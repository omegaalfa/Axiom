l},{"name":"newkey","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"renameNx","fqn":"Redis::renameNx","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":114567,"end":114575}},"declared_type":null,"signature":{"parameters":[{"name":"key_src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key_dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Renames $key_src to $key_dst but only if newkey does not exist. $redis->set('src', 'src_key'); $redis->set('existing-dst', 'i_exist'); $redis->renamenx('src', 'dst'); $redis->renamenx('dst', 'existing-dst'); /","params":[{"name":"key_src","declared_type":"string","description":"The source key name"},{"name":"key_dst","declared_type":"string","description":"The destination key name."}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"replicaof","fqn":"Redis::replicaof","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":144084,"end":144093}},"declared_type":null,"signature":{"parameters":[{"name":"host","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"port","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Used to turn a Redis instance into a replica of another, or to remove replica status promoting the instance to a primary. were able to promote the replicat to a primary. $redis = new Redis(['host' => 'localhost']); // Attempt to become a replica of a Redis instance at 127.0.0.1:9999 $redis->replicaof('127.0.0.1', 9999); // When passed no arguments, PhpRedis will deliver the command `REPLICAOF NO ONE` // attempting to promote the instance to a primary. $redis->replicaof(); /","params":[{"name":"host","declared_type":"string|null","description":"The host of the primary to start replicating."},{"name":"port","declared_type":"int","description":"The port of the primary to start replicating."}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"request","fqn":"Redis::request","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":1193,"end":1200}},"declared_type":null,"signature":{"parameters":[{"name":"params","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"reset","fqn":"Redis::reset","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":114900,"end":114905}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Reset the state of the connection. $redis->reset(); /","params":[],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"restore","fqn":"Redis::restore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":117012,"end":117019}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"ttl","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Restore a key by the binary payload generated by the DUMP command. Zero means no TTL at all. ```php $options = [ 'ABSTTL'          # If this is present, the `$ttl` provided by the user should # be an absolute timestamp, in milliseconds() 'REPLACE'         # This flag instructs Redis to store the key even if a key with # that name already exists. 'IDLETIME' => int # Tells Redis to set the keys internal 'idletime' value to a # specific number (see the Redis command OBJECT for more info). 'FREQ'     => int # Tells Redis to set the keys internal 'FREQ' value to a specific # number (this relates to Redis' LFU eviction algorithm). ]; ``` $redis->sAdd('captains', 'Janeway', 'Picard', 'Sisko', 'Kirk', 'Archer'); $serialized = $redis->dump('captains'); $redis->restore('captains-backup', 0, $serialized); /","params":[{"name":"key","declared_type":"string","description":"The name of the key you wish to create."},{"name":"ttl","declared_type":"int","description":"What Redis should set the key's TTL (in milliseconds) to once it is created."},{"name":"value","declared_type":"string","description":"The serialized binary value of the string (generated by DUMP)."},{"name":"options","declared_type":"array|null","description":"An array of additional options that modifies how the command operates."}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"role","fqn":"Redis::role","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":117447,"end":117451}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Query whether the connected instance is a primary or replica an error. $redis->role(); /","params":[],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rPop","fqn":"Redis::rPop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":112518,"end":112522}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|string|bool","phpdoc_return_type":"Redis|array|string|bool"},"documentation":{"description":"Pop one or more elements from the end of a list. NOTE:  The `count` argument requires Redis >= 6.2.0 /","params":[{"name":"key","declared_type":"string","description":"A redis LIST key name."},{"name":"count","declared_type":"int","description":"The maximum number of elements to pop at once."}],"return_type":"Redis|array|string|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rpoplpush","fqn":"Redis::rpoplpush","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":118165,"end":118174}},"declared_type":null,"signature":{"parameters":[{"name":"srckey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"dstkey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|string|false","phpdoc_return_type":"Redis|string|false"},"documentation":{"description":"Atomically pop an element off the end of a Redis LIST and push it to the beginning of another. $redis->pipeline() ->del('list1', 'list2') ->rpush('list1', 'list1-1', 'list1-2') ->rpush('list2', 'list2-1', 'list2-2') ->exec(); $redis->rpoplpush('list2', 'list1'); /","params":[{"name":"srckey","declared_type":"string","description":"The source key to pop from."},{"name":"dstkey","declared_type":"string","description":"The destination key to push to."}],"return_type":"Redis|string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rPush","fqn":"Redis::rPush","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":92947,"end":92952}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"elements","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Append one or more elements to a list. /","params":[{"name":"key","declared_type":"string","description":"The list to append to."},{"name":"elements","declared_type":"mixed","description":"one or more elements to append."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rPushx","fqn":"Redis::rPushx","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":93869,"end":93875}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Append an element to a list but only if the list exists $redis->rPushx('queue', 'job-99'); /","params":[{"name":"key","declared_type":"string","description":"The key to prepend to."},{"name":"value","declared_type":"mixed","description":"The value to prepend."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sAdd","fqn":"Redis::sAdd","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":118797,"end":118801}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"other_values","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Add one or more values to a Redis SET key. $redis->del('myset'); $redis->sadd('myset', 'foo', 'bar', 'baz'); $redis->sadd('myset', 'foo', 'new'); /","params":[{"name":"key","declared_type":"string","description":"The key name"},{"name":"value","declared_type":"mixed","description":"A value to add to the set."},{"name":"other_values","declared_type":"mixed","description":"One or more additional values to add"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sAddArray","fqn":"Redis::sAddArray","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":119524,"end":119533}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Add one or more values to a Redis SET key.  This is an alternative to Redis::sadd() but instead of being variadic, takes a single array of values. $redis->del('myset'); $redis->sAddArray('myset', ['foo', 'bar', 'baz']); $redis->sAddArray('myset', ['foo', 'new']); /","params":[{"name":"key","declared_type":"string","description":"The set to add values to."},{"name":"values","declared_type":"array","description":"One or more members to add to the set."}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"save","fqn":"Redis::save","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":131025,"end":131029}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Persist the Redis database to disk.  This command will block the server until the save is completed.  For a nonblocking alternative, see Redis::bgsave(). $redis->save(); /","params":[],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"scan","fqn":"Redis::scan","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":134096,"end":134100}},"declared_type":null,"signature":{"parameters":[{"name":"iterator","declared_type":"null|int|string","phpdoc_type":"int|string|null","optional":false,"variadic":false,"by_reference":true},{"name":"pattern","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"type","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Incrementally scan the Redis keyspace, with optional pattern and type matching. A note about Redis::SCAN_NORETRY and Redis::SCAN_RETRY. For convenience, PhpRedis can retry SCAN commands itself when Redis returns an empty array of keys with a nonzero iterator.  This can happen when matching against a pattern that very few keys match inside a key space with a great many keys.  The following example demonstrates how to use Redis::scan() with the option disabled and enabled. the initial invocation of the call, it should be initialized by the caller to NULL.  Each time SCAN is invoked, the iterator will be updated to a new number, until finally Redis will set the value to zero, indicating that the scan is complete. NULL, it is the equivalent of sending '*' (match every key). call to SCAN.  The larger the number, the longer Redis may block clients while iterating the key space. 'STRING', 'LIST', 'SET') invocation of scan.  Note that it is possible for Redis to return zero keys before having scanned the entire key space, so the caller should instead continue to SCAN until the iterator reference is returned to zero. $redis = new Redis(['host' => 'localhost']); $redis->setOption(Redis::OPT_SCAN, Redis::SCAN_NORETRY); $it = null {} do { $keys = $redis->scan($it, '*zorg*'); foreach ($keys as $key) { echo \"KEY: $key\\n\"; } } while ($it != 0); $redis->setOption(Redis::OPT_SCAN, Redis::SCAN_RETRY); $it = null; // When Redis::SCAN_RETRY is enabled, we can use simpler logic, as we will never receive an // empty array of keys when the iterator is nonzero. while ($keys = $redis->scan($it, '*zorg*')) { foreach ($keys as $key) { echo \"KEY: $key\\n\"; } } /","params":[{"name":"iterator","declared_type":"int|string|null","description":"The cursor returned by Redis for every subsequent call to SCAN.  On"},{"name":"pattern","declared_type":"string|null","description":"An optional glob-style pattern for matching key names.  If passed as"},{"name":"count","declared_type":"int","description":"A hint to redis that tells it how many keys to return in a single"},{"name":"type","declared_type":"string|null","description":"An optional argument to specify which key types to scan (e.g."}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"scard","fqn":"Redis::scard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":134562,"end":134567}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Retrieve the number of members in a Redis set. /","params":[{"name":"key","declared_type":"string","description":"The set to get the cardinality of."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sContains","fqn":"Redis::sContains","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":10256,"end":10265}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":