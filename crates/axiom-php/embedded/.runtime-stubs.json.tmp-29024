ed_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Increments the value of a member from a hash by a given amount. <pre> $redisCluster->del('h'); $redisCluster->hIncrBy('h', 'x', 2); // returns 2: h[x] = 2 now. $redisCluster->hIncrBy('h', 'x', 1); // h[x] ← 2 + 1. Returns 3 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"member","declared_type":"string","description":null},{"name":"value","declared_type":"int","description":"(integer) value that will be added to the member's value"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hIncrByFloat","fqn":"RedisCluster::hIncrByFloat","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":59695,"end":59707}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"float","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|float|false","phpdoc_return_type":null},"documentation":{"description":"Increment the float value of a hash field by the given amount <pre> $redisCluster->hset('h', 'float', 3); $redisCluster->hset('h', 'int',   3); var_dump( $redisCluster->hIncrByFloat('h', 'float', 1.5) ); // float(4.5) var_dump( $redisCluster->hGetAll('h') ); //// Output: // // array(2) { //   [\"float\"]=> //   string(3) \"4.5\" //   [\"int\"]=> //   string(1) \"3\" // } </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"member","declared_type":"string","description":null},{"name":"increment","declared_type":"float","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hKeys","fqn":"RedisCluster::hKeys","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":50376,"end":50381}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns the keys in a hash, as an array of strings. <pre> $redisCluster->del('h'); $redisCluster->hSet('h', 'a', 'x'); $redisCluster->hSet('h', 'b', 'y'); $redisCluster->hSet('h', 'c', 'z'); $redisCluster->hSet('h', 'd', 't'); var_dump($redisCluster->hKeys('h')); //// Output: // // array(4) { // [0]=> // string(1) \"a\" // [1]=> // string(1) \"b\" // [2]=> // string(1) \"c\" // [3]=> // string(1) \"d\" // } // The order is random and corresponds to redis' own internal representation of the set structure. </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hLen","fqn":"RedisCluster::hLen","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":49357,"end":49361}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Returns the length of a hash, in number of items <pre> $redisCluster->del('h'); $redisCluster->hSet('h', 'key1', 'hello'); $redisCluster->hSet('h', 'key2', 'plop'); $redisCluster->hLen('h'); // returns 2 </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hMget","fqn":"RedisCluster::hMget","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":57011,"end":57016}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Retrieve the values associated to the specified fields in the hash. with the hash keys as array keys. <pre> $redisCluster->del('h'); $redisCluster->hSet('h', 'field1', 'value1'); $redisCluster->hSet('h', 'field2', 'value2'); $redisCluster->hMget('h', array('field1', 'field2')); // returns array('field1' => 'value1', 'field2' => 'value2') </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"keys","declared_type":"array","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hMset","fqn":"RedisCluster::hMset","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":57724,"end":57729}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"varia