,"phpdoc_return_type":"string|false"},"documentation":{"description":"Tokenize string Note that only the first call to strtok uses the string argument. Every subsequent call to strtok only needs the token to use, as it keeps track of where it is in the current string. To start over, or to tokenize a new string you simply call strtok with the string argument again to initialize it. Note that you may put multiple tokens in the token parameter. The string will be tokenized when any one of the characters in the argument are found. The string being split up into smaller strings (tokens). </p> The delimiter used when splitting up str. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"token","declared_type":"string|null","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"strtolower","fqn":"strtolower","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":724,"end":734}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Make a string lowercase The input string. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"strtotime","fqn":"strtotime","kind":"Function","origin":"PhpRuntime","extension":"date","location":{"file":"date/date.php","range":{"start":894,"end":903}},"declared_type":null,"signature":{"parameters":[{"name":"datetime","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"baseTimestamp","declared_type