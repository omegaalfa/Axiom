reams. $redis->xAdd('s03', '3-1', ['title' => 'The Search, Part I']); $redis->xAdd('s03', '3-2', ['title' => 'The Search, Part II']); $redis->xAdd('s03', '3-3', ['title' => 'The House Of Quark']); $redis->xAdd('s04', '4-1', ['title' => 'The Way of the Warrior']); $redis->xAdd('s04', '4-3', ['title' => 'The Visitor']); $redis->xAdd('s04', '4-4', ['title' => 'Hippocratic Oath']); $redis->xRead(['s03' => '3-2', 's04' => '4-1']); /","params":[{"name":"streams","declared_type":"array","description":"An associative array with stream name keys and minimum id values."},{"name":"count","declared_type":"int","description":"An optional limit to how many entries are returned *per stream*"},{"name":"block","declared_type":"int","description":"An optional maximum number of milliseconds to block the caller if no"}],"return_type":"Redis|array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xReadGroup","fqn":"Redis::xReadGroup","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":26167,"end":26177}},"declared_type":null,"signature":{"parameters":[{"name":"group_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"consumer_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"streams","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"/","params":[{"name":"options","declared_type":"array","description":"Accepted options: \"count\", \"block\", and \"noack\"."}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xreadgroup","fqn":"Redis::xreadgroup","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":181482,"end":181492}},"declared_type":null,"signature":{"parameters":[{"name":"group","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"consumer","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"streams","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"block","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|bool","phpdoc_return_type":"Redis|array|bool"},"documentation":{"description":"Read one or more messages using a consumer group. $redis->xGroup('CREATE', 'episodes', 'ds9', '0-0', true); $redis->xAdd('episodes', '1-1', ['title' => 'Emissary: Part 1']); $redis->xAdd('episodes', '1-2', ['title' => 'A Man Alone']); $messages = $redis->xReadGroup('ds9', 'sisko', ['episodes' => '>']); // After having read the two messages, add another $redis->xAdd('episodes', '1-3', ['title' => 'Emissary: Part 2']); // Acknowledge the first two read messages foreach ($messages as $stream => $stream_messages) { $ids = array_keys($stream_messages); $redis->xAck('stream', 'ds9', $ids); } // We can now pick up where we left off, and will only get the final message $msgs = $redis->xReadGroup('ds9', 'sisko', ['episodes' => '>']); /","params":[{"name":"group","declared_type":"string","description":"The consumer group to use."},{"name":"consumer","declared_type":"string","description":"The consumer to use."},{"name":"streams","declared_type":"array","description":"An array of stream names and message IDs"},{"name":