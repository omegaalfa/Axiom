ocation":{"file":"redis/Redis.php","range":{"start":80524,"end":80529}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"iterator","declared_type":"null|int|string","phpdoc_type":"int|string|null","optional":false,"variadic":false,"by_reference":true},{"name":"pattern","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|bool","phpdoc_return_type":"Redis|array|bool"},"documentation":{"description":"Iterate over the fields and values of a hash in an incremental fashion. This value will be updated after every call to hscan, until it reaches zero meaning the scan is complete. $redis = new Redis(['host' => 'localhost']); $redis->del('big-hash'); for ($i = 0; $i < 1000; $i++) { $fields[\"field:$i\"] = \"value:$i\"; } $redis->hmset('big-hash', $fields); $it = null; do { // Scan the hash but limit it to fields that match '*:1?3' $fields = $redis->hscan('big-hash', $it, '*:1?3'); foreach ($fields as $field => $value) { echo \"[$field] => $value\\n\"; } } while ($it != 0); /","params":[{"name":"key","declared_type":"string","description":"The hash to query."},{"name":"iterator","declared_type":"int|string|null","description":"The scan iterator, which should be initialized to NULL before the first call."},{"name":"pattern","declared_type":"string|null","description":"An optional glob-style pattern to filter fields with."},{"name":"count","declared_type":"int","description":"An optional hint to Redis about how many fields and values to return per HSCAN."}],"return_type":"Redis|array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hSet","fqn":"Redis::hSet","kind":"Method","orig