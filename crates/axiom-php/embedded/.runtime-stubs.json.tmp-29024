 database connection resource. </p> An optional parameter that controls how the returned array is indexed. <i>result_type</i> is a constant and can take the following values: <b>PGSQL_ASSOC</b>, <b>PGSQL_NUM</b> and <b>PGSQL_BOTH</b>. Using <b>PGSQL_NUM</b>, <b>pg_get_notify</b> will return an array with numerical indices, using <b>PGSQL_ASSOC</b> it will return only associative indices while <b>PGSQL_BOTH</b>, the default, will return both numerical and associative indices. </p> Otherwise if no NOTIFY is waiting, then <b>FALSE</b> is returned. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_get_pid","fqn":"pg_get_pid","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":44341,"end":44351}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Gets the backend's process ID PostgreSQL database connection resource. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_get_result","fqn":"pg_get_result","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":33663,"end":33676}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"va