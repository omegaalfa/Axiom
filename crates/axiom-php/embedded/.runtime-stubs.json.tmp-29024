t","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"username","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"password","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"database","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"socket","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"/","params":[{"name":"host","declared_type":"string","description":"[optional]"},{"name":"username","declared_type":"string","description":"[optional]"},{"name":"password","declared_type":"string","description":"[optional]"},{"name":"database","declared_type":"string","description":"[optional]"},{"name":"port","declared_type":"int","description":"[optional]"},{"name":"socket","declared_type":"string","description":"[optional]"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"next_result","fqn":"mysqli::next_result","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":17846,"end":17857}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Prepare next result from multi_query /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"options","fqn":"mysqli::options","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":19466,"end":19473}},"declared_type":null,"signature":{"parameters":[{"name":"option","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"string|int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set options The option that you want to set. It can be one of the following values: <table> Valid options <tr valign=\"top\"> <td>Name</td> <td>Description</td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_OPT_CONNECT_TIMEOUT</b></td> <td>connection timeout in seconds (supported on Windows with TCP/IP since PHP 5.3.1)</td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_OPT_LOCAL_INFILE</b></td> <td>enable/disable use of LOAD LOCAL INFILE</td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_INIT_COMMAND</b></td> <td>command to execute after when connecting to MySQL server</td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_READ_DEFAULT_FILE</b></td> <td> Read options from named option file instead of my.cnf </td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_READ_DEFAULT_GROUP</b></td> <td> Read options from the named group from my.cnf or the file specified with <b>MYSQL_READ_DEFAULT_FILE</b> </td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_SERVER_PUBLIC_KEY</b></td> <td> RSA public key file used with the SHA-256 based authentication. </td> </tr> </table> </p> The value for the option. </p> /","params":[{"name":"option","declared_type":"int","description":"<p>"},{"name":"value","declared_type":"string|int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ping","fqn":"mysqli::ping","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":19877,"end":19881}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Pings a server connection, or tries to reconnect if the connection has gone down /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"poll","fqn":"mysqli::poll","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":28245,"end":28249}},"declared_type":null,"signature":{"parameters":[{"name":"read","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"error","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"reject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"seconds","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"microseconds","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Poll connections </p> </p> </p> Number of seconds to wait, must be non-negative. </p> Number of microseconds to wait, must be non-negative. </p> /","params":[{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null},{"name":"seconds","declared_type":"int","description":"<p>"},{"name":"microseconds","declared_type":"int","description":"[optional] <p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"prepare","fqn":"mysqli::prepare","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":21252,"end":21259}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mysqli_stmt|false","phpdoc_return_type":"mysqli_stmt|false"},"documentation":{"description":"Prepares an SQL statement for execution The query, as a string. It must consist of a single SQL statement. </p> <p> The SQL statement may contain zero or more parameter markers represented by question mark (?) characters at the appropriate positions. </p> <p> The markers are legal only in certain places in SQL statements. For example, they are permitted in the VALUES() list of an INSERT statement (to specify column values for a row), or in a comparison with a column in a WHERE clause to specify a comparison value. </p> <p> However, they are not permitted for identifiers (such as table or column names), or to specify both operands of a binary operator such as the = equal sign. The latter restriction is necessary because it would be impossible to determine the parameter type. In general, parameters are legal only in Data Manipulation Language (DML) statements, and not in Data Definition Language (DDL) statements. </p> /","params":[{"name":"query","declared_type":"string","description":"<p>"}],"return_type":"mysqli_stmt|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"query","fqn":"mysqli::query","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":23305,"end":23310}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"result_mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mysqli_result|bool","phpdoc_return_type":"mysqli_result|bool"},"documentation":{"description":"Performs a query on the database The query string. </p> <p> If the query contains any variable input then parameterized prepared statements should be used instead. Alternatively, the data must be properly formatted and all strings must be escaped using the <b>mysqli_real_escape_string</b> function. </p> The result mode can be one of 3 constants indicating how the result will be returned from the MySQL server. </p> <p> <b>MYSQLI_STORE_RESULT</b> (default) - returns a <b>mysqli_result</b> object with buffered result set. </p> <p> <b>MYSQLI_USE_RESULT</b> - returns a <b>mysqli_result</b> object with unbuffered result set. As long as there are pending records waiting to be fetched, the connection line will be busy and all subsequent calls will return error Commands out of sync. To avoid the error all records must be fetched from the server or the result set must be discarded by calling <b>mysqli_free_result</b>. </p> <p> <b>MYSQLI_ASYNC</b> (available with mysqlnd) - the query is performed asynchronously and no result set is immediately returned. <b>mysqli_poll</b> is then used to get results from such queries. Used in combination with either <b>MYSQLI_STORE_RESULT</b> or <b>MYSQLI_USE_RESULT</b> constant. </p> For successful queries which produce a result set, such as SELECT, SHOW, DESCRIBE or EXPLAIN, <b>mysqli_query</b> will return a <b>mysqli_result</b> object. For other successful queries <b>mysqli_query</b> will return true. /","params":[{"name":"query","declared_type":"string","description":"<p>"},{"name":"result_mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"mysqli_result|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"quote_string","fqn":"mysqli::quote_string","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":36931,"end":36943}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"/","params":[{"name":"string","declared_type":"string","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"real_connect","fqn":"mysqli::real_connect","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":26441,"end":26453}},"declared_type":null,"signature":{"parameters":[{"name":"hostname","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"username","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"password","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"database","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"socket","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Opens a connection to a mysql server Can be either a host name or an IP address. Passing the null value or the string \"localhost\" to this parameter, the local host is assumed. When possible, pipes will be used instead of the TCP/IP protocol. </p> The MySQL user name. </p> If provided or null, the MySQL server will attempt to authenticate the user against those user records which have no password only. This allows one username to be used with different permissions (depending on if a password as provided or not). </p> If provided will specify the default database to be used when performing queries. </p> Specifies the port number to attempt to connect to the MySQL server. </p> Specifies the socket or named pipe that should be used. </p> <p> Specifying the <i>socket</i> parameter will not explicitly determine the type of connection to be used when connecting to the MySQL server. How the connection is made to the MySQL database is determined by the <i>host</i> parameter. </p> With the parameter <i>flags</i> you can set different connection options: </p> <table> Supported flags <tr valign=\"top\"> <td>Name</td> <td>Description</td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_CLIENT_COMPRESS</b></td> <td>Use compression protocol</td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_CLIENT_FOUND_ROWS</b></td> <td>return number of matched rows, not the number of affected rows</td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_CLIENT_IGNORE_SPACE</b></td> <td>Allow spaces after function names. Makes all function names reserved words.</td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_CLIENT_INTERACTIVE</b></td> <td> Allow interactive_timeout seconds (instead of wait_timeout seconds) of inactivity before closing the connection </td> </tr> <tr valign=\"top\"> <td><b>MYSQLI_CLIENT_SSL</b></td> <td>Use SSL (encryption)</td> </tr> </table> <p> For security reasons the <b>MULTI_STATEMENT</b> flag is not supported in PHP. If you want to execute multiple queries use the <b>mysqli_multi_query</b> function. </p> /","params":[{"name":"hostname","declared_type":"string","description":"[optional] <p>"},{"name":"username","declared_type":"string","description":"[optional] <p>"},{"name":"password","declared_type":"string","description":"[optional] <p>"},{"name":"database","declared_type":"string","description":"[optional] <p>"},{"name":"port","declared_type":"int","description":"[optional] <p>"},{"name":"socket","declared_type":"string","description":"[optional] <p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"real_escape_string","fqn":"mysqli::real_escape_string","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":27569,"end":27587}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Escapes special characters in a string for use in an SQL statement, taking into account the current charset of the connection The string to be escaped. </p> <p> Characters encoded are NUL (ASCII 0), \\n, \\r, \\, ', \", and Control-Z. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"real_query","fqn":"mysqli::real_query","kind":"Method","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":30068,"end":30078}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Execute an SQL query The query, as a string. </p> <p> If the query contains any variable input then parameterized prepared statements should be used instead. Alternatively, the data must be properly formatted and all strings must be escaped using the <b>mysqli_real_escape_string</b> function. </p> /","params":[{"name":"query","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name"