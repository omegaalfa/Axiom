th new ones An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The distinguished name of an LDAP entity. </p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"dn","declared_type":"string","description":"<p>"},{"name":"entry","declared_type":"array","description":null},{"name":"controls","declared_type":"array|null","description":"Array of LDAP Controls to send with the request."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_mod_replace_ext","fqn":"ldap_mod_replace_ext","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":34651,"end":34671}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"dn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"controls","declared_type":null,"phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Replace attribute values with new ones Does the same thing as ldap_mod_replace() but returns the LDAP result resource to be parsed with ldap_parse_result(). An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The distinguished name of an LDAP entity. </p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"dn","declared_type":"string","description":"<p>"},{"name":"entry","declared_type":"array","description":null},{"name":"controls","declared_type":"array|null","description":"Array of LDAP Controls to send with the request."}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_modify","fqn":"ldap_modify","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":31442,"end":31453}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"dn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"controls","declared_type":null,"phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"This function is an alias of: ldap_mod_replace(). Replace attribute values with new ones An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The distinguished name of an LDAP entity. </p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"dn","declared_type":"string","description":"<p>"},{"name":"entry","declared_type":"array","description":null},{"name":"controls","declared_type":"array|null","description":"Array of LDAP Controls to send with the request."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_modify_batch","fqn":"ldap_modify_batch","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":52978,"end":52995}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"dn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"modifications_info","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"controls","declared_type":null,"phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5.4 &gt;= 5.4.26, PHP 5.5 &gt;= 5.5.10, PHP 5.6 &gt;= 5.6.0) Batch and execute modifications on an LDAP entry An LDAP link identifier, returned by {@see ldap_connect()}. </p> array is an associative array with two or three keys: <em>attrib</em> maps to the name of the attribute to modify, <em>modtype</em> maps to the type of modification to perform, and (depending on the type of modification) <em>values</em> maps to an array of attribute values relevant to the modification. </p> <p> Possible values for <em>modtype</em> include: </p> <dl> <dt> <b>LDAP_MODIFY_BATCH_ADD</b></dt> <dd> <p> Each value specified through <em>values</em> is added (as an additional value) to the attribute named by <em>attrib</em>. </p> </dd> <dt> <b>LDAP_MODIFY_BATCH_REMOVE</b></dt> <dd> <p> Each value specified through <em>values</em> is removed from the attribute named by <em>attrib</em>. Any value of the attribute not contained in the <em>values</em> array will remain untouched. </p> </dd> <dt> <b>LDAP_MODIFY_BATCH_REMOVE_ALL</b></dt> <dd> <p> All values are removed from the attribute named by <em>attrib</em>. A <em>values</em> entry must not be provided. </p> </dd> <dt> <b>LDAP_MODIFY_BATCH_REPLACE</b></dt> <dd> <p> All current values of the attribute named by <em>attrib</em> are replaced with the values specified through <em>values</em>. </p> </dd> </dl> <p> Note that any value for <em>attrib</em> must be a string, any value for <em>values</em> must be an array of strings, and any value for <em>modtype</em> must be one of the <b>LDAP_MODIFY_BATCH_*</b> constants listed above. </p> /","params":[{"name":"ldap","declared_type":null,"description":"<p>"},{"name":"dn","declared_type":"string","description":"<p>The distinguished name of an LDAP entity.</p>"},{"name":"modifications_info","declared_type":"array","description":"<p>An array that specifies the modifications to make. Each entry in this"},{"name":"controls","declared_type":"array|null","description":"Array of LDAP Controls to send with the request."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_next_attribute","fqn":"ldap_next_attribute","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":22912,"end":22931}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Get the next attribute in result An LDAP link identifier, returned by <b>ldap_connect</b>. </p> error. /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"entry","declared_type":"resource","description":null}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_next_entry","fqn":"ldap_next_entry","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":20574,"end":20589}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Get next result entry An LDAP link identifier, returned by <b>ldap_connect</b>. </p> are being read starting with <b>ldap_first_entry</b>. If there are no more entries in the result then it returns <b>FALSE</b>. /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"entry","declared_type":"resource","description":null}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_next_reference","fqn":"ldap_next_reference","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":46525,"end":46544}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource"},"documentation":{"description":"Get next reference /","params":[{"name":"ldap","declared_type":"resource","description":null},{"name":"entry","declared_type":"resource","description":null}],"return_type":"resource","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_parse_exop","fqn":"ldap_parse_exop","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":5531,"end":5546}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"response_data","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"response_data","declared_type":null,"phpdoc_type":null,"op