erence":false},{"name":"object_id","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"type","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"retries","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Set the value of an SNMP object The hostname of the SNMP agent (server). </p> the security name, usually some kind of username </p> the security level (noAuthNoPriv|authNoPriv|authPriv) </p> the authentication protocol (MD5 or SHA) </p> the authentication pass phrase </p> the privacy protocol (DES or AES) </p> the privacy pass phrase </p> The SNMP object id. </p> <p>types:</p> <table> <tr valign=\"top\"><td>=</td><td>The type is taken from the MIB</td></tr> <tr valign=\"top\"><td>i</td><td>INTEGER</td></tr> <tr valign=\"top\"><td>u</td><td>INTEGER</td></tr> <tr valign=\"top\"><td>s</td><td>STRING</td></tr> <tr valign=\"top\"><td>x</td><td>HEX STRING</td></tr> <tr valign=\"top\"><td>d</td><td>DECIMAL STRING</td></tr> <tr valign=\"top\"><td>n</td><td>NULLOBJ</td></tr> <tr valign=\"top\"><td>o</td><td>OBJID</td></tr> <tr valign=\"top\"><td>t</td><td>TIMETICKS</td></tr> <tr valign=\"top\"><td>a</td><td>IPADDRESS</td></tr> <tr valign=\"top\"><td>b</td><td>BITS</td></tr> </table> <p>If <b>OPAQUE_SPECIAL_TYPES</b> was defined while compiling the SNMP library, the following are also valid: </p> <p>types:</p> <table> <tr valign=\"top\"><td>U</td><td>unsigned int64</td></tr> <tr valign=\"top\"><td>I</td><td>signed int64</td></tr> <tr valign=\"top\"><td>F</td><td>float</td></tr> <tr valign=\"top\"><td>D</td><td>double</td></tr> </table> <p>Most of these will use the obvious corresponding ASN.1 type. &#x00027;s&#x00027;, &#x00027;x&#x00027;, &#x00027;d&#x00027; and &#x00027;b&#x00027; are all different ways of specifying an OCTET STRING value, and the &#x00027;u&#x00027; unsigned type is also used for handling Gauge32 values. </p> <p> If the MIB-Files are loaded by into the MIB Tree with \"snmp_read_mib\" or by specifying it in the libsnmp config, &#x00027;=&#x00027; may be used as the <i>type</i> parameter for all object ids as the type can then be automatically read from the MIB. </p> <p> Note that there are two ways to set a variable of the type BITS like e.g. \"SYNTAX BITS {telnet(0), ftp(1), http(2), icmp(3), snmp(4), ssh(5), https(6)}\": </p> <p> Using type \"b\" and a list of bit numbers. This method is not recommended since GET query for the same OID would return e.g. 0xF8. Using type \"x\" and a hex number but without(!) the usual \"0x\" prefix. See examples section for more details. </p> The new value </p> The number of microseconds until the first timeout. </p> The number of times to retry if timeouts occur. </p> <p> If the SNMP host rejects the data type, an E_WARNING message like \"Warning: Error in packet. Reason: (badValue) The value given has the wrong type or length.\" is shown. If an unknown or invalid OID is specified the warning probably reads \"Could not add variable\". </p> /","params":[{"name":"hostname","declared_type":"string","description":"<p>"},{"name":"security_name","declared_type":"string","description":"<p>"},{"name":"security_level","declared_type":"string","description":"<p>"},{"name":"auth_protocol","declared_type":"string","description":"<p>"},{"name":"auth_passphrase","declared_type":"string","description":"<p>"},{"name":"privacy_protocol","declared_type":"string","description":"<p>"},{"name":"privacy_passphrase","declared_type":"string","description":"<p>"},{"name":"object_id","declared_type":"string","description":"<p>"},{"name":"type","declared_type":"string","description":"<p>The MIB defines the type of each object id. It has to be specified as a single character from the below list.</p>"},{"name":"value","declared_type":"string","description":"<p>"},{"name":"timeout","declared_type":"int","description":"[optional] <p>"},{"name":"retries","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"snmp3_walk","fqn":"snmp3_walk","kind":"Function","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":34546,"end":34556}},"declared_type":null,"signature":{"parameters":[{"name":"hostname","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"security_name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"security_level","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"auth_protocol","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"auth_passphrase","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"privacy_protocol","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"privacy_passphrase","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"object_id","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"retries","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Fetch all the SNMP objects from an agent The hostname of the SNMP agent (server). </p> the security name, usually some kind of username </p> the security level (noAuthNoPriv|authNoPriv|authPriv) </p> the authentication protocol (MD5 or SHA) </p> the authentication pass phrase </p> the privacy protocol (DES or AES) </p> the privacy pass phrase </p> If <b>NULL</b>, <i>object_id</i> is taken as the root of the SNMP objects tree and all objects under that tree are returned as an array. </p> <p> If <i>object_id</i> is specified, all the SNMP objects below that <i>object_id</i> are returned. </p> The number of microseconds until the first timeout. </p> The number of times to retry if timeouts occur. </p> <i>object_id</i> as root or <b>FALSE</b> on error. /","params":[{"name":"hostname","declared_type":"string","description":"<p>"},{"name":"security_name","declared_type":"string","description":"<p>"},{"name":"security_level","declared_type":"string","description":"<p>"},{"name":"auth_protocol","declared_type":"string","description":"<p>"},{"name":"auth_passphrase","declared_type":"string","description":"<p>"},{"name":"privacy_protocol","declared_type":"string","description":"<p>"},{"name":"privacy_passphrase","declared_type":"string","description":"<p>"},{"name":"object_id","declared_type":"string","description":"<p>"},{"name":"timeout","declared_type":"int","description":"[optional] <p>"},{"name":"retries","declared_type":"int","description":"[optional] <p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"snmp_get_quick_print","fqn":"snmp_get_quick_print","kind":"Function","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":22275,"end":22295}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Fetches the current value