ull","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"errorCode","fqn":"PDOStatement::errorCode","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":85649,"end":85658}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"?string","phpdoc_return_type":"string"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Fetch the SQLSTATE associated with the last operation on the statement handle <b>PDOStatement::errorCode</b> only retrieves error codes for operations performed with PDOStatement objects. /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"errorInfo","fqn":"PDOStatement::errorInfo","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":86810,"end":86819}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Fetch extended error information associated with the last operation on the statement handle error information about the last operation performed by this statement handle. The array consists of the following fields: <tr valign=\"top\"> <td>Element</td> <td>Information</td> </tr> <tr valign=\"top\"> <td>0</td> <td>SQLSTATE error code (a five characters alphanumeric identifier defined in the ANSI SQL standard).</td> </tr> <tr valign=\"top\"> <td>1</td> <td>Driver specific error code.</td> </tr> <tr valign=\"top\"> <td>2</td> <td>Driver specific error message.</td> </tr> /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"execute","fqn":"PDOStatement::execute","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":72145,"end":72152}},"declared_type":null,"signature":{"parameters":[{"name":"params","declared_type":null,"phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Executes a prepared statement An array of values with as many elements as there are bound parameters in the SQL statement being executed. All values are treated as <b>PDO::PARAM_STR</b>. </p> <p> You cannot bind multiple values to a single parameter; for example, you cannot bind two values to a single named parameter in an IN() clause. </p> <p> You cannot bind more values than specified; if more keys exist in <i>input_parameters</i> than in the SQL specified in the <b>PDO::prepare</b>, then the statement will fail and an error is emitted. </p> /","params":[{"name":"params","declared_type":"array","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fetch","fqn":"PDOStatement::fetch","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":74066,"end":74071}},"declared_type":null,"signature":{"parameters":[{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"cursorOrientation","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"cursorOffset","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"($mode is PDO::FETCH_ASSOC ? array<string, mixed>|false"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Fetches the next row from a result set Controls how the next row will be returned to the caller. This value must be one of the PDO::FETCH_* constants, defaulting to value of PDO::ATTR_DEFAULT_FETCH_MODE (which defaults to PDO::FETCH_BOTH). </p> <p> PDO::FETCH_ASSOC: returns an array indexed by column name as returned in your result set </p> For a PDOStatement object representing a scrollable cursor, this value determines which row will be returned to the caller. This value must be one of the PDO::FETCH_ORI_* constants, defaulting to PDO::FETCH_ORI_NEXT. To request a scrollable cursor for your PDOStatement object, you must set the PDO::ATTR_CURSOR attribute to PDO::CURSOR_SCROLL when you prepare the SQL statement with <b>PDO::prepare</b>. </p> : ($mode is PDO::FETCH_NUM ? list<mixed>|false : ($mode is PDO::FETCH_BOTH ? array<string|int, mixed>|false : ($mode is PDO::FETCH_OBJ ? \\stdClass|false : ($mode is PDO::FETCH_COLUMN ? mixed : ($mode is PDO::FETCH_NAMED ? array<string, mixed>|false : mixed)))))) /","params":[{"name":"mode","declared_type":"int","description":"[optional] <p>"},{"name":"cursorOrientation","declared_type":"int","description":"[optional] <p>"},{"name":"cursorOffset","declared_type":"int","description":"[optional]"}],"return_type":"($mode is PDO::FETCH_ASSOC ? array<string, mixed>|false","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fetchAll","fqn":"PDOStatement::fetchAll","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":83558,"end":83566}},"declared_type":null,"signature":{"parameters":[{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"fetch_argument","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"args","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"($mode is PDO::FETCH_COLUMN ? list<mixed>"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Returns an array containing all of the remaining rows in the result set. The array represents each row as either an array of column values or an object with properties corresponding to each column name. An empty array is returned if there are zero results to fetch. <p> Using this method to fetch large result sets will result in a heavy demand on system and possibly network resources. Rather than retrieving all of the data and manipulating it in PHP, consider using the database server to manipulate the result sets. For example, use the WHERE and ORDER BY clauses in SQL to restrict results before retrieving and processing them with PHP. </p> Controls the contents of the returned array as documented in <b>PDOStatement::fetch</b>. Defaults to value of <b>PDO::ATTR_DEFAULT_FETCH_MODE</b> (which defaults to <b>PDO::FETCH_BOTH</b>) </p> <p> To return an array consisting of all values of a single column from the result set, specify <b>PDO::FETCH_COLUMN</b>. You can specify which column you want with the <i>column-index</i> parameter. </p> <p> To fetch only the unique values of a single column from the result set, bitwise-OR <b>PDO::FETCH_COLUMN</b> with <b>PDO::FETCH_UNIQUE</b>. </p> <p> To return an associative array grouped by the values of a specified column, bitwise-OR <b>PDO::FETCH_COLUMN</b> with <b>PDO::FETCH_GROUP</b>. </p> Arguments of custom class constructor when the <i>fetch_style</i> parameter is <b>PDO::FETCH_CLASS</b>. </p> : ($mode is PDO::FETCH_KEY_PAIR ? array<array-key, mixed> : ($mode is PDO::FETCH_ASSOC ? list<array<string, mixed>> : ($mode is PDO::FETCH_NUM ? list<list<mixed>> : ($mode is PDO::FETCH_BOTH ? list<array<string|int, mixed>> : ($mode is PDO::FETCH_OBJ ? list<\\stdClass> : ($mode is PDO::FETCH_NAMED ? list<array<string, mixed>> : list<mixed>))))))) attribute <b>PDO::ATTR_ERRMODE</b> is set to <b>PDO::ERRMODE_EXCEPTION</b>. /","params":[{"name":"mode","declared_type":"int","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null}],"return_type":"($mode is PDO::FETCH_COLUMN ? list<mixed>","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fetchColumn","fqn":"PDOStatement::fetchColumn","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":80639,"end":80650}},"declared_type":null,"signature":{"parameters":[{"name":"column","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.9.0)<br/> Returns a single column from the next row of a result set 0-indexed number of the column you wish to retrieve from the row. If no value is supplied, <b>PDOStatement::fetchColumn</b> fetches the first column. </p> set or FALSE if there are no more rows. </p> <p> There is no way to return another column from the same row if you use <b>PDOStatement::fetchColumn</b> to retrieve data. /","params":[{"name":"column","declared_type":"int","description":"[optional] <p>"}],"return_type":"mixed","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fetchObject","fqn":"PDOStatement::fetchObject","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":84914,"end":84925}},"declared_type":null,"signature":{"parameters":[{"name":"class","declared_type":null,"phpdoc_type":"class-string<T>","optional":true,"variadic":false,"by_reference":false},{"name":"constructorArgs","declared_type":null,"phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"object|false","phpdoc_return_type":"T|stdClass|null"},"documentation":{"description":"Fetches the next row and returns it as an object Fetches the next row and returns it as an object. This function is an alternative to PDOStatement::fetch with PDO::FETCH_CLASS or PDO::FETCH_OBJ style. (PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.2.4)<br/> Fetches the next row and returns it as an object. Name of the created class. </p> Elements of this array are passed to the constructor. </p> correspond to the column names or <b>FALSE</b> on failure. /","params":[{"name":"class","declared_type":"class-string<T>","description":"[optional] <p>"},{"name":"constructorArgs","declared_type":"array","description":"[optional] <p>"}],"return_type":"T|stdClass|null","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getAttribute","fqn":"PDOStatement::getAttribute","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":87823,"end":87835}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.2.0)<br/> Retrieve a statement attribute /","params":[{"name":"name","declared_type":"int","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getColumnMeta","fqn":"PDOStatement::getColumnMeta","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":91102,"end":91115}},"declared_type":null,"signature":{"parameters":[{"name":"column","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.2.0)<br/> Returns metadata for a column in a result set The 0-indexed column in the result set. </p> the metadata for a single column: </p> <table> Column metadata <tr valign=\"top\"> <td>Name</td> <td>Value</td> </tr> <tr valign=\"top\"> <td>native_type</td> <td>The PHP native type used to represent the column value.</td> </tr> <tr valign=\"top\"> <td>driver:decl_type</td> <td>The SQL type used to represent the column value in the database. If the column in the result set is the result of a function, this value is not returned by <b>PDOStatement::getColumnMeta</b>. </td> </tr> <tr valign=\"top\"> <td>flags</td> <td>Any flags set for this column.</td> </tr> <tr valign=\"top\"> <td>name</td> <td>The name of this column as returned by the database.</td> </tr> <tr valign=\"top\"> <td>table</td> <td>The name of this column's table as returned by the database.</td> </tr> <tr valign=\"top\"> <td>len</td> <td>The length of this column. Normally -1 for types other than floating point decimals.</td> </tr> <tr valign=\"top\"> <td>precision</td> <td>The numeric precision of this column. Normally 0 for types other than floating point decimals.</td> </tr> <tr valign=\"top\"> <td>pdo_type</td> <td>The type of this column as represented by the PDO::PARAM_* constants.</td> </tr> </table> <p> Returns <b>FALSE</b> if the requested column does not exist in the result set, or if no result set exists. /","params":[{"name":"column","declared_type":"int","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getIterator","fqn":"PDOStatement::getIterator","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":93534,"end":93545}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"Iterator","phpdoc_return_type":"Iterator"},"documentation":{"description":