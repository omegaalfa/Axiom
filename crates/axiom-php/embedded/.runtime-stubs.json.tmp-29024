e}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"SoapHeader constructor The namespace of the SOAP header element. </p> The name of the SoapHeader object. </p> A SOAP header's content. It can be a PHP value or a <b>SoapVar</b> object. </p> Value of the actor attribute of the SOAP header element. </p> /","params":[{"name":"namespace","declared_type":"string","description":"<p>"},{"name":"name","declared_type":"string","description":"<p>"},{"name":"data","declared_type":"mixed","description":"[optional] <p>"},{"name":"mustunderstand","declared_type":"bool","description":"[optional]"},{"name":"actor","declared_type":"string","description":"[optional] <p>"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"SoapParam::__construct","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":34141,"end":34152}},"declared_type":null,"signature":{"parameters":[{"name":"data","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"SoapParam constructor The data to pass or return. This parameter can be passed directly as PHP value, but in this case it will be named as paramN and the SOAP service may not understand it. </p> The parameter name. </p> /","params":[{"name":"data","declared_type":"mixed","description":"<p>"},{"name":"name","declared_type":"string","description":"<p>"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"SoapParam","fqn":"SoapParam::SoapParam","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.ph