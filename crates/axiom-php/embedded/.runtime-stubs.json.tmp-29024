":168269,"end":168273}},"declared_type":null,"signature":null,"documentation":{"description":"A PHP representation of the CQL `inet` datatype /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Map","fqn":"Cassandra\\Map","kind":"Class","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":148378,"end":148381}},"declared_type":null,"signature":null,"documentation":{"description":"A PHP representation of the CQL `map` datatype /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"MaterializedView","fqn":"Cassandra\\MaterializedView","kind":"Class","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":123818,"end":123834}},"declared_type":null,"signature":null,"documentation":{"description":"A PHP representation of a materialized view /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PreparedStatement","fqn":"Cassandra\\PreparedStatement","kind":"Class","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":191960,"end":191977}},"declared_type":null,"signature":null,"documentation":{"description":"Prepared statements are faster to execute because the server doesn't need to process a statement's CQL during the execution. With token-awareness enabled in the driver, prepared statements are even faster, because they are sent directly to replica nodes and avoid the extra network hop. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"DefaultPolicy","fqn":"Cassandra\\RetryPolicy\\DefaultPolicy","kind":"Class","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":216198,"end":216211}},"declared_type":null,"signature":null,"documentation":{"description":"The default retry policy. This policy retries a query, using the request's original consistency level, in the following cases: * On a read timeout, if enough replicas replied but the data was not received. * On a write timeout, if a timeout occurs while writing a distributed batch log. * On unavailable, it will move to the next host. In all other cases the error will be returned. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"DowngradingConsistency","fqn":"Cassandra\\RetryPolicy\\DowngradingConsistency","kind":"Class","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":217594,"end":217616}},"declared_type":null,"signature":null,"documentation":{"description":"A retry policy that will downgrade the consistency of a request in an attempt to save a request in cases where there is any chance of success. A write request will succeed if there is at least a single copy persisted and a read request will succeed if there is some data available even if it increases the risk of reading stale data. This policy will retry in the same scenarios as the default policy, and it will also retry in the following case: * On a read timeout, if some replicas responded but is lower than required by the current consistency level then retry with a lower consistency level * On a write timeout, Retry unlogged batches at a lower consistency level if at least one replica responded. For single queries and batch if any replicas responded then consider the request successful and swallow the error. * On unavailable, retry at a lower consistency if at lease one replica responded. Important: This policy may attempt to retry requests with a lower consistency level. Using this policy can break consistency guarantees. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Fallthrough","fqn":"Cassandra\\RetryPolicy\\Fallthrough","kind":"Class","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":217881,"end":217892}},"declared_type":null,"signature":null,"documentation":{"description":"A retry policy that never retries and allows all errors to fallthrough. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Logging","fqn":"Cassandra\\RetryPolicy\\Logging","kind":"Class","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":218141,"end":218148}},"declared_type":null,"signature":null,"documentation":{"description":"A retry policy that logs the decisions of its child policy. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Rows","fqn":"Cassandra\\Rows","kind":"Class","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":57189,"end":57193}},"declared_type":null,"signature":null,"documentation":{"description":"Rows represent a result of statement execution. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Set","fqn":"Cassandra\\Set","kind":"Class","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":99036,"end":99039}},"declared_type":null,"signature":null,"documentation":{"description":"A PHP representation of the CQL `set` datatype /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availa