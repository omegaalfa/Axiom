hen a document has gone over the maximum size allowed by the server. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"VARIANT","fqn":"VARIANT","kind":"Class","origin":"PhpRuntime","extension":"com_dotnet","location":{"file":"com_dotnet/com_dotnet.php","range":{"start":1667,"end":1674}},"declared_type":null,"signature":null,"documentation":{"description":"The VARIANT is COM's equivalent of the PHP zval; it is a structure that can contain a value with a range of different possible types. The VARIANT class provided by the COM extension allows you to have more control over the way that PHP passes values to and from COM. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Vector","fqn":"Vector","kind":"Class","origin":"PhpRuntime","extension":"ds","location":{"file":"ds/ds.php","range":{"start":19997,"end":20003}},"declared_type":null,"signature":null,"documentation":{"description":"A Vector is a sequence of values in a contiguous buffer that grows and shrinks automatically. It’s the most efficient sequential structure because a value’s index is a direct mapping to its index in the buffer, and the growth factor isn't bound to a specific multiple or exponent. <br><br> <p> <h3>Strengths <ul> <li>Supports array syntax (square brackets).</li> <li>Uses less overall memory than an array for the same number of values.</li> <li>Automatically frees allocated memory when its size drops low enough.</li> <li>Capacity does not have to be a power of 2.</li> <li>get(), set(), push(), pop() are all O(1)</li> </ul> </p> <h3>Weaknesses <ul> <li>shift(), unshift(), insert() and remove() are all O(n).</li> </ul> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"View","fqn":"View","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":59636,"end":59640}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"ViewException","fqn":"ViewException","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":17614,"end":17627}},"declared_type":null,"signature":null,"documentation":{"description":"Thrown for exceptions that originate from view operations. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ViewIndexManager","fqn":"ViewIndexManager","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":60167,"end":60183}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"ViewOptions","fqn":"ViewOptions","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":105884,"end":105895}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"ViewRow","fqn":"ViewRow","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":15103,"end":15110}},"declared_type":null,"signature":null,"documentation":{"description":"Object for accessing a row returned as a part of the results from a viery query. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Volatile","fqn":"Volatile","kind":"Class","origin":"PhpRuntime","extension":"pthreads","location":{"file":"pthreads/pthreads.php","range":{"start":18518,"end":18526}},"declared_type":null,"signature":null,"documentation":{"description":"(PECL pthreads &gt;= 3.0.0)<br/> The Volatile class is new to pthreads v3. Its introduction is a consequence of the new immutability semantics of Threaded members of Threaded classes. The Volatile class enables for mutability of its Threaded members, and is also used to store PHP arrays in Threaded contexts. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Warning","fqn":"Warning","kind":"Class","origin":"PhpRuntime","extension":"mysql_xdevapi","location":{"file":"mysql_xdevapi/mysql_xdevapi.php","range":{"start":52845,"end":52852}},"declared_type":null,"signature":null,"documentation":{"description":"Class Warning /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"WatchQueryIndexesOptions","fqn":"WatchQueryIndexesOptions","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":22767,"end":22791}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"WeakMap","fqn":"WeakMap","kind":"Class","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core_c.php","range":{"start":27839,"end":27846}},"declared_type":null,"signature":null,"documentation":{"description":"Weak maps allow creating a map from objects to arbitrary values (similar to SplObjectStorage) without preventing the objects that are used as keys from being garbage collected. If an object key is garbage collected, it will simply be removed from the map. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"WeakReference","fqn":"WeakReference","kind":"Class","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core_c.php","range":{"start":26357,"end":26370}},"declared_type":null,"signature":null,"documentation":{"description":"Weak references allow the programmer to retain a reference to an object which does not prevent the object from being destroyed. They are useful for implementing cache like structures. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"webObj","fqn":"webObj","kind":"Class","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":114725,"end":114731}},"declared_type":null,"signature":null,"documentation":{"description":"Instances of webObj are always are always embedded inside the `mapObj`_. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"WildcardSearchQuery","fqn":"WildcardSearchQuery","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":84576,"end":84595}},"declared_type":null,"signature":null,"documentation":{"description":"A FTS query that allows for simple matching using wildcard characters (* and ?). /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Worker","fqn":"Worker","kind":"Class","origin":"PhpRuntime","extension":"pthreads","location":{"file":"pthreads/pthreads.php","range":{"start":15345,"end":15351}},"declared_type":null,"signature":null,"documentation":{"description":"(PECL pthreads &gt;= 2.0.0)<br/> Worker Threads have a persistent context, as such should be used over Threads in most cases.<br/> When a Worker is started, the run method will be executed, but the Thread will not leave until one of the following conditions are met:<br/><ul> <li>the Worker goes out of scope (no more references remain)</li> <li>the programmer calls shutdown</li> <li>the script dies</li></ul> This means the programmer can reuse the context throughout execution; placing objects on the stack of the Worker will cause the Worker to execute the stacked objects run method. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"WriteConcern","fqn":"WriteConcern","kind":"Class","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/WriteConcern.php","range":{"start":278,"end":290}},"declared_type":null,"signature":null,"documentation":{"description":"WriteConcern controls the acknowledgment of a write operation, specifies the level of write guarantee for Replica Sets. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"WriteConcernError","fqn":"WriteConcernError","kind":"Class","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/WriteConcernError.php","range":{"start":306,"end":323}},"declared_type":null,"signature":null,"documentation":{"description":"The MongoDB\\Driver\\WriteConcernError class encapsulates information about a write concern error and may be returned by MongoDB\\Driver\\WriteResult::getWriteConcernError(). /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"WriteConcernException","fqn":"WriteConcernException","kind":"Class","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/Exception/WriteConcernException.php","range":{"start":50,"end":71}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"WriteError","fqn":"WriteError","kind":"Class","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/WriteError.php","range":{"start":229,"end