:null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Get current system status flush tables and queries per second. For a complete list of other status variables, you have to use the SHOW STATUS SQL command. If <i>link_identifier</i> is invalid, null is returned. /","params":[{"name":"link_identifier","declared_type":"resource","description":"[optional]"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_table_name","fqn":"mysql_table_name","kind":"Function","origin":"PhpRuntime","extension":"mysql","location":{"file":"mysql/mysql.php","range":{"start":31807,"end":31823}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"row","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"field","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"/","params":[{"name":"result","declared_type":null,"description":null},{"name":"row","declared_type":null,"description":null},{"name":"field","declared_type":null,"description":"[optional]"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_tablename","fqn":"mysql_tablename","kind":"Function","origin":"PhpRuntime","extension":"mysql","location":{"file":"mysql/mysql.php","range":{"start":31652,"end":31667}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"i","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Get table name of field A result pointer resource that's returned from <b>mysql_list_tables</b>. </p> The integer index (row/table number) </p> <p> Use the <b>mysql_tablename</b> function to traverse this result pointer, or any function for result tables, such as <b>mysql_fetch_array</b>. </p> /","params":[{"name":"result","declared_type":"resource","description":"<p>"},{"name":"i","declared_type":"int","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_thread_id","fqn":"mysql_thread_id","kind":"Function","origin":"PhpRuntime","extension":"mysql","location":{"file":"mysql/mysql.php","range":{"start":24293,"end":24308}},"declared_type":null,"signature":{"parameters":[{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"Return the current thread ID /","params":[{"name":"link_identifier","declared_type":"resource","description":"[optional]"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_unbuffered_query","fqn":"mysql_unbuffered_query","kind":"Function","origin":"PhpRuntime","extension":"mysql","location":{"file":"mysql/mysql.php","range":{"start":7130,"end":7152}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|bool"},"documentation":{"description":"Send an SQL query to MySQL without fetching and buffering the result rows mysql_unbuffered_query sends the SQL query query to MySQL without automatically fetching and buffering the result rows as mysql_query does. This saves a considerable amount of memory with SQL queries that produce large result sets, and you can start working on the result set immediately after the first row has been retrieved as you don't have to wait until the complete SQL query has been performed. To use mysql_unbuffered_query while multiple database connections are open, you must specify the optional parameter link_identifier to identify which connection you want to use. Send an SQL query to MySQL without fetching and buffering the result rows. The SQL query to execute. </p> <p> Data inside the query should be properly escaped. </p> <b>mysql_unbuffered_query</b> returns a resource on success, or false on error. </p> <p> For other type of SQL statements, UPDATE, DELETE, DROP, etc, <b>mysql_unbuffered_query</b> returns true on success or false on error. /","params":[{"name":"query","declared_type":"string","description":"<p>"},{"name":"link_identifier","declared_type":"resource","description":"[optional]"}],"return_type":"resource|bool","var_type":null,"throws":[],"deprecated":"5.5"},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysqli_affected_rows","fqn":"mysqli_affected_rows","kind":"Function","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":64978,"end":64998}},"declared_type":null,"signature":{"parameters":[{"name":"mysql","declared_type":"mysqli","phpdoc_type":"mysqli","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|int","phpdoc_return_type":"string|int"},"documentation":{"description":"Gets the number of affected rows in a previous MySQL operation Zero indicates that no records were updated for an UPDATE statement, no rows matched the WHERE clause in the query or that no query has yet been executed. -1 indicates that the query returned an error or that <b>mysqli_affected_rows</b> was called for an unbuffered SELECT query. /","params":[{"name":"mysql","declared_type":"mysqli","description":"A link identifier returned by mysqli_connect() or mysqli_init()"}],"return_type":"string|int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysqli_autocommit","fqn":"mysqli_autocommit","kind":"Function","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":65328,"end":65345}},"declared_type":null,"signature":{"parameters":[{"name":"mysql","declared_type":"mysqli","phpdoc_type":"mysqli","optional":false,"variadic":false,"by_reference":false},{"name":"enable","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Turns on or off auto-committing database modifications /","params":[{"name":"mysql","declared_type":"mysqli","description":"A link identifier returned by mysqli_connect() or mysqli_init()"},{"name":"enable","declared_type":"bool","description":"Whether to turn on auto-commit or not."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysqli_begin_transaction","fqn":"mysqli_begin_transaction","kind":"Function","origin":"PhpRuntime","extension":"mysqli","location":{"file":"mysqli/mysqli.php","range":{"start":65716,"end":65740}},"declared_type":null,"signature":{"parameters":[{"name":"mysql","declared_type":"mysqli","phpdoc_type":"mysqli","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"name","declared_type":"?string","phpdoc_type":"string|null","optional":true,"var