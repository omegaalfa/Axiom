and delete operations needed to transform str1 into str2. Note: A second variant will take three additional parameters that define the cost of insert, replace and delete operations. This is more general and adaptive than variant one, but not as efficient. One of the strings being evaluated for Levenshtein distance. </p> One of the strings being evaluated for Levenshtein distance. </p> Defines the cost of insertion. </p> Defines the cost of replacement. </p> Defines the cost of deletion. </p> two argument strings or -1, if one of the argument strings is longer than the limit of 255 characters. /","params":[{"name":"string1","declared_type":"string","description":"<p>"},{"name":"string2","declared_type":"string","description":"<p>"},{"name":"insertion_cost","declared_type":"int","description":"[optional] <p>"},{"name":"replacement_cost","declared_type":"int","description":"[optional] <p>"},{"name":"deletion_cost","declared_type":"int","description":"[optional] <p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"library_version_major","fqn":"library_version_major","kind":"Function","origin":"PhpRuntime","extension":"libsodium","location":{"file":"libsodium/libsodium.php","range":{"start":14797,"end":14818}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Get the true major version of libsodium /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"library_version_minor","fqn":"library_version_minor","kind":"Function","origin":"PhpRuntime","extension":"libsodium","location":{"file":"libsodium/libsodium.php","range":{"start":14905,"end":14926}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Get the true 