e,"by_reference":false},{"name":"privateKey","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"(PHP &gt;= 5.3.0, PECL phar &gt;= 1.1.0)<br/> set the signature algorithm for a phar and apply it. One of Phar::MD5, Phar::SHA1, Phar::SHA256, Phar::SHA512, or Phar::OPENSSL </p> The contents of an OpenSSL private key, as extracted from a certificate or OpenSSL key file: <code> $private = openssl_get_privatekey(file_get_contents('private.pem')); $pkey = ''; openssl_pkey_export($private, $pkey); $p->setSignatureAlgorithm(Phar::OPENSSL, $pkey); </code> See phar introduction for instructions on naming and placement of the public key file. </p> if any problems occur flushing changes to disk. /","params":[{"name":"algo","declared_type":"int","description":"<p>"},{"name":"privateKey","declared_type":"string","description":"[optional] <p>"}],"return_type":"void","var_type":null,"throws":["\\UnexpectedValueException","\\BadMethodCallException","\\PharException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setStub","fqn":"PharData::setStub","kind":"Method","origin":"PhpRuntime","extension":"Phar","location":{"file":"Phar/Phar.php","range":{"start":77742,"end":77749}},"declared_type":null,"signature":{"parameters":[{"name":"stub","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP &gt;= 5.3.0, PECL phar &gt;= 1.0.0)<br/> Used to set the PHP loader or bootstrap stub of a Phar archive A string or an open stream handle to use as the executable stub for this phar archive. </p> </p> /","params":[{"name":"stub","declared_type":"string","description":"<p