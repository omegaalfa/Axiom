ilure.</p> /","params":[{"name":"name","declared_type":"string","description":"<p>Lua variable name.</p>"},{"name":"arguments","declared_type":"mixed[]","description":"<p>Arguments to the function.</p>"}],"return_type":"array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"disableProfiler","fqn":"LuaSandbox::disableProfiler","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":2244,"end":2259}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Disable the profiler. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"enableProfiler","fqn":"LuaSandbox::enableProfiler","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":2965,"end":2979}},"declared_type":null,"signature":{"parameters":[{"name":"period","declared_type":null,"phpdoc_type":"float","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Enable the profiler. <p>The profiler periodically samples the Lua environment to record the running function. Testing indicates that at least on Linux, setting a period less than 1ms will lead to a high overrun count but no performance problems.</p> /","params":[{"name":"period","declared_type":"float","description":"[optional] <p>Sampling period in seconds.</p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getCPUUsage","fqn":"LuaSandbox::getCPUUsage","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":3741,"end":3752}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"float"},"documentation":{"description":"Fetch the current CPU time usage of the Lua environment. <p>This includes time spent in PHP callbacks.</p> <p>Note: On Windows, this function always returns zero. On operating systems that do not support <i>CLOCK_THREAD_CPUTIME_ID</i>, such as FreeBSD and Mac OS X, this function will return the elapsed wall-clock time, not CPU time.</p> /","params":[],"return_type":"float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getMemoryUsage","fqn":"LuaSandbox::getMemoryUsage","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":4110,"end":4124}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Fetch the current memory usage of the Lua environment. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getPeakMemoryUsage","fqn":"LuaSandbox::getPeakMemoryUsage","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":4533,"end":4551}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Fetch the peak memory usage of the Lua environment. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getProfilerFunctionReport","fqn":"LuaSandbox::getProfilerFunctionReport","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":5935,"end":5960}},"declared_type":null,"signature":{"parameters":[{"name":"units","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Fetch profiler data. <p>For a profiling instance previously started by <code>LuaSandbox::enableProfiler()</code>, get a report of the cost of each function.</p> <p>The measurement unit used for the cost is determined by the $units parameter:</p> <li><code>LuaSandbox::SAMPLES</code> Measure in number of samples.</li> <li><code>LuaSandbox::SECONDS</code> Measure in seconds of CPU time.</li> <li><code>LuaSandbox::PERCENT</code> Measure percentage of CPU time.</li> <p>Note: On Windows, this function always returns an empty array. On operating systems that do not support <i>CLOCK_THREAD_CPUTIME_ID</i>, such as FreeBSD and Mac OS X, this function will report the elapsed wall-clock time, not CPU time.</p> Keys are the Lua function names (with source file and line defined in angle brackets), values are the measurements as integer or float.</p> /","params":[{"name":"units","declared_type":"int","description":"Measurement unit constant."}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getVersionInfo","fqn":"LuaSandbox::getVersionInfo","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":6462,"end":6476}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Return the versions of LuaSandbox and Lua. <li>LuaSandbox (string), the version of the LuaSandbox extension.</li> <li>Lua (string), the library name and version as defined by the LUA_RELEASE macro, for example, \"Lua 5.1.5\".</li> /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"loadBinary","fqn":"LuaSandbox::loadBinary","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":7016,"end":7026}},"declared_type":null,"signature":{"parameters":[{"name":"code","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"chunkName","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"LuaSandboxFunction"},"documentation":{"description":"Load a precompiled binary chunk into the Lua environment. <p>Loads data generated by <code>LuaSandboxFunction::dump()</code>.</p> /","params":[{"name":"code","declared_type":"string","description":"<p>Data from <code>LuaSandboxFunction::dump()</code>.</p>"},{"name":"chunkName","declared_type":"string","description":"[optional] <p>Name for the loaded function.</p>"}],"return_type":"LuaSandboxFunction","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"loadString","fqn":"LuaSandbox::loadString","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":7732,"end":7742}},"declared_type":null,"signature":{"parameters":[{"name":"code","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"chunkName","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"LuaSandboxFunction"},"documentation":{"description":"Load Lua code into the Lua environment. <p>This is the equivalent of standard Lua's <code>loadstring()</code> function.</p> will execute the passed <code>$code</code>.</p> /","params":[{"name":"code","declared_type":"string","description":"<p>Lua code.</p>"},{"name":"chunkName","declared_type":"string","description":"[optional] <p>Name for the loaded chunk, for use in error traces.</p>"}],"return_type":"LuaSandboxFunction","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pauseUsageTimer","fqn":"LuaSandbox::pauseUsageTimer","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":8758,"end":8773}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Pause the CPU usage timer. <p>This only has effect when called from within a callback from Lua. When execution returns to Lua, the timer will be automatically unpaused. If a new call into Lua is made, the timer will be unpaused for the duration of that call.</p> <p>If a PHP callback calls into Lua again with timer not paused, and then that Lua function calls into PHP again, the second PHP call will not be able to pause the timer. The logic is that even though the second PHP call would avoid counting the CPU usage against the limit, the first call still counts it.</p> /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"registerLibrary","fqn":"LuaSandbox::registerLibrary","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":9715,"end":9730}},"declared_type":null,"signature":{"parameters":[{"name":"libname","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"functions","declared_type":null,"phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Register a set of PHP functions as a Lua library. <p>Registers a set of PHP functions as a Lua library, so that Lua can call the relevant PHP code.</p> <p>For more information about calling Lua functions and the return values, see <code>LuaSandboxFunction::call()</code>.</p> In the Lua state, the global variable of this name will be set to the table of functions. If the table already exists, the new functions will be added to it.</p> and each value is a corresponding PHP callable.</p> /","params":[{"name":"libname","declared_type":"string","description":"<p>The name of the library."},{"name":"functions","declared_type":"array","description":"<p>Returns an array, where each key is a function name,"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setCPULimit","fqn":"LuaSandbox::setCPULimit","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":10799,"end":10810}},"declared_type":null,"signature":{"parameters":[{"name":"limit","declared_type":null,"phpdoc_type":"bool|float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Set the CPU time limit for the Lua environment. <p>If the total user and system time used by the environment after the call to this method exceeds this limit, a <code>LuaSandboxTimeoutError</code> exception is thrown.</p> <p>Time used in PHP callbacks is included in the limit.</p> <p>Setting the time limit from a callback while Lua is running causes the timer to be reset, or started if it was not already running.</p> <p>Note: On Windows, the CPU limit will be ignored. On operating systems that do not support <i>CLOCK_THREAD_CPUTIME_ID</i>, such as FreeBSD and Mac OS X, wall-clock time rather than CPU time will be limited.</p> /","params":[{"name":"limit","declared_type":"bool|float","description":"<p>Limit as a float in seconds, or false for no limit.</p>"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setMemoryLimit","fqn":"LuaSandbox::setMemoryLimit","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":11296,"end":11310}},"declared_type":null,"signature":{"parameters":[{"name":"limit","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Set the memory limit for the Lua environment. /","params":[{"name":"limit","declared_type":"int","description":"<p>Memory limit in bytes.</p>"}],"return_type":null,"var_type":null,"throws":["LuaSandboxMemoryError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"unpauseUsageTimer","fqn":"LuaSandbox::unpauseUsageTimer","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":11637,"end":11654}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Unpause the timer paused by <code>LuaSandbox::pauseUsageTimer()</code>. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wrapPhpFunction","fqn":"LuaSandbox::wrapPhpFunction","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":12689,"end":12704}},"declared_type":null,"signature":{"parameters":[{"name":"function","declared_type":null,"phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"LuaSandboxFunction"},"documentation":{"description":"Wrap a PHP callable in a LuaSandboxFunction. <p>Wraps a PHP callable in a <code>LuaSandboxFunction</code>, so it can be passed into Lua as an anonymous function.</p> <p>The function must return either an array of values (which may be empty), or NULL which is equivalent to returning the empty array.</p> <p>Exceptions will be raised as errors in Lua, however only <code>LuaSandboxRuntimeError<code> exceptions may be caught inside Lua with <code>pcall()<code/> or <code>xpcall()<code/>.</p> <p>For more information about calling Lua functions and the return values, see <code>LuaSandboxFunction::call()</code>.</p> /","params":[{"name":"function","declared_type":"callable","description":"<p>Callable to wrap.</p>"}],"return_type":"LuaSandboxFunction","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"call","fqn":"LuaSandboxFunction::call","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":15899,"end":15903}},"declared_type":null,"signature":{"parameters":[{"name":"args","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|bool"},"documentation":{"description":"Call a Lua function. <p>Errors considered to be the fault of the PHP code will result in the function returning false and <i>E_WARNING</i> being raised, for example, a resource type being used as an argument. Lua errors will result in a LuaSandboxRuntimeError exception being thrown.</p> <p>PHP and Lua types are converted as follows:</p> <ul> <li>PHP NULL is Lua nil, and vice versa.</li> <li>PHP integers and floats are converted to Lua numbers. Infinity and NAN are supported.</li> <li>Lua numbers without a fractional part between approximately -2**53 and 2**53 are converted to PHP integers, with others being converted to PHP floats.</li> <li>PHP booleans are Lua booleans, and vice versa.</li> <li>PHP strings are Lua strings, and vice versa.</li> <li>Lua functions are PHP LuaSandboxFunction objects, and vice versa. General PHP callables are not supported.</li> <li>PHP arrays are converted to Lua tables, and vice versa.</li> <ul> <li>Note that Lua typically indexes arrays from 1, while PHP indexes arrays from 0. No adjustment is made for these differing conventions.</li> <li>Self-referential arrays are not supported in either direction.</li> <li>PHP references are dereferenced.</li> <li>Lua <i>__pairs</i> and <i>__ipairs</i> are processed. <i>__index</i> is ignored.</li> <li>When converting from PHP to Lua, integer keys between -2**53 and 2**53 are represented as Lua numbers. All other keys are represented as Lua strings.</li> <li>When converting from Lua to PHP, keys other than strings and numbers will result in an error, as will collisions when converting numbers to strings or vice versa (since PHP considers things like <code>$a[0]</code> and <code>$a[\"0\"]</code> as being equivalent).</li> </ul> <li>All other types are unsupported and will raise an error/exception, including general PHP objects and Lua userdata and thread types.</li> </ul> <p>Lua functions inherently return a list of results. So on success, this method returns an array containing all of the values returned by Lua, with integer keys starting from zero. Lua may return no results, in which case an empty array is returned.</p> which may be empty, or false on error.</p> /","params":[{"name":"arguments","declared_type":"string[]","description":"<p>Arguments passed to the function.</p>"}],"return_type":"array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dump","fqn":"LuaSandboxFunction::dump","kind":"Method","origin":"PhpRuntime","extension":"LuaSandbox","location":{"file":"LuaSandbox/LuaSandbox.php","range":{"start":16223,"end":16227}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Dump the function as a binary blob. /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"MAC::__construct","kind":"Method","origin":"PhpRuntime","extension":"crypto","location":{"file":"crypto/crypto.php","range":{"start":9533,"end":9544}},"declared_type":null,"signature":{"parameters":[{"name":"algorithm","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Create a MAC (used by MAC subclasses - HMAC and CMAC) /","params":[{"name":"algorithm","declared_type":"string","description":null},{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"Manager::__construct","kind":"Method","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/Manager.php","range":{"start":1722,"end":1733}},"declared_type":null,"signature":{"parameters":[{"name":"uri","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"uriOptions","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"driverOptions","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Manager constructor. /","params":[{"name":"uri","declared_type":"string|null","description":"A mongodb:// connection URI"},{"name":"uriOptions","declared_type":"array|null","description":"Connection string options"},{"name":"driverOptions","declared_type":"array|null","description":"Any driver-specific options not include