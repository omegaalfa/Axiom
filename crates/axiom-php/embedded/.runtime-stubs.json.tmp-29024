ed output is the same. </p> /","params":[{"name":"data","declared_type":"string","description":"<p>"},{"name":"block_size","declared_type":"int","description":"<p>"},{"name":"work_factor","declared_type":"int","description":"[optional] <p>"}],"return_type":"string|int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bzdecompress","fqn":"bzdecompress","kind":"Function","origin":"PhpRuntime","extension":"bz2","location":{"file":"bz2/bz2.php","range":{"start":5673,"end":5685}},"declared_type":null,"signature":{"parameters":[{"name":"data","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"use_less_memory","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|int|false","phpdoc_return_type":"string|int|false"},"documentation":{"description":"Decompresses bzip2 encoded data The string to decompress. </p> If <b>TRUE</b>, an alternative decompression algorithm will be used which uses less memory (the maximum memory requirement drops to around 2300K) but works at roughly half the speed. </p> <p> See the bzip2 documentation for more information about this feature. </p> /","params":[{"name":"data","declared_type":"string","description":"<p>"},{"name":"use_less_memory","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bzerrno","fqn":"bzerrno","kind":"Function","origin":"PhpRuntime","extension":"bz2","location":{"file":"bz2/bz2.php","range":{"start":3029,"end":3036}},"declared_type":null,"signature":{"parameters":[{"name":"bz","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Retu