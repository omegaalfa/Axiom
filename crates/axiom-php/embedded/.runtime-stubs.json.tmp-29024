ption":"Test whether an archive is broken (incomplete) This function determines whether an archive is incomplete, i.e., if a volume is missing or a volume is truncated. the passed file has already been closed. The only way to tell the two cases apart is to enable exceptions with {@see RarException::setUsingExceptions()}; however, this should be unnecessary as a program should not operate on closed files. /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"isSolid","fqn":"RarArchive::isSolid","kind":"Method","origin":"PhpRuntime","extension":"rar","location":{"file":"rar/rar.php","range":{"start":3987,"end":3994}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Check whether the RAR archive is solid Check whether the RAR archive is solid. Individual file extraction is slower on solid archives /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"open","fqn":"RarArchive::open","kind":"Method","origin":"PhpRuntime","extension":"rar","location":{"file":"rar/rar.php","range":{"start":1794,"end":1798}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"password","declared_type":null,"phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false},{"name":"volume_callback","declared_type":"?callable","phpdoc_type":"null|callable","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"RarArchive|false"},"documentation":{"description":"Open RAR archive encrypted files are found. Note that the files may have different passwords in respect to the headers and among them not found – and returns a string with the correct path for such volume or NULL if such volume does not exist or is not known. The programmer should ensure the passed function doesn't cause loops as this function is called repeatedly if the path returned in a previous call did not correspond to the needed volume. Specifying this parameter omits the notice that would otherwise be emitted whenever a volume is not found; an implementation that only returns NULL can therefore be used to merely omit such notices /","params":[{"name":"filename","declared_type":"string","description":"Path to the Rar archive"},{"name":"password","declared_type":"null|string","description":"A plain password, if needed to decrypt the headers. It will also be used by default if"},{"name":"volume_callback","declared_type":"null|callable","description":"A function that receives one parameter – the path of the volume that was"}],"return_type":"RarArchive|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"setAllowBroken","fqn":"RarArchive::setAllowBroken","kind":"Method","origin":"PhpRuntime","extension":"rar","location":{"file":"rar/rar.php","range":{"start":4710,"end":4724}},"declared_type":null,"signature":{"parameters":[{"name":"allow_broken","declared_type":null,"phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Whether opening broken archives is allowed This method defines whether broken archives can be read or all the operations that attempt to extract the archive entries will fail. Broken archives are archives for which no error is detected when the file is opened but an error occurs when reading the entries. /","params":[{"name":"allow_broken","declared_type":"bool","description":"Whether to allow reading broken files (TRUE) or not (FALSE)"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since"