e":"int","phpdoc_return_type":"int"},"documentation":{"description":"Return the last multi curl error number /","params":[{"name":"multi_handle","declared_type":"CurlMultiHandle|resource","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"curl_multi_exec","fqn":"curl_multi_exec","kind":"Function","origin":"PhpRuntime","extension":"curl","location":{"file":"curl/curl.php","range":{"start":92610,"end":92625}},"declared_type":null,"signature":{"parameters":[{"name":"multi_handle","declared_type":null,"phpdoc_type":"CurlMultiHandle|resource","optional":false,"variadic":false,"by_reference":false},{"name":"still_running","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"still_running","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Run the sub-connections of the current cURL handle A reference to a flag to tell whether the operations are still running. </p> <p> This only returns errors regarding the whole multi stack. There might still have occurred problems on individual transfers even when this function returns CURLM_OK. </p> /","params":[{"name":"multi_handle","declared_type":"CurlMultiHandle|resource","description":null},{"name":"","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"curl_multi_get_handles","fqn":"curl_multi_get_handles","kind":"Function","origin":"PhpRuntime","extension":"curl","location":{"file":"curl/curl.php","range":{"start":95424,"end":95446}},"declared_type":null,"signature":{"parameters":[{"name":"multi_handle","declared_type":"CurlMultiHandle","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"decla