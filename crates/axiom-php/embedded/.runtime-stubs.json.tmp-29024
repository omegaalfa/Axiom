s_acct_open","kind":"Function","origin":"PhpRuntime","extension":"radius","location":{"file":"radius/radius.php","range":{"start":14442,"end":14458}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Creates a Radius handle for accounting /","params":[],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"radius_add_server","fqn":"radius_add_server","kind":"Function","origin":"PhpRuntime","extension":"radius","location":{"file":"radius/radius.php","range":{"start":16035,"end":16052}},"declared_type":null,"signature":{"parameters":[{"name":"radius_handle","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"hostname","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"secret","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"max_tries","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"<b>radius_add_server()</b> may be called multiple times, and it may be used together with {@see radius_config()}. At most 10 servers may be specified. When multiple servers are given, they are tried in round-robin fashion until a valid response is received, or until each server's max_tries limit has been reached. If port is given as 0, the library looks up the radius/udp or radacct/udp service in the network services database, and uses the port found there.<br> If no entry is found, the library uses the standard Radius ports, 1812 for authentication and 1813 for accounting. /","params":[{"name":"radius_handle","declared_type":"resource","description":null},{"name":"hostname","declared_type":"string","description":"The <b>hostname</b> parameter specifies the server host, either as a fully qualified domain name or as a dotted-quad IP address in text form."},{"name":"port","declared_type":"int","description":"The <b>port</b> specifies the UDP port to contact on the server.<br>"},{"name":"secret","declared_type":"string","description":"The shared secret for the server host is passed to the <b>secret</b> parameter. The Radius protocol ignores all but the leading 128 bytes of the shared secret."},{"name":"timeout","declared_type":"int","description":"The timeout for receiving replies from the server is passed to the <b>timeout</b> parameter, in units of seconds."},{"name":"max_tries","declared_type":"int","description":"The maximum number of repeated requests to make before giving up is passed into the <b>max_tries</b>."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"radius_auth_open","fqn":"radius_auth_open","kind":"Function","origin":"PhpRuntime","extension":"radius","location":{"file":"radius/radius.php","range":{"start":16413,"end":16429}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Creates a Radius handle for authentication /","params":[],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"radius_close","fqn":"radius_close","kind":"Function","origin":"PhpRuntime","extension":"radius","location":{"file":"radius/radius.php","range":{"start":16768,"end":16780}},"declared_type":null,"signature":{"parameters":[{"name":"radius_handle","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Free all resources. It is not needed to call this function because php frees all resources at the end of each request. /","params":[{"name":"radius_handle","declared_type":"resource","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"radius_config","fqn":"radius_config","kind":"Function","origin":"PhpRuntime","extension":"radius","location":{"file":"radius/radius.php","range":{"start":17612,"end":17625}},"declared_type":null,"signature":{"parameters":[{"name":"radius_handle","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"file","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Before issuing any Radius requests, the library must be made aware of the servers it can contact. The easiest way to configure the library is to call <b>radius_config()</b>. <b>radius_config()</b> causes the library to read a configuration file whose format is described in radius.conf. /","params":[{"name":"radius_handle","declared_type":"resource","description":null},{"name":"file","declared_type":"string","description":"The pathname of the configuration file is passed as the file argument to {@see radius_config()}. The library can also be configured programmatically by calls to <b>{@see radius_add_server()}</b>."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"radius_create_request","fqn":"radius_create_request","kind":"Function","origin":"PhpRuntime","extension":"radius","location":{"file":"radius/radius.php","rang