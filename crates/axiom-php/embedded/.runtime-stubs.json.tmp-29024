tion","origin":"PhpRuntime","extension":"ibm_db2","location":{"file":"ibm_db2/ibm_db2.php","range":{"start":55870,"end":55885}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"stdClass|false","phpdoc_return_type":"stdClass|false"},"documentation":{"description":"Returns an object with properties that describe the DB2 database client Specifies an active DB2 client connection. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"stdClass|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"db2_close","fqn":"db2_close","kind":"Function","origin":"PhpRuntime","extension":"ibm_db2","location":{"file":"ibm_db2/ibm_db2.php","range":{"start":6615,"end":6624}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Closes a database connection Specifies an active DB2 client connection. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"db2_column_privileges","fqn":"db2_column_privileges","kind":"Function","origin":"PhpRuntime","extension":"ibm_db2","location":{"file":"ibm_db2/ibm_db2.php","range":{"start":8494,"end":8515}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"qualifier","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"schema","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"table_name","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"column_name","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Returns a result set listing the columns and associated privileges for a table A valid connection to an IBM DB2, Cloudscape, or Apache Derby database. </p> A qualifier for DB2 databases running on OS/390 or z/OS servers. For other databases, pass null or an empty string. </p> The schema which contains the tables. To match all schemas, pass null or an empty string. </p> the column privileges for columns matching the specified parameters. The rows are composed of the following columns: <tr valign=\"top\"> <td>Column name</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>TABLE_CAT</td> <td>Name of the catalog. The value is NULL if this table does not have catalogs.</td> </tr> <tr valign=\"top\"> <td>TABLE_SCHEM</td> <td>Name of the schema.</td> </tr> <tr valign=\"top\"> <td>TABLE_NAME</td> <td>Name of the table or view.</td> </tr> <tr valign=\"top\"> <td>COLUMN_NAME</td> <td>Name of the column.</td> </tr> <tr valign=\"top\"> <td>GRANTOR</td> <td>Authorization ID of the user who granted the privilege.</td> </tr> <tr valign=\"top\"> <td>GRANTEE</td> <td>Authorization ID of the user to whom the privilege was granted.</td> </tr> <tr valign=\"top\"> <td>PRIVILEGE</td> <td>The privilege for the column.</td> </tr> <tr valign=\"top\"> <td>IS_GRANTABLE</td> <td>Whether the GRANTEE is permitted to grant this privilege to other users.</td> </tr> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"qualifier","declared_type":"string|null","description":"<p>"},{"name":"schema",