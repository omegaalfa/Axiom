"params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"CONSISTENCY_QUORUM","fqn":"Cassandra::CONSISTENCY_QUORUM","kind":"ClassConstant","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":3558,"end":3576}},"declared_type":null,"signature":null,"documentation":{"description":"Consistency level QUORUM guarantees that data has been written to at least the majority of Replica nodes. How many nodes exactly are a majority depends on the replication factor of a given keyspace and is calculated using the formula `ceil(RF / 2 + 1)`, where `ceil` is a mathematical ceiling function and `RF` is the replication factor used. For example, for a replication factor of `5`, the majority is `ceil(5 / 2 + 1) = 3`. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"CONSISTENCY_SERIAL","fqn":"Cassandra::CONSISTENCY_SERIAL","kind":"ClassConstant","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":5504,"end":5522}},"declared_type":null,"signature":null,"documentation":{"description":"This is a serial consistency level, it is used in conditional updates, e.g. (`CREATE|INSERT ... IF NOT EXISTS`), and should be specified as the `serial_consistency` execution option when invoking `session.execute` or `session.execute_async`. Consistency level SERIAL, when set, ensures that a Paxos commit fails if any of the replicas is down. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"CONSISTENCY_THREE","fqn":"Cassandra::CONSISTENCY_THREE","kind":"ClassConstant","origin":"PhpRuntime","extension":"cassandra","location":{"file":"cassandra/cassandra.php","range":{"start":2815,"end":2832}},"declared_type":