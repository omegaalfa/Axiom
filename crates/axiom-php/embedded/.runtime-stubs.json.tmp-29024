n":{"description":"Overrides PHP's default error handling. E_CORE_WARNING, E_COMPILE_ERROR, E_USER_ERROR, E_USER_WARNING, E_USER_NOTICE, E_STRICT, E_RECOVERABLE_ERROR, E_DEPRECATED, E_USER_DEPRECATED /","params":[{"name":"message","declared_type":"string","description":"Error message"},{"name":"errorType","declared_type":"int","description":"Error Type. Supported error types are: E_ERROR, E_WARNING, E_PARSE, E_NOTICE, E_CORE_ERROR,"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"trace_function","fqn":"DDTrace\\trace_function","kind":"Function","origin":"PhpRuntime","extension":"ddtrace","location":{"file":"ddtrace/ddtrace.stub.php","range":{"start":11934,"end":11948}},"declared_type":null,"signature":{"parameters":[{"name":"functionName","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"tracingClosureOrConfigArray","declared_type":"\\Closure|array|null","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Instrument (trace) a specific function call. This function automatically handle the following tasks: - Open a span before the code executes - Set any errors from the instrumented call on the span - Close the span when the instrumented call is done. Additional tags are set on the span from the closure (called a tracing closure). The tracing closure is a function that adds extra tags to the span after the instrumented call is executed. It accepts four parameters, namely, an instance of 'DDTrace\\SpanData' that writes to the span properties, an array of arguments from the instrumented call, the return value of the instrumented call, and an instance of the exception that was thrown in the instrumented call (if any), or 'null' if no exception was thrown. Alternatively, an associative configuration array can be given whose recognized keys are: - 'prehook': a closure to be run prior to the function call - 'posthook': a closure to be run after the function was executed - 'instrument_when_limited': set to 1 shall the function be traced in limited mode (e.g., when span limit exceeded) - 'recurse': a boolean to state whether should recursive calls be traced as well /","params":[{"name":"functionName","declared_type":"string","description":"The name of the function to trace."},{"name":"span,","declared_type":"null|\\Closure(SpanData","description":"array $args, mixed $retval, \\Exception|null $exception):void|array{prehook?: \\Closure, posthook?: \\Closure, instrument_when_limited?: int, recurse?: bool} $tracingClosureOrConfigArray"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"trace_id","fqn":"DDTrace\\trace_id","kind":"Function","origin":"PhpRuntime","extension":"ddtrace","location":{"file":"ddtrace/ddtrace.stub.php","range":{"start":23941,"end":23949}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Return the id of the current trace /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"trace_method","fqn":"DDTrace\\trace_method","kind":"Function","origin":"PhpRuntime","extension":"ddtrace","location":{"file":"ddtrace/ddtrace.stub.php","range":{"start":10077,"end":10089}},"declared_type":null,"signature":{"parameters":[{"name":"className","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"methodName","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"tracingClosureOrConfigArray","declared_type":"null|\\Closure|array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Instrument (trace) a specific method call. This function automatically handle the following tasks: - Open a span before the code executes - Set any errors from the instrumented call on the span - Close the span when the instrumented call is done. Additional tags are set on the span from the closure (called a tracing closure). The tracing closure is a function that adds extra tags to the span after the instrumented call is executed. It accepts four parameters, namely, an instance of 'DDTrace\\SpanData', an array of arguments from the instrumented call, the return value of the instrumented call, and an instance of the exception that was thrown in the instrumented call (if any), or 'null' if no exception was thrown. Alternatively, an associative configuration array can be given whose recognized keys are: - 'prehook': a closure to be run prior to the method call - 'posthook': a closure to be run after the method was executed - 'instrument_when_limited': set to 1 shall the method be traced in limited mode (e.g., when span limit exceeded) - 'recurse': a boolean to state whether should recursive calls be traced as well /","params":[{"name":"className","declared_type":"string","description":"The name of the class that contains the method."},{"name":"methodName","declared_type":"string","description":"The name of the method to instrument."},{"name":"span,","declared_type":"null|\\Closure(SpanData","description":"array $args, mixed $retval, \\Exception|null $exception):void|array{prehook?: \\Closure, posthook?: \\Closure, instrument_when_limited?: int, recurse?: bool} $tracingClosureOrConfigArray"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"update_span_duration","fqn":"DDTrace\\update_span_duration","kind":"Function","origin":"PhpRuntime","extension":"ddtrace"