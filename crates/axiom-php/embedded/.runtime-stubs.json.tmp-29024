027; means to return all mailboxes. If you pass <i>pattern</i> as &#x00027;*&#x00027;, you will get a list of the entire mailbox hierarchy. &#x00027;&#37;&#x00027; means to return the current level only. &#x00027;&#37;&#x00027; as the <i>pattern</i> parameter will return only the top level mailboxes; &#x00027;~/mail/&#37;&#x00027; on UW_IMAPD will return every mailbox in the ~/mail directory, but none in subfolders of that directory.</p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"reference","declared_type":"string","description":"<p>"},{"name":"pattern","declared_type":"string","description":"Specifies where in the mailbox hierarchy"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_listmailbox","fqn":"imap_listmailbox","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":53396,"end":53412}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"reference","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Alias of <b>imap_list</b> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"reference","declared_type":"string","description":null},{"name":"pattern","declared_type":"string","description":null}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_listscan","fqn":"imap_listscan","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":21784,"end":21797}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"reference","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"content","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Returns the list of mailboxes that matches the given text <i>ref</i> should normally be just the server specification as described in <b>imap_open</b> </p> to start searching.</p>There are two special characters you can pass as part of the <i>pattern</i>: &#x00027;*&#x00027; and &#x00027;&#37;&#x00027;. &#x00027;*&#x00027; means to return all mailboxes. If you pass <i>pattern</i> as &#x00027;*&#x00027;, you will get a list of the entire mailbox hierarchy. &#x00027;&#37;&#x00027; means to return the current level only. &#x00027;&#37;&#x00027; as the <i>pattern</i> parameter will return only the top level mailboxes; &#x00027;~/mail/&#37;&#x00027; on UW_IMAPD will return every mailbox in the ~/mail directory, but none in subfolders of that directory.</p> The searched string </p> <i>content</i> in the text of the mailbox. /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"reference","declared_type":"string","description":"<p>"},{"name":"pattern","declared_type":"string","description":"Specifies where in the mailbox hierarchy"},{"name":"content","declared_type":"string","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_listsub