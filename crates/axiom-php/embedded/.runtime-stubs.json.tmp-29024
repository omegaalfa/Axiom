8}},"declared_type":null,"signature":null,"documentation":{"description":"<p>Enable the use of the binary protocol. Please note that you cannot toggle this option on an open connection.</p> <p>Type: boolean, default: <b>FALSE</b>.</p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_BUFFER_WRITES","fqn":"Memcached::OPT_BUFFER_WRITES","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":7106,"end":7123}},"declared_type":null,"signature":null,"documentation":{"description":"<p>Enables or disables buffered I/O. Enabling buffered I/O causes storage commands to \"buffer\" instead of being sent. Any action that retrieves data causes this buffer to be sent to the remote connection. Quitting the connection or closing down the connection will also cause the buffered data to be pushed to the remote connection.</p> <p>Type: boolean, default: <b>FALSE</b>.</p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_CACHE_LOOKUPS","fqn":"Memcached::OPT_CACHE_LOOKUPS","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":10222,"end":10239}},"declared_type":null,"signature":null,"documentation":{"description":"<p>Enables or disables caching of DNS lookups.</p> <p>Type: boolean, default: <b>FALSE</b>.</p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_COMPRESSION","fqn":"Memcached::OPT_COMPRESSION","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":598,"end":613}},"declared_type":null,"signature":null,"documentation":{"description":"<p>Enables or disables payload compression. When enabled, item values longer than a certain threshold (currently 100 bytes) will be compressed during storage and decompressed during retrieval transparently.</p> <p>Type: boolean, default: <b>TRUE</b>.</p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_COMPRESSION_TYPE","fqn":"Memcached::OPT_COMPRESSION_TYPE","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":640,"end":660}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_CONNECT_TIMEOUT","fqn":"Memcached::OPT_CONNECT_TIMEOUT","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":8808,"end":8827}},"declared_type":null,"signature":null,"documentation":{"description":"<p>In non-blocking mode this set the value of the timeout during socket connection, in milliseconds.</p> <p>Type: integer, default: 1000.</p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_CORK","fqn":"Memcached::OPT_CORK","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":10928,"end":10936}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_DEAD_TIMEOUT","fqn":"Memcached::OPT_DEAD_TIMEOUT","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":11009,"end":11025}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_DISTRIBUTION","fqn":"Memcached::OPT_DISTRIBUTION","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":5281,"end":5297}},"declared_type":null,"signature":null,"documentation":{"description":"<p>Specifies the method of distributing item keys to the servers. Currently supported methods are modulo and consistent hashing. Consistent hashing delivers better distribution and allows servers to be added to the cluster with minimal cache losses.</p> <p>Type: integer, default: <b>Memcached::DISTRIBUTION_MODULA.</b></p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_HASH","fqn":"Memcached::OPT_HASH","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":3316,"end":3324}},"declared_type":null,"signature":null,"documentation":{"description":"<p>Specifies the hashing algorithm used for the item keys. The valid values are supplied via <b>Memcached::HASH_*</b> constants. Each hash algorithm has its advantages and its disadvantages. Go with the default if you don't know or don't care.</p> <p>Type: integer, default: <b>Memcached::HASH_DEFAULT</b></p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_HASH_WITH_PREFIX_KEY","fqn":"Memcached::OPT_HASH_WITH_PREFIX_KEY","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":10638,"end":10662}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_IO_BYTES_WATERMARK","fqn":"Memcached::OPT_IO_BYTES_WATERMARK","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":11128,"end":11150}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_IO_KEY_PREFETCH","fqn":"Memcached::OPT_IO_KEY_PREFETCH","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":11174,"end":11193}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_IO_MSG_WATERMARK","fqn":"Memcached::OPT_IO_MSG_WATERMARK","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":11217,"end":11237}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_LIBKETAMA_COMPATIBLE","fqn":"Memcached::OPT_LIBKETAMA_COMPATIBLE","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":6471,"end":6495}},"declared_type":null,"signature":null,"documentation":{"description":"<p>Enables or disables compatibility with libketama-like behavior. When enabled, the item key hashing algorithm is set to MD5 and distribution is set to be weighted consistent hashing distribution. This is useful because other libketama-based clients (Python, Ruby, etc.) with the same server configuration will be able to access the keys transparently. </p> <p> It is highly recommended to enable this option if you want to use consistent hashing, and it may be enabled by default in future releases. </p> <p>Type: boolean, default: <b>FALSE</b>.</p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_LIBKETAMA_HASH","fqn":"Memcached::OPT_LIBKETAMA_HASH","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":6519,"end":6537}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_LOAD_FROM_FILE","fqn":"Memcached::OPT_LOAD_FROM_FILE","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":11261,"end":11279}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_MAX","fqn":"Memcached::OPT_MAX","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":11097,"end":11104}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_NO_BLOCK","fqn":"Memcached::OPT_NO_BLOCK","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":7706,"end":7718}},"declared_type":null,"signature":null,"documentation":{"description":"<p>Enables or disables asynchronous I/O. This is the fastest transport available for storage functions.</p> <p>Type: boolean, default: <b>FALSE</b>.</p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_NOREPLY","fqn":"Memcached::OPT_NOREPLY","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":10686,"end":10697}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_NUMBER_OF_REPLICAS","fqn":"Memcached::OPT_NUMBER_OF_REPLICAS","kind":"ClassConstant","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":10832,"end":10854}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null