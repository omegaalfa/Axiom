eclared_type":"mixed","description":null},{"name":"timeout","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sGetMembers","fqn":"Redis::sGetMembers","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":5590,"end":5601}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sInter","fqn":"Redis::sInter","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":122015,"end":122021}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":null},"documentation":{"description":"Given one or more Redis SET keys, this command will return all of the elements that are in every one. $redis->pipeline() ->del('alice_likes', 'bob_likes', 'bill_likes') ->sadd('alice_likes', 'asparagus', 'broccoli', 'carrot', 'potato') ->sadd('bob_likes', 'asparagus', 'carrot', 'potato') ->sadd('bill_likes', 'broccoli', 'potato') ->exec(); var_dump($redis->sinter('alice_likes', 'bob_likes', 'bill_likes')); /","params":[{"name":"key","declared_type":"array|string","description":"The first SET key to intersect."},{"name":"other_k