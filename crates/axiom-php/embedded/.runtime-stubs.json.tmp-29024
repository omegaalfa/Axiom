TypeError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_jit","fqn":"pg_jit","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":87442,"end":87448}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":"?PgSql\\Connection","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array<string, string|null>"},"documentation":{"description":"Returns the JIT information of the server pg_jit returns an array with the JIT (Just-In-Time compilation) information of the PostgreSQL server. /","params":[],"return_type":"array<string, string|null>","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_last_error","fqn":"pg_last_error","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":46760,"end":46773}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Get the last error message string of a connection PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> given <i>connection</i>, or <b>FALSE</b> on error. /","params":[{"name":"connection","declared_type":"resource","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_last_notice","fqn":"pg_last_notice","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","rang