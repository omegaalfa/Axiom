e,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|array","phpdoc_return_type":null},"documentation":{"description":"Scan a sorted set for members, with optional pattern and count. <pre> $iterator = null; while ($members = $redis->zscan('zset', $iterator)) { foreach ($members as $member => $score) { echo $member . ' => ' . $score . PHP_EOL; } } </pre> /","params":[{"name":"key","declared_type":"string","description":"String, the set to scan."},{"name":"","declared_type":null,"description":null},{"name":"pattern","declared_type":"null|string","description":"String (optional), the pattern to match."},{"name":"count","declared_type":"int","description":"How many keys to return per iteration (Redis might return a different number)."}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zScore","fqn":"RedisCluster::zScore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":46983,"end":46989}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|float|false","phpdoc_return_type":null},"documentation":{"description":"Returns the score of a given member in the specified sorted set. <pre> $redisCluster->zAdd('key', 2.5, 'val2'); $redisCluster->zScore('key', 'val2'); // 2.5 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"member","declared_type":"mixed","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zunion","fqn":"RedisCluster::zunion","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":192248,"end":192254}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":"RedisCluster|array|false"},"documentation":{"description":"Compute the union of one or more sorted sets and return the result. /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted set key names."},{"name":"weights","declared_type":"array|null","description":"An optional array of weights to apply to each sorted set."},{"name":"options","declared_type":"array|null","description":"Options to modify how the command behaves (e.g. ['aggregate' => 'sum', 'withscores' => true])."}],"return_type":"RedisCluster|array|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zunionstore","fqn":"RedisCluster::zunionstore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":93871,"end":93882}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":"?array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false},{"name":"aggregate","declared_type":"?string","phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Add multiple sorted sets and store the resulting sorted set in a new key duplicate entries during the zUnion. <pre> $redisCluster->del('k1'); $redisCluster->del('k2'); $redisCluster->del('k3'); $redisCluster->del('ko1'); $redisCluster->del('ko2'); $redisCluster->del('ko3'); $redisCluster->zAdd('k1', 0, 'val0'); $redisCluster->zAdd('k1', 1, 'val1'); $redisCluster->zAdd('k2', 2, 'val2'); $redisCluster->zAdd('k2', 3, 'val3'); $redisCluster->zunionstore('ko1', array('k1', 'k2')); // 4, 'ko1' => array('val0', 'val1', 'val2', 'val3') // Weighted zunionstore $redisCluster->zunionstore('ko2', array('k1', 'k2'), array(1, 1)); // 4, 'ko2' => array('val0', 'val1', 'val2','val3') $redisCluster->zunionstore('ko3', array('k1', 'k2'), array(5, 1)); // 4, 'ko3' => array('val0', 'val2', 'val3','val1') </pre> /","params":[{"name":"dst","declared_type":"string","description":null},{"name":"keys","declared_type":"array","description":null},{"name":"weights","declared_type":"null|array","description":null},{"name":"aggregate","declared_type":"null|string","description":"Either \"SUM\", \"MIN\", or \"MAX\": defines the behaviour to use on"}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"RedisSentinel::__construct","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisSentinel.php","range":{"start":3138,"end":3149}},"declared_type":null,"signature":{"parameters":[{"name":"options_or_host","declared_type":"array|string|null","phpdoc_type":"array|string|null","optional":true,"variadic":false,"by_reference":false},{"name":"port","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"float","phpdoc_type":"float","optional":true,"variadic":false,"by_reference":false},{"name":"persistent","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"retryInterval","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"readTimeout","declared_type":"float","phpdoc_type":"float","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Creates a Redis Sentinel You can either pass an array of options (recommended >= 6.0.0) or separate parameters (legacy). Available options for array: - 'host'           => string, Sentinel IP address or hostname - 'port'           => int, Sentinel Port (optional, default is 26379) - 'connectTimeout' => float, Value in seconds (optional, default is 0 meaning unlimited) - 'persistent'     => string, Persistent connection id (optional, default is NULL meaning not persistent) - 'retryInterval'  => int, Value in milliseconds (optional, default is 0) - 'readTimeout'    => float, Value in seconds (optional, default is 0 meaning unlimited) - 'auth'           => string|array, Authentication credentials (optional, default is NULL meaning NOAUTH) /","params":[{"name":"options_or_host","declared_type":"array|string|null","description":"Associative array of options, or Sentinel IP address/hostname"},{"name":"port","declared_type":"int","description":"Sentinel Port (ignored if $options_or_host is an array)"},{"name":"timeout","declared_type":"float","description":"Value in seconds (optional, default is 0 meaning unlimited)"},{"name":"persistent","declared_type":"string|null","description":"Persistent connection id (optional, default is null meaning not persistent)"},{"name":"retryInterval","declared_type":"int","description":"Value in milliseconds (optional, default is 0)"},{"name":"readTimeout","declared_type":"float","description":"Value in seconds (optional, default is 0 meaning unlimited)"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ckquorum","fqn":"RedisSentinel::ckquorum","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisSentinel.php","range":{"start":3901,"end":3909}},"declared_type":null,"signature":{"parameters":[{"name":"master","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisSentinel|bool","phpdoc_return_type":"RedisSentinel|bool"},"documentation":{"description":"Check if the current Sentinel configuration is able to reach the quorum needed to failover a master, and the majority needed to authorize the failover. This command should be used in monitoring systems to check if a Sentinel deployment is ok. /","params":[{"name":"master","declared_type":"string","description":"Name of master"}],"return_type":"RedisSentinel|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"failover","fqn":"RedisSentinel::failover","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisSentinel.php","range":{"start":4468,"end":4476}},"declared_type":null,"signature":{"parameters":[{"name":"master","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisSentinel|bool","phpdoc_return_type":"RedisSentinel|bool"},"documentation":{"description":"Force a failover as if the master was not reachable, and without asking for agreement to other Sentinels (however a new version of the configuration will be published so that the other Sentinels will update their configurations). /","params":[{"name":"master","declared_type":"string","description":"Name of master"}],"return_type":"RedisSentinel|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"flushconfig","fqn":"RedisSentinel::flushconfig","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisSentinel.php","range":{"start":5379,"end":5390}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"RedisSentinel|bool","phpdoc_return_type":"RedisSentinel|bool"},"documentation":{"description":"Force Sentinel to rewrite its configuration on disk, including the current Sentinel state. Normally Sentinel rewrites the configuration every time something changes in its state (in the context of the subset of the state which is persisted on disk across restart). However sometimes it is possible that the configuration file is lost because of operation errors, disk failures, package upgrade scripts or configuration managers. In those cases a way to to force Sentinel to rewrite the configuration file is handy. This command works even if the previous configuration file is completely missing. /","params":[],"return_type":"RedisSentinel|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getMasterAddrByName","fqn":"RedisSentinel::getMasterAddrByName","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisSentinel.php","range":{"start":5919,"end":5938}},"declared_type":null,"signature":{"parameters":[{"name":"master","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisSentinel|array|bool","phpdoc_return_type":"RedisSentinel|array|bool"},"documentation":{"description":"Return the ip and port number of the master with that name. If a failover is in progress or terminated successfully for this master it returns the address and port of the promoted replica. /","params":[{"name":"master","declared_type":"string","description":"Name of master"}],"return_type":"RedisSentinel|array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"master","fqn":"RedisSentinel::master","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisSentinel.php","range":{"start":6336,"end":6342}},"declared_type":null,"signature":{"parameters":[{"name":"master","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisSentinel|array|bool","phpdoc_return_type":"RedisSentinel|array|bool"},"documentation":{"description":"Return the state and info of the specified master /","params":[{"name":"master","declared_type":"string","description":"Name of master"}],"return_type":"RedisSentinel|array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"masters","fqn":"RedisSentinel::masters","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisSentinel.php","range":{"start":6695,"end":6702}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"RedisSentinel|array|bool","phpdoc_return_type":"RedisSentinel|array|bool"},"documentation":{"description":"Return a list of monitored masters and their state /","params":[],"return_type":"RedisSentinel|array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"myid","fqn":"RedisSentinel::myid","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisSentinel.php","range":{"start":6964,"end":6968}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Return the run ID of this Sentinel instance. /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,