:null,"optional":false,"variadic":false,"by_reference":true}],"declared_return_type":"mixed","phpdoc_return_type":"mixed|null"},"documentation":{"description":"Shift an element off the beginning of array The input array. </p> empty or is not an array. /","params":[{"name":"","declared_type":null,"description":null}],"return_type":"mixed|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"array_slice","fqn":"array_slice","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":38294,"end":38305}},"declared_type":null,"signature":{"parameters":[{"name":"array","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false},{"name":"preserve_keys","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Extract a slice of the array The input array. </p> If offset is non-negative, the sequence will start at that offset in the array. If offset is negative, the sequence will start that far from the end of the array. </p> If length is given and is positive, then the sequence will have that many elements in it. If length is given and is negative then the sequence will stop that many elements from the end of the array. If it is omitted, then the sequence will have everything from offset up until the end of the array. </p> Note that array_slice will reorder and reset the array indices by default. You can change this behaviour by setting preserve_keys to true. </p> /","params":[{"name":"array","declared_type":"array","description":"<p>"},{"name":"offset","declared_type":"int","description":"<p>"},{"name":"length","declared_type":"int|null","description":"[optional] <p>"},{"name":"preserve_keys","declared_type":"bool","description":"[optional] <p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"array_splice","fqn":"array_splice","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":37207,"end":37219}},"declared_type":null,"signature":{"parameters":[{"name":"array","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false},{"name":"replacement","declared_type":"mixed","phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Remove a portion of the array and replace it with something else The input array. </p> If offset is positive then the start of removed portion is at that offset from the beginning of the input array. If offset is negative then it starts that far from the end of the input array. </p> If length is omitted, removes everything from offset to the end of the array. If length is specified and is positive, then that many elements will be removed. If length is specified and is negative then the end of the removed portion will be that many elements from the end of the array. Tip: to remove everything from offset to the end of the array when replacement is also specified, use count($input) for length. </p> If replacement array is specified, then the removed elements are replaced with elements from this array. </p> <p> If offset and length are such that nothing is removed, then the elements from the replacement array are inserted in the place specified by the offset. Note that keys in replacement array are not preserved. </p> <p> If replacement is just one element it is not necessary to put array() around it, unless the element is an array itself. </p> /","params":[{"name":"","declared_type":null,"description":null},{"name":"offset","declared_type":"int","description":"<p>"},{"name":"length","declared_type":"int|null","description":"[optional] <p>"},{"name":"replacement","declared_type":"mixed","description":"<p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"array_sum","fqn":"array_sum","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_9.php","range":{"start":24472,"end":24481}},"declared_type":null,"signature":{"parameters":[{"name":"array","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|float","phpdoc_return_type":"int|float"},"documentation":{"description":"Calculate the sum of values in an array The input array. </p> /","params":[{"name":"array","declared_type":"array","description":"<p>"}],"return_type":"int|float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"array_udiff","fqn":"array_udiff","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_9.php","range":{"start":19183,"end":19194}},"declared_type":null,"signature":{"parameters":[{"name":"array","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"array2","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"data_compare_func","declared_type":"callable","phpdoc_type":"callable","optional":false