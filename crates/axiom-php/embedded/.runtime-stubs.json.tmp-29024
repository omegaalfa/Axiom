est was not successfully processed.  OWS requests include :ref:`WMS <wms_server>`, :ref:`WFS <wfs_server>`, :ref:`WCS <wcs_server>` and :ref:`SOS <sos_server>` requests supported by MapServer. Results of a dispatched request are written to stdout and can be captured using the msIO services (ie. ms_ioinstallstdouttobuffer() and ms_iogetstdoutbufferstring()) /","params":[{"name":"request","declared_type":"OwsrequestObj","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"prepareImage","fqn":"mapObj::prepareImage","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":64682,"end":64694}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"imageObj"},"documentation":{"description":"Return a blank image object. /","params":[],"return_type":"imageObj","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"prepareQuery","fqn":"mapObj::prepareQuery","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":64833,"end":64845}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Calculate the scale of the map and set map->scaledenom. /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"processLegendTemplate","fqn":"mapObj::processLegendTemplate","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":65091,"end":65112}},"declared_type":null,"signature":{"parameters":[{"name":"params","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Process legend template files and return the result in a buffer. .. seealso:: :ref:`processtemplate <processtemplate>` /","params":[{"name":"params","declared_type":"array","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"processQueryTemplate","fqn":"mapObj::processQueryTemplate","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":65533,"end":65553}},"declared_type":null,"signature":{"parameters":[{"name":"params","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"generateimages","declared_type":null,"phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Process query template files and return the result in a buffer. Second argument generateimages is not mandatory. If not given it will be set to TRUE. .. seealso:: :ref:`processtemplate <processtemplate>` .. _processtemplate: /","params":[{"name":"params","declared_type":"array","description":null},{"name":"generateimages","declared_type":"bool","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"processTemplate","fqn":"mapObj::processTemplate","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":66713,"end":66728}},"declared_type":null,"signature":{"parameters":[{"name":"params","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"generateimages","declared_type":null,"phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Process the template file specified in the web object and return the result in a buffer. The processing consists of opening the template file and replace all the tags found in it. Only tags that have an equivalent element in the map object are replaced (ex [scaledenom]). The are two exceptions to the previous statement : - [img], [scalebar], [ref], [legend] would be replaced with the appropriate url if the parameter generateimages is set to MS_TRUE. (Note :  the images corresponding to the different objects are generated if the object is set to MS_ON in the map file) - the user can use the params parameter to specify tags and their values. For example if the user have a specific tag call [my_tag] and would like it to be replaced by \"value_of_my_tag\" he would do .. code-block:: php $tmparray[\"my_tag\"] = \"value_of_my_tag\"; $map->processtemplate($tmparray, MS_FALSE); /","params":[{"name":"params","declared_type":"array","description":null},{"name":"generateimages","declared_type":"bool","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByFeatures","fqn":"mapObj::queryByFeatures","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":67240,"end":67255}},"declared_type":null,"signature":{"parameters":[{"name":"slayer","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Perform a query based on a previous set of results from a layer. At present the results MUST be based on a polygon layer. Returns MS_SUCCESS if shapes were found or MS_FAILURE if nothing was found or if some other error happened (note that the error message in case nothing was found can be avoided in PHP using the '@' control operator). /","params":[{"name":"slayer","declared_type":"int","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByIndex","fqn":"mapObj::queryByIndex","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":67732,"end":67744}},"declared_type":null,"signature":{"parameters":[{"name":"layerindex","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"tileindex","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"shapeindex","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"addtoquery","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Add a specific shape on a given layer to the query result. If addtoquery (which is a non mandatory argument) is set to MS_TRUE, the shape will be added to the existing query list. Default behavior is to free the existing query list and add only the new shape. /","params":[{"name":"layerindex","declared_type":null,"description":null},{"name":"tileindex","declared_type":null,"description":null},{"name":"shapeindex","declared_type":null,"description":null},{"name":"addtoquery","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByPoint","fqn":"mapObj::queryByPoint","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":68805,"end":68817}},"declared_type":null,"signature":{"parameters":[{"name":"point","declared_type":"pointObj","phpdoc_type":"pointObj","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"buffer","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Query all selected layers in map at point location specified in georeferenced map coordinates (i.e. not pixels). The query is performed on all the shapes that are part of a :ref:`CLASS` that contains a :ref:`TEMPLATE` value or that match any class in a layer that contains a :ref:`LAYER` :ref:`TEMPLATE <template>` value. Mode is MS_SINGLE or MS_MULTIPLE depending on number of results you want. Passing buffer -1 defaults to tolerances set in the map file (in pixels) but you can use a constant buffer (specified in ground units) instead. Returns MS_SUCCESS if shapes were found or MS_FAILURE if nothing was found or if some other error happened (note that the error message in case nothing was found can be avoided in PHP using the '@' control operator). /","params":[{"name":"point","declared_type":"pointObj","description":null},{"name":"mode","declared_type":"int","description":null},{"name":"buffer","declared_type":"float","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByRect","fqn":"mapObj::queryByRect","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":69555,"end":69566}},"declared_type":null,"signature":{"parameters":[{"name":"rect","declared_type":"rectObj","phpdoc_type":"rectObj","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Query all selected layers in map using a rectangle specified in georeferenced map coordinates (i.e. not pixels).  The query is performed on all the shapes that are part of a :ref:`CLASS` that contains a :ref:`TEMPLATE` value or that match any class in a layer that contains a :ref:`LAYER` :ref:`TEMPLATE <template>` value.  Returns MS_SUCCESS if shapes were found or MS_FAILURE if nothing was found or if some other error happened (note that the error message in case nothing was found can be avoided in PHP using the '@' control operator). /","params":[{"name":"rect","declared_type":"rectObj","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByShape","fqn":"mapObj::queryByShape","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":70046,"end":70058}},"declared_type":null,"signature":{"parameters":[{"name":"shape","declared_type":"shapeObj","phpdoc_type":"shapeObj","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Query all selected layers in map based on a single shape, the shape has to be a polygon at this point. Returns MS_SUCCESS if shapes were found or MS_FAILURE if nothing was found or if some other error happened (note that the error message in case nothing was found can be avoided in PHP using the '@' control operator). /","params":[{"name":"shape","declared_type":"shapeObj","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"removeLayer","fqn":"mapObj::removeLayer","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":70338,"end":70349}},"declared_type":null,"signature":{"parameters":[{"name":"nIndex","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"layerObj"},"documentation":{"description":"Remove a layer from the mapObj. The argument is the index of the layer to be removed. Returns the removed layerObj on success, else null. /","params":[{"name":"nIndex","declared_type":"int","description":null}],"return_type":"layerObj","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"removeMetaData","fqn":"mapObj::removeMetaData","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":70584,"end":70598}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Remove a metadata entry for the map (stored in the WEB object in the map file).  Returns MS_SUCCESS/MS_FAILURE. /","params":[{"name":"name","declared_type":"string","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"removeOutputFormat","fqn":"mapObj::removeOutputFormat","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":73300,"end":73318}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Remove outputformat from the map. Returns MS_SUCCESS/MS_FAILURE. /","params":[{"name":"name","declared_type":"string","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"save","fqn":"mapObj::save","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":70889,"end":70893}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Save current map object state to a file. Returns -1 on error. Use absolute path. If a relative path is used, then it will be relative to the mapfile location. /","params":[{"name":"filename","declared_type":"string","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"saveMapContext","fqn":"mapObj::saveMapContext","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":71249,"end":71263}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Available only if WMS support is enabled.  Save current map object state in :ref:`WMS Map Context <map_context>` format.  Only WMS layers are saved in the WMS Map Context XML file.  Returns MS_SUCCESS/MS_FAILURE. /","params":[{"name":"filename","declared_type":"string","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"saveQuery","fqn":"mapObj::saveQuery","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":71828,"end":71837}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"results","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Save the current query in a file. Results determines the save format - MS_TRUE (or 1/true) saves the query results (tile index and shape index), MS_FALSE (or 0/false) the query parameters (and the query will be re-run in loadquery). Returns MS_SUCCESS or MS_FAILURE. Either save format can be used with loadquery. See RFC 65 and ticket #3647 for details of different save formats. /","params":[{"name":"filename","declared_type":"string","description":null},{"name":"results","declared_type":"int","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"scaleExtent","fqn":"mapObj::scaleExtent","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":72301,"end":72312}},"declared_type":null,"signature":{"parameters":[{"name":"zoomfactor","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"minscaledenom","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"maxscaledenom","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Scale the map extent using the zoomfactor and ensure the extent within the minscaledenom and maxscaledenom domain.  If minscaledenom and/or maxscaledenom is 0 then the parameter is not taken into account.  Returns MS_SUCCESS or MS_FAILURE. /","params":[{"name":"zoomfactor","declared_type":"float","description":null},{"name":"minscaledenom","declared_type":"float","description":null},{"name":"maxscaledenom","declared_type":"float","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"selectOutputFormat","fqn":"mapObj::selectOutputFormat","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":72829,"end":72847}},"declared_type":null,"signature":{"parameters":[{"name":"type","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Selects the output format to be used in the map. Returns MS_SUCCESS/MS_FAILURE. .. note:: the type used should correspond to one of the output formats declared in the map file.  The type argument passed is compared with the mimetype parameter in the output format structure and then to the name parameter in the structure. /","params":[{"name":"type","declared_type":"string","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set","fqn":"mapObj::set","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":73689,"end":73692}},"declared_type":null,"signature":{"parameters":[{"name":"property_name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"new_value","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Set map object property to new value. /","params":[{"name":"property_name","declared_type":"string","description":null},{"name":"new_value","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setCenter","fqn":"mapObj::setCenter","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":73915,"end":73924}},"declared_type":null,"signature":{"parameters":[{"name":"center","declared_type":"pointObj","phpdoc_type":"pointObj","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Set the map center to the given map point. Returns MS_SUCCESS or MS_FAILURE. /","params":[{"name":"center","declared_type":"pointObj","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setConfigOption","fqn":"mapObj::setConfigOption","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":74135,"end":74150}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Sets a config parameter using the key and the value passed /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"string","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setExtent","fqn":"mapObj::setExtent","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":74464,"end":74473}},"declared_type":null,"signature":{"parameters":[{"name":"minx","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"miny","declared_type":null,"phpdoc_type":"float","op