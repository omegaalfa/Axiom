wser's major and minor version numbers and ID string; true/false values for features such as frames, JavaScript, and cookies; and so forth. </p> <p> The cookies value simply means that the browser itself is capable of accepting cookies and does not mean the user has enabled the browser to accept cookies or not. The only way to test if cookies are accepted is to set one with setcookie, reload, and check for the value. /","params":[{"name":"user_agent","declared_type":"string|null","description":"[optional] <p>"},{"name":"return_array","declared_type":"bool","description":"[optional] <p>"}],"return_type":"array|object|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"get_call_stack","fqn":"get_call_stack","kind":"Function","origin":"PhpRuntime","extension":"ZendDebugger","location":{"file":"ZendDebugger/ZendDebugger.php","range":{"start":76,"end":90}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"get_called_class","fqn":"get_called_class","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":11296,"end":11312}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"the \"Late Static Binding\" class name PHP 8.0.0, an E_WARNING level error was raised. /","params":[],"return_type":"string","var_type":null,"throws":["\\Error"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"get_cfg_var","fqn":"get_cfg_var","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":26895,"end":26906}},"declared_type":null,"signature":{"parameters":[{"name":"option","declared_type":"string","phpdoc_type":"string","opt