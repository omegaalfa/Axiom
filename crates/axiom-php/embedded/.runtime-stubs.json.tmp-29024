null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setFlushCallback","fqn":"ExcimerProfiler::setFlushCallback","kind":"Method","origin":"PhpRuntime","extension":"excimer","location":{"file":"excimer/ExcimerProfiler.php","range":{"start":1913,"end":1929}},"declared_type":null,"signature":{"parameters":[{"name":"callback","declared_type":null,"phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"maxSamples","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Set a callback which will be called once the specified number of samples has been collected. When the ExcimerProfiler object is destroyed, the callback will also be called, unless no samples have been collected. The callback will be called with a single argument: the ExcimerLog object containing the samples. Before the callback is called, a new ExcimerLog object will be created and registered with the ExcimerProfiler. So ExcimerProfiler::getLog() should not be used from the callback, since it will not return the samples. /","params":[{"name":"callback","declared_type":"callable","description":null},{"name":"maxSamples","declared_type":"int","description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setMaxDepth","fqn":"ExcimerProfiler::setMaxDepth","kind":"Method","origin":"PhpRuntime","extension":"excimer","location":{"file":"excimer/ExcimerProfiler.php","range":{"start":1176,"end":1187}},"declared_type":null,"signature":{"parameters":[{"name":"maxDepth","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Set the maximum depth of stack trace collection. If this depth is exceeded, the traversal up the stack will be terminated, so the function will appear to have no caller. By default, there is no limit. If this is called with a depth of zero, the limit is disabled. This will take effect immediately. /","params":[{"name":"maxDepth","declared_type":"int","description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setPeriod","fqn":"ExcimerProfiler::setPeriod","kind":"Method","origin":"PhpRuntime","extension":"excimer","location":{"file":"excimer/ExcimerProfiler.php","range":{"start":408,"end":417}},"declared_type":null,"signature":{"parameters":[{"name":"period","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Set the period. This will take effect the next time start() is called. If this method is not called, the default period of 0.1 seconds will be used. /","params":[{"name":"period","declared_type":"float","description":"The period in seconds"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"start","fqn":"ExcimerProfiler::start","kind":"Method","origin":"PhpRuntime","extension":"excimer","location":{"file":"excimer/ExcimerProfiler.php","range":{"start":2290,"end":2295}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Start the profiler. If the profiler was already running, it will be stopped and restarted with new options. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"stop","fqn":"ExcimerProfiler::stop","kind":"Method","origin":"PhpRuntime","extension":"excimer","location":{"file":"excimer/ExcimerProfiler.php","range