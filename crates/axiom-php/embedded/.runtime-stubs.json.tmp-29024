fied module One of the <b>MCRYPT_ciphername</b> constants, or the name of the algorithm as string. </p> The optional lib_dir parameter can contain the location of where the algorithm module is on the system. </p> fails. /","params":[{"name":"algorithm","declared_type":"string","description":"<p>"},{"name":"lib_dir","declared_type":"string","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mcrypt_ofb","fqn":"mcrypt_ofb","kind":"Function","origin":"PhpRuntime","extension":"mcrypt","location":{"file":"mcrypt/mcrypt.php","range":{"start":1389,"end":1399}},"declared_type":null,"signature":{"parameters":[{"name":"cipher","declared_type":null,"phpdoc_type":"int|string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"data","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"iv","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Encrypt/decrypt data in OFB mode /","params":[{"name":"cipher","declared_type":"int|string","description":null},{"name":"key","declared_type":"string","description":null},{"name":"data","declared_type":"string","description":null},{"name":"mode","declared_type":"int","description":null},{"name":"iv","declared_type":"string","description":"[optional]"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"md5","fqn":"md5","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":25683,"end":25686}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"binary","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Calculate the md5 hash of a string The string. </p> If the optional raw_output is set to true, then the md5 digest is instead returned in raw binary format with a length of 16. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"binary","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"md5_file","fqn":"md5_file","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":26109,"end":26117}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"binary","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Calculates the md5 hash of a given file The filename </p> When true, returns the digest in raw binary format with a length of 16. </p> /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"binary","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mdecrypt_generic","fqn":"mdecrypt_generic","kind":"Function","origin":"PhpRuntime","extension":"mcrypt","location":{"file":"mcrypt/mcrypt.php","range":{"start":11487,"end":11503}},"declared_type":null,"signature":{"parameters":[{"name":"td","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"data","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Decrypts data An encryption descriptor returned by mcrypt_module_open </p> Encrypted data. </p> /","params":[{"name":"td","declared_type":"resource","description":"<p>"},{"name":"data","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"memcache_add","fqn":"memcache_add","kind":"Function","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":29310,"end":29322}},"declared_type":null,"signature":{"parameters":[{"name":"memcache","declared_type":null,"phpdoc_type":"Memcache","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"var","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"flag","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"expire","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcache &gt;= 2.0.0)<br/> Add an item to the server. If the key already exists, the value will not be added and <b>FALSE</b> will be returned. Use <b>MEMCACHE_COMPRESSED</b> to store the item compressed (uses zlib). </p> If it's equal to zero, the item will never expire. You can also use Unix timestamp or a number of seconds starting from current time, but in the latter case the number of seconds may not exceed 2592000 (30 days).</p> /","params":[{"name":"memcache","declared_type":"Memcache","description":null},{"name":"key","declared_type":"string","description":"The key that will be associated with the item."},{"name":"var","declared_type":"mixed","description":"The variable to store. Strings and integers are stored as is, other types are stored serialized."},{"name":"flag","declared_type":"int","description":"[optional] <p>"},{"name":"expire","declared_type":"int","description":"[optional] <p>Expiration time of the item."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"memcache_add_server","fqn":"memcache_add_server","kind":"Function","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":24998,"end":25017}},"declared_type":null,"signature":{"parameters":[{"name":"memcache","declared_type":null,"phpdoc_type":"Memcache","optional":false,"variadic":false,"by_reference":false},{"name":"host","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"persistent","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"weight","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"retry_interval","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"status","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"failure_callback","declared_type":"?callable","phpdoc_type":"callable","optional":true,"variadic":false,"by_reference":false},{"name":"timeoutms","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcache &gt;= 2.0.0)<br/> Add a memcached server to connection pool Point to the host where memcached is listening for connections. This parameter may also specify other transports like unix:///path/to/memcached.sock to use UNIX domain sockets, in this case <i>port</i> must also be set to 0. </p> Point to the port where memcached is listening for connections. Set this parameter to 0 when using UNIX domain sockets. </p> <p> Please note: <i>port</i> defaults to memcache.default_port if not specified. For this reason it is wise to specify the port explicitly in this method call. </p> Controls the use of a persistent connection. Default to <b>TRUE</b>. </p> Number of buckets to create for this server which in turn control its probability of it being selected. The probability is relative to the total weight of all servers. </p> Value in seconds which will be used for connecting to the daemon. Think twice before changing the default value of 1 second - you can lose all the advantages of caching if your connection is too slow. </p> Controls how often a failed server will be retried, the default value is 15 seconds. Setting this parameter to -1 disables automatic retry. Neither this nor the <i>persistent</i> parameter has any effect when the extension is loaded dynamically via <b>dl</b>. </p> <p> Each failed connection struct has its own timeout and before it has expired the struct will be skipped when selecting backends to serve a request. Once expired the connection will be successfully reconnected or marked as failed for another <i>retry_interval</i> seconds. The typical effect is that each web server child will retry the connection about every <i>retry_interval</i> seconds when serving a page. </p> Controls if the server should be flagged as online. Setting this parameter to <b>FALSE</b> and <i>retry_interval</i> to -1 allows a failed server to be kept in the pool so as not to affect the key distribution algorithm. Requests for this server will then failover or fail immediately depending on the <i>memcache.allow_failover</i> setting. Default to <b>TRUE</b>, meaning the server should be considered online. </p> Allows the user to specify a callback function to run upon encountering an error. The callback is run before failover is attempted. The function takes two parameters, the hostname and port of the failed server. </p> </p> /","params":[{"name":"memcache","declared_type":"Memcache","description":null},{"name":"host","declared_type":"string","description":"<p>"},{"name":"port","declared_type":"int","description":"[optional] <p>"},{"name":"persistent","declared_type":"bool","description":"[optional] <p>"},{"name":"weight","declared_type":"int","description":"[optional] <p>"},{"name":"timeout","declared_type":"int","description":"[optional] <p>"},{"name":"retry_interval","declared_type":"int","description":"[optional] <p>"},{"name":"status","declared_type":"bool","description":"[optional] <p>"},{"name":"failure_callback","declared_type":"callable","description":"[optional] <p>"},{"name":"timeoutms","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"memcache_append","fqn":"memcache_append","kind":"Function","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":33020,"end":33035}},"declared_type":null,"signature":{"parameters":[{"name":"memcache","declared_type":null,"phpdoc_type":"Memcache","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":