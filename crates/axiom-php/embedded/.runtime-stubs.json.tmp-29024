pdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"xShear","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"yShear","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Slides one edge of an image along the X or Y axis, creating a parallelogram. An X direction shear slides an edge along the X axis, while a Y direction shear slides an edge along the Y axis. The amount of the shear is controlled by a shear angle. For X direction shears, x_shear is measured relative to the Y axis, and similarly, for Y direction shears y_shear is measured relative to the X axis. Empty triangles left over from shearing the image are filled with the background color. /","params":[{"name":"color","declared_type":"mixed","description":"The background pixel wand."},{"name":"xShear","declared_type":"float","description":"The number of degrees to shear the image."},{"name":"yShear","declared_type":"float","description":"The number of degrees to shear the image."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"solarizeimage","fqn":"Gmagick::solarizeimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":72099,"end":72112}},"declared_type":null,"signature":{"parameters":[{"name":"threshold","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Applies a solarizing effect to the image. Applies a special effect to the image, similar to the effect achieved in a photo darkroom by selectively exposing areas of photo sensitive paper to light. Threshold ranges from 0 to QuantumRange and is a measure of the extent of the solarization. /","params":[{"name":"threshold","declared_type":"int","description":"Define the extent of the solarization."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"spreadimage","fqn":"Gmagick::spreadimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":72601,"end":72612}},"declared_type":null,"signature":{"parameters":[{"name":"radius","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Randomly displaces each pixel in a block. Special effects method that randomly displaces each pixel in a block defined by the radius parameter. /","params":[{"name":"radius","declared_type":"float","description":"Choose a random pixel in a neighborhood of this extent."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"stripimage","fqn":"Gmagick::stripimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":72894,"end":72904}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Strips an image of all profiles and comments. /","params":[],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"swirlimage","fqn":"Gmagick::swirlimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":73479,"end":73489}},"declared_type":null,"signature":{"parameters":[{"name":"degrees","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Swirls the pixels about the center of the image. Swirls the pixels about the center of the image, where degrees indicates the sweep of the arc through which each pixel is moved. You get a more dramatic effect as the degrees move from 1 to 360. /","params":[{"name":"degrees","declared_type":"float","description":"Define the tightness of the swirling effect."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"thumbnailimage","fqn":"Gmagick::thumbnailimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":74268,"end":74282}},"declared_type":null,"signature":{"parameters":[{"name":"width","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"fit","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Changes the size of an image to the given dimensions and removes any associated profiles. The goal is to produce small low cost thumbnail images suited for display on the Web. If TRUE is given as a third parameter then columns and rows parameters are used as maximums for each side. Both sides will be scaled down until the match or are smaller than the parameter given for the side. /","params":[{"name":"width","declared_type":"int","description":"Image width."},{"name":"height","declared_type":"int","description":"Image height."},{"name":"fit","declared_type":"bool","description":"[optional]"}],"return_type":"Gmagic