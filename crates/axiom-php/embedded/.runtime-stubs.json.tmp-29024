ard to next element /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rewind","fqn":"MongoCommandCursor::rewind","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":82295,"end":82301}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Rewind the Iterator to the first element /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setReadPreference","fqn":"MongoCommandCursor::setReadPreference","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":82526,"end":82543}},"declared_type":null,"signature":{"parameters":[{"name":"read_preference","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"tags","declared_type":"?array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"MongoCursorInterface","phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"timeout","fqn":"MongoCommandCursor::timeout","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":82636,"end":82643}},"declared_type":null,"signature":{"parameters":[{"name":"ms","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"MongoCursorInterface","phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"valid","fqn":"MongoCommandCursor::valid","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":82069,"end":82074}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Checks if current position is valid Returns true on success or false on failure. /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"MongoCursor::__construct","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":68461,"end":68472}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"MongoClient","optional":false,"variadic":false,"by_reference":false},{"name":"ns","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"query","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"fields","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Create a new cursor /","params":[{"name":"connection","declared_type":"MongoClient","description":"Database connection."},{"name":"ns","declared_type":"string","description":"Full name of database and collection."},{"name":"query","declared_type":"array","description":"Database query."},{"name":"fields","declared_type":"array","description":"Fields to return."}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addOption","fqn":"MongoCursor::addOption","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":75550,"end":75559}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"MongoCursor"},"documentation":{"description":"Adds a top-level key/value pair to a query /","params":[{"name":"key","declared_type":"string","description":"Fieldname to add."},{"name":"value","declared_type":"mixed","description":"Value to add."}],"return_type":"MongoCursor","var_type":null,"throws":["MongoCursorException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"awaitData","fqn":"MongoCursor::awaitData","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":68856,"end":68865}},"declared_type":null,"signature":{"parameters":[{"name":"wait","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"MongoCursor"},"documentation":{"description":"(PECL mongo &gt;= 1.2.11)<br/> Sets whether this cursor will wait for a while for a tailable cursor to return more data /","params":[{"name":"wait","declared_type":"bool","description":"[optional] <p>If the cursor should wait for more data to become available.</p>"}],"return_type":"MongoCursor","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"batchSize","fqn":"MongoCursor::batchSize","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":80637,"end":80646}},"declared_type":null,"signature":{"parameters":[{"name":"batchSize","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"MongoCursor"},"documentation":{"description":"PECL mongo >= 1.0.11 Limits the number of elements returned in one batch. <p>A cursor typically fetches a batch of result objects and store them locally. This method sets the batchSize value to configure the amount of documents retrieved from the server in one data packet. However, it will never return more documents than fit in the max batch size limit (usually 4MB). </p> <p>If batchSize is 2 or more, it represents the size of each batch of objects retrieved. It can be adjusted to optimize performance and limit data transfer. </p> <p>If batchSize is 1 or negative, it will limit of number returned documents to the absolute value of batchSize, and the cursor will be closed. For example if batchSize is -10, then the server will return a maximum of 10 documents and as many as can fit in 4MB, then close the cursor. </p> <b>Warning</b> <p>A batchSize of 1 is special, and means the same as -1, i.e. a value of 1 makes the cursor only capable of returning one document. </p> <p>Note that this feature is different from MongoCursor::limit() in that documents must fit within a maximum size, and it removes the need to send a request to close the cursor server-side. The batch size can be changed even after a cursor is iterated, in which case the setting will apply on the next batch retrieval. </p> <p>This cannot override MongoDB's limit on the amount of data it will return to the client (i.e., if you set batch size to 1,000,000,000, MongoDB will still only return 4-16MB of results per batch). </p> <p>To ensure consistent behavior, the rules of MongoCursor::batchSize() and MongoCursor::limit() behave a little complex but work \"as expected\". The rules are: hard limits override soft limits with preference given to MongoCursor::limit() over MongoCursor::batchSize(). After that, whichever is set and lower than the other will take precedence. See below. section for some examples. </p> /","params":[{"name":"batchSize","declared_type":"int","description":"The number of results to return per batch. Each batch requires a round-trip to the server."}],"return_type":"MongoCursor","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"count","fqn":"MongoCursor::count","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":77667,"end":77672}},"declared_type":null,"signature":{"parameters":[{"name":"all","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Counts the number of results for this query /","params":[{"name":"all","declared_type":"bool","description":"Send cursor limit and skip information to the count function, if applicable."}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"current","fqn":"MongoCursor::current","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":75981,"end":75988}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Returns the current element /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dead","fqn":"MongoCursor::dead","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":74176,"end":74180}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Checks if there are documents that have not been sent yet from the database for this cursor /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"doQuery","fqn":"MongoCursor::doQuery","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","ra