/p> Typically the group number from the password file. </p> /","params":[{"name":"username","declared_type":"string","description":"<p>"},{"name":"group_id","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_isatty","fqn":"posix_isatty","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":8574,"end":8586}},"declared_type":null,"signature":{"parameters":[{"name":"file_descriptor","declared_type":null,"phpdoc_type":"resource|int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Determine if a file descriptor is an interactive terminal The file descriptor, which is expected to be either a file resource or an integer. An integer will be assumed to be a file descriptor that can be passed directly to the underlying system call.<br /> In almost all cases, you will want to provide a file resource. </p> to a terminal and <b>FALSE</b> otherwise. /","params":[{"name":"file_descriptor","declared_type":"resource|int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_kill","fqn":"posix_kill","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":467,"end":477}},"declared_type":null,"signature":{"parameters":[{"name":"process_id","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"signal","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Send a signal to a process The process identifier. </p> One of the PCNTL signals constants. </p> /","params":[{"name":"process_id","declared_type":"int","description":"<p>"},{"name":"signal","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_mkfifo","fqn":"posix_mkfifo","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":9494,"end":9506}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"permissions","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Create a fifo special file (a named pipe) Path to the FIFO file. </p> The second parameter <i>mode</i> has to be given in octal notation (e.g. 0644). The permission of the newly created FIFO also depends on the setting of the current <b>umask</b>. The permissions of the created file are (mode & ~umask). </p> /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"permissions","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_mknod","fqn":"posix_mknod","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":10312,"end":10323}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"major","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name