tart":12343,"end":12362}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Looks up a current parameter setting of the server. PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> Possible <i>param_name</i> values include server_version, server_encoding, client_encoding, is_superuser, session_authorization, DateStyle, TimeZone, and integer_datetimes. </p> <i>param_name</i>. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"name","declared_type":"string","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_pconnect","fqn":"pg_pconnect","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":3660,"end":3671}},"declared_type":null,"signature":{"parameters":[{"name":"connection_string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"host","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"port","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"tty","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"dbname","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Open a persistent PostgreSQL connection The <i>connection_string</i> can be empty to use all default parameters, or it can contain one or more parameter settings separated by whitespace. Each parameter setting is in the form keyword = value. Spaces around the equal sign are optional. To write an empty value or a value containing spaces, surround it with single quotes, e.g., keyword = 'a value'. Single quotes and backslashes within the value must be escaped with a backslash, i.e., \\' and \\\\. </p> <p> The currently recognized parameter keywords are: <i>host</i>, <i>hostaddr</i>, <i>port</i>, <i>dbname</i>, <i>user</i>, <i>password</i>, <i>connect_timeout</i>, <i>options</i>, <i>tty</i> (ignored), <i>sslmode</i>, <i>requiressl</i> (deprecated in favor of <i>sslmode</i>), and <i>service</i>. Which of these arguments exist depends on your PostgreSQL version. </p> If <b>PGSQL_CONNECT_FORCE_NEW</b> is passed, then a new connection is created, even if the <i>connection_string</i> is identical to an existing connection. </p> /","params":[{"name":"connection_string","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"<p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_ping","fqn":"pg_ping","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":11456,"end":11463}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Ping database connection PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> /","params":[{"name":"connection","declared_type":"resource","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_pipeline_status","fqn":"pg_pipeline_status","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":83746,"end":83764}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":"PgSql\\Connection","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":null},"documentation":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_pipeline_sync","fqn":"pg_pipeline_sync","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":83835,"end":83851}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":"PgSql\\Connection","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":null},"documentation":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_port","fqn":"pg_port","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":8854,"end":8861}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Return the port number associated with the connection PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> /","params":[{"name":"connection","declared_type":"resource","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_prepare","fqn":"pg_prepare","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":18079,"end":18089}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"statement_name","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"statement_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"query","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Submits a request to create a prepared statement with the given parameters, and waits for completion. PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> The name to give the prepared statement. Must be unique per-connection. If \"\" is specified, then an unnamed statement is created, overwriting any previously defined unnamed statement. </p> The parameterized SQL statement. Must contain only a single statement. (multiple statements separated by semi-colons are not allowed.) If any parameters are used, they are referred to as $1, $2, etc. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"statement_name","declared_type":"string","description":"<p>"},{"name":"query","declared_type":"string","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_put_copy_data","fqn":"pg_put_copy_data","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":85239,"end":85255}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":"PgSql\\Connection","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"cmd","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":null},"documentation":{"description":"Send data to the server during a COPY operation Sends data to the server during a COPY FROM STDIN operation. A COPY command must have been issued via pg_query before calling this function. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_put_copy_end","fqn":"pg_put_copy_end","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":86958,"end":86973}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":"PgSql\\Connection","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"error","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":null},"documentation":{"description":"Signal the completion of a COPY operation to the server Sends an end-of-data indication to the server during a COPY FROM STDIN operation. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_put_line","fqn":"pg_put_line","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":48344,"end":48355}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"query","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Send a NULL-terminated string to PostgreSQL backend PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> A line of text to be sent directly to the PostgreSQL backend. A NULL terminator is added automatically. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"query","declared_type":"string","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_query","fqn":"pg_query","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":14658,"end":14666}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"query","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Execute a query PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> The SQL statement or statements to be executed. When multiple statements are passed to the function, they are automatically executed as one transaction, unless there are explicit BEGIN/COMMIT commands included in the query string. However, using multiple transactions in one function call is not recommended. </p> <p> String interpolation of user-supplied data is extremely dangerous and is likely to lead to SQL injection vulnerabilities. In most cases <b>pg_query_params</b> should be preferred, passing user-supplied values as parameters rather than substituting them into the query string. </p> <p> Any user-supplied data substituted directly into a query string should be properly escaped. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"query","declared_type":"string","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_query_params","fqn":"pg_query_params","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":16567,"end":16582}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"query","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"params","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Submits a command to the server and waits for the result, with the ability to pass parameters separately from the SQL command text. PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> The parameterized SQL statement. Must contain only a single statement. (multiple statements separated by semi-colons are not allowed.) If any parameters are used, they are referred to as $1, $2, etc. </p> <p> User-supplied values should always be passed as parameters, not interpolated into the query string, where they form possible SQL injection attack vectors and introduce bugs when handling data containing quotes. If for some reason you cannot use a parameter, ensure that interpolated values are properly escaped. </p> An array of parameter values to substitute for the $1, $2, etc. placeholders in the original prepared query string. The number of elements in the array must match the number of placeholders. </p> <p> Values intended for bytea fields are not supported as parameters. Use <b>pg_escape_bytea</b> instead, or use the large object functions. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"query","declared_type":"string","description":"<p>"},{"name":"params","declared_type":"array","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_result","fqn":"pg_result","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":78805,"end":78814}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"result","declared_type":null,"phpdoc_type":"PgSql\\Result|resource","optional":false,"variadic":false,"by_reference":false},{"name":"row","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"field","declared_type":"string|int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|null|false","phpdoc_return_type":null},"documentation":{"description":"/","params":[{"name":"result","declared_type":"PgSql\\Result|resource","description":null},{"name":"row","declared_type":null,"description":null},{"name":"field","declared_type":null,"description":"[optional]"}],"return_type":null,"var_type":null,"throws":[],"deprecated":"8.0"},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_result_error","fqn":"pg_result_error","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":45009,"end":45024}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Get error message associated with result PostgreSQL query result resource, returned by <b>pg_query</b>, <b>pg_query_params</b> or <b>pg_execute</b> (among others). </p> <i>result</i> parameter, <b>FALSE</b> otherwise. /","params":[{"name":"result","declared_type":"resource","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_result_error_field","fqn":"pg_result_error_field","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":46077,"end":46098}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"field_code","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false|null","phpdoc_return_type":"string|null|false"},"documentation":{"description":"Returns an individual field of an error report. A PostgreSQL query result resource from a previously executed statement. </p> Possible <i>fieldcode</i> values are: <b>PGSQL_DIAG_SEVERITY</b>, <b>PGSQL_DIAG_SQLSTATE</b>, <b>PGSQL_DIAG_MESSAGE_PRIMARY</b>, <b>PGSQL_DIAG_MESSAGE_DETAIL</b>, <b>PGSQL_DIAG_MESSAGE_HINT</b>, <b>PGSQL_DIAG_STATEMENT_POSITION</b>, <b>PGSQL_DIAG_INTERNAL_POSITION</b> (PostgreSQL 8.0+ only), <b>PGSQL_DIAG_INTERNAL_QUERY</b> (PostgreSQL 8.0+ only), <b>PGSQL_DIAG_CONTEXT</b>, <b>PGSQL_DIAG_SOURCE_FILE</b>, <b>PGSQL_DIAG_SOURCE_LINE</b> or <b>PGSQL_DIAG_SOURCE_FUNCTION</b>. </p> on failure. /","params":[{"name":"result","declared_type":"resource","description":"<p>"},{"name":"field_code","declared_type":"int","description":"<p>"}],"return_type":"string|null|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_result_memory_size","fqn":"pg_result_memory_size","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":84425,"end":84446}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":"PgSql\\Result","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":null},"documentation":{"description":"Returns the amount of memory allocated for a query result Returns the amount of memory, in bytes, allocated to the specified query result PgSql\\Result instance. This value is the same amount that would be freed by pg_free_result. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_result_seek","fqn":"pg_result_seek","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":34278,"end":34292}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"row","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set internal row offset in result resource PostgreSQL query result resource, returned by <b>pg_query</b>, <b>pg_query_params</b> or <b>pg_execute</b> (among others). </p> Row to move the internal offset to in the <i>result</i> resource. Rows are numbered starting from zero. </p> /","params":[{"name":"result","declared_type":"resource","description":"<p>"},{"name":"row","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_result_status","fqn":"pg_result_status","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":35333,"end":35349}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|int","phpdoc_return_type":"string|int"},"documentation":{"description":"Get status of query result PostgreSQL query result resource, returned by <b>pg_query</b>, <b>pg_query_params</b> or <b>pg_execute</b> (among others). </p> Either <b>PGSQL_STATUS_LONG</b> to return the numeric status of the <i>result</i>, or <b>PGSQL_STATUS_STRING</b> to return the command tag of the <i>result</i>. If not specified, <b>PGSQL_STATUS_LONG</b> is the default. </p> <b>PGSQL_COMMAND_OK</b>, <b>PGSQL_TUPLES_OK</b>, <b>PGSQL_COPY_OUT</b>, <b>PGSQL_COPY_IN</b>, <b>PGSQL_BAD_RESPONSE</b>, <b>PGSQL_NONFATAL_ERROR</b> and <b>PGSQL_FATAL_ERROR</b> if <b>PGSQL_STATUS_LONG</b> is specified. Otherwise, a string containing the PostgreSQL command tag is returned. /","params":[{"name":"result","declared_type":"resource","description":"<p>"},{"name":"mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"string|int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_select","fqn":"pg_select","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":75277,"end":75286}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource|PgSql\\Connection","optional":false,"variadic":false,"by_reference":false},{"name":"table_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"conditions","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|string|false","phpdoc_return_type":"array|string|false"},"documentation":{"description":"Select records PostgreSQL database connection resource. </p> Name of the table from which to select rows. </p> An array whose keys are field names in the table <i>table_name</i>, and whose values are the conditions that a row must meet to be retrieved. </p> Any number of <b>PGSQL_CONV_FORCE_NULL</b>, <b>PGSQL_DML_NO_CONV</b>, <b>PGSQL_DML_EXEC</b>, <b>PGSQL_DML_ASYNC</b> or <b>PGSQL_DML_STRING</b> combined. If <b>PGSQL_DML_STRING</b> is part of the <i>options</i> then query string is returned. </p> An optional parameter that controls how the returned array is indexed. <i>result_type</i> is a constant and can take the following values: <b>PGSQL_ASSOC</b>, <b>PGSQL_NUM</b> and <b>PGSQL_BOTH</b>. Using <b>PGSQL_NUM</b>, <b>pg_fetch_array</b> will return an array with numerical indices, using <b>PGSQL_ASSOC</b> it will return only associative indices while <b>PGSQL_BOTH</b>, the default, will return both numerical and associative indices. </p> via <i>options</i>. /","params":[{"name":"connection","declared_type":"resource|PgSql\\Connection","description":"<p>"},{"name":"table_name","declared_type":"string","description":"<p>"},{"name":"conditions","declared_type":"array","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"},{"name":"mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_send_execute","fqn":"pg_send_execute","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":24176,"end":24191}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"statement_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"params","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|bool","phpdoc_return_type":"int|bool"},"documentation":{"description":"Sends a request to execute a prepared statement with given parameters, without waiting for the result(s). PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> The name of the prepared statement to execute. if \"\" is specified, then the unnamed statement is executed. The name must have been previously prepared using <b>pg_prepare</b>, <b>pg_send_prepare</b> or a PREPARE SQL command. </p> An array of parameter values to substitute for the $1, $2, etc. placeholders in the original prepared query string. The number of elements in the array must match the number of placeholders. </p> to determine the query result. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"statement_name","declared_type":"string","description":"<p>"},{"name":"params","declared_type":"array","description":"<p>"}],"return_type":"int|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_send_prepare","fqn":"pg_send_prepare","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":22900,"end":22915}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"statement_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"query","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|bool","phpdoc_return_type":"int|bool"},"documentation":{"description":"Sends a request to create a prepared statement with the given parameters, without waiting for completion. PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> The name to give the prepared statement. Must be unique per-connection. If \"\" is specified, then an unnamed statement is created, overwriting any previously defined unnamed statement. </p> The parameterized SQL statement. Must contain only a single statement. (multiple statements separated by semi-colons are not allowed.) If any parameters are used, they are referred to as $1, $2, etc. </p> to determine the query result. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"statement_name","declared_type":"string","description":"<p>"},{"name":"query","declared_type":"string","description":"<p>"}],"return_type":"int|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_send_query","fqn":"pg_send_query","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":20632,"end":20645}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"query","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|bool","phpdoc_return_type":"int|bool"},"documentation":{"description":"Sends asynchronous query PostgreSQL database connection resource. </p> The SQL statement or statements to be executed. </p> <p> Data inside the query should be properly escaped. </p> <p> Use <b>pg_get_result</b> to determine the query result. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"query","declared_type":"string","description":"<p>"}],"return_type":"int|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_send_query_params","fqn":"pg_send_query_params","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":21666,"end":21686}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"query","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"params","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|bool","phpdoc_return_type":"int|bool"},"documentation":{"description":"Submits a command and separate parameters to the server without waiting for the result(s). PostgreSQL database connection resource. </p> The parameterized SQL statement. Must contain only a single statement. (multiple statements separated by semi-colons are not allowed.) If any parameters are used, they are referred to as $1, $2, etc. </p> An array of parameter values to substitute for the $1, $2, etc. placeholders in the original prepared query string. The number of elements in the array must match the number of placeholders. </p> <p> Use <b>pg_get_result</b> to determine the query result. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"query","declared_type":"string","description":"<p>"},{"name":"params","declared_type":"array","description":"<p>"}],"return_type":"int|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_set_chunked_rows_size","fqn":"pg_set_chunked_rows_size","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":86638,"end":86662}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":"PgSql\\Connection","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"size","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":null},"documentation":{"description":"Set the query results to be retrieved in chunk mode Set the query results to be retrieved in chunk mode. The query results returned afterward will be divided into multiple chunks, each containing up to size rows. This function must be called before retrieving results with pg_get_result. This function is only available when libpq is version 17 or higher. /","params":[],"return_type":null,"var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_set_client_encoding","fqn":"pg_set_client_encoding","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":67778,"end":67800}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Set the client encoding PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> The required client encoding. One of SQL_ASCII, EUC_JP, EUC_CN, EUC_KR, EUC_TW, UNICODE, MULE_INTERNAL, LATINX (X=1...9), KOI8, WIN, ALT, SJIS, BIG5 or WIN1250. </p> <p> The exact list of available encodings depends on your PostgreSQL version, so check your PostgreSQL manual for a more specific list. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"encoding","declared_type":"string","description":"[optional] <p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_set_error_context_visibility","fqn":"pg_set_error_context_visibility","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":83627,"end":83658}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":"PgSql\\Connection","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"visibility","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":null},"documentation":{"description":"Determines the visibility of the context's error messages returned by pg_last_error and pg_result_error /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_set_error_verbosity","fqn":"pg_set_error_verbosity","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":66104,"end":66126}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"verbosity","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Determines the verbosity of messages returned by <b>pg_last_error</b> and <b>pg_result_error</b>. PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> The required verbosity: <b>PGSQL_ERRORS_TERSE</b>, <b>PGSQL_ERRORS_DEFAULT</b> or <b>PGSQL_ERRORS_VERBOSE</b>. </p> <b>PGSQL_ERRORS_DEFAULT</b> or <b>PGSQL_ERRORS_VERBOSE</b>. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"verbosity","declared_type":"int","description":"[optional] <p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_setclientencoding","fqn":"pg_setclientencoding","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":82215,"end":82235}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"/","params":[{"name":"connection","declared_type":null,"description":null},{"name":"encoding","declared_type":null,"description":"[optional]"}],"return_type":"int","var_type":null,"throws":[],"deprecated":"8.0"},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_socket","fqn":"pg_socket","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":6945,"end":6954}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Get a read only handle to the socket underlying a PostgreSQL connection PostgreSQL database connection resource. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_socket_poll","fqn":"pg_socket_poll","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":86005,"end":86019}},"declared_type":null,"signature":{"parameters":[{"name":"socket","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"read","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"write","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":null},"documentation":{"description":"Poll a PostgreSQL connection socket for read/write readiness Polls a PostgreSQL connection socket for read and/or write readiness. The socket can be obtained using pg_socket. This function is useful for implementing non-blocking, asynchronous query workflows. 0 to not wait at all. /","params":[{"name":"socket","declared_type":"resource","description":null},{"name":"read","declared_type":"int","description":"Whether to check for read readiness. Pass 1 to check, 0 to skip."},{"name":"write","declared_type":"int","description":"Whether to check for write readiness. Pass 1 to check, 0 to skip."},{"name":"timeout","declared_type":"int","description":"The maximum number of milliseconds to wait. Pass -1 to wait indefinitely, or"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_trace","fqn":"pg_trace","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":52116,"end":52124}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"trace_mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Enable tracing a PostgreSQL connection The full path and file name of the file in which to write the trace log. Same as in <b>fopen</b>. </p> An optional file access mode, same as for <b>fopen</b>. </p> PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"string","description":"[optional] <p>"},{"name":"connection","declared_type":"resource","description":"[optional] <p>"},{"name":"trace_mode","declared_type":"int","description":"Since PHP 8.3 optional trace mode"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_transaction_status","fqn":"pg_transaction_status","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":13217,"end":13238}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Returns the current in-transaction status of the server. PostgreSQL database connection resource. </p> <b>PGSQL_TRANSACTION_ACTIVE</b> (a command is in progress), <b>PGSQL_TRANSACTION_INTRANS</b> (idle, in a valid transaction block), or <b>PGSQL_TRANSACTION_INERROR</b> (idle, in a failed transaction block). <b>PGSQL_TRANSACTION_UNKNOWN</b> is reported if the connection is bad. <b>PGSQL_TRANSACTION_ACTIVE</b> is reported only when a query has been sent to the server and not yet completed. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_tty","fqn":"pg_tty","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":9484,"end":9490}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Return the TTY name associated with the connection PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> the <i>connection</i>, or <b>FALSE</b> on error. /","params":[{"name":"connection","declared_type":"resource","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_unescape_bytea","fqn":"pg_unescape_bytea","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":65292,"end":65309}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Unescape binary for bytea type A string containing PostgreSQL bytea data to be converted into a PHP binary string. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_untrace","fqn":"pg_untrace","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":52819,"end":52829}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Disable tracing of a PostgreSQL connection PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> /","params":[{"name":"connection","declared_type":"resource","description":"[optional] <p>"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_update","fqn":"pg_update","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":72516,"end":72525}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"table_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"conditions","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|bool","phpdoc_return_type":"string|bool"},"documentation":{"description":"Update table PostgreSQL database connection resource. </p> Name of the table into which to update rows. </p> An array whose keys are field names in the table <i>table_name</i>, and whose values are what matched rows are to be updated to. </p> An array whose keys are field names in the table <i>table_name</i>, and whose values are the conditions that a row must meet to be updated. </p> Any number of <b>PGSQL_CONV_OPTS</b>, <b>PGSQL_DML_NO_CONV</b>, <b>PGSQL_DML_EXEC</b> or <b>PGSQL_DML_STRING</b> combined. If <b>PGSQL_DML_STRING</b> is part of the <i>options</i> then query string is returned. </p> via <i>options</i>. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"table_name","declared_type":"string","description":"<p>"},{"name":"values","declared_type":"array","description":"<p>"},{"name":"conditions","declared_type":"array","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"string|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_version","fqn":"pg_version","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":10889,"end":10899}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Returns an array with client, protocol and server version (when available) PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> and server keys and values (if available). Returns <b>FALSE</b> on error or invalid connection. /","params":[{"name":"connection","declared_type":"resource","description":"[optional] <p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"php_egg_logo_guid","fqn":"php_egg_logo_guid","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":37381,"end":37398}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"php_ini_loaded_file","fqn":"php_ini_loaded_file","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":39718,"end":39737}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Retrieve a path to the loaded php.ini file /","params":[],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"php_ini_scanned_files","fqn":"php_ini_scanned_files","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":39441,"end":39462}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Return a list of .ini files parsed from the additional ini dir followed by a newline. If the directive --with-config-file-scan-dir wasn't set, false is returned. If it was set and the directory was empty, an empty string is returned. If a file is unrecognizable, the file will still make it into the returned string but a PHP error will also result. This PHP error will be seen both at compile time and while using php_ini_scanned_files. /","params":[],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"php_logo_guid","fqn":"php_logo_guid","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":37262,"end":37275}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Gets the logo guid /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"php_real_logo_guid","fqn":"php_real_logo_guid","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":37323,"end":37341}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"php_sapi_name","fqn":"php_sapi_name","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":38273,"end":38286}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Returns the type of interface between web server and PHP <p> Although not exhaustive, the possible return values include aolserver, apache, apache2filter, apache2handler, caudium, cgi (until PHP 5.3), cgi-fcgi, cli, continuity, embed, isapi, litespeed, milter, nsapi, phttpd, pi3web, roxen, thttpd, tux, and webjames. </p> /","params":[],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"php_strip_whitespace","fqn":"php_strip_whitespace","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":15085,"end":15105}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Return source with stripped comments and whitespace Path to the PHP file. </p> on failure. </p> <p> This function works as described as of PHP 5.0.1. Before this it would only return an empty string. For more information on this bug and its prior behavior, see bug report #29606. /","params":[{"name":"filename","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"php_uname","fqn":"php_uname","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":38710,"end":38719}},"declared_type":null,"signature":{"parameters":[{"name":"mode","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Returns information about the operating system PHP is running on mode is a single character that defines what information is returned: 'a': This is the default. Contains all modes in the sequence \"s n r v m\".</p> /","params":[{"name":"mode","declared_type":"string","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"phpcredits","fqn":"phpcredits","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":37037,"end":37047}},"declared_type":null,"signature":{"parameters":[{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Prints out the credits for PHP To generate a custom credits page, you may want to use the flags parameter. </p> <p> <table> Pre-defined phpcredits flags <tr valign=\"top\"> <td>name</td> <td>description</td> </tr> <tr valign=\"top\"> <td>CREDITS_ALL</td> <td> All the credits, equivalent to using: CREDITS_DOCS + CREDITS_GENERAL + CREDITS_GROUP + CREDITS_MODULES + CREDITS_FULLPAGE. It generates a complete stand-alone HTML page with the appropriate tags. </td> </tr> <tr valign=\"top\"> <td>CREDITS_DOCS</td> <td>The credits for the documentation team</td> </tr> <tr valign=\"top\"> <td>CREDITS_FULLPAGE</td> <td> Usually used in combination with the other flags. Indicates that a complete stand-alone HTML page needs to be printed including the information indicated by the other flags. </td> </tr> <tr valign=\"top\"> <td>CREDITS_GENERAL</td> <td> General credits: Language design and concept, PHP 4.0 authors and SAPI module. </td> </tr> <tr valign=\"top\"> <td>CREDITS_GROUP</td> <td>A list of the core developers</td> </tr> <tr valign=\"top\"> <td>CREDITS_MODULES</td> <td> A list of the extension modules for PHP, and their authors </td> </tr> <tr valign=\"top\"> <td>CREDITS_SAPI</td> <td> A list of the server API modules for PHP, and their authors </td> </tr> </table> </p> /","params":[{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"phpdbg_break_file","fqn":"phpdbg_break_file","kind":"Function","origin":"PhpRuntime","extension":"phpdbg","location":{"file":"phpdbg/phpdbg.php","range":{"start":563,"end":580}},"declared_type":null,"signature":{"parameters":[{"name":"file","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"line","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Inserts a breakpoint at a line in a file Insert a breakpoint at the given line in the given file. /","params":[{"name":"file","declared_type":"string","description":"The name of the file."},{"name":"line","declared_type":"int","description":"The line number."}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"phpdbg_break_function","fqn":"phpdbg_break_function","kind":"Function","origin":"PhpRuntime","extension":"phpdbg","location":{"file":"phpdbg/phpdbg.php","range":{"start":1313,"end":1334}},"declared_type":null,"signature":{"parameters":[{"name":"function","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Inserts a breakpoint at entry to a function Insert a breakpoint at the entry to the given function. /","params":[{"name":"