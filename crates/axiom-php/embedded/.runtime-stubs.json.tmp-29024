m value instead of the raw integer As the value is interpreted as boolean by the Net-SNMP library, it can only be \"0\" or \"1\". </p> /","params":[{"name":"enum_print","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"snmp_set_oid_numeric_print","fqn":"snmp_set_oid_numeric_print","kind":"Function","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":24152,"end":24178}},"declared_type":null,"signature":{"parameters":[{"name":"oid_format","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Set the oid output format /","params":[{"name":"oid_format","declared_type":"int","description":null}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"snmp_set_oid_output_format","fqn":"snmp_set_oid_output_format","kind":"Function","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":23920,"end":23946}},"declared_type":null,"signature":{"parameters":[{"name":"oid_format","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Set the OID output format OID .1.3.6.1.2.1.1.3.0 representation for various <i>oid_format</i> values <tr valign=\"top\"><td><b>SNMP_OID_OUTPUT_FULL</b></td><td>.iso.org.dod.internet.mgmt.mib-2.system.sysUpTime.sysUpTimeInstance</td></tr> <tr valign=\"top\"><td><b>SNMP_OID_OUTPUT_NUMERIC</b></td><td>.1.3.6.1.2.1.1.3.0</td> </tr> </table> <p>Begining from PHP 5.4.0 four additional constants available: <table> <tr valign=\"top\"><td><b>SNMP_OID_OUTPUT_MODULE</b></td><td>DISMAN-EVENT-MIB::sysUpTimeInstance</td></tr> <tr valign=\"top\"><td><b>SNMP_OID_OUTPUT_SUFFIX</b></td><td>sysUpTimeInstance</td></tr> <tr valign=\"top\"><td><b>SNMP_OID_OUTPUT_UCD</b></td><td>system.sysUpTime.sysUpTimeInstance</td></tr> <tr valign=\"top\"><td><b>SNMP_OID_OUTPUT_NONE</b></td><td>Undefined</td></tr> </table> </p> /","params":[{"name":"oid_format","declared_type":"int","description":"[optional] <table>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"snmp_set_quick_print","fqn":"snmp_set_quick_print","kind":"Function","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":22521,"end":22541}},"declared_type":null,"signature":{"parameters":[{"name":"quick_print","declared_type":null,"phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Set the value of <i>quick_print</i> within the UCD SNMP library /","params":[{"name":"quick_print","declared_type":"bool","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"snmp_set_valueretrieval","fqn":"snmp_set_valueretrieval","kind":"Function","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":40729,"end":40752}},"declared_type":null,"signature":{"parameters":[{"name":"method","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Specify the method how the SNMP values will be returned types <tr valign=\"top\"> <td>SNMP_VALUE_LIBRARY</td> <td>The return values will be as returned by the Net-SNMP library.</td> </tr> <tr valign=\"top\"> <td>SNMP_VALUE_PLAIN</td> <td>The return values will be the plain value without the SNMP type hint.</td> </tr> <tr valign=\"top\"> <td>SNMP_VALUE_OBJECT</td> <td> The return values will be objects with the properties \"value\" and \"type\", where the latter is one of the SNMP_OCTET_STR, SNMP_COUNTER etc. constants. The way \"value\" is returned is based on which one of constants <b>SNMP_VALUE_LIBRARY</b>, <b>SNMP_VALUE_PLAIN</b> is set. </td> </tr> </table> /","params":[{"name":"method","declared_type":"int","description":"<table>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"snmpget","fqn":"snmpget","kind":"Function","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":15309,"end":15316}},"declared_type":null,"signature":{"parameters":[{"name":"hostname","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"community","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"object_id","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"retries","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Fetch an SNMP object The SNMP agent. </p> The read community. </p> The SNMP object. </p> The number of microseconds until the first timeout. </p> The number of times to retry if timeouts occur. </p> /","params":[{"name":"hostname","declared_type":"string","description":"<p>"},{"name":"community","declared_type":"string","description":"<p>"},{"name":"object_id","declared_type":"string","description":"<p>"},{"name":"timeout","declared_type":"int","description":"[optional] <p>"},{"name":"retries","declared_type":"int","description"