ole","location":{"file":"swoole/Swoole/Coroutine/Socket.php","range":{"start":2500,"end":2511}},"declared_type":null,"signature":{"parameters":[{"name":"io_vector","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"mixed|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"io_vector","declared_type":"mixed","description":null},{"name":"timeout","declared_type":"mixed|null","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"writeVectorAll","fqn":"Socket::writeVectorAll","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Socket.php","range":{"start":2667,"end":2681}},"declared_type":null,"signature":{"parameters":[{"name":"io_vector","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"mixed|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"io_vector","declared_type":"mixed","description":null},{"name":"timeout","declared_type":"mixed|null","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"SolrClient::__construct","kind":"Method","origin":"PhpRuntime","extension":"solr","location":{"file":"solr/SolrClient.php","range":{"start":9126,"end":9137}},"declared_type":null,"signature":{"parameters":[{"name":"clientOptions","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"(PECL solr &gt;= 0.9.2)<br/> SolrClient constructor. This is an array containing one of the following keys : </p> <ul> <li><b>secure</b>: (Boolean value indicating whether or not to connect in secure mode)</li> <li><b>hostname</b>: (The hostname for the Solr server)</li> <li><b>port</b>: (The port number)</li> <li><b>path</b>: (The path to solr)</li> <li><b>wt</b>: (The name of the response writer e.g. xml, json)</li> <li><b>login</b>: (The username used for HTTP Authentication, if any)</li> <li><b>password</b>: (The HTTP Authentication password)</li> <li><b>proxy_host</b>: (The hostname for the proxy server, if any)</li> <li><b>proxy_port</b>: (The proxy port)</li> <li><b>proxy_login</b>: (The proxy username)</li> <li><b>proxy_password</b>: (The proxy password)</li> <li><b>timeout</b>: (This is maximum time in seconds allowed for the http data transfer operation. Default is 30 seconds)</li> <li><b>ssl_cert</b>: (File name to a PEM-formatted file containing the private key + private certificate (concatenated in that order) )</li> <li><b>ssl_key</b>: (File name to a PEM-formatted private key file only)</li> <li><b>ssl_keypassword</b>: (Password for private key)</li> <li><b>ssl_cainfo</b>: (Name of file holding one or more CA certificates to verify peer with)</li> <li><b>ssl_capath</b>: (Name of directory holding multiple CA certificates to verify peer with )</li> </ul> <p> Please note the if the ssl_cert file only contains the private certificate, you have to specify a separate ssl_key file. </p> <p> The ssl_keypassword option is required if the ssl_cert or ssl_key options are set. </p> /","params":[{"name":"clientOptions","declared_type":"array","description":"<p>"}],"return_type":null,"var_type":null,"throws":["SolrIllegalArgumentException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__destruct","fqn":"SolrClient::__destruct","kind":"Method","origin":"PhpRuntime","extension":"solr","location":{"file":"solr/SolrClient.php","range":{"start":12289,"end":12299}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"(PECL solr &gt;= 0.9.2)<br/> Destructor for SolrClient /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addDocument","fqn":"SolrClient::addDocument","kind":"Method","origin":"PhpRuntime","extension":"solr","location":{"file":"solr/SolrClient.php","range":{"start":3583,"end":3594}},"declared_type":null,"signature":{"parameters":[{"name":"doc","declared_type":"SolrInputDocument","phpdoc_type":"SolrInputDocument","optional":false,"variadic":false,"by_reference":false},{"name":"overwrite","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"commitWithin","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"SolrUpdateResponse"},"documentation":{"description":"(PECL solr &gt;= 0.9.2)<br/> Adds a document to the index The SolrInputDocument instance. </p> Whether to overwrite existing document or not. If <b>FALSE</b> there will be duplicates (several documents with the same ID). </p> <div> <b>Warning</b><br/> PECL Solr < 2.0 $allowDups was used instead of $overwrite, which does the same functionality with exact opposite bool flag.<br/> <br/> $allowDups = false is the same as $overwrite = true </div> Number of milliseconds within which to auto commit this document. Available since Solr 1.4 . Default (0) means disabled. </p> <p> When this value specified, it leaves the control of when to do the commit to Solr itself, optimizing number of commits to a minimum while still fulfilling the update latency requirements, and Solr will automatically do a commit when the oldest add in the buffer is due. </p> Returns a SolrUpdateResponse object or throws an Exception on failure. </p> Throws SolrClientException if the client had failed, or there was a connection issue. </p> Throws SolrServerException if the Solr Server had failed to satisfy the request. </p> /","params":[{"name":"doc","declared_type":"SolrInputDocument","description":"<p>"},{"name":"overwrite","declared_type":"bool","description":"[optional] <p>"},{"name":"commitWithin","declared_type":"int","description":"[optional] <p>"}],"return_type":"SolrUpdateResponse","var_type":null,"throws":["SolrClientException","SolrServerException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addDocuments","fqn":"SolrClient::addDocuments","kind":"Method","origin":"PhpRuntime","extension":"solr","location":{"file":"solr/SolrClient.php","range":{"start":5409,"end":5421}},"declared_type":null,"signature":{"parameters":[{"name":"docs","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"overwrite","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"commitWithin","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"SolrUpdateResponse"},"documentation":{"description":"(PECL solr &gt;= 0.9.2)<br/> Adds a collection of SolrInputDocument instances to the index An array containing the collection of SolrInputDocument instances. This array must be an actual variable. </p> Whether to overwrite existing document or not. If <b>FALSE</b> there will be duplicates (several documents with the same ID). </p> <div> <b>Warning</b><br/> PECL Solr < 2.0 $allowDups was used instead of $overwrite, which does the same functionality with exact opposite bool flag.<br/> <br/> $allowDups = false is the same as $overwrite = true </div> Number of milliseconds within which to auto commit this document. Available since Solr 1.4 . Default (0) means disabled. </p> <p> When this value specified, it leaves the control of when to do the commit to Solr itself, optimizing number of commits to a minimum while still fulfilling the update latency requirements, and Solr will automatically do a commit when the oldest add in the buffer is due. </p> Returns a SolrUpdateResponse object or throws an Exception on failure. </p> Throws SolrClientException if the client had failed, or there was a connection issue. </p> Throws SolrServerException if the Solr Server had failed to satisfy the request. </p> /","params":[{"name":"docs","declared_type":"array","description":"<p>"},{"name":"overwrite","declared_type":"bool","description":"[optional] <p>"},{"name":"commitWithin","declared_type":"int","description":"[optional] <p>"}],"return_type":"SolrUpdateResponse","var_type":null,"throws":["SolrClientException","SolrServerException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"commit","fqn":"SolrClient::commit","kind":"Method","origin":"PhpRuntime","extension":"solr","location":{"file":"solr/SolrClient.php","range":{"start":7027,"end":7033}},"declared_type":null,"signature":{"parameters":[{"name":"softCommit","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"waitSearcher","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"expungeDeletes","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"SolrUpdateResponse"},"documentation":{"description":"(PECL solr &gt;= 0.9.2)<br/> Finalizes all add/deletes made to the index This will refresh the 'view' of the index in a more performant manner, but without \"on-disk\" guarantees. (Solr4.0+) </p> <p> A soft commit is much faster since it only makes index changes visible and does not fsync index files or write a new index descriptor. If the JVM crashes or there is a loss of power, changes that occurred after the last hard commit will be lost. Search collections that have near-real-time requirements (that want index changes to be quickly visible to searches) will want to soft commit often but hard commit less frequently. </p> block until a new searcher is opened and registered as the main query searcher, making the changes visible. </p> Merge segments with deletes away. (Solr1.4+) </p> Returns a SolrUpdateResponse object or throws an Exception on failure. </p> Throws SolrClientException if the client had failed, or there was a connection issue. </p> Throws SolrServerException if the Solr Server had failed to satisfy the request. </p> /","params":[{"name":"softCommit","declared_type":"bool","description":"[optional] <p>"},{"name":"waitSearcher","declared_type":"bool","description":"[optional] <p>"},{"name":"expungeDeletes","declared_type":"bool","description":"[optional] <p>"}],"return_type":"SolrUpdateResponse","var_type":null,"throws":["SolrClientException","SolrServerException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"deleteById","fqn":"SolrClient::deleteById","kind":"Method","origin":"PhpRuntime","extension":"solr","location":{"file":"solr/SolrClient.php","range":{"start":9841,"end":9851}},"declared_type":null,"signature":{"parameters":[{"name":"id","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"SolrUpdateResponse"},"documentation":{"description":"(PECL solr &gt;= 0.9.2)<br/> Delete by Id The value of the uniqueKey field declared in the schema </p> Returns a SolrUpdateResponse on success and throws an exception on failure. </p> Throws SolrClientException if the client had failed, or there was a connection issue. </p> Throws SolrServerException if the Solr Server had failed to satisfy the request. </p> /","params":[{"name":"id","declared_type":"string","description":"<p>"}],"return_type":"SolrUpdateResponse","var_type":null,"throws":["SolrClientException","SolrServerException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"deleteByIds","fqn":"SolrClient::deleteByIds","kind":"Method","origin":"PhpRuntime","extension":"solr","location":{"file":"solr/SolrClient.php","range":{"start":10634,"end":10645}},"declared_type":null,"signature":{"parameters":[{"name":"ids","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"SolrUpdateResponse"},"documentation":{"description":"(PECL solr &gt;= 0.9.2)<br/> Deletes by Ids An array of IDs representing the uniqueKey field declared in the schema for each document to be deleted. This must be an actual php variable. </p> Returns a SolrUpdateResponse on success and throws an exception on failure. </p> Throws SolrClientException if the client had failed, or there was a connection issue. </p> Throws SolrServerException if the Solr Server had failed to satisfy the request. </p> /","params":[{"name":"ids","declared_type":"array","description":"<p>"}],"return_type":"SolrUpdateResponse","var_type":null,"throws":["SolrClientException","SolrServerException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"deleteByQueries","fqn":"SolrClient::deleteByQueries","kind":"Method","origin":"PhpRuntime","extension":"solr","location":{"file":"solr/SolrClient.php","range":{"start":11388,"end":11403}},"declared_type":null,"signature":{"parameters":[{"name":"queries","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"SolrUpdateResponse"},"documentation":{"description":"(PECL solr &gt;= 0.9.2)<br/> Removes all documents matching any of the queries The array of queries. This must be an actual 