l":null},"is_static":false},{"name":"strncmp","fqn":"strncmp","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":2644,"end":2651}},"declared_type":null,"signature":{"parameters":[{"name":"string1","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"string2","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Binary safe string comparison of the first n characters The first string. </p> The second string. </p> Number of characters to use in the comparison. </p> <i>str2</i>; &gt; 0 if <i>str1</i> is greater than <i>str2</i>, and 0 if they are equal. /","params":[{"name":"string1","declared_type":"string","description":"<p>"},{"name":"string2","declared_type":"string","description":"<p>"},{"name":"length","declared_type":"int","description":"<p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"strpbrk","fqn":"strpbrk","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":14092,"end":14099}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"char_list","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"characters","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Search a string for any of a set of characters The string where char_list is looked for. </p> This parameter is case sensitive. </p> not found. /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"characters","declared_type":"string","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"strpos","fqn":"strpos","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":1799,"end":1805}},"declared_type":null,"signature":{"parameters":[{"name":"haystack","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"needle","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int<0,max>","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int<0,max>|false"},"documentation":{"description":"Find the position of the first occurrence of a substring in a string The string to search in </p> If <b>needle</b> is not a string, it is converted to an integer and applied as the ordinal value of a character. </p> If specified, search will start this number of characters counted from the beginning of the string. Unlike {@see strrpos()} and {@see strripos()}, the offset cannot be negative. </p> Returns the position where the needle exists relative to the beginning of the <b>haystack</b> string (independent of search direction or offset). Also note that string positions start at 0, and not 1. </p> <p> Returns <b>FALSE</b> if the needle was not found. </p> thrown. /","params":[{"name":"haystack","declared_type":"string","description":"<p>"},{"name":"needle","declared_type":"string","description":"<p>"},{"name":"offset","declared_type":"int<0,max>","description":"[optional] <p>"}],"return_type":"int<0,max>|false","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"strptime","fqn":"strptime","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":11593,"end":11601}},"declared_type":null,"signature":{"parameters":[{"name":"timestamp","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"format","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Parse a time/date generated with <function>strftime</function> The string to parse (e.g. returned from strftime) </p> The format used in date (e.g. the same as used in strftime). </p> <p> For more information about the format options, read the strftime page. </p> <p> <table> The following parameters are returned in the array <tr valign=\"top\"> <td>parameters</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>\"tm_sec\"</td> <td>Seconds after the minute (0-61)</td> </tr> <tr valign=\"top\"> <td>\"tm_min\"</td> <td>Minutes after the hour (0-59)</td> </tr> <tr valign=\"top\"> <td>\"tm_hour\"</td> <td>Hour since midnight (0-23)</td> </tr> <tr valign=\"top\"> <td>\"tm_mday\"</td> <td>Day of the month (1-31)</td> </tr> <tr valign=\"top\"> <td>\"tm_mon\"</td> <td>Months since January (0-11)</td> </tr> <tr valign=\"top\"> <td>\"tm_year\"</td> <td>Years since 1900</td> </tr> <tr valign=\"top\"> <td>\"tm_wday\"</td> <td>Days since Sunday (0-6)</td> </tr> <tr valign=\"top\"> <td>\"tm_yday\"</td> <td>Days since January 1 (0-365)</td> </tr> <tr valign=\"top\"> <td>\"unparsed\"</td> <td>the date part which was not recognized using the specified format</td> </tr> </table> </p> /","params":[{"name":"timestamp","declared_type":"string","description":"<p>"},{"name":"format","declar