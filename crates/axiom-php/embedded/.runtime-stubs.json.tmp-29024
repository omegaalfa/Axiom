edisCluster|string|array","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hscan","fqn":"RedisCluster::hscan","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":106039,"end":106044}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"iterator","declared_type":"null|int|string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"pattern","declared_type":"?string","phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|bool","phpdoc_return_type":null},"documentation":{"description":"Scan a HASH value for members, with an optional pattern and count. <pre> $iterator = null; while($elements = $redisCluster->hscan('hash', $iterator)) { foreach($elements as $key => $value) { echo $key . ' => ' . $value . PHP_EOL; } } </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"","declared_type":null,"description":null},{"name":"pattern","declared_type":"null|string","description":"Optional pattern to match against."},{"name":"count","declared_type":"int","description":"How many keys to return in a go (only a sugestion to Redis)."}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hSet","fqn":"RedisCluster::hSet","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":55387,"end":55391}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Adds a value to the hash stored at key. If this value is already in the hash, FALSE is returned. 1 if value didn't exist and was added successfully, 0 if the value was already present and was replaced, FALSE if there was an error. <pre> $redisCluster->del('h') $redisCluster->hSet('h', 'key1', 'hello');  // 1, 'key1' => 'hello' in the hash at \"h\" $redisCluster->hGet('h', 'key1');           // returns \"hello\" $redisCluster->hSet('h', 'key1', 'plop');   // 0, value was replaced. $redisCluster->hGet('h', 'key1');           // returns \"plop\" </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"member","declared_type":"string","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hsetex","fqn":"RedisCluster::hsetex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":164919,"end":164925}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"fields","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"expiry","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Set one or more fields in a hash with optional expiration information. /","params":[{"name":"key","declared_type":"string","description":"The hash to create/update."},{"name":"fields","declared_type":"array","description":"An array with field values."},{"name":"expiry","declared_type":"array|null","description":"Info about the expiration (e.g. ['EX' => 60])."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hSetNx","fqn":"RedisCluster::hSetNx","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":56200,"end":56206}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Adds a value to the hash stored at key only if this field isn't already in the hash. <pre> $redisCluster->del('h') $redisCluster->hSetNx('h', 'key1', 'hello'); // TRUE, 'key1' => 'hello' in the hash at \"h\" $redisCluster->hSetNx('h', 'key1', 'world'); // FALSE, 'key1' => 'hello' in the hash at \"h\". No change since the field wasn't replaced. </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"member","declared_type":"string","description":null},{"name":"value","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hStrLen","fqn":"RedisCluster::hStrLen","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":163100,"end":163107}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"field","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Get the string length of a hash field's value. /","params":[{"name":"key","declared_type":"string","description":"The hash to query."},{"name":"field","declared_type":"string","description":"The field to check."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"httl","fqn":"RedisCluster::httl","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":168945,"end":168949}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"fields","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":"RedisCluster|array|false"},"documentation":{"description":"Get the remaining time to live (in seconds) of one or more fields of a hash. /","params":[{"name":"key","declared_type":"string","description":"The hash to query."},{"name":"fields","declared_type":"array","description":"One or more fields to check."}],"return_type":"RedisCluster|array|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hVals","fqn":"RedisCluster::hVals","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":51420,"end":51425}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns the values in a hash, as an array of strings. <pre> $redisCluster->del('h'); $redisCluster->hSet('h', 'a', 'x'); $redisCluster->hSet('h', 'b', 'y'); $redisCluster->hSet('h', 'c', 'z'); $redisCluster->hSet('h', 'd', 't'); var_dump($redisCluster->hVals('h')); //// Output: // // array(4) { //   [0]=> //   string(1) \"x\" //   [1]=> //   string(1) \"y\" //   [2]=> //   string(1) \"z\" //   [3]=> //   string(1) \"t\" // } // The order is random and corresponds to redis' own internal representation of the set structure. </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"incr","fqn":"RedisCluster::incr","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":62258,"end":62262}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"by","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Increment the number stored at key by one. <pre> $redisCluster->incr('key1'); // key1 didn't exists, set to 0 before the increment and now has the value 1 $redisCluster->incr('key1'); // 2 $redisCluster->incr('key1'); // 3 $redisCluster->incr('key1'); // 4 </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"incrBy","fqn":"RedisCluster::incrBy","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":63724,"end":63730}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Increment the number stored at key by one. If the second argument is filled, it will be used as the integer value of the increment. <pre> $redisCluster->incr('key1');        // key1 didn't exists, set to 0 before the increment and now has the value 1 $redisCluster->incr('key1');        // 2 $redisCluster->incr('key1');        // 3 $redisCluster->incr('key1');        // 4 $redisCluster->incrBy('key1', 10);  // 14 </pre> /","params":[{"name":"key","declared_type":"string","description":"key"},{"name":"value","declared_type":"int","description":"value that will be added to key (only for incrBy)"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"incrByFloat","fqn":"RedisCluster::incrByFloat","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":65144,"end":65155}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|float|false","phpdoc_return_type":null},"documentation":{"description":"Increment the float value of a key by the given amount <pre> $redisCluster->set('x', 3); var_dump( $redisCluster->incrByFloat('x', 1.5) );   // float(4.5) var_dump( $redisCluster->get('x') );                // string(3) \"4.5\" </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"float","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"info","fqn":"RedisCluster::info","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":121556,"end":121560}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"sections","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns an associative array of strings and integers Returns an associative array of strings and integers, with the following keys: - redis_version - redis_git_sha1 - redis_git_dirty - redis_build_id - redis_mode - os - arch_bits - multiplexing_api - atomicvar_api - gcc_version - process_id - run_id - tcp_port - uptime_in_seconds - uptime_in_days - hz - lru_clock - executable - config_file - connected_clients - client_longest_output_list - client_biggest_input_buf - blocked_clients - used_memory - used_memory_human - used_memory_rss - used_memory_rss_human - used_memory_peak - used_memory_peak_human - used_memory_peak_perc - used_memory_peak - used_memory_overhead - used_memory_startup - used_memory_dataset - used_memory_dataset_perc - total_system_memory - total_system_memory_human - used_memory_lua - used_memory_lua_human - maxmemory - maxmemory_human - maxmemory_policy - mem_fragmentation_ratio - mem_allocator - active_defrag_running - lazyfree_pending_objects - mem_fragmentation_ratio - loading - rdb_changes_since_last_save - rdb_bgsave_in_progress - rdb_last_save_time - rdb_last_bgsave_status - rdb_last_bgsave_time_sec - rdb_current_bgsave_time_sec - rdb_last_cow_size - aof_enabled - aof_rewrite_in_progress - aof_rewrite_scheduled - aof_last_rewrite_time_sec - aof_current_rewrite_time_sec - aof_last_bgrewrite_status - aof_last_write_status - aof_last_cow_size - changes_since_last_save - aof_current_size - aof_base_size - aof_pending_rewrite - aof_buffer_length - aof_rewrite_buffer_length - aof_pending_bio_fsync - aof_delayed_fsync - loading_start_time - loading_total_bytes - loading_loaded_bytes - loading_loaded_perc - loading_eta_seconds - total_connections_received - total_commands_processed - instantaneous_ops_per_sec - total_net_input_bytes - total_net_output_bytes - instantaneous_input_kbps - instantaneous_output_kbps - rejected_connections - maxclients - sync_full - sync_partial_ok - sync_partial_err - expired_keys - evicted_keys - keyspace_hits - keyspace_misses - pubsub_channels - pubsub_patterns - latest_fork_usec - migrate_cached_sockets - slave_expires_tracked_keys - active_defrag_hits - active_defrag_misses - active_defrag_key_hits - active_defrag_key_misses - role - master_replid - master_replid2 - master_repl_offset - second_repl_offset - repl_backlog_active - repl_backlog_size - repl_backlog_first_byte_offset - repl_backlog_histlen - master_host - master_port - master_link_status - master_last_io_seconds_ago - master_sync_in_progress - slave_repl_offset - slave_priority - slave_read_only - master_sync_left_bytes - master_sync_last_io_seconds_ago - master_link_down_since_seconds - connected_slaves - min-slaves-to-write - min-replicas-to-write - min_slaves_good_slaves - used_cpu_sys - used_cpu_user - used_cpu_sys_children - used_cpu_user_children - cluster_enabled <pre> $redisCluster->info(); or $redisCluster->info(\"COMMANDSTATS\"); //Information on the commands that have been run (>=2.6 only) $redisCluster->info(\"CPU\"); // just CPU information from Redis INFO </pre> /","params":[{"name":"key_or_address","declared_type":"string|array","description":null},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"keys","fqn":"RedisCluster::keys","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":10497,"end":10501}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns the keys that match a certain pattern. <pre> $allKeys = $redisCluster->keys('*');   // all keys will match this. $keyWithUserPrefix = $redisCluster->keys('user*'); </pre> /","params":[{"name":"pattern","declared_type":"string","description":"pattern, using '*' as a wildcard."}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lastSave","fqn":"RedisCluster::lastSave","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":117091,"end":117099}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Returns the timestamp of the last disk save at a specific node. /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lcs","fqn":"RedisCluster::lcs","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":160152,"end":160155}},"declared_type":null,"signature":{"parameters":[{"name":"key1","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key2","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|string|array|int|false","phpdoc_return_type":"RedisCluster|string|array|int|false"},"documentation":{"description":"Find the longest common subsequence between two string keys. Note that both keys must map to the same slot. /","params":[{"name":"key1","declared_type":"string","description":"The first key to compare."},{"name":"key2","declared_type":"string","description":"The second key to compare."},{"name":"options","declared_type":"array|null","description":"Options to modify how the command executes (e.g. ['len'], ['idx'], ['minmatchlen' => n])."}],"return_type":"RedisCluster|string|array|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lGet","fqn":"RedisCluster::lGet","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":75204,"end":75208}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"index","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|string|bool","phpdoc_return_type":null},"documentation":{"description":"/","params":[{"name":"key","declared_type":"string","description":null},{"name":"index","declared_type":"int","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lindex","fqn":"RedisCluster::lindex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":24705,"end":24711}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"index","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Return the specified element of the list stored at the specified key. 0 the first element, 1 the second ... -1 the last element, -2 the penultimate ... Return FALSE in case of a bad index or a key that doesn't point to a list. Bool FALSE if the key identifies a non-string data type, or no value corresponds to this index in the list Key. <pre> $redisCluster->rPush('key1', 'A'); $redisCluster->rPush('key1', 'B'); $redisCluster->rPush('key1', 'C');  // key1 => [ 'A', 'B', 'C' ] $redisCluster->lGet('key1', 0);     // 'A' $redisCluster->lGet('key1', -1);    // 'C' $redisCluster->lGet('key1', 10);    // `FALSE` </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"index","declared_type":"int","description":null}],"return_type":"mixed","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lInsert","fqn":"RedisCluster::lInsert","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":23657,"end":23664}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pos","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pivot","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Insert value in the list before or after the pivot value. the parameter options specify the position of the insert (before or after). If the list didn't exists, or the pivot didn't exists, the value is not inserted. <pre> $redisCluster->del('key1'); $redisCluster->lInsert('key1', RedisCluster::AFTER, 'A', 'X');    // 0 $redisCluster->lPush('key1', 'A'); $redisCluster->lPush('key1', 'B'); $redisCluster->lPush('key1', 'C'); $redisCluster->lInsert('key1', RedisCluster::BEFORE, 'C', 'X');   // 4 $redisCluster->lRange('key1', 0, -1);                      // array('X', 'C', 'B', 'A') $redisCluster->lInsert('key1', RedisCluster::AFTER, 'C', 'Y');    // 5 $redisCluster->lRange('key1', 0, -1);                      // array('X', 'C', 'Y', 'B', 'A') $redisCluster->lInsert('key1', RedisCluster::AFTER, 'W', 'value'); // -1 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"pos","declared_type":"string","description":"RedisCluster::BEFORE | RedisCluster::AFTER"},{"name":"pivot","declared_type":"mixed","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lLen","fqn":"RedisCluster::lLen","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":28493,"end":28497}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|bool","phpdoc_return_type":null},"documentation":{"description":"Returns the size of a list identified by Key. If the list didn't exist or is empty, the command returns 0. If the data type identified by Key is not a list, the command return FALSE. bool FALSE if the data type identified by Key is not list <pre> $redisCluster->rPush('key1', 'A'); $redisCluster->rPush('key1', 'B'); $redisCluster->rPush('key1', 'C');  // key1 => [ 'A', 'B', 'C' ] $redisCluster->lLen('key1');       // 3 $redisCluster->rPop('key1'); $redisCluster->lLen('key1');       // 2 </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lMove","fqn":"RedisCluster::lMove","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":141067,"end":141072}},"declared_type":null,"signature":{"parameters":[{"name":"src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"wherefrom","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"whereto","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|string|false","phpdoc_return_type":"RedisCluster|string|false"},"documentation":{"description":"Move an element from one list into another. <pre> $redisCluster->rPush('numbers', 'one', 'two', 'three'); $redisCluster->lMove('numbers', 'odds', RedisCluster::LEFT, RedisCluster::LEFT); </pre> /","params":[{"name":"src","declared_type":"string","description":"The source list."},{"name":"dst","declared_type":"string","description":"The destination list."},{"name":"wherefrom","declared_type":"string","description":"Where in the source list to retrieve the element (RedisCluster::LEFT or RedisCluster::RIGHT)."},{"name":"whereto","declared_type":"string","description":"Where in the destination list to put the element (RedisCluster::LEFT or RedisCluster::RIGHT)."}],"return_type":"RedisCluster|string|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lmovem","fqn":"RedisCluster::lmovem","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":142145,"end":142151}},"declared_type":null,"signature":{"parameters":[{"name":"src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"wherefrom","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"whereto","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":"RedisCluster|array|false"},"documentation":{"description":"Move one or more element from one list to another. <pre> $redisCluster->rPush('numbers', 'one', 'two', 'three'); $redisCluster->lMovem('numbers', 'odds', RedisCluster::LEFT, RedisCluster::LEFT, ['COUNT' => [2, 'BULK']]); </pre> /","params":[{"name":"src","declared_type":"string","description":"The source list."},{"name":"dst","declared_type":"string","description":"The destination list."},{"name":"wherefrom","declared_type":"string","description":"Where in the source list to extract the element (RedisCluster::LEFT or RedisCluster::RIGHT)."},{"name":"whereto","declared_type":"string","description":"Where in the destination list to put the element (RedisCluster::LEFT or RedisCluster::RIGHT)."},{"name":"options","declared_type":"array|null","description":"An array of options to modify how the command behaves."}],"return_type":"RedisCluster|array|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lmpop","fqn":"RedisCluster::lmpop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":148415,"end":148420}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"from","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|null|false","phpdoc_return_type":"RedisCluster|array|null|false"},"documentation":{"description":"Pop one or more elements from the first non-empty list. /","params":[{"name":"keys","declared_type":"array","description":"One or more list keys to pop from."},{"name":"from","declared_type":"string","description":"The string 'LEFT' or 'RIGHT' to pop from the head or tail of the list."},{"name":"count","declared_type":"int","description":"The maximum number of elements to pop."}],"return_type":"RedisCluster|array|null|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lPop","fqn":"RedisCluster::lPop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":12195,"end":12199}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|string|array","phpdoc_return_type":null},"documentation":{"description":"Returns and removes the first element of the list. <pre> $redisCluster->rPush('key1', 'A'); $redisCluster->rPush('key1', 'B'); $redisCluster->rPush('key1', 'C'); var_dump( $redisCluster->lRange('key1', 0, -1) ); // Output: // array(3) { //   [0]=> string(1) \"A\" //   [1]=> string(1) \"B\" //   [2]=> string(1) \"C\" // } $redisCluster->lPop('key1'); var_dump( $redisCluster->lRange('key1', 0, -1) ); // Output: // array(2) { //   [0]=> string(1) \"B\" //   [1]=> string(1) \"C\" // } </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lPos","fqn":"RedisCluster::lPos","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":171632,"end":171636}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|null|bool|int|array","phpdoc_return_type":"RedisCluster|null|bool|int|array"},"documentation":{"description":"Get the position(s) of an element in a list. /","params":[{"name":"key","declared_type":"string","description":"The list to query."},{"name":"value","declared_type":"mixed","description":"The value to search for."},{"name":"options","declared_type":"array|null","description":"An array of options to modify how the command behaves (e.g. ['RANK' => n, 'COUNT' => n])."}],"return_type":"RedisCluster|null|bool|int|array","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lPush","fqn":"RedisCluster::lPush","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":15920,"end":15925}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"other_values","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|int|bool","phpdoc_return_type":null},"documentation":{"description":"Adds the string values to the head (left) of the list. Creates the list if the key didn't exist. If the key exists and is not a list, FALSE is returned. <pre> $redisCluster->lPush('l', 'v1', 'v2', 'v3', 'v4')   // int(4) var_dump( $redisCluster->lRange('l', 0, -1) ); //// Output: // array(4) { //   [0]=> string(2) \"v4\" //   [1]=> string(2) \"v3\" //   [2]=> string(2) \"v2\" //   [3]=> string(2) \"v1\" // } </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"mixed","description":"String, value to push in key"},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lPushx","fqn":"RedisCluster::lPushx","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":22209,"end":22215}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|bool","phpdoc_return_type":null},"documentation":{"description":"Adds the string value to the head (left) of the list if the list exists. <pre> $redisCluster->del('key1'); $redisCluster->lPushx('key1', 'A');     // returns 0 $redisCluster->lPush('key1', 'A');      // returns 1 $redisCluster->lPushx('key1', 'B');     // returns 2 $redisCluster->lPushx('key1', 'C');     // returns 3 // key1 now points to the following list: [ 'C', 'B', 'A' ] </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"mixed","description":"Value to push in key"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lrange","fqn":"RedisCluster::lrange","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":77476,"end":77482}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns the specified elements of the list stored at the specified key in the range [start, end]. start and stop are interpretated as indices: 0 the first element, 1 the second ... -1 the last element, -2 the penultimate ... <pre> $redisCluster->rPush('key1', 'A'); $redisCluster->rPush('key1', 'B'); $redisCluster->rPush('key1', 'C'); $redisCluster->lrange('key1', 0, -1); // array('A', 'B', 'C') </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"start","declared_type":"int","description":null},{"name":"end","declared_type":"int","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lrem","fqn":"RedisCluster::lrem","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":25785,"end":25789}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|bool","phpdoc_return_type":null},"documentation":{"description":"Removes the first count occurrences of the value element from the list. If count is zero, all the matching elements are removed. If count is negative, elements are removed from tail to head. bool FALSE if the value identified by key is not a list. <pre> $redisCluster->lPush('key1', 'A'); $redisCluster->lPush('key1', 'B'); $redisCluster->lPush('key1', 'C'); $redisCluster->lPush('key1', 'A'); $redisCluster->lPush('key1', 'A'); $redisCluster->lRange('key1', 0, -1);   // array('A', 'A', 'C', 'B', 'A') $redisCluster->lrem('key1', 'A', 2);    // 2 $redisCluster->lRange('key1', 0, -1);   // array('C', 'B', 'A') </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"mixed","description":null},{"name":"count","declared_type":"int","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lSet","fqn":"RedisCluster::lSet","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":14021,"end":14025}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"index","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":"RedisCluster|bool"},"documentation":{"description":"Set the list at index with the new value. is not a list. <pre> $redisCluster->rPush('key1', 'A'); $redisCluster->rPush('key1', 'B'); $redisCluster->rPush('key1', 'C');  // key1 => [ 'A', 'B', 'C' ] $redisCluster->lGet('key1', 0);     // 'A' $redisCluster->lSet('key1', 0, 'X'); $redisCluster->lGet('key1', 0);     // 'X' </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"index","declared_type":"int","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":"RedisCluster|bool","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ltrim","fqn":"RedisCluster::ltrim","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":76622,"end":76627}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":"RedisCluster|bool"},"documentation":{"description":"Trims an existing list so that it will contain only a specified range of elements. <pre> $redisCluster->rPush('key1', 'A'); $redisCluster->rPush('key1', 'B'); $redisCluster->rPush('key1', 'C'); $redisCluster->lRange('key1', 0, -1); // array('A', 'B', 'C') $redisCluster->ltrim('key1', 0, 1); $redisCluster->lRange('key1', 0, -1); // array('A', 'B') </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"start","declared_type":"int","description":null},{"name":"stop","declared_type":"int","description":null}],"return_type":"RedisCluster|bool","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mget","fqn":"RedisCluster::mget","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":4975,"end":4979}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":"RedisCluster|array|false"},"documentation":{"description":"Returns the values of all specified keys. For every key that does not hold a string value or does not exist, the special value false is returned. Because of this, the operation never fails. <pre> $redisCluster->del('x', 'y', 'z', 'h');    // remove x y z $redisCluster->mset(array('x' => 'a', 'y' => 'b', 'z' => 'c')); $redisCluster->hset('h', 'field', 'value'); var_dump($redisCluster->mget(array('x', 'y', 'z', 'h'))); // Output: // array(3) { // [0]=> // string(1) \"a\" // [1]=> // string(1) \"b\" // [2]=> // string(1) \"c\" // [3]=> // bool(false) // } </pre> /","params":[{"name":"keys","declared_type":"array","description":null}],"return_type":"RedisCluster|array|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mset","fqn":"RedisCluster::mset","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":5726,"end":5730}},"declared_type":null,"signature":{"parameters":[{"name":"key_values","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Sets multiple key-value pairs in one atomic command. MSETNX only returns TRUE if all the keys were set (see SETNX). <pre> $redisCluster->mset(array('key0' => 'value0', 'key1' => 'value1')); var_dump($redisCluster->get('key0')); var_dump($redisCluster->get('key1')); // Output: // string(6) \"value0\" // string(6) \"value1\" </pre> /","params":[{"name":"key_values","declared_type":"array","description":"Pairs: array(key => value, ...)"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"msetex","fqn":"RedisCluster::msetex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":150869,"end":150875}},"declared_type":null,"signature":{"parameters":[{"name":"key_vals","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"expiry","declared_type":"int|float|array|null","phpdoc_type":"int|float|array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Set one or more keys and values with optional expiry information. /","params":[{"name":"key_vals","declared_type":"array","description":"An array of keys with their values."},{"name":"expiry","declared_type":"int|float|array|null","description":"An optional array with expiry information (e.g. ['EX' => 60])."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"msetnx","fqn":"RedisCluster::msetnx","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":6055,"end":6061}},"declared_type":null,"signature":{"parameters":[{"name":"key_values","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"/","params":[{"name":"key_values","declared_type":"array","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"multi","fqn":"RedisCluster::multi","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":112432,"end":112437}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":"RedisCluster|bool"},"documentation":{"description":"Enter and exit transactional mode. Defaults to RedisCluster::MULTI. A RedisCluster::MULTI block of commands runs as a single transaction; a RedisCluster::PIPELINE block is simply transmitted faster to the server, but without any guarantee of atomicity. discard cancels a transaction. Once in multi-mode, all subsequent method calls return the same object until exec() is called. <pre> $ret = $redisCluster->multi() ->set('key1', 'val1') ->get('key1') ->set('key2', 'val2') ->get('key2') ->exec(); //$ret == array ( //    0 => TRUE, //    1 => 'val1', //    2 => TRUE, //    3 => 'val2'); </pre> /","params":[{"name":"value","declared_type":"int","description":"RedisCluster::MULTI|RedisCluster::PIPELINE"}],"return_type":"RedisCluster|bool","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"object","fqn":"RedisCluster::object","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":98770,"end":98776}},"declared_type":null,"signature":{"parameters":[{"name":"subcommand","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|string|false","phpdoc_return_type":null},"documentation":{"description":"Describes the object pointed to by a key. The information to retrieve (string) and the key (string). Info can be one of the following: - \"encoding\" - \"refcount\" - \"idletime\" <pre> $redisCluster->object(\"encoding\", \"l\"); // → ziplist $redisCluster->object(\"refcount\", \"l\"); // → 1 $redisCluster->object(\"idletime\", \"l\"); // → 400 (in seconds, with a precision of 10 seconds). </pre> /","params":[{"name":"subcommand","declared_type":"string","description":null},{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"persist","fqn":"RedisCluster::persist","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":42480,"end":42487}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Remove the expiration timer from a key. /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pexpire","fqn":"RedisCluster::pexpire","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":66705,"end":66712}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Sets an expiration date (a timeout in milliseconds) on an item. <pre> $redisCluster->set('x', '42'); $redisCluster->pexpire('x', 11500); // x will disappear in 11500 milliseconds. $redisCluster->ttl('x');            // 12 $redisCluster->pttl('x');           // 11500 </pre> /","params":[{"name":"key","declared_type":"string","description":"The key that will disappear."},{"name":"timeout","declared_type":"int","description":"The key's remaining Time To Live, in milliseconds."}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pexpireAt","fqn":"RedisCluster::pexpireAt","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":68443,"end":68452}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timestamp","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Sets an expiration date (a timestamp) on an item. Requires a timestamp in milliseconds <pre> $redisCluster->set('x', '42'); $redisCluster->pExpireAt('x', 1555555555005); $redisCluster->ttl('x');                       // 218270121 $redisCluster->pttl('x');                      // 218270120575 </pre> /","params":[{"name":"key","declared_type":"string","description":"The key that will disappear."},{"name":"timestamp","declared_type":"int","description":"Unix timestamp. The key's date of death, in seconds from Epoch time."}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pexpiretime","fqn":"RedisCluster::pexpiretime","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":154571,"end":154582}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Get the expiration of a key as a unix timestamp in milliseconds. /","params":[{"name":"key","declared_type":"string","description":"The key to check."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pfadd","fqn":"RedisCluster::pfadd","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":81380,"end":81385}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"elements","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Adds all the element arguments to the HyperLogLog data structure stored at the key. /","params":[{"name":"key","declared_type":"string","description":null},{"name":"elements","declared_type":"array","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pfcount","fqn":"RedisCluster::pfcount","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":80940,"end":80947}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"When called with a single key, returns the approximated cardinality computed by the HyperLogLog data structure stored at the specified variable, which is 0 if the variable does not exist. <pre> $redisCluster->pfadd('key1', array('elem1', 'elem2')); $redisCluster->pfadd('key2', array('elem3', 'elem2')); $redisCluster->pfcount('key1'); // int(2) $redisCluster->pfcount(array('key1', 'key2')); // int(3) </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pfmerge","fqn":"RedisCluster::pfmerge","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":82125,"end":82132}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Merge multiple HyperLogLog values into an unique value that will approximate the cardinality of the union of the observed Sets of the source HyperLogLog structures. <pre> $redisCluster->pfadd('key1', array('elem1', 'elem2')); $redisCluster->pfadd('key2', array('elem3', 'elem2')); $redisCluster->pfmerge('key3', array('key1', 'key2')); $redisCluster->pfCount('key3'); // int(3) </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"keys","declared_type":"array","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ping","fqn":"RedisCluster::ping","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":123874,"end":123878}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"message","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"Check the specified node status above. /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"psetex","fqn":"RedisCluster::psetex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":8071,"end":8077}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"PSETEX works exactly like SETEX with the sole difference that the expire time is specified in milliseconds instead of seconds. <pre> $redisCluster->psetex('key', 1000, 'value'); // sets key → value, with 1s TTL. </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"ttl","declared_type":"int","description":null},{"name":"value","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"psubscribe","fqn":"RedisCluster::psubscribe","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":100865,"end":100875}},"declared_type":null,"signature":{"parameters":[{"name":"patterns","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"callback","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":null},"documentation":{"description":"Subscribe to channels by pattern The callback will get four arguments ($redis, $pattern, $channel, $message) <pre> function psubscribe($redisCluster, $pattern, $chan, $msg) { echo \"Pattern: $pattern\\n\"; echo \"Channel: $chan\\n\"; echo \"Payload: $msg\\n\"; } </pre> /","params":[{"name":"patterns","declared_type":"array","description":"The number of elements removed from the set."},{"name":"callback","declared_type":"callable","description":"Either a string or an array with an object and method."}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pttl","fqn":"RedisCluster::pttl","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":44163,"end":44167}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Returns the remaining time to live of a key that has an expire set, with the sole difference that TTL returns the amount of remaining time in seconds while PTTL returns it in milliseconds. In Redis 2.6 or older the command returns -1 if the key does not exist or if the key exist but has no associated expire. Starting with Redis 2.8 the return value in case of error changed: Returns -2 if the key does not exist. Returns -1 if the key exists but has no associated expire. /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"publish","fqn":"RedisCluster::publish","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":78876,"end":78883}},"declared_type":null,"signature":{"parameters":[{"name":"channel","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"message","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|int","phpdoc_return_type":null},"documentation":{"description":"Publish messages to channels. Warning: this function will probably change in the future. /","params":[{"name":"channel","declared_type":"string","description":"a channel to publish to"},{"name":"message","declared_type":"string","description":"string"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pubsub","fqn":"RedisCluster::pubsub","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":128439,"end":128445}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"A command allowing you to get information on the Redis pub/sub system. For the \"channels\" subcommand, you can pass a string pattern. For \"numsub\" an array of channel names - channels  Returns an array where the members are the matching channels. - numsub    Returns a key/value array where the keys are channel names and values are their counts. - numpat    Integer return containing the number active pattern subscriptions. <pre> $redisCluster->pubsub(['127.0.0.1',6379], 'channels'); // All channels $redisCluster->pubsub(['127.0.0.1',6379], 'channels', '*pattern*'); // Just channels matching your pattern $redisCluster->pubsub(['127.0.0.1',6379], 'numsub', array('chan1', 'chan2')); // Get subscriber counts for 'chan1' and 'chan2' $redisCluster->pubsub(['127.0.0.1',6379], 'numpat'); // Get the number of pattern subscribers </pre> /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"},{"name":"keyword","declared_type":"string","description":"String, which can be: \"channels\", \"numsub\", or \"numpat\""},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"punsubscribe","fqn":"RedisCluster::punsubscribe","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":101430,"end":101442}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_patterns","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"bool|array","phpdoc_return_type":null},"documentation":{"description":"Unsubscribes the client from the given patterns, or from all of them if none is given. /","params":[{"name":"pattern","declared_type":"string","description":null},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"randomKey","fqn":"RedisCluster::randomKey","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":122685,"end":122694}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|string","phpdoc_return_type":"RedisCluster|bool|string"},"documentation":{"description":"Returns a random key at the specified node <pre> $key = $redisCluster->randomKey('x'); $surprise = $redisCluster->get($key);  // who knows what's in there. </pre> /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"}],"return_type":"RedisCluster|bool|string","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rawcommand","fqn":"RedisCluster::rawcommand","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":124909,"end":124919}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"command","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"Send arbitrary things to the redis server at the specified node /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"},{"name":"command","declared_type":"string","description":"Required command to send to the server."},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rename","fqn":"RedisCluster::rename","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":79469,"end":79475}},"declared_type":null,"signature":{"parameters":[{"name":"key_src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key_dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Renames a key. <pre> $redisCluster->set('x', '42'); $redisCluster->rename('x', 'y'); $redisCluster->get('y');   // → 42 $redisCluster->get('x');   // → `FALSE` </pre> /","params":[{"name":"key_src","declared_type":"string","description":null},{"name":"key_dst","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"renameNx","fqn":"RedisCluster::renameNx","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":80192,"end":80200}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"newkey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Renames a key. Same as rename, but will not replace a key if the destination already exists. This is the same behaviour as setNx. <pre> $redisCluster->set('x', '42'); $redisCluster->renameNx('x', 'y'); $redisCluster->get('y');   // → 42 $redisCluster->get('x');   // → `FALSE` </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"newkey","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"restore","fqn":"RedisCluster::restore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":83534,"end":83541}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Restore a key from the result of a DUMP operation. <pre> $redisCluster->set('foo', 'bar'); $val = $redisCluster->dump('foo'); $redisCluster->restore('bar', 0, $val); // The key 'bar', will now be equal to the key 'foo' </pre> /","params":[{"name":"key","declared_type":"string","description":"The key name"},{"name":"timeout","declared_type":"int","description":"How long the key should live (if zero, no expire will be set on the key)"},{"name":"value","declared_type":"string","description":"(binary).  The Redis encoded key value (from DUMP)"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"role","fqn":"RedisCluster::role","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":122158,"end":122162}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Returns the role of the instance in the context of replication <pre> $redisCluster->role(['127.0.0.1',6379]); // [ 0=>'master',1 => 3129659, 2 => [ ['127.0.0.1','9001','3129242'], ['127.0.0.1','9002','3129543'] ] ] </pre> /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"}],"return_type":"mixed","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rPop","fqn":"RedisCluster::rPop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":13189,"end":13193}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|string|array","phpdoc_return_type":null},"documentation":{"description":"Returns and removes the last element of the list. <pre> $redisCluster->rPush('key1', 'A'); $redisCluster->rPush('key1', 'B'); $redisCluster->rPush('key1', 'C'); var_dump( $redisCluster->lRange('key1', 0, -1) ); // Output: // array(3) { //   [0]=> string(1) \"A\" //   [1]=> string(1) \"B\" //   [2]=> string(1) \"C\" // } $redisCluster->rPop('key1'); var_dump( $redisCluster->lRange('key1', 0, -1) ); // Output: // array(2) { //   [0]=> string(1) \"A\" //   [1]=> string(1) \"B\" // } </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rpoplpush","fqn":"RedisCluster::rpoplpush","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":27584,"end":27593}},"declared_type":null,"signature":{"parameters":[{"name":"src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|string","phpdoc_return_type":null},"documentation":{"description":"Pops a value from the tail of a list, and pushes it to the front of another list. Also return this value. <pre> $redisCluster->del('x', 'y'); $redisCluster->lPush('x', 'abc'); $redisCluster->lPush('x', 'def'); $redisCluster->lPush('y', '123'); $redisCluster->lPush('y', '456'); // move the last of x to the front of y. var_dump($redisCluster->rpoplpush('x', 'y')); var_dump($redisCluster->lRange('x', 0, -1)); var_dump($redisCluster->lRange('y', 0, -1)); ////Output: // //string(3) \"abc\" //array(1) { //  [0]=> //  string(3) \"def\" //} //array(3) { //  [0]=> //  string(3) \"abc\" //  [1]=> //  string(3) \"456\" //  [2]=> //  string(3) \"123\" //} </pre> /","params":[{"name":"src","declared_type":"string","description":null},{"name":"dst","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rPush","fqn":"RedisCluster::rPush","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":16840,"end":16845}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"elements","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Adds the string values to the tail (right) of the list. Creates the list if the key didn't exist. If the key exists and is not a list, FALSE is returned. <pre> $redisCluster->rPush('r', 'v1', 'v2', 'v3', 'v4');    // int(4) var_dump( $redisCluster->lRange('r', 0, -1) ); //// Output: // array(4) { //   [0]=> string(2) \"v1\" //   [1]=> string(2) \"v2\" //   [2]=> string(2) \"v3\" //   [3]=> string(2) \"v4\" // } </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rPushx","fqn":"RedisCluster::rPushx","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":21352,"end":21358}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|int","phpdoc_return_type":null},"documentation":{"description":"Adds the string value to the tail (right) of the list if the ist exists. FALSE in case of Failure. <pre> $redisCluster->del('key1'); $redisCluster->rPushx('key1', 'A'); // returns 0 $redisCluster->rPush('key1', 'A'); // returns 1 $redisCluster->rPushx('key1', 'B'); // returns 2 $redisCluster->rPushx('key1', 'C'); // returns 3 // key1 now points to the following list: [ 'A', 'B', 'C' ] </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"string","description":"String, value to push in key"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sAdd","fqn":"RedisCluster::sAdd","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":31660,"end":31664}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"other_values","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Adds a values to the set value stored at key. If this value is already in the set, FALSE is returned. <pre> $redisCluster->sAdd('k', 'v1');                // int(1) $redisCluster->sAdd('k', 'v1', 'v2', 'v3');    // int(2) </pre> /","params":[{"name":"key","declared_type":"string","description":"Required key"},{"name":"value","declared_type":"mixed","description":"Required value"},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sAddArray","fqn":"RedisCluster::sAddArray","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":32294,"end":32303}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|int","phpdoc_return_type":null},"documentation":{"description":"Adds a values to the set value stored at key. If this value is already in the set, FALSE is returned. <pre> $redisCluster->sAddArray('k', ['v1', 'v2', 'v3']); //This is a feature in php only. Same as $redisCluster->sAdd('k', 'v1', 'v2', 'v3'); </pre> /","params":[{"name":"key","declared_type":"string","description":"Required key"},{"name":"values","declared_type":"array","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"save","fqn":"RedisCluster::save","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":114386,"end":114390}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Performs a synchronous save at a specific node. If a save is already running, this command will fail and return FALSE. $redisCluster->save('x'); //key $redisCluster->save(['127.0.0.1',6379]); //[host,port] /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"scan","fqn":"RedisCluster::scan","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":103131,"end":103135}},"declared_type":null,"signature":{"parameters":[{"name":"iterator","declared_type":"null|int|string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"?string","phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool|array","phpdoc_return_type":"bool|array"},"documentation":{"description":"Scan the keyspace for keys. <pre> $iterator = null; while($keys = $redisCluster->scan($iterator)) { foreach($keys as $key) { echo $key . PHP_EOL; } } </pre> /","params":[{"name":"","declared_type":null,"description":null},{"name":"key_or_address","declared_type":"string|array","description":"Node identified by key or host/port array"},{"name":"pattern","declared_type":"null|string","description":"Pattern to match."},{"name":"count","declared_type":"int","description":"Count of keys per iteration (only a suggestion to Redis)."}],"return_type":"bool|array","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"scard","fqn":"RedisCluster::scard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":29224,"end":29229}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Returns the set cardinality (number of elements) of the set stored at key. <pre> $redisCluster->sAdd('key1' , 'set1'); $redisCluster->sAdd('key1' , 'set2'); $redisCluster->sAdd('key1' , 'set3');   // 'key1' => {'set1', 'set2', 'set3'} $redisCluster->scard('key1');           // 3 $redisCluster->scard('keyX');           // 0 </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"script","fqn":"RedisCluster::script","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":129676,"end":129682}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"Execute the Redis SCRIPT command to perform various operations on the scripting subsystem. <pre> $redisCluster->script(['127.0.0.1',6379], 'load', $script); $redisCluster->script(['127.0.0.1',6379], 'flush'); $redisCluster->script(['127.0.0.1',6379], 'kill'); $redisCluster->script(['127.0.0.1',6379], 'exists', $script1, [$script2, $script3, ...]); </pre> SCRIPT LOAD will return the SHA1 hash of the passed script on success, and FALSE on failure. SCRIPT FLUSH should always return TRUE SCRIPT KILL will return true if a script was able to be killed and false if not SCRIPT EXISTS will return an array with TRUE or FALSE for each passed script /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sDiff","fqn":"RedisCluster::sDiff","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":39235,"end":39240}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Performs the difference between N sets and returns it. <pre> $redisCluster->del('s0', 's1', 's2'); $redisCluster->sAdd('s0', '1'); $redisCluster->sAdd('s0', '2'); $redisCluster->sAdd('s0', '3'); $redisCluster->sAdd('s0', '4'); $redisCluster->sAdd('s1', '1'); $redisCluster->sAdd('s2', '3'); var_dump($redisCluster->sDiff('s0', 's1', 's2')); //// Output: // //array(2) { //  [0]=> //  string(1) \"4\" //  [1]=> //  string(1) \"2\" //} </pre> /","params":[{"name":"key","declared_type":"string","description":"Any number of keys corresponding to sets in redis."},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sdiffcard","fqn":"RedisCluster::sdiffcard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":173390,"end":173399}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Compute the difference of one or more sets and return the cardinality of the result. /","params":[{"name":"keys","declared_type":"array","description":"One or more set key names."},{"name":"options","declared_type":"array|null","description":"An optional array of options that modifies how the command works."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sDiffStore","fqn":"RedisCluster::sDiffStore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":40451,"end":40461}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Performs the same action as sDiff, but stores the result in the first key <pre> $redisCluster->del('s0', 's1', 's2'); $redisCluster->sAdd('s0', '1'); $redisCluster->sAdd('s0', '2'); $redisCluster->sAdd('s0', '3'); $redisCluster->sAdd('s0', '4'); $redisCluster->sAdd('s1', '1'); $redisCluster->sAdd('s2', '3'); var_dump($redisCluster->sDiffStore('dst', 's0', 's1', 's2')); var_dump($redisCluster->sMembers('dst')); //// Output: // //int(2) //array(2) { //  [0]=> //  string(1) \"4\" //  [1]=> //  string(1) \"2\" //} </pre> /","params":[{"name":"dst","declared_type":"string","description":"the key to store the diff into."},{"name":"key","declared_type":"string","description":"Any number of keys corresponding to sets in redis"},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set","fqn":"RedisCluster::set","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":3964,"end":3967}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"mixed","phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|string|bool","phpdoc_return_type":null},"documentation":{"description":"Set the string value in argument as value of the key. >= 2.6.12 extended options if you pass an array with valid values. <pre> // Simple key -> value set $redisCluster->set('key', 'value'); // Will redirect, and actually make an SETEX call $redisCluster->set('key','value', 10); // Will set the key, if it doesn't exist, with a ttl of 10 seconds $redisCluster->set('key', 'value', Array('nx', 'ex'=>10)); // Will set a key, if it does exist, with a ttl of 1000 milliseconds $redisCluster->set('key', 'value', Array('xx', 'px'=>1000)); </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"mixed","description":null},{"name":"options","declared_type":"mixed","description":"If you pass an integer, phpredis will redirect to SETEX, and will try to use Redis"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setBit","fqn":"RedisCluster::setBit","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":70402,"end":70408}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"onoff","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Changes a single bit of a string. <pre> $redisCluster->set('key', \"*\");     // ord(\"*\") = 42 = 0x2f = \"0010 1010\" $redisCluster->setBit('key', 5, 1); // returns 0 $redisCluster->setBit('key', 7, 1); // returns 0 $redisCluster->get('key');          // chr(0x2f) = \"/\" = b(\"0010 1111\") </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"offset","declared_type":"int","description":null},{"name":"onoff","declared_type":"bool","description":"bool or int (1 or 0)"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setex","fqn":"RedisCluster::setex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":7436,"end":7441}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"expire","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Set the string value in argument as value of the key, with a time to live. <pre> $redisCluster->setex('key', 3600, 'value'); // sets key → value, with 1h TTL. </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"expire","declared_type":"int","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setnx","fqn":"RedisCluster::setnx","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":8701,"end":8706}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Set the string value in argument as value of the key if the key doesn't already exist in the database. <pre> $redisCluster->setnx('key', 'value');   // return TRUE $redisCluster->setnx('key', 'value');   // return FALSE </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setOption","fqn":"RedisCluster::setOption","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":108583,"end":108592}},"declared_type":null,"signature":{"parameters":[{"name":"option","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":null},"documentation":{"description":"Set client option. <pre> $redisCluster->setOption(RedisCluster::OPT_SERIALIZER, RedisCluster::SERIALIZER_NONE);        // don't serialize data $redisCluster->setOption(RedisCluster::OPT_SERIALIZER, RedisCluster::SERIALIZER_PHP);         // use built-in serialize/unserialize $redisCluster->setOption(RedisCluster::OPT_SERIALIZER, RedisCluster::SERIALIZER_IGBINARY);    // use igBinary serialize/unserialize $redisCluster->setOption(RedisCluster::OPT_PREFIX, 'myAppName:');                             // use custom prefix on all keys </pre> /","params":[{"name":"option","declared_type":"int","description":"parameter"},{"name":"value","declared_type":"mixed","description":"parameter value"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setRange","fqn":"RedisCluster::setRange","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":82769,"end":82777}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Changes a substring of a larger string. <pre> $redisCluster->set('key', 'Hello world'); $redisCluster->setRange('key', 6, \"redis\"); // returns 11 $redisCluster->get('key');                  // \"Hello redis\" </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"offset","declared_type":"int","description":null},{"name":"value","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sInter","fqn":"RedisCluster::sInter","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":36948,"end":36954}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array|string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns the members of a set resulting from the intersection of all the sets held at the specified keys. If just a single key is specified, then this command produces the members of this set. If one of the keys is missing, FALSE is returned. If the intersection between the different sets is empty, the return value will be empty array. <pre> $redisCluster->sAdd('key1', 'val1'); $redisCluster->sAdd('key1', 'val2'); $redisCluster->sAdd('key1', 'val3'); $redisCluster->sAdd('key1', 'val4'); $redisCluster->sAdd('key2', 'val3'); $redisCluster->sAdd('key2', 'val4'); $redisCluster->sAdd('key3', 'val3'); $redisCluster->sAdd('key3', 'val4'); var_dump($redisCluster->sInter('key1', 'key2', 'key3')); // Output: // //array(2) { //  [0]=> //  string(4) \"val4\" //  [1]=> //  string(4) \"val3\" //} </pre> /","params":[{"name":"keykeys","declared_type":"array|string","description":"identifying the different sets on which we will apply the intersection."},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sintercard","fqn":"RedisCluster::sintercard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":172235,"end":172245}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Compute the intersection of one or more sets and return the cardinality of the result. /","params":[{"name":"keys","declared_type":"array","description":"One or more set key names."},{"name":"limit","declared_type":"int","description":"A maximum cardinality to return. This puts an upper bound on the work Redis will do."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sInterStore","fqn":"RedisCluster::sInterStore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":38178,"end":38189}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Performs a sInter command and stores the result in a new set. <pre> $redisCluster->sAdd('key1', 'val1'); $redisCluster->sAdd('key1', 'val2'); $redisCluster->sAdd('key1', 'val3'); $redisCluster->sAdd('key1', 'val4'); $redisCluster->sAdd('key2', 'val3'); $redisCluster->sAdd('key2', 'val4'); $redisCluster->sAdd('key3', 'val3'); $redisCluster->sAdd('key3', 'val4'); var_dump($redisCluster->sInterStore('output', 'key1', 'key2', 'key3')); var_dump($redisCluster->sMembers('output')); //// Output: // //int(2) //array(2) { //  [0]=> //  string(4) \"val4\" //  [1]=> //  string(4) \"val3\" //} </pre> /","params":[{"name":"key","declared_type":"array|string","description":"the key to store the diff into."},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sismember","fqn":"RedisCluster::sismember","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":30968,"end":30977}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Returns if member is a member of the set stored at key. <pre> $redisCluster->sAdd('key1' , 'set1'); $redisCluster->sAdd('key1' , 'set2'); $redisCluster->sAdd('key1' , 'set3'); // 'key1' => {'set1', 'set2', 'set3'} $redisCluster->sIsMember('key1', 'set1'); // TRUE $redisCluster->sIsMember('key1', 'setX'); // FALSE </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"slowlog","fqn":"RedisCluster::slowlog","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":130159,"end":130166}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"This function is used in order to read and reset the Redis slow queries log. <pre> $redisCluster->slowlog(['127.0.0.1',6379],'get','2'); </pre> /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sMembers","fqn":"RedisCluster::sMembers","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":30215,"end":30223}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns all the members of the set value stored at key. This has the same effect as running SINTER with one argument key. <pre> $redisCluster->del('s'); $redisCluster->sAdd('s', 'a'); $redisCluster->sAdd('s', 'b'); $redisCluster->sAdd('s', 'a'); $redisCluster->sAdd('s', 'c'); var_dump($redisCluster->sMembers('s')); ////Output: // //array(3) { //  [0]=> //  string(1) \"b\" //  [1]=> //  string(1) \"c\" //  [2]=> //  string(1) \"a\" //} // The order is random and corresponds to redis' own internal representation of the set structure. </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sMisMember","fqn":"RedisCluster::sMisMember","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":173979,"end":173989}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_members","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":"RedisCluster|array|false"},"documentation":{"description":"Check whether one or more values are members of a set. /","params":[{"name":"key","declared_type":"string","description":"The set to query."},{"name":"member","declared_type":"string","description":"The first member to check."},{"name":"","declared_type":null,"description":null}],"return_type":"RedisCluster|array|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sMove","fqn":"RedisCluster::sMove","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":84667,"end":84672}},"declared_type":null,"signature":{"parameters":[{"name":"src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Moves the specified member from the set at srcKey to the set at dstKey. If the srcKey and/or dstKey didn't exist, and/or the member didn't exist in srcKey, FALSE is returned. <pre> $redisCluster->sAdd('key1' , 'set11'); $redisCluster->sAdd('key1' , 'set12'); $redisCluster->sAdd('key1' , 'set13');          // 'key1' => {'set11', 'set12', 'set13'} $redisCluster->sAdd('key2' , 'set21'); $redisCluster->sAdd('key2' , 'set22');          // 'key2' => {'set21', 'set22'} $redisCluster->sMove('key1', 'key2', 'set13');  // 'key1' =>  {'set11', 'set12'} // 'key2' =>  {'set21', 'set22', 'set13'} </pre> /","params":[{"name":"src","declared_type":"string","description":null},{"name":"dst","declared_type":"string","description":null},{"name":"member","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sort","fqn":"RedisCluster::sort","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":97877,"end":97881}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|bool|int|string","phpdoc_return_type":null},"documentation":{"description":"Sort - 'by' => 'some_pattern_*', - 'limit' => array(0, 1), - 'get' => 'some_other_pattern_*' or an array of patterns, - 'sort' => 'asc' or 'desc', - 'alpha' => TRUE, - 'store' => 'external-key' An array of values, or a number corresponding to the number of elements stored if that was used. <pre> $redisCluster->del('s'); $redisCluster->sadd('s', 5); $redisCluster->sadd('s', 4); $redisCluster->sadd('s', 2); $redisCluster->sadd('s', 1); $redisCluster->sadd('s', 3); var_dump($redisCluster->sort('s')); // 1,2,3,4,5 var_dump($redisCluster->sort('s', array('sort' => 'desc'))); // 5,4,3,2,1 var_dump($redisCluster->sort('s', array('sort' => 'desc', 'store' => 'out'))); // (int)5 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"options","declared_type":"null|array","description":"$option array(key => value, ...) - optional, with the following keys and values:"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sort_ro","fqn":"RedisCluster::sort_ro","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":174545,"end":174552}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|bool|int|string","phpdoc_return_type":"RedisCluster|array|bool|int|string"},"documentation":{"description":"A read-only variant of SORT that can be run against a replica. /","params":[{"name":"key","declared_type":"string","description":"The key to sort."},{"name":"options","declared_type":"array|null","description":"An array of options to modify how the command behaves."}],"return_type":"RedisCluster|array|bool|int|string","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sPop","fqn":"RedisCluster::sPop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":14956,"end":14960}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|string|array|false","phpdoc_return_type":null},"documentation":{"description":"Removes and returns a random element from the set value at Key. <pre> $redisCluster->sAdd('key1' , 'set1'); $redisCluster->sAdd('key1' , 'set2'); $redisCluster->sAdd('key1' , 'set3'); var_dump($redisCluster->sMembers('key1'));// 'key1' => {'set3', 'set1', 'set2'} $redisCluster->sPop('key1');// 'set1' var_dump($redisCluster->sMembers('key1'));// 'key1' => {'set3', 'set2'} $redisCluster->sPop('key1');// 'set3', var_dump($redisCluster->sMembers('key1'));// 'key1' => {'set2'} </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sRandMember","fqn":"RedisCluster::sRandMember","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":41584,"end":41595}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|string|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns a random element(s) from the set value at Key, without removing it. bool FALSE if set identified by key is empty or doesn't exist and count argument isn't passed. <pre> $redisCluster->sAdd('key1' , 'one'); $redisCluster->sAdd('key1' , 'two'); $redisCluster->sAdd('key1' , 'three');              // 'key1' => {'one', 'two', 'three'} var_dump( $redisCluster->sRandMember('key1') );     // 'key1' => {'one', 'two', 'three'} // string(5) \"three\" var_dump( $redisCluster->sRandMember('key1', 2) );  // 'key1' => {'one', 'two', 'three'} // array(2) { //   [0]=> string(2) \"one\" //   [1]=> string(2) \"three\" // } </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"count","declared_type":"int","description":"[optional]"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"srem","fqn":"RedisCluster::srem","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":33079,"end":33083}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"other_values","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Removes the specified members from the set value stored at key. <pre> var_dump( $redisCluster->sAdd('k', 'v1', 'v2', 'v3') );    // int(3) var_dump( $redisCluster->sRem('k', 'v2', 'v3') );          // int(2) var_dump( $redisCluster->sMembers('k') ); //// Output: // array(1) { //   [0]=> string(2) \"v1\" // } </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"mixed","description":null},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sscan","fqn":"RedisCluster::sscan","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":104107,"end":104112}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"iterator","declared_type":"null|int|string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"pattern","declared_type":"?string","phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":null},"documentation":{"description":"Scan a set for members. <pre> $iterator = null; while ($members = $redisCluster->sscan('set', $iterator)) { foreach ($members as $member) { echo $member . PHP_EOL; } } </pre> /","params":[{"name":"key","declared_type":"string","description":"The set to search."},{"name":"","declared_type":null,"description":null},{"name":"pattern","declared_type":"null|string","description":"String, optional pattern to match against."},{"name":"count","declared_type":"int","description":"How many members to return at a time (Redis might return a different amount)."}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"strlen","fqn":"RedisCluster::strlen","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":42035,"end":42041}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Get the length of a string value. <pre> $redisCluster->set('key', 'value'); $redisCluster->strlen('key'); // 5 </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"subscribe","fqn":"RedisCluster::subscribe","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":99994,"end":100003}},"declared_type":null,"signature":{"parameters":[{"name":"channels","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"cb","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Subscribe to channels. Warning: this function will probably change in the future. The callback function receives 3 parameters: the redis instance, the channel name, and the message. <pre> function f($redisCluster, $chan, $msg) { switch($chan) { case 'chan-1': ... break; case 'chan-2': ... break; case 'chan-2': ... break; } } $redisCluster->subscribe(array('chan-1', 'chan-2', 'chan-3'), 'f'); // subscribe to 3 chans </pre> /","params":[{"name":"channels","declared_type":"array","description":"an array of channels to subscribe to"},{"name":"cb","declared_type":"callable","description":"either a string or an array($instance, 'method_name')."}],"return_type":"void","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sUnion","fqn":"RedisCluster::sUnion","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":34192,"end":34198}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|bool|array","phpdoc_return_type":null},"documentation":{"description":"Performs the union between N sets and returns it. <pre> $redisCluster->del('s0', 's1', 's2'); $redisCluster->sAdd('s0', '1'); $redisCluster->sAdd('s0', '2'); $redisCluster->sAdd('s1', '3'); $redisCluster->sAdd('s1', '1'); $redisCluster->sAdd('s2', '3'); $redisCluster->sAdd('s2', '4'); var_dump($redisCluster->sUnion('s0', 's1', 's2')); //// Output: // //array(4) { //  [0]=> //  string(1) \"3\" //  [1]=> //  string(1) \"4\" //  [2]=> //  string(1) \"1\" //  [3]=> //  string(1) \"2\" //} </pre> /","params":[{"name":"key","declared_type":"string","description":"Any number of keys corresponding to sets in redis."},{"na