ck","declared_type":"callable","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Defers the execution of a callback function until the surrounding function of a coroutine returns. This function is an alias of function swoole_coroutine_defer(); it's available only when directive \"swoole.use_shortname\" is not explicitly turned off. <pre> go(function () {      // The surrounding function of a coroutine. echo '1'; defer(function () { // The callback function to be deferred. echo '3'; }); echo '2'; }); <pre> /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"define","fqn":"define","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":9507,"end":9513}},"declared_type":null,"signature":{"parameters":[{"name":"constant_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"null|array|bool|int|float|string","optional":false,"variadic":false,"by_reference":false},{"name":"case_insensitive","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Defines a named constant The name of the constant. </p> The value of the constant. In PHP 5, value must be a scalar value (integer, float, string, boolean, or null). In PHP 7, array values are also accepted. It is possible to define resource constants, however it is not recommended and may cause unpredictable behavior. </p> If set to true, the constant will be defined case-insensitive. The default behavior is case-sensitive; i.e. CONSTANT and Constant represent different values. Defining case-insensitive constants is deprecated as of PHP 7.3.0. </p> <p> Case-insensitive constants are stored as lower-case. </p> /","params":[{"name":"constant_name","declared_type":"string","description":"<p>"},{"name":"value","declared_type":"null|array|bool|int|float|string","description":"<p>"},{"name":"case_insensitive","declared_type":"bool","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"define_syslog_variables","fqn":"define_syslog_variables","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":4548,"end":4571}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Initializes all syslog related variables /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"defined","fqn":"defined","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":10023,"end":10030}},"declared_type":null,"signature":{"parameters":[{"name":"constant_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Checks whether a given named constant exists The constant name. </p> has been defined, false otherwise. /","params":[{"name":"constant_name","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"deflate_add","fqn":"deflate_add","kind":"Function","origin":"PhpRuntime","extension":"zlib","location":{"file":"zlib/zlib.php","range":{"start":15534,"end":15545}},"declared_type":null,"signature":{"parameters":[{"name":"context","declared_type":null,"phpdoc_type":"DeflateContext|resource","optional":false,"variadic":false,"by_reference":false},{"name":"data","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flush_mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Incrementally deflate data A context created with <b>deflate_init()</b>. </p> A chunk of data to compress. </p> One of <b>ZLIB_BLOCK</b>, <b>ZLIB_NO_FLUSH</b>, <b>ZLIB_PARTIAL_FLUSH</b>, <b>ZLIB_SYNC_FLUSH</b> (default), <b>ZLIB_FULL_FLUSH</b>, <b>ZLIB_FINISH</b>. Normally you will want to set <b>ZLIB_NO_FLUSH</b> to maximize compression, and <b>ZLIB_FINISH</b> to terminate with the last chunk of data. </p> Returns a chunk of compressed data, or <b>FALSE</b> on failure. </p> /","params":[{"name":"context","declared_type":"DeflateContext|resource","description":"<p>"},{"name":"data","declared_type":"string","description":"<p>"},{"name":"flush_mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"deflate_init","fqn":"deflate_init","kind":"Function","origin":"PhpRuntime","extension":"zlib","location":{"file":"zlib/zlib.php","range":{"start":14663,"end":14675}},"declared_type":null,"signature":{"parameters":[{"name":"encoding","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":null,"phpdoc_type":"array|object","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false|DeflateContext"},"documentation":{"description":"Initialize an incremental deflate context One of the <b>ZLIB_ENCODING_*</b> constants. </p> An associative array which may contain the following elements: <b>level</b>The compression level in range -1..9; defaults to -1. <b>memory</b>The compression memory level in range 1..9; defaults to 8. <b>window</b>The zlib window size (logarithmic) in range 8..15; defaults to 15. <b>strategy</b>One of <b>ZLIB_FILTERED</b>, <b>ZLIB_HUFFMAN_ONLY</b>, <b>ZLIB_RLE</b>, <b>ZLIB_FIXED</b> or <b>ZLIB_DEFAULT_STRATEGY</b> (the default). <b>dictionary</b>A string or an array of strings of the preset dictionary (default: no preset dictionary).</p> Returns a deflate context resource (zlib.deflate) on success, or <b>FALSE</b> on failure. </p> /","params":[{"name":"encoding","declared_type":"int","description":"<p>"},{"name":"options","declared_type":"array|object","description":"<p>"}],"return_type":"resource|false|DeflateContext","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"deg2rad","fqn":"deg2rad","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":11958,"end":11965}},"declared_type":null,"signature":{"parameters":[{"name":"num","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float","phpdoc_return_type":"float"},"documentation":{"description":"Converts the number in degrees to the radian equivalent Angular value in degrees </p> /","params":[{"name":"num","declared_type":"float","description":"<p>"}],"return_type":"float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dgettext","fqn":"dgettext","kind":"Function","origin":"PhpRuntime","extension":"gettext","location":{"file":"gettext/gettext.php","range":{"start":1610,"end":1618}},"declared_type":null,"signature":{"parameters":[{"name":"domain","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"message","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Override the current domain The domain </p> The message </p> /","params":[{"name":"domain","declared_type":"string","description":"<p>"},{"name":"message","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"die","fqn":"die","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":36433,"end":36436}},"declared_type":null,"signature":{"parameters":[{"name":"status","declared_type":"string|int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"never","phpdoc_return_type":null},"documentation":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_close","fqn":"dio_close","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":1060,"end":1069}},"declared_type":null,"signature":{"parameters":[{"name":"fd","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Closes the file descriptor given by fd. dio_close ( resource $fd ) : void /","params":[{"name":"fd","declared_type":"resource","description":"The file descriptor returned by dio_open()"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_fcntl","fqn":"dio_fcntl","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":2022,"end":2031}},"declared_type":null,"signature":{"parameters":[{"name":"fd","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"cmd","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"The dio_fcntl() function performs the operation specified by cmd on the file descriptor fd. dio_fcntl ( resource $fd , int $cmd [, mixed $args ] ) : mixed Some commands require additional arguments args to be supplied. <ul> <li>\"start\" - offset where lock begins</li> <li>\"length\" - size of locked area. zero means to end of file</li> <li>\"whence\" - Where l_start is relative to: can be SEEK_SET, SEEK_END and SEEK_CUR</li> <li>\"type\" - type of lock: can be F_RDLCK (read lock), F_WRLCK (write lock) or F_UNLCK (unlock)</li> </ul> /","params":[{"name":"fd","declared_type":"resource","description":"The file descriptor returned by dio_open()."},{"name":"cmd","declared_type":"int","description":"The file descriptor returned by dio_open()."},{"name":"","declared_type":null,"description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_open","fqn":"dio_open","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":3426,"end":3434}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Opens a file (creating it if necessary) at a lower level than theC library input/ouput stream functions allow dio_open ( string $filename , int $flags [, int $mode = 0 ] ) : resource <ul> <li>O_RDONLY - opens the file for read access.</li> <li>O_WRONLY - opens the file for write access.</li> <li>O_RDWR - opens the file for both reading and writing.</li> <li>O_CREAT - creates the file, if it doesn't already exist.</li> <li>O_EXCL - if both O_CREAT and O_EXCL are set and the file already exists, dio_open() will fail.</li> <li>O_TRUNC - if the file exists and is opened for write access, the file will be truncated to zero length.</li> <li>O_APPEND - write operations write data at the end of the file.</li> <li>O_NONBLOCK - sets non blocking mode.</li> <li>O_NOCTTY - prevent the OS from assigning the opened file as the process's controllingterminal when opening a TTY device file.</li> </ul> /","params":[{"name":"filename","declared_type":"string","description":"The pathname of the file to open."},{"name":"flags","declared_type":"int","description":"The flags parameter is a bitwise-ORed value comprising flags from the following list."},{"name":"mode","declared_type":"int","description":"If flags contains O_CREAT, mode will set the permissions of the file (creation permissions)."}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_raw","fqn":"dio_raw","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":8522,"end":8529}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|null"},"documentation":{"description":"Opens a raw direct IO stream. dio_raw ( string filename , string mode [, array options] ) : ?resource <ul> <li>\"data_rate\" - baud rate of the port - can be 75, 110, 134, 150, 300, 600, 1200, 1800, 2400, 4800, 7200, 9600, 14400, 19200, 38400, 57600, 115200, 56000, 128000 or 256000 default value is 9600.</li> <li>\"data_bits\" - can be 8, 7, 6 or 5. Default value is 8.</li> <li>\"stop_bits\" - can be 1 or 2. Default value is 1.</li> <li>\"parity\" - can be 0, 1 or 2. Default value is 0.</li> <li>\"flow_control\" - can be 0 or 1. Default value is 1.</li> <li>\"is_canonical\" - can be 0 or 1. Default value is 1.</li> </ul> /","params":[{"name":"filename","declared_type":"string","description":"The pathname of the file to open."},{"name":"mode","declared_type":"string","description":"The mode parameter specifies the type of access you require to the stream (as fopen())."},{"name":"options","declared_type":"array|null","description":"The currently available options are:"}],"return_type":"resource|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_read","fqn":"dio_read","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":3874,"end":3882}},"declared_type":null,"signature":{"parameters":[{"name":"fd","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"len","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Reads bytes from a file descriptor. dio_read ( resource $fd [, int $len = 1024 ] ) : string /","params":[{"name":"fd","declared_type":"resource","description":"The file descriptor returned by dio_open()."},{"name":"len","declared_type":"int","description":"The number of bytes to read. If not specified, dio_read() reads 1k sized block."}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_seek","fqn":"dio_seek","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":4641,"end":4649}},"declared_type":null,"signature":{"parameters":[{"name":"fd","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"pos","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"whence","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Seeks to pos on fd from whence dio_seek ( resource $fd , int $pos [, int $whence = SEEK_SET ] ): int <ul> <li>SEEK_SET - (Default) Specifies that pos is specified from the beginning of the file.</li> <li>SEEK_CUR - Specifies that pos is a count of characters from the current file position. This count may be positive or negative.</li> <li>SEEK_END - Specifies that pos is a count of characters from the end of the file.</li> </ul> /","params":[{"name":"fd","declared_type":"resource","description":"The file descriptor returned by dio_open()."},{"name":"pos","declared_type":"int","description":"The new position."},{"name":"whence","declared_type":"int","description":"Specifies how the position pos should be interpreted:"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_serial","fqn":"dio_serial","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":9569,"end":9579}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|null"},"documentation":{"description":"Opens a serial direct IO stream. dio_serial ( string $filename , string $mode [, array $options = null] ) : ?resource <ul> <li>\"data_rate\" - baud rate of the port - can be 75, 110, 134, 150, 300, 600, 1200, 1800, 2400, 4800, 7200, 9600, 14400, 19200, 38400, 57600, 115200, 56000, 128000 or 256000 default value is 9600.</li> <li>\"data_bits\" - can be 8, 7, 6 or 5. Default value is 8.</li> <li>\"stop_bits\" - can be 1 or 2. Default value is 1.</li> <li>\"parity\" - can be 0, 1 or 2. Default value is 0.</li> <li>\"flow_control\" - can be 0 or 1. Default value is 1.</li> <li>\"is_canonical\" - can be 0 or 1. Default value is 1.</li> </ul> /","params":[{"name":"filename","declared_type":"string","description":"The pathname of the file to open."},{"name":"mode","declared_type":"string","description":"The mode parameter specifies the type of access you require to the stream (as fopen())."},{"name":"options","declared_type":"array|null","description":"The currently available options are:"}],"return_type":"resource|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_stat","fqn":"dio_stat","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":5566,"end":5574}},"declared_type":null,"signature":{"parameters":[{"name":"fd","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|null"},"documentation":{"description":"Gets stat information about the file descriptor fd dio_stat ( resource $fd ) : array <ul> <li>\"device\" - device</li> <li>\"inode\" - inode</li> <li>\"mode\" - mode</li> <li>\"nlink\" - number of hard links</li> <li>\"uid\" - user id</li> <li>\"gid\" - group id</li> <li>\"device_type\" - device type (if inode device)</li> <li>\"size\" - total size in bytes</li> <li>\"blocksize\" - blocksize</li> <li>\"blocks\" - number of blocks allocated</li> <li>\"atime\" - time of last access</li> <li>\"mtime\" - time of last modification</li> <li>\"ctime\" - time of last change</li> </ul> On error dio_stat() returns NULL. /","params":[{"name":"fd","declared_type":"resource","description":"The file descriptor returned by dio_open()."}],"return_type":"array|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_tcsetattr","fqn":"dio_tcsetattr","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":6312,"end":6325}},"declared_type":null,"signature":{"parameters":[{"name":"fd","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Sets terminal attributes and baud rate for a serial port dio_tcsetattr ( resource $fd , array $options ) : bool <ul> <li>\"baud\" - baud rate of the port - can be 38400, 19200, 9600, 4800, 2400, 1800, 1200, 600, 300, 200, 150, 134, 110, 75 or 50, default value is 9600.</li> <li>\"bits\" - data bits - can be 8,7,6 or 5. Default value is 8.</li> <li>\"stop\" - stop bits - can be 1 or 2. Default value is 1.</li> <li>\"parity\" - can be 0,1 or 2. Default value is 0.</li> </ul> /","params":[{"name":"fd","declared_type":"resource","description":"The file descriptor returned by dio_open()."},{"name":"options","declared_type":"array","description":"The currently available options are:"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_truncate","fqn":"dio_truncate","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":6963,"end":6975}},"declared_type":null,"signature":{"parameters":[{"name":"fd","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Truncates a file to at most offset bytes in size. dio_truncate ( resource $fd , int $offset ) : bool If the file previously was larger than this size, the extra data is lost. If the file previously was shorter, it is unspecified whether the file is left unchanged or is extended. In the latter case the extended part reads as zero bytes. /","params":[{"name":"fd","declared_type":"resource","description":"The file descriptor returned by dio_open()."},{"name":"offset","declared_type":"int","description":"The offset in bytes."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dio_write","fqn":"dio_write","kind":"Function","origin":"PhpRuntime","extension":"dio","location":{"file":"dio/dio.php","range":{"start":7505,"end":7514}},"declared_type":null,"signature":{"parameters":[{"name":"fd","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"data","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"len","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Writes data to fd with optional truncation at length dio_write ( resource $fd , string $data [, int $len = 0 ] ) : int /","params":[{"name":"fd","declared_type":"resource","description":"The file descriptor returned by dio_open()."},{"name":"data","declared_type":"string","description":"The written data."},{"name":"len","declared_type":"int","description":"The length of data to write in bytes. If not specified, the function writes all the data to the specified file."}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dir","fqn":"dir","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7.php","range":{"start":12666,"end":12669}},"declared_type":null,"signature":{"parameters":[{"name":"directory","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"context","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Directory|false","phpdoc_return_type":"Directory|false"},"documentation":{"description":"Return an instance of the Directory class Directory to open </p> parameters, or <b>FALSE</b> in case of another error /","params":[{"name":"directory","declared_type":"string","description":"<p>"},{"name":"context","declared_type":"resource","description":"[optional]"}],"return_type":"Directory|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dirname","fqn":"dirname","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":7772,"end":7779}},"declared_type":null,"signature":{"parameters":[{"name":"path","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"levels","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Returns a parent directory's path A path. </p> <p> On Windows, both slash (/) and backslash (\\) are used as directory separator character. In other environments, it is the forward slash (/). </p> The number of parent directories to go up. This must be an integer greater than 0. </p> path, a dot ('.') is returned, indicating the current directory. Otherwise, the returned string is path with any trailing /component removed. /","params":[{"name":"path","declared_type":"string","description":"<p>"},{"name":"levels","declared_type":"int","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"disk_free_space","fqn":"disk_free_space","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7.php","range":{"start":29498,"end":29513}},"declared_type":null,"signature":{"parameters":[{"name":"directory","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float|false","phpdoc_return_type":"float|false"},"documentation":{"description":"Returns available space in directory A directory of the filesystem or disk partition. </p> <p> Given a file name instead of a directory, the behaviour of the function is unspecified and may differ between operating systems and PHP versions. </p> or false on failure. /","params":[{"name":"directory","declared_type":"string","description":"<p>"}],"return_type":"float|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"disk_total_space","fqn":"disk_total_space","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7.php","range":{"start":28943,"end":28959}},"declared_type":null,"signature":{"parameters":[{"name":"directory","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float|false","phpdoc_return_type":"float|false"},"documentation":{"description":"Returns the total size of a filesystem or disk partition A directory of the filesystem or disk partition. </p> or false on failure. /","params":[{"name":"directory","declared_type":"string","description":"<p>"}],"return_type":"float|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"diskfreespace","fqn":"diskfreespace","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7.php","range":{"start":29770,"end":29783}},"declared_type":null,"signature":{"parameters":[{"name":"directory","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float|false","phpdoc_return_type":"float|false"},"documentation":{"description":"Alias of {@see disk_free_space} /","params":[{"name":"directory","declared_type":"string","description":null}],"return_type":"float|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dl","fqn":"dl","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/basic.php","range":{"start":1438,"end":1440}},"declared_type":null,"signature":{"parameters":[{"name":"extension_filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Loads a php extension at runtime This parameter is only the filename of the extension to load which also depends on your platform. For example, the sockets extension (if compiled as a shared module, not the default!) would be called sockets.so on Unix platforms whereas it is called php_sockets.dll on the Windows platform. </p> <p> The directory where the extension is loaded from depends on your platform: </p> <p> Windows - If not explicitly set in the <i>php.ini</i>, the extension is loaded from C:\\php4\\extensions\\ (PHP 4) or C:\\php5\\ (PHP 5) by default. </p> <p> Unix - If not explicitly set in the <i>php.ini</i>, the default extension directory depends on whether PHP has been built with --enable-debug or not</p> or has been disabled (either by setting enable_dl off or by enabling safe mode in <i>php.ini</i>) an <b>E_ERROR</b> is emitted and execution is stopped. If <b>dl</b> fails because the specified library couldn't be loaded, in addition to <b>FALSE</b> an <b>E_WARNING</b> message is emitted. Loads a PHP extension at runtime /","params":[{"name":"extension_filename","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dngettext","fqn":"dngettext","kind":"Function","origin":"PhpRuntime","extension":"gettext","location":{"file":"gettext/gettext.php","range":{"start":3322,"end":3331}},"declared_type":null,"signature":{"parameters":[{"name":"domain","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"singular","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"plural","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Plural version of dgettext The domain </p> /","params":[{"name":"domain","declared_type":"string","description":"<p>"},{"name":"singular","declared_type":"string","description":null},{"name":"plural","declared_type":"string","description":null},{"name":"count","declared_type":"int","description":null}],"return_type":"string","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dns_check_record","fqn":"dns_check_record","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":37163,"end":37179}},"declared_type":null,"signature":{"parameters":[{"name":"hostname","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"type","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Alias: {@see checkdnsrr} <b>host</b> may either be the IP address in dotted-quad notation or the host name. </p> <b>type</b> may be any one of: A, MX, NS, SOA, PTR, CNAME, AAAA, A6, SRV, NAPTR, TXT or ANY. </p> /","params":[{"name":"hostname","declared_type":"string","description":"<p>"},{"name":"type","declared_type":"string","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dns_get_mx","fqn":"dns_get_mx","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":38033,"end":38043}},"declared_type":null,"signature":{"parameters":[{"name":"hostname","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"hosts","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"weights","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Alias: {@see getmxrr} /","params":[{"name":"hostname","declared_type":"string","description":null},{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dns_get_record","fqn":"dns_get_record","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":44736,"end":44750}},"declared_type":null,"signature":{"parameters":[{"name":"hostname","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"type","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"authoritative_name_servers","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"additional_records","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"raw","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Fetch DNS Resource Records associated with a hostname hostname should be a valid DNS hostname such as \"www.example.com\". Reverse lookups can be generated using in-addr.arpa notation, but gethostbyaddr is more suitable for the majority of reverse lookups. </p> <p> Per DNS standards, email addresses are given in user.host format (for example: hostmaster.example.com as opposed to hostmaster@example.com), be sure to check this value and modify if necessary before using it with a functions such as mail. </p> By default, dns_get_record will search for any resource records associated with hostname. To limit the query, specify the optional type parameter. May be any one of the following: DNS_A, DNS_CNAME, DNS_HINFO, DNS_MX, DNS_NS, DNS_PTR, DNS_SOA, DNS_TXT, DNS_AAAA, DNS_SRV, DNS_NAPTR, DNS_A6, DNS_ALL or DNS_ANY. </p> <p> Because of eccentricities in the performance of libresolv between platforms, DNS_ANY will not always return every record, the slower DNS_ALL will collect all records more reliably. </p> Passed by reference and, if given, will be populated with Resource Records for the Authoritative Name Servers. </p> Passed by reference and, if given, will be populated with any Additional Records. </p> In case of raw mode, we query only the requested type instead of looping type by type before going with the additional info stuff. </p> at minimum the following keys: <table> Basic DNS attributes <tr valign=\"top\"> <td>Attribute</td> <td>Meaning</td> </tr> <tr valign=\"top\"> <td>host</td> <td> The record in the DNS namespace to which the rest of the associated data refers. </td> </tr> <tr valign=\"top\"> <td>class</td> <td> dns_get_record only returns Internet class records and as such this parameter will always return IN. </td> </tr> <tr valign=\"top\"> <td>type</td> <td> String containing the record type. Additional attributes will also be contained in the resulting array dependant on the value of type. See table below. </td> </tr> <tr valign=\"top\"> <td>ttl</td> <td> \"Time To Live\" remaining for this record. This will not equal the record's original ttl, but will rather equal the original ttl minus whatever length of time has passed since the authoritative name server was queried. </td> </tr> </table> </p> <p> <table> Other keys in associative arrays dependant on 'type' <tr valign=\"top\"> <td>Type</td> <td>Extra Columns</td> </tr> <tr valign=\"top\"> <td>A</td> <td> ip: An IPv4 addresses in dotted decimal notation. </td> </tr> <tr valign=\"top\"> <td>MX</td> <td> pri: Priority of mail exchanger. Lower numbers indicate greater priority. target: FQDN of the mail exchanger. See also dns_get_mx. </td> </tr> <tr valign=\"top\"> <td>CNAME</td> <td> target: FQDN of location in DNS namespace to which the record is aliased. </td> </tr> <tr valign=\"top\"> <td>NS</td> <td> target: FQDN of the name server which is authoritative for this hostname. </td> </tr> <tr valign=\"top\"> <td>PTR</td> <td> target: Location within the DNS namespace to which this record points. </td> </tr> <tr valign=\"top\"> <td>TXT</td> <td> txt: Arbitrary string data associated with this record. </td> </tr> <tr valign=\"top\"> <td>HINFO</td> <td> cpu: IANA number designating the CPU of the machine referenced by this record. os: IANA number designating the Operating System on the machine referenced by this record. See IANA's Operating System Names for the meaning of these values. </td> </tr> <tr valign=\"top\"> <td>SOA</td> <td> mname: FQDN of the machine from which the resource records originated. rname: Email address of the administrative contain for this domain. serial: Serial # of this revision of the requested domain. refresh: Refresh interval (seconds) secondary name servers should use when updating remote copies of this domain. retry: Length of time (seconds) to wait after a failed refresh before making a second attempt. expire: Maximum length of time (seconds) a secondary DNS server should retain remote copies of the zone data without a successful refresh before discarding. minimum-ttl: Minimum length of time (seconds) a client can continue to use a DNS resolution before it should request a new resolution from the server. Can be overridden by individual resource records. </td> </tr> <tr valign=\"top\"> <td>AAAA</td> <td> ipv6: IPv6 address </td> </tr> <tr valign=\"top\"> <td>A6(PHP &gt;= 5.1.0)</td> <td> masklen: Length (in bits) to inherit from the target specified by chain. ipv6: Address for this specific record to merge with chain. chain: Parent record to merge with ipv6 data. </td> </tr> <tr valign=\"top\"> <td>SRV</td> <td> pri: (Priority) lowest priorities should be used first. weight: Ranking to weight which of commonly prioritized targets should be chosen at random. target and port: hostname and port where the requested service can be found. For additional information see: RFC 2782 </td> </tr> <tr valign=\"top\"> <td>NAPTR</td> <td> order and pref: Equivalent to pri and weight above. flags, services, regex, and replacement: Parameters as defined by RFC 2915. </td> </tr> </table> /","params":[{"name":"hostname","declared_type":"string","description":"<p>"},{"name":"type","declared_type":"int","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null},{"name":"raw","declared_type":"bool","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dom_import_simplexml","fqn":"dom_import_simplexml","kind":"Function","origin":"PhpRuntime","extension":"dom","location":{"file":"dom/dom.php","range":{"start":548,"end":568}},"declared_type":null,"signature":{"parameters":[{"name":"node","declared_type":"object","phpdoc_type":"SimpleXMLElement","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"DOMElement|null"},"documentation":{"description":"Gets a <b>DOMElement</b> object from a <b>SimpleXMLElement</b> object The <b>SimpleXMLElement</b> node. </p> /","params":[{"name":"node","declared_type":"SimpleXMLElement","description":"<p>"}],"return_type":"DOMElement|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"doubleval","fqn":"doubleval","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_5.php","range":{"start":2249,"end":2258}},"declared_type":null,"signature":{"parameters":[{"name":"value","d