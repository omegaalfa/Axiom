ficate. </p> The private key. </p> corresponds to <i>cert</i>, or false otherwise. /","params":[{"name":"certificate","declared_type":"OpenSSLCertificate|string|resource","description":"<p>"},{"name":"private_key","declared_type":"OpenSSLAsymmetricKey|OpenSSLCertificate|array|string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"openssl_x509_checkpurpose","fqn":"openssl_x509_checkpurpose","kind":"Function","origin":"PhpRuntime","extension":"openssl","location":{"file":"openssl/openssl.php","range":{"start":15548,"end":15573}},"declared_type":null,"signature":{"parameters":[{"name":"certificate","declared_type":null,"phpdoc_type":"OpenSSLCertificate|string|resource","optional":false,"variadic":false,"by_reference":false},{"name":"purpose","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"ca_info","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"ca_info","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"untrusted_certificates_file","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int|bool","phpdoc_return_type":"int|bool"},"documentation":{"description":"Verifies if a certificate can be used for a particular purpose The examined certificate. </p> <table> <b>openssl_x509_checkpurpose</b> purposes <tr valign=\"top\"> <td>Constant</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>X509_PURPOSE_SSL_CLIENT</td> <td>Can the certificate be used for the client side of an SSL connection?</td> </tr> <tr valign=\"top\"> <td>X509_PURPOSE_SSL_SERVER</td> <td>Can the certificate be used for the server side of an SSL connection?</td> </tr> <tr valign=\"top\"> <td>X509_PURPOSE_NS_SSL_SERVER</td> <td>Can the cert be used for Netscape SSL server?</td> </tr> <tr valign=\"top\"> <td>X509_PURPOSE_SMIME_SIGN</td> <td>Can the cert be used to sign S/MIME email?</td> </tr> <tr valign=\"top\"> <td>X509_PURPOSE_SMIME_ENCRYPT</td> <td>Can the cert be used to encrypt S/MIME email?</td> </tr> <tr valign=\"top\"> <td>X509_PURPOSE_CRL_SIGN</td> <td>Can the cert be used to sign a certificate revocation list (CRL)?</td> </tr> <tr valign=\"top\"> <td>X509_PURPOSE_ANY</td> <td>Can the cert be used for Any/All purposes?</td> </tr> </table> These options are not bitfields - you may specify one only! </p> <i>cainfo</i> should be an array of trusted CA files/dirs as described in Certificate Verification. </p> If specified, this should be the name of a PEM encoded file holding certificates that can be used to help verify the certificate, although no trust is placed in the certificates that come from that file. </p> false if it cannot, or -1 on error. /","params":[{"name":"certificate","declared_type":"OpenSSLCertificate|string|resource","description":"<p>"},{"name":"purpose","declared_type":"int","description":"<p>"},{"name":"ca_info","declared_type":"array","description":"<p>"},{"name":"untrusted_certificates_file","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"int|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"openssl_x509_export","fqn":"openssl_x509_export","kind":"Function","origin":"PhpRuntime","extension":"openssl","location":{"file":"openssl/openssl.php","range":{"start":17027,"end":17046}},"declared_type":null,"signature":{"parameters":[{"name":"certificate","declared_type":null,"phpdoc_type":"OpenSSLCertificate|string|resource","optional":false,"variadic":false,"by_reference":false},{"name":"output","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"no_text","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic"