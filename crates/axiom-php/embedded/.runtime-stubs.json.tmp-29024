start":132894,"end":132908}},"declared_type":null,"signature":{"parameters":[{"name":"modules","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"language","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":null,"phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"List the UDF modules registered with the cluster The modules array has the following structure: ``` Array of: name => module name type => Aerospike::UDF_TYPE_* ``` **Example** ```php $status = $client->listRegistered($modules); if ($status == Aerospike::OK) { var_dump($modules); } else { echo \"[{$client->errorno()}] \".$client->error(); } ``` ``` array(2) { [0]=> array(2) { [\"name\"]=> string(13) \"my_record_udf\" [\"type\"]=> int(0) } [1]=> array(2) { [\"name\"]=> string(13) \"my_stream_udf\" [\"type\"]=> int(0) } } ``` * Aerospike::OPT_READ_TIMEOUT /","params":[{"name":"","declared_type":null,"description":null},{"name":"language","declared_type":"int","description":null},{"name":"options","declared_type":"array","description":"an optional array of policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"listRemove","fqn":"Aerospike::listRemove","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":93729,"end":93739}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"bin","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"index","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":fa