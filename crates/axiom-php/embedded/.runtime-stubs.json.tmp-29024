magick 2.0.0)<br/> Selects a threshold for each pixel based on a range of intensity Width of the local neighborhood. </p> Height of the local neighborhood. </p> The mean offset </p> /","params":[{"name":"width","declared_type":"int","description":"<p>"},{"name":"height","declared_type":"int","description":"<p>"},{"name":"offset","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addImage","fqn":"Imagick::addImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":166563,"end":166571}},"declared_type":null,"signature":{"parameters":[{"name":"source","declared_type":"Imagick","phpdoc_type":"Imagick","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL imagick 2.0.0)<br/> Adds new image to Imagick object image list The source Imagick object </p> /","params":[{"name":"source","declared_type":"Imagick","description":"<p>"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addNoiseImage","fqn":"Imagick::addNoiseImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":115272,"end":115285}},"declared_type":null,"signature":{"parameters":[{"name":"noise_type","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"channel","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL imagick 2.0.0)<br/> Adds random noise to the image The type of the noise. Refer to this list of noise constants. </p> Provide any channel constant that is valid for your channel mode. To apply to more than one channel, combine channel constants using bitwise operators. Defaults to <b>Imagick::CHANNEL_DEFAULT</b>. Refer to this list of channel constants </p> /","params":[{"name":"noise_type","declared_type":"int","description":"<p>"},{"name":"channel","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"affineTransformImage","fqn":"Imagick::affineTransformImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":117800,"end":117820}},"declared_type":null,"signature":{"parameters":[{"name":"matrix","declared_type":"ImagickDraw","phpdoc_type":"ImagickDraw","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL imagick 2.0.0)<br/> Transforms an image The affine matrix </p> /","params":[{"name":"matrix","declared_type":"ImagickDraw","description":"<p>"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"animateImages","fqn":"Imagick::animateImages","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":53293,"end":53306}},"declared_type":null,"signature":{"parameters":[{"name":"x_server","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(No version information available, might only be in SVN)<br/> Animates an image or images X server address </p> /","params":[{"name":"x_server","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":["ImagickEx