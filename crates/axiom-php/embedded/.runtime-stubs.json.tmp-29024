se},{"name":"to","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Translate characters or replace substrings The string being translated. </p> The string replacing from. </p> The string being translated to to. </p> translating all occurrences of each character in from to the corresponding character in to. /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"from","declared_type":"string","description":"<p>"},{"name":"to","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"strval","fqn":"strval","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_5.php","range":{"start":2724,"end":2730}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Get string value of a variable The variable that is being converted to a string. </p> <p> $var may be any scalar type or an object that implements the __toString() method. You cannot use strval() on arrays or objects that do not implement the __toString() method. </p> /","params":[{"name":"value","declared_type":"mixed","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"substr","fqn":"substr","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":19259,"end":19265}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Returns the portion of string specified by the offset and length parameters. The input string. </p> If offset is non-negative, the returned string will start at the offset'th position in string, counting from zero. For instance, in the string 'abcdef', the character at position 0 is 'a', the character at position 2 is 'c', and so forth. </p> <p> If offset is negative, the returned string will start at the offset'th character from the end of string. </p> <p> If string is less than offset characters long, an empty string will be returned. </p> <p> Using a negative offset </p> <pre> <?php $rest = substr(\"abcdef\", -1);    // returns \"f\" $rest = substr(\"abcdef\", -2);    // returns \"ef\" $rest = substr(\"abcdef\", -3, 1); // returns \"d\" ?> </pre> If length is given and is positive, the string returned will contain at most length characters beginning from offset (depending on the length of string). </p> <p> If length is given and is negative, then that many characters will be omitted from the end of string. If offset denotes the position of this truncation or beyond, an empty string will be returned. </p> <p> If length is given and is 0, an empty string will be returned. </p> <p> Starting from PHP 8.0 if length is omitted or null, the substring starting from offset until the end of the string will be returned. </p> <p> Using a negative length: </p> <pre> <?php $rest = substr(\"abcdef\", 0, -1);  // returns \"abcde\" $rest = substr(\"abcdef\", 2, -1);  // returns \"cde\" $rest = substr(\"abcdef\", 4, -4);  // returns false $rest = substr(\"abcdef\", -3, -1); // returns \"de\" ?> </pre> <p> Basic usage: </p> <code> echo substr('abcdef', 1), PHP_EOL;     // bcdef echo substr(\"abcdef\", 1, null), PHP_EOL; // bcdef; prior to PHP 8.0.0, empty string was returned echo substr('abcdef', 1, 3), PHP_EOL;  // bcd echo substr('abcdef', 0, 4), PHP_EOL;  // abcd echo substr('abcdef', 0, 8), PHP_EOL;  // abcdef echo substr('abcdef', -1, 1), PHP_EOL; // f // Accessing single characters in a string // can also be achieved using \"square brackets\" $string = 'abcdef'; echo $string[0], PHP_EOL;                 // a echo $string[3], PHP_EOL;                 // d echo $string[strlen($string)-1], PHP_EOL; // f </code> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"offset","declared_type":"int","description":"<p>"},{"name":"length","declared_type":"int|null","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"substr_compare","fqn":"substr_compare","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":15262,"end":15276}},"declared_type":null,"signature":{"parameters":[{"name":"haystack","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"needle","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false},{"name":"case_insensitive","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Binary safe comparison of two strings from an offset, up to length characters The main string being compared. </p> The secondary string being compared. </p> The start position for the comparison. If negative, it starts counting from the end of the string. </p> The length of the comparison. </p> If case_insensitivity is true, comparison is case insensitive. </p> offset is less than str, &gt; 0 if it is greater than str, and 0 if they are equal. If offset is equal to or greater than the length of main_str or length is set and is less than 1, substr_compare prints a warning and returns false. /","params":[{"name":"haystack","declared_type":"string","description":"<p>"},{"name":"needle","declared_type":"string","description":"<p>"},{"name":"offset","declared_type":"int","description":"<p>"},{"name":"length","declared_type":"int|null","description":"[optional] <p>"},{"name":"case_insensitive","declared_type":"bool","description":"[optional] <p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"substr_count","fqn":"substr_count","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":41515,"end":41527}},"declared_type":null,"signature":{"parameters":[{"name":"haystack","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"needle","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"length","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int<0,max>"},"documentation":{"description":"Count the number of substring occurrences The string to search in </p> The substring to search for </p> The offset where to start counting. If the offset is negative, counting starts from the end of the string. </p> The maximum length after the specified offset to search for the substring. It outputs a warning if the offset plus the length is greater than the haystack length. A negative length counts from the end of haystack. </p> /","params":[{"name":"haystack","declared_type":"string","description":"<p>"},{"name":"needle","declared_type":"string","description":"<p>"},{"name":"offset","declared_type":"int","description":"<p>"},{"name":"length","declared_type":"int|null","description":"[optional] <p>"}],"return_type":"int<0,max>","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"substr_replace","fqn":"substr_replace","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":20488,"end":20502}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"array|string","phpdoc_type":"string[]|string","optional":false,"variadic":false,"by_reference":false},{"name":"replace","declared_type":"array|string","phpdoc_type":"string[]|string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"array|int","phpdoc_type":"int[]|int","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":"array|int|null","phpdoc_type":"int[]|int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|string","phpdoc_return_type":"string|string[]"},"documentation":{"description":"Replace text within a portion of a string The input string. </p> The replacement string. </p> If start is positive, the replacing will begin at the start'th offset into string. </p> <p> If start is negative, the replacing will begin at the start'th character from the end of string. </p> If given and is positive, it represents the length of the portion of string which is to be replaced. If it is negative, it represents the number of characters from the end of string at which to stop replacing. If it is not given, then it will default to strlen( string ); i.e. end the replacing at the end of string. Of course, if length is zero then this function will have the effect of inserting replacement into string at the given start offset. </p> array then array is returned. /","params":[{"name":"string","declared_type":"string[]|string","description":"<p>"},{"name":"replace","declared_type":"string[]|string","description":"<p>"},{"name":"offset","declared_type":"int[]|int","description":"<p>"},{"name":"length","declared_type":"int[]|int","description":"[optional] <p>"}],"return_type":"string|string[]","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"suhosin_encrypt_cookie","fqn":"suhosin_encrypt_cookie","kind":"Function","origin":"PhpRuntime","extension":"suhosin","location":{"file":"suhosin/suhosin.php","range":{"start":371,"end":393}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Encrypts a cookie value according to current cookie encrpytion setting Cookie name. </p> Cookie value. </p> /","params":[{"name":"name","declared_type":"string","description":"<p>"},{"name":"value","declared_type":"string","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"suhosin_get_raw_cookies","fqn":"suhosin_get_raw_cookies","kind":"Function","origin":"PhpRuntime","extension":"suhosin","location":{"file":"suhosin/suhosin.php","range":{"start":615,"end":638}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_re