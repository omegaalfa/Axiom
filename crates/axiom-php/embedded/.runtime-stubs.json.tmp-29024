ull},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_create_font","fqn":"wb_create_font","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":33385,"end":33399}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"color","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Creates a new font. name is the font name, height is its height in points (not pixels), and color is a RGB color value. flags can be a combination of the following values:. FTA_NORMAL FTA_REGULAR FTA_BOLD FTA_ITALIC FTA_UNDERLINE FTA_STRIKEOUT Constants of FTA_NORMAL and FTA_REGULAR mean the same thing and are defined as zero. The function returns an integer value that is the font identifier. After use, the font must be destroyed by a call to wb_destroy_font() to prevent resource leaks. NOTE: The color parameter is not implemented yet. /","params":[{"name":"name","declared_type":null,"description":null},{"name":"height","declared_type":null,"description":null},{"name":"color","declared_type":"null","description":null},{"name":"flags","declared_type":"null","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_create_image","fqn":"wb_create_image","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":14536,"end":14551}},"declared_type":null,"signature":{"parameters":[{"name":"width","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"dibbmi","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"dibbits","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Creates a true-color image measuring width by height pixels. NOTE: The resulting image must be destroyed by a call to wb_destroy_image(). /","params":[{"name":"width","declared_type":"int","description":null},{"name":"height","declared_type":"int","description":null},{"name":"dibbmi","declared_type":"null","description":null},{"name":"dibbits","declared_type":"null","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_create_mask","fqn":"wb_create_mask","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":14927,"end":14941}},"declared_type":null,"signature":{"parameters":[{"name":"bitmap","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"transparent_color","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Creates a transparency mask of a true-color bitmap. The mask returned is also a bitmap. The transparent color is set by transparent_color. NOTE: The resulting image must be destroyed by a call to wb_destroy_image(). /","params":[{"name":"bitmap","declared_type":null,"description":null},{"name":"transparent_color","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_create_timer","fqn":"wb_create_timer","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":12288,"end":12303}},"declared_type":null,"signature":{"parameters":[{"name":"window","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"id","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"interval","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Creates a timer in the specified window. The timer must be given an integer id that must be unique to all timers and controls. interval specifies the time-out value in milliseconds. Timer events are passed to and processed by the window callback function. A call to wb_destroy_timer() destroys the timer. Low resolution and high resolution timers This function supports both conventional (low-resolution) and multimedia (high-resolution) timers. Use a non-negative id to specify a low-resolution timer or a negative id to specify a high-resolution timer. Hi-res timers have a 10:1 increase in speed (resolution can go down to 1 ms opposed to 10 ms of a conventional timer) and much higher precision. NOTE: Only one high-resolution timer is allowed per application and it must be on the main window. /","params":[{"name":"window","declared_type":null,"description":null},{"name":"id","declared_type":null,"description":null},{"name":"interval","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_create_window","fqn":"wb_create_window","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":43581,"end":43597}},"declared_type":null,"signature":{"parameters":[{"name":"parent","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"wclass","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"caption","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"xpos","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"ypos","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"width","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"style","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"param","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Creates a window of class wclass. Click here for a list of the available window classes. Windows created with this function must be destroyed with a call to wb_destroy_window(). Optional style flags may be passed through parameter style. To enable additional messages in a particular window, include the WBC_NOTIFY style in the style parameter and use param to indicate which additional notification messages you want to process. This function may set the text and/or the tooltip (small hint window) of the window when it is created. To create a tooltip, text must be an array with two elements. The first one is the new caption (or NULL if one is not required) and the second one is the new tooltip (or NULL if one is not required). All classes support tooltips. Returns the handle of the newly created window or NULL or zero if an error occurs. /","params":[{"name":"parent","declared_type":null,"description":null},{"name":"wclass","declared_type":null,"description":null},{"name":"caption","declared_type":"null","description":null},{"name":"xpos","declared_type":"null","description":null},{"name":"ypos","declared_type":"null","description":null},{"name":"width","declared_type":"null","description":null},{"name":"height","declared_type":"null","description":null},{"name":"style","declared_type":"null","description":null},{"name":"param","declared_type":"null","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_delete_items","fqn":"wb_delete_items","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":24777,"end":24792}},"declared_type":null,"signature":{"parameters":[{"name":"ctrl","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"items","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Deletes an item, a range of items, or all items from a control. Returns TRUE on success or FALSE if an error occurs. Control classes. This function applies to the following control classes: ListBox, ComboBox, ListView and TreeView. $items can be: integer    Deletes the specified item. array of integers    Deletes the specified items. zero    Deletes item zero. null    Deletes all items. /","params":[{"name":"ctrl","declared_type":null,"description":null},{"name":"items","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb