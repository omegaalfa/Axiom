tication. </p> /","params":[{"name":"username","declared_type":"string","description":"<p>"},{"name":"password","declared_type":"string","description":"<p>"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"touch","fqn":"Memcached::touch","kind":"Method","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":32241,"end":32246}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"expiration","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcached &gt;= 2.0.0)<br/> Set a new expiration on an item The key under which to store the value. </p> The expiration time, defaults to 0. See Expiration Times for more info. </p> Use <b>Memcached::getResultCode</b> if necessary. /","params":[{"name":"key","declared_type":"string","description":"<p>"},{"name":"expiration","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"touchByKey","fqn":"Memcached::touchByKey","kind":"Method","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":33179,"end":33189}},"declared_type":null,"signature":{"parameters":[{"name":"server_key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"expiration","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcached &gt;= 2.0.0)<br/> Set a new expiration on an item on a specific server The key identifying the server to store the value on or retrieve it from. Instead of hashing on the actual key for the item, we hash on the server key when deciding which memcached server to talk to. This allows related items to be grouped together on a single server for efficiency with multi operations. </p> The key under which to store the value. </p> The expiration time, defaults to 0. See Expiration Times for more info. </p> Use <b>Memcached::getResultCode</b> if necessary. /","params":[{"name":"server_key","declared_type":"string","description":"<p>"},{"name":"key","declared_type":"string","description":"<p>"},{"name":"expiration","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"MemcachedException::__construct","kind":"Method","origin":"PhpRuntime","extension":"memcached","location":{"file":"memcached/memcached.php","range":{"start":59252,"end":59263}},"declared_type":null,"signature":{"parameters":[{"name":"errmsg","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"errcode","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"add","fqn":"MemcachePool::add","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":9078,"end":9081}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"var","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"flag","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"expire","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcache &gt;= 2.0.0)<br/> Add an item to the server. If the key already exists, the value will not be added and <b>FALSE</b> will be returned. Use <b>MEMCACHE_COMPRESSED</b> to store the item compressed (uses zlib). </p> If it's equal to zero, the item will never expire. You can also use Unix timestamp or a number of seconds starting from current time, but in the latter case the number of seconds may not exceed 2592000 (30 days).</p> /","params":[{"name":"key","declared_type":"string","description":"The key that will be associated with the item."},{"name":"var","declared_type":"mixed","description":"The variable to store. Strings and integers are stored as is, other types are stored serialized."},{"name":"flag","declared_type":"int","description":"[optional] <p>"},{"name":"expire","declared_type":"int","description":"[optional] <p>Expiration time of the item."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addServer","fqn":"MemcachePool::addServer","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":4692,"end":4701}},"declared_type":null,"signature":{"parameters":[{"name":"host","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"persistent","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"weight","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"retry_interval","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"status","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"failure_callback","declared_type":"?callable","phpdoc_type":"callable","optional":true,"variadic":false,"by_reference":false},{"name":"timeoutms","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcache &gt;= 2.0.0)<br/> Add a memcached server to connection pool Point to the host where memcached is listening for connections. This parameter may also specify other transports like unix:///path/to/memcached.sock to use UNIX domain sockets, in this case <i>port</i> must also be set to 0. </p> Point to the port where memcached is listening for connections. Set this parameter to 0 when using UNIX domain sockets. </p> <p> Please note: <i>port</i> defaults to memcache.default_port if not specified. For this reason it is wise to specify the port explicitly in this method call. </p> Controls the use of a persistent connection. Default to <b>TRUE</b>. </p> Number of buckets to create for this server which in turn control its probability of it being selected. The probability is relative to the total weight of all servers. </p> Value in seconds which will be used for connecting to the daemon. Think twice before changing the default value of 1 second - you can lose all the advantages of caching if your connection is too slow. </p> Controls how often a failed server will be retried, the default value is 15 seconds. Setting this parameter to -1 disables automatic retry. Neither this nor the <i>persistent</i> parameter has any effect when the extension is loaded dynamically via <b>dl</b>. </p> <p> Each failed connection struct has its own timeout and before it has expired the struct will be skipped when selecting backends to serve a request. Once expired the connection will be successfully reconnected or marked as failed for another <i>retry_interval</i> seconds. The typical effect is that each web server child will retry the connection about every <i>retry_interval</i> seconds when serving a page. </p> Controls if the server should be flagged as online. Setting this parameter to <b>FALSE</b> and <i>retry_interval</i> to -1 allows a failed server to be kept in the pool so as not to affect the key distribution algorithm. Requests for this server will then failover or fail immediately depending on the <i>memcache.allow_failover</i> setting. Default to <b>TRUE</b>, meaning the server should be considered online. </p> Allows the user to specify a callback function to run upon encountering an error. The callback is run before failover is attempted. The function takes two parameters, the hostname and port of the failed server. </p> </p> /","params":[{"name":"host","declared_type":"string","description":"<p>"},{"name":"port","declared_type":"int","description":"[optional] <p>"},{"name":"persistent","declared_type":"bool","description":"[optional] <p>"},{"name":"weight","declared_type":"int","description":"[optional] <p>"},{"name":"timeout","declared_type":"int","description":"[optional] <p>"},{"name":"retry_interval","declared_type":"int","description":"[optional] <p>"},{"name":"status","declared_type":"bool","description":"[optional] <p>"},{"name":"failure_callback","declared_type":"callable","description":"[optional] <p>"},{"name":"timeoutms","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"append","fqn":"MemcachePool::append","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":12760,"end":12766}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"var","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"flag","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"expire","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"string","description":"<p>The key that will be associated with the item.</p>"},{"name":"var","declared_type":"mixed","description":"<p>The variable to store. Strings and integers are stored as is, other types are stored serialized.</p>"},{"name":"flag","declared_type":"int","description":"[optional] <p>Use <b>MEMCACHE_COMPRESSED</b> to store the item compressed (uses zlib).</p>"},{"name":"expire","declared_type":"int","description":"[optional] <p>Expiration time of the item. If it's equal to zero, the item will never expire. You can also use Unix timestamp or a number of seconds starting from current time, but in the latter case the number of seconds may not exceed 2592000 (30 days).</p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"cas","fqn":"MemcachePool::cas","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":11999,"end":12002}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"var","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"flag","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"expire","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"string","description":"<p>The key that will be associated with the item.</p>"},{"name":"var","declared_type":"mixed","description":"<p>The variable to store. Strings and integers are stored as is, other types are stored serialized.</p>"},{"name":"flag","declared_type":"int","description":"[optional] <p>Use <b>MEMCACHE_COMPRESSED</b> to store the item compressed (uses zlib).</p>"},{"name":"expire","declared_type":"int","description":"[optional] <p>Expiration time of the item. If it's equal to zero, the item will never expire. You can also use Unix timestamp or a number of seconds starting from current time, but in the latter case the number of seconds may not exceed 2592000 (30 days).</p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"close","fqn":"MemcachePool::close","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":19132,"end":19137}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcache &gt;= 0.4.0)<br/> Close memcached server connection /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"connect","fqn":"MemcachePool::connect","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":1358,"end":1365}},"declared_type":null,"signature":{"parameters":[{"name":"host","declared_type":null,"