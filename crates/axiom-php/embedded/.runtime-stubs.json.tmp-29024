false","phpdoc_return_type":"array|false"},"documentation":{"description":"Splits a key in string representation into array representation The key in string representation. </p> value_name). This function will return <b>FALSE</b> if <i>key</i> is <b>NULL</b> or <b>FALSE</b>. /","params":[{"name":"key","declared_type":"string|false|null","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dba_list","fqn":"dba_list","kind":"Function","origin":"PhpRuntime","extension":"dba","location":{"file":"dba/dba.php","range":{"start":16298,"end":16306}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"List all open database files /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dba_nextkey","fqn":"dba_nextkey","kind":"Function","origin":"PhpRuntime","extension":"dba","location":{"file":"dba/dba.php","range":{"start":14610,"end":14621}},"declared_type":null,"signature":{"parameters":[{"name":"dba","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Fetch next key The database handler, returned by <b>dba_open</b> or <b>dba_popen</b>. </p> /","params":[{"name":"dba","declared_type":"resource","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dba_open","fqn":"dba_open","kind":"Function","origin":"PhpRuntime","extension":"dba","location":{"file":"dba/dba.php","range":{"start":3711,"end":3719}},"declared_type":null,"signature":{"parameters":[{"name":"path","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"handler","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"handler_params","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Open database Commonly a regular path in your filesystem. </p> It is r for read access, w for read/write access to an already existing database, c for read/write access and database creation if it doesn't currently exist, and n for create, truncate and read/write access. The database is created in BTree mode, other modes (like Hash or Queue) are not supported. </p> <p> Additionally you can set the database lock method with the next char. Use l to lock the database with a .lck file or d to lock the databasefile itself. It is important that all of your applications do this consistently. </p> <p> If you want to test the access and do not want to wait for the lock you can add t as third character. When you are absolutely sure that you do not require database locking you can do so by using - instead of l or d. When none of d, l or - is used, dba will lock on the database file as it would with d. </p> <p> There can only be one writer for one database file. When you use dba on a web server and more than one request requires write operations they can only be done one after another. Also read during write is not allowed. The dba extension uses locks to prevent this. See the following table: <table> DBA locking <tr valign=\"top\"> <td>already open</td> <td><i>mode</i> = \"rl\"</td> <td><i>mode</i> = \"rlt\"</td> <td><i>mode</i> = \"wl\"</td> <td><i>mode</i> = \"wlt\"</td> <td><i>mode</i> = \"rd\"</td> <td><i>mode</i> = \"rdt\"</td> <td><i>mode</i> = \"wd\"</td> <td><i>mode</i> = \"wdt\"</td> </tr> <tr valign=\"top\"> <td>not open</td> <td>ok</td> <td>ok</td> <td>ok</td> <td>ok</td> <td>ok</td> <td>ok</td> <td>ok</td> <td>ok</td> </tr> <tr valign=\"top\"> <td><i>mode</i> = \"rl\"</td> <td>ok</td> <td>ok</td> <td>wait</td> <td>false</td> <td>illegal</td> <td>illegal</td> <td>illegal</td> <td>illegal</td> </tr> <tr valign=\"top\"> <td><i>mode</i> = \"wl\"</td> <td>wait</td> <td>false</td> <td>wait</td> <td>false</td> <td>illegal</td> <td>illegal</td> <td>illegal</td> <td>illegal</td> </tr> <tr valign=\"top\"> <td><i>mode</i> = \"rd\"</td> <td>illegal</td> <td>illegal</td> <td>illegal</td> <td>illegal</td> <td>ok</td> <td>ok</td> <td>wait</td> <td>false</td> </tr> <tr valign=\"top\"> <td><i>mode</i> = \"wd\"</td> <td>illegal</td> <td>illegal</td> <td>illegal</td> <td>illegal</td> <td>wait</td> <td>false</td> <td>wait</td> <td>false</td> </tr> </table> ok: the second call will be successful. wait: the second call waits until <b>dba_close</b> is called for the first. false: the second call returns false. illegal: you must not mix \"l\" and \"d\" modifiers for <i>mode</i> parameter. </p> The name of the handler which shall be used for accessing <i>path</i>. It is passed all optional parameters given to <b>dba_open</b> and can act on behalf of them. </p> /","params":[{"name":"path","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"string","description":"<p>"},{"name":"handler","declared_type":"string","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dba_optimize","fqn":"dba_optimize","kind":"Function","origin":"PhpRuntime","extension":"dba","location":{"file":"dba/dba.php","range":{"start":15002,"end":15014}},"declared_type":null,"signature":{"parameters":[{"name":"dba","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Optimize database The database handler, returned by <b>dba_open</b> or <b>dba_popen</b>. </p> /","params":[{"name":"dba","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dba_popen","fqn":"dba_popen","kind":"Function","origin":"PhpRuntime","extension":"dba","location":{"file":"dba/dba.php","range":{"start":7923,"end":7932}},"declared_type":null,"signature":{"parameters":[{"name":"path","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"handler","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"handler_params","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Open database persistently Commonly a regular path in your filesystem. </p> It is r for read access, w for read/write access to an already existing database, c for read/write access and database creation if it doesn't currently exist, and n for create, truncate and read/write access. </p> The name of the handler which shall be used for accessing <i>path</i>. It is passed all optional parameters given to <b>dba_popen</b> and can act on behalf of them. </p> /","params":[{"name":"path","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"string","description":"<p>"},{"name":"handler","declared_type":"string","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null