ry","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"(PHP 5 &gt;= 5.1.2, PECL hash &gt;= 1.1)<br/> Finalize an incremental hash and return resulting digest Hashing context returned by {@see hash_init}. </p> When set to <b>TRUE</b>, outputs raw binary data. <b>FALSE</b> outputs lowercase hexits. </p> unless <i>binary</i> is set to true in which case the raw binary representation of the message digest is returned. /","params":[{"name":"context","declared_type":"HashContext|resource","description":"<p>"},{"name":"binary","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hash_hkdf","fqn":"hash_hkdf","kind":"Function","origin":"PhpRuntime","extension":"hash","location":{"file":"hash/hash.php","range":{"start":12221,"end":12230}},"declared_type":null,"signature":{"parameters":[{"name":"algo","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"info","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"salt","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Generate a hkdf key derivation of a supplied key input See {@see hash_algos()} for a list of supported algorithms. <blockquote> <p><strong>Note</strong></p> <p> Non-cryptographic hash functions are not allowed. </p> </blockquote> If <b>length</b> is 0, the output length will default to the chosen hash function size.</p> Generate a HKDF key derivation of a supplied key input unknown/non-cryptographic, length is less than 0 or too large (greater than 255 times the size of the hash function). /","params":[{"name":"algo","declared_type":"string","description":"Name of selected hashing algorithm (i.e. \"sha256\", \"sha512\", \"haval160,4\", etc..)"},{"name":"key","declared_type":"string","description":"<p>Input keying material (raw binary). Cannot be empty.</p>"},{"name":"length","declared_type":"int","description":"[optional] <p>Desired output length in bytes. Cannot be greater than 255 times the chosen hash function size."},{"name":"info","declared_type":"string","description":"[optional] <p>Application/context-specific info string.</p>"},{"name":"salt","declared_type":"string","description":"[optional] <p>Salt to use during derivation. While optional, adding random salt significantly improves the strength of HKDF.</p>"}],"return_type":"string|false","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hash_hmac","fqn":"hash_hmac","kind":"Function","origin":"PhpRuntime","extension":"hash","location":{"file":"hash/hash.php","range":{"start":3965,"end":3974}},"declared_type":null,"signature":{"parameters":[{"name":"algo","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"data","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"binary","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"(PHP 5 &gt;= 5.1.2, PECL hash &gt;= 1.1)<br/> Generate a keyed hash value using the HMAC method Name of selected hashing algorithm (i.e. \"md5\", \"sha256\", \"haval160,4\", etc..) See <b>hash_algos</b> for a list of supported algorithms.<br/> Since 7.2.0 usage of non-cryptographic hash functions (adler32, crc32, crc32b, fnv132, fnv1a32, fnv164, fnv1a64, joaat) was disabled. </p> Message to be hashed. </p> Shared secret key used for generating the HMAC variant of the message digest. </p> When set to <b>TRUE</b>, outputs raw binary data. <b>FALSE</b> outputs lowercase hexits. </p> unless <i>binary</i> is set to true in which case the raw binary representation of the message digest is returned. hash function. /","params":[{"name":"algo","declared_type":"string","description":"<p>"},{"name":"data","declared_type":"string","description":"<p>"},{"name":"key","declared_type":"string","description":"<p>"},{"name":"binary","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hash_hmac_algos","fqn":"hash_hmac_algos","kind":"Function","origin":"PhpRuntime","extension":"hash","location":{"file":"hash/hash.php","range":{"start":12707,"end":12722}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"string[]"},"documentation":{"description":"Return a list of registered hashing algorithms suitable for hash_hmac Return a list of registered hashing algorithms suitable for hash_hmac /","params":[],"return_type":"string[]","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hash_hmac_file","fqn":"hash_hmac_file","kind":"Function","origin":"PhpRuntime","extension":"hash","location":{"file":"hash/hash.php","range":{"start":5290,"end":5304}},"declared_type":null,"signature":{"parameters":[{"name":"algo","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":fal