0.2)<br/> Deletes the large object A large object identifier. </p> /","params":[{"name":"oid","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"prepare","fqn":"PDO::prepare","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":43868,"end":43875}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":null,"phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"PDOStatement|false","phpdoc_return_type":"PDOStatement|false"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Prepares a statement for execution and returns a statement object This must be a valid SQL statement for the target database server. </p> This array holds one or more key=&gt;value pairs to set attribute values for the <b>PDOStatement</b> object that this method returns. You would most commonly use this to set the <b>PDO::ATTR_CURSOR</b> value to <b>PDO::CURSOR_SCROLL</b> to request a scrollable cursor. Some drivers have driver specific options that may be set at prepare-time. </p> <b>PDO::prepare</b> returns a <b>PDOStatement</b> object. If the database server cannot successfully prepare the statement, <b>PDO::prepare</b> returns <b>FALSE</b> or emits <b>PDOException</b> (depending on error handling). </p> <p> Emulated prepared statements does not communicate with the database server so <b>PDO::prepare</b> does not check the statement. /","params":[{"name":"query","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"array","description":"[optional] <p>"}],"return_type":"PDOStatement|false","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"query","fqn":"PDO::query","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":50159,"end":50164}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"fetchMode","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"arg3","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false},{"name":"ctorargs","declared_type":null,"phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"PDOStatement|false","phpdoc_return_type":"PDOStatement|false"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.2.0)<br/> Executes an SQL statement, returning a result set as a PDOStatement object The SQL statement to prepare and execute. </p> <p> Data inside the query should be properly escaped. </p> The fetch mode must be one of the PDO::FETCH_* constants. </p> The second and following parameters are the same as the parameters for PDOStatement::setFetchMode. </p> Arguments of custom class constructor when the <i>mode</i> parameter is set to <b>PDO::FETCH_CLASS</b>. </p> on failure or emits <b>PDOException</b> (depending on error handling) /","params":[{"name":"query","declared_type":"string","description":"<p>"},{"name":"fetchMode","declared_type":"int","description":"<p>"},{"name":"arg3","declared_type":"mixed","description":"<p>"},{"name":"ctorargs","declared_type":"array","description":"[optional] <p>"}],"return_type":"PDOStatement|false","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"quote","fqn":"PDO::quote","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":58495,"e