_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xpending","fqn":"Redis::xpending","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":177954,"end":177962}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"group","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"end","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"consumer","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Interact with stream messages that have been consumed by a consumer group but not yet acknowledged with XACK. $redis->xpending('mystream', 'workers', '-', '+', 10); /","params":[{"name":"key","declared_type":"string","description":"The stream to inspect."},{"name":"group","declared_type":"string","description":"The user group we want to see pending messages from."},{"name":"start","declared_type":"string|null","description":"The minimum ID to consider."},{"name":"end","declared_type":"string|null","description":"The maximum ID to consider."},{"name":"count","declared_type":"int","description":"Optional maximum number of messages to return."},{"name":"consumer","declared_type":"string|null","description":"If provided, limit the returned messages to a specific consumer."}],"return_type":"Redis|array|false","var_type