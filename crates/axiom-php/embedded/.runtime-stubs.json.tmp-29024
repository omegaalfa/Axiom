wner. </p> The table. </p> The scope, which orders the result set. </p> The nullable option. </p> failure. <p> The result set has the following columns: SCOPE COLUMN_NAME DATA_TYPE TYPE_NAME PRECISION LENGTH SCALE PSEUDO_COLUMN </p> /","params":[{"name":"odbc","declared_type":"Odbc\\Connection|resource","description":"<p>The ODBC connection identifier,"},{"name":"type","declared_type":"int","description":"When the type argument is <b>SQL_BEST_ROWID</b>,"},{"name":"catalog","declared_type":"string|null","description":"<p>"},{"name":"schema","declared_type":"string","description":"<p>"},{"name":"table","declared_type":"string","description":"<p>"},{"name":"scope","declared_type":"int","description":"<p>"},{"name":"nullable","declared_type":"int","description":"<p>"}],"return_type":"Odbc\\Result|resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_statistics","fqn":"odbc_statistics","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":24843,"end":24858}},"declared_type":null,"signature":{"parameters":[{"name":"odbc","declared_type":null,"phpdoc_type":"Odbc\\Connection|resource","optional":false,"variadic":false,"by_reference":false},{"name":"catalog","declared_type":"?string","phpdoc_type":"string|null","optional":false,"variadic":false,"by_reference":false},{"name":"schema","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"table","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"unique","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"accuracy","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Odbc\\Result|resource|false"},"documentation":{"descript