ion":"random","location":{"file":"random/random.php","range":{"start":1609,"end":1614}},"declared_type":null,"signature":{"parameters":[{"name":"seed","declared_type":null,"phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Seed the random number generator <p><strong>Note</strong>: As of PHP 7.1.0, {@see srand()} has been made an alias of {@see mt_srand()}. </p> Optional seed value </p> Use one of the following constants to specify the implementation of the algorithm to use. </p> /","params":[{"name":"seed","declared_type":"int|null","description":"<p>"},{"name":"mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sscanf","fqn":"sscanf","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_2.php","range":{"start":17908,"end":17914}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"format","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"vars","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":true}],"declared_return_type":"array|int|null","phpdoc_return_type":"array|int|null"},"documentation":{"description":"Parses input from a string according to a format The input string being parsed. </p> The interpreted format for str, which is described in the documentation for sprintf with following differences: Function is not locale-aware. F, g, G and b are not supported. D stands for decimal number. i stands for integer with base detection. n stands for number of characters processed so far. </p> two parameters were passed to this function, the values parsed will be returned as an array. Otherwise, if optional parameters are passed, the function will return the number of assigned values. The optional parameters must be passed by reference. /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"format","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"array|int|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_auth_agent","fqn":"ssh2_auth_agent","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":23013,"end":23028}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"username","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL ssh2 &gt;= 0.12)<br/> ssh2_auth_agent — Authenticate over SSH using the ssh agent <p> Authenticate over SSH using the ssh agent </p> <p> Note: The ssh2_auth_agent() function will only be available when the ssh2 extension is compiled with libssh >= 1.2.3. </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>An SSH connection link identifier, obtained from a call to ssh2_connect().</p>"},{"name":"username","declared_type":"string","description":"<p>Remote user name.</p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_auth_hostbased_file","fqn":"ssh2_auth_hostbased_file","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":8976,"end":9000}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"username","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"hostname","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pubkeyfile","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"privkeyfile","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"passphrase","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"local_username","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Authenticate using a public hostkey An SSH connection link identifier, obtained from a call to ssh2_connect. </p> </p> </p> </p> </p> If privkeyfile is encrypted (which it should be), the passphrase must be provided. </p> If local_username is omitted, then the value for username will be used for it. </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>"},{"name":"username","declared_type":"string","description":"<p>"},{"name":"hostname","declared_type":"string","description":"<p>"},{"name":"pubkeyfile","declared_type":"string","description":"<p>"},{"name":"privkeyfile","declared_type":"string","description":"<p>"},{"name":"passphrase","declared_type":"string","description":"[optional] <p>"},{"name":"local_username","declared_type":"string","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_auth_none","fqn":"ssh2_auth_none","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":6023,"end":6037}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"username","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|bool"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Authenticate as \"none\" An SSH connection link identifier, obtained from a call to ssh2_connect. </p> Remote user name. </p> method, or an array of accepted authentication methods on failure. /","params":[{"name":"session","declared_type":"resource","description":"<p>"},{"name":"username","declared_type":"string","description":"<p>"}],"return_type":"array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_auth_password","fqn":"ssh2_auth_password","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":6523,"end":6541}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"username","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"password","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Authenticate over SSH using a plain password An SSH connection link identifier, obtained from a call to ssh2_connect. </p> Remote user name. </p> Password for username </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>"},{"name":"username","declared_type":"string","description":"<p>"},{"name":"password","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_auth_pubkey","fqn":"ssh2_auth_pubkey","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":7436,"end":7452}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"username","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pubkey","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"privkey","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"passphrase","declared_type":null,"phpdoc_type":"?string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL ssh2 &gt;= 1.4.0)<br/> Authenticate using a public key in a variable An SSH connection link identifier, obtained from a call to ssh2_connect. </p> Name of the user to authenticate as on the remote server. </p> Public key in OpenSSH's format. It should look something like: ssh-rsa AAAAB3NzaC1yc2EAAA....NX6sqSnHA8= rsa-key-20121110 </p> Private OpenSSH key. It should begin with: -----BEGIN RSA PRIVATE KEY----- </p> If privkey is encrypted (which it should be), the passphrase must be provided. </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>"},{"name":"username","declared_type":"string","description":"<p>"},{"name":"pubkey","declared_type":"string","description":"<p>"},{"name":"privkey","declared_type":"string","description":"<p>"},{"name":"passphrase","declared_type":"?string","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_auth_pubkey_file","fqn":"ssh2_auth_pubkey_file","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":8106,"end":8127}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"username","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pubkeyfile","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"privkeyfile","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"passphrase","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Authenticate using a public key An SSH connection link identifier, obtained from a call to ssh2_connect. </p> </p> </p> </p> If privkeyfile is encrypted (which it should be), the passphrase must be provided. </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>"},{"name":"username","declared_type":"string","description":"<p>"},{"name":"pubkeyfile","declared_type":"string","description":"<p>"},{"name":"privkeyfile","declared_type":"string","description":"<p>"},{"name":"passphrase","declared_type":"string","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_connect","fqn":"ssh2_connect","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":4254,"end":4266}},"declared_type":null,"signature":{"parameters":[{"name":"host","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"methods","declared_type":"?array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false},{"name":"callbacks","declared_type":"?array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Connect to an SSH server </p> </p> methods may be an associative array with up to four parameters as described below. </p> <p> <table> methods may be an associative array with any or all of the following parameters. <tr valign=\"top\"> <td>Index</td> <td>Meaning</td> <td>Supported Values*</td> </tr> <tr valign=\"top\"> <td>kex</td> <td> List of key exchange methods to advertise, comma separated in order of preference. </td> <td> diffie-hellman-group1-sha1, diffie-hellman-group14-sha1, and diffie-hellman-group-exchange-sha1 </td> </tr> <tr valign=\"top\"> <td>hostkey</td> <td> List of hostkey methods to advertise, come separated in order of preference. </td> <td> ssh-rsa and ssh-dss </td> </tr> <tr valign=\"top\"> <td>client_to_server</td> <td> Associative array containing crypt, compression, and message authentication code (MAC) method preferences for messages sent from client to server. </td> </tr> <tr valign=\"top\"> <td>server_to_client</td> <td> Associative array containing crypt, compression, and message authentication code (MAC) method preferences for messages sent from server to client. </td> </tr> </table> </p> <p> * - Supported Values are dependent on methods supported by underlying library. See libssh2 documentation for additional information. </p> <p> <table> client_to_server and server_to_client may be an associative array with any or all of the following parameters. <tr valign=\"top\"> <td>Index</td> <td>Meaning</td> <td>Supported Values*</td> </tr> <tr valign=\"top\"> <td>crypt</td> <td>List of crypto methods to advertise, comma separated in order of preference.</td> <td> rijndael-cbc@lysator.liu.se, aes256-cbc, aes192-cbc, aes128-cbc, 3des-cbc, blowfish-cbc, cast128-cbc, arcfour, and none** </td> </tr> <tr valign=\"top\"> <td>comp</td> <td>List of compression methods to advertise, comma separated in order of preference.</td> <td> zlib and none </td> </tr> <tr valign=\"top\"> <td>mac</td> <td>List of MAC methods to advertise, come separated in order of preference.</td> <td> hmac-sha1, hmac-sha1-96, hmac-ripemd160, hmac-ripemd160@openssh.com, and none** </td> </tr> </table> </p> <p> Crypt and MAC method \"none\" <p> For security reasons, none is disabled by the underlying libssh2 library unless explicitly enabled during build time by using the appropriate ./configure options. See documentation for the underlying library for more information. </p> </p> callbacks may be an associative array with any or all of the following parameters. <table> Callbacks parameters <tr valign=\"top\"> <td>Index</td> <td>Meaning</td> <td>Prototype</td> </tr> <tr valign=\"top\"> <td>ignore</td> <td> Name of function to call when an SSH2_MSG_IGNORE packet is received </td> <td>void ignore_cb($message)</td> </tr> <tr valign=\"top\"> <td>debug</td> <td> Name of function to call when an SSH2_MSG_DEBUG packet is received </td> <td>void debug_cb($message, $language, $always_display)</td> </tr> <tr valign=\"top\"> <td>macerror</td> <td> Name of function to call when a packet is received but the message authentication code failed. If the callback returns true, the mismatch will be ignored, otherwise the connection will be terminated. </td> <td>bool macerror_cb($packet)</td> </tr> <tr valign=\"top\"> <td>disconnect</td> <td> Name of function to call when an SSH2_MSG_DISCONNECT packet is received </td> <td>void disconnect_cb($reason, $message, $language)</td> </tr> </table> </p> /","params":[{"name":"host","declared_type":"string","description":"<p>"},{"name":"port","declared_type":"int","description":"[optional] <p>"},{"name":"methods","declared_type":"null|array","description":"[optional] <p>"},{"name":"callbacks","declared_type":"null|array","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_disconnect","fqn":"ssh2_disconnect","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":4631,"end":4646}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL ssh2 &gt;= 1.0)<br/> Close a connection to a remote SSH server An SSH connection link identifier, obtained from a call to ssh2_connect. </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_exec","fqn":"ssh2_exec","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":12035,"end":12044}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"command","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pty","declared_type":null,"phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false},{"name":"env","declared_type":"?array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false},{"name":"width","declared_type":null,"phpdoc_type":"null|int","optional":true,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":"null|int","optional":true,"variadic":false,"by_reference":false},{"name":"width_height_type","declared_type":null,"phpdoc_type":"null|int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Execute a command on a remote server An SSH connection link identifier, obtained from a call to ssh2_connect. </p> </p> </p> env may be passed as an associative array of name/value pairs to set in the target environment. </p> Width of the virtual terminal. </p> Height of the virtual terminal. </p> width_height_type should be one of SSH2_TERM_UNIT_CHARS or SSH2_TERM_UNIT_PIXELS. </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>"},{"name":"command","declared_type":"string","description":"<p>"},{"name":"pty","declared_type":"null|string","description":"[optional] <p>"},{"name":"env","declared_type":"null|array","description":"[optional] <p>"},{"name":"width","declared_type":"null|int","description":"[optional] <p>"},{"name":"height","declared_type":"null|int","description":"[optional] <p>"},{"name":"width_height_type","declared_type":"null|int","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_fetch_stream","fqn":"ssh2_fetch_stream","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":14001,"end":14018}},"declared_type":null,"signature":{"parameters":[{"name":"channel","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"streamid","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Fetch an extended data stream </p> An SSH2 channel stream. </p> /","params":[{"name":"channel","declared_type":"resource","description":"<p>"},{"name":"streamid","declared_type":"int","description":"<p>"}],"return_type":"resource","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_fingerprint","fqn":"ssh2_fingerprint","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":5509,"end":5525}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Retrieve fingerprint of remote server An SSH connection link identifier, obtained from a call to ssh2_connect. </p> flags may be either of SSH2_FINGERPRINT_MD5 or SSH2_FINGERPRINT_SHA1 logically ORed with SSH2_FINGERPRINT_HEX or SSH2_FINGERPRINT_RAW. </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_forward_accept","fqn":"ssh2_forward_accept","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":10087,"end":10106}},"declared_type":null,"signature":{"parameters":[{"name":"listener","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Accept a connection created by a listener An SSH2 Listener resource, obtained from a call to ssh2_forward_listen(). </p> /","params":[{"name":"listener","declared_type":"resource","description":"<p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_forward_listen","fqn":"ssh2_forward_listen","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":9651,"end":9670}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"host","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"max_connections","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Bind a port on the remote server and listen for connections An SSH connection link identifier, obtained from a call to `ssh2_connect()`. </p> The port of the remote server. </p> </p> </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>"},{"name":"port","declared_type":"int","description":"<p>"},{"name":"host","declared_type":"string","description":"[optional] <p>"},{"name":"max_connections","declared_type":"int","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_methods_negotiated","fqn":"ssh2_methods_negotiated","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":4955,"end":4978}},"declared_type":null,"signature":{"parameters":[{"name":"session","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Return list of negotiated methods An SSH connection link identifier, obtained from a call to ssh2_connect. </p> /","params":[{"name":"session","declared_type":"resource","description":"<p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_poll","fqn":"ssh2_poll","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":14767,"end":14776}},"declared_type":null,"signature":{"parameters":[{"name":"desc","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"(PECL ssh2 &gt;= 0.9.0)<br/> Poll the channels/listeners/streams for events An indexed array of subarrays with the keys 'resource' and 'events'. The value of the resource is a (channel) stream or an SSH2 Listener resource. The value of the event are SSH2_POLL* flags bitwise ORed together. Each subarray will be populated with an 'revents' element on return, whose values are SSH2_POLL* flags bitwise ORed together of the events that occurred. </p> The timeout in seconds. </p> /","params":[{"name":"","declared_type":null,"description":null},{"name":"timeout","declared_type":"int","description":"<p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssh2_publickey_add","fqn":"ssh2_publickey_add","kind":"Function","origin":"PhpRuntime","extension":"ssh2","location":{"file":"ssh2/ssh2.php","range":{"start":20332,"end":20350}},"declared_type":null,"signature":{"parameters":[{"name":"pkey","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"algoname","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"blob","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"overwrite","declared_type":null,"phpdoc_type":"null|bool","optional":true,"variadic":false,"by_reference":false},{"name":"attributes","declared_type":"?array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL ssh2 &gt;= 0.10)<br/> Add an authorized publickey Publickey Subsystem resource created by ssh2_publickey_init. </p> Publickey algorithm (e.g.): ssh-dss, ssh-rsa </p> Publickey blob as raw binary data </p> If the specified key already exists, should it be overwritten? </p> Associative array of attributes to assign to this public key. Refer to ietf-secsh-publickey-subsystem for a list of supported attributes. To mark an attribute as mandatory, precede its name with an asterisk. If the server is unable to support an attribute marked mandatory, it will abort the add process. </p> /","params":[{"name":"pkey","declared_type":"resource","description":"<p>"},{"name":"algoname","declared_type":"string","description":"<p>"},{"name":"blob","declared_type":"string","description":"<p>"},{"name":"overwrite","declared_type":"null|bool","description":"[optional] <p>"},{"name":"attributes","declared_type":"null|array","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name