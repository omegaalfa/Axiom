il":null},"is_static":false},{"name":"flock","fqn":"flock","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_6.php","range":{"start":24444,"end":24449}},"declared_type":null,"signature":{"parameters":[{"name":"stream","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"operation","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"would_block","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Portable advisory file locking An open file pointer. </p> operation is one of the following: LOCK_SH to acquire a shared lock (reader).</p> The optional third argument is set to 1 if the lock would block (EWOULDBLOCK errno condition). </p> /","params":[{"name":"stream","declared_type":"resource","description":"<p>"},{"name":"operation","declared_type":"int","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"floor","fqn":"floor","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":3225,"end":3230}},"declared_type":null,"signature":{"parameters":[{"name":"num","declared_type":"int|float","phpdoc_type":"int|float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"float|false"},"documentation":{"description":"Round fractions down The numeric value to round </p> The return value of floor is still of type float because the value range of float is usually bigger than that of integer. /","params":[{"name":"num","declared_type":"int|float","description":"<p>"}],"return_type":"float|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"flush","fqn":"flush","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":11771,"end":11776}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Flush system output buffer /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fmod","fqn":"fmod","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":17618,"end":17622}},"declared_type":null,"signature":{"parameters":[{"name":"num1","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"num2","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float","phpdoc_return_type":"float"},"documentation":{"description":"Returns the floating point remainder (modulo) of the division of the arguments The dividend </p> The divisor </p> x/y /","params":[{"name":"num1","declared_type":"float","description":"<p>"},{"name":"num2","declared_type":"float","description":"<p>"}],"return_type":"float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fnmatch","fqn":"fnmatch","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_6.php","range":{"start":42474,"end":42481}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Match filename against a pattern The shell wildcard pattern. </p> The tested string. This function is especially useful for filenames, but may also be used on regular strings. </p> <p> The average user may be used to shell patterns or at least in their simplest form to '?' and '*' wildcards so using fnmatch instead of preg_match for frontend search expression input may be way more convenient for non-programming users. </p> The value of flags can be any combination of the following flags, joined with the binary OR (|) operator. <table> A list of possible flags for fnmatch <tr valign=\"top\"> <td>Flag</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>FNM_NOESCAPE</td> <td> Disable backslash escaping. </td> </tr> <tr valign=\"top\"> <td>FNM_PATHNAME</td> <td> Slash in string only matches slash in the given pattern. </td> </tr> <tr valign=\"top\"> <td>FNM_PERIOD</td> <td> Leading period in string must be exactly matched by period in the given pattern. </td> </tr> <tr valign=\"top\"> <td>FNM_CASEFOLD</td> <td> Caseless match. Part of the GNU extension. </td> </tr> </table> </p> /","params":[{"name":"pattern","declared_type":"string","description":"<p>"},{"name":"filename","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fopen","fqn":"fopen","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_5.php","range":{"start":22226,"end":22231}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"use_include_path","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"context","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Opens file or URL If filename is of the form \"scheme://...\", it is assumed to be a URL and PHP will search for a protocol handler (also known as a wrapper) for that scheme. If no wrappers for that protocol are registered, PHP will emit a notice to help you track potential problems in your script and then continue as though filename specifies a regular file. </p> <p> If PHP has decided that filename specifies a local file, then it will try to open a stream on that file. The file must be accessible to PHP, so you need to ensure that the file access permissions allow this access. If you have enabled \"safemode\", or open_basedir further restrictions may apply. </p> <p> If PHP has decided that filename specifies a registered protocol, and that protocol is registered as a network URL, PHP will check to make sure that allow_url_fopen is enabled. If it is switched off, PHP will emit a warning and the fopen call will fail. </p> <p> The list of supported protocols can be found in . Some protocols (also referred to as wrappers) support context and/or \"php.ini\" options. Refer to the specific page for the protocol in use for a list of options which can be set. (e.g. \"php.ini\" value user_agent used by the http wrapper). </p> <p> On the Windows platform, be careful to escape any backslashes used in the path to the file, or use forward slashes. </p> <pre> <?php $handle = fopen(\"c:\\\\folder\\\\resource.txt\", \"r\"); ?> </pre> The mode parameter specifies the type of access you require to the stream. It may be any of the following: <table> A list of possible modes for fopen using mode <tr valign=\"top\"> <td>mode</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>'r'</td> <td> Open for reading only; place the file pointer at the beginning of the file. </td> </tr> <tr valign=\"top\"> <td>'r+'</td> <td> Open for reading and writing; place the file pointer at the beginning of the file. </td> </tr> <tr valign=\"top\"> <td>'w'</td> <td> Open for writing only; place the file pointer at the beginning of the file and truncate the file to zero length. If the file does not exist, attempt to create it. </td> </tr> <tr valign=\"top\"> <td>'w+'</td> <td> Open for reading and writing; place the file pointer at the beginning of the file and truncate the file to zero length. If the file does not exist, attempt to create it. </td> </tr> <tr valign=\"top\"> <td>'a'</td> <td> Open for writing only; place the file pointer at the end of the file. If the file does not exist, attempt to create it. </td> </tr> <tr valign=\"top\"> <td>'a+'</td> <td> Open for reading and writing; place the file pointer at the end of the file. If the file does not exist, attempt to create it. </td> </tr> <tr valign=\"top\"> <td>'x'</td> <td> Create and open for writing only; place the file pointer at the beginning of the file. If the file already exists, the fopen call will fail by returning false and generating an error of level E_WARNING. If the file does not exist, attempt to create it. This is equivalent to specifying O_EXCL|O_CREAT flags for the underlying open(2) system call. </td> </tr> <tr valign=\"top\"> <td>'x+'</td> <td> Create and open for reading and writing; place the file pointer at the beginning of the file. If the file already exists, the fopen call will fail by returning false and generating an error of level E_WARNING. If the file does not exist, attempt to create it. This is equivalent to specifying O_EXCL|O_CREAT flags for the underlying open(2) system call. </td> </tr> </table> </p> <p> Different operating system families have different line-ending conventions. When you write a text file and want to insert a line break, you need to use the correct line-ending character(s) for your operating system. Unix based systems use \\n as the line ending character, Windows based systems use \\r\\n as the line ending characters and Macintosh based systems use \\r as the line ending character. </p> <p> If you use the wrong line ending characters when writing your files, you might find that other applications that open those files will \"look funny\". </p> <p> Windows offers a text-mode translation flag ('t') which will transparently translate \\n to \\r\\n when working with the file. In contrast, you can also use 'b' to force binary mode, which will not translate your data. To use these flags, specify either 'b' or 't' as the last character of the mode parameter. </p> <p> The default translation mode depends on the SAPI and version of PHP that you are using, so you are encouraged to always specify the appropriate flag for portability reasons. You should use the 't' mode if you are working with plain-text files and you use \\n to delimit your line endings in your script, but expect your files to be readable with applications such as notepad. You should use the 'b' in all other cases. </p> <p> If you do not specify the 'b' flag when working with binary files, you may experience strange problems with your data, including broken image files and strange problems with \\r\\n characters. </p> <p> For portability, it is strongly recommended that you always use the 'b' flag when opening files with fopen. </p> <p> Again, for portability, it is also strongly recommended that you re-write code that uses or relies upon the 't' mode so that it uses the correct line endings and 'b' mode instead. </p> The optional third use_include_path parameter can be set to '1' or true if you want to search for the file in the include_path, too. </p> /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"string","description":"<p>"},{"name":"use_include_path","declared_type":"bool","description":"[optional] <p>"},{"name":"context","declared_type":"resource","description":"[optional]"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"forward_static_call","fqn":"forward_static_call","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":3262,"end":3281}},"declared_type":null,"signature":{"parameters":[{"name":"callback","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Call a static method The function or method to be called. This parameter may be an array, with the name of the class, and the method, or a string, with a function name. </p> Zero or more parameters to be passed to the function. </p> /","params":[{"name":"callback","declared_type":"callable","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"forward_static_call_array","fqn":"forward_static_call_array","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":3753,"end":3778}},"declared_type":null,"signature":{"parameters":[{"name":"callback","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"doc