anged in Imagick 3.0.0. Before this version given dimensions 400x400 an image of dimensions 200x150 would be left untouched.<br> In Imagick 3.0.0 and later the image would be scaled up to size 400x300 as this is the \"best fit\" for the given dimensions. If bestfit parameter is used both width and height must be given. /","params":[{"name":"columns","declared_type":"int","description":"Width of the image"},{"name":"rows","declared_type":"int","description":"Height of the image"},{"name":"filter","declared_type":"int","description":"Refer to the list of filter constants."},{"name":"blur","declared_type":"float","description":"The blur factor where > 1 is blurry, < 1 is sharp."},{"name":"bestfit","declared_type":"bool","description":"[optional] Added since 2.1.0. Added optional fit parameter. This method now supports proportional scaling. Pass zero as either parameter for proportional scaling"},{"name":"legacy","declared_type":"bool","description":"[optional] Added since 3.4.0. Default value FALSE"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rewind","fqn":"Imagick::rewind","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":178941,"end":178947}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"rollImage","fqn":"Imagick::rollImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":101746,"end":101755}},"declared_type":null,"signature":{"parameters":[{"name":"x","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"y","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_retur