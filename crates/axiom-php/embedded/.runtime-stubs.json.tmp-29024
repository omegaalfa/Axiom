null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRemRangeByScore","fqn":"Redis::zRemRangeByScore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":209055,"end":209071}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Remove one or more members of a sorted set by their score. $redis->zAdd('zs', 2, 'two', 4, 'four', 6, 'six'); $redis->zRemRangeByScore('zs', 2, 4); /","params":[{"name":"key","declared_type":"string","description":"The sorted set where we want to remove members."},{"name":"start","declared_type":"string","description":"The lowest score to remove."},{"name":"end","declared_type":"string","description":"The highest score to remove."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRevRange","fqn":"Redis::zRevRange","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":210051,"end":210060}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"scores","declared_type":"mixed","phpdoc_type":"mixed|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"List the members of a Redis sorted set in reverse order the example below demonstrating how it may be used. on failure. $redis->zRevRange('zs', 0, -1); $redis->zRevRange('zs', 2, 3); $redis->zRevRange('zs', 0, -1, true); $redis->zRevRange('zs', 0, -1, ['withscores' => true]); /","params":[{"name":"key","declared_type":"string","description":"The sorted set in question."},{"name":"start","declared_type":"int","description":"The index to start listing elements"},{"name":"end","declared_type":"int","description":"The index to stop listing elements."},{"name":"scores","declared_type":"mixed|null","description":"Whether or not Redis should also return each members score.  See"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRevRangeByLex","fqn":"Redis::zRevRangeByLex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":210991,"end":211005}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"List members of a Redis sorted set within a legographical range, in reverse order. $redis->zRevRangeByLex('captains', '[Q', '[J'); $redis->zRevRangeByLex('captains', '[Q', '[J', 1, 2); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to list"},{"name":"max","declared_type":"string","description":"The maximum legographical element to include in the result."},{"name":"min","declared_type":"string","description":"The minimum lexographical element to include in the result."},{"name":"offset","declared_type":"int","description":"An option offset within the matching elements to start at."},{"name":"count","declared_type":"int","description":"An optional count to limit the replies to."}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRevRangeByScore","fqn":"Redis::zRevRangeByScore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":212974,"end":212990}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|bool","phpdoc_type":"array|bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"List elements from a Redis sorted set by score, highest to lowest ```php $options = [ 'WITHSCORES' => true|false # Whether or not to return scores 'LIMIT' => [offset, count] # Return a subset of the matching members ]; ``` NOTE: For legacy reason, you may also simply pass `true` for the options argument, to mean `WITHSCORES`. $redis->zadd('oldest-people', 122.4493, 'Jeanne Calment', 119.2932, 'Kane Tanaka', 119.2658, 'Sarah Knauss',   118.7205, 'Lucile Randon', 117.7123, 'Nabi Tajima',    117.6301, 'Marie-Louise Meilleur', 117.5178, 'Violet Brown',   117.3753, 'Emma Morano', 117.2219, 'Chiyo Miyako',   117.0740, 'Misao Okawa'); $redis->zRevRangeByScore('oldest-people', 122, 119); $redis->zRevRangeByScore('oldest-people', 'inf', 118); $redis->zRevRangeByScore('oldest-people', '117.5', '-inf', ['LIMIT' => [0, 1]]); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to query."},{"name":"max","declared_type":"string","description":"The highest score to include in the results."},{"name":"min","declared_type":"string","description":"The lowest score to include in the results."},{"name":"options","declared_type":"array|bool","description":"An options array that modifies how the command executes."}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRevRank","fqn":"Redis::zRevRank","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":213723,"end":213731}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Retrieve a member of a sorted set by reverse rank. false on failure. $redis->zAdd('ds9-characters', 10, 'Sisko', 9, 'Garak', 8, 'Dax', 7, 'Odo'); $redis->zrevrank('ds9-characters', 'Sisko'); $redis->zrevrank('ds9-characters', 'Garak'); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to query."},{"name":"member","declared_type":"mixed","description":"The member to look up."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zscan","fqn":"Redis::zscan","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":221123,"end":221128}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"iterator","declared_type":"null|int|string","phpdoc_type":"int|string|null","optional":false,"variadic":false,"by_reference":true},{"name":"pattern","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Scan the members of a sorted set incrementally, using a cursor will be updated after each subsequent call to ZSCAN.  Once the iterator has returned to zero the scan is complete the scanning process. from the call.  The higher the more work Redis may do in any one given call to ZSCAN potentially blocking for longer periods of time. NOTE:  See Redis::scan() for detailed example code on how to call SCAN like commands. $it = null; while ($members = $redis->zscan('leaders', $it)) { foreach ($members as $member => $score) { printf('%s => %s' . PHP_EOL, $member, $score); } } /","params":[{"name":"key","declared_type":"string","description":"The sorted set to scan."},{"name":"iterator","declared_type":"int|string|null","description":"A reference to an iterator that should be initialized to NULL initially, that"},{"name":"pattern","declared_type":"string|null","description":"An optional glob-style pattern that limits which members are returned during"},{"name":"count","declared_type":"int","description":"A hint for Redis that tells it how many elements it should test before returning"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zScore","fqn":"Redis::zScore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":214294,"end":214300}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|float|false","phpdoc_return_type":"Redis|float|false"},"documentation":{"description":"Get the score of a member of a sorted set. $redis->zAdd('telescopes', 11.9, 'LBT', 10.4, 'GTC', 10, 'HET'); $redis->zScore('telescopes', 'LBT'); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to query."},{"name":"member","declared_type":"mixed","description":"The member we wish to query."}],"return_type":"Redis|float|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zSize","fqn":"Redis::zSize","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":6236,"end":6241}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zUnion","fqn":"Redis::zUnion","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":14996,"end":15002}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":null,"phpdoc_type":"mixed|null","optional":true,"variadic":false,"by_reference":false},{"name":"aggregate","declared_type":null,"phpdoc_type":"mixed|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"mixed","description":null},{"name":"keys","declared_type":"mixed","description":null},{"name":"weights","declared_type":"mixed|null","description":null},{"name":"aggregate","declared_type":"mixed|null","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zunion","fqn":"Redis::zunion","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":223197,"end":223203}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Retrieve the union of one or more sorted sets Note that if this argument is passed, it must contain the same number of elements as the $keys array. ```php $options = [ # By default when members exist in more than one set Redis will SUM # total score for each match.  Instead, it can return the AVG, MIN, # or MAX value based on this option. 'AGGREGATE' => 'sum' | 'min' | 'max' # Whether Redis should also return each members aggregated score. 'WITHSCORES' => true | false ] ``` $redis->del('store1', 'store2', 'store3'); $redis->zAdd('store1', 1, 'apples', 3, 'pears', 6, 'bananas'); $redis->zAdd('store2', 3, 'apples', 5, 'coconuts', 2, 'bananas'); $redis->zAdd('store3', 2, 'bananas', 6, 'apples', 4, 'figs'); $redis->zUnion(['store1', 'store2', 'store3'], NULL, ['withscores' => true]); $redis->zUnion(['store1', 'store3'], [2, .5], ['withscores' => true]); $redis->zUnion(['store1', 'store3'], [2, .5], ['withscores' => true, 'aggregate' => 'MIN']); /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted set key names"},{"name":"weights","declared_type":"array|null","description":"An optional array with floating point weights used when performing the union."},{"name":"options","declared_type":"array|null","description":"An array that modifies how this command functions."}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zunionstore","fqn":"Redis::zunionstore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":224306,"end":224317}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"aggregate","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Perform a union on one or more Redis sets and store the result in a destination sorted set. Valid:  'MIN', 'MAX', 'SUM'. $redis->zAdd('zs1', 1, 'one', 3, 'three'); $redis->zAdd('zs1', 2, 'two', 4, 'four'); $redis->zadd('zs3', 1, 'one', 7, 'five'); $redis->zUnionStore('dst', ['zs1', 'zs2', 'zs3']); /","params":[{"name":"dst","declared_type":"string","description":"The destination set to store the union."},{"name":"keys","declared_type":"array","description":"One or more input keys on which to perform our union."},{"name":"weights","declared_type":"array|null","description":"An optional weights array used to weight each input set."},{"name":"aggregate","declared_type":"string|null","description":"An optional modifier in how Redis will combine duplicate members."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__call","fqn":"RedisArray::__call","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisArray.php","range":{"start":5991,"end":5997}},"declared_type":null,"signature":{"parameters":[{"name":"function_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"arguments","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"RedisArray::__construct","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisArray.php","range":{"start":420,"end":431}},"declared_type":null,"signature":{"parameters":[{"name":"name_or_hosts","declared_type":"string|array","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_refer