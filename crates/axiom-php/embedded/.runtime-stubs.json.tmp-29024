y_reference":false},{"name":"handler","declared_type":null,"phpdoc_type":"callable|int","optional":false,"variadic":false,"by_reference":false},{"name":"restart_syscalls","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Installs a signal handler The signal number. </p> The signal handler. This may be either a callable, which will be invoked to handle the signal, or either of the two global constants <b>SIG_IGN</b> or <b>SIG_DFL</b>, which will ignore the signal or restore the default signal handler respectively. </p> <p> If a callable is given, it must implement the following signature: </p> <p> void<b>handler</b> <b>int<i>signo</i></b> <i>signo</i> The signal being handled.</p> Specifies whether system call restarting should be used when this signal arrives. </p> /","params":[{"name":"signal","declared_type":"int","description":"<p>"},{"name":"handler","declared_type":"callable|int","description":"<p>"},{"name":"restart_syscalls","declared_type":"bool","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_signal_dispatch","fqn":"pcntl_signal_dispatch","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":5608,"end":5629}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Calls signal handlers for pending signals /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_signal_get_handler","fqn":"pcntl_signal_get_handler","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":15905,"end":15929}},"declared_type":null,"signature":{"parameters":[{"name":"signal","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool|resource"},"documentation":{"description":"Get the current handler for specified signal. The signal number. </p> /","params":[{"name":"signal","declared_type":"int","description":"<p>"}],"return_type":"bool|resource","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_sigprocmask","fqn":"pcntl_sigprocmask","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":13165,"end":13182}},"declared_type":null,"signature":{"parameters":[{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"signals","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"old_signals","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Sets and retrieves blocked signals Sets the behavior of <b>pcntl_sigprocmask</b>. Possible values: <b>SIG_BLOCK</b>: Add the signals to the currently blocked signals. <b>SIG_UNBLOCK</b>: Remove the signals from the currently blocked signals. <b>SIG_SETMASK</b>: Replace the currently blocked signals by the given list of signals. </p> List of signals. </p> The <i>old_signals</i> parameter is set to an array containing the list of the previously blocked signals. </p> /","params":[{"name":"mode","declared_type":"int","description":"<p>"},{"name":"signals","declared_type":"array","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_sigtimedwait","fqn":"pcntl_sigtimedwait","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":14960,"end":14978}},"declared_type":null,"signature":{"parameters":[{"name":"signals","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"info","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"seconds","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"nanoseconds","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Waits for signals, with a timeout Array of signals to wait for. </p> The <i>siginfo</i> is set to an array containing informations about the signal. See <b>pcntl_sigwaitinfo</b>. </p> Timeout in seconds. </p> Timeout in nanoseconds. </p> /","params":[{"name":"signals","declared_type":"array","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"seconds","declared_type":"int","description":"[optional] <p>"},{"name":"nanoseconds","declared_type":"int","description":"[optional] <p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_sigwaitinfo","fqn":"pcntl_sigwaitinfo","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":14323,"end":14340}},"declared_type":null,"signature":{"parameters":[{"name":"signals","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"info","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Waits for signals Array of signals to wait for. </p> The <i>info</i> parameter is set to an array containing informations about the signal. </p> <p> The following elements are set for all signals: signo: Signal number errno: An error number code: Signal code </p> <p> The following elements may be set for the <b>SIGCHLD</b> signal: status: Exit value or signal utime: User time consumed stime: System time consumed pid: Sending process ID uid: Real user ID of sending process </p> <p> The following elements may be set for the <b>SIGILL</b>, <b>SIGFPE</b>, <b>SIGSEGV</b> and <b>SIGBUS</b> signals: addr: Memory location which caused fault </p> <p> The following element may be set for the <b>SIGPOLL</b> signal: band: Band event fd: File descriptor number </p> /","params":[{"name":"signals","declared_type":"array","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_strerror","fqn":"pcntl_strerror","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":10863,"end":10877}},"declared_type":null,"signature":{"parameters":[{"name":"error_code","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Retrieve the system error message associated with the given errno </p> /","params":[{"name":"error_code","declared_type":"int","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_unshare","fqn":"pcntl_unshare","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":16402,"end":16415}},"declared_type":null,"signature":{"parameters":[{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Dissociates parts of the process execution context pcntl_unshare allows a process to disassociate parts of its execution context that are currently being shared with other processes. The main use of pcntl_unshare is to allow a process to control its shared execution context without creating a new process. /","params":[{"name":"flags","declared_type":"int","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_wait","fqn":"pcntl_wait","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":4330,"end":4340}},"declared_type":null,"signature":{"parameters":[{"name":"status","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"resource_usage","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Waits on or returns the status of a forked child <b>pcntl_wait</b> will store status information in the <i>status</i> parameter which can be evaluated using the following functions: <b>pcntl_wifexited</b>, <b>pcntl_wifstopped</b>, <b>pcntl_wifsignaled</b>, <b>pcntl_wexitstatus</b>, <b>pcntl_wtermsig</b> and <b>pcntl_wstopsig</b>. </p> If wait3 is available on your system (mostly BSD-style systems), you can provide the optional <i>flags</i> parameter. If this parameter is not provided, wait will be used for the system call. If wait3 is not available, providing a value for <i>flags </i> will have no effect. The value of <i>flags </i> is the value of zero or more of the following two constants OR'ed together: <table> Possible values for <i>flags</i> <tr valign=\"top\"> <td>WNOHANG</td> <td> Return immediately if no child has exited. </td> </tr> <tr valign=\"top\"> <td>WUNTRACED</td> <td> Return for children which are stopped, and whose status has not been reported. </td> </tr> </table> </p> child which exited, -1 on error or zero if WNOHANG was provided as an option (on wait3-available systems) and no child was available. /","params":[{"name":"","declared_type":null,"description":null},{"name":"flags","declared_type":"int","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_waitid","fqn":"pcntl_waitid","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":16710,"end":16722}},"declared_type":null,"signature":{"parameters":[{"name":"idtype","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"id","declared_type":"?int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"info","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"flags","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"resource_usage","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"bool","phpdoc_return_type":null},"documentation":{"description":"Waits for a child process to change state Obtains status information pertaining to termination, stop, and/or continue events in one of the caller's child processes. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_waitpid","fqn":"pcntl_waitpid","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":2698,"end":2711}},"declared_type":null,"signature":{"parameters":[{"name":"process_id","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"status","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"resource_usage","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Waits on or returns the status of a forked child The value of <i>pid</i> can be one of the following: <table> possible values for <i>pid</i> <tr valign=\"top\"> <td>&lt; -1</td> <td> wait for any child process whose process group ID is equal to the absolute value of <i>pid</i>. </td> </tr> <tr valign=\"top\"> <td>-1</td> <td> wait for any child process; this is the same behaviour that the wait function exhibits. </td> </tr> <tr valign=\"top\"> <td>0</td> <td> wait for any child process whose process group ID is equal to that of the calling process. </td> </tr> <tr valign=\"top\"> <td>&gt; 0</td> <td> wait for the child whose process ID is equal to the value of <i>pid</i>. </td> </tr> </table> </p> <p> Specifying -1 as the <i>pid</i> is equivalent to the functionality <b>pcntl_wait</b> provides (minus <i>options</i>). </p> <b>pcntl_waitpid</b> will store status information in the <i>status</i> parameter which can be evaluated using the following functions: <b>pcntl_wifexited</b>, <b>pcntl_wifstopped</b>, <b>pcntl_wifsignaled</b>, <b>pcntl_wexitstatus</b>, <b>pcntl_wtermsig</b> and <b>pcntl_wstopsig</b>. </p> The value of <i>options</i> is the value of zero or more of the following two global constants OR'ed together: <table> possible values for <i>options</i> <tr valign=\"top\"> <td>WNOHANG</td> <td> return immediately if no child has exited. </td> </tr> <tr valign=\"top\"> <td>WUNTRACED</td> <td> return for children which are stopped, and whose status has not been reported. </td> </tr> </table> </p> child which exited, -1 on error or zero if <b>WNOHANG</b> was used and no child was available /","params":[{"name":"process_id","declared_type":"int","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"flags","declared_type":"int","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_wexitstatus","fqn":"pcntl_wexitstatus","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":7328,"end":7345}},"declared_type":null,"signature":{"parameters":[{"name":"status","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Returns the return code of a terminated child parameter is the status parameter supplied to a successful call to <b>pcntl_waitpid</b>.</p> /","params":[{"name":"status","declared_type":"int","description":"<p>The <i>status</i>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pcntl_wifcontinued","fqn":"pcntl_wifcontinued","kind":"Function","origin":"PhpRuntime","extension":"pcntl","location":{"file":"pcntl/pcntl.php","range":{"start":7802,"end":7820}},"declared_type":null,"signature":{"parameters":[{"name":"status","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool"