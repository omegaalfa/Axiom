e":false},{"name":"dest_width","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"threshold","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Convert JPEG image file to WBMP image file Path to JPEG file. </p> Path to destination WBMP file. </p> Destination image height. </p> Destination image width. </p> Threshold value, between 0 and 8 (inclusive). </p> /","params":[{"name":"jpegname","declared_type":"string","description":"<p>"},{"name":"wbmpname","declared_type":"string","description":"<p>"},{"name":"dest_height","declared_type":"int","description":"<p>"},{"name":"dest_width","declared_type":"int","description":"<p>"},{"name":"threshold","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"json_decode","fqn":"json_decode","kind":"Function","origin":"PhpRuntime","extension":"json","location":{"file":"json/json.php","range":{"start":4900,"end":4911}},"declared_type":null,"signature":{"parameters":[{"name":"json","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"associative","declared_type":"?bool","phpdoc_type":"bool|null","optional":true,"variadic":false,"by_reference":false},{"name":"depth","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"(PHP 5 &gt;= 5.2.0, PECL json &gt;= 1.2.0)<br/> Takes a JSON encoded string and converts it into a PHP value. The <i>json</i> string being decoded. </p> <p> This function only works with UTF-8 encoded strings. </p> <p>PHP implements a superset of JSON as specified by <a href=\"https://datatracker.ietf.org/doc/html/rfc7159\">RFC 7159</a>. </p> When <b>TRUE</b>, JSON objects will be returned as associative arrays; when <b>FALSE</b>, JSON objects will be returned as objects. When <b>NULL</b>, JSON objects will be returned as associative arrays or objects depending on whether JSON_OBJECT_AS_ARRAY is set in the flags. </p> Maximum nesting depth of the structure being decoded. The value must be greater than 0, and less than or equal to 2147483647. </p> Bitmask of JSON decode options:<br/> {@see JSON_BIGINT_AS_STRING} decodes large integers as their original string value.<br/> {@see JSON_INVALID_UTF8_IGNORE} ignores invalid UTF-8 characters, {@see JSON_INVALID_UTF8_SUBSTITUTE} converts invalid UTF-8 characters to \\0xfffd, Available as of PHP 7.2.0. {@see JSON_OBJECT_AS_ARRAY} Decodes JSON objects as PHP array. This option can be added automatically by calling json_decode() with the second parameter equal to true. {@see JSON_THROW_ON_ERROR} Throws JsonException if an error occurs instead of setting the global error state that is retrieved with json_last_error() and json_last_error_msg(). JSON_PARTIAL_OUTPUT_ON_ERROR takes precedence over JSON_THROW_ON_ERROR. Available as of PHP 7.3.0.<br/> </p> and <b>NULL</b> are returned as <b>TRUE</b>, <b>FALSE</b> and <b>NULL</b> respectively. <b>NULL</b> is returned if the <i>json</i> cannot be decoded or if the encoded data is deeper than the nesting limit. 8.0.0, while previously, an error of level E_WARNING was raised. /","params":[{"name":"json","declared_type":"string","description":"<p>"},{"name":"associative","declared_type":"bool|null","description":"<p>"},{"name":"depth","declared_type":"int","description":"[optional] <p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"mixed","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"json_encode","fqn":"json_encode","kind":"Function","origin":"PhpRuntime","extension":"json","location":{"file":"json/json.php","range":{"start":2536,"end":2547}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"depth","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"(PHP 5 &gt;= 5.2.0, PECL json &gt;= 1.2.0)<br/> Returns the JSON representation of a value The <i>value</i> being encoded. Can be any type except a resource. </p> <p> All string data must be UTF-8 encoded. </p> <p>PHP implements a superset of JSON - it will also encode and decode scalar types and <b>NULL</b>. The JSON standard only supports these values when they are nested inside an array or an object. </p> Bitmask consisting of <b>JSON_HEX_QUOT</b>, <b>JSON_HEX_TAG</b>, <b>JSON_HEX_AMP</b>, <b>JSON_HEX_APOS</b>, <b>JSON_NUMERIC_CHECK</b>, <b>JSON_PRETTY_PRINT</b>, <b>JSON_UNESCAPED_SLASHES</b>, <b>JSON_FORCE_OBJECT</b>, <b>JSON_UNESCAPED_UNICODE</b>. <b>JSON_THROW_ON_ERROR</b> The behaviour of these constants is described on the JSON constants page. </p> Set the maximum depth. Must be greater than zero. </p> /","params":[{"name":"value","declared_type":"mixed","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"},{"name":"depth","declared_type":"int","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"json_last_error","fqn":"json_last_error","kind":"Function","origin":"PhpRuntime","extension":"json","location":{"file":"json/json.php","range":{"start":7466,"end":7481}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Returns the last error occurred constants: <table class='doctable table'> <thead> <tr> <th>Constant</th> <th>Meaning</th> <th>Availability</th> </tr> </thead> <tbody class='tbody'> <tr> <td><strong><code>JSON_ERROR_NONE</code></strong></td> <td>No error has occurred</td> <td class='empty'>&nbsp;</td> </tr> <tr> <td><strong><code>JSON_ERROR_DEPTH</code></strong></td> <td>The maximum stack depth has been exceeded</td> <td class='empty'>&nbsp;</td> </tr> <tr> <td><strong><code>JSON_ERROR_STATE_MISMATCH</code></strong></td> <td>Invalid or malformed JSON</td> <td class='empty'>&nbsp;</td> </tr> <tr> <td><strong><code>JSON_ERROR_CTRL_CHAR</code></strong></td> <td>Control character error, possibly incorrectly encoded</td> <td class='empty'>&nbsp;</td> </tr> <tr> <td><strong><code>JSON_ERROR_SYNTAX</code></strong></td> <td>Syntax error</td> <td class='empty'>&nbsp;</td> </tr> <tr> <td><strong><code>JSON_ERROR_UTF8</code></strong></td> <td>Malformed UTF-8 characters, possibly incorrectly encoded</td> <td>PHP 5.3.3</td> </tr> <tr> <td><strong><code>JSON_ERROR_RECURSION</code></strong></td> <td>One or more recursive references in the value to be encoded</td> <td>PHP 5.5.0</td> </tr> <tr> <td><strong><code>JSON_ERROR_INF_OR_NAN</code></strong></td> <td> One or more <a href='language.types.float.php#language.types.float.nan' class='link'><strong><code>NAN</code></strong></a> or <a href='function.is-infinite.php' class='link'><strong><code>INF</code></strong></a> values in the value to be encoded </td> <td>PHP 5.5.0</td> </tr> <tr> <td><strong><code>JSON_ERROR_UNSUPPORTED_TYPE</code></strong></td> <td>A value of a type that cannot be encoded was given</td> <td>PHP 5.5.0</td> </tr> <tr> <td><strong><code>JSON_ERROR_INVALID_PROPERTY_NAME</code></strong></td> <td>A property name that cannot be encoded was given</td> <td>PHP 7.0.0</td> </tr> <tr> <td><strong><code>JSON_ERROR_UTF16</code></strong></td> <td>Malformed UTF-16 characters, possibly incorrectly encoded</td> <td>PHP 7.0.0</td> </tr> </tbody> </table> /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"json_last_error_msg","fqn":"json_last_error_msg","kind":"Function","origin":"PhpRuntime","extension":"json","location":{"file":"json/json.php","range":{"start":7826,"end":7845}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Returns the error string of the last json_encode() or json_decode() call, which did not specify <b>JSON_THROW_ON_ERROR</b>. /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"json_validate","fqn":"json_validate","kind":"Function","origin":"PhpRuntime","extension":"json","location":{"file":"json/json.php","range":{"start":8334,"end":8347}},"declared_type":null,"signature":{"parameters":[{"name":"json","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"depth","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":null},"documentation":{"description":"Checks if a string contains valid JSON Returns whether the given string is syntactically valid JSON. If json_validate returns true, json_decode will successfully decode the given string when using the same depth and flags. not a valid flag, a ValueError is thrown. /","params":[],"return_type":null,"var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"unti