.php.net/manual/en/mongocursor.timeout.php MongoCursor::timeout()}. This does not cause the MongoDB server to cancel the operation; it only instructs the driver to stop waiting for a response and throw a {@link https://php.net/manual/en/class.mongocursortimeoutexception.php MongoCursorTimeoutException} after a set time. </p> /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sec","fqn":"MongoDate::sec","kind":"Property","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":95837,"end":95841}},"declared_type":null,"signature":null,"documentation":{"description":"/","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"usec","fqn":"MongoDate::usec","kind":"Property","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":95967,"end":95972}},"declared_type":null,"signature":null,"documentation":{"description":"/","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"w","fqn":"MongoDB::w","kind":"Property","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":25633,"end":25635}},"declared_type":null,"signature":null,"documentation":{"description":"<p> The number of servers to replicate a change to before returning success. Inherited by instances of {@link https://php.net/manual/en/class.mongocollection.php MongoCollection} derived from this.  <em>w</em> functionality is only available in version 1.5.1+ of the MongoDB server and 1.0.8+ of the driver. </p> <p> <em>w</em> is used whenever you need to adjust the acknowledgement level ( {@link https://php.net/manual/en/mongocollection.insert.php MongoCollection::insert()}, {@link https://php.net/manual/en/mongocollection.update.php MongoCollection::update()}, {@link https://php.net/manual/en/mongocollection.remove.php MongoCollection::remove()}, {@link https://php.net/manual/en/mongocollection.save.php MongoCollection::save()}, and {@link https://php.net/manual/en/mongocollection.ensureindex.php MongoCollection::ensureIndex()} all support this option). With the default value (1), an acknowledged operation will return once the database server has the operation. If the server goes down before the operation has been replicated to a secondary, it is possible to lose the operation forever. Thus, you can specify <em>w</em> to be higher than one and guarantee that at least one secondary has the operation before it is considered successful. </p> <p> For example, if <em>w</em> is 2, the primary and one secondary must have a record of the operation or the driver will throw a {@link https://php.net/manual/en/class.mongocursorexception.php MongoCursorException}. It is tempting to set <em>w</em> to the total number of secondaries + primary, but then if one secondary is down the operation will fail and an exception will be thrown, so usually <em>w=2</em> is safest (primary and one secondary). </p> /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wtimeout","fqn":"MongoDB::wtimeout","kind":"Property","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":26318,"end":26327}},"declared_type":null,"signature":null,"documentation":{"description":"T he number of milliseconds to wait for <em>MongoDB::$w</em> replications to take place.  Inherited by instances of {@link https://secure.php.net/manual/en/class.mongocollection.php MongoCollection} derived from this. <em>w</em> functionality is only available in version 1.5.1+ of the MongoDB server and 1.0.8+ of the driver. </p> <p> Unless <em>wtimeout</em> is set, the server waits forever for replicating to <em>w</em> servers to finish.  The driver defaults to waiting for 10 seconds, you can change this value to alter its behavior. </p> /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"idKey","fqn":"MongoDBRef::idKey","kind":"Property","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":98765,"end":98771}},"declared_type":null,"signature":null,"documentation":{"description":"/","params":[],"return_type":null,"var_type":"string","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"refKey","fqn":"MongoDBRef::refKey","kind":"Property","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":98690,"end":98697}},"declared_type":null,"signature":null,"documentation":{"description":"/","params":[],"return_type":null,"var_type":"string","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"chunks","fqn":"MongoGridFS::chunks","kind":"Property","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":83344,"end":83351}},"declared_type":null,"signature":null,"documentation":{"description":"/","params":[],"return_type":null,"var_type":"MongoCollection","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"chunksName","fqn":"MongoGridFS::chunksName","kind":"Property","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":83644,"end":83655}},"declared_type":null,"signature":null,"documentation":{"description":"/","params":[],"return_type":null,"var_type":"string","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"filesName","fqn":"MongoGridFS::filesName","kind":"Property","origin":"PhpRuntime","extension":"mongo","location":{"file