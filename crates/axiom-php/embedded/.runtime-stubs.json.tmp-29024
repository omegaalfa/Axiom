s. Returns MS_SUCCESS or MS_FAILURE. ex layer->moveclassup(1) will have the effect of moving class 1 up to position 0, and the class at position 0 will be moved to position 1. /","params":[{"name":"index","declared_type":"int","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ms_newLayerObj","fqn":"layerObj::ms_newLayerObj","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":30823,"end":30837}},"declared_type":null,"signature":{"parameters":[{"name":"map","declared_type":"mapObj","phpdoc_type":"mapObj","optional":false,"variadic":false,"by_reference":false},{"name":"layer","declared_type":"layerObj","phpdoc_type":"layerObj","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"layerObj"},"documentation":{"description":"Old style constructor /","params":[{"name":"map","declared_type":"mapObj","description":null},{"name":"layer","declared_type":"layerObj","description":null}],"return_type":"layerObj","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"nextShape","fqn":"layerObj::nextShape","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":40289,"end":40298}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"shapeObj"},"documentation":{"description":"Called after msWhichShapes has been called to actually retrieve shapes within a given area. Returns a shape object or NULL on error. .. code-block:: php $map = ms_newmapobj(\"d:/msapps/gmap-ms40/htdocs/gmap75.map\"); $layer = $map->getLayerByName('road'); $status = $layer->open(); $status = $layer->whichShapes($map->extent); while ($shape = $layer->nextShape()) { echo $shape->index .\"<br>\\n\"; } $layer->close(); /","params":[],"return_type":"shapeObj","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"open","fqn":"layerObj::open","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":39701,"end":39705}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Open the layer for use with getShape(). Returns MS_SUCCESS/MS_FAILURE. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByAttributes","fqn":"layerObj::queryByAttributes","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":41287,"end":41304}},"declared_type":null,"signature":{"parameters":[{"name":"qitem","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"qstring","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Query layer for shapes that intersect current map extents.  qitem is the item (attribute) on which the query is performed, and qstring is the expression to match.  The query is performed on all the shapes that are part of a :ref:`CLASS` that contains a :ref:`TEMPLATE <template>` value or that match any class in a layer that contains a :ref:`LAYER` :ref:`TEMPLATE <template>` value.  Note that the layer's FILTER/FILTERITEM are ignored by this function.  Mode is MS_SINGLE or MS_MULTIPLE depending on number of results you want.  Returns MS_SUCCESS if shapes were found or MS_FAILURE if nothing was found or if some other error happened (note that the error message in case nothing was found can be avoided in PHP using the '@' control operator). /","params":[{"name":"qitem","declared_type":"string","description":null},{"name":"qstring","declared_type":"string","description":null},{"name":"mode","declared_type":"int","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByFeatures","fqn":"layerObj::queryByFeatures","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":41826,"end":41841}},"declared_type":null,"signature":{"parameters":[{"name":"slayer","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Perform a query set based on a previous set of results from another layer. At present the results MUST be based on a polygon layer. Returns MS_SUCCESS if shapes were found or MS_FAILURE if nothing was found or if some other error happened (note that the error message in case nothing was found can be avoided in PHP using the '@' control operator). /","params":[{"name":"slayer","declared_type":"int","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByPoint","fqn":"layerObj::queryByPoint","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":42800,"end":42812}},"declared_type":null,"signature":{"parameters":[{"name":"point","declared_type":"pointObj","phpdoc_type":"pointObj","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"buffer","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Query layer at point location specified in georeferenced map coordinates (i.e. not pixels). The query is performed on all the shapes that are part of a CLASS that contains a TEMPLATE value or that match any class in a layer that contains a LAYER TEMPLATE value. Mode is MS_SINGLE or MS_MULTIPLE depending on number of results you want. Passing buffer -1 defaults to tolerances set in the map file (in pixels) but you can use a constant buffer (specified in ground units) instead. Returns MS_SUCCESS if shapes were found or MS_FAILURE if nothing was found or if some other error happened (note that the error message in case nothing was found can be avoided in PHP using the '@' control operator). /","params":[{"name":"point","declared_type":"pointObj","description":null},{"name":"mode","declared_type":"int","description":null},{"name":"buffer","declared_type":"float","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByRect","fqn":"layerObj::queryByRect","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":43488,"end":43499}},"declared_type":null,"signature":{"parameters":[{"name":"rect","declared_type":"rectObj","phpdoc_type":"rectObj","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Query layer using a rectangle specified in georeferenced map coordinates (i.e. not pixels). The query is performed on all the shapes that are part of a CLASS that contains a TEMPLATE value or that match any class in a layer that contains a LAYER TEMPLATE value. Returns MS_SUCCESS if shapes were found or MS_FAILURE if nothing was found or if some other error happened (note that the error message in case nothing was found can be avoided in PHP using the '@' control operator). /","params":[{"name":"rect","declared_type":"rectObj","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryByShape","fqn":"layerObj::queryByShape","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":43958,"end":43970}},"declared_type":null,"signature":{"parameters":[{"name":"shape","declared_type":"shapeObj","phpdoc_type":"shapeObj","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Query layer based on a single shape, the shape has to be a polygon at this point. Returns MS_SUCCESS if shapes were found or MS_FAILURE if nothing was found or if some other error happened (note that the error message in case nothing was found can be avoided in PHP using the '@' control operator). /","params":[{"name":"shape","declared_type":"shapeObj","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"removeClass","fqn":"layerObj::removeClass","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":44336,"end":44347}},"declared_type":null,"signature":{"parameters":[{"name":"index","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"classObj|null"},"documentation":{"description":"Removes the class indicated and returns a copy, or NULL in the case of a failure.  Note that subsequent classes will be renumbered by this operation. The numclasses field contains the number of classes available. /","params":[{"name":"index","declared_type":"int","descripti