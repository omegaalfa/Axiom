:null,"phpdoc_type":"Odbc\\Result|resource","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Handling of binary column data The result identifier. </p> <p> If <i>result_id</i> is 0, the settings apply as default for new results. Default for longreadlen is 4096 and <i>mode</i> defaults to ODBC_BINMODE_RETURN. Handling of binary long columns is also affected by <b>odbc_longreadlen</b>. </p> Possible values for <i>mode</i> are: <b>ODBC_BINMODE_PASSTHRU</b>: Passthru BINARY data </p> /","params":[{"name":"statement","declared_type":"Odbc\\Result|resource","description":"<p>"},{"name":"mode","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_close","fqn":"odbc_close","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":2147,"end":2157}},"declared_type":null,"signature":{"parameters":[{"name":"odbc","declared_type":null,"phpdoc_type":"Odbc\\Connection|resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Close an ODBC connection see <b>odbc_connect</b> for details.</p> /","params":[{"name":"odbc","declared_type":"Odbc\\Connection|resource","description":"<p>The ODBC connection identifier,"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_close_all","fqn":"odbc_close_all","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":2401,"end":2415}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Close all ODBC connections /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_columnprivileges","fqn":"odbc_columnprivileges","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":28597,"end":28618}},"declared_type":null,"signature":{"parameters":[{"name":"odbc","declared_type":null,"phpdoc_type":"Odbc\\Connection|resource","optional":false,"variadic":false,"by_reference":false},{"name":"catalog","declared_type":"?string","phpdoc_type":"string|null","optional":false,"variadic":false,"by_reference":false},{"name":"schema","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"table","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"column","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Odbc\\Result|resource|false"},"documentation":{"description":"Lists columns and associated privileges for the given table see <b>odbc_connect</b> for details.</p> The qualifier. </p> The owner. </p> The table name. </p> The <i>column_name</i> argument accepts search patterns ('%' to match zero or more characters and '_' to match a single character). </p> This result identifier can be used to fetch a list of columns and associated privileges. <p> The result set has the following columns: TABLE_QUALIFIER TABLE_OWNER TABLE_NAME GRANTOR GRANTEE PRIVILEGE IS_GRANTABLE </p> <p> The result set is ordered by TABLE_QUALIFIER, TABLE_OWNER and TABLE_NAME. </p> /","params":[{"name":"odbc","declared_type":"Odbc\\Connection|resource","description":"<p>The ODBC connection identifier,"},{"name":"catalog","declared_type":"string|null","description":"<p>"},{"name":"schema","declared_type":"string","description":"<p>"},{"name":"table","declared_type":"string","description":"<p>"},{"name":"column","declared_type":"string","description":"<p>"}],"return_type":"Odbc\\Result|resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_columns","fqn":"odbc_columns","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":3441,"end":3453}},"declared_type":null,"signature":{"parameters":[{"name":"odbc","declared_type":null,"phpdoc_type":"Odbc\\Connection|resource","optional":false,"variadic":false,"by_reference":false},{"name":"catalog","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"schema","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"table","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"column","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Odbc\\Result|resource|false"},"documentation":{"description":"Lists the column names in specified tables see <b>odbc_connect</b> for details.</p> The qualifier. </p> The owner. </p> The table name. </p> The column name. </p> <p> The result set has the following columns: TABLE_QUALIFIER TABLE_SCHEM TABLE_NAME COLUMN_NAME DATA_TYPE TYPE_NAME PRECISION LENGTH SCALE RADIX NULLABLE REMARKS </p> <p> The result set is ordered by TABLE_QUALIFIER, TABLE_SCHEM and TABLE_NAME. </p> /","params":[{"name":"odbc","declared_type":"Odbc\\Connection|resource","description":"<p>The ODBC connection identifier,"},{"name":"catalog","declared_type":"string|null","description":"[optional] <p>"},{"name":"schema","declared_type":"string|null","description":"[optional] <p>"},{"name":"table","declared_type":"string|null","description":"[optional] <p>"},{"name":"column","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"Odbc\\Result|resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_commit","fqn":"odbc_commit","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":3933,"end":3944}},"declared_type":null,"signature":{"parameters":[{"name":"odbc","declared_type":null,"phpdoc_type":"Odbc\\Connection|resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Commit an ODBC transaction see <b>odbc_connect</b> for details.</p> /","params":[{"name":"odbc","declared_type":"Odbc\\Connection|resource","description":"<p>The ODBC connection identifier,"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_connect","fqn":"odbc_connect","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":4900,"end":4912}},"declared_type":null,"signature":{"parameters":[{"name":"dsn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"user","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"user","declared_type":"?string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"password","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"password","declared_type":"?string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"cursor_option","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Odbc\\Connection|resource|false"},"documentation":{"description":"Connect to a datasource The database source name for the connection. Alternatively, a DSN-less connection string can be used. </p> The username. </p> The password. </p> This sets the type of cursor to be used for this connection. This parameter is not normally needed, but can be useful for working around problems with some ODBC drivers. </p> <p> The following constants are defined for cursortype: SQL_CUR_USE_IF_NEEDED </p> /","params":[{"name":"dsn","declared_type":"string","description":"<p>"},{"name":"user","declared_type":"string","description":"<p>"},{"name":"password","declared_type":"string","description":"<p>"},{"name":"cursor_option","declared_type":"int","description":"[optional] <p>"}],"return_type":"Odbc\\Connection|resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_connection_string_is_quoted","fqn":"odbc_connection_string_is_quoted","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":36087,"end":36119}},"declared_type":null,"signature":{"parameters":[{"name":"str","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Determines if a string is properly quoted for an ODBC connection string value. ODBC connection string quoting is performed using curly braces, and ending braces within a string must be escaped through repeating them twice, similar to SQL quoting. /","params":[{"name":"str","declared_type":"string","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_connection_string_quote","fqn":"odbc_connection_string_quote","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":37394,"end":37422}},"declared_type":null,"signature":{"parameters":[{"name":"str","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Quotes a value for a connection string, according to ODBC rules. That is, it will be surrounded by quotes, and any ending curly braces will be escaped. This should be done for any connection string values that come from user input. Not doing so can lead to issues with parsing the connection string, or values being injected into the connection string. Note that this function does not check if the string is already quoted, nor if the string needs quoting. For that, call odbc_connection_string_is_quoted() and odbc_connection_string_should_quote(). /","params":[{"name":"str","declared_type":"string","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_connection_string_should_quote","fqn":"odbc_connection_string_should_quote","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":36632,"end":36667}},"declared_type":null,"signature":{"parameters":[{"name":"str","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Determines if a string needs to be quoted for an ODBC connection string value; that is, if it contains special characters. Note that this does not check if the string is already quoted; an already quoted string will contain characters that will make this function return true. You should call odbc_connection_string_is_quoted() to check. /","params":[{"name":"str","declared_type":"string","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_cursor","fqn":"odbc_cursor","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":5512,"end":5523}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"Odbc\\Result|resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Get cursorname The result identifier. </p> /","params":[{"name":"statement","declared_type":"Odbc\\Result|resource","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"odbc_data_source","fqn":"odbc_data_source","kind":"Function","origin":"PhpRuntime","extension":"odbc","location":{"file":"odbc/odbc.php","range":{"start":6285,"end":6301}},"declared_type":null,"signature":{"parameters":[{"name":"odbc","declared_type":null,"phpdoc_type":"Odbc\\Connection|resource","optional":false,"variadic":false,"by_reference":false},{"name":"fetch_type","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false|null","phpdoc_return_type":"array|false|null"},"documentation":{"description":"Returns information about a current connection see <b>odbc_connect</b> for details.</p> The <i>fetch_type</i> can be one of two constant types: <b>SQL_FETCH_FIRST</b>, <b>SQL_FETCH_NEXT</b>. Use <b>SQL_FETCH_FIRST</b> the first time this function is called, thereafter use the <b>SQL_FETCH_NEXT</b>. </p> /","params":[{"name":"odbc","declared_type":"Odbc\\Connection|resource","description":"<p>The ODBC connection identifier,"},{"name":"fetch_type","declared_type":"int","description