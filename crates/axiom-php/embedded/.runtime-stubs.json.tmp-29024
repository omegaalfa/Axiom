sult","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":47588,"end":47605}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"error_code","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"matched_dn","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"error_message","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"referrals","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"controls","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Extract information from result /","params":[{"name":"ldap","declared_type":"resource","description":null},{"name":"result","declared_type":"resource","description":null},{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_read","fqn":"ldap_read","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":12650,"end":12659}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"base","declared_type":"array|string","phpdoc_type":"array|array|string","optional":false,"variadic":false,"by_reference":false},{"name":"filter","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"attributes","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"attributes_only","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"sizelimit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"timelimit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"deref","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"controls","declared_type":null,"phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Read an entry An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The base DN for the directory. </p> An empty filter is not allowed. If you want to retrieve absolutely all information for this entry, use a filter of objectClass=*. If you know which entry types are used on the directory server, you might use an appropriate filter such as objectClass=inetOrgPerson. </p> An array of the required attributes, e.g. array(\"mail\", \"sn\", \"cn\"). Note that the \"dn\" is always returned irrespective of which attributes types are requested. </p> <p> Using this parameter is much more efficient than the default action (which is to return all attributes and their associated values). The use of this parameter should therefore be considered good practice. </p> Should be set to 1 if only attribute types are wanted. If set to 0 both attributes types and attribute values are fetched which is the default behaviour. </p> Enables you to limit the count of entries fetched. Setting this to 0 means no limit. </p> <p> This parameter can NOT override server-side preset sizelimit. You can set it lower though. </p> <p> Some directory server hosts will be configured to return no more than a preset number of entries. If this occurs, the server will indicate that it has only returned a partial results set. This also occurs if you use this parameter to limit the count of fetched entries. </p> Sets the number of seconds how long is spend on the search. Setting this to 0 means no limit. </p> <p> This parameter can NOT override server-side preset timelimit. You can set it lower though. </p> Specifies how aliases should be handled during the search. It can be one of the following: <b>LDAP_DEREF_NEVER</b> - (default) aliases are never dereferenced.</p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"base","declared_type":"array|array|string","description":"<p>"},{"name":"filter","declared_type":"array|string","description":"<p>"},{"name":"attributes","declared_type":"array","description":"<p>"},{"name":"attributes_only","declared_type":"int","description":"<p>"},{"name":"sizelimit","declared_type":"int","description":"[optional] <p>"},{"name":"timelimit","declared_type":"int","description":"[optional] <p>"},{"name":"deref","declared_type":"int","description":"<p>"},{"name":"controls","declared_type":"array|null","description":"Array of LDAP Controls to send with the request."}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_rename","fqn":"ldap_rename","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":39730,"end":39741}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"dn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"new_rdn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"new_parent","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"delete_old_rdn","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false},{"name":"controls","declared_type":null,"phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Modify the name of an entry An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The distinguished name of an LDAP entity. </p> The new RDN. </p> The new parent/superior entry. </p> If <b>TRUE</b> the old RDN value(s) is removed, else the old RDN value(s) is retained as non-distinguished values of the entry. </p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"dn","declared_type":"string","description":"<p>"},{"name":"new_rdn","declared_type":"string","description":"<p>"},{"name":"new_parent","declared_type":"string","description":"<p>"},{"name":"delete_old_rdn","declared_type":"bool","description":"<p>"},{"name":"controls","declared_type":"array|null","description":"Array of LDAP Controls to send with the request."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_rename_ext","fqn":"ldap_rename_ext","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":40942,"end":40957}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"dn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"new_rdn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"new_parent","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"delete_old_rdn","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false},{"name":"controls","declared_type":null,"phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Modify the name of an entry Does the same thing as ldap_rename() but returns the LDAP result resource to be parsed with ldap_parse_result(). An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The distinguished name of an LDAP entity. </p> The new RDN. </p> The new parent/superior entry. </p> If <b>TRUE</b> the old RDN value(s) is removed, else the old RDN value(s) is retained as non-distinguished values of the entry. </p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"dn","declared_type":"string","description":"<p>"},{"name":"new_rdn","declared_type":"string","description":"<p>"},{"name":"new_parent","declared_type":"string","description":"<p>"},{"name":"delete_old_rdn","declared_type":"bool","description":"<p>"},{"name":"controls","declared_type":"array|null","description":"Array of LDAP Controls to send with the request."}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_sasl_bind","fqn":"ldap_sasl_bind","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":9547,"end":9561}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_