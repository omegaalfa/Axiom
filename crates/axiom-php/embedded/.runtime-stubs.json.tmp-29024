escription":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"filter_has_var","fqn":"filter_has_var","kind":"Function","origin":"PhpRuntime","extension":"filter","location":{"file":"filter/filter.php","range":{"start":6914,"end":6928}},"declared_type":null,"signature":{"parameters":[{"name":"input_type","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"var_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Checks if variable of specified type exists One of <b>INPUT_GET</b>, <b>INPUT_POST</b>, <b>INPUT_COOKIE</b>, <b>INPUT_SERVER</b>, or <b>INPUT_ENV</b>. </p> Name of a variable to check. </p> /","params":[{"name":"input_type","declared_type":"int","description":"<p>"},{"name":"var_name","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"filter_id","fqn":"filter_id","kind":"Function","origin":"PhpRuntime","extension":"filter","location":{"file":"filter/filter.php","range":{"start":7261,"end":7270}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Returns the filter ID belonging to a named filter Name of a filter to get. </p> /","params":[{"name":"name","declared_type":"string","description":"<p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"filter_input","fqn":"filter_input","kind":"Function","origin":"PhpRuntime","extension":"filter","location":{"file":"filter/filter.php","range":{"start":1058,"end":1070}},"declared_type":null,"signature":{"parameters":[{"name":"type","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"var_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"filter","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|int","phpdoc_type":"array|int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Gets a specific external variable by name and optionally filters it One of <b>INPUT_GET</b>, <b>INPUT_POST</b>, <b>INPUT_COOKIE</b>, <b>INPUT_SERVER</b>, or <b>INPUT_ENV</b>. </p> Name of a variable to get. </p> The ID of the filter to apply. The manual page lists the available filters. </p> Associative array of options or bitwise disjunction of flags. If filter accepts options, flags can be provided in \"flags\" field of array. </p> or <b>NULL</b> if the <i>variable_name</i> variable is not set. If the flag <b>FILTER_NULL_ON_FAILURE</b> is used, it returns <b>FALSE</b> if the variable is not set and <b>NULL</b> if the filter fails. /","params":[{"name":"type","declared_type":"int","description":"<p>"},{"name":"var_name","declared_type":"string","description":"<p>"},{"name":"filter","declared_type":"int","description":"[optional] <p>"},{"name":"options","declared_type":"array|int","description":"<p>"}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"filter_input_array","fqn":"filter_input_array","kind":"Function","origin":"PhpRuntime","extension":"filter","location":{"file":"filter/filter.php","range":{"start":4639,"end":4657}},"declared_type":null,"signature":{"parameters":[{"name":"type","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|int","phpdoc_type":"array|int","optional":true,"variadic":false,"by_reference":false},{"name":"add_empty","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false|null","phpdoc_return_type":"array|false|null"},"documentation":{"description":"Gets external variables and optionally filters them One of <b>INPUT_GET</b>, <b>INPUT_POST</b>, <b>INPUT_COOKIE</b>, <b>INPUT_SERVER</b>, or <b>INPUT_ENV</b>. </p> An array defining the arguments. A valid key is a string containing a variable name and a valid value is either a filter type, or an array optionally specifying the filter, flags and options. If the value is an array, valid keys are filter which specifies the filter type, flags which specifies any flags that apply to the filter, and options which specifies any options that apply to the filter. See the example below for a better understanding. </p> <p> This parameter can be also an integer holding a filter constant. Then all values in the input array are filtered by this filter. </p> Add missing keys as <b>NULL</b> to the return value. </p> on failure. An array value will be <b>FALSE</b> if the filter fails, or <b>NULL</b> if the variable is not set. Or if the flag <b>FILTER_NULL_ON_FAILURE</b> is used, it returns <b>FALSE</b> if the variable is not set and <b>NULL</b> if the filter fails. /","params":[{"name":"type","declared_type":"int","description":"<p>"},{"name":"options","declared_type":"array|int","description":"[optional] <p>"},{"name":"add_empty","declared_type":"bool","description":"[optional] <p>"}],"return_type":"array|false|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"filter_list","fqn":"filter_list","kind":"Function","origin":"PhpRuntime","extension":"filter","location":{"file":"filter/filter.php","range":{"start":6462,"end":6473}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Returns a list of all supported filters are no such filters. Indexes of this array are not filter IDs, they can be obtained with <b>filter_id</b> from a name instead. /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"filter_var","fqn":"filter_var","kind":"Function","origin":"PhpRuntime","extension":"filter","location":{"file":"filter/filter.php","range":{"start":3096,"end":3106}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"filter","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|int","phpdoc_type":"array|int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Filters a variable with a specified filter Value to filter. </p> The ID of the filter to apply. The manual page lists the available filters. </p> Associative array of options or bitwise disjunction of flags. If filter accepts options, flags can be provided in \"flags\" field of array. For the \"callback\" filter, callable type should be passed. The callback must accept one argument, the value to be filtered, and return the value after filtering/sanitizing it. </p> <p> <code> // for filters that accept options, use this format $options = array( 'options' => array( 'default' => 3, // value to return if the filter fails // other options here 'min_range' => 0 ), 'flags' => FILTER_FLAG_ALLOW_OCTAL, ); $var = filter_var('0755', FILTER_VALIDATE_INT, $options); // for filter that only accept flags, you can pass them directly $var = filter_var('oops', FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE); // for filter that only accept flags, you can also pass as an array $var = filter_var('oops', FILTER_VALIDATE_BOOLEAN, array('flags' => FILTER_NULL_ON_FAILURE)); // callback validate filter function foo($value) { // Expected format: Surname, GivenNames if (strpos($value, \", \") === false) return false; list($surname, $givennames) = explode(\", \", $value, 2); $empty = (empty($surname) || empty($givennames)); $notstrings = (!is_string($surname) || !is_string($givennames)); if ($empty || $notstrings) { return false; } else { return $value; } } $var = filter_var('Doe, Jane Sue', FILTER_CALLBACK, array('options' => 'foo')); </code> </p> /","params":[{"name":"value","declared_type":"mixed","description":"<p>"},{"name":"filter","declared_type":"int","description":"[optional] <p>"},{"name":"options","declared_type":"array|int","description":"<p>"}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"filter_var_array","fqn":"filter_var_array","kind":"Function","origin":"PhpRuntime","extension":"filter","location":{"file":"filter/filter.php","range":{"start":6005,"end":6021}},"declared_type":null,"signature":{"parameters":[{"name":"array","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|int","phpdoc_type":"array|int","optional":true,"variadic":false,"by_reference":false},{"name":"add_empty","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false|null","phpdoc_return_type":"array|false|null"},"documentation":{"description":"Gets multiple variables and optionally filters them An array with string keys containing the data to filter. </p> An array defining the arguments. A valid key is a string containing a variable name and a valid value is either a filter type, or an array optionally specifying the filter, flags and options. If the value is an array, valid keys are filter which specifies the filter type, flags which specifies any flags that apply to the filter, and options which specifies any options that apply to the filter. See the example below for a better understanding. </p> <p> This parameter can be also an integer holding a filter constant. Then all values in the input array are filtered by this filter. </p> Add missing keys as <b>NULL</b> to the return value. </p> on failure. An array value will be <b>FALSE</b> if the filter fails, or <b>NULL</b> if the variable is not set. /","params":[{"name":"array","declared_type":"array","description":"<p>"},{"name":"options","declared_type":"array|int","description":"[optional] <p>"},{"name":"add_empty","declared_type":"bool","description":"[optional] <p>"}],"return_type":"array|false|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"finfo_buffer","fqn":"finfo_buffer","kind":"Function","origin":"PhpRuntime","extension":"fileinfo","location":{"file":"fileinfo/fileinfo.php","range":{"start":6674,"end":6686}},"declared_type":null,"signature":{"parameters":[{"name":"finfo","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"context","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"(PHP 5 &gt;= 5.3.0, PECL fileinfo &gt;= 0.1.0)<br/> Return information about a string buffer Fileinfo resource returned