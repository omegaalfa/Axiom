hat all actions on the Manager to be wrapped in try/catch statements. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Map","fqn":"Map","kind":"Class","origin":"PhpRuntime","extension":"ds","location":{"file":"ds/ds.php","range":{"start":51398,"end":51401}},"declared_type":null,"signature":null,"documentation":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mapObj","fqn":"mapObj","kind":"Class","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":51153,"end":51159}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"MatchAllSearchQuery","fqn":"MatchAllSearchQuery","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":77078,"end":77097}},"declared_type":null,"signature":null,"documentation":{"description":"A FTS query that matches all indexed documents (usually for debugging purposes). /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"MatchNoneSearchQuery","fqn":"MatchNoneSearchQuery","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":77451,"end":77471}},"declared_type":null,"signature":null,"documentation":{"description":"A FTS query that matches 0 document (usually for debugging purposes). /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"MatchPhraseSearchQuery","fqn":"MatchPhraseSearchQuery","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couc