pping). Fields provided first are considered first and in a \"tie\" case the next sort field is considered. So sorting by \"firstname\" and then \"lastname\" will first sort ascending by the firstname and if the names are equal then sort ascending by lastname. Special fields like \"_id\" and \"_score\" can also be used. If prefixed with \"-\" the sort order is set to descending. If no sort is provided, it is equal to sort(\"-_score\"), since the server will sort it by score in descending order. /","params":[{"name":"specs","declared_type":"array","description":"sort the fields that should take part in the sorting."}],"return_type":"SearchOptions","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"timeout","fqn":"SearchOptions::timeout","kind":"Method","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":64875,"end":64882}},"declared_type":null,"signature":{"parameters":[{"name":"ms","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"SearchOptions","phpdoc_return_type":"SearchOptions"},"documentation":{"description":"Sets the server side timeout in milliseconds /","params":[{"name":"ms","declared_type":"int","description":"the server side timeout to apply"}],"return_type":"SearchOptions","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"facets","fqn":"SearchResult::facets","kind":"Method","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":14471,"end":14477}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"?array","phpdoc_return_type":"array|null"},"documentation":{"description":"Returns any facets returned by the query Array contains instances of SearchFacetResult /","params":[],"return_type":"array|null","var_type":null,"throws