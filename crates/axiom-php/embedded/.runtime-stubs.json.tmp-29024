d":34215}},"declared_type":null,"signature":{"parameters":[{"name":"script_sha","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"num_keys","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"This is simply the read-only variant of eval, meaning the underlying script may not modify data in redis. $redis->eval_ro('return redis.call(\"get\", KEYS[1])', ['counter'], 1); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"evalSha","fqn":"Redis::evalSha","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":22831,"end":22838}},"declared_type":null,"signature":{"parameters":[{"name":"script_sha","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":null,"phpdoc_type":"mixed|null","optional":true,"variadic":false,"by_reference":false},{"name":"num_keys","declared_type":null,"phpdoc_type":"mixed|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"script_sha","declared_type":"mixed","description":null},{"name":"args","declared_type":"mixed|null","description":null},{"name":"num_keys","declared_type":"mixed|null","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"evalsha","fqn":"Redis::evalsha","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":35195,"end":35202}},"declared_type":null,"signature":{"parameters":[{"name":"sha1","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"num_keys","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Execute a LUA script on the server but instead of sending the script, send the SHA1 hash of the script. must already exist on the server, either having been loaded with `SCRIPT LOAD` or having been executed directly with `EVAL` first. $sha = $redis->script('load', 'return redis.call(\"incr\", KEYS[1])'); $redis->evalsha($sha, ['counter'], 1); /","params":[{"name":"sha1","declared_type":"string","description":"The SHA1 hash of the lua code.  Note that the script"},{"name":"args","declared_type":"array","description":"Arguments to send to the script."},{"name":"num_keys","declared_type":"int","description":"The number of arguments that are keys"}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"evalsha_ro","fqn":"Redis::evalsha_ro","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":35669,"end":35679}},"declared_type":null,"signature":{"parameters":[{"name":"sha1","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"num_keys","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"This is simply the read-only variant of evalsha, meaning the underlying script may not modify data in redis. $sha = $redis->script('load', 'return redis.call(\"get\", KEYS[1])'); $redis->evalsha_ro($sha, ['counter'], 1); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"exec","fqn":"Redis::exec","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":36387,"end":36391}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Execute either a MULTI or PIPELINE block and return the array of replies. $res = $redis->multi() ->set('foo', 'bar') ->get('foo') ->del('list') ->rpush('list', 'one', 'two', 'three') ->exec(); /","params":[],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"exists","fqn":"Redis::exists","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":37002,"end":37008}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|bool","phpdoc_return_type":"Redis|int|bool"},"documentation":{"description":"Test if one or more keys exist. additional keys to test. /","params":[{"name":"key","declared_type":"mixed","description":"Either an array of keys or a string key"},{"name":"other_keys","declared_type":"mixed","description":"If the previous argument was a string, you may send any number of"}],"return_type":"Redis|int|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"expire","fqn":"Redis::expire","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":38187,"end":38193}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Sets an expiration in seconds on the key in question.  If connected to redis-server >= 7.0.0 you may send an additional \"mode\" argument which modifies how the command will execute. command works. <code> NX - Set expiry only if key has no expiry XX - Set expiry only if key has an expiry LT - Set expiry only when new expiry is < current expiry GT - Set expiry only when new expiry is > current expiry </code> $redis->expire('session:42', 60); /","params":[{"name":"key","declared_type":"string","description":"The key to set an expiration on."},{"name":"timeout","declared_type":"int","description":"The number of seconds after which key will be automatically deleted."},{"name":"mode","declared_type":"string|null","description":"A two character modifier that changes how the"}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"expireAt","fqn":"Redis::expireAt","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":39297,"end":39305}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timestamp","declared_type":"int","