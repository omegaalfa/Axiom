oat[]|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imageaffinematrixget","fqn":"imageaffinematrixget","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":97812,"end":97832}},"declared_type":null,"signature":{"parameters":[{"name":"type","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"float[]|false"},"documentation":{"description":"Return an image containing the affine tramsformed src image, using an optional clipping area /","params":[{"name":"type","declared_type":"int","description":"<p> One of <b>IMG_AFFINE_*</b> constants.</p>"},{"name":"options","declared_type":"mixed","description":null}],"return_type":"float[]|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagealphablending","fqn":"imagealphablending","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":21180,"end":21198}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"enable","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Set the blending mode for an image Whether to enable the blending mode or not. On true color images the default value is true otherwise the default value is false </p> /","params":[{"name":"image","declared_type":"re