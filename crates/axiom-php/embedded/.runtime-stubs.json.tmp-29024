rver. </p> /","params":[{"name":"memcache","declared_type":"Memcache","description":null},{"name":"host","declared_type":"string","description":"<p>Point to the host where memcached is listening for connections.</p>."},{"name":"port","declared_type":"int","description":"[optional] <p>"},{"name":"timeout","declared_type":"int","description":"[optional] <p>"},{"name":"retry_interval","declared_type":"int","description":"[optional] <p>"},{"name":"status","declared_type":"bool","description":"[optional] <p>"},{"name":"failure_callback","declared_type":"callable","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"memcmp","fqn":"memcmp","kind":"Function","origin":"PhpRuntime","extension":"libsodium","location":{"file":"libsodium/libsodium.php","range":{"start":15060,"end":15066}},"declared_type":null,"signature":{"parameters":[{"name":"left","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"right","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Compare two strings in constant time /","params":[{"name":"left","declared_type":"string","description":null},{"name":"right","declared_type":"string","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"meminfo_dump","fqn":"meminfo_dump","kind":"Function","origin":"PhpRuntime","extension":"meminfo","location":{"file":"meminfo/meminfo.php","range":{"start":134,"end":146}},"declared_type":null,"signature":{"parameters":[{"name":"stream","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentat