{"name":"expire","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcache &gt;= 0.2.0)<br/> Stores an item var with key on the memcached server. Parameter expire is expiration time in seconds. If it's 0, the item never expires (but memcached server doesn't guarantee this item to be stored all the time, it could be deleted from the cache to make place for other items). You can use MEMCACHE_COMPRESSED constant as flag value if you want to use on-the-fly compression (uses zlib). /","params":[{"name":"key","declared_type":"string","description":"The key that will be associated with the item."},{"name":"var","declared_type":"mixed","description":"The variable to store. Strings and integers are stored as is, other types are stored serialized."},{"name":"flag","declared_type":"int","description":"[optional] Use MEMCACHE_COMPRESSED to store the item compressed (uses zlib)."},{"name":"expire","declared_type":"int","description":"[optional] Expiration time of the item. If it's equal to zero, the item will never expire. You can also use Unix timestamp or a number of seconds starting from current time, but in the latter case the number of seconds may not exceed 2592000 (30 days)."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setCompressThreshold","fqn":"MemcachePool::setCompressThreshold","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":18002,"end":18022}},"declared_type":null,"signature":{"parameters":[{"name":"thresold","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"min_saving","declared_type":null,"phpdoc_type":"float","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcache &gt;= 2.0.0)<br/> Enable automatic compression of large values /","params":[{"name":"thresold","declared_type":"int","description":"<p>Controls the minimum value length before attempting to compress automatically.</p>"},{"name":"min_saving","declared_type":"float","description":"[optional] <p>Specifies the minimum amount of savings to actually store the value compressed. The supplied value must be between 0 and 1. Default value is 0.2 giving a minimum 20% compression savings.</p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setFailureCallback","fqn":"MemcachePool::setFailureCallback","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":7142,"end":7160}},"declared_type":null,"signature":{"parameters":[{"name":"callback","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"/","params":[{"name":"callback","declared_type":"callable","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setServerParams","fqn":"MemcachePool::setServerParams","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":6850,"end":6865}},"declared_type":null,"signature":{"parameters":[{"name":"host","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"retry_interval","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"status","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"failure_callback","declared_type":"?callable","phpdoc_type":"callable","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcache &gt;= 2.1.0)<br/> Changes server parameters and status at runtime Point to the port where memcached is listening for connections. </p> Value in seconds which will be used for connecting to the daemon. Think twice before changing the default value of 1 second - you can lose all the advantages of caching if your connection is too slow. </p> Controls how often a failed server will be retried, the default value is 15 seconds. Setting this parameter to -1 disables automatic retry. Neither this nor the <b>persistent</b> parameter has any effect when the extension is loaded dynamically via {@link https://secure.php.net/manual/en/function.dl.php dl()}. </p> Controls if the server should be flagged as online. Setting this parameter to <b>FALSE</b> and <b>retry_interval</b> to -1 allows a failed server to be kept in the pool so as not to affect the key distribution algorithm. Requests for this server will then failover or fail immediately depending on the <b>memcache.allow_failover</b> setting. Default to <b>TRUE</b>, meaning the server should be considered online. </p> Allows the user to specify a callback function to run upon encountering an error. The callback is run before failover is attempted. The function takes two parameters, the hostname and port of the failed server. </p> /","params":[{"name":"host","declared_type":"string","description":"<p>Point to the host where memcached is listening for connections.</p>."},{"name":"port","declared_type":"int","description":"[optional] <p>"},{"name":"timeout","declared_type":"int","description":"[optional] <p>"},{"name":"retry_interval","declared_type":"int","description":"[optional] <p>"},{"name":"status","declared_type":"bool","description":"[optional] <p>"},{"name":"failure_callback","declared_type":"callable","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"Message::__construct","kind":"Method","origin":"PhpRuntime","extension":"http","location":{"file":"http/http3.php","range":{"start":36029,"end":36040}},"declared_type":null,"signature":{"parameters":[{"name":"message","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false},{"name":"greedy","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Create a new HTTP message. /","params":[{"name":"message","declared_type":"mixed","description":"Either a resource or a string, representing the HTTP message."},{"name":"greedy","declared_type":"bool","description":"Whether to read from a $message resource until EOF."}],"return_type":null,"var_type":null,"throws":["\\http\\Exception\\InvalidArgumentException","\\http\\Exception\\BadMessageException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__toString","fqn":"Message::__toString","kind":"Method","origin":"PhpRuntime","extension":"http","location":{"file":"http/http3.php","range":{"start":36278,"end":36288}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Retrieve the message serialized to a string. Alias of http\\Message::toString(). /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addBody","fqn":"Message::addBo