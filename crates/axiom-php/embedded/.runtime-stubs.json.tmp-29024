orted sets, blocking up to a specified timeout if no elements are available. Following are examples of the two main ways to call this method. **NOTE**:  We recommend calling this function with an array and a timeout as the other strategy may be deprecated in future versions of PhpRedis must be a timeout value.  Otherwise it could also be another key. which needs to be a timeout. $redis->bzPopMax('key1', 'key2', 'key3', 1.5); $redis->bzPopMax(['key1', 'key2', 'key3'], 1.5); /","params":[{"name":"key","declared_type":"string|array","description":"Either a string key or an array of one or more keys."},{"name":"timeout_or_key","declared_type":"string|int","description":"If the previous argument was an array, this argument"},{"name":"extra_args","declared_type":"mixed","description":"Can consist of additional keys, until the last argument"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bzPopMin","fqn":"Redis::bzPopMin","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":16981,"end":16989}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string|array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"timeout_or_key","declared_type":"string|int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"extra_args","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":null},"documentation":{"description":"POP the minimum scoring element off of one or more sorted sets, blocking up to a specified timeout if no elements are available This command is identical in semantics to bzPopMax so please see that method for more information. $redis->bzPopMin(['scores:high', 'scores:low'], 1.5); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"clearLastError","fqn":"Redis::clearLastError","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":21501,"end":21515}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Reset any last error on the connection to NULL $redis = new Redis(['host' => 'localhost']); $redis->set('string', 'this_is_a_string'); $redis->smembers('string'); var_dump($redis->getLastError()); $redis->clearLastError(); var_dump($redis->getLastError()); /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"clearTransferredBytes","fqn":"Redis::clearTransferredBytes","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":64089,"end":64110}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Reset the number of bytes sent and received on the socket. $redis->clearTransferredBytes(); /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"client","fqn":"Redis::client","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":21869,"end":21875}},"declared_type":null,"signature":{"parameters":[{"name":"opt","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"Execute Redis CLIENT subcommands. $re