ed when using the object-oriented method.</p>"},{"name":"field_index","declared_type":"int","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sqlite_has_more","fqn":"sqlite_has_more","kind":"Function","origin":"PhpRuntime","extension":"SQLite","location":{"file":"SQLite/SQLite.php","range":{"start":44664,"end":44679}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL sqlite &gt;= 1.0.0)<br/> Finds whether or not more rows are available The SQLite result resource. </p> result handle, or <b>FALSE</b> otherwise. /","params":[{"name":"result","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sqlite_has_prev","fqn":"sqlite_has_prev","kind":"Function","origin":"PhpRuntime","extension":"SQLite","location":{"file":"SQLite/SQLite.php","range":{"start":45096,"end":45111}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Returns whether or not a previous row is available The SQLite result resource.  This parameter is not required when using the object-oriented method. </p> result handle, or <b>FALSE</b> otherwise. /","params":[{"name":"result","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sqlite_last_error","fqn":"sqlite_last_error","kind":"Function","origin":"PhpRuntime"