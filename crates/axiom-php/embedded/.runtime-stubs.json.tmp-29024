dkafka/RdKafka/Metadata/Broker.php","range":{"start":42,"end":48}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"Bucket","fqn":"Bucket","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":57104,"end":57110}},"declared_type":null,"signature":null,"documentation":{"description":"Bucket is an object containing functionality for performing bucket level operations against a cluster and for access to scopes and collections. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"BucketManager","fqn":"BucketManager","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":42304,"end":42317}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"BucketMissingException","fqn":"BucketMissingException","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":20476,"end":20498}},"declared_type":null,"signature":null,"documentation":{"description":"Occurs when the specified bucket does not exist. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"BucketSettings","fqn":"BucketSettings","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":39792,"end":39806}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"BulkWrite","fqn":"BulkWrite","kind":"Class","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/BulkWrite.php","range":{"start":748,"end":757}},"declared_type":null,"signature":null,"documentation":{"description":"The BulkWrite collects one or more write operations that should be sent to the server. After adding any number of insert, update, and delete operations, the collection may be executed via Manager::executeBulkWrite(). Write operations may either be ordered (default) or unordered. Ordered write operations are sent to the server, in the order provided, for serial execution. If a write fails, any remaining operations will be aborted. Unordered operations are sent to the server in an arbitrary order where they may be executed in parallel. Any errors that occur are reported after all operations have been attempted. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"BulkWriteCommand","fqn":"BulkWriteCommand","kind":"Class","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/BulkWriteCommand.stub.php","range":{"start":1073,"end":1089}},"declared_type":null,"signature":null,"documentation":{"description":"MongoDB\\Driver\\BulkWriteCommand collects one or more write operations that should be sent to the server using the » bulkWrite command introduced in MongoDB 8.0. After adding any number of insert, update, and delete operations, the command may be executed via MongoDB\\Driver\\Manager::executeBulkWriteCommand(). Unlike MongoDB\\Driver\\BulkWrite, where all write operations must target the same collection, each write operation within MongoDB\\Driver\\BulkWriteCommand may target a different collection. Write operations may either be ordered (default) or unordered. Ordered write operations are sent to the server, in the order provided, for serial execution. If a write fails, any remaining operations will be aborted. Unordered operations are sent to the server in an arbitrary order where they may be executed in parallel. Any errors that occur are reported after all operations have been attempted. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"BulkWriteCommandException","fqn":"BulkWriteCommandException","kind":"Class","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/Exception/BulkWriteCommandException.stub.php","range":{"start":381,"end":406}},"declared_type":null,"signature":null,"documentation":{"description":"Exception thrown due to failed execution of a MongoDB\\Driver\\BulkWriteCommand. The methods of this class provide more details of the error that occurred, including the error reply and partial results from the bulk write. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"BulkWriteCommandResult","fqn":"BulkWriteCommandResult","kind":"Class","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/BulkWriteCommandResult.stub.php","range":{"start":345,"end":367}},"declared_type":null,"signature":null,"documentation":{"description":"The MongoDB\\Driver\\BulkWriteCommandResult class encapsulates information about an executed MongoDB\\Driver\\BulkWriteCommand and is returned by MongoDB\\Driver\\Manager::executeBulkWriteCommand(). /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"BulkWriteException","fqn":"BulkWriteException","kind":"Class","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/Exception/BulkWriteException.php","range":{"start":241,"end":259}},"declared_type":null,"signature":null,"documentation":{"description":"Thrown when a bulk write operation fails. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Bytes","fqn":"Bytes","kind":"Class","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/Bytes.php","range":{"start":1564,"end":1569}},"declared_type":null,"signature":null,"documentation":{"description":"\\Aerospike\\Bytes is a utility for wrapping PHP strings containing potentially harmful bytes such as \\0. By wrapping the binary-string, the Aerospike client will serialize the data into an as_bytes rather than an as_string. This ensures that the string will not get truncated or otherwise lose data. The main difference is that strings in the Aerospike cluster can have a secondary index built over them, and queries executed against the index, while bytes data cannot. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"CachingIterator","fqn":"CachingIterator","kind":"Class","origin":"PhpRuntime","extension":"SPL","location":{"file":"SPL/SPL.php","range":{"start":25798,"end":25813}},"declared_type":null,"signature":null,"documentation":{"description":"This object supports cached iteration over another iterator. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Call","fqn":"Call","kind":"Class","origin":"PhpRuntime","extension":"grpc","location":{"file":"grpc/grpc.php","range":{"start":17268,"end":17272}},"declared_type":null,"signature":null,"documentation":{"description":"Class Call /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"CallbackFilterIterator","fqn":"CallbackFilterIterator","kind":"Class","origin":"PhpRuntime","extension":"SPL","location":{"file":"SPL/SPL.php","range":{"start":5034,"end":5056}},"declared_type":null,"signature":null,"documentation":{"description":"Filtered iterator using the callback to determine which items are accepted or rejected. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated"