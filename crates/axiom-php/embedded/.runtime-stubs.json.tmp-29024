,"range":{"start":66833,"end":66840}},"declared_type":null,"signature":{"parameters":[{"name":"feature","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"/","params":[{"name":"feature","declared_type":null,"description":"[optional]"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"pasteImage","fqn":"imageObj::pasteImage","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":19046,"end":19056}},"declared_type":null,"signature":{"parameters":[{"name":"srcImg","declared_type":"imageObj","phpdoc_type":"imageObj","optional":false,"variadic":false,"by_reference":false},{"name":"transparentColorHex","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"dstX","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"dstY","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"angle","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Copy srcImg on top of the current imageObj. transparentColorHex is the color (in 0xrrggbb format) from srcImg that should be considered transparent (i.e. those pixels won't be copied).  Pass -1 if you don't want any transparent color. If optional dstx,dsty are provided then it defines the position where the image should be copied (dstx,dsty = top-left corner position). The optional angle is a value between 0 and 360 degrees to rotate the source image counterclockwise.  Note that if an angle is specified (even if its value is zero) then the dstx and dsty coordinates specify the CENTER of the destination area. Note: this function works only with 8 bits GD images (PNG or GIF). /","params":[{"name":"srcImg","declared_type":"imageObj","description":null},{"name":"transparentColorHex","declared_type":"int","description":null},{"name":"dstX","declared_type":"int","description":null},{"name":"dstY","declared_type":"int","description":null},{"name":"angle","declared_type":"int","description":null}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"saveImage","fqn":"imageObj::saveImage","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":19909,"end":19918}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"oMap","declared_type":"mapObj","phpdoc_type":"mapObj","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Writes image object to specified filename. Passing no filename or an empty filename sends output to stdout.  In this case, the PHP header() function should be used to set the document's content-type prior to calling saveImage().  The output format is the one that is currently selected in the map file.  The second argument oMap is not manadatory. It is usful when saving to formats like GTIFF that needs georeference information contained in the map file. On success, it returns either MS_SUCCESS if writing to an external file, or the number of bytes written if output is sent to stdout. /","params":[{"name":"filename","declared_type":"string","description":null},{"name":"oMap","declared_type":"mapObj","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"saveWebImage","fqn":"imageObj::saveWebImage","kind":"Method","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":20165,"end":20177}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Writes image to temp directory.  Returns image URL. The output format is the one that is currently selected in the map file. /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"Imagick::__construct","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":74516,"end":74527}},"declared_type":null,"signature":{"parameters":[{"name":"files","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"(PECL imagick 2.0.0)<br/> The Imagick constructor The path to an image to load or an array of paths. Paths can include wildcards for file names, or can be URLs. </p> /","params":[{"name":"files","declared_type":"mixed","description":"<p>"}],"return_type":null,"var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__toString","fqn":"Imagick::__toString","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":74605,"end":74615}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"/","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"adaptiveBlurImage","fqn":"Imagick::adaptiveBlurImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":36215,"end":36232}},"declared_type":null,"signature":{"parameters":[{"name":"radius","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"sigma","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"channel","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL imagick 2.0.0)<br/> Adds adaptive blur filter to image The radius of the Gaussian, in pixels, not counting the center pixel. Provide a value of 0 and the radius will be chosen automagically. </p> The standard deviation of the Gaussian, in pixels. </p> Provide any channel constant that is valid for your channel mode. To apply to more than one channel, combine channel constants using bitwise operators. Defaults to <b>Imagick::CHANNEL_DEFAULT</b>. Refer to this list of channel constants </p> /","params":[{"name":"radius","declared_type":"float","description":"<p>"},{"name":"sigma","declared_type":"float","description":"<p>"},{"name":"channel","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"adaptiveResizeImage","fqn":"Imagick::adaptiveResizeImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":33273,"end":33292}},"declared_type":null,"signature":{"parameters":[{"name":"columns","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"rows","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"bestfit","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"legacy","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Adaptively resize image with data dependent triangulation If legacy is true, the calculations are done with the small rounding bug that existed in Imagick before 3.4.0.<br> If false, the calculations should produce the same results as ImageMagick CLI does.<br> <br> <b>Note:</b> The behavior of the parameter bestfit changed in Imagick 3.0.0. Before this version given dimensions 400x400 an image of dimensions 200x150 would be left untouched. In Imagick 3.0.0 and later the image would be scaled up to size 400x300 as this is the \"best fit\" for the given dimensions. If bestfit parameter is used both width and height must be given. The behavior of the parameter bestfit changed in Imagick 3.0.0. Before this version given dimensions 400x400 an image of dimensions 200x150 would be left untouched. In Imagick 3.0.0 and later the image would be scaled up to size 400x300 as this is the \"best fit\" for the given dimensions. If bestfit parameter is used both width and height must be given. /","params":[{"name":"columns","declared_type":"int","description":"The number of columns in the scaled image."},{"name":"rows","declared_type":"int","description":"The number of rows in the scaled image."},{"name":"bestfit","declared_type":"bool","description":"[optional] Whether to fit the image inside a bounding box.<br>"},{"name":"legacy","declared_type":"bool","description":"[optional] Added since 3.4.0. Default value FALSE"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"adaptiveSharpenImage","fqn":"Imagick::adaptiveSharpenImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":37910,"e