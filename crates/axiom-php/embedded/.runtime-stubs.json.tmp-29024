l":null},"is_static":false},{"name":"IntlDatePatternGenerator","fqn":"IntlDatePatternGenerator","kind":"Class","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/IntlDatePatternGenerator.php","range":{"start":210,"end":234}},"declared_type":null,"signature":null,"documentation":{"description":"Generates localized date and/or time format pattern strings suitable for use in IntlDateFormatter. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"IntlException","fqn":"IntlException","kind":"Class","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":152373,"end":152386}},"declared_type":null,"signature":null,"documentation":{"description":"This class is used for generating exceptions when errors occur inside intl functions. Such exceptions are only generated when intl.use_exceptions is enabled. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"IntlGregorianCalendar","fqn":"IntlGregorianCalendar","kind":"Class","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":108749,"end":108770}},"declared_type":null,"signature":null,"documentation":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"IntlIterator","fqn":"IntlIterator","kind":"Class","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":151148,"end":151160}},"declared_type":null,"signature":null,"documentation":{"description":"This class represents iterator objects throughout the intl extension whenever the iterator cannot be identified with any other object provided by the extension. The distinct iterator object used internally by the foreach construct can only be obtained (in the relevant part here) from objects, so objects of this class serve the purpose of providing the hook through which this internal object can be obtained. As a convenience, this class also implements the Iterator interface, allowing the collection of values to be navigated using the methods defined in that interface. Both these methods and the internal iterator objects provided to foreach are backed by the same state (e.g. the position of the iterator and its current value). Subclasses may provide richer functionality. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"IntlListFormatter","fqn":"IntlListFormatter","kind":"Class","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/IntlListFormatter.php","range":{"start":220,"end":237}},"declared_type":null,"signature":null,"documentation":{"description":"Formats, orders, and punctuates a list of items according to locale-specific rules. Requires ICU 67 or later. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"IntlNumberRangeFormatter","fqn":"IntlNumberRangeFormatter","kind":"Class","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/IntlNumberRangeFormatter.php","range":{"start":41,"end":65}},"declared_type":null,"signature":null,"documentation":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"IntlPartsIterator","fqn":"IntlPartsIterator","kind":"Class","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":304793,"end":304810}},"declared_type":null,"signature":null,"documentation":{"description":"Objects of this class can be obtained from IntlBreakIterator objects. While the break iterators provide a sequence of boundary positions 