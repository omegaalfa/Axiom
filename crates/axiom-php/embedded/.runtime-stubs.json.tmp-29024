key The key the data is specified by. </p> <p> When working with inifiles this function accepts arrays as keys where index 0 is the group and index 1 is the value name. See: <b>dba_key_split</b>. </p> The database handler, returned by <b>dba_open</b> or <b>dba_popen</b>. </p> otherwise. /","params":[{"name":"key","declared_type":"string","description":"<p>"},{"name":"handle","declared_type":"resource","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dba_firstkey","fqn":"dba_firstkey","kind":"Function","origin":"PhpRuntime","extension":"dba","location":{"file":"dba/dba.php","range":{"start":14217,"end":14229}},"declared_type":null,"signature":{"parameters":[{"name":"dba","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Fetch first key The database handler, returned by <b>dba_open</b> or <b>dba_popen</b>. </p> /","params":[{"name":"dba","declared_type":"resource","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dba_handlers","fqn":"dba_handlers","kind":"Function","origin":"PhpRuntime","extension":"dba","location":{"file":"dba/dba.php","range":{"start":16065,"end":16077}},"declared_type":null,"signature":{"parameters":[{"name":"full_info","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"List all the handlers available Turns on/off full information display in the result. </p> is set to <b>TRUE</b>, the array will be associative with the handlers names as keys, and their version information as value. Otherwise, the result will be an ind