ntain other arrays). </p> <p> If query_data is an object, then only public properties will be incorporated into the result. </p> If numeric indices are used in the base array and this parameter is provided, it will be prepended to the numeric index for elements in the base array only. </p> <p> This is meant to allow for legal variable names when the data is decoded by PHP or another CGI application later on. </p> arg_separator.output is used to separate arguments, unless this parameter is specified, and is then used. </p> <p>If enc_type is PHP_QUERY_RFC1738, then encoding is performed per » RFC 1738 and the application/x-www-form-urlencoded media type, which implies that spaces are encoded as plus (+) signs. <p>If enc_type is PHP_QUERY_RFC3986, then encoding is performed according to » RFC 3986, and spaces will be percent encoded (%20). /","params":[{"name":"data","declared_type":"object|array","description":"<p>"},{"name":"numeric_prefix","declared_type":"string","description":"[optional] <p>"},{"name":"arg_separator","declared_type":"string|null","description":"<p>"},{"name":"encoding_type","declared_type":"int","description":"By default, PHP_QUERY_RFC1738."}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"http_build_str","fqn":"http_build_str","kind":"Function","origin":"PhpRuntime","extension":"http","location":{"file":"http/http.php","range":{"start":68531,"end":68545}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"prefix","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"arg_separator","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"(PECL