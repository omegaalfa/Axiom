on","origin":"PhpRuntime","extension":"wincache","location":{"file":"wincache/wincache.php","range":{"start":19112,"end":19131}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"inc_by","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"success","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"(PHP 5.2+; PECL wincache &gt;= 1.1.0)<br/> Increments the value associated with the key by 1 or as specified by inc_by. key is case sensitive.</p> get incremented. If the argument is a floating point number it will be truncated to nearest integer. The variable associated with the key should be of type long, otherwise the function fails and returns FALSE.</p> <p>Will be set to TRUE on success and FALSE on failure.</p> /","params":[{"name":"key","declared_type":"string","description":"<p>The key that was used to store the variable in the cache."},{"name":"inc_by","declared_type":"int","description":"<p>The value by which the variable associated with the key will"},{"name":"","declared_type":null,"description":null}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wincache_ucache_info","fqn":"wincache_ucache_info","kind":"Function","origin":"PhpRuntime","extension":"wincache","location":{"file":"wincache/wincache.php","range":{"start":21414,"end":21434}},"declared_type":null,"signature":{"parameters":[{"name":"summaryonly","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"key","declared_type":null,"phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PHP 5.2+; PECL wincache &gt;= 1.1.0)<br/> Retrieves information about data stored in the user cache. <p>Controls whether the returned array will contain information about individual cache entries along with the user cache summary.</p> <p>The key of an entry in the user cache. If specified then the returned array will contain information only about that cache entry. If not specified and summaryonly is set to false then the returned array will contain information about all entries in the cache.</p> <p>The array returned by this function contains the following elements: <ul> <li><em>total_cache_uptime</em> - total time in seconds that the user cache has been active</li> <li><em>total_item_count</em> - total number of elements that are currently in the user cache</li> <li><em>is_local_cache</em> - true is the cache metadata is for a local cache instance, false if the metadata is for the global cache</li> <li><em>total_hit_count</em> - number of times the data has been served from the cache</li> <li><em>total_miss_count</em> - number of times the data has not been found in the cache</li> <li><em>ucache_entries</em> - an array that contains the information about all the cached items: <ul> <li><em>key_name</em> - name of the key which is used to store the data</li> <li><em>value_type</em> - type of value stored by the key</li> <li><em>use_time</em> - time in seconds since the file has been accessed in the opcode cache</li> <li><em>last_check</em> - time in seconds since the file has been checked for modifications</li> <li><em>is_session</em> - indicates if the data is a session variable</li> <li><em>ttl_seconds</em> - time remaining for the data to live in the cache, 0 meaning infinite</li> <li><em>age_seconds</em> - time elapsed from the time data has been added in the cache</li> <li><em>hitcount</em> - number of times data has been served from the cache</li> </ul></li> </ul></p> /","params":[{"name":"summaryonly","declared_type":"bool","description":"[optional]"},{"name":"key","declared_type":"null|string","description":"[optional]"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wincache_ucache_meminfo","fqn":"wincache_ucache_meminfo","kind":"Function","origin":"PhpRuntime","extension":"wincache","location":{"file":"wincache/wincache.php","range":{"start":22342,"end":22365}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PHP 5.2+; PECL wincache &gt;= 1.1.0)<br/> Retrieves information about memory usage by user cache. <p>The array returned by this function contains the following elements: <ul> <li><em>memory_total</em> - amount of memory in bytes allocated for the user cache</li> <li><em>memory_free</em> - amount of free memory in bytes available for the user cache</li> <li><em>num_used_blks</em> - number of memory blocks used by the user cache</li> <li><em>num_free_blks</em> - number of free memory blocks available for the user cache</li> <li><em>memory_overhead</em> - amount of memory in bytes used for the user cache internal structures</li> </ul></p> /","params":[],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wincache_ucache_set","fqn":"wincache_ucache_set","kind":"Function","origin":"PhpRuntime","extension":"wincache","location":{"file":"wincache/wincache.php","range":{"start":24433,"end":24452}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"ttl","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5.2+; PECL wincache &gt;= 1.1.0)<br/> Adds a variable in user cache and overwrites a variable if it already exists in the cache. <p>The added or updated variable remains in the user cache unless its time to live expires or it is deleted by using wincache_ucache_delete() or wincache_ucache_clear() functions.</p> Store the variable using this key name. If a variable with same key is already present the function will overwrite the previous value with the new one. key is case sensitive. key can also take array of name =&gt; value pairs where names will be used as keys. This can be used to add multiple values in the cache in one operation, thus avoiding race condition.</p> Value of a variable to store. Value supports all data types except resources, such as file handles. This parameter is ignored if first argument is an array. A general guidance is to pass NULL as value while using array as key.</p> Time for the variable to live in the cache in seconds. After the value specified in ttl has passed the stored variable will be deleted from the cache. This parameter takes a default value of 0 which means the variable will stay in the cache unless explicitly deleted by using wincache_ucache_delete() or wincache_ucache_clear() functions.</p> If key is string, the function returns TRUE on success and FALSE on failure.</p> <p>If key is an array, the function returns: <ul style=\"list-style: square;\"> <li>If all the name =&gt; value pairs in the array can be set, function returns an empty array;</li> <li>If all the name =&gt; value pairs in the array cannot be set, function returns FALSE;</li> <li>If some can be set while others cannot, function returns an array with name=&gt;value pair for which the addition failed in the user cache.</li> </ul></p> /","params":[{"name":"key","declared_type":"string|string[]","description":"<p>"},{"name":"value","declared_type":"mixed","description":"<p>"},{"name":"ttl","declared_type":"int","description":"[optional]<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wincache_unlock","fqn":"wincache_unlock","kind":"Function","origin":"PhpRuntime","extension":"wincache","location":{"file":"wincache/wincache.php","range":{"start":24963,"end":24978}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5.2+; PECL wincache &gt;= 1.1.0)<br/> Releases an exclusive lock that was obtained on a given key by using wincache_lock(). <p>If any other process was blocked waiting for the lock on this key, that process will be able to obtain the lock.</p> /","params":[{"name":"key","declared_type":"string","description":"Name of the key in the cache to release the lock on."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wordwrap","fqn":"wordwrap","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":12597,"end":12605}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"width","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"break","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"cut_long_words","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Wraps a string to a given number of characters The input string. </p> The number of characters at which the string will be wrapped. </p> The line is broken using the optional break parameter. </p> If the cut is set to true, the string is always wrapped at or before the specified width. So if you have a word that is larger than the given width, it is broken apart. (See second example). </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"width","declared_type":"int","description":"[optional] <p>"},{"name":"break","declared_type":"string","description":"[optional] <p>"},{"name":"cut_long_words","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xcache_asm","fqn":"xcache_asm","kind":"Function","origin":"PhpRuntime","extension":"xcache","location":{"file":"xcache/xcache.php","range":{"start":2578,"end":2588}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"/","params":[{"name":"filename","declared_type":"string","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xcache_clear_cache","fqn":"xcache_clear_cache","kind":"Function","origin":"PhpRuntime","extension":"xcache","location":{"file":"xcache/xcache.php","range":{"start":1946,"end":1964}},"declared_type":null,"signature":{"parameters":[{"name":"type","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"id","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Clear