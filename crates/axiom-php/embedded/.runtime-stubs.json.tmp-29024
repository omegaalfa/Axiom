et, it will set the INTERNALDATE on the appended message. The parameter should be a date string that conforms to the rfc2060 specifications for a date_time value. </p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"folder","declared_type":"string","description":"<p>"},{"name":"message","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"string","description":"[optional] <p>"},{"name":"internal_date","declared_type":"string","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_base64","fqn":"imap_base64","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":28414,"end":28425}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Decode BASE64 encoded text The encoded text </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_binary","fqn":"imap_binary","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":29266,"end":29277}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Convert an 8bit string to a base64 string The 8bit string </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_body","fqn":"imap_body","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":10076,"end":10085}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_num","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Read the message body The message number </p> The optional <i>options</i> are a bit mask with one or more of the following: <b>FT_UID</b> - The <i>msg_number</i> is a UID</p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_num","declared_type":"int","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_bodystruct","fqn":"imap_bodystruct","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":10768,"end":10783}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_num","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"section","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"object"},"documentation":{"description":"Read the structure of a specified body section of a specific message The message number </p> The body section to read </p> of the object structure and properties see <b>imap_fetchstructure</b>. /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_num","declared_type":"int","description":"<p>"},{"name":"section","declared_type":"string","description":"<p>"}],"return_type":"object","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_check","fqn":"imap_check","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":20471,"end":20481}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"stdClass|false","phpdoc_return_type":"object|stdClass|false"},"documentation":{"description":"Check current mailbox <b>Date</b> - current system time formatted according to RFC2822 <b>Driver</b> - protocol used to access this mailbox: POP3, IMAP, NNTP <b>Mailbox</b> - the mailbox name <b>Nmsgs</b> - number of messages in the mailbox <b>Recent</b> - number of recent messages in the mailbox </p> <p> Returns <b>FALSE</b> on failure. /","params":[{"name":"imap","declared_type":"resource","description":null}],"return_type":"object|stdClass|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_clearflag_full","fqn":"imap_clearflag_full","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":33592,"end":33611}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"sequence","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flag","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Clears flags on messages A sequence of message numbers. You can enumerate desired messages with the X,Y syntax, or retrieve all messages within an interval with the X:Y syntax </p> The flags which you can unset are \"\\\\Seen\", \"\\\\Answered\", \"\\\\Flagged\", \"\\\\Deleted\", and \"\\\\Draft\" (as defined by RFC2060) </p> <i>options</i> are a bit mask and may contain the single option: <b>ST_UID</b> - The sequence argument contains UIDs instead of sequence numbers</p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"sequence","declared_type":"string","description":"<p>"},{"name":"flag","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"int","description":"[optional] <p>"}],"return_type":null,"var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_close","fqn":"imap_close","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":3290,"end":3300}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Close an IMAP stream If set to <b>CL_EXPUNGE</b>, the function will silently expunge the mailbox before closing, removing all messages marked for deletion. You can achieve the same thing by using <b>imap_expunge</b> </p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":null,"var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_create","fqn":"imap_create","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":59583,"end":59594}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"mailbox","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":null},"documentation":{"description":"Alias of <b>imap_createmailbox</b> /","params":[{"name":"imap","declared_type":null,"description":null},{"name":"mailbox","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_createmailbox","fqn":"imap_createmailbox","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":24743,"end":24761}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"mailbox","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Create a new mailbox The mailbox name, see <b>imap_open</b> for more information. Names containing international characters should be encoded by <b>imap_utf7_encode</b> </p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"mailbox","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_delete","fqn":"imap_delete","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":19322,"end":19333}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_nums","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Mark a message for deletion from current mailbox The message number </p> You can set the <b>FT_UID</b> which tells the function to treat the <i>msg_number</i> argument as an UID. </p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_nums","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":null,"var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_deletemailbox","fqn":"imap_deletemailbox","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":25738,"end":25756}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"mailbox","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Delete a mailbox The mailbox name, see <b>imap_open</b> for more information </p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"mailbox","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_errors","fqn":"imap_errors","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":40084,"end":40095}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Returns all of the IMAP errors that have occurred generated since the last <b>imap_errors</b> call, or the beginning of the page. Returns <b>FALSE</b> if no error messages are available. /","params":[],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_expunge","fqn":"imap_expunge","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":18716,"end":18728}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Delete all messages marked for deletion /","params":[{"name":"imap","declared_type":"resource","description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_fetch_overview","fqn":"imap_fetch_overview","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":39271,"end":39290}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"sequence","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Read an overview of the information in the headers of the given message A message sequence description. You can enumerate desired messages with the X,Y syntax, or retrieve all messages within an interval with the X:Y syntax </p> <i>sequence</i> will contain a sequence of message indices or UIDs, if this parameter is set to <b>FT_UID</b>. </p> The object will only define a property if it exists. The possible properties are: subject - the messages subject from - who sent it to - recipient date - when was it sent message_id - Message-ID references - is a reference to this message id in_reply_to - is a reply to this message id size - size in bytes uid - UID the message has in the mailbox msgno - message sequence number in the mailbox recent - this message is flagged as recent flagged - this message is flagged answered - this message is flagged as answered deleted - this message is flagged for deletion seen - this message is flagged as already read draft - this message is flagged as being a draft /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"sequence","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_fetchbody","fqn":"imap_fetchbody","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":11546,"end":11560}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_num","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"section","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Fetch a particular section of the body of the message The message number </p> The part number. It is a string of integers delimited by period which index into a body part list as per the IMAP4 specification </p> A bitmask with one or more of the following: <b>FT_UID</b> - The <i>msg_number</i> is a UID</p> text string. /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_num","declared_type":"int","description":"<p>"},{"name":"section","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_fetchheader","fqn":"imap_fetchheader","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":13945,"end":13961}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_num","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Returns header for a message The message number </p> The possible <i>options</i> are: <b>FT_UID</b> - The <i>msgno</i> argument is a UID</p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_num","declared_type":"int","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_fetchmime","fqn":"imap_fetchmime","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":12410,"end":12424}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_num","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"section","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Fetch MIME headers for a particular section of the message The message number </p> The part number. It is a string of integers delimited by period which index into a body part list as per the IMAP4 specification </p> A bitmask with one or more of the following: <b>FT_UID</b> - The <i>msg_number</i> is a UID</p> text string. /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_num","declared_type":"int","description":"<p>"},{"name":"section","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_fetchstructure","fqn":"imap_fetchstructure","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":17610,"end":17629}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_num","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"stdClass|false","phpdoc_return_type":"object|stdClass|false"},"documentation":{"description":"Read the structure of a particular message The message number </p> This optional parameter only has a single option, <b>FT_UID</b>, which tells the function to treat the <i>msg_number</i> argument as a UID. </p> body structure along with a similar object for each mime attachment. The structure of the returned objects is as follows: </p> <p> <table> Returned Objects for <b>imap_fetchstructure</b> <tr valign=\"top\"> <td>type</td> <td>Primary body type</td> </tr> <tr valign=\"top\"> <td>encoding</td> <td>Body transfer encoding</td> </tr> <tr valign=\"top\"> <td>ifsubtype</td> <td><b>TRUE</b> if there is a subtype string</td> </tr> <tr valign=\"top\"> <td>subtype</td> <td>MIME subtype</td> </tr> <tr valign=\"top\"> <td>ifdescription</td> <td><b>TRUE</b> if there is a description string</td> </tr> <tr valign=\"top\"> <td>description</td> <td>Content description string</td> </tr> <tr valign=\"top\"> <td>ifid</td> <td><b>TRUE</b> if there is an identification string</td> </tr> <tr valign=\"top\"> <td>id</td> <td>Identification string</td> </tr> <tr valign=\"top\"> <td>lines</td> <td>Number of lines</td> </tr> <tr valign=\"top\"> <td>bytes</td> <td>Number of bytes</td> </tr> <tr valign=\"top\"> <td>ifdisposition</td> <td><b>TRUE</b> if there is a disposition string</td> </tr> <tr valign=\"top\"> <td>disposition</td> <td>Disposition string</td> </tr> <tr valign=\"top\"> <td>ifdparameters</td> <td><b>TRUE</b> if the dparameters array exists</td> </tr> <tr valign=\"top\"> <td>dparameters</td> <td>An array of objects where each object has an \"attribute\" and a \"value\" property corresponding to the parameters on the Content-disposition MIME header.</td> </tr> <tr valign=\"top\"> <td>ifparameters</td> <td><b>TRUE</b> if the parameters array exists</td> </tr> <tr valign=\"top\"> <td>parameters</td> <td>An array of objects where each object has an \"attribute\" and a \"value\" property.</td> </tr> <tr valign=\"top\"> <td>parts</td> <td>An array of objects identical in structure to the top-level object, each of which corresponds to a MIME body part.</td> </tr> </table> </p> <p> <table> Primary body type (may vary with used library) <tr valign=\"top\"><td>0</td><td>text</td></tr> <tr valign=\"top\"><td>1</td><td>multipart</td></tr> <tr valign=\"top\"><td>2</td><td>message</td></tr> <tr valign=\"top\"><td>3</td><td>application</td></tr> <tr valign=\"top\"><td>4</td><td>audio</td></tr> <tr valign=\"top\"><td>5</td><td>image</td></tr> <tr valign=\"top\"><td>6</td><td>video</td></tr> <tr valign=\"top\"><td>7</td><td>other</td></tr> </table> </p> <p> <table> Transfer encodings (may vary with used library) <tr valign=\"top\"><td>0</td><td>7BIT</td></tr> <tr valign=\"top\"><td>1</td><td>8BIT</td></tr> <tr valign=\"top\"><td>2</td><td>BINARY</td></tr> <tr valign=\"top\"><td>3</td><td>BASE64</td></tr> <tr valign=\"top\"><td>4</td><td>QUOTED-PRINTABLE</td></tr> <tr valign=\"top\"><td>5</td><td>OTHER</td></tr> </table> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_num","declared_type":"int","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"object|stdClass|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_fetchtext","fqn":"imap_fetchtext","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":58933,"end":58947}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_num","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"(PHP 4, PHP 5)<br/> Alias of imap_body() <li>FT_UID - The msg_number is a UID <li>FT_PEEK - Do not set the \\Seen flag if not already set <li>FT_INTERNAL - The return string is in internal format, will not canonicalize to CRLF.</ul><p> /","params":[{"name":"imap","declared_type":"resource","description":"An IMAP stream returned by imap_open()"},{"name":"message_num","declared_type":"int","description":"message number"},{"name":"flags","declared_type":"int","description":"[optional] A bitmask with one or more of the following:<ul>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_gc","fqn":"imap_gc","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":18266,"end":18273}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Clears IMAP cache Specifies the cache to purge. It may one or a combination of the following constants: <b>IMAP_GC_ELT</b> (message cache elements), <b>IMAP_GC_ENV</b> (enveloppe and bodies), <b>IMAP_GC_TEXTS</b> (texts). </p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"flags","declared_type":"int","description":"<p>"}],"return_type":null,"var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_get_quota","fqn":"imap_get_quota","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":45788,"end":45802}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"quota_root","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Retrieve the quota level settings, and usage statics per mailbox <i>quota_root</i> should normally be in the form of user.name where name is the mailbox you wish to retrieve information about. </p> mailbox. The value of limit represents the total amount of space allowed for this mailbox. The usage value represents the mailboxes current level of capacity. Will return <b>FALSE</b> in the case of failure. </p> <p> As of PHP 4.3, the function more properly reflects the functionality as dictated by the RFC2087. The array return value has changed to support an unlimited number of returned resources (i.e. messages, or sub-folders) with each named resource receiving an individual array key. Each key value then contains an another array with the usage and limit values within it. </p> <p> For backwards compatibility reasons, the original access methods are still available for use, although it is suggested to update. /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"quota_root","declared_type":"string","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_get_quotaroot","fqn":"imap_get_quotaroot","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":46604,"end":46622}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"mailbox","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Retrieve the quota settings per user <i>quota_root</i> should normally be in the form of which mailbox (i.e. INBOX). </p> mailbox. All values contain a key based upon the resource name, and a corresponding array with the usage and limit values within. </p> <p> This function will return <b>FALSE</b> in the case of call failure, and an array of information about the connection upon an un-parsable response from the server. /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"mailbox","declared_type":"string","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_getacl","fqn":"imap_getacl","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":48312,"end":48323}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"mailbox","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Gets the ACL for a given mailbox The mailbox name, see <b>imap_open</b> for more information </p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"mailbox","declared_type":"string","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_getannotation","fqn":"imap_getannotation","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":48805,"end":48823}},"declared_type":null,"signature":{"parameters":[{"name":"stream_id","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"mailbox","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"attr","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"/","params":[{"name":"stream_id","declared_type":null,"description":null},{"name":"mailbox","declared_type":null,"description":null},{"name":"entry","declared_type":null,"description":null},{"name":"attr","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_getmailboxes","fqn":"imap_getmailboxes","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":55675,"end":55692}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"reference","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Read the list of mailboxes, returning detailed information on each one <i>ref</i> should normally be just the server specification as described in <b>imap_open</b> </p> to start searching.</p>There are two special characters you can pass as part of the <i>pattern</i>: &#x00027;*&#x00027; and &#x00027;&#37;&#x00027;. &#x00027;*&#x00027; means to return all mailboxes. If you pass <i>pattern</i> as &#x00027;*&#x00027;, you will get a list of the entire mailbox hierarchy. &#x00027;&#37;&#x00027; means to return the current level only. &#x00027;&#37;&#x00027; as the <i>pattern</i> parameter will return only the top level mailboxes; &#x00027;~/mail/&#37;&#x00027; on UW_IMAPD will return every mailbox in the ~/mail directory, but none in subfolders of that directory.</p> object has the attributes <i>name</i>, specifying the full name of the mailbox; <i>delimiter</i>, which is the hierarchy delimiter for the part of the hierarchy this mailbox is in; and <i>attributes</i>. <i>Attributes</i> is a bitmask that can be tested against: <p> <b>LATT_NOINFERIORS</b> - This mailbox contains, and may not contain any \"children\" (there are no mailboxes below this one). Calling <b>imap_createmailbox</b> will not work on this mailbox. </p> <p> <b>LATT_NOSELECT</b> - This is only a container, not a mailbox - you cannot open it. </p> <p> <b>LATT_MARKED</b> - This mailbox is marked. This means that it may contain new messages since the last time it was checked. Not provided by all IMAP servers. </p> <p> <b>LATT_UNMARKED</b> - This mailbox is not marked, does not contain new messages. If either <b>MARKED</b> or <b>UNMARKED</b> is provided, you can assume the IMAP server supports this feature for this mailbox. </p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"reference","declared_type":"string","description":"<p>"},{"name":"pattern","declared_type":"string","description":"Specifies where in the mailbox hierarchy"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_getsubscribed","fqn":"imap_getsubscribed","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":58268,"end":58286}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"reference","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"List all the subscribed mailboxes <i>ref</i> should normally be just the server specification as described in <b>imap_open</b> </p> to start searching.</p>There are two special characters you can pass as part of the <i>pattern</i>: &#x00027;*&#x00027; and &#x00027;&#37;&#x00027;. &#x00027;*&#x00027; means to return all mailboxes. If you pass <i>pattern</i> as &#x00027;*&#x00027;, you will get a list of the entire mailbox hierarchy. &#x00027;&#37;&#x00027; means to return the current level only. &#x00027;&#37;&#x00027; as the <i>pattern</i> parameter will return only the top level mailboxes; &#x00027;~/mail/&#37;&#x00027; on UW_IMAPD will return every mailbox in the ~/mail directory, but none in subfolders of that directory.</p> object has the attributes <i>name</i>, specifying the full name of the mailbox; <i>delimiter</i>, which is the hierarchy delimiter for the part of the hierarchy this mailbox is in; and <i>attributes</i>. <i>Attributes</i> is a bitmask that can be tested against: <b>LATT_NOINFERIORS</b> - This mailbox has no \"children\" (there are no mailboxes below this one). <b>LATT_NOSELECT</b> - This is only a container, not a mailbox - you cannot open it. <b>LATT_MARKED</b> - This mailbox is marked. Only used by UW-IMAPD. <b>LATT_UNMARKED</b> - This mailbox is not marked. Only used by UW-IMAPD. /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"reference","declared_type":"string","description":"<p>"},{"name":"pattern","declared_type":"string","description":"Specifies where in the mailbox hierarchy"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_header","fqn":"imap_header","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":53085,"end":53096}},"declared_type":null,"signature":{"parameters":[{"name":"stream_id","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"msg_no","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"from_length","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"subject_length","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"default_host","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"object"},"documentation":{"description":"Alias of <b>imap_headerinfo</b> <dl> <dt>toaddress</dt><dd>full to: line, up to 1024 characters</dd> <dt>to</dt><dd>an array of objects from the To: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>fromaddress</dt><dd>full from: line, up to 1024 characters</dd> <dt>from</dt><dd>an array of objects from the From: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>ccaddress</dt><dd>full cc: line, up to 1024 characters</dd> <dt>cc</dt><dd>an array of objects from the Cc: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>bccaddress</dt><dd>full bcc: line, up to 1024 characters</dd> <dt>bcc</dt><dd>an array of objects from the Bcc: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>reply_toaddress</dt><dd>full Reply-To: line, up to 1024 characters</dd> <dt>reply_to</dt><dd>an array of objects from the Reply-To: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>senderaddress</dt><dd>full sender: line, up to 1024 characters</dd> <dt>sender</dt><dd>an array of objects from the Sender: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>return_pathaddress</dt><dd>full Return-Path: line, up to 1024 characters</dd> <dt>return_path</dt><dd>an array of objects from the Return-Path: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>remail -</dt> <dt>date</dt><dd>The message date as found in its headers</dd> <dt>Date</dt><dd>Same as date</dd> <dt>subject</dt><dd>The message subject</dd> <dt>Subject</dt><dd>Same a subject</dd> <dt>in_reply_to -</dt> <dt>message_id -</dt> <dt>newsgroups -</dt> <dt>followup_to -</dt> <dt>references -</dt> <dt>Recent</dt><dd>R if recent and seen, N if recent and not seen, ' ' if not recent.</dd> <dt>Unseen</dt><dd>U if not seen AND not recent, ' ' if seen OR not seen and recent</dd> <dt>Flagged</dt><dd>F if flagged, ' ' if not flagged</dd> <dt>Answered</dt><dd>A if answered, ' ' if unanswered</dd> <dt>Deleted</dt><dd>D if deleted, ' ' if not deleted</dd> <dt>Draft</dt><dd>X if draft, ' ' if not draft</dd> <dt>Msgno</dt><dd>The message number</dd> <dt>MailDate -</dt> <dt>Size</dt><dd>The message size</dd> <dt>udate</dt><dd>mail message date in Unix time</dd> <dt>fetchfrom</dt><dd>from line formatted to fit fromlength characters</dd> <dt>fetchsubject</dt><dd>subject line formatted to fit subjectlength characters</dd> </dl> /","params":[{"name":"stream_id","declared_type":"resource","description":"An IMAP stream returned by imap_open()."},{"name":"msg_no","declared_type":"int","description":"The message number"},{"name":"from_length","declared_type":"int","description":"[optional] Number of characters for the fetchfrom property. Must be greater than or equal to zero."},{"name":"subject_length","declared_type":"int","description":"[optional] Number of characters for the fetchsubject property Must be greater than or equal to zero."},{"name":"default_host","declared_type":null,"description":"[optional]"}],"return_type":"object","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_headerinfo","fqn":"imap_headerinfo","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":7678,"end":7693}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource|IMAP\\Connection","optional":false,"variadic":false,"by_reference":false},{"name":"message_num","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"from_length","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"subject_length","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"default_host","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"stdClass|false","phpdoc_return_type":"stdClass|false"},"documentation":{"description":"Read the header of the message <dl> <dt>toaddress</dt><dd>full to: line, up to 1024 characters</dd> <dt>to</dt><dd>an array of objects from the To: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>fromaddress</dt><dd>full from: line, up to 1024 characters</dd> <dt>from</dt><dd>an array of objects from the From: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>ccaddress</dt><dd>full cc: line, up to 1024 characters</dd> <dt>cc</dt><dd>an array of objects from the Cc: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>bccaddress</dt><dd>full bcc: line, up to 1024 characters</dd> <dt>bcc</dt><dd>an array of objects from the Bcc: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>reply_toaddress</dt><dd>full Reply-To: line, up to 1024 characters</dd> <dt>reply_to</dt><dd>an array of objects from the Reply-To: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>senderaddress</dt><dd>full sender: line, up to 1024 characters</dd> <dt>sender</dt><dd>an array of objects from the Sender: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>return_pathaddress</dt><dd>full Return-Path: line, up to 1024 characters</dd> <dt>return_path</dt><dd>an array of objects from the Return-Path: line, with the following properties: personal, adl, mailbox, and host</dd> <dt>remail -</dt> <dt>date</dt><dd>The message date as found in its headers</dd> <dt>Date</dt><dd>Same as date</dd> <dt>subject</dt><dd>The message subject</dd> <dt>Subject</dt><dd>Same a subject</dd> <dt>in_reply_to -</dt> <dt>message_id -</dt> <dt>newsgroups -</dt> <dt>followup_to -</dt> <dt>references -</dt> <dt>Recent</dt><dd>R if recent and seen, N if recent and not seen, ' ' if not recent.</dd> <dt>Unseen</dt><dd>U if not seen AND not recent, ' ' if seen OR not seen and recent</dd> <dt>Flagged</dt><dd>F if flagged, ' ' if not flagged</dd> <dt>Answered</dt><dd>A if answered, ' ' if unanswered</dd> <dt>Deleted</dt><dd>D if deleted, ' ' if not deleted</dd> <dt>Draft</dt><dd>X if draft, ' ' if not draft</dd> <dt>Msgno</dt><dd>The message number</dd> <dt>MailDate -</dt> <dt>Size</dt><dd>The message size</dd> <dt>udate</dt><dd>mail message date in Unix time</dd> <dt>fetchfrom</dt><dd>from line formatted to fit fromlength characters</dd> <dt>fetchsubject</dt><dd>subject line formatted to fit subjectlength characters</dd> </dl> /","params":[{"name":"imap","declared_type":"resource|IMAP\\Connection","description":"An IMAP stream returned by imap_open()."},{"name":"message_num","declared_type":"int","description":"The message number"},{"name":"from_length","declared_type":"int","description":"[optional] Number of characters for the fetchfrom property. Must be greater than or equal to zero."},{"name":"subject_length","declared_type":"int","description":"[optional] Number of characters for the fetchsubject property Must be greater than or equal to zero."},{"name":"default_host","declared_type":null,"description":"[optional]"}],"return_type":"stdClass|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_headers","fqn":"imap_headers","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":4381,"end":4393}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Returns headers for all messages in a mailbox element per mail message. /","params":[{"name":"imap","declared_type":"resource","description":null}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_is_open","fqn":"imap_is_open","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":60614,"end":60626}},"declared_type":null,"signature":{"parameters":[