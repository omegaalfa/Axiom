g> ]; ``` /","params":[{"name":"key","declared_type":"string","description":"The set to query"},{"name":"lng","declared_type":"float","description":"The longitude of the location to query."},{"name":"lat","declared_type":"float","description":"The latitude of the location to query."},{"name":"radius","declared_type":"float","description":"The radius of the area to include."},{"name":"unit","declared_type":"string","description":"The unit of the provided radius (defaults to 'meters)."},{"name":"options","declared_type":"array","description":"An array of options that modifies how the command behaves."}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"georadius_ro","fqn":"Redis::georadius_ro","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":50601,"end":50613}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"lng","declared_type":"float","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"lat","declared_type":"float","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"radius","declared_type":"float","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"unit","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"A readonly variant of `GEORADIUS` that may be executed on replicas. $redis->georadius_ro('cities', -122.335167, 47.608013, 100, 'km'); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until