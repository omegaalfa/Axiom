pertyAliases.txt."}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"getPropertyName","fqn":"IntlChar::getPropertyName","kind":"Method","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/IntlChar.php","range":{"start":55203,"end":55218}},"declared_type":null,"signature":{"parameters":[{"name":"property","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"type","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Get the Unicode name for a property <p><b>IntlChar::PROPERTY_INVALID_CODE</b> should not be used. Also, if property is out of range, FALSE is returned.</p> <p>All properties have a long name. Most have a short name, but some do not. Unicode allows for additional names; if present these will be returned by adding 1, 2, etc. to <b>IntlChar::LONG_PROPERTY_NAME</b>.</p> Returns the name, or <b>FALSE</b> if either the <em>property</em> or the <em>nameChoice</em> is out of range. </p> <p> If a given <em>nameChoice</em> returns <b>FALSE</b>, then all larger values of <em>nameChoice</em> will return <b>FALSE</b>, with one exception: if <b>FALSE</b> is returned for <b>IntlChar::SHORT_PROPERTY_NAME</b>, then <b>IntlChar::LONG_PROPERTY_NAME</b> (and higher) may still return a non-<b>FALSE</b> value. </p> /","params":[{"name":"property","declared_type":"int","description":"<p>The Unicode property to lookup (see the IntlChar::PROPERTY_* constants).</p>"},{"name":"type","declared_type":"int","description":"<p> Selector for which name to get. If out of range, FALSE is returned.</p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"getPropertyValueEnum","fqn":"IntlChar::getPropertyValueEnum","kind":"Method","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/IntlChar.php","range":{"start":56199,"end":56219}},"declared_type":null,"signature":{"parameters":[{"name":"property","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Get the property value for a given value name If out of range, or this method doesn't work with the given value, IntlChar::PROPERTY_INVALID_CODE is returned</p> /","params":[{"name":"property","declared_type":"int","description":"<p>The Unicode property to lookup (see the IntlChar::PROPERTY_* constants)."},{"name":"name","declared_type":"string","description":"<p> The value name to be matched. The name is compared using \"loose matching\" as described in PropertyValueAliases.txt.</p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"getPropertyValueName","fqn":"IntlChar::getPropertyValueName","kind":"Method","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/IntlChar.php","range":{"start":58061,"end":58081}},"declared_type":null,"signature":{"parameters":[{"name":"property","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"type","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":null},"documentation":{"description":"Get the Unicode name for a property value The Unicode property to lookup (see the IntlChar::PROPERTY_* constants). If out of range, or this method doesn't work with the given value, FALSE is returned. </p> Selector for a value for the given property. If out of range, <b>FALSE</b> is returned. </p> <p> In general, valid values range from <em>0</em> up to some maximum. There are a couple exceptions: </p><ul> <li> <b>IntlChar::PROPERTY_BLOCK</b> values begin at the non-zero value <b>IntlChar::BLOCK_CODE_BASIC_LATIN</b> </li> <li> <b>IntlChar::PROPERTY_CANONICAL_COMBINING_CLASS</b> values are not contiguous and range from 0..240. </li> </ul> Selector for which name to get. If out of range, FALSE is returned. All values have a long name. Most have a short name, but some do not. Unicode allows for additional names; if present these will be returned by adding 1, 2, etc. to IntlChar::LONG_PROPERTY_NAME. </p> If a given nameChoice returns FALSE, then all larger values of nameChoice will return FALSE, with one exception: if FALSE is returned for IntlChar::SHORT_PROPERTY_NAME, then IntlChar::LONG_PROPERTY_NAME (and higher) may still return a non-FALSE value. /","params":[{"name":"property","declared_type":"int","description":"<p>"},{"name":"value","declared_type":"int","description":"<p>"},{"name":"type","declared_type":"int","description":"[optional] <p>"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"getUnicodeVersion","fqn":"IntlChar::getUnicodeVersion","kind":"Method","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/IntlChar.php","range":{"start":58610,"end":58627}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Get the Unicode version /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"hasBinaryProperty","fqn":"IntlChar::hasBinaryProperty","kind":"Method","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/IntlChar.php","ran