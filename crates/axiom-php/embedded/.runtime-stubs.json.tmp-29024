27;&#37;&#x00027;. &#x00027;*&#x00027; means to return all mailboxes. If you pass <i>pattern</i> as &#x00027;*&#x00027;, you will get a list of the entire mailbox hierarchy. &#x00027;&#37;&#x00027; means to return the current level only. &#x00027;&#37;&#x00027; as the <i>pattern</i> parameter will return only the top level mailboxes; &#x00027;~/mail/&#37;&#x00027; on UW_IMAPD will return every mailbox in the ~/mail directory, but none in subfolders of that directory.</p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"reference","declared_type":"string","description":"<p>"},{"name":"pattern","declared_type":"string","description":"Specifies where in the mailbox hierarchy"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_mail","fqn":"imap_mail","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":49714,"end":49723}},"declared_type":null,"signature":{"parameters":[{"name":"to","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"message","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"additional_headers","declared_type":"?string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"cc","declared_type":"?string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"bcc","declared_type":"?string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"return_path","declared_type":"?string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Send an email message The receiver </p> The mail subject </p> The mail body, see <b>imap_mail_compose</b> </p> As string with additional headers to be set on the mail </p> The receivers specified in <i>bcc</i> will get the mail, but are excluded from the headers. </p> Use this parameter to specify return path upon mail delivery failure. This is useful when using PHP as a mail client for multiple users. </p> /","params":[{"name":"to","declared_type":"string","description":"<p>"},{"name":"subject","declared_type":"string","description":"<p>"},{"name":"message","declared_type":"string","description":"<p>"},{"name":"additional_headers","declared_type":"string","description":"[optional] <p>"},{"name":"cc","declared_type":"string","description":"[optional]"},{"name":"bcc","declared_type":"string","description":"[optional] <p>"},{"name":"return_path","declared_type":"string","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_mail_compose","fqn":"imap_mail_compose","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":24280,"end":24297}},"declared_type":null,"signature":{"parameters":[{"name":"envelope","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"bodies","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Create a MIME message based on given envelope and body sections An associative array of headers fields. Valid keys are: \"remail\", \"return_path\", \"date\", \"from\", \"reply_to\", \"in_reply_to\", \"subject\", \"to\", \"cc\", \"bcc\", \"message_id\" and \"custom_headers\" (which contains associative array of other headers). </p> An indexed array of bodies </p> <p> A body is an associative array which can consist of the following keys: \"type\", \"encoding\", \"charset\", \"type.parameters\", \"subtype\", \"id\", \"description\", \"disposition.type\", \"disposition\", \"contents.data\", \"lines\", \"bytes\" and \"md5\". </p> /","params":[{"name":"envelope","declared_type":"array","description":"<p>"},{"name":"bodies","declared_type":"array","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_mail_copy","fqn":"imap_mail_copy","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":22538,"end":22552}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_nums","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mailbox","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Copy specified messages to a mailbox <i>msglist</i> is a range not just message numbers (as described in RFC2060). </p> The mailbox name, see <b>imap_open</b> for more information </p> <i>options</i> is a bitmask of one or more of <b>CP_UID</b> - the sequence numbers contain UIDS</p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_nums","declared_type":"string","description":"<p>"},{"name":"mailbox","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_mail_move","fqn":"imap_mail_move","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":23305,"end":23319}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_nums","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mailbox","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Move specified messages to a mailbox <i>msglist</i> is a range not just message numbers (as described in RFC2060). </p> The mailbox name, see <b>imap_open</b> for more information </p> <i>options</i> is a bitmask and may contain the single option: <b>CP_UID</b> - the sequence numbers contain UIDS</p> /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_nums","declared_type":"string","description":"<p>"},{"name":"mailbox","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_mailboxmsginfo","fqn":"imap_mailboxmsginfo","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":31697,"end":31716}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"stdClass","phpdoc_return_type":"object|stdClass|false"},"documentation":{"description":"Get information about the current mailbox <table> Mailbox properties <tr valign=\"top\"> <td>Date</td> <td>date of last change (current datetime)</td> </tr> <tr valign=\"top\"> <td>Driver</td> <td>driver</td> </tr> <tr valign=\"top\"> <td>Mailbox</td> <td>name of the mailbox</td> </tr> <tr valign=\"top\"> <td>Nmsgs</td> <td>number of messages</td> </tr> <tr valign=\"top\"> <td>Recent</td> <td>number of recent messages</td> </tr> <tr valign=\"top\"> <td>Unread</td> <td>number of unread messages</td> </tr> <tr valign=\"top\"> <td>Deleted</td> <td>number of deleted messages</td> </tr> <tr valign=\"top\"> <td>Size</td> <td>mailbox size</td> </tr> </table> </p> <p> Returns <b>FALSE</b> on failure. /","params":[{"name":"imap","declared_type":"resource","description":null}],"return_type":"object|stdClass|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_mime_header_decode","fqn":"imap_mime_header_decode","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":43039,"end":43062}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Decode MIME header elements The MIME text </p> object has two properties, charset and text. </p> <p> If the element hasn't been encoded, and in other words is in plain US-ASCII, the charset property of that element is set to default. /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_msgno","fqn":"imap_msgno","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":35414,"end":35424}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_uid","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Gets the message sequence number for the given UID The message UID </p> <i>uid</i>. /","params":[{"name":"imap","declared_type":"resource","description":null},{"name":"message_uid","declared_type":"int","description":"<p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_mutf7_to_utf8","fqn":"imap_mutf7_to_utf8","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":60187,"end":60205}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Decode a modified UTF-7 string to UTF-8 /","params":[{"name":"string","declared_type":"string","description":null}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_myrights","fqn":"imap_myrights","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":48500,"end":48513}},"declared_type":null,"signature":{"parameters":[{"name":"stream_id","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"mailbox","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"/","params":[{"name":"stream_id","declared_type":null,"description":null},{"name":"mailbox","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_num_msg","fqn":"imap_num_msg","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":3653,"end":3665}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Gets the number of messages in the current mailbox /","params":[{"name":"imap","declared_type":"resource","description":null}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_num_recent","fqn":"imap_num_recent","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":4016,"end":4031}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Gets the number of recent messages in current mailbox integer. /","params":[{"name":"imap","declared_type":"resource","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_open","fqn":"imap_open","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":1926,"end":1935}},"declared_type":null,"signature":{"parameters":[{"name":"mailbox","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"user","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"password","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"retries","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Open an IMAP stream to a mailbox A mailbox name consists of a server and a mailbox path on this server. The special name INBOX stands for the current users personal mailbox. Mailbox names that contain international characters besides those in the printable ASCII space have to be encoded width <b>imap_utf7_encode</b>. </p> <p> The server part, which is enclosed in '{' and '}', consists of the servers name or ip address, an optional port (prefixed by ':'), and an optional protocol specification (prefixed by '/'). </p> <p> The server part is mandatory in all mailbox parameters. </p> <p> All names which start with { are remote names, and are in the form \"{\" remote_system_name [\":\" port] [flags] \"}\" [mailbox_name] where: remote_system_name - Internet domain name or bracketed IP address of server.</p> The user name </p> The password associated with the <i>username</i> </p> The <i>options</i> are a bit mask with one or more of the following: <b>OP_READONLY</b> - Open mailbox read-only</p> Number of maximum connect attempts </p> Connection parameters, the following (string) keys maybe used to set one or more connection parameters: DISABLE_AUTHENTICATOR - Disable authentication properties</p> /","params":[{"name":"mailbox","declared_type":"string","description":"<p>"},{"name":"user","declared_type":"string","description":"<p>"},{"name":"password","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"},{"name":"retries","declared_type":"int","description":"[optional] <p>"},{"name":"options","declared_type":"null|array","description":"<p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_ping","fqn":"imap_ping","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":28088,"end":28097}},"declared_type":null,"signature":{"parameters":[{"name":"imap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Check if the IMAP stream is still active /","params":[{"name":"imap","declared_type":"resource","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_qprint","fqn":"imap_qprint","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":28701,"end":28712}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Convert a quoted-printable string to an 8 bit string A quoted-printable string </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_rename","fqn":"imap_rename","kind":"Function","origin":"PhpRuntime","ext