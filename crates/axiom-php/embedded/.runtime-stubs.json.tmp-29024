mentation":{"description":"Functions is an API for managing code to be executed on the server. 'LOAD'      - Create a new library with the given library name and code. 'DELETE'    - Delete the given library. 'LIST'      - Return general information on all the libraries 'STATS'     - Return information about the current function running 'KILL'      - Kill the current running function 'FLUSH'     - Delete all the libraries 'DUMP'      - Return a serialized payload representing the current libraries 'RESTORE'   - Restore the libraries represented by the given payload $redis->function('LIST'); /","params":[{"name":"operation","declared_type":"string","description":"The subcommand you intend to execute.  Valid options are as follows"},{"name":"args","declared_type":"mixed","description":"Additional arguments"}],"return_type":"Redis|bool|string|array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"gcra","fqn":"Redis::gcra","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":190715,"end":190719}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"maxBurst","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"requestsPerPeriod","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"period","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"tokens","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Get rate limiting information for a key using the GCRA (Generic Cell Rate Algorithm). /","params":[{"name":"