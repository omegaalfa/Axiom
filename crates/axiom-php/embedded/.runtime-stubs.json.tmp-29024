n associative array The result handle. </p> fetch_flag is a combination of the constants IBASE_TEXT and IBASE_UNIXTIME ORed together. Passing IBASE_TEXT will cause this function to return BLOB contents instead of BLOB ids. Passing IBASE_UNIXTIME will cause this function to return date/time values as Unix timestamps instead of as formatted strings. </p> Subsequent calls will return the next row in the result set, or false if there are no more rows. /","params":[{"name":"result","declared_type":"resource","description":"<p>"},{"name":"fetch_flag","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_fetch_object","fqn":"fbird_fetch_object","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":32288,"end":32306}},"declared_type":null,"signature":{"parameters":[{"name":"result_id","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"fetch_flag","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"object|false"},"documentation":{"description":"This is an alias of ibase_fetch_object Get an object from a InterBase database An InterBase result identifier obtained either by fbird_query or fbird_execute. </p> fetch_flag is a combination of the constants IBASE_TEXT and IBASE_UNIXTIME ORed together. Passing IBASE_TEXT will cause this function to return BLOB contents instead of BLOB ids. Passing IBASE_UNIXTIME will cause this function to return date/time values as Unix timestamps instead of as formatted strings. </p> no more rows. /","params":[{"name":"result_id","declared_type":"resource","description":"<p>"},{"name":"fetch_flag","declared_type":"int","description":"[optional] <p>"}],"return_type":"object|fa