age. /","params":[],"return_type":"bool","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"implodeimage","fqn":"Gmagick::implodeimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":37832,"end":37844}},"declared_type":null,"signature":{"parameters":[{"name":"radius","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Creates a new image that is a copy of an existing one with the image pixels \"imploded\" by the specified percentage. /","params":[{"name":"radius","declared_type":"float","description":"The radius of the implode."}],"return_type":"mixed","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"labelimage","fqn":"Gmagick::labelimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":38146,"end":38156}},"declared_type":null,"signature":{"parameters":[{"name":"label","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Adds a label to an image. /","params":[{"name":"label","declared_type":"string","description":"The label to add."}],"return_type":"mixed","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"levelimage","fqn":"Gmagick::levelimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":39436,"end":39446}},"declared_type":null,"signature":{"parameters":[{"name":"blackPoint","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"gamma","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"whitePoint","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"channel","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Adjusts the levels of an image. Adjusts the levels of an image by scaling the colors falling between specified white and black points to the full available quantum range. The parameters provided represent the black, mid, and white points. The black point specifies the darkest color in the image. Colors darker than the black point are set to zero. Mid point specifies a gamma correction to apply to the image. White point specifies the lightest color in the image. Colors brighter than the white point are set to the maximum quantum value. To apply to more than one channel, combine channeltype constants using bitwise operators. Refer to this list of channel constants. /","params":[{"name":"blackPoint","declared_type":"float","description":"The image black point."},{"name":"gamma","declared_type":"float","description":"The gamma value."},{"name":"whitePoint","declared_type":"float","description":"The image white point."},{"name":"channel","declared_type":"int","description":"Provide any channel constant that is valid for your channel mode."}],"return_type":"mixed","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"magnifyimage","fqn":"Gmagick::magnifyimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":39755,"end":39767}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Scales an image proportionally 2x. /","params":[],"return_type":"mixed","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mapimage","fqn":"Gmagick::mapimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":40228,"end":40236}},"declared_type":null,"signature":{"parameters":[{"name":"gmagick","declared_type":null,"phpdoc_type":"gmagick","optional":false,"variadic":false,"by_reference":false},{"name":"dither","declared_type":null,"phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Replaces the colors of an image with the closest color from a reference image. /","params":[{"name":"gmagick","declared_type":"gmagick","description":"The reference image."},{"name":"dither","declared_type":"bool","description":"Set this integer value to something other than zero to dither the mapped image."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"medianfilterimage","fqn":"Gmagick::medianfilterimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":40737,"end":40754}},"declared_type":null,"signature":{"parameters":[{"name":"radius","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Applies a digital filter that improves the quality of a noisy image. Each pixel is replaced by the median in a set of neighboring pixels as defined by radius. /","params":[{"name":"radius","declared_type":"float","description":"The radius of the pixel neighborhood."}],"return_type":"void","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"minifyimage","fqn":"Gmagick::minifyimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":41040,"end":41051}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Scales an image proportionally to half its size. /","params":[],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"modulateimage","fqn":"Gmagick::modulateimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":41930,"end":41943}},"declared_type":null,"signature":{"parameters":[{"name":"brightness","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"saturation","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"hue","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Controls the brightness, saturation, and hue. Lets you control the brightness, saturation, and hue of an image. Hue is the percentage of absolute rotation from the current position. For example 50 results in a counter-clockwise rotation of 90 degrees, 150 results in a clockwise rotation of 90 degrees, with 0 and 200 both resulting in a rotation of 180 degrees. /","params":[{"name":"brightness","declared_type":"float","description":"The percent change in brightness (-100 thru +100)."},{"name":"saturation","declared_type":"float","description":"The percent change in saturation (-100 thru +100)."},{"name":"hue","declared_type":"float","description":"The percent change in hue (-100 thru +100)."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"motionblurimage","fqn":"Gmagick::motionblurimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":42792,"end":42807}},"declared_type":null,"signature":{"parameters":[{"name":"radius","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"sigma","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"angle","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Simulates motion blur. We convolve the image with a Gaussian operator of the given radius and standard deviation (sigma). For reasonable results, radius should be larger than sigma. Use a radius of 0 and MotionBlurImage() selects a suitable radius for you. Angle gives the angle of the blurring motion. /","params":[{"name":"radius","declared_type":"float","description":"The radius of the Gaussian, in pixels, not counting the center pixel."},{"name":"sigma","declared_type":"float","description":"The standard deviation of the Gaussian, in pixels."},{"name":"angle","declared_type":"float","description":"Apply the effect along this angle."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"newimage","fqn":"Gmagick::newimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":43332,"end":43340}},"declared_type":null,"signature":{"parameters":[{"name":"width","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"background","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"format","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Creates a new image. /","params":[{"name":"width","declared_type":"int","description":"Width of the new image"},{"name":"height","declared_type":"int","description":"Height of the new image."},{"name":"background","declared_type":"string","description":"The background color used for this image."},{"name":"format","declared_type":"string","description":"[optional] Image format."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"nextimage","fqn":"Gmagick::nextimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":43671,"end":43680}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Moves to the next image. Associates the next image in the image list with an Gmagick object. /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"normalizeimage","fqn":"Gmagick::normalizeimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":44035,"end":44049}},"declared_type":null,"signature":{"parameters":[{"name":"channel","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Enhances the contrast of a color image. /","params":[{"name":"channel","declared_type":"int","description":"[optional] Identify which channel to normalize."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oilpaintimage","fqn":"Gmagick::oilpaintimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":44584,"end":44597}},"declared_type":null,"signature":{"parameters":[{"name":"radius","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Simulates an oil painting. Applies a special effect filter that simulates an oil painting. Each pixel is replaced by the most frequent color occurring in a circular region defined by radius. /","params":[{"name":"radius","declared_type":"float","description":"The radius of the circular neighborhood."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"previousimage","fqn":"Gmagick::previousimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":44965,"end":44978}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Move to the previous image in the object. Associates the previous image in an image list with the Gmagick object. /","params":[],"return_type":"bool","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"profileimage","fqn":"Gmagick::profileimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":45635,"end":45647}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"profile","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Adds or removes a profile from an image. Adds or removes a ICC, IPTC, or generic profile from an image. If the profile is NULL, it is removed from the image otherwise added. Use a name of '*' and a profile of NULL to remove all profiles from the image. /","params":[{"name":"name","declared_type":"string","description":"Name of profile to add or remove: ICC, IPTC, or generic profile."},{"name":"profile","declared_type":"string","description":"The profile."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"quantizeimage","fqn":"Gmagick::quantizeimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":47732,"end":47745}},"declared_type":null,"signature":{"parameters":[{"name":"numColors","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"colorspace","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"treeDepth","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"dither","declared_type":null,"phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false},{"name":"measureError","declared_type":null,"phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Analyzes the colors within a reference image. Analyzes the colors within a reference image and chooses a fixed number of colors to represent the image. The goal of the algorithm is to minimize the color difference between the input and output image while minimizing the processing time. A zero or one tells Quantize to choose a optimal tree depth of Log4(number_colors). A tree of this depth generally allows the best representation of the reference image with the least amount of memory and the fastest computational speed. In some cases, such as an image with low color dispersion (a few number of colors), a value other than Log4(number_colors) is required. To expand the color tree completely, use a value of 8. corresponding color reduced algorithm to neighboring pixels along a Hilbert curve. images. This difference is the total quantization error. The error is computed by summing over all pixels in an image the distance squared in RGB space between each reference pixel value and its quantized value. /","params":[{"name":"numColors","declared_type":"int","description":"The number of colors."},{"name":"colorspace","declared_type":"int","description":"Perform color reduction in this colorspace, typically RGBColorspace."},{"name":"treeDepth","declared_type":"int","description":"Normally, this integer value is zero or one."},{"name":"dither","declared_type":"bool","description":"A value other than zero distributes the difference between an original image and the"},{"name":"measureError","declared_type":"bool","description":"A value other than zero measures the difference between the original and quantized"}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"quantizeimages","fqn":"Gmagick::quantizeimages","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":49859,"end":49873}},"declared_type":null,"signature":{"parameters":[{"name":"numColors","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"colorspace","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"treeDepth","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"dither","declared_type":null,"phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false},{"name":"measureError","declared_type":null,"phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"The quantizeimages purpose. Analyzes the colors within a sequence of images and chooses a fixed number of colors to represent the image. The goal of the algorithm is to minimize the color difference between the input and output image while minimizing the processing time. A zero or one tells Quantize to choose a optimal tree depth of Log4(number_colors). A tree of this depth generally allows the best representation of the reference image with the least amount of memory and the fastest computational speed. In some cases, such as an image with low color dispersion (a few number of colors), a value other than Log4(number_colors) is required. To expand the color tree completely, use a value of 8. corresponding color reduced algorithm to neighboring pixels along a Hilbert curve. images. This difference is the total quantization error. The error is computed by summing over all pixels in an image the distance squared in RGB space between eac reference pixel value and its quantized value. /","params":[{"name":"numColors","declared_type":"int","description":"The number of colors."},{"name":"colorspace","declared_type":"int","description":"Perform color reduction in this colorspace, typically RGBColorspace."},{"name":"treeDepth","declared_type":"int","description":"Normally, this integer value is zero or one."},{"name":"dither","declared_type":"bool","description":"A value other than zero distributes the difference between an original image and the"},{"name":"measureError","declared_type":"bool","description":"A value other than zero measures the difference between the original and quantized"}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryfontmetrics","fqn":"Gmagick::queryfontmetrics","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":50253,"end":50269}},"declared_type":null,"signature":{"parameters":[{"name":"draw","declared_type":null,"phpdoc_type":"GmagickDraw","optional":false,"variadic":false,"by_reference":false},{"name":"text","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Returns an array representing the font metrics. /","params":[{"name":"draw","declared_type":"GmagickDraw","description":null},{"name":"text","declared_type":"string","description":null}],"return_type":"array","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryfonts","fqn":"Gmagick::queryfonts","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":50561,"end":50571}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Returns fonts supported by Gmagick. /","params":[{"name":"pattern","declared_type":"string","description":"[optional]"}],"return_type":"array","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"i