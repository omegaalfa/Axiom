"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Draw a line x-coordinate for first point. </p> y-coordinate for first point. </p> x-coordinate for second point. </p> y-coordinate for second point. </p> The line color. A color identifier created with imagecolorallocate. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"x1","declared_type":"int","description":"<p>"},{"name":"y1","declared_type":"int","description":"<p>"},{"name":"x2","declared_type":"int","description":"<p>"},{"name":"y2","declared_type":"int","description":"<p>"},{"name":"color","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imageloadfont","fqn":"imageloadfont","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":43704,"end":43717}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"Load a new font The font file format is currently binary and architecture dependent. This means you should generate the font files on the same type of CPU as the machine you are running PHP on. </p> <p> <table> Font file format <tr valign=\"top\"> <td>byte position</td> <td>C data type</td> <td>description</td> </tr> <tr valign=\"top\"> <td>byte 0-3</td> <td>int</td> <td>number of characters in the font</td> </tr> <tr valign=\"top\"> <td>byte 4-7</td> <td>int</td> <td> value of first character in the font (often 32 for space) </td> </tr> <tr valign=\"top\"> <td>byte 8-11</td> <td>int</td> <td>pixel width of each character</td> </tr> <tr valign=\"top\"> <td>byte 12-15</td> <td>int</td> <td>pixel height of each character</td> </tr> <tr valign=\"top\"> <td>byte 16-</td> <td>char</td> <td> array with character data, one byte per pixel in each character, for a total of (nchars*width*height) bytes. </td> </tr> </table> </p> built-in fonts or false on errors. /","params":[{"name":"filename","declared_type":"string","description":"<p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imageopenpolygon","fqn":"imageopenpolygon","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":75369,"end":75385}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"points","declared_type":"array","phpdoc_type":"int[]","optional":false,"variadic":false,"by_reference":false},{"name":"num_points_or_color","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"color","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false},{"name":"color","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"<b>imageopenpolygon()</b> draws an open polygon on the given <b>image.</b> Contrary to {@see imagepolygon()}, no line is drawn between the last and the first point. <pre> points[0]\t= x0 points[1]\t= y0 points[2]\t= x1 points[3]\t= y1 </pre> /","params":[{"name":"image","declared_type":"resource|GdImage","description":"An image resource, returned by one of the image creation functions, such as {@see imagecreatetruecolor()}."},{"name":"points","declared_type":"int[]","description":"An array containing the polygon's vertices, e.g.:"},{"name":"num_points_or_color","declared_type":"int","description":"Total number of points (vertices)."},{"name":"color","declared_type":"int|null","description":"A color identifier created with {@see imagecolorallocate()}."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagepalettecopy","fqn":"imagepalettecopy","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":7144,"end":7160}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"src","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Copy the palette from one image to another The destination image resource. </p> The source image resource. </p> /","params":[{"name":"dst","declared_type":"resource|GdImage","description":"<p>"},{"name":"src","declared_type":"resource|GdImage","description":"<p>"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagepalettetotruecolor","fqn":"imagepalettetotruecolor","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":101087,"end":101110}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Converts a palette based image to true color An image resource, returnd by one of the image creation functions, such as {@link https://php.net/manual/en/function.imagecreatetruecolor.php imagecreatetruecolor()}. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":"<p>"}],"retu