c":false,"by_reference":false},{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":"RedisCluster|bool"},"documentation":{"description":"Copy a key to another key. Note that in a cluster both keys must map to the same slot. /","params":[{"name":"src","declared_type":"string","description":"The key to copy."},{"name":"dst","declared_type":"string","description":"The destination key."},{"name":"options","declared_type":"array|null","description":"An array with options to modify how the command behaves (e.g. ['REPLACE' => true])."}],"return_type":"RedisCluster|bool","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dbSize","fqn":"RedisCluster::dbSize","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":116170,"end":116176}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int","phpdoc_return_type":"RedisCluster|int"},"documentation":{"description":"Returns the current database's size at a specific node. <pre> $count = $redisCluster->dbSize('x'); echo \"Redis has $count keys\\n\"; </pre> /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"}],"return_type":"RedisCluster|int","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"decr","fqn":"RedisCluster::decr","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":62851,"end":62855}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"by","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Decrement the number stored at key by one. <pre> $redisCluster->decr('key1'); // key1 didn't exists, set to 0 before the increment and now has the value -1 $redisCluster->decr('key1'); // -2 $redisCluster->decr('key1'); // -3 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"by","declared_type":"int","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"decrBy","fqn":"RedisCluster::decrBy","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":64545,"end":64551}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Decrement the number stored at key by one. If the second argument is filled, it will be used as the integer value of the decrement. <pre> $redisCluster->decr('key1');        // key1 didn't exists, set to 0 before the increment and now has the value -1 $redisCluster->decr('key1');        // -2 $redisCluster->decr('key1');        // -3 $redisCluster->decrBy('key1', 10);  // -13 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"int","description":"that will be subtracted to key (only for decrBy)"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"decrbyfloat","fqn":"RedisCluster::decrbyfloat","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":151380,"end":151391}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float","phpdoc_return_type":"float"},"documentation":{"description":"Decrement a floating point value stored at a key by the provided amount. /","params":[{"name":"key","declared_type":"string","description":"The key to decrement."},{"name":"value","declared_type":"float","description":"How much to decrement the value."}],"return_type":"float","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"del","fqn":"RedisCluster::del","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":6855,"end":6858}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array|string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"int"},"documentation":{"description":"Remove specified keys. ... keyN <pre> $redisCluster->set('key1', 'val1'); $redisCluster->set('key2', 'val2'); $redisCluster->set('key3', 'val3'); $redisCluster->set('key4', 'val4'); $redisCluster->del('key1', 'key2');