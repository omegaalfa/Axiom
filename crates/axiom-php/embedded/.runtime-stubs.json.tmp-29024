ect how the signature is verified - see PKCS7 constants for more information. </p> If the <i>outfilename</i> is specified, it should be a string holding the name of a file into which the certificates of the persons that signed the messages will be stored in PEM format. </p> If the <i>cainfo</i> is specified, it should hold information about the trusted CA certificates to use in the verification process - see certificate verification for more information about this parameter. </p> If the <i>extracerts</i> is specified, it is the filename of a file containing a bunch of certificates to use as untrusted CAs. </p> You can specify a filename with <i>content</i> that will be filled with the verified data, but with the signature information stripped. </p> (the message has been tampered with, or the signing certificate is invalid), or -1 on error. /","params":[{"name":"input_filename","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"<p>"},{"name":"signers_certificates_filename","declared_type":"string|null","description":"[optional] <p>"},{"name":"ca_info","declared_type":"array","description":"<p>"},{"name":"untrusted_certificates_filename","declared_type":"string|null","description":"[optional] <p>"},{"name":"content","declared_type":"string|null","description":"[optional] <p>"},{"name":"output_filename","declared_type":"string|null","description":"[optional]"}],"return_type":"bool|int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"openssl_pkey_derive","fqn":"openssl_pkey_derive","kind":"Function","origin":"PhpRuntime","extension":"openssl","location":{"file":"openssl/openssl.php","range":{"start":47303,"end":47322}},"declared_type":null,"signature":{"parameters":[{"name":"public_key","declared_type":null,"phpdoc_type":"OpenSSLAsymmetricKey|OpenSSLCertificate|array|string","optional":false,"variadic":false,"by_reference":false},{"name":"private_key","d