d","origin":"PhpRuntime","extension":"FFI","location":{"file":"FFI/FFI.php","range":{"start":11251,"end":11260}},"declared_type":null,"signature":{"parameters":[{"name":"type","declared_type":"CType","phpdoc_type":"CType","optional":false,"variadic":false,"by_reference":false},{"name":"dimensions","declared_type":"array","phpdoc_type":"array<array-key, int<0, max>>","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"CType","phpdoc_return_type":"CType"},"documentation":{"description":"Constructs a new C array type with elements of $type and dimensions specified by `$dimensions`. ```php $ffi = FFI::cdef(); $t1 = $ffi->type('int[2][3]'); $t2 = FFI::arrayType($ffi->type('int'), [2, 3]); ``` of {@see FFI\\CType} which has already been created. the type as {@see array}. /","params":[{"name":"type","declared_type":"CType","description":"A valid C declaration as string, or an instance"},{"name":"dimensions","declared_type":"array<array-key, int<0, max>>","description":"The dimensions of"}],"return_type":"CType","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"cast","fqn":"FFI::cast","kind":"Method","origin":"PhpRuntime","extension":"FFI","location":{"file":"FFI/FFI.php","range":{"start":9007,"end":9011}},"declared_type":null,"signature":{"parameters":[{"name":"type","declared_type":"CType|string","phpdoc_type":"CType|string","optional":false,"variadic":false,"by_reference":false},{"name":"ptr","declared_type":null,"phpdoc_type":"CData|int|float|bool|null","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"CData|null"},"documentation":{"description":"Creates a new {@see FFI\\CData} object, that references the same C data structure, but is associated with a different type. The resulting object does not own the C data, and the source ptr must survive the result. The C type may be specified as a {@see string} with any valid C type declaration or as {@see FFI\\CType} object, created before. Any type declared for the instance is allowed. Note: Calling {@see FFI::cast()} statically is deprecated since PHP 8.3. ```php $ffi = FFI::cdef(); $int32Value = $ffi->new('int32_t'); $int16Array = $ffi->cast('int16_t[2]', $int32Value); ``` an instance of {@see FFI\\CType} which has already been created. to a C data structure. or {@see null} on failure for PHP versions prior to 8.4. /","params":[{"name":"type","declared_type":"CType|string","description":"A valid C declaration as {@see string}, or"},{"name":"ptr","declared_type":"CData|int|float|bool|null","description":"The handle of the pointer"}],"return_type":"CData|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"cdef","fqn":"FFI::cdef","kind":"Method","origin":"PhpRuntime","extension":"FFI","location":{"file":"FFI/FFI.php","range":{"start":2125,"end":2129}},"declared_type":null,"signature":{"parameters":[{"name":"code","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"lib","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"FFI","phpdoc_return_type":"FFI"},"documentation":{"description":"The method creates a binding on the existing C function. All variables and functions defined by first arguments are bound to corresponding native symbols in a DSO library and then may be accessed as FFI object methods and properties. C types of argument, return value, and variables are automatically converted to/from PHP types (if possible). Otherwise, they are wrapped in a special CData proxy object and may be accessed by elements. in regular C language (types, structures, functions, variables, etc). Actually, this string may be copy-pasted from C header files. Note: C preprocessor directives are not supported, i.e. `#include`, `#define` and CPP macros do not work. loaded and linked with the definitions. Note: If lib is omitted or {@see null}, platforms supporting RTLD_DEFAULT attempt to lookup symbols declared in code in the normal global scope. Other systems will fail to resolve these symbols. /","params":[{"name":"code","declared_type":"string","description":"A string containing a sequence of declarations"},{"name":"lib","declared_type":"string|null","description":"The name of a shared library file, to be"}],"return_type":"FFI","var_type":null,"throws":["ParserException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"free","fqn":"FFI::free","kind":"Method","origin":"PhpRuntime","extension":"FFI","location":{"file":"FFI/FFI.php","range":{"start":7578,"end":7582}},"declared_type":null,"signature":{"parameters":[{"name":"ptr","declared_type":"CData","phpdoc_type":"CData","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":null},"documentation":{"description":"Manually removes previously created \"not-owned\" data structure. /","params":[{"name":"ptr","declared_type":"CData","description":"The handle of the unmanaged pointer to a C data structure."}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"isNull","fqn":"FFI::isNull","kind":"Method","origin":"PhpRuntime","extension":"FFI","location":{"file":"FFI/FFI.php","range":{"start":16068,"end":16074}},"declared_type":null,"signature":{"parameters":[{"name":"ptr","declared_type":"CData","phpdoc_type":"CData","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Checks whether the FFI\\CData is a null pointer. /","params":[{"name":"ptr","declared_type":"CData","description":"The handle of the pointer to a C data structure."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"load","fqn":"FFI::load","kind":"Method","origin":"PhpRuntime","extension":"FFI","location":{"file":"FFI/FFI.php","range":{"start":4028,"end":4032}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"?FFI","phpdoc_return_type":"FFI|null"},"documentation":{"description":"Instead of embedding of a long C definition into a PHP string and creating FFI through {@see FFI::cdef()}, it's possible to separate it into a C header file. Note that C preprocessor directives (e.g., `#define` or `#ifdef`) are not supported. And only a couple of special macros may be used, especially for FFI. ```c #define FFI_LIB \"libc.so.6\" int printf(const char *format, ...); ``` Here, `FFI_LIB` specifies that the given library should be loaded. ```php $ffi = FFI::load(__DIR__ . \"/printf.h\"); $ffi->printf(\"Hello world!\\n\"); ``` directives are not supported, i.e. `#include`, `#define` and CPP macros do not work, except for special cases listed below. The header file should contain a #define statement for the `FFI_SCOPE` variable, e.g.: `#define FFI_SCOPE \"MYLIB\"`. Refer to the class introduction for details. The header file may contain a `#define` statement for the `FFI_LIB` variable to specify the library it exposes. If it is a system library only the file name is required, e.g.: `#define FFI_LIB \"libc.so.6\"`. If it is a custom library, a relative path is required, e.g.: `#define FFI_LIB \"./mylib.so\"`. or {@see null} on failure. /","params":[{"name":"filename","declared_type":"string","description":"The name of a C header file. C preprocessor"}],"return_type":"FFI|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"memcmp","fqn":"FFI::memcmp","kind":"Method","origin":"PhpRuntime","extension":"FFI","location":{"file":"FFI/FFI.php","range":{"start":14384,"end":14390}},"declared_type":null,"signature":{"parameters":[{"name":"ptr1","declared_type":null,"phpdoc_type":"CData|string","optional":false,"variadic":false,"by_reference":false},{"name":"ptr2","declared_type":null,"phpdoc_type":"CData|string","optional":false,"variadic":false,"by_reference":false},{"name":"size","declared_type":"int","phpdoc_type":"int<0, max>","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int<-1, 1>"},"documentation":{"description":"Compares `$size` bytes from the memory areas `$ptr1` and `$ptr2`. Both `$ptr1` and `$ptr2` can be any native data structures ({@see FFI\\CData}) or PHP strings. memory area starting at `$ptr1` are considered less than the contents of the memory area starting at `$ptr2`, a value greater than 0 if the contents of the first memory area are considered greater than the second, and 0 if they are equal. /","params":[{"name":"ptr1","declared_type":"CData|string","description":"The start of one memory area."},{"name":"ptr2","declared_type":"CData|string","description":"The start of another memory area."},{"name":"size","declared_type":"int<0, max>","description":"The number of bytes to compare."}],"return_type":"int<-1, 1>","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"memcpy","fqn":"FFI::memcpy","kind":"Method","origin":"PhpRuntime","extension":"FFI","location":{"file":"FFI/FFI.php","range":{"start":13393,"end":13399}},"declared_type":null,"signature":{"parameters":[{"name":"to","declared_type":"CData","phpdoc_type":"CData","optional":false,"variadic":false,"by_reference":false},{"name":"from","declared_type":null,"phpdoc_type":"CData|string","optional":false,"variadic":false,"by_reference":false},{"name":"size","declared_type":"int","phpdoc_type":"int<0, max>","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":