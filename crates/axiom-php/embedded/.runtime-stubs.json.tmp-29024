[PREG_PATTERN_ORDER] => 1 [PREG_SET_ORDER] => 2 [PREG_OFFSET_CAPTURE] => 256 [PREG_SPLIT_NO_EMPTY] => 1 [PREG_SPLIT_DELIM_CAPTURE] => 2 [PREG_SPLIT_OFFSET_CAPTURE] => 4 [PREG_GREP_INVERT] => 1 ) [user] => Array ( [MY_CONSTANT] => 1 ) ) </pre> </p> /","params":[{"name":"categorize","declared_type":"bool","description":"[optional] <p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"get_defined_functions","fqn":"get_defined_functions","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":26253,"end":26274}},"declared_type":null,"signature":{"parameters":[{"name":"exclude_disabled","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Returns an array of all defined functions functions, both built-in (internal) and user-defined. The internal functions will be accessible via $arr[\"internal\"], and the user defined ones using $arr[\"user\"] (see example below). /","params":[{"name":"exclude_disabled","declared_type":"bool","description":"[optional] Whether disabled functions should be excluded from the return value."}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"get_defined_vars","fqn":"get_defined_vars","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":26640,"end":26656}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Returns an array of all defined variables /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"get_error_handler","fqn":