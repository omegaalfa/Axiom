Read messages from one or more streams as part of a consumer group. /","params":[{"name":"group","declared_type":"string","description":"The consumer group to read as."},{"name":"consumer","declared_type":"string","description":"The consumer within the group to read as."},{"name":"streams","declared_type":"array","description":"An associative array of stream name => ID from which to read."},{"name":"count","declared_type":"int","description":"The maximum number of messages to return per stream."},{"name":"block","declared_type":"int","description":"How long to block (in milliseconds) if no messages are available."}],"return_type":"RedisCluster|bool|array","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xrevrange","fqn":"RedisCluster::xrevrange","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":185711,"end":185720}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|array","phpdoc_return_type":"RedisCluster|bool|array"},"documentation":{"description":"Get a range of messages from a stream in reverse chronological order. /","params":[{"name":"key","declared_type":"string","description":"The stream to query."},{"name":"start","declared_type":"string","description":"The maximum message ID to include."},{"name":"end","declared_type":"string","description":"The minimum message ID to include."},{"name":"count","declared_type":"int","description":"An optional maximum number of messages to include."}],"return_type":"RedisCluster|bool|array","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xtrim","fqn":"RedisCluster::xtrim","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":186550,"end":186555}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"maxlen","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"approx","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"minid","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Truncate a stream to a given maximum length or minimum ID. /","params":[{"name":"key","declared_type":"string","description":"The stream to trim."},{"name":"maxlen","declared_type":"int","description":"The maximum length (or minimum ID when $minid is true)."},{"name":"approx","declared_type":"bool","description":"Whether redis is allowed to do an approximate trimming of the stream."},{"name":"minid","declared_type":"bool","description":"When true, $maxlen is treated as a minimum ID rather than a maximum length."},{"name":"limit","declared_type":"int","description":"An optional upper bound on how many entries to trim during the command."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zAdd","fqn":"RedisCluster::zAdd","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":47829,"end":47833}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"score_or_options","declared_type":"array|float","phpdoc_type":"array|float","optional":false,"variadic":false,"by_reference":false},{"name":"more_scores_and_mems","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|int|float|false","phpdoc_return_type":null},"documentation":{"description":"Adds the specified member with a given score to the sorted set stored at key. <pre> $redisCluster->zAdd('z', 1, 'v2', 2, 'v2', 3, 'v3', 4, 'v4' );  // int(3) $redisCluster->zRem('z', 'v2', 'v3');                           // int(2) var_dump( $redisCluster->zRange('z', 0, -1) ); //// Output: // array(1) { //   [0]=> string(2) \"v4\" // } </pre> /","params":[{"name":"key","declared_type":"string","description":"Required key"},{"name":"score_or_options","declared_type":"array|float","description":null},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zCard","fqn":"RedisCluster::zCard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":44723,"end":44728}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Returns the cardinality of an ordered set. <pre> $redisCluster->zAdd('key', 0, 'val0'); $redisCluster->zAdd('key', 2, 'val2'); $redisCluster->zAdd('key', 10, 'val10'); $redisCluster->zCard('key');            // 3 </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zCount","fqn":"RedisCluster::zCount","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":45598,"end":45604}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Returns the number of elements of the sorted set stored at the specified key which have scores in the range [start,end]. Adding a parenthesis before start or end excludes it from the range. +inf and -inf are also valid limits. <pre> $redisCluster->zAdd('key', 0, 'val0'); $redisCluster->zAdd('key', 2, 'val2'); $redisCluster->zAdd('key', 10, 'val10'); $redisCluster->zCount('key', 0, 3); // 2, corresponding to array('val0', 'val2') </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"start","declared_type":"string","description":null},{"name":"end","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zdiff","fqn":"RedisCluster::zdiff","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":192836,"end":192841}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":"RedisCluster|array|false"},"documentation":{"description":"Compute the difference of one or more sorted sets and return the result. /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted set key names."},{"name":"options","declared_type":"array|null","description":"Options to modify how the command behaves (e.g. ['withscores' => true])."}],"return_type":"RedisCluster|array|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zdiffstore","fqn":"RedisCluster::zdiffstore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":191587,"end":191597}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Compute the difference of one or more sorted sets and store the result in a new sorted set. /","params":[{"name":"dst","declared_type":"string","description":"The destination sorted set."},{"name":"keys","declared_type":"array","description":"One or more sorted set key names."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zIncrBy","fqn":"RedisCluster::zIncrBy","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":48715,"end":48722}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|float|false","phpdoc_return_type":null},"documentation":{"description":"Increments the score of a member from a sorted set by a given amount. <pre> $redisCluster->del('key'); $redisCluster->zIncrBy('key', 2.5, 'member1');// key or member1 didn't exist, so member1's score is to 0 ; //before the increment and now has the value 2.5 $redisCluster->zIncrBy('key', 1, 'member1');    // 3.5 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"float","description":"(double) value that will be added to the member's score"},{"name":"member","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zinter","fqn":"RedisCluster::zinter","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":191020,"end":191026}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":"RedisCluster|array|false"},"documentation":{"description":"Compute the intersection of one or more sorted sets and return the result. /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted set key names."},{"name":"weights","declared_type":"array|null","description":"An optional array of weights to apply to each sorted set."},{"name":"options","declared_type":"array|null","description":"Options to modify how the command behaves (e.g. ['aggregate' => 'sum', 'withscores' => true])."}],"return_type":"RedisCluster|array|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zintercard","fqn":"RedisCluster::zintercard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":187200,"end":187210}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Compute the intersection of one or more sorted sets and return the cardinality of the result. /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted set key names."},{"name":"limit","declared_type":"int","description":"A maximum cardinality to return. This puts an upper bound on the work Redis will do."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zinterstore","fqn":"RedisCluster::zinterstore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":95611,"end":95622}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":"?array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false},{"name":"aggregate","declared_type":"?string","phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Intersect multiple sorted sets and store the resulting sorted set in a new key defines the behaviour to use on duplicate entries during the zInterStore. <pre> $redisCluster->del('k1'); $redisCluster->del('k2'); $redisCluster->del('k3'); $redisCluster->del('ko1'); $redisCluster->del('ko2'); $redisCluster->del('ko3'); $redisCluster->del('ko4'); $redisCluster->zAdd('k1', 0, 'val0'); $redisCluster->zAdd('k1', 1, 'val1'); $redisCluster->zAdd('k1', 3, 'val3'); $redisCluster->zAdd('k2', 2, 'val1'); $redisCluster->zAdd('k2', 3, 'val3'); $redisCluster->zInterStore('ko1', array('k1', 'k2'));               // 2, 'ko1' => array('val1', 'val3') $redisCluster->zInterStore('ko2', array('k1', 'k2'), array(1, 1));  // 2, 'ko2' => array('val1', 'val3') // Weighted zInterStore $redisCluster->zInterStore('ko3', array('k1', 'k2'), array(1, 5), 'min'); // 2, 'ko3' => array('val1', 'val3') $redisCluster->zInterStore('ko4', array('k1', 'k2'), array(1, 5), 'max'); // 2, 'ko4' => array('val3', 'val1') </pre> /","params":[{"name":"dst","declared_type":"string","description":null},{"name":"keys","declared_type":"array","description":null},{"name":"weights","declared_type":"null|array","description":null},{"name":"aggregate","declared_type":"null|string","description":"Either \"SUM\", \"MIN\", or \"MAX\":"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zLexCount","fqn":"RedisCluster::zLexCount","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":91440,"end":91449}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Count the number of members in a sorted set between a given lexicographical range. <pre> foreach (array('a', 'b', 'c', 'd', 'e', 'f', 'g') as $k => $char) { $redisCluster->zAdd('key', $k, $char); } $redisCluster->zLexCount('key', '[b', '[f'); // 5 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"min","declared_type":"string","description":null},{"name":"max","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zmpop","fqn":"RedisCluster::zmpop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":146983,"end":146988}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"from","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|null|false","phpdoc_return_type":"RedisCluster|array|null|false"},"documentation":{"description":"Pop one or more of the highest or lowest scoring members from one or more sorted sets. /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted sets to pop from."},{"name":"from","declared_type":"string","description":"The string 'MIN' or 'MAX' to pop the lowest or highest scoring members."},{"name":"count","declared_type":"int","description":"The maximum number of elements to pop."}],"return_type":"RedisCluster|array|null|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zMscore","fqn":"RedisCluster::zMscore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":190319,"end":190326}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"other_members","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":"RedisCluster|array|false"},"documentation":{"description":"Get the scores of one or more members in a sorted set. /","params":[{"name":"key","declared_type":"string","description":"The sorted set to query."},{"name":"member","declared_type":"mixed","description":"The first member to look up."},{"name":"","declared_type":null,"description":null}],"return_type":"RedisCluster|array|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zPopMax","fqn":"RedisCluster::zPopMax","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":187692,"end":187699}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|array","phpdoc_return_type":"RedisCluster|bool|array"},"documentation":{"description":"Pop one or more of the highest scoring members from a sorted set. /","params":[{"name":"key","declared_type":"string","description":"The sorted set to pop from."},{"name":"value","declared_type":"int|null","description":"The number of members to pop."}],"return_type":"RedisCluster|bool|array","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zPopMin","fqn":"RedisCluster::zPopMin","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":188184,"end":188191}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|array","phpdoc_return_type":"RedisCluster|bool|array"},"documentation":{"description":"Pop one or more of the lowest scoring members from a sorted set. /","params":[{"name":"key","declared_type":"string","description":"The sorted set to pop from."},{"name":"value","declared_type":"int|null","description":"The number of members to pop."}],"return_type":"RedisCluster|bool|array","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRandMember","fqn":"RedisCluster::zRandMember","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":189697,"end":189708}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|string|array","phpdoc_return_type":"RedisCluster|string|array"},"documentation":{"description":"Get one or more random members from a sorted set. /","params":[{"name":"key","declared_type":"string","description":"The sorted set to query."},{"name":"options","declared_type":"array|null","description":"An array of options to modify how the command behaves (e.g. ['COUNT' => n, 'WITHSCORES' => true])."}],"return_type":"RedisCluster|string|array","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRange","fqn":"RedisCluster::zRange","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":85775,"end":85781}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|bool|null","phpdoc_type":"array|bool|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|bool","phpdoc_return_type":null},"documentation":{"description":"Returns a range of elements from the ordered set stored at the specified key, with values in the range [start, end]. start and stop are interpreted as zero-based indices: 0 the first element, 1 the second ... -1 the last element, -2 the penultimate ... <pre> $redisCluster->zAdd('key1', 0, 'val0'); $redisCluster->zAdd('key1', 2, 'val2'); $redisCluster->zAdd('key1', 10, 'val10'); $redisCluster->zRange('key1', 0, -1); // array('val0', 'val2', 'val10') // with scores $redisCluster->zRange('key1', 0, -1, true); // array('val0' => 0, 'val2' => 2, 'val10' => 10) </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"start","declared_type":"mixed","description":null},{"name":"end","declared_type":"mixed","description":null},{"name":"options","declared_type":"array|bool|null","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRangeByLex","fqn":"RedisCluster::zRangeByLex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":90242,"end":90253}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns a range of members in a sorted set, by lexicographical range <pre> foreach (array('a', 'b', 'c', 'd', 'e', 'f', 'g') as $k => $char) { $redisCluster->zAdd('key', $k, $char); } $redisCluster->zRangeByLex('key', '-', '[c'); // array('a', 'b', 'c') $redisCluster->zRangeByLex('key', '-', '(c'); // array('a', 'b') $redisCluster->zRevRangeByLex('key', '(c','-'); // array('b', 'a') </pre> /","params":[{"name":"key","declared_type":"string","description":"The ZSET you wish to run against."},{"name":"min","declared_type":"string","description":"The minimum alphanumeric value you wish to get."},{"name":"max","declared_type":"string","description":"The maximum alphanumeric value you wish to get."},{"name":"offset","declared_type":"int","description":"Optional argument if you wish to start somewhere other than the first element."},{"name":"count","declared_type":"int","description":"Optional argument if you wish to limit the number of elements returned."}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRangeByScore","fqn":"RedisCluster::zRangeByScore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":88613,"end":88626}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":null},"documentation":{"description":"Returns the elements of the sorted set stored at the specified key which have scores in the range [start,end]. Adding a parenthesis before start or end excludes it from the range. +inf and -inf are also valid limits. zRevRangeByScore returns the same items in reverse order, when the start and end parameters are swapped. - withscores => TRUE, - and limit => array($offset, $count) <pre> $redisCluster->zAdd('key', 0, 'val0'); $redisCluster->zAdd('key', 2, 'val2'); $redisCluster->zAdd('key', 10, 'val10'); $redisCluster->zRangeByScore('key', 0, 3); // array('val0', 'val2') $redisCluster->zRangeByScore('key', 0, 3, array('withscores' => TRUE); // array('val0' => 0, 'val2' => 2) $redisCluster->zRangeByScore('key', 0, 3, array('limit' => array(1, 1)); // array('val2' => 2) $redisCluster->zRangeByScore('key', 0, 3, array('limit' => array(1, 1)); // array('val2') $redisCluster->zRangeByScore('key', 0, 3, array('withscores' => TRUE, 'limit' => array(1, 1)); // array('val2'=> 2) </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"start","declared_type":"string","description":null},{"name":"end","declared_type":"string","description":null},{"name":"options","declared_type":"array","description":"Two options are available:"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zrangestore","fqn":"RedisCluster::zrangestore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":189058,"end":189069}},"declared_type":null,"signature":{"parameters":[{"name":"dstkey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"srckey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|bool|null","phpdoc_type":"array|bool|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":"RedisCluster|int|false"},"documentation":{"description":"Store a range of a sorted set into a new sorted set. Note that both keys must map to the same slot. /","params":[{"name":"dstkey","declared_type":"string","description":"The destination sorted set."},{"name":"srckey","declared_type":"string","description":"The source sorted set."},{"name":"start","declared_type":"int","description":"The minimum index (or score/lex value depending on options)."},{"name":"end","declared_type":"int","description":"The maximum index (or score/lex value depending on options)."},{"name":"options","declared_type":"array|bool|null","description":"Options to modify how the range is selected (e.g. ['BYSCORE'], ['REV'])."}],"return_type":"RedisCluster|int|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRank","fqn":"RedisCluster::zRank","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":61309,"end":61314}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Returns the rank of a given member in the specified sorted set, starting at 0 for the item with the smallest score. zRevRank starts at 0 for the item with the largest score. <pre> $redisCluster->del('z'); $redisCluster->zAdd('key', 1, 'one'); $redisCluster->zAdd('key', 2, 'two'); $redisCluster->zRank('key', 'one');     // 0 $redisCluster->zRank('key', 'two');     // 1 $redisCluster->zRevRank('key', 'one');  // 1 $redisCluster->zRevRank('key', 'two');  // 0 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"member","declared_type":"mixed","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRem","fqn":"RedisCluster::zRem","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":96473,"end":96477}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_values","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Deletes a specified member from the ordered set. <pre> $redisCluster->zAdd('z', 1, 'v1', 2, 'v2', 3, 'v3', 4, 'v4' );  // int(2) $redisCluster->zRem('z', 'v2', 'v3');                           // int(2) var_dump( $redisCluster->zRange('z', 0, -1) ); //// Output: // // array(2) { //   [0]=> string(2) \"v1\" //   [1]=> string(2) \"v4\" // } </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"string","description":null},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRemRangeByLex","fqn":"RedisCluster::zRemRangeByLex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":92373,"end":92387}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Remove all members in a sorted set between the given lexicographical range. <pre> foreach (array('a', 'b', 'c', 'd', 'e', 'f', 'g') as $k => $char) { $redisCluster->zAdd('key', $k, $char); } $redisCluster->zRemRangeByLex('key', '(b','[d'); // 2 , remove element 'c' and 'd' $redisCluster->zRange('key',0,-1);// array('a','b','e','f','g') </pre> /","params":[{"name":"key","declared_type":"string","description":"The ZSET you wish to run against."},{"name":"min","declared_type":"string","description":"The minimum alphanumeric value you wish to get."},{"name":"max","declared_type":"string","description":"The maximum alphanumeric value you wish to get."}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRemRangeByRank","fqn":"RedisCluster::zRemRangeByRank","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":78298,"end":78313}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Deletes the elements of the sorted set stored at the specified key which have rank in the range [start,end]. <pre> $redisCluster->zAdd('key', 1, 'one'); $redisCluster->zAdd('key', 2, 'two'); $redisCluster->zAdd('key', 3, 'three'); $redisCluster->zRemRangeByRank('key', 0, 1); // 2 $redisCluster->zRange('key', 0, -1, true); // array('three' => 3) </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"start","declared_type":"int","description":null},{"name":"end","declared_type":"int","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRemRangeByScore","fqn":"RedisCluster::zRemRangeByScore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":46448,"end":46464}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Deletes the elements of the sorted set stored at the specified key which have scores in the range [start,end]. <pre> $redisCluster->zAdd('key', 0, 'val0'); $redisCluster->zAdd('key', 2, 'val2'); $redisCluster->zAdd('key', 10, 'val10'); $redisCluster->zRemRangeByScore('key', '0', '3'); // 2 </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"start","declared_type":"string","description":"double or \"+inf\" or \"-inf\" as a string"},{"name":"end","declared_type":"string","description":"double or \"+inf\" or \"-inf\" as a string"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRevRange","fqn":"RedisCluster::zRevRange","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":86922,"end":86931}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|array","phpdoc_return_type":null},"documentation":{"description":"Returns the elements of the sorted set stored at the specified key in the range [start, end] in reverse order. start and stop are interpretated as zero-based indices: 0 the first element, 1 the second ... -1 the last element, -2 the penultimate ... <pre> $redisCluster->zAdd('key', 0, 'val0'); $redisCluster->zAdd('key', 2, 'val2'); $redisCluster->zAdd('key', 10, 'val10'); $redisCluster->zRevRange('key', 0, -1); // array('val10', 'val2', 'val0') // with scores $redisCluster->zRevRange('key', 0, -1, true); // array('val10' => 10, 'val2' => 2, 'val0' => 0) </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"start","declared_type":"string","description":null},{"name":"end","declared_type":"string","description":null},{"name":"options","declared_type":"null|array","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRevRangeByLex","fqn":"RedisCluster::zRevRangeByLex","kind":"Meth