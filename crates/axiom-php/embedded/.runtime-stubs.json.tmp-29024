,"by_reference":false},{"name":"status","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"headers","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"body","declared_type":"mixed","phpdoc_type":"string|resource|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"?array","phpdoc_return_type":"array|null"},"documentation":{"description":"Notifies the user request listeners of the imminence of a commit, and allows for the replacement of the response. /","params":[{"name":"span","declared_type":"\\DDTrace\\RootSpanData","description":"the span associated with this user request."},{"name":"status","declared_type":"int","description":"the HTTP status code of the response"},{"name":"headers","declared_type":"array","description":"the HTTP headers of the response in the form name => array(values)"},{"name":"body","declared_type":"string|resource|null","description":"the body of the response (a string or a seekable resource)"}],"return_type":"array|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"notify_start","fqn":"DDTrace\\UserRequest\\notify_start","kind":"Function","origin":"PhpRuntime","extension":"ddtrace","location":{"file":"ddtrace/ddtrace.stub.php","range":{"start":29296,"end":29308}},"declared_type":null,"signature":{"parameters":[{"name":"span","declared_type":"\\DDTrace\\RootSpanData","phpdoc_type":"\\DDTrace\\RootSpanData","optional":false,"variadic":false,"by_reference":false},{"name":"data","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"body","declared_type":"mixed","phpdoc_type":"string|resource|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"?array","phpdoc_return_type":"array|null"},"documentation":{"description":"Notifies the user request listeners of the start of a user request. /","params":[{"name":"span","declared_type":"\\DDTrace\\RootSpanData","description":"the span associated with this user request."},{"name":"data","declared_type":"array","description":"an array with keys named '_GET', '_POST', '_SERVER', '_FILES', '_COOKIE'"},{"name":"body","declared_type":"string|resource|null","description":"the body of the request (a string or a seekable resource)"}],"return_type":"array|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set_blocking_function","fqn":"DDTrace\\UserRequest\\set_blocking_function","kind":"Function","origin":"PhpRuntime","extension":"ddtrace","location":{"file":"ddtrace/ddtrace.stub.php","range":{"start":30336,"end":30357}},"declared_type":null,"signature":{"parameters":[{"name":"span","declared_type":"\\DDTrace\\RootSpanData","phpdoc_type":"\\DDTrace\\RootSpanData","optional":false,"variadic":false,"by_reference":false},{"name":"blockingFunction","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":null},"documentation":{"description":"Sets a function to be called when blocking a request midway. /","params":[{"name":"span","declared_type":"\\DDTrace\\RootSpanData","description":null},{"name":"blockingFunction","declared_type":"callable","description":"a blocking function taking an array with the keys 'status', 'headers', 'body'"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ddtrace_config_app_name","fqn":"ddtrace_config_app_name","kind":"Function","origin":"PhpRuntime","extension":"ddtrace","location":{"file":"ddtrace/ddtrace.stub.php","range":{"start":34038,"end":34061}},"declared_type":null,"signature":{"parameters":[{"name":"fallbackName","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"?string","phpdoc_return_type":"string|null"},"documentation":{"description":"Get the name of the app (DD_SERVICE) fallback name is provided. /","params":[{"name":"fallbackName","declared_type":"string|null","description":"Fallback name if the app's name wasn't set"}],"return_type":"string|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ddtrace_config_distributed_tracing_enabled","fqn":"ddtrace_config_distributed_tracing_enabled","kind":"Function","origin":"PhpRuntime","extension":"ddtrace","location":{"file":"ddtrace/ddtrace.stub.php","range":{"start":34288,"end":34330}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Check if distributed tracing is enabled (DD_DISTRIBUTED_TRACING) /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ddtrace_config_integration_enabled","fqn":"ddtrace_config_integration_enabled","kind":"Function","origin":"PhpRuntime","extension":"ddtrace","location":{"file":"ddtrace/ddtrace.stub.php","range":{"start":34792,"end":34826}},"declared_type":null,"signature":{"parameters":[{"name":"integrationName","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Check if a specific integration is enabled /","params":[{"name":"integrationName","declared_type":"string","description":"The name of the integration (e.g., mysqli)"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ddtrace_config_trace_enabled","fqn":"ddtrace_config_trace_enabled","kind":"Function","origin":"PhpRuntime","extension":"ddtrace","location":{"file":"ddtrace/ddtrace.stub.php","range":{"start":34496,"end":34524}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Check if tracing is enabled (DD_TRACE_ENABLED) /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"debug_backtrace","fqn":"debug_backtrace","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":33057,"end":33072}},"declared_type":null,"signature":{"parameters":[{"name":"options","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Generates a backtrace As of 5.3.6, this parameter is a bitmask for the following options:</p> <b>debug_backtrace</b> options <table> <tr valign=\"top\"> <td>DEBUG_BACKTRACE_PROVIDE_OBJECT</td> <td> Whether or not to populate the \"object\" index. </td> </tr> <tr valign=\"top\"> <td>DEBUG_BACKTRACE_IGNORE_ARGS</td> <td> Whether or not to omit the \"args\" index, and thus all the function/method arguments, to save memory. </td> </tr> </table> <p> Before 5.3.6, the only values recognized are true or false, which are the same as setting or not setting the <b>DEBUG_BACKTRACE_PROVIDE_OBJECT</b> option respectively. </p> As of 5.4.0, this parameter can be used to limit the number of stack frames returned. By default (<i>limit</i>=0) it returns all stack frames. </p> are as follows: </p> <p> Possible returned elements from <b>debug_backtrace</b> </p> <table> <tr valign=\"top\"> <td>Name</td> <td>Type</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>function</td> <td>string</td> <td> The current function name. See also __FUNCTION__. </td> </tr> <tr valign=\"top\"> <td>line</td> <td>integer</td> <td> The current line number. See also __LINE__. </td> </tr> <tr valign=\"top\"> <td>file</td> <td>string</td> <td> The current file name. See also __FILE__. </td> </tr> <tr valign=\"top\"> <td>class</td> <td>string</td> <td> The current class name. See also __CLASS__ </td> </tr> <tr valign=\"top\"> <td>object</td> <td>object</td> <td> The current object. </td> </tr> <tr valign=\"top\"> <td>type</td> <td>string</td> <td> The current call type. If a method call, \"->\" is returned. If a static method call, \"::\" is returned. If a function call, nothing is returned. </td> </tr> <tr valign=\"top\"> <td>args</td> <td>array</td> <td> If inside a function, this lists the functions arguments. If inside an included file, this lists the included file name(s). </td> </tr> </table> /","params":[{"name":"options","declared_type":"int","description":"[optional] <p>"},{"name":"limit","declared_type":"int","description":"[optional] <p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"debug_print_backtrace","fqn":"debug_print_backtrace","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":33846,"end":33867}},"declared_type":null,"signature":{"parameters":[{"name":"options","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Prints a backtrace As of 5.3.6, this parameter is a bitmask for the following options: <b>debug_print_backtrace</b> options <table> <tr valign=\"top\"> <td><b>DEBUG_BACKTRACE_IGNORE_ARGS</b></td> <td> Whether or not to omit the \"args\" index, and thus all the function/method arguments, to save memory. </td> </tr> </table> </p> As of 5.4.0, this parameter can be used to limit the number of stack frames printed. By default (<i>limit</i> = 0) it prints all stack frames. </p> /","params":[{"name":"options","declared_type":"int","description":"[optional] <p>"},{"name":"limit","declared_type":"int","description":"[optional] <p>"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"debug_zval_dump","fqn":"debug_zval_dump","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":8619,"end":8634}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"values","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Dumps a string representation of an internal zend value to output The other variable being evaluated. </p> /","params":[{"name":"value","declared_type":"mixed","description":"The variable being evaluated."},{"name":"","declared_type":null,"description":null}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"debugger_connect","fqn":"debugger_connect","kind":"Function","origin":"PhpRuntime","extension":"ZendDebugger","location":{"file":"ZendDebugger/ZendDebugger.php","range":{"start":180,"end":196}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"debugger_connector_pid","fqn":"debugger_co