ox","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"minid","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Truncate a STREAM key in various ways. MAXLEN - An integer describing the maximum desired length of the stream after the command. MINID  - An ID that will become the new minimum ID in the stream, as Redis will trim all messages older than this ID. more efficient for Redis given how streams are stored internally. /","params":[{"name":"key","declared_type":"string","description":"The STREAM key to trim."},{"name":"threshold","declared_type":"string","description":"This can either be a maximum length, or a minimum id."},{"name":"approx","declared_type":"bool","description":"Whether redis is allowed to do an approximate trimming of the stream.  This is"},{"name":"minid","declared_type":"bool","description":"When set to `true`, users should pass a minimum ID to the `$threshold` argument."},{"name":"limit","declared_type":"int","description":"An optional upper bound on how many entries to trim during the command."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zAdd","fqn":"Redis::zAdd","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":194906,"end":194910}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"score_or_options","declared_type":"array|float","phpdoc_type":"array|float","optional":false,"variadic":false,"by_reference":false},{"name":"more_scores_and_mems","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|float|false","phpdoc_return_type":"Redis|int|float|false"},"documentation":{"description":"Add one or more elements and scores to a Redis sorted set. ```php $options = [ 'NX',       # Only update elements that already exist 'NX',       # Only add new elements but don't update existing ones. 'LT'        # Only update existing elements if the new score is # less than the existing one. 'GT'        # Only update existing elements if the new score is # greater than the existing one. 'CH'        # Instead of returning the number of elements added, # Redis will return the number Of elements that were # changed in the operation. 'INCR'      # Instead of setting each element to the provide score, # increment the element by the # provided score, much like ZINCRBY.  When this option # is passed, you may only send a single score and member. ]; ``` Note:  'GX', 'LT', and 'NX' cannot be passed together, and PhpRedis will send whichever one is last in the options array. Following is information about the options that may be passed as the second argument: $redis->zadd('zs', 1, 'first', 2, 'second', 3, 'third'); $redis->zAdd('zs', ['XX'], 8, 'second', 99, 'new-element'); /","params":[{"name":"key","declared_type":"string","description":"The sorted set in question."},{"name":"score_or_options","declared_type":"array|float","description":"Either the score for the first element, or an array of options."},{"name":"more_scores_and_mems","declared_type":"mixed","description":"A variadic number of additional scores and members."}],"return_type":"Redis|int|float|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zCard","fqn":"Redis::zCard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":195382,"end":195387}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Return the number of elements in a sorted set. /","params":[{"name":"key","declared_type":"string","description":"The sorted set to retrieve cardinality from."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zCount","fqn":"Redis::zCount","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":196177,"end":196183}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"int|string","phpdoc_type":"int|string","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"int|string","phpdoc_type":"int|string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":null},"documentation":{"description":"Count the number of members in a sorted set with scores inside a provided range. NOTE:  In addition to a floating point score you may pass the special values of '-inf' and '+inf' meaning negative and positive infinity, respectively. $redis->zCount('fruit-rankings', '0', '+inf'); $redis->zCount('fruit-rankings', 50, 60); $redis->zCount('fruit-rankings', '-inf', 0); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to check."},{"name":"start","declared_type":"int|string","description":"The minimum score to include in the count"},{"name":"end","declared_type":"int|string","description":"The maximum score to include in the count"}],"return_type":null,"var_type":null,"throws":[],"dep