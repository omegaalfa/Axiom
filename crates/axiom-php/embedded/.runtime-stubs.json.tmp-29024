deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"acosh","fqn":"acosh","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":7444,"end":7449}},"declared_type":null,"signature":{"parameters":[{"name":"num","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float","phpdoc_return_type":"float"},"documentation":{"description":"Inverse hyperbolic cosine The value to process </p> /","params":[{"name":"num","declared_type":"float","description":"<p>"}],"return_type":"float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"add","fqn":"add","kind":"Function","origin":"PhpRuntime","extension":"libsodium","location":{"file":"libsodium/libsodium.php","range":{"start":14674,"end":14677}},"declared_type":null,"signature":{"parameters":[{"name":"left","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"right","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Add the right operand to the left /","params":[{"name":"","declared_type":null,"description":null},{"name":"right","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addcslashes","fqn":"addcslashes","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":25131,"end":25142}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"characters","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Quote string with slashes in a C style The string to be escaped. </p> A list of characters to be escaped. If characters contains characters \\n, \\r etc., they are converted in C-like style, while other non-alphanumeric characters with ASCII codes lower than 32 and higher than 126 converted to octal representation. </p> <p> When you define a sequence of characters in the characters argument make sure that you know what characters come between the characters that you set as the start and end of the range. </p> <pre> <?php echo addcslashes('foo[ ]', 'A..z'); // output:  \\f\\o\\o\\[ \\] // All upper and lower-case letters will be escaped // ... but so will the [\\]^_` ?> </pre> <p> Also, if the first character in a range has a higher ASCII value than the second character in the range, no range will be constructed. Only the start, end and period characters will be escaped. Use the ord function to find the ASCII value for a character. </p> <pre> <?php echo addcslashes(\"zoo['.']\", 'z..A'); // output:  \\zoo['\\.'] ?> </pre> <p> Be careful if you choose to escape characters 0, a, b, f, n, r, t and v. They will be converted to \\0, \\a, \\b, \\f, \\n, \\r, \\t and \\v, all of which are predefined escape sequences in C. Many of these sequences are also defined in other C-derived languages, including PHP, meaning that you may not get the desired result if you use the output of addcslashes() to generate code in those languages with these characters defined in characters. </p> <p> Example usage: </p> <code> <?php $not_escaped = \"PHP isThirty\\nYears Old!\\tYay to the Elephant!\\n\"; $escaped = addcslashes($not_escaped, \"\\0..\\37!@\\177..\\377\"); echo $escaped; ?> </code> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"characters","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addslashes","fqn":"addslashes","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":23099,"end":23109}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Quote string with slashes The string to be escaped. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addSubscriber","fqn":"addSubscriber","kind":"Function","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/Monitoring/functions.php","range":{"start":547,"end":560}},"declared_type":null,"signature":{"parameters":[{"name":"subscriber","declared_type":"Subscriber","phpdoc_type":"Subscriber","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":null},"documentation":{"description":"Registers a new monitoring event subscriber with the driver. Registered subscribers will be notified of monitoring events through specific methods. Note: If the object is already registered, this function is a no-op. /","params":[{"name":"subscriber","declared_type":"Subscriber","description":"A monitoring event subscriber object to register."}],"return_type":null,"var_type":null,"throws":["\\InvalidArgumentException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"apache_child_terminate","fqn":"apache_child_terminate","kind":"Function","origin":"PhpRuntime","extension":"apache","location":{"file":"apache/apache.php","ran