nce":null,"until":null},"is_static":true},{"name":"compressFiles","fqn":"PharData::compressFiles","kind":"Method","origin":"PhpRuntime","extension":"Phar","location":{"file":"Phar/Phar.php","range":{"start":57701,"end":57714}},"declared_type":null,"signature":{"parameters":[{"name":"compression","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"(PHP &gt;= 5.3.0, PECL phar &gt;= 2.0.0)<br/> Compresses all files in the current Phar archive Compression must be one of Phar::GZ, Phar::BZ2 to add compression, or Phar::NONE to remove compression. </p> variable is on, the zlib extension is not available, or if any files are compressed using bzip2 compression and the bzip2 extension is not enabled. /","params":[{"name":"compression","declared_type":"int","description":"<p>"}],"return_type":"void","var_type":null,"throws":["\\BadMethodCallException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"convertToData","fqn":"PharData::convertToData","kind":"Method","origin":"PhpRuntime","extension":"Phar","location":{"file":"Phar/Phar.php","range":{"start":64537,"end":64550}},"declared_type":null,"signature":{"parameters":[{"name":"format","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"compression","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"extension","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"?PharData","phpdoc_return_type":"PharData|null"},"documentation":{"description":"(PHP &gt;= 5.3.0, PECL phar &gt;= 2.0.0)<br/> Convert a phar archive to a non-executable tar or zip file This should be one of Phar::TAR or Phar::ZIP. If set to <b>NULL</b>, the existing file format will be preserved. </p> This should be one of Phar::NONE for no whole-archive compression, Phar::GZ for zlib-based compression, and Phar::BZ2 for bzip-based compression. </p> This parameter is used to override the default file extension for a converted archive. Note that .phar cannot be used anywhere in the filename for a non-executable tar or zip archive. </p> <p> If converting to a tar-based phar archive, the default extensions are .tar, .tar.gz, and .tar.bz2 depending on specified compression. For zip-based archives, the default extension is .zip. </p> exception on failure. compress, an unknown compression method has been specified, the requested archive is buffering with Phar::startBuffering and has not concluded with Phar::stopBuffering. any problems are encountered during the phar creation process. /","params":[{"name":"format","declared_type":"int","description":"[optional] <p>"},{"name":"compression","declared_type":"int","description":"[optional] <p>"},{"name":"extension","declared_type":"string","description":"[optional] <p>"}],"return_type":"PharData|null","var_type":null,"throws":["\\BadMethodCallException","\\PharException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"convertToExecutable","fqn":"PharData::convertToExecutable","kind":"Method","origin":"PhpRuntime","extension":"Phar","location":{"file":"Phar/Phar.php","range":{"start":62522,"end":62541}},"declared_type":null,"signature":{"parameters":[{"name":"format","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"compression","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"extension","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"?Phar","phpdoc_return_type":"Phar|null"},"documentation":{"description":"(PHP &gt;= 5.3.0, PECL phar &gt;= 2.0.0)<br/> Convert a phar archive to another executable phar archive file format This should be one of Phar::PHAR, Phar::TAR, or Phar::ZIP. If set to <b>NULL</b>, the existing file format will be preserved. </p> This should be one of Phar::NONE for no whole-archive compression, Phar::GZ for zlib-based compression, and Phar::BZ2 for bzip-based compression. </p> This parameter is used to override the default file extension for a converted archive. Note that all zip- and tar-based phar archives must contain .phar in their file extension in order to be processed as a phar archive. </p> <p> If converting to a phar-based archive, the default extensions are .phar, .phar.gz, or .phar.bz2 depending on the specified compression. For tar-based phar archives, the default extensions are .phar.tar, .phar.tar.gz, and .phar.tar.bz2. For zip-based phar archives, the default extension is .phar.zip. </p> exception on failure. compress, an unknown compression method has been specified, the requested archive is buffering with Phar::startBuffering and has not concluded with Phar::stopBuffering. UnexpectedValueException if write support is disabled. are encountered during the phar creation process. /","params":[{"name":"format","declared_type":"int","description":"[optional] <p>"},{"name":"compression","declared_type":"int","description":"[optional] <p>"},{"name":"extension","declared_type":"string","description":"[optional] <p>"}],"return_type":"Phar|null","var_type":null,"throws":["\\BadMethodCallException","\\UnexpectedValueException","\\PharException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"copy","fqn":"PharData::copy","kind":"Method","origin":"PhpRuntime","extension":"Phar","location":{"file":"Phar/Phar.php","range":{"start":65712,"end":65716}},"declared_type":null,"signature":{"parameters":[{"name":"from","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"to","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_referenc