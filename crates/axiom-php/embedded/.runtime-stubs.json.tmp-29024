>zDiff(['primes', 'evens', 'mod3']); /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted sets."},{"name":"options","declared_type":"array|null","description":"An array which can contain ['WITHSCORES' => true] if you want Redis to"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zdiffstore","fqn":"Redis::zdiffstore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":215874,"end":215884}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Store the difference of one or more sorted sets in a destination sorted set. See {@link Redis::zdiff} for a more detailed description of how the diff operation works. failure. $redis->zdiffstore('only:new', ['all:users', 'inactive:users']); /","params":[{"name":"dst","declared_type":"string","description":"The destination set name."},{"name":"keys","declared_type":"array","description":"One or more source key names"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zIncrBy","fqn":"Redis::zIncrBy","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":196757,"end":196764}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|float|false","phpdoc_return_type":"Redis|float|false"},"documentation":{"description":"Create or increment the score of a member in a Redis sorted set $redis->zIncrBy('zs', 5.0, 'bananas'); $redis->zIncrBy('zs', 2.0, 'eggplants'); /","params":[{"name":"key","declared_type":"string","description":"The sorted set in question."},{"name":"value","declared_type":"float","description":"How much to increment the score."}],"return_type":"Redis|float|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zInter","fqn":"Redis::zInter","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":14515,"end":14521}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":null,"phpdoc_type":"mixed|null","optional":true,"variadic":false,"by_reference":false},{"name":"aggregate","declared_type":null,"phpdoc_type":"mixed|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"mixed","description":null},{"name":"keys","declared_type":"mixed","description":null},{"name":"weights","declared_type":"mixed|null","description":null},{"name":"aggregate","declared_type":"mixed|null","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zinter","fqn":"Redis::zinter","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":216978,"end":216984}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Compute the intersection of one or more sorted sets and return the members the intersection. intersection.  See Redis::zunion() for details. $redis->zAdd('TNG', 2, 'Worf', 2.5, 'Data', 4.0, 'Picard'); $redis->zAdd('DS9', 2.5, 'Worf', 3.0, 'Kira', 4.0, 'Sisko'); $redis->zInter(['TNG', 'DS9']); $redis->zInter(['TNG', 'DS9'], NULL, ['withscores' => true]); $redis->zInter(['TNG', 'DS9'], NULL, ['withscores' => true, 'aggregate' => 'max']); /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted sets."},{"name":"weights","declared_type":"array|null","description":"An optional array of weights to be applied to each set when performing"},{"name":"options","declared_type":"array|null","description":"Options for how Redis should combine duplicate elements when performing the"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zintercard","fqn":"Redis::zintercard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":218029,"end":218039}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Similar to ZINTER but instead of returning the intersected values, this command returns the cardinality of the intersected set. greater than zero, Redis will stop processing the intersection once the resulting cardinality reaches this limit. $redis->zAdd('zs1', 1, 'one', 2, 'two', 3, 'three', 4, 'four'); $redis->zAdd('zs2', 2, 'two', 4, 'four'); $redis->zInterCard(['zs1', 'zs2']); /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted set key names."},{"name":"limit","declared_type":"int","description":"An optional upper bound on the returned cardinality.  If set to a value"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zinterstore","fqn":"Redis::zinterstore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":219445,"end":219456}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"aggregate","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Compute the intersection of one or more sorted sets storing the result in a new sorted set. 'SUM' - Store sum of all intersected members (this is the default). 'MIN' - Store minimum value for each intersected member. 'MAX' - Store maximum value for each intersected member. $redis->zAdd('zs1', 3, 'apples', 2, 'pears'); $redis->zAdd('zs2', 4, 'pears', 3, 'bananas'); $redis->zAdd('zs3', 2, 'figs', 3, 'pears'); $redis->zInterStore('fruit-sum', ['zs1', 'zs2', 'zs3']); $redis->zInterStore('fruit-max', ['zs1', 'zs2', 'zs3'], NULL, 'MAX'); /","params":[{"name":"dst","declared_type":"string","description":"The destination sorted set to store the intersected values."},{"name":"keys","declared_type":"array","description":"One or more sorted set key names."},{"name":"weights","declared_type":"array|null","description":"An optional array of floats to weight each passed input set."},{"name":"aggregate","declared_type":"string|null","description":"An optional aggregation method to use."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zLexCount","fqn":"Redis::zLexCount","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":197524,"end":197533}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Count the number of elements in a sorted set whose members fall within the provided lexographical range. $redis->zAdd('captains', 0, 'Janeway', 0, 'Kirk', 0, 'Picard', 0, 'Sisko', 0, 'Archer'); $redis->zLexCount('captains', '[A', '[S'); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to check."},{"name":"min","declared_type":"string","description":"The minimum matching lexographical string"},{"name":"max","declared_type":"string","description":"The maximum matching lexographical string"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zmpop","fqn":"Redis::zmpop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":19057,"end":19062}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"from","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|null|false","phpdoc_return_type":"Redis|array|null|false"},"documentation":{"description":"POP one or more of the highest or lowest scoring elements from one or more sorted sets. pop the lowest or highest scoring elements. $redis->zmpop(['scores:high', 'scores:low'], 'MAX', 2); /","params":[{"name":"keys","declared_type":"array","description":"One or more sorted sets"},{"name":"from","declared_type":"string","description":"The string 'MIN' or 'MAX' (case insensitive) telling Redis whether you want to"},{"name":"count","declared_type":"int","description":"Pop up to how many elements at once."}],"return_type":"Redis|array|null|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zMscore","fqn":"Redis::zMscore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":198278,"end":198285}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"other_members","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Retrieve the score of one or more members in a sorted set. $redis->zAdd('zs', 0, 'zero', 1, 'one', 2, 'two', 3, 'three'); $redis->zMScore('zs', 'zero', 'two'); $redis->zMScore('zs', 'one', 'not-a-member'); /","params":[{"name":"key","declared_type":"string","description":"The sorted set"},{"name":"member","declared_type":"mixed","description":"The first member to return the score from"},{"name":"other_members","declared_type":"mixed","description":"One or more additional members to return the scores of."}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zPopMax","fqn":"Redis::zPopMax","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":198943,"end":198950}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Pop one or more of the highest scoring elements from a sorted set. $redis->zAdd('zs', 0, 'zero', 1, 'one', 2, 'two', 3, 'three'); $redis->zPopMax('zs'); $redis->zPopMax('zs', 2);. /","params":[{"name":"key","declared_type":"string","description":"The sorted set to pop elements from."},{"name":"count","declared_type":"int|null","description":"An optional count of elements to pop."}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zPopMin","fqn":"Redis::zPopMin","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":199586,"end":199593}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Pop one or more of the lowest scoring elements from a sorted set. $redis->zAdd('zs', 0, 'zero', 1, 'one', 2, 'two', 3, 'three'); $redis->zPopMin('zs'); $redis->zPopMin('zs', 2); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to pop elements from."},{"name":"count","declared_type":"int|null","description":"An optional count of elements to pop."}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRandMember","fqn":"Redis::zRandMember","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":205806,"end":205817}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|string|array","phpdoc_return_type":"Redis|string|array"},"documentation":{"description":"Retrieve one or more random members from a Redis sorted set. OPTION       TYPE    MEANING 'COUNT'      int     The number of random members to return. 'WITHSCORES' bool    Whether to return scores and members instead of $redis->zRandMember('zs', ['COUNT' => 2, 'WITHSCORES' => true]); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to pull random members from."},{"name":"options","declared_type":"array|null","description":"One or more options that determine exactly how the command operates."}],"return_type":"Redis|string|array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRange","fqn":"Redis::zRange","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":201524,"end":201530}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"string|int","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"string|int","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|bool|null","phpdoc_type":"array|bool|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Retrieve a range of elements of a sorted set between a start and end point. How the command works in particular is greatly affected by the options that are passed in. the command, or for historical purposes a boolean which controls just the 'WITHSCORES' option. ```php $options = [ 'WITHSCORES' => true,     # Return both scores and members. 'LIMIT'      => [10, 10], # Start at offset 10 and return 10 elements. 'REV'                     # Return the elements in reverse order 'BYSCORE',                # Treat `start` and `end` as scores instead 'BYLEX'                   # Treat `start` and `end` as lexicographical values. ]; ``` Note:  `BYLEX` and `BYSCORE` are mutually exclusive. $redis->zRange('zset', 0, -1); $redis->zRange('zset', '-inf', 'inf', ['byscore']); /","params":[{"name":"key","declared_type":"string","description":"The sorted set in question."},{"name":"start","declared_type":"mixed","description":"The starting index we want to return."},{"name":"end","declared_type":"mixed","description":"The final index we want to return."},{"name":"options","declared_type":"array|bool|null","description":"This value may either be an array of options to pass to"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRangeByLex","fqn":"Redis::zRangeByLex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":202608,"end":202619}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Retrieve a range of elements from a sorted set by legographical range. $redis = new Redis(['host' => 'localhost']); $redis->zAdd('captains', 0, 'Janeway', 0, 'Kirk', 0, 'Picard', 0, 'Sisko', 0, 'Archer'); $redis->zRangeByLex('captains', '[A', '[S'); $redis->zRangeByLex('captains', '[A', '[S', 2, 2); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to retrieve elements from"},{"name":"min","declared_type":"string","description":"The minimum legographical value to return"},{"name":"max","declared_type":"string","description":"The maximum legographical value to return"},{"name":"offset","declared_type":"int","description":"An optional offset within the matching values to return"},{"name":"count","declared_type":"int","description":"An optional count to limit the replies to (used in conjunction with offset)"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRangeByScore","fqn":"Redis::zRangeByScore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":203749,"end":203762}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Retrieve a range of members from a sorted set by their score. OPTION       TYPE            MEANING 'WITHSCORES' bool            Whether to also return scores. 'LIMIT'      [offset, count] Limit the reply to a subset of elements. $redis->zRangeByScore('zs', 20, 30, ['WITHSCORES' => true]); $redis->zRangeByScore('zs', 20, 30, ['WITHSCORES' => true, 'LIMIT' => [5, 5]]); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to query."},{"name":"start","declared_type":"string","description":"The minimum score of elements that Redis should return."},{"name":"end","declared_type":"string","description":"The maximum score of elements that Redis should return."},{"name":"options","declared_type":"array","description":"Options that change how Redis will execute the command."}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zrangestore","fqn":"Redis::zrangestore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":204846,"end":204857}},"declared_type":null,"signature":{"parameters":[{"name":"dstkey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"srckey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"end","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|bool|null","phpdoc_type":"array|bool|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"This command is similar to ZRANGE except that instead of returning the values directly it will store them in a destination key provided by the user See {@link Redis::zRange} for a full description of the possible options. $redis->zrangestore('recent:leaders', 'leaders', '0', '9'); /","params":[{"name":"dstkey","declared_type":"string","description":"The key to store the resulting element(s)"},{"name":"srckey","declared_type":"string","description":"The source key with element(s) to retrieve"},{"name":"start","declared_type":"string","description":"The starting index to store"},{"name":"end","declared_type":"string","description":"The ending index to store"},{"name":"options","declared_type":"array|bool|null","description":"Our options array that controls how the command will function."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRank","fqn":"Redis::zRank","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":206310,"end":206315}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Get the rank of a member of a sorted set, by score. $redis->zRank('zs', 'zero'); $redis->zRank('zs', 'three'); /","params":[{"name":"key","declared_type":"string","description":"The sorted set to check."},{"name":"member","declared_type":"mixed","description":"The member to test."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"zRem","fqn":"Redis::zRem","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":206972,"end":206976}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"other_members","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Remove one or more members from a Redis sorted set. $redis->zRem('zs', 'mem:0', 'mem:1', 'mem:2', 'mem:6', 'mem:7', 'mem:8', 