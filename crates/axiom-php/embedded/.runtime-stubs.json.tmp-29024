d_8.php","range":{"start":12778,"end":12791}},"declared_type":null,"signature":{"parameters":[{"name":"full_status","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Get status of output buffers true to return all active output buffer levels. If false or not set, only the top level output buffer is returned. </p> or with full_status = false a simple array with the following elements is returned: <pre> Array ( [level] => 2 [type] => 0 [status] => 0 [name] => URL-Rewriter [del] => 1 ) </pre> <table> <tr><th>Key</th><th>Value</th></tr> <tr><td>level</td><td>Output nesting level</td></tr> <tr><td>type</td><td><em>PHP_OUTPUT_HANDLER_INTERNAL (0)</em> or <em>PHP_OUTPUT_HANDLER_USER (1)</em></td></tr> <tr><td>status</td><td>One of <em>PHP_OUTPUT_HANDLER_START</em> (0), <em>PHP_OUTPUT_HANDLER_CONT</em> (1) or <em>PHP_OUTPUT_HANDLER_END</em> (2)</td></tr> <tr><td>name</td><td>Name of active output handler or &#039; default output handler&#039; if none is set</td></tr> <tr><td>del</td><td>Erase-flag as set by ob_start()</td></tr> </table> <p> If called with full_status = TRUE an array with one element for each active output buffer level is returned. The output level is used as key of the top level array and each array element itself is another array holding status information on one active output level. </p> <pre> Array ( [0] => Array ( [chunk_size] => 0 [size] => 40960 [block_size] => 10240 [type] => 1 [status] => 0 [name] => default output handler [del] => 1 ) [1] => Array ( [chunk_size] => 0 [size] => 40960 [block_size] => 10240 [type] => 0 [buffer_size] => 0 [status] => 0 [name] => URL-Rewriter [del] => 1 ) ) </pre> <p> The full output contains these additional elements:</p> <table> <tr><th>Key</th><th>Value</th></tr> <tr><td>chunk_size</td><td>Chunk size as set by ob_start()</td></tr> <tr><td>size</td><td>...</td></tr> <tr><td>blocksize</td><td>...</td></tr> </table> /","params":[{"name":"full_status","declared_type":"bool","description":"[optional] <p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ob_gzhandler","fqn":"ob_gzhandler","kind":"Function","origin":"PhpRuntime","extension":"zlib","location":{"file":"zlib/zlib.php","range":{"start":13536,"end":13548}},"declared_type":null,"signature":{"parameters":[{"name":"data","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"ob_start callback function to gzip output buffer /","params":[{"name":"data","declared_type":"string","description":null},{"name":"flags","declared_type":"int","description":null}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ob_iconv_handler","fqn":"ob_iconv_handler","kind":"Function","origin":"PhpRuntime","extension":"iconv","location":{"file":"iconv/iconv.php","range":{"start":1361,"end":1377}},"declared_type":null,"signature":{"parameters":[{"name":"contents","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"status","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Convert character encoding as output buffer handler return values. /","params":[{"name":"contents","declared_type":"string","description":null},{"name":"status","declared_type":"int","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ob_implicit_flush","fqn":"ob_implicit_flush","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":13416,"end":13433}},"declared_type":null,"signature":{"parameters":[{"name":"enable","declared_type":null,"phpdoc_type":"int|bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Turn implicit flush on/off 1|<b>TRUE</b> to turn implicit flushing on, 0|<b>FALSE</b> turns it off. <br><br>default: 1|<b>TRUE</b> </p> /","params":[{"name":"enable","declared_type":"int|bool","description":"[optional] <p>"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ob_inflatehandler","fqn":"ob_inflatehandler","kind":"Function","origin":"PhpRuntime","extension":"http","location":{"file":"http/http.php","range":{"start":87232,"end":87249}},"declared_type":null,"signature":{"parameters":[{"name":"data","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"(PECL pecl_http &gt;= 0.21.0)<br/> Inflate output handler /","params":[{"name":"data","declared_type":"string","description":null},{"name":"mode","declared_type":"int","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ob_list_handlers","fqn":"ob_list_handlers","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":13870,"end":13886}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"List all output handlers in use output_buffering is enabled or an anonymous function was used with ob_start, ob_list_handlers will return \"default output handler\". /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ob_start","fqn":"ob_start","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":7887,"end":7895}},"declared_type":null,"signature":{"parameters":[{"name":"callback","declared_type":null,"phpdoc_type":"callable|null","optional":true,"variadic":false,"by_reference":false},{"name":"chunk_size","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Turn on output buffering An optional output_callback function may be specified. This function takes a string as a parameter and should return a string. The function will be called when the output buffer is flushed (sent) or cleaned (with ob_flush, ob_clean or similar function) or when the output buffer is flushed to the browser at the end of the request. When output_callback is called, it will receive the contents of the output buffer as its parameter and is expected to return a new output buffer as a result, which will be sent to the browser. If the output_callback is not a callable function, this function will return false. </p> <p> If the callback function has two parameters, the second parameter is filled with a bit-field consisting of PHP_OUTPUT_HANDLER_START, PHP_OUTPUT_HANDLER_CONT and PHP_OUTPUT_HANDLER_END. </p> <p> If output_callback returns false original input is sent to the browser. </p> <p> The output_callback parameter may be bypassed by passing a null value. </p> <p> ob_end_clean, ob_end_flush, ob_clean, ob_flush and ob_start may not be called from a callback function. If you call them from callback function, the behavior is undefined. If you would like to delete the contents of a buffer, return \"\" (a null string) from callback function. You can't even call functions using the output buffering functions like print_r($expression, true) or highlight_file($filename, true) from a callback function. </p> <p> In PHP 4.0.4, ob_gzhandler was introduced to facilitate sending gz-encoded data to web browsers that support compressed web pages. ob_gzhandler determines what type of content encoding the browser will accept and will return its output accordingly. </p> If the optional parameter chunk_size is passed, the buffer will be flushed after any output call which causes the buffer's length to equal or exceed chunk_size. Default value 0 means that the function is called only in the end, other special value 1 sets chunk_size to 4096. </p> The flags parameter is a bitmask that controls the operations that can be performed on the output buffer. The default is to allow output buffers to be cleaned, flushed and removed, which can be set explicitly via PHP_OUTPUT_HANDLER_CLEANABLE | PHP_OUTPUT_HANDLER_FLUSHABLE | PHP_OUTPUT_HANDLER_REMOVABLE, or PHP_OUTPUT_HANDLER_STDFLAGS as shorthand. </p> /","params":[{"name":"callback","declared_type":"callable|null","description":"<p>"},{"name":"chunk_size","declared_type":"int","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ob_tidyhandler","fqn":"ob_tidyhandler","kind":"Function","origin":"PhpRuntime","extension":"tidy","location":{"file":"tidy/tidy.php","range":{"start":32382,"end":32396}},"declared_type":null,"signature":{"parameters":[{"name":"input","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"ob_start callback function to repair the buffer The buffer. </p> The buffer mode. </p> /","params":[{"name":"input","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_bind_array_by_name","fqn":"oci_bind_array_by_name","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":18378,"end":18400}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"var_array","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"max_table_length","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"max_item_length","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"type","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5 &gt;= 5.1.2, PECL OCI8 &gt;= 1.2.0)<br/> Binds a PHP array to an Oracle PL/SQL array parameter A valid OCI statement identifier. </p> The Oracle placeholder. </p> An array. </p> Sets the maximum length both for incoming and result arrays. </p> Sets maximum length for array items. If not specified or equals to -1, {@see oci_bind_array_by_name} will find the longest element in the incoming array and will use it as the maximum length. </p> Should be used to set the type of PL/SQL array items. See list of available types below: </p> <p> <b>SQLT_NUM</b> - for arrays of NUMBER. </p> /","params":[{"name":"statement","declared_type":"resource","description":"<p>"},{"name":"name","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"max_table_length","declared_type":"int","description":"<p>"},{"name":"max_item_length","declared_type":"int","description":"[optional] <p>"},{"name":"type","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_bind_by_name","fqn":"oci_bind_by_name","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":17272,"end":17288}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"bv_name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"variable","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"maxlength","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"type","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Binds a PHP variable to an Oracle placeholder A valid OCI8 statement identifier. </p> The colon-prefixed bind variable placeholder used in the statement. The colon is optional in <i>bv_name</i>. Oracle does not use question marks for placeholders. </p> The PHP variable to be associated with <i>bv_name</i> </p> Sets the maximum length for the data. If you set it to -1, this function will use the current length of <i>variable</i> to set the maximum length. In this case the <i>variable</i> must exist and contain data when {@see oci_bind_by_name} is called. </p> The datatype that Oracle will treat the data as. The default <i>type</i> used is <b>SQLT_CHR</b>. Oracle will convert the data between this type and the database column (or PL/SQL variable type), when possible. </p> <p> If you need to bind an abstract datatype (LOB/ROWID/BFILE) you need to allocate it first using the {@see oci_new_descriptor} function. The <i>length</i> is not used for abstract datatypes and should be set to -1. </p> <p> Possible values for <i>type</i> are: </p> <p> <b>SQLT_BFILEE</b> or <b>OCI_B_BFILE</b> - for BFILEs; </p> /","params":[{"name":"statement","declared_type":"resource","description":"<p>"},{"name":"bv_name","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"maxlength","declared_type":"int","description":"[optional] <p>"},{"name":"type","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_cancel","fqn":"oci_cancel","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":24184,"end":24194}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Cancels reading from cursor An OCI statement. </p> /","params":[{"name":"statement","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_client_version","fqn":"oci_client_version","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":37069,"end":37087}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"(PHP 5.3.7, PECL OCI8 &gt;= 1.4.6)<br/> Returns the Oracle client library version /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_close","fqn":"oci_close","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":39430,"end":39439}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Closes an Oracle connection An Oracle connection identifier returned by {@see oci_connect}, {@see oci_pconnect}, or {@see oci_new_connect}. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_commit","fqn":"oci_commit","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":52867,"end":52877}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Commits the outstanding database transaction An Oracle connection identifier, returned by {@see oci_connect}, {@see oci_pconnect}, or {@see oci_new_connect}. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_connect","fqn":"oci_connect","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":42696,"end":42707}},"declared_type":null,"signature":{"parameters":[{"name":"username","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"password","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"connection_string","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"character_set","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"session_mode","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Connect to an Oracle database The Oracle user name. </p> The password for <i>username</i>. </p> the Oracle instance to connect to. It can be an Easy Connect string, or a Connect Name from the tnsnames.ora file, or the name of a local Oracle instance. </p> <p> If not specified, PHP uses environment variables such as <b>TWO_TASK</b> (on Linux) or <b>LOCAL</b> (on Windows) and <b>ORACLE_SID</b> to determine the Oracle instance to connect to. </p> <p> To use the Easy Connect naming method, PHP must be linked with Oracle 10g or greater Client libraries. The Easy Connect string for Oracle 10g is of the form: [//]host_name[:port][/service_name]. From Oracle 11g, the syntax is: [//]host_name[:port][/service_name][:server_type][/instance_name]. Service names can be found by running the Oracle utility lsnrctl status on the database server machine. </p> <p> The tnsnames.ora file can be in the Oracle Net search path, which includes $ORACLE_HOME/network/admin and /etc. Alternatively set TNS_ADMIN so that $TNS_ADMIN/tnsnames.ora is read. Make sure the web daemon has read access to the file. </p> the character set used by the Oracle Client libraries. The character set does not need to match the character set used by the database. If it doesn't match, Oracle will do its best to convert data to and from the database character set. Depending on the character sets this may not give usable results. Conversion also adds some time overhead. </p> <p> If not specified, the Oracle Client libraries determine a character set from the <b>NLS_LANG</b> environment variable. </p> <p> Passing this parameter can reduce the time taken to connect. </p> <p> parameter is available since version PHP 5 (PECL OCI8 1.1) and accepts the following values: <b>OCI_DEFAULT</b>, <b>OCI_SYSOPER</b> and <b>OCI_SYSDBA</b>. If either <b>OCI_SYSOPER</b> or <b>OCI_SYSDBA</b> were specified, this function will try to establish privileged connection using external credentials. Privileged connections are disabled by default. To enable them you need to set oci8.privileged_connect to On. </p> <p> PHP 5.3 (PECL OCI8 1.3.4) introduced the <b>OCI_CRED_EXT</b> mode value. This tells Oracle to use External or OS authentication, which must be configured in the database. The <b>OCI_CRED_EXT</b> flag can only be used with username of &#x00022;/&#x00022; and a empty password. oci8.privileged_connect may be On or Off. </p> <p> <b>OCI_CRED_EXT</b> may be combined with the <b>OCI_SYSOPER</b> or <b>OCI_SYSDBA</b> modes. </p> <p> <b>OCI_CRED_EXT</b> is not supported on Windows for security reasons. </p> /","params":[{"name":"username","declared_type":"string","description":"<p>"},{"name":"password","declared_type":"string","description":"<p>"},{"name":"connection_string","declared_type":"string","description":"[optional] <p>Contains"},{"name":"character_set","declared_type":"string","description":"[optional] <p>Determines"},{"name":"session_mode","declared_type":"int","description":"[optional] This"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_define_by_name","fqn":"oci_define_by_name","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":15611,"end":15629}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"column_name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"variable","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"type","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Associates a PHP variable with a column for query fetches identifier created by {@see oci_parse} and executed by {@see oci_execute}, or a REF CURSOR statement identifier.</p> The column name used in the query. </p> <p> Use uppercase for Oracle's default, non-case sensitive column names. Use the exact column name case for case-sensitive column names. </p> The PHP variable that will contain the returned column value. </p> The data type to be returned. Generally not needed. Note that Oracle-style data conversions are not performed. For example, SQLT_INT will be ignored and the returned data type will still be SQLT_CHR. </p> <p> You can optionally use {@see oci_new_descriptor} to allocate LOB/ROWID/BFILE descriptors. </p> /","params":[{"name":"statement","declared_type":"resource","description":"<p>A valid OCI8 statement"},{"name":"column_name","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"type","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_error","fqn":"oci_error","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":51004,"end":51013}},"declared_type":null,"signature":{"parameters":[{"name":"resource","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Returns the last error found For most errors, <i>resource</i> is the resource handle that was passed to the failing function call. For connection errors with {@see oci_connect}, {@see oci_new_connect} or {@see oci_pconnect} do not pass <i>resource</i>. </p> <b>FALSE</b>. Otherwise, {@see oci_error} returns the error information as an associative array. </p> <p> <table> {@see oci_error} Array Description <tr valign=\"top\"> <td>Array key</td> <td>Type</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>code</td> <td>integer</td> <td> The Oracle error number. </td> </tr> <tr valign=\"top\"> <td>message</td> <td>string</td> <td> The Oracle error text. </td> </tr> <tr valign=\"top\"> <td>offset</td> <td>integer</td> <td> The byte position of an error in the SQL statement. If there was no statement, this is 0 </td> </tr> <tr valign=\"top\"> <td>sqltext</td> <td>string</td> <td> The SQL statement text. If there was no statement, this is an empty string. </td> </tr> </table> /","params":[{"name":"resource","declared_type":"resource","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_execute","fqn":"oci_execute","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":23849,"end":23860}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Executes a statement A valid OCI statement identifier. </p> An optional second parameter can be one of the following constants: <table> Execution Modes <tr valign=\"top\"> <td>Constant</td> <td>Description</td> </tr> <tr valign=\"top\"> <td><b>OCI_COMMIT_ON_SUCCESS</b></td> <td>Automatically commit all outstanding changes for this connection when the statement has succeeded. This is the default.</td> </tr> <tr valign=\"top\"> <td><b>OCI_DESCRIBE_ONLY</b></td> <td>Make query meta data available to functions like {@see oci_field_name} but do not create a result set. Any subsequent fetch call such as {@see oci_fetch_array} will fail.</td> </tr> <tr valign=\"top\"> <td><b>OCI_NO_AUTO_COMMIT</b></td> <td>Do not automatically commit changes. Prior to PHP 5.3.2 (PECL OCI8 1.4) use <b>OCI_DEFAULT</b> which is equivalent to <b>OCI_NO_AUTO_COMMIT</b>.</td> </tr> </table> </p> <p> Using <b>OCI_NO_AUTO_COMMIT</b> mode starts or continues a transaction. Transactions are automatically rolled back when the connection is closed, or when the script ends. Explicitly call {@see oci_commit} to commit a transaction, or {@see oci_rollback} to abort it. </p> <p> When inserting or updating data, using transactions is recommended for relational data consistency and for performance reasons. </p> <p> If <b>OCI_NO_AUTO_COMMIT</b> mode is used for any statement including queries, and {@see oci_commit} or {@see oci_rollback} is not subsequently called, then OCI8 will perform a rollback at the end of the script even if no data was changed. To avoid an unnecessary rollback, many scripts do not use <b>OCI_NO_AUTO_COMMIT</b> mode for queries or PL/SQL. Be careful to ensure the appropriate transactional consistency for the application when using {@see oci_execute} with different modes in the same script. </p> /","params":[{"name":"statement","declared_type":"resource","description":"<p>"},{"name":"mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_fetch","fqn":"oci_fetch","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":24675,"end":24684}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Fetches the next row from a query into internal buffers identifier created by {@see oci_parse} and executed by {@see oci_execute}, or a REF CURSOR statement identifier.</p> <i>statement</i>. /","params":[{"name":"statement","declared_type":"resource","description":"<p>A valid OCI8 statement"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_fetch_all","fqn":"oci_fetch_all","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":33077,"end":33090}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"output","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"skip","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"maxrows","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Fetches multiple rows from a query into a two-dimensional array identifier created by {@see oci_parse} and executed by {@see oci_execute}, or a REF CURSOR statement identifier.</p> The variable to contain the returned rows. </p> <p> LOB columns are returned as strings, where Oracle supports conversion. </p> <p> See {@see oci_fetch_array} for more information on how data and types are fetched. </p> The number of initial rows to discard when fetching the result. The default value is 0, so the first row onwards is returned. </p> The number of rows to return. The default is -1 meaning return all the rows from <i>skip</i> + 1 onwards. </p> Parameter <i>flags</i> indicates the array structure and whether associative arrays should be used. <table> {@see oci_fetch_all} Array Structure Modes <tr valign=\"top\"> <td>Constant</td> <td>Description</td> </tr> <tr valign=\"top\"> <td><b>OCI_FETCHSTATEMENT_BY_ROW</b></td> <td>The outer array will contain one sub-array per query row.</td> </tr> <tr valign=\"top\"> <td><b>OCI_FETCHSTATEMENT_BY_COLUMN</b></td> <td>The outer array will contain one sub-array per query column. This is the default.</td> </tr> </table> </p> <p> Arrays can be indexed by column heading or numerically. <table> {@see oci_fetch_all} Array Index Modes <tr valign=\"top\"> <td>Constant</td> <td>Description</td> </tr> <tr valign=\"top\"> <td><b>OCI_NUM</b></td> <td>Numeric indexes are used for each column's array.</td> </tr> <tr valign=\"top\"> <td><b>OCI_ASSOC</b></td> <td>Associative indexes are used for each column's array. This is the default.</td> </tr> </table> </p> <p> Use the addition operator &#x00022;+&#x00022; to choose a combination of array structure and index modes. </p> <p> Oracle's default, non-case sensitive column names will have uppercase array keys. Case-sensitive column names will have array keys using the exact column case. Use <b>var_dump</b> on <i>output</i> to verify the appropriate case to use for each query. </p> <p> Queries that have more than one column with the same name should use column aliases. Otherwise only one of the columns will appear in an associative array. </p> may be 0 or more, or <b>FALSE</b> on failure. /","params":[{"name":"statement","declared_type":"resource","description":"<p>A valid OCI8 statement"},{"name":"","declared_type":null,"description":null},{"name":"skip","declared_type":"int","description":"[optional] <p>"},{"name":"maxrows","declared_type":"int","description":"[optional] <p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_fetch_array","fqn":"oci_fetch_array","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":29791,"end":29806}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Returns the next row from a query as an associative or numeric array identifier created by {@see oci_parse} and executed by {@see oci_execute}, or a REF CURSOR statement identifier.</p> <p> Can also be a statement identifier returned by {@see oci_get_implicit_resultset}. </p> An optional second parameter can be any combination of the following constants: <table> {@see oci_fetch_array} Modes <tr valign=\"top\"> <td>Constant</td> <td>Description</td> </tr> <tr valign=\"top\"> <td><b>OCI_BOTH</b></td> <td>Returns an array with both associative and numeric indices. This is the same as <b>OCI_ASSOC</b> + <b>OCI_NUM</b> and is the default behavior.</td> </tr> <tr valign=\"top\"> <td><b>OCI_ASSOC</b></td> <td>Returns an associative array.</td> </tr> <tr valign=\"top\"> <td><b>OCI_NUM</b></td> <td>Returns a numeric array.</td> </tr> <tr valign=\"top\"> <td><b>OCI_RETURN_NULLS</b></td> <td>Creates elements for <b>NULL</b> fields. The element values will be a PHP <b>NULL</b>. </td> </tr> <tr valign=\"top\"> <td><b>OCI_RETURN_LOBS</b></td> <td>Returns the contents of LOBs instead of the LOB descriptors.</td> </tr> </table> </p> <p> The default <i>mode</i> is <b>OCI_BOTH</b>. </p> <p> Use the addition operator &#x00022;+&#x00022; to specify more than one mode at a time. </p> are no more rows in the <i>statement</i> then <b>FALSE</b> is returned. </p> <p> By default, LOB columns are returned as LOB descriptors. </p> <p> DATE columns are returned as strings formatted to the current date format. The default format can be changed with Oracle environment variables such as NLS_LANG or by a previously executed ALTER SESSION SET NLS_DATE_FORMAT command. </p> <p> Oracle's default, non-case sensitive column names will have uppercase associative indices in the result array. Case-sensitive column names will have array indices using the exact column case. Use <b>var_dump</b> on the result array to verify the appropriate case to use for each query. </p> <p> The table name is not included in the array index. If your query contains two different columns with the same name, use <b>OCI_NUM</b> or add a column alias to the query to ensure name uniqueness, see example #7. Otherwise only one column will be returned via PHP. </p> /","params":[{"name":"statement","declared_type":"resource","description":"<p>A valid OCI8 statement"},{"name":"mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_fetch_assoc","fqn":"oci_fetch_assoc","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":27005,"end":27020}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Returns the next row from a query as an associative array identifier created by {@see oci_parse} and executed by {@see oci_execute}, or a REF CURSOR statement identifier.</p> the <i>statement</i> then <b>FALSE</b> is returned. /","params":[{"name":"statement","declared_type":"resource","description":"<p>A valid OCI8 statement"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_fetch_object","fqn":"oci_fetch_object","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":25958,"end":25974}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"object|false"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Returns the next row from a query as an object identifier created by {@see oci_parse} and executed by {@see oci_execute}, or a REF CURSOR statement identifier.</p> column of the row. If there are no more rows in the <i>statement</i> then <b>FALSE</b> is returned. </p> <p> Any LOB columns are returned as LOB descriptors. </p> <p> DATE columns are returned as strings formatted to the current date format. The default format can be changed with Oracle environment variables such as NLS_LANG or by a previously executed ALTER SESSION SET NLS_DATE_FORMAT command. </p> <p> Oracle's default, non-case sensitive column names will have uppercase attribute names. Case-sensitive column names will have attribute names using the exact column case. Use <b>var_dump</b> on the result object to verify the appropriate case for attribute access. </p> <p> Attribute values will be <b>NULL</b> for any NULL data fields. </p> /","params":[{"name":"statement","declared_type":"resource","description":"<p>A valid OCI8 statement"}],"return_type":"object|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_fetch_row","fqn":"oci_fetch_row","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":26483,"end":26496}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Returns the next row from a query as a numeric array identifier created by {@see oci_parse} and executed by {@see oci_execute}, or a REF CURSOR statement identifier.</p> the <i>statement</i> then <b>FALSE</b> is returned. /","params":[{"name":"statement","declared_type":"resource","description":"<p>A valid OCI8 statement"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_field_is_null","fqn":"oci_field_is_null","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":18943,"end":18960}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"field","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Checks if a field in the currently fetched row <b>NULL</b> A valid OCI statement identifier. </p> Can be a field's index or a field's name (uppercased). </p> /","params":[{"name":"statement","declared_type":"resource","description":"<p>"},{"name":"field","declared_type":"mixed","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_field_name","fqn":"oci_field_name","kind":"Function","origin":"PhpRuntime","extension":"oci8","location":{"file":"oci8/oci8.php","range":{"start":19393,"end":19407}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"field","declared_type":null,"phpdoc_type":"string|int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"(PHP 5, PECL OCI8 &gt;= 1.1.0)<br/> Returns the name of a field from the statement A valid OCI statement identifier. </p> Can be the field's index (1-based) or name. </p> /","params":[{"name":"statement","declared_type":"resource","description":"<p>"},{"name":"field","declared_type":"string|int","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"oci_field_precision","