er, upper, or natural) that will appear in a result set. autocommit <p> Passing DB2_AUTOCOMMIT_ON turns autocommit on for the specified connection resource. </p> <p> Passing DB2_AUTOCOMMIT_OFF turns autocommit off for the specified connection resource. </p> An integer value that specifies the type of resource that was passed into the function. The type of resource and this value must correspond. <p> Passing 1 as the value specifies that a connection resource has been passed into the function. </p> <p> Passing any integer not equal to 1 as the value specifies that a statement resource has been passed into the function. </p> /","params":[{"name":"resource","declared_type":"resource","description":"<p>"},{"name":"options","declared_type":"array","description":"<p>"},{"name":"type","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"db2_setoption","fqn":"db2_setoption","kind":"Function","origin":"PhpRuntime","extension":"ibm_db2","location":{"file":"ibm_db2/ibm_db2.php","range":{"start":53891,"end":53904}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"db2_special_columns","fqn":"db2_special_columns","kind":"Function","origin":"PhpRuntime","extension":"ibm_db2","location":{"file":"ibm_db2/ibm_db2.php","range":{"start":27143,"end":27162}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"qualifier","declared_type":"?string","phpdoc_type":"string|null","optional":false,"variadic":false,"by_reference":false},{"name":"schema","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"table_name","declared_type":"str