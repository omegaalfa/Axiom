e of SQL statements, UPDATE, DELETE, DROP, etc, cubrid_unbuffered_query returns true on success or false on error. </p> /","params":[{"name":"query","declared_type":"string","description":"<p>"},{"name":"conn_identifier","declared_type":"resource","description":"[optional] <p>"}],"return_type":"resource|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"cubrid_version","fqn":"cubrid_version","kind":"Function","origin":"PhpRuntime","extension":"cubrid","location":{"file":"cubrid/cubrid.php","range":{"start":59278,"end":59292}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"(PHP 5, CUBRID &gt;= 8.3.0)<br/> Get the CUBRID PHP module's version Version information (eg. \"8.4.1.0001\"). </p> /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"curl_close","fqn":"curl_close","kind":"Function","origin":"PhpRuntime","extension":"curl","location":{"file":"curl/curl.php","range":{"start":86592,"end":86602}},"declared_type":null,"signature":{"parameters":[{"name":"handle","declared_type":null,"phpdoc_type":"CurlHandle|resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Close a cURL session /","params":[{"name":"handle","declared_type":"CurlHandle|resource","description":null}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"curl_copy_handle","fqn":"curl_copy_handle","kind":"Function","origin":"PhpRuntime","extension":"curl","location":{"file":"curl/curl.php","range":{"start":4053,"end":4069}},"declared_type":null,"signature":{"parameters":[{"name":"handle","declared_type":null,"phpdoc_type":"CurlHandle|resource","option