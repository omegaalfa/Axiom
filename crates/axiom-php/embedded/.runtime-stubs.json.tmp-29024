crease a stored number the stored variable will be expunged from the cache (on the next request). If no ttl is supplied (or if the ttl is 0), the value will persist until it is removed from the cache manually, or otherwise fails to exist in the cache (clear, restart, etc.). /","params":[{"name":"key","declared_type":"string","description":"The key of the value being decreased."},{"name":"step","declared_type":"int","description":"The step, or value to decrease."},{"name":"ttl","declared_type":"int","description":"Time To Live; store var in the cache for ttl seconds. After the ttl has passed,"},{"name":"","declared_type":null,"description":null}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"apcu_delete","fqn":"apcu_delete","kind":"Function","origin":"PhpRuntime","extension":"apcu","location":{"file":"apcu/apcu.php","range":{"start":19042,"end":19053}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string|string[]|APCUIterator","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool|string[]"},"documentation":{"description":"Removes a stored variable from the cache /","params":[{"name":"key","declared_type":"string|string[]|APCUIterator","description":"The key used to store the value (with apcu_store())."}],"return_type":"bool|string[]","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"apcu_enabled","fqn":"apcu_enabled","kind":"Function","origin":"PhpRuntime","extension":"apcu","location":{"file":"apcu/apcu.php","range":{"start":24930,"end":24942}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Whether APCu is usable in the current environment /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"apcu_entry","fqn":"apcu_entry","kind":"Function","origin":"PhpRuntime","extension":"apcu","location":{"file":"apcu/apcu.php","range":{"start":24275,"end":24285}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"generator","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"ttl","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Atomically fetch or generate a cache entry <p>Atomically attempts to find key in the cache, if it cannot be found generator is called, passing key as the only argument. The return value of the call is then cached with the optionally specified ttl, and returned. </p> <p>Note: When control enters <i>apcu_entry()</i> the lock for the cache is acquired exclusively, it is released when control leaves apcu_entry(): In effect, this turns the body of generator into a critical section, disallowing two processes from executing the same code paths concurrently. In addition, it prohibits the concurrent execution of any other APCu functions, since they will acquire the same lock. </p> <p>Warning The only APCu function that can be called safely by generator is apcu_entry().</p> After the ttl has passed, the stored variable will be expunged from the cache (on the next request). If no ttl is supplied (or if the ttl is 0), the value will persist until it is removed from the cache manually, or otherwise fails to exist in the cache (clear, restart, etc.). /","params":[{"name":"key","declared_type":"string","description":"Identity of cache entry"},{"name":"generator","declared_type":"callable","description":"A callable that accepts key as the only argument an