":"ldap/ldap.php","range":{"start":26796,"end":26811}},"declared_type":null,"signature":{"parameters":[{"name":"dn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"with_attrib","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Splits DN into its component parts The distinguished name of an LDAP entity. </p> Used to request if the RDNs are returned with only values or their attributes as well. To get RDNs with the attributes (i.e. in attribute=value format) set <i>with_attrib</i> to 0 and to get only values set it to 1. </p> The first element in this array has count key and represents the number of returned values, next elements are numerically indexed DN components. /","params":[{"name":"dn","declared_type":"string","description":"<p>"},{"name":"with_attrib","declared_type":"int","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_first_attribute","fqn":"ldap_first_attribute","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":22364,"end":22384}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Return first attribute An LDAP link identifier, returned by <b>ldap_connect</b>. </p> error. /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"entry","declared_type":"resource","description":null}],"return_type":"s