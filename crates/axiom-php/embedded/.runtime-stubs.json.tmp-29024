ange":{"start":4087,"end":4099}},"declared_type":null,"signature":{"parameters":[{"name":"dictionary","declared_type":null,"phpdoc_type":"\\PSpell\\Dictionary|int","optional":false,"variadic":false,"by_reference":false},{"name":"word","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Check a word The tested word. </p> /","params":[{"name":"dictionary","declared_type":"\\PSpell\\Dictionary|int","description":null},{"name":"word","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_clear_session","fqn":"pspell_clear_session","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":6354,"end":6374}},"declared_type":null,"signature":{"parameters":[{"name":"dictionary","declared_type":null,"phpdoc_type":"\\PSpell\\Dictionary|int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Clear the current session /","params":[{"name":"dictionary","declared_type":"\\PSpell\\Dictionary|int","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_config_create","fqn":"pspell_config_create","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":8112,"end":8132}},"declared_type":null,"signature":{"parameters":[{"name":"language","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"spelling","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"jargon","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"\\PSpell\\Config|int"},"documentation":{"description":"Create a config used to open a dictionary The language parameter is the language code which consists of the two letter ISO 639 language code and an optional two letter ISO 3166 country code after a dash or underscore. </p> The spelling parameter is the requested spelling for languages with more than one spelling such as English. Known values are 'american', 'british', and 'canadian'. </p> The jargon parameter contains extra information to distinguish two different words lists that have the same language and spelling parameters. </p> The encoding parameter is the encoding that words are expected to be in. Valid values are 'utf-8', 'iso8859-*', 'koi8-r', 'viscii', 'cp1252', 'machine unsigned 16', 'machine unsigned 32'. This parameter is largely untested, so be careful when using. </p> /","params":[{"name":"language","declared_type":"string","description":"<p>"},{"name":"spelling","declared_type":"string","description":"<p>"},{"name":"jargon","declared_type":"string","description":"<p>"},{"name":"encoding","declared_type":"string","description":"<p>"}],"return_type":"\\PSpell\\Config|int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_config_data_dir","fqn":"pspell_config_data_dir","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":10938,"end":10960}},"declared_type":null,"signature":{"parameters":[{"name":"config","declared_type":null,"phpdoc_type":"\\PSpell\\Config|int","optional":false,"variadic":false,"by_reference":false},{"name":"directory","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"location of language data files /","params":[{"name":"config","declared_type":"\\PSpell\\Config|int","description":null},{"name":"directory","declared_type":"string","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_config_dict_dir","fqn":"pspell_config_dict_dir","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":10551,"end":10573}},"declared_type":null,"signature":{"parameters":[{"name":"config","declared_type":null,"phpdoc_type":"\\PSpell\\Config|int","optional":false,"variadic":false,"by_reference":false},{"name":"directory","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Location of the main word list /","params":[{"name":"config","declared_type":"\\PSpell\\Config|int","description":null},{"name":"directory","declared_type":"string","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_config_ignore","fqn":"pspell_config_ignore","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":9618,"end":9638}},"declared_type":null,"signature":{"parameters":[{"name":"config","declared_type":null,"phpdoc_type":"\\PSpell\\Config|int","optional":false,"variadic":false,"by_reference":false},{"name":"min_length","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Ignore words less than N characters long Words less than <i>n</i> characters will be skipped. </p> /","params":[{"name":"config","declared_type":"\\PSpell\\Config|int","description":null},{"name":"min_length","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_config_mode","fqn":"pspell_config_mode","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":9170,"end":9188}},"declared_type":null,"signature":{"parameters":[{"name":"config","declared_type":null,"phpdoc_type":"\\PSpell\\Config|int","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Change the mode number of suggestions returned The mode parameter is the mode in which spellchecker will work. There are several modes available: <b>PSPELL_FAST</b> - Fast mode (least number of suggestions)</p> /","params":[{"name":"config","declared_type":"\\PSpell\\Config|int","description":null},{"name":"mode","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_config_personal","fqn":"pspell_config_personal","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":10166,"end":10188}},"declared_type":null,"signature":{"parameters":[{"name":"config","declared_type":null,"phpdoc_type":"\\PSpell\\Config|int","optional":false,"variadic":false,"by_reference":false},{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set a file that contains personal wordlist The personal wordlist. If the file does not exist, it will be created. The file should be writable by whoever PHP runs as (e.g. nobody). </p> /","params":[{"name":"config","declared_type":"\\PSpell\\Config|int","description":null},{"name":"filename","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_config_repl","fqn":"pspell_config_repl","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":11412,"end":11430}},"declared_type":null,"signature":{"parameters":[{"name":"config","declared_type":null,"phpdoc_type":"\\PSpell\\Config|int","optional":false,"variadic":false,"by_reference":false},{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set a file that contains replacement pairs The file should be writable by whoever PHP runs as (e.g. nobody). </p> /","params":[{"name":"config","declared_type":"\\PSpell\\Config|int","description":null},{"name":"filename","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_config_runtogether","fqn":"pspell_config_runtogether","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":8603,"end":8628}},"declared_type":null,"signature":{"parameters":[{"name":"config","declared_type":null,"phpdoc_type":"\\PSpell\\Config|int","optional":false,"variadic":false,"by_reference":false},{"name":"allow","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Consider run-together words as valid compounds <b>TRUE</b> if run-together words should be treated as legal compounds, <b>FALSE</b> otherwise. </p> /","params":[{"name":"config","declared_type":"\\PSpell\\Config|int","description":null},{"name":"allow","declared_type":"bool","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_config_save_repl","fqn":"pspell_config_save_repl","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":11923,"end":11946}},"declared_type":null,"signature":{"parameters":[{"name":"config","declared_type":null,"phpdoc_type":"\\PSpell\\Config|int","optional":false,"variadic":false,"by_reference":false},{"name":"save","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Determine whether to save a replacement pairs list along with the wordlist <b>TRUE</b> if replacement pairs should be saved, <b>FALSE</b> otherwise. </p> /","params":[{"name":"config","declared_type":"\\PSpell\\Config|int","description":null},{"name":"save","declared_type":"bool","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_new","fqn":"pspell_new","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":1493,"end":1503}},"declared_type":null,"signature":{"parameters":[{"name":"language","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"spelling","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"jargon","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"Load a new dictionary The language parameter is the language code which consists of the two letter ISO 639 language code and an optional two letter ISO 3166 country code after a dash or underscore. </p> The spelling parameter is the requested spelling for languages with more than one spelling such as English. Known values are 'american', 'british', and 'canadian'. </p> The jargon parameter contains extra information to distinguish two different words lists that have the same language and spelling parameters. </p> The encoding parameter is the encoding that words are expected to be in. Valid values are 'utf-8', 'iso8859-*', 'koi8-r', 'viscii', 'cp1252', 'machine unsigned 16', 'machine unsigned 32'. This parameter is largely untested, so be careful when using. </p> The mode parameter is the mode in which spellchecker will work. There are several modes available: <b>PSPELL_FAST</b> - Fast mode (least number of suggestions)</p> /","params":[{"name":"language","declared_type":"string","description":"<p>"},{"name":"spelling","declared_type":"string","description":"<p>"},{"name":"jargon","declared_type":"string","description":"<p>"},{"name":"encoding","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"int","description":"<p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_new_config","fqn":"pspell_new_config","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":3714,"end":3731}},"declared_type":null,"signature":{"parameters":[{"name":"config","declared_type":null,"phpdoc_type":"\\PSpell\\Config|int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"Load a new dictionary with settings based on a given config The <i>config</i> parameter is the one returned by <b>pspell_config_create</b> when the config was created. </p> /","params":[{"name":"config","declared_type":"\\PSpell\\Config|int","description":"<p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_new_personal","fqn":"pspell_new_personal","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":3114,"end":3133}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"language","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"spelling","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"jargon","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"Load a new dictionary with personal wordlist The file where words added to the personal list will be stored. It should be an absolute filename beginning with '/' because otherwise it will be relative to $HOME, which is \"/root\" for most systems, and is probably not what you want. </p> The language code which consists of the two letter ISO 639 language code and an optional two letter ISO 3166 country code after a dash or underscore. </p> The requested spelling for languages with more than one spelling such as English. Known values are 'american', 'british', and 'canadian'. </p> Extra information to distinguish two different words lists that have the same language and spelling parameters. </p> The encoding that words are expected to be in. Valid values are utf-8, iso8859-*, koi8-r, viscii, cp1252, machine unsigned 16, machine unsigned 32. </p> The mode in which spellchecker will work. There are several modes available: <b>PSPELL_FAST</b> - Fast mode (least number of suggestions)</p> /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"language","declared_type":"string","description":"<p>"},{"name":"spelling","declared_type":"string","description":"<p>"},{"name":"jargon","declared_type":"string","description":"<p>"},{"name":"encoding","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"int","description":"<p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_save_wordlist","fqn":"pspell_save_wordlist","kind":"Function","origin":"PhpRuntime","extension":"pspell","location":{"file":"pspell/pspell.php","range":{"start":6798,"end":6818}},"declared_type":null,"signature":{"parameters":[{"name":"dictionary","declared_type":null,"phpdoc_type":"\\PSpell\\Dictionary|int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Save the personal wordlist to a file A dictionary link identifier opened with <b>pspell_new_personal</b>. </p> /","params":[{"name":"dictionary","declared_type":"\\PSpell\\Dictionary|int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},