tion. </li> <li> IMG_NEAREST_NEIGHBOUR: Nearest neighbour interpolation. </li> <li> IMG_WEIGHTED4: Weighting filter. </li> <li> IMG_TRIANGLE: Triangle interpolation. </li> </ul> </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":"<p>"},{"name":"method","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagesetpixel","fqn":"imagesetpixel","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":45851,"end":45864}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"x","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"y","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"color","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Set a single pixel x-coordinate. </p> y-coordinate. </p> A color identifier created with imagecolorallocate. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"x","declared_type":"int","description":"<p>"},{"name":"y","declared_type":"int","description":"<p>"},{"name":"color","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagesetstyle","fqn":"imagesetstyle","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":27988,"end":28001}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_