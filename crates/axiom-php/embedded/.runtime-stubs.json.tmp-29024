:false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Feed signal event into Ev Simulates a signal receive. It is safe to call this function at any time, from any context, including signal handlers or random threads. Its main use is to customise signal handling in the process. Unlike Ev::feedSignalEvent() , this works regardless of which loop has registered the signal. extension. /","params":[{"name":"signum","declared_type":"int","description":"Signal number. See signal(7) man page for details. You can use constants exported by pcntl"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"feedSignalEvent","fqn":"Ev::feedSignalEvent","kind":"Method","origin":"PhpRuntime","extension":"Ev","location":{"file":"Ev/Ev.php","range":{"start":9733,"end":9748}},"declared_type":null,"signature":{"parameters":[{"name":"signum","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Feed signal event into the default loop Feed signal event into the default loop. Ev will react to this call as if the signal specified by signal had occurred. extension. /","params":[{"name":"signum","declared_type":"int","description":"Signal number. See signal(7) man page for details. See also constants exported by pcntl"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"iteration","fqn":"Ev::iteration","kind":"Method","origin":"PhpRuntime","extension":"Ev","location":{"file":"Ev/Ev.php","range":{"start":10093,"end":10102}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Return the number of times the default event loop has polled for 