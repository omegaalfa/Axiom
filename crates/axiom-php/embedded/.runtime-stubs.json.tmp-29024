til":null},"is_static":false},{"name":"output_reset_rewrite_vars","fqn":"output_reset_rewrite_vars","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_9.php","range":{"start":44208,"end":44233}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Reset URL rewriter values <table> <thead> <tr> <th>Version</th> <th>Description</th> </tr> </thead> <tbody> <tr> <td>7.1.0</td> <td> Before PHP 7.1.0, rewrite vars set by <span class=\"function\"><a href=\"function.output-add-rewrite-var.php\" class=\"function\">output_add_rewrite_var()</a></span> use the same Session module trans sid output buffer. Since PHP 7.1.0, dedicated output buffer is used and {@see output_reset_rewrite_vars()} only removes rewrite vars defined by {@see output_add_rewrite_var()}. </td> </tr> </tbody> </table> /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pack","fqn":"pack","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7.php","range":{"start":5585,"end":5589}},"declared_type":null,"signature":{"parameters":[{"name":"format","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"values","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Pack data into binary string The format string consists of format codes followed by an optional repeater argument. The repeater argument can be either an integer value or * for repeating to the end of the input data. For a, A, h, H the repeat count specifies how many characters of one data argument are taken, for @ it is the absolute position where to put the next data, for everything else the repeat count specifies how many data arguments are consumed and packed into the resulting binary string. </p> <p> Currently implemented formats are: <table> pack format characters <tr valign=\"top\"> <td>Code</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>a</td> <td>NUL-padded string</td> </tr> <tr valign=\"top\"> <td>A</td> <td>SPACE-padded string</td></tr> <tr valign=\"top\"> <td>h</td> <td>Hex string, low nibble first</td></tr> <tr valign=\"top\"> <td>H</td> <td>Hex string, high nibble first</td></tr> <tr valign=\"top\"><td>c</td><td>signed char</td></tr> <tr valign=\"top\"> <td>C</td> <td>unsigned char</td></tr> <tr valign=\"top\"> <td>s</td> <td>signed short (always 16 bit, machine byte order)</td> </tr> <tr valign=\"top\"> <td>S</td> <td>unsigned short (always 16 bit, machine byte order)</td> </tr> <tr valign=\"top\"> <td>n</td> <td>unsigned short (always 16 bit, big endian byte order)</td> </tr> <tr valign=\"top\"> <td>v</td> <td>unsigned short (always 16 bit, little endian byte order)</td> </tr> <tr valign=\"top\"> <td>i</td> <td>signed integer (machine dependent size and byte order)</td> </tr> <tr valign=\"top\"> <td>I</td> <td>unsigned integer (machine dependent size and byte order)</td> </tr> <tr valign=\"top\"> <td>l</td> <td>signed long (always 32 bit, machine byte order)</td> </tr> <tr valign=\"top\"> <td>L</td> <td>unsigned long (always 32 bit, machine byte order)</td> </tr> <tr valign=\"top\"> <td>N</td> <td>unsigned long (always 32 bit, big endian byte order)</td> </tr> <tr valign=\"top\"> <td>V</td> <td>unsigned long (always 32 bit, little endian byte order)</td> </tr> <tr valign=\"top\"> <td>f</td> <td>float (machine dependent size and representation, both little and big endian)</td> </tr> <tr valign=\"top\"> <td>d</td> <td>double (machine dependent size and representation, both little and big endian)</td> </tr> <tr valign=\"top\"> <td>x</td> <td>NUL byte</td> </tr> <tr valign=\"top\"> <td>X</td> <td>Back up one byte</td> </tr> <tr valign=\"top\"> <td>@</td> <td>NUL-fill to absolute position</td> </tr> </table> </p> </p> /","params":[{"name":"format","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pam_auth","fqn":"pam_auth","kind":"Function","origin":"PhpRuntime","extension":"pam","location":{"file":"pam/pam.php","range":{"start":691,"end":699}},"declared_type":null,"signature":{"parameters":[{"name":"username","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"password","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"error","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"check_account_management","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"service_name","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Authorize against a PAM unix database. The username to check. </p> The user-supplied password to check. </p> Output parameter to put any error messages in. </p> Call <b>pam_acct_mgmt()</b> to check account expiration and access. (Requires root access!) </p> PAM service name to use. (Defaults to \"php\") </p> /","params":[{"name":"username","declared_type":"string","description":"<p>"},{"name":"password","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"check_account_management","declared_type":"bool","description":"<p>"},{"name":"service_name","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pam_chpass","fqn":"pam_chpass","kind":"Function","origin":"PhpRuntime","extension":"pam","location":{"file":"pam/pam.php","range":{"start":1427,"end":1437}},"declared_type":null,"signature":{"parameters":[{"name":"username","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"old_password","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"new_password","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"error","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"service_name","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Change a password for a PAM unix account. The username to check. </p> The current password for the account. </p> The new password for the account. </p> Output parameter to put any error messages in. </p> PAM service name to use. (Defaults to \"php\") </p> /","params":[{"name":"username","declared_type":"string","description":"<p>"},{"name":"old_password","declared_type":"string","description":"<p>"},{"name":"new_password","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"service_name","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"parse_ini_file","fqn":"parse_ini_file","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":32953,"end":32967}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"process_sections","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"scanner_mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Parse a configuration file The filename of the ini file being parsed. </p> By setting the process_sections parameter to true, you get a multidimensional array, with the section names and settings included. The default for process_sections is false </p> Can either be INI_SCANNER_NORMAL (default) or INI_SCANNER_RAW. If INI_SCANNER_RAW is supplied, then option values will not be parsed. </p> <p> As of PHP 5.6.1 can also be specified as <strong><code>INI_SCANNER_TYPED</code></strong>. In this mode boolean, null and integer types are preserved when possible. String values <em>\"true\"</em>, <em>\"on\"</em> and <em>\"yes\"</em> are converted to <b>TRUE</b>. <em>\"false\"</em>, <em>\"off\"</em>, <em>\"no\"</em> and <em>\"none\"</em> are considered <b>FALSE</b>. <em>\"null\"</em> is converted to <b>NULL</b> in typed mode. Also, all numeric strings are converted to integer type if it is possible. </p> and false on failure. /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"process_sections","declared_type":"bool","description":"[optional] <p>"},{"name":"scanner_mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"parse_ini_string","fqn":"parse_ini_string","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":33846,"end":33862}},"declared_type":null,"signature":{"parameters":[{"name":"ini_string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"process_sections","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"scanner_mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Parse a configuration string The contents of the ini file being parsed. </p> By setting the process_sections parameter to true, you get a multidimensional array, with the section names and settings included. The default for process_sections is false </p> Can either be INI_SCANNER_NORMAL (default) or INI_SCANNER_RAW. If INI_SCANNER_RAW is supplied, then option values will not be parsed. </p> and false on failure. /","params":[{"name":"ini_string","declared_type":"string","description":"<p>"},{"name":"process_sections","declared_type":"bool","description":"[optional] <p>"},{"name":"scanner_mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"parse_str","fqn":"parse_str","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_2.php","range":{"start":7100,"end":7109}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"result","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"result","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true}],"declared_return_type":"void","phpdoc_return_type":"void"},