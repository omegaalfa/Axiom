":null,"phpdoc_return_type":"Yaf_Response_Abstract"},"documentation":{"description":"<p>This method does the heavy work of the Yaf_Dispatcher. It take a request object.</p><br/> <p>The dispatch process has three distinct events:</p> <ul> <li>Routing</li> <li>Dispatching</li> <li>Response</li> </ul> <p>Routing takes place exactly once, using the values in the request object when dispatch() is called. Dispatching takes place in a loop; a request may either indicate multiple actions to dispatch, or the controller or a plugin may reset the request object to force additional actions to dispatch(see Yaf_Plugin_Abstract. When all is done, the Yaf_Dispatcher returns a response.</p> /","params":[{"name":"request","declared_type":"Yaf_Request_Abstract","description":null}],"return_type":"Yaf_Response_Abstract","var_type":null,"throws":["Yaf_Exception_TypeError","Yaf_Exception_RouterFailed","Yaf_Exception_DispatchFailed","Yaf_Exception_LoadFailed","Yaf_Exception_LoadFailed_Action","Yaf_Exception_LoadFailed_Controller"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"enableView","fqn":"Yaf_Dispatcher::enableView","kind":"Method","origin":"PhpRuntime","extension":"yaf","location":{"file":"yaf/yaf.php","range":{"start":9989,"end":9999}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"Yaf_Dispatcher"},"documentation":{"description":"enable view rendering /","params":[],"return_type":"Yaf_Dispatcher","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"flushInstantly","fqn":"Yaf_Dispatcher::flushInstantly","kind":"Method","origin":"PhpRuntime","extension":"yaf","location":{"file":"yaf/yaf.php","range":{"start":14669,"end":14683}},"declared_type":null,"signature":{"parameters":[{"name":"flag","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_re