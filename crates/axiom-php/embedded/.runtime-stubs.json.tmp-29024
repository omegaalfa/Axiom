":{"file":"mapscript/mapscript.php","range":{"start":5110,"end":5128}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Resets the default stdin and stdout handlers in place of \"buffer\" based handlers. /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ms_iostripstdoutbuffercontentheaders","fqn":"ms_iostripstdoutbuffercontentheaders","kind":"Function","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":5470,"end":5506}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Strip all the Content-* headers off the stdout buffer if it has some. /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ms_iostripstdoutbuffercontenttype","fqn":"ms_iostripstdoutbuffercontenttype","kind":"Function","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":5318,"end":5351}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Strip the Content-type header off the stdout buffer if it has one, and if a content type is found it is return. Otherwise return false. /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ms_ResetErrorList","fqn":"ms_ResetErrorList","kind":"Function","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":6139,"end":6156}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Clear the current error list. Note that clearing the list invalidates any errorObj handles obtained via the $error->next() method. /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ms_TokenizeMap","fqn":"ms_TokenizeMap","kind":"Function","origin":"PhpRuntime","extension":"mapscript","location":{"file":"mapscript/mapscript.php","range":{"start":5807,"end":5821}},"declared_type":null,"signature":{"parameters":[{"name":"map_file_name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Preparses a mapfile through the MapServer parser and return an array with one item for each token from the mapfile.  Strings, logical expressions, regex expressions and comments are returned as individual tokens. /","params":[{"name":"map_file_name","declared_type":"string","description":null}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"msg_get_queue","fqn":"msg_get_queue","kind":"Function","origin":"PhpRuntime","extension":"sysvmsg","location":{"file":"sysvmsg/sysvmsg.php","range":{"start":668,"end":681}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"permissions","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|SysvMessageQueue|false"},"documentation":{"description":"Create or attach to a message queue Message queue numeric ID </p> Queue permissions. Default to 0666. If the message queue already exists, the <i>perms</i> will be ignored. </p> /","params":[{"name":"key","declared_type":"int","description":"<p>"},{"name":"permissions","declared_type":"int","description":"[optional] <p>"}],"return_type":"resource|SysvMessageQueue|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"msg_queue_exists","fqn":"msg_queue_exists","kind":"Function","origin":"PhpRuntime","extension":"sysvmsg","location":{"file":"sysvmsg/sysvmsg.php","range":{"start":9531,"end":9547}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Check whether a message queue exists Queue key. </p> /","params":[{"name":"key","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"msg_receive","fqn":"msg_receive","kind":"Function","origin":"PhpRuntime","extension":"sysvmsg","location":{"file":"sysvmsg/sysvmsg.php","range":{"start":5968,"end":5979}},"declared_type":null,"signature":{"parameters":[{"name":"queue","declared_type":null,"phpdoc_type":"SysvMessageQueue|resource","optional":false,"variadic":false,"by_reference":false},{"name":"desired_message_type","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"received_message_type","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"max_message_size","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"message","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"unserialize","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"error_code","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Receive a message from a message queue If <i>desiredmsgtype</i> is 0, the message from the front of the queue is returned. If <i>desiredmsgtype</i> is greater than 0, then the first message of that type is returned. If <i>desiredmsgtype</i> is less than 0, the first message on the queue with the lowest type less than or equal to the absolute value of <i>desiredmsgtype</i> will be read. If no messages match the criteria, your script will wait until a suitable message arrives on the queue. You can prevent the script from blocking by specifying <b>MSG_IPC_NOWAIT</b> in the <i>flags</i> parameter. </p> The type of the message that was received will be stored in this parameter. </p> The maximum size of message to be accepted is specified by the <i>maxsize</i>; if the message in the queue is larger than this size the function will fail (unless you set <i>flags</i> as described below). </p> The received message will be stored in <i>message</i>, unless there were errors receiving the message. </p> If set to <b>TRUE</b>, the message is treated as though it was serialized using the same mechanism as the session module. The message will be unserialized and then returned to your script. This allows you to easily receive arrays or complex object structures from other PHP scripts, or if you are using the WDDX serializer, from any WDDX compatible source. </p> <p> If <i>unserialize</i> is <b>FALSE</b>, the message will be returned as a binary-safe string. </p> The optional <i>flags</i> allows you to pass flags to the low-level msgrcv system call. It defaults to 0, but you may specify one or more of the following values (by adding or ORing them together). <table> Flag values for msg_receive <tr valign=\"top\"> <td><b>MSG_IPC_NOWAIT</b></td> <td>If there are no messages of the <i>desiredmsgtype</i>, return immediately and do not wait. The function will fail and return an integer value corresponding to <b>MSG_ENOMSG</b>. </td> </tr> <tr valign=\"top\"> <td><b>MSG_EXCEPT</b></td> <td>Using this flag in combination with a <i>desiredmsgtype</i> greater than 0 will cause the function to receive the first message that is not equal to <i>desiredmsgtype</i>.</td> </tr> <tr valign=\"top\"> <td><b>MSG_NOERROR</b></td> <td> If the message is longer than <i>maxsize</i>, setting this flag will truncate the message to <i>maxsize</i> and will not signal an error. </td> </tr> </table> </p> If the function fails, the optional <i>errorcode</i> will be set to the value of the system errno variable. </p> <p> Upon successful completion the message queue data structure is updated as follows: msg_lrpid is set to the process-ID of the calling process, msg_qnum is decremented by 1 and msg_rtime is set to the current time. </p> /","params":[{"name":"queue","declared_type":"SysvMessageQueue|resource","description":null},{"name":"desired_message_type","declared_type":"int","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"max_message_size","declared_type":"int","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"unserialize","declared_type":"bool","description":"[optional] <p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"},{"name":"error_code","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"msg_remove_queue","fqn":"msg_remove_queue","kind":"Function","origin":"PhpRuntime","extension":"sysvmsg","location":{"file":"sysvmsg/sysvmsg.php","range":{"start":6496,"end":6512}},"declared_type":null,"signature":{"parameters":[{"name":"queue","declared_type":null,"phpdoc_type":"SysvMessageQueue|resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Destroy a message queue Message queue resource handle </p> /","params":[{"name":"queue","declared_type":"SysvMessageQueue|resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"msg_send","fqn":"msg_send","kind":"Function","origin":"PhpRuntime","extension":"sysvmsg","location":{"file":"sysvmsg/sysvmsg.php","range":{"start":2364,"end":2372}},"declared_type":null,"signature":{"parameters":[{"name":"queue","declared_type":null,"phpdoc_type":"SysvMessageQueue|resource","optional":false,"variadic":false,"by_reference":false},{"name":"message_type","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"message","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"serialize","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"blocking","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"error_code","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Send a message to a message queue The optional <i>serialize</i> controls how the <i>message</i> is sent. <i>serialize</i> defaults to <b>TRUE</b> which means that the <i>message</i> is serialized using the same mechanism as the session module before being sent to the queue. This allows complex arrays and objects to be sent to other PHP scripts, or if you are using the WDDX serializer, to any WDDX compatible client. </p> If the message is too large to fit in the queue, your script will wait until another process reads messages from the queue and frees enough space for your message to be sent. This is called blocking; you can prevent blocking by setting the optional <i>blocking</i> parameter to <b>FALSE</b>, in which case <b>msg_send</b> will immediately return <b>FALSE</b> if the message is too big for the queue, and set the optional <i>errorcode</i> to <b>MSG_EAGAIN</b>, indicating that you should try to send your message again a little later on. </p> <p> Upon successful completion the message queue data structure is updated as follows: <i>msg_lspid</i> is set to the process-ID of the calling process, <i>msg_qnum</i> is incremented by 1 and <i>msg_stime</i> is set to the current time. </p> /","params":[{"name":"queue","declared_type":"SysvMessageQueue|resource","description":null},{"name":"message_type","declared_type":"int","description":null},{"name":"message","declared_type":"mixed","description":null},{"name":"serialize","declared_type":"bool","description":"[optional] <p>"},{"name":"blocking","declared_type":"bool","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"msg_set_queue","fqn":"msg_set_queue","kind":"Function","origin":"PhpRuntime","extension":"sysvmsg","location":{"file":"sysvmsg/sysvmsg.php","range":{"start":9174,"end":9187}},"declared_type":null,"signature":{"parameters":[{"name":"queue","declared_type":null,"phpdoc_type":"SysvMessageQueue|resource","optional":false,"variadic":false,"by_reference":false},{"name":"data","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set information in the message queue data structure Message queue resource handle </p> You specify the values you require by setting the value of the keys that you require in the <i>data</i> array. </p> /","params":[{"name":"queue","declared_type":"SysvMessageQueue|resource","description":"<p>"},{"name":"data","declared_type":"array","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"msg_stat_queue","fqn":"msg_stat_queue","kind":"Function","origin":"PhpRuntime","extension":"sysvmsg","location":{"file":"sysvmsg/sysvmsg.php","range":{"start":8616,"end":8630}},"declared_type":null,"signature":{"parameters":[{"name":"queue","declared_type":null,"phpdoc_type":"SysvMessageQueue|resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Returns information from the message queue data structure Message queue resource handle </p> meanings: <table> Array structure for msg_stat_queue <tr valign=\"top\"> <td>msg_perm.uid</td> <td> The uid of the owner of the queue. </td> </tr> <tr valign=\"top\"> <td>msg_perm.gid</td> <td> The gid of the owner of the queue. </td> </tr> <tr valign=\"top\"> <td>msg_perm.mode</td> <td> The file access mode of the queue. </td> </tr> <tr valign=\"top\"> <td>msg_stime</td> <td> The time that the last message was sent to the queue. </td> </tr> <tr valign=\"top\"> <td>msg_rtime</td> <td> The time that the last message was received from the queue. </td> </tr> <tr valign=\"top\"> <td>msg_ctime</td> <td> The time that the queue was last changed. </td> </tr> <tr valign=\"top\"> <td>msg_qnum</td> <td> The number of messages waiting to be read from the queue. </td> </tr> <tr valign=\"top\"> <td>msg_qbytes</td> <td> The maximum number of bytes allowed in one message queue. On Linux, this value may be read and modified via /proc/sys/kernel/msgmnb. </td> </tr> <tr valign=\"top\"> <td>msg_lspid</td> <td> The pid of the process that sent the last message to the queue. </td> </tr> <tr valign=\"top\"> <td>msg_lrpid</td> <td> The pid of the process that 