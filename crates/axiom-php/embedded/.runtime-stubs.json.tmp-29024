ection. /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"qos","fqn":"AMQPChannel::qos","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":10139,"end":10142}},"declared_type":null,"signature":{"parameters":[{"name":"size","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"global","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Set the Quality Of Service settings for the given channel. Specify the amount of data to prefetch in terms of window size (octets) or number of messages from a queue during a AMQPQueue::consume() or AMQPQueue::get() method call. The client will prefetch data up to size octets or count messages from the server, whichever limit is hit first. Setting either value to 0 will instruct the client to ignore that particular setting. A call to AMQPChannel::qos() will overwrite any values set by calling AMQPChannel::setPrefetchSize() and AMQPChannel::setPrefetchCount(). If the call to either AMQPQueue::consume() or AMQPQueue::get() is done with the AMQP_AUTOACK flag set, the client will not do any prefetching of data, regardless of the QOS settings. /","params":[{"name":"size","declared_type":"int","description":"The window size, in octets, to prefetch."},{"name":"count","declared_type":"int","description":"The number of messages to prefetch."},{"name":"global","declared_type":"bool","description":"TRUE for global, FALSE for consumer. FALSE by default."}],"return_type":"void","var_type":null,"throws":["AMQPConnectionException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"rollbackTransaction","fqn":"AMQPChannel::rollbackTransaction","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":10616,"end":10635}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Rollback a transaction. Rollback an existing transaction. AMQPChannel::startTransaction() must be called prior to this. calling this method. /","params":[],"return_type":"void","var_type":null,"throws":["AMQPChannelException","AMQPConnectionException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setConfirmCallback","fqn":"AMQPChannel::setConfirmCallback","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":15431,"end":15449}},"declared_type":null,"signature":{"parameters":[{"name":"ack_callback","declared_type":"?callable","phpdoc_type":"callable|null","optional":true,"variadic":false,"by_reference":false},{"name":"nack_callback","declared_type":"?callable","phpdoc_type":"callable|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Set callback to process basic.ack and basic.nac AMQP server methods (applicable when channel in confirm mode). Callback functions with all arguments have the following signature: function ack_callback(int $deliveryTag, bool $multiple) : bool; function nack_callback(int $deliveryTag, bool $multiple, bool $requeue) : bool; and should return boolean false when wait loop should be canceled. Note, basic.nack server method will only be delivered if an internal error occurs in the Erlang process responsible for a queue (see https://www.rabbitmq.com/confirms.html for details). /","params":[{"name":"ack_callback","declared_type":"callable|null","description":null},{"name":"nack_callback","declared_type":"callable|null","description":null}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setGlobalPrefetchCount","fqn":"AMQPChannel::setGlobalPrefetchCount","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":12619,"end":12641}},"declared_type":null,"signature":{"parameters":[{"name":"count","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Set the number of messages to prefetch from the broker across all consumers. Set the number of messages to prefetch from the broker during a call to AMQPQueue::consume() or AMQPQueue::get(). /","params":[{"name":"count","declared_type":"int","description":"The number of messages to prefetch."}],"return_type":"void","var_type":null,"throws":["AMQPConnectionException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setGlobalPrefetchSize","fqn":"AMQPChannel::setGlobalPrefetchSize","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":13553,"end":13574}},"declared_type":null,"signature":{"parameters":[{"name":"size","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Set the window size to prefetch from the broker for all consumers. Set the prefetch window size, in octets, during a call to AMQPQueue::consume() or AMQPQueue::get(). Any call to this method will automatically set the prefetch message count to 0, meaning that the prefetch message count setting will be ignored. If the call to either AMQPQueue::consume() or AMQPQueue::get() is done with the AMQP_AUTOACK flag set, this setting will be ignored. /","params":[{"name":"size","declared_type":"int","description":"The window size, in octets, to prefetch."}],"return_type":"void","var_type":null,"throws":["AMQPConnectionException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setPrefetchCount","fqn":"AMQPChannel::setPrefetchCount","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":11077,"end":11093}},"declared_type":null,"signature":{"parameters":[{"name":"count","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Set the number of messages to prefetch from the broker for each consumer. Set the number of messages to prefetch from the broker during a call to AMQPQueue::consume() or AMQPQueue::get(). /","params":[{"name":"count","declared_type":"int","description":"The number of messages to prefetch."}],"return_type":"void","var_type":null,"throws":["AMQPConnectionException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setPrefetchSize","fqn":"AMQPChannel::setPrefetchSize","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":11996,"end":12011}},"declared_type":null,"signature":{"parameters":[{"name":"size","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Set the window size to prefetch from the broker for each consumer. Set the prefetch window size, in octets, during a call to AMQPQueue::consume() or AMQPQueue::get(). Any call to this method will automatically set the prefetch message count to 0, meaning that the prefetch message count setting will be ignored. If the call to either AMQPQueue::consume() or AMQPQueue::get() is done with the AMQP_AUTOACK flag set, this setting will be ignored. /","params":[{"name":"size","declared_type":"int","description":"The window size, in octets, to prefetch."}],"return_type":"void","var_type":null,"throws":["AMQPConnectionException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setReturnCallback","fqn":"AMQPChannel::setReturnCallback","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":16598,"end":16615}},"declared_type":null,"signature":{"parameters":[{"name":"return_callback","declared_type":"?callable","phpdoc_type":"callable|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Set callback to process basic.return AMQP server method Callback function with all arguments has the following signature: function callback(int $reply_code, string $reply_text, string $exchange, string $routingKey, AMQPBasicProperties $properties, string $body) : bool; and should return boolean false when wait loop should be canceled. /","params":[{"name":"return_callback","declared_type":"callable|null","description":null}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"startTransaction","fqn":"AMQPChannel::startTransaction","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":14087,"end":14103}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Start a transaction. This method must be called on the given channel prior to calling AMQPChannel::commitTransaction() or AMQPChannel::rollbackTransaction(). /","params":[],"return_type":"void","var_type":null,"throws":["AMQPConnectionException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"waitForBasicReturn","fqn":"AMQPChannel::waitForBasicReturn","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":16913,"end":16931}},"declared_type":null,"signature":{"parameters":[{"name":"timeout","declared_type":null,"phpdoc_type":"float","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Start wait loop for basic.return AMQP server methods /","params":[{"name":"timeout","declared_type":"float","description":"Timeout in seconds. May be fractional."}],"return_type":"void","var_type":null,"throws":["AMQPQueueException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"waitForConfirm","fqn":"AMQPChannel::waitForConfirm","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":15907,"end":15921}},"declared_type":null,"signature":{"parameters":[{"name":"timeout","declared_type":null,"phpdoc_type":"float","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Wait until all messages published since the last call have been either ack'd or nack'd by the broker. Note, this method also catch all basic.return message from server. /","params":[{"name":"timeout","declared_type":"float","description":"Timeout in seconds. May be fractional."}],"return_type":"void","var_type":null,"throws":["AMQPQueueException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"AMQPConnection::__construct","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":20095,"end":20106}},"declared_type":null,"signature":{"parameters":[{"name":"credentials","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Create an instance of AMQPConnection. Creates an AMQPConnection instance representing a connection to an AMQP broker. A connection will not be established until AMQPConnection::connect() is called. $credentials = array( 'host'  => amqp.host The host to connect too. Note: Max 1024 characters. 'port'  => amqp.port Port on the host. 'vhost' => amqp.vhost The virtual host on the host. Note: Max 128 characters. 'login' => amqp.login The login name to use. Note: Max 128 characters. 'password' => amqp.password Password. Note: Max 128 characters. 'read_timeout'  => Timeout in for income activity. Note: 0 or greater seconds. May be fractional. 'write_timeout' => Timeout in for outcome activity. Note: 0 or greater seconds. May be fractional. 'connect_timeout' => Connection timeout. Note: 0 or greater seconds. May be fractional. 'rpc_timeout' => RPC timeout. Note: 0 or greater seconds. May be fractional. Connection tuning options (see http://www.rabbitmq.com/amqp-0-9-1-reference.html#connection.tune for details): 'channel_max' => Specifies highest channel number that the server permits. 0 means standard extension limit (see PHP_AMQP_MAX_CHANNELS constant) 'frame_max'   => The largest frame size that the server proposes for the connection, including frame header and end-byte. 0 means standard extension limit (depends on librabbimq default frame size limit) 'heartbeat'   => The delay, in seconds, of the connection heartbeat that the server wants. 0 means the server does not want a heartbeat. Note, librabbitmq has limited heartbeat support, which means heartbeats checked only during blocking calls. TLS support (see https://www.rabbitmq.com/ssl.html for details): 'cacert' => Path to the CA cert file in PEM format.. 'cert'   => Path to the client certificate in PEM foramt. 'key'    => Path to the client key in PEM format. 'verify' => Enable or disable peer verification. If peer verification is enabled then the common name in the server certificate must match the server name. Peer verification is enabled by default. 'connection_name' => A user determined name for the connection ) connecting to the AMQP broker. /","params":[{"name":"credentials","declared_type":"array","description":"Optional array of credential information for"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"connect","fqn":"AMQPConnection::connect","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":21023,"end":21030}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Establish a transient connection with the AMQP broker. This method will initiate a connection with the AMQP broker. /","params":[],"return_type":"void","var_type":null,"throws":["AMQPConnectionException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"disconnect","fqn":"AMQPConnection::disconnect","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":21339,"end":21349}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Closes the transient connection with the AMQP broker. This method will close an open connection with the AMQP broker. /","params":[],"return_type":"void","var_type":null,"throws":["AMQPConnectionException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getCACert","fqn":"AMQPConnection::getCACert","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":28375,"end":28384}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string|null"},"documentation":{"description":"Get path to