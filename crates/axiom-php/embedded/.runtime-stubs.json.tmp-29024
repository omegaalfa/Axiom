he dimensions of a vector set $redis->vdim('embeddings'); /","params":[{"name":"key","declared_type":"string","description":"The vector set to query."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"vemb","fqn":"Redis::vemb","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":186281,"end":186285}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"raw","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Get the embeddings for a specific member $redis->vemb('embeddings', 'doc:1'); /","params":[{"name":"key","declared_type":"string","description":"The vector set to query."},{"name":"member","declared_type":"mixed","description":"The member to query."},{"name":"raw","declared_type":"bool","description":"If set to `true`, the raw embeddings will be returned"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"vgetattr","fqn":"Redis::vgetattr","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":189261,"end":189269}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"decode","declared_type":"bool","phpdoc_type":"b