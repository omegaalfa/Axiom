ever unit the resource limit requires, or POSIX_RLIMIT_INFINITY."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_setsid","fqn":"posix_setsid","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":4418,"end":4430}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Make the current process a session leader /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_setuid","fqn":"posix_setuid","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":1349,"end":1361}},"declared_type":null,"signature":{"parameters":[{"name":"user_id","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set the UID of the current process The user id. </p> /","params":[{"name":"user_id","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_strerror","fqn":"posix_strerror","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":21065,"end":21079}},"declared_type":null,"signature":{"parameters":[{"name":"error_code","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Retrieve the system error message associated with the given errno A POSIX error number, returned by <b>posix_get_last_error</b>. If set to 0, then the string \"Success\" is returned. </p> /","params":[{"name":"error_code","declared_type":"int","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_sysconf","fqn":"posix_sysconf","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":21666,"end":21679}},"declared_type":null,"signature":{"parameters":[{"name":"conf_id","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":null},"documentation":{"description":"Returns system runtime information. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_times","fqn":"posix_times","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":7181,"end":7192}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Get process times process CPU usage. The indices of the hash are: ticks - the number of clock ticks that have elapsed since reboot. utime - user time used by the current process. stime - system time used by the current process. cutime - user time used by current process and children. cstime - system time used by current process and children. /","params":[],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_ttyname","fqn":"posix_ttyname","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":7933,"end":7946}},"declared_type":null,"signature":{"parameters":[{"name":"file_descriptor","declared_type":null,"phpdoc_type":"resource|int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Determine terminal device name The file descriptor. </p> <i>fd</i>. On failure, returns <b>FALSE</b> /","params":[{"name":"file_descriptor","declared_type":"resource|int","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_uname","fqn":"posix_uname","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":6475,"end":6486}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Get system name system. The indices of the hash are sysname - operating system name (e.g. Linux) nodename - system name (e.g. valiant) release - operating system release (e.g. 2.2.10) version - operating system version (e.g. #4 Tue Jul 20 17:01:36 MEST 1999) machine - system architecture (e.g. i586) domainname - DNS domainname (e.g. example.com) </p> <p> domainname is a GNU extension and not part of POSIX.1, so this field is only available on GNU systems or when using the GNU libc. /","params":[],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pow","fqn":"pow","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":10085,"end":10088}},"declared_type":null,"signature":{"parameters":[{"name":"num","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"exponent","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"object|int|float","phpdoc_return_type":"object|int|float"},"documentation":{"description":"Exponential expression The base to use </p> The exponent </p> If the result can be represented as integer it will be returned as type integer, else it will be returned as type float. If the power cannot be computed false will be returned instead. /","params":[{"name":"num","declared_type":"mixed","description":"<p>"},{"name":"exponent","declared_type":"mixed","description":"<p>"}],"return_type":"object|int|float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_filter","fqn":"preg_filter","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":13724,"end":13735}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"replacement","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"array|string|null","phpdoc_return_type":"string|string[]|null"},"documentation":{"description":"Perform a regular expression search and replace parameter is an array, or a string otherwise. </p> <p> If no matches are found or an error occurred, an empty array is returned when <i>subject</i> is an array or <b>NULL</b> otherwise. /","params":[{"name":"pattern","declared_type":"string|string[]","description":null},{"name":"replacement","declared_type":"string|string[]","description":null},{"name":"subject","declared_type":"string|string[]","description":null},{"name":"limit","declared_type":"int","description":"[optional]"},{"name":"","declared_type":null,"description":null}],"return_type":"string|string[]|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_grep","fqn":"preg_grep","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":16134,"end":16143}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"array","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Return array entries that match the pattern The pattern to search for, as a string. </p> The input array. </p> If set to <b>PREG_GREP_INVERT</b>, this function returns the elements of the input array that do not match the given <i>pattern</i>. </p> <i>input</i> array or false when pattern cannot be compiled. /","params":[{"name":"pattern","declared_type":"string","description":"<p>"},{"name":"array","declared_type":"array","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_last_error","fqn":"preg_last_error","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":16716,"end":16731}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Returns the error code of the last PCRE regex execution <b>PREG_NO_ERROR</b> <b>PREG_INTERNAL_ERROR</b> <b>PREG_BACKTRACK_LIMIT_ERROR</b> (see also pcre.backtrack_limit) <b>PREG_RECURSION_LIMIT_ERROR</b> (see also pcre.recursion_limit) <b>PREG_BAD_UTF8_ERROR</b> <b>PREG_BAD_UTF8_OFFSET_ERROR</b> (since PHP 5.3.0) /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_last_error_msg","fqn":"preg_last_error_msg","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":17001,"end":17020}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Returns the error message of the last PCRE regex execution /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_match","fqn":"preg_match","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":3943,"end":3953}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"matches","declared_type":"?array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Perform a regular expression match The pattern to search for, as a string. </p> The input string. </p> If <i>matches</i> is provided, then it is filled with the results of search. $matches[0] will contain the text that matched the full pattern, $matches[1] will have the text that matched the first captured parenthesized subpattern, and so on. </p> <i>flags</i> can be the following flag: <b>PREG_OFFSET_CAPTURE</b> <blockquote> If this flag is passed, for every occurring match the appendant string offset will also be returned. Note that this changes the value of <i>matches</i> into an array where every element is an array consisting of the matched string at offset 0 and its string offset into <i>subject</i> at offset 1. <pre> <?php preg_match('/(foo)(bar)(baz)/', 'foobarbaz', $matches, PREG_OFFSET_CAPTURE); print_r($matches); ?> </pre> The above example will output: <pre> Array ( [0] => Array ( [0] => foobarbaz [1] => 0 ) [1] => Array ( [0] => foo [1] => 0 ) [2] => Array ( [0] => bar [1] => 3 ) [3] => Array ( [0] => baz [1] => 6 ) ) </pre> </blockquote> <b>PREG_UNMATCHED_AS_NULL</b> <blockquote> If this flag is passed, unmatched subpatterns are reported as NULL; otherwise they are reported as an empty string. <pre> <?php preg_match('/(a)(b)*(c)/', 'ac', $matches); var_dump($matches); preg_match('/(a)(b)*(c)/', 'ac', $matches, PREG_UNMATCHED_AS_NULL); var_dump($matches); ?> </pre> The above example will output: <pre> array(4) { [0]=> string(2) \"ac\" [1]=> string(1) \"a\" [2]=> string(0) \"\" [3]=> string(1) \"c\" } array(4) { [0]=> string(2) \"ac\" [1]=> string(1) \"a\" [2]=> NULL [3]=> string(1) \"c\" } </pre> </blockquote> Normally, the search starts from the beginning of the subject string. The optional parameter <i>offset</i> can be used to specify the alternate place from which to start the search (in bytes). </p> <p> Using <i>offset</i> is not equivalent to passing substr($subject, $offset) to <b>preg_match</b> in place of the subject string, because <i>pattern</i> can contain assertions such as ^, $ or (?&lt;=x). Compare: <pre> $subject = \"abcdef\"; $pattern = '/^def/'; preg_match($pattern, $subject, $matches, PREG_OFFSET_CAPTURE, 3); print_r($matches); </pre> The above example will output:</p> <pre> Array ( ) </pre> <p> while this example </p> <code> $subject = \"abcdef\"; $pattern = '/^def/'; preg_match($pattern, substr($subject,3), $matches, PREG_OFFSET_CAPTURE); print_r($matches); </code> <p> will produce </p> <pre> Array ( [0] => Array ( [0] => def [1] => 0 ) ) </pre> Alternatively, to avoid using substr(), use the \\G assertion rather than the ^ anchor, or the A modifier instead, both of which work with the offset parameter. </p> matches given <i>subject</i>, 0 if it does not, or <b>FALSE</b> if an error occurred. /","params":[{"name":"pattern","declared_type":"string","description":"<p>"},{"name":"subject","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"flags","declared_type":"int","description":"[optional] <p>"},{"name":"offset","declared_type":"int","description":"[optional] <p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_match_all","fqn":"preg_match_all","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":6065,"end":6079}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"matches","declared_type":"?array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int|false|null"},"documentation":{"description":"Perform a global regular expression match The pattern to search for, as a string. </p> The input string. </p> Array of all matches in multi-dimensional array ordered according to flags. </p> Can be a combination of the following flags (note that it doesn't make sense to use <b>PREG_PATTERN_ORDER</b> together with <b>PREG_SET_ORDER</b>): <b>PREG_PATTERN_ORDER</b> <br> Orders results so that $matches[0] is an array of full pattern matches, $matches[1] is an array of strings matched by the first parenthesized subpattern, and so on. </p> Normally, the search starts from the beginning of the subject string. The optional parameter <i>offset</i> can be used to specify the alternate place from which to start the search (in bytes). </p> <p> Using <i>offset</i> is not equivalent to passing substr($subject, $offset) to <b>preg_match_all</b> in place of the subject string, because <i>pattern</i> can contain assertions such as ^, $ or (?&lt;=x). See <b>preg_match</b> for examples. </p> <p> <code> preg_match_all(\"|]+>(.*)]+>|U\", \"example: this is a test\", $out, PREG_PATTERN_ORDER); echo $out[0][0] . \", \" . $out[0][1] . \"\\n\"; echo $out[1][0] . \", \" . $out[1][1] . \"\\n\"; </code> The above example will output:</p> <pre> example: , this is a test example: , this is a test </pre> <p> So, $out[0] contains array of strings that matched full pattern, and $out[1] contains array of strings enclosed by tags. </p> or <b>FALSE</b> if an error occurred. /","params":[{"name":"pattern","declared_type":"string","description":"<p>"},{"name":"subject","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"flags","declared_type":"int","description":"<p>"},{"name":"offset","declared_type":"int","description":"[optional] <p>"}],"return_type":"int|false|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_quote","fqn":"preg_quote","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":15491,"end":15501}},"declared_type":null,"signature":{"parameters":[{"name":"str","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"delimiter","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Quote regular expression characters The input string. </p> If the optional <i>delimiter</i> is specified, it will also be escaped. This is useful for escaping the delimiter that is required by the PCRE functions. The / is the most commonly used delimiter. </p> /","params":[{"name":"str","declared_type":"string","description":"<p>"},{"name":"delimiter","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_replace","fqn":"preg_replace","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":9615,"end":9627}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"replacement","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"array|string|null","phpdoc_return_type":"string|string[]|null"},"documentation":{"description":"Perform a regular expression search and replace The pattern to search for. It can be either a string or an array with strings. </p> <p> Several PCRE modifiers are also available, including the deprecated 'e' (PREG_REPLACE_EVAL), which is specific to this function. </p> The string or an array with strings to replace. If this parameter is a string and the <i>pattern</i> parameter is an array, all patterns will be replaced by that string. If both <i>pattern</i> and <i>replacement</i> parameters are arrays, each <i>pattern</i> will be replaced by the <i>replacement</i> counterpart. If there are fewer elements in the <i>replacement</i> array than in the <i>pattern</i> array, any extra <i>pattern</i>s will be replaced by an empty string. </p> <p> <i>replacement</i> may contain references of the form \\\\n or (since PHP 4.0.4) $n, with the latter form being the preferred one. Every such reference will be replaced by the text captured by the n'th parenthesized pattern. n can be from 0 to 99, and \\\\0 or $0 refers to the text matched by the whole pattern. Opening parentheses are counted from left to right (starting from 1) to obtain the number of the capturing subpattern. To use backslash in replacement, it must be doubled (\"\\\\\\\\\" PHP string). </p> <p> When working with a replacement pattern where a backreference is immediately followed by another number (i.e.: placing a literal number immediately after a matched pattern), you cannot use the familiar \\\\1 notation for your backreference. \\\\11, for example, would confuse <b>preg_replace</b> since it does not know whether you want the \\\\1 backreference followed by a literal 1, or the \\\\11 backreference followed by nothing. In this case the solution is to use \\${1}1. This creates an isolated $1 backreference, leaving the 1 as a literal. </p> <p> When using the deprecated e modifier, this function escapes some characters (namely ', \", \\ and NULL) in the strings that replace the backreferences. This is done to ensure that no syntax errors arise from backreference usage with either single or double quotes (e.g. 'strlen(\\'$1\\')+strlen(\"$2\")'). Make sure you are aware of PHP's string syntax to know exactly how the interpreted string will look. </p> The string or an array with strings to search and replace. </p> <p> If <i>subject</i> is an array, then the search and replace is performed on every entry of <i>subject</i>, and the return value is an array as well. </p> The maximum possible replacements for each pattern in each <i>subject</i> string. Defaults to -1 (no limit). </p> If specified, this variable will be filled with the number of replacements done. </p> <i>subject</i> parameter is an array, or a string otherwise. </p> <p> If matches are found, the new <i>subject</i> will be returned, otherwise <i>subject</i> will be returned unchanged or <b>NULL</b> if an error occurred. /","params":[{"name":"pattern","declared_type":"string|string[]","description":"<p>"},{"name":"replacement","declared_type":"string|string[]","description":"<p>"},{"name":"subject","declared_type":"string|string[]","description":"<p>"},{"name":"limit","declared_type":"int","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null}],"return_type":"string|string[]|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_replace_callback","fqn":"preg_replace_callback","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":12032,"end":12053}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"callback","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|string|null","phpdoc_return_type":"string|string[]|null"},"documentation":{"description":"Perform a regular expression search and replace using a callback The pattern to search for. It can be either a string or an array with strings. </p> A callback that will be called and passed an array of matched elements in the <i>subject</i> string. The callback should return the replacement string. This is the callback signature: </p> <p> string<b>handler</b> <b>array<i>matches</i></b> </p> <p> You'll often need the <i>callback</i> function for a <b>preg_replace_callback</b> in just one place. In this case you can use an anonymous function to declare the callback within the call to <b>preg_replace_callback</b>. By doing it this way you have all information for the call in one place and do not clutter the function namespace with a callback function's name not used anywhere else. </p> <p> <b>preg_replace_callback</b> and anonymous function <code> /* a unix-style command line filter to convert uppercase * letters at the beginning of paragraphs to lowercase * / $fp = fopen(\"php://stdin\", \"r\") or die(\"can't read stdin\"); while (!feof($fp)) { $line = fgets($fp); $line = preg_replace_callback( '|<p>\\s*\\w|', function ($matches) { return strtolower($matches[0]); }, $line ); echo $line; } fclose($fp); </code> </p> The string or an array with strings to search and replace. </p> The maximum possible replacements for each pattern in each <i>subject</i> string. Defaults to -1 (no limit). </p> If specified, this variable will be filled with the number of replacements done. </p> <i>subject</i> parameter is an array, or a string otherwise. On errors the return value is <b>NULL</b> </p> <p> If matches are found, the new subject will be returned, otherwise <i>subject</i> will be returned unchanged. /","params":[{"name":"pattern","declared_type":"string|string[]","description":"<p>"},{"name":"callback","declared_type":"callable","description":"<p>"},{"name":"subject","declared_type":"string|string[]","description":"<p>"},{"name":"limit","declared_type":"int","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null},{"name":"flags","declared_type":"int","description":"[optional]"}],"return_type":"string|string[]|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_replace_callback_array","fqn":"preg_replace_callback_array","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":12948,"end":12975}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"array","phpdoc_type":"callable[]","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|string|null","phpdoc_return_type":"string|string[]|null"},"documentation":{"description":"Perform a regular expression search and replace using callbacks <p>If matches are found, the new subject will be returned, otherwise subject will be returned unchanged.</p> /","params":[{"name":"pattern","declared_type":"callable[]","description":"An associative array mapping patterns (keys) to callbacks (values)"},{"name":"subject","declared_type":"string|string[]","description":null},{"name":"limit","declared_type":"int","description":"[optional]"},{"name":"","declared_type":null,"description":null},{"name":"flags","declared_type":"int","description":"[optional]"}],"return_type":"string|string[]|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"preg_split","fqn":"preg_split","kind":"Function","origin":"PhpRuntime","extension":"pcre","location":{"file":"pcre/pcre.php","range":{"start":14906,"end":14916}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"limit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"string[]|false"},"documentation":{"description":"Split string by a regular expression The pattern to search for, as a string. </p> The input string. </p> If specified, then only substrings up to <i>limit</i> are returned with the rest of the string being placed in the last substring. A <i>limit</i> of -1, 0 or <b>NULL</b> means \"no limit\" and, as is standard across PHP, you can use <b>NULL</b> to skip to the <i>flags</i> parameter. </p> <i>flags</i> can be any combination of the following flags (combined with the | bitwise operator): <b>PREG_SPLIT_NO_EMPTY</b> If this flag is set, only non-empty pieces will be returned by <b>preg_split</b>. </p> split along boundaries matched by <i>pattern</i>, or <b>FALSE</b> if an error occurred. /","params":[{"name":"pattern","declared_type":"string","description":"<p>"},{"name":"subject","declared_type":"string","description":"<p>"},{"name":"limit","declared_type":"int","description":"[optional] <p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"string[]|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"prev","fqn":"prev","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":23836,"end":23840}},"declared_type":null,"signature":{"parameters":[{"name":"array","declared_type":"object|array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true}],"declared_return_type":"mixed","phpdoc_return_type":"mixed|false"},"documentation":{"description":"Rewind the internal array pointer The input array. </p> the internal array pointer, or false if there are no more elements. /","params":[{"name":"","declared_type":null,"description":null}],"return_type":"mixed|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"print_r","fqn":"print_r","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":9561,"end":9568}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"return","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|bool"},"documentation":{"description":"Prints human-readable information about a variable The expression to be printed. </p> If you would like to capture the output of print_r, use the return parameter. If this parameter is set to true, print_r will return its output, instead of printing it (which it does by default). </p> the value itself will be printed. If given an array, values will be presented in a format that shows keys and elements. Similar notation is used for objects. /","params":[{"name":"value","declared_type":"mixed","description":"<p>"},{"name":"return","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"printf","fqn":"printf","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_2.php","range":{"start":12882,"end":12888}},"declared_type":null,"signature":{"parameters":[{"name":"format","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Output a formatted string See sprintf for a description of format. </p> </p> Prior to PHP 8.0.0, a E_WARNING was emitted instead. As of PHP 8.0.0, a ValueError is thrown if [width] is less than zero or bigger than PHP_INT_MAX. Prior to PHP 8.0.0, a E_WARNING was emitted instead. As of PHP 8.0.0, a ValueError is thrown if [precision] is less than zero or bigger than PHP_INT_MAX. Prior to PHP 8.0.0, a E_WARNING was emitted instead. are given than required. Prior to PHP 8.0.0, false was returned and a E_WARNING emitted instead. /","params":[{"name":"format","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":["\\ValueError","\\ArgumentCountError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"proc_close","fqn":"proc_close","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_2.php","range":{"start":32743,"end":32753}},"declared_type":null,"signature":{"parameters":[{"name":"process","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Close a process opened by {@see proc_open} and return the exit code of that process The proc_open resource that will be closed. </p> /","params":[{"name":"process","declared_type":"resource","description":"<p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"proc_get_status","fqn":"proc_get_status","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_2.php","range":{"start":35471,"end":35486}},"declared_type":null,"signature":{"parameters":[{"name":"process","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"Get information about a process opened by {@see proc_open} The proc_open resource that will be evaluated. </p> on failure. The returned array contains the following elements: </p> <p> <tr valign=\"top\"><td>element</td><td>type</td><td>description</td></tr> <tr valign=\"top\"> <td>command</td> <td>string</td> <td> The command string that was passed to proc_open. </td> </tr> <tr valign=\"top\"> <td>pid</td> <td>int</td> <td>process id</td> </tr> <tr valign=\"top\"> <td>running</td> <td>bool</td> <td> true if the process is still running, false if it has terminated. </td> </tr> <tr valign=\"top\"> <td>signaled</td> <td>bool</td> <td> true if the child process has been terminated by an uncaught signal. Always set to false on Windows. </td> </tr> <tr valign=\"top\"> <td>stopped</td> <td>bool</td> <td> true if the child process has been stopped by a signal. Always set to false on Windows. </td> </tr> <tr valign=\"top\"> <td>exitcode</td> <td>int</td> <td> The exit code returned by the process (which is only meaningful if running is false). Only first call of this function return real value, next calls return -1. </td> </tr> <tr valign=\"top\"> <td>termsig</td> <td>int</td> <td> The number of the signal that caused the child process to terminate its execution (only meaningful if signaled is true). </td> </tr> <tr valign=\"top\"> <td>stopsig</td> <td>int</td> <td> The number of the signal that caused the child process to stop its execution (only meaningful if stopped is true). </td> </tr> /","params":[{"name":"process","declared_type":"resource","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"proc_nice","fqn":"proc_nice","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_2.php","range":{"start":35940,"end":35949}},"declared_type":null,"signature":{"parameters":[{"name":"priority","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Change the priority of the current process. <br/> Since 7.2.0 supported on Windows platforms. The increment value of the priority change. </p> If an error occurs, like the user lacks permission to change the priority, an error of level E_WARNING is also generated. /","params":[{"name":"priority","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"proc_open","fqn":"proc_open","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_2.php","range":{"start":32283,"end":32292}},"declared_type":null,"signature":{"parameters":[{"name":"command","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"descriptor_spec","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"pipes","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"cwd","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"env_vars","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Execute a command and open file pointers for input/output Execute a command and open file pointers for input/output </p> <p> As of PHP 7.4.0, cmd may be passed as array of command parameters. In this case the process will be opened directly (without going through a shell) and PHP will take care of any necessary argument escaping. </p> An indexed array where the key represents the descriptor number and the value represents how PHP will pass that descriptor to the child process. 0 is stdin, 1 is stdout, while 2 is stderr. </p> <p> Each element can be: An array describing the pipe to pass to the process. The first element is the descriptor type and the second element is an option for the given type. Valid types are pipe (the second element is either r to pass the read end of the pipe to the process, or w to pass the write end) and file (the second element is a filename). A stream resource representing a real file descriptor (e.g. opened file, a socket, STDIN). </p> <p> The file descriptor numbers are not limited to 0, 1 and 2 - you may specify any valid file descriptor number and it will be passed to the child process. This allows your script to interoperate with other scripts that run as \"co-processes\". In particular, this is useful for passing passphrases to programs like PGP, GPG and openssl in a more secure manner. It is also useful for reading status information provided by those programs on auxiliary file descriptors. </p> Will be set to an indexed array of file pointers that correspond to PHP's end of any pipes that are created. </p> The initial working dir for the command. This must be an absolute directory path, or null if you want to use the default value (the working dir of the current PHP process) </p> An array with the environment variables for the command that will be run, or null to use the same environment as the current PHP process </p> Allows you to specify additional options. Currently supported options include: suppress_errors (windows only): suppresses errors generated by this function when it's set to TRUE generated by this function when it's set to true bypass_shell (windows only): bypass cmd.exe shell when set to TRUE context: stream context used when opening files (created with stream_context_create) blocking_pipes: (windows only): force blocking pipes when set to TRUE create_process_group (windows only): allow the child process to handle CTRL events when set to TRUE create_new_console (windows only): the new process has a new console, instead of inheriting its parent's console </p> proc_close when you are finished with it. On failure returns false. one non-empty element. /","params":[{"name":"command","declared_type":"array|string","description":"<p>"},{"name":"descriptor_spec","declared_type":"array","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"cwd","declared_type":"string|null","description":"[optional] <p>"},{"name":"env_vars","declared_type":"array|null","description":"[optional] <p>"},{"name":"options","declared_type":"array|null","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"proc_terminate","fqn":"proc_terminate","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_2.php","range":{"start":33277,"end":33291}},"declared_type":null,"signature":{"parameters":[{"name":"process","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"signal","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Kills a process opened by proc_open The proc_open resource that will be closed. </p> This optional parameter is only useful on POSIX operating systems; you may specify a signal to send to the process using the kill(2) system call. The default is SIGTERM. </p> /","params":[{"name":"process","declared_type":"resource","description":"<p>"},{"name":"signal","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"property_exists","fqn":"property_exists","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":12770,"end":12785}},"declared_type":null,"signature":{"parameters":[{"name":"object_or_class","declared_type":null,"phpdoc_type":"object|string","optional":false,"variadic":false,"by_reference":false},{"name":"property","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Checks if the object or class has a property The class name or an object of the class to test for </p> The name of the property </p> /","params":[{"name":"object_or_class","declared_type":"object|string","description":"<p>"},{"name":"property","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PS_UNRESERVE_PREFIX___halt_compiler","fqn":"PS_UNRESERVE_PREFIX___halt_compiler","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/_standard_manual.php","range":{"start":490,"end":525}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"(PHP 5.1)<br/> Halts the execution of the compiler. This can be useful to embed data in PHP scripts, like the installation files. Byte position of the data start can be determined by the __COMPILER_HALT_OFFSET__ constant which is defined only if there is a __halt_compiler() presented in the file. <p> Note: __halt_compiler() can only be used from the outermost scope.</p> /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PS_UNRESERVE_PREFIX_array","fqn":"PS_UNRESERVE_PREFIX_array","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/_types.php","range":{"start":862,"end":887}},"declared_type":null,"signature":{"parameters":[{"name":"_","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Creates an array. Syntax \"index => values\", separated by commas, define index and values. index may be of type string or integer. When index is omitted, an integer index is automatically generated, starting at 0. If index is an integer, next generated index will be the biggest integer index + 1. Note that when two identical index are defined, the last overwrite the first. </p> <p> Having a trailing comma after the last defined array entry, while unusual, is a valid syntax. </p> /","params":[{"name":"","declared_type":null,"description":null}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PS_UNRESERVE_PREFIX_die","fqn":"PS_UNRESERVE_PREFIX_die","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/_types.php","range":{"start":2115,"end":2138}},"declared_type":null,"signature":{"parameters":[{"name":"status","declared_type":null,"phpdoc_type":"int|string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"never"},"documentation":{"description":"<p>Terminates execution of the script. Shutdown functions and object destructors will always be executed even if exit is called.</p> <p>die is a language construct and it can be called without parentheses if no status is passed.</p> If status is a string, this function prints the status just before exiting. </p> <p> If status is an integer, that value will be used as the exit status and not printed. Exit statuses should be in the range 0 to 254, the exit status 255 is reserved by PHP and shall not be used. The status 0 is used to terminate the program successfully. </p> <p> Note: PHP >= 4.2.0 does NOT print the status if it is an integer. </p> /","params":[{"name":"status","declared_type":"int|string","description":"[optional] <p>"}],"return_type":"never","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PS_UNRESERVE_PREFIX_empty","fqn":"PS_UNRESERVE_PREFIX_empty","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/_types.php","range":{"start":4443,"end":4468}},"declared_type":null,"signature":{"parameters":[{"name":"var","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Determine whether a variable is considered to be empty. A variable is considered empty if it does not exist or if its value equals <b>FALSE</b>. <b>empty()</b> does not generate a warning if the variable does not exist. <p>Note: Prior to PHP 5.5, <b>empty()</b> only supports variables; anything else will result in a parse error. In other words, the following will not work: <b>empty(trim($name))</b>. Instead, use <b>trim($name) == false</b>. </p> <p> No warning is generated if the variable does not exist. That means <b>empty()</b> is essentially the concise equivalent to <b>!isset($var) || $var == false</b>. </p> <p> The following things are considered to be empty: <ul> <li>\"\" (an empty string)</li> <li>0 (0 as an integer)</li> <li>0.0 (0 as a float)</li> <li>\"0\" (0 as a string)</li> <li><b>NULL</b></li> <li><b>FALSE</b></li> <li>array() (an empty array)</li> <li>$var; (a variable declared, but without a value)</li> </ul> </p> /","params":[{"name":"var","declared_type":"mixed","description":"<p>Variable to be checked.</p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PS_UNRESERVE_PREFIX_eval","fqn":"PS_UNRESERVE_PREFIX_eval","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/_types.php","range":{"start":7853,"end":7877}},"declared_type":null,"signature":{"parameters":[{"name":"code","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"<p>Evaluates the given code as PHP.</p> <p>Caution: The <b>eval()</b> language construct is very dangerous because it allows execution of arbitrary PHP code. Its use thus is discouraged. If you have carefully verified that there is no other option than to use this construct, pay special attention not to pass any user provided data into it without properly validating it beforehand.</p> Valid PHP code to be evaluated. </p> <p> The code must not be wrapped in opening and closing PHP tags, i.e. 'echo \"Hi!\";' must be passed instead of '<?php echo \"Hi!\"; ?>'. It is still possible to leave and re-enter PHP mode though using the appropriate PHP tags, e.g. 'echo \"In PHP mode!\"; ?>In HTML mode!<?php echo \"Back in PHP mode!\";'. </p> <p> Apart from that the passed code must be valid PHP. This includes that all statements must be properly terminated using a semicolon. 'echo \"Hi!\"' for example will cause a parse error, whereas 'echo \"Hi!\";' will work. </p> <p> A return statement will immediately terminate the evaluation of the code. </p> <p> The code will be executed in the scope of the code calling <b>eval()</b>. Thus any variables defined or changed in the <b>eval()</b> call will remain visible after it terminates. </p> As of PHP 7, if there is a parse error in the evaluated code, <b>eval()</b> throws a ParseError exception. Before PHP 7, in this case <b>eval()</b> returned <b>FALSE</b> and execution of the following code continued normally. It is not possible to catch a parse error in <b>eval()</b> using set_error_handler(). /","params":[{"name":"code","declared_type":"string","description":"<p>"}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PS_UNRESERVE_PREFIX_exit","fqn":"PS_UNRESERVE_PREFIX_exit","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/_types.php","range":{"start":3042,"end":3066}},"declared_type":null,"signature":{"parameters":[{"name":"status","declared_type":null,"phpdoc_type":"int|string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"never"},"documentation":{"description":"<p>Terminates execution of the script. Shutdown functions and object destructors will always be executed even if exit is called.</p> <p>exit is a language construct and it can be called without parentheses if no status is passed.</p> If status is a string, this function prints the status just before exiting. </p> <p> If status is an integer, that value will be used as the exit status and not printed. Exit statuses should be in the range 0 to 254, the exit status 255 is reserved by PHP and shall not be used. The status 0 is used to terminate the program successfully. </p> <p> Note: PHP >= 4.2.0 does NOT print the status if it is an integer. </p> /","params":[{"name":"status","declared_type":"int|string","description":"[optional] <p>"}],"return_type":"never","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PS_UNRESERVE_PREFIX_isset","fqn":"PS_UNRESERVE_PREFIX_isset","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/_types.php","range":{"start":5382,"end":5407}},"declared_type":null,"signature":{"parameters":[{"name":"var","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"_","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"<p>Determine if a variable is set and is not <b>NULL</b>.</p> <p>If a variable has been unset with unset(), it will no longer be set. <b>isset()</b> will return <b>FALSE</b> if testing a variable that has been set to <b>NULL</b>. Also note that a null character (\"\\0\") is not equivalent to the PHP <b>NULL</b> constant.</p> <p>If multiple parameters are supplied then <b>isset()</b> will return <b>TRUE</b> only if all of the parameters are set. Evaluation goes from left to right and stops as soon as an unset variable is encountered.</p> /","params":[{"name":"var","declared_type":"mixed","description":"<p>The variable to be checked.</p>"},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PS_UNRESERVE_PREFIX_list","fqn":"PS_UNRESERVE_PREFIX_list","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/_types.php","range":{"start":1189,"end":1213}},"declared_type":null,"signature":{"parameters":[{"name":"var1","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"_","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Assigns a list of variables in one operation. /","params":[{"name":"var1","declared_type":"mixed","description":"<p>A variable.</p>"},{"name":"","declared_type":null,"description":null}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PS_UNRESERVE_PREFIX_unset","fqn":"PS_UNRESERVE_PREFIX_unset","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/_types.php","range":{"start":5844,"end":5869}},"declared_type":null,"signature":{"parameters":[{"name":"var","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"_","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"<p>Destroys the specified variables.</p> <p>The behavior of <b>unset()</b> inside of a function can vary depending on what type of variable you are attempting to destroy.</p> /","params":[{"name":"var","declared_type":"mixed","description":"<p>The variable to be unset.</p>"},{"name":"","declared_type":null,"description":null}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pspell_add_to_personal","fqn":"pspell