 of local paths of files to be committed </p> This parameter must be an array, a string for a single target is not acceptable. Relative paths will be resolved as if the current working directory was the one that contains the PHP binary. To use the calling script&#x00027;s working directory, use <b>realpath</b> or dirname(__FILE__). Boolean flag to disable recursive committing of directories in the <i>targets</i> array. Default is <b>TRUE</b>. </p> <pre> array( 0 => integer revision number of commit 1 => string ISO 8601 date and time of commit 2 => name of committer ) </pre> <p> Returns <b>FALSE</b> on failure. </p> /","params":[{"name":"log","declared_type":"string","description":"<p>"},{"name":"targets","declared_type":"array","description":"<p>"},{"name":"recursive","declared_type":"bool","description":"[optional] <p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"svn_config_ensure","fqn":"svn_config_ensure","kind":"Function","origin":"PhpRuntime","extension":"svn","location":{"file":"svn/svn.php","range":{"start":9070,"end":9087}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"svn_copy","fqn":"svn_copy","kind":"Function","origin":"PhpRuntime","extension":"svn","location":{"file":"svn/svn.php","range":{"start":19391,"end":19399}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"svn_delete","fqn":"svn_delete","kind":"Function","origin":"PhpRuntime","extension":"svn","location":{"file":"svn/svn.php","range":{"start":20642,"end":20652}},"declared_type":null,"signature":{"parameters":[{"name":"path","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_r