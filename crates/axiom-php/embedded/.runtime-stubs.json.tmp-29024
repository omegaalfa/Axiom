ional":false,"variadic":false,"by_reference":false},{"name":"hostname","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"community","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"retries","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Creates SNMP instance representing session to remote SNMP agent <b>SNMP::VERSION_1</b>, <b>SNMP::VERSION_2C</b>, <b>SNMP::VERSION_3</b>.</p> optional <acronym title=\"Simple Network Management Protocol\">SNMP</acronym> agent port after colon. IPv6 addresses must be enclosed in square brackets if used with port. If FQDN is used for <i>hostname</i> it will be resolved by php-snmp library, not by Net-SNMP engine. Usage of IPv6 addresses when specifying FQDN may be forced by enclosing FQDN into square brackets. Here it is some examples: <table> <tbody> <tr><td>IPv4 with default port</td><td>127.0.0.1</td></tr> <tr><td>IPv6 with default port</td><td>::1 or [::1]</td></tr> <tr><td>IPv4 with specific port</td><td>127.0.0.1:1161</td></tr> <tr><td>IPv6 with specific port</td><td>[::1]:1161</td></tr> <tr><td>FQDN with default port</td><td>host.domain</td></tr> <tr><td>FQDN with specific port</td><td>host.domain:1161</td></tr> <tr><td>FQDN with default port, force usage of IPv6 address</td><td>[host.domain]</td></tr> <tr><td>FQDN with specific port, force usage of IPv6 address</td><td>[host.domain]:1161</td></tr> </tbody> </table> <acronym title=\"Simple Network Management Protocol\">SNMP</acronym> version specific:</p> <table> <tbody> <tr><td>SNMP::VERSION_1</td><td><acronym title=\"Simple Network Management Protocol\">SNMP</acronym> community</td></tr> <tr><td>SNMP::VERSION_2C</td><td><acronym title=\"Simple Network Management Protocol\">SNMP</acronym> community</td></tr> <tr><td>SNMP::VERSION_3</td><td><acronym title=\"Simple Network Management Protocol\">SNMP</acronym>v3 securityName</td></tr> </tbody> </table> /","params":[{"name":"version","declared_type":"int","description":"<p>SNMP protocol version:"},{"name":"hostname","declared_type":"string","description":"The SNMP agent. <i>hostname</i> may be suffixed with"},{"name":"community","declared_type":"string","description":"<p>The purpuse of <i>community</i> is"},{"name":"timeout","declared_type":"int","description":"[optional] The number of microseconds until the first timeout."},{"name":"retries","declared_type":"int","description":"[optional] The number of retries in case timeout occurs."}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"close","fqn":"SNMP::close","kind":"Method","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":7043,"end":7048}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Close SNMP session /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"get","fqn":"SNMP::get","kind":"Method","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":8575,"end":8578}},"declared_type":null,"signature":{"parameters":[{"name":"object_id","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"preserve_keys","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Fetch an SNMP object depending on <i>object_id</i> type or <b>FALSE</b> on error. /","params":[{"name":"object_id","declared_type":"mixed","description":"The SNMP object (OID) or objects"},{"name":"preserve_keys","declared_type":"bool","description":"[optional] When object_id is a array and preserve_keys set to <b>TRUE</b> keys in results will be taken exactly as in object_id, otherwise SNMP::oid_output_format property is used to determinate the form of keys."}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getErrno","fqn":"SNMP::getErrno","kind":"Method","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":13980,"end":13988}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Get last error code /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getError","fqn":"SNMP::getError","kind":"Method","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":14206,"end":14214}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Get last error message /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getnext","fqn":"SNMP::getnext","kind":"Method","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":9078,"end":9085}},"declared_type":null,"signature":{"parameters":[{"name":"object_id","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Fetch an SNMP object which follows the given object id The <acronym title=\"Simple Network Management Protocol\">SNMP</acronym> object (OID) or objects </p> depending on <i>object_id</i> type or <b>FALSE</b> on error. /","params":[{"name":"object_id","declared_type":"mixed","description":"<p>"}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set","fqn":"SNMP::set","kind":"Method","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":13726,"end":13729}},"declared_type":null,"signature":{"parameters":[{"name":"object_id","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"type","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Set the value of an SNMP object <p>When count of OIDs in object_id array is greater than max_oids object property set method will have to use multiple queries to perform requested value updates. In this case type and value checks are made per-chunk so second or subsequent requests may fail due to wrong type or value for OID requested. To mark this a warning is raised when count of OIDs in object_id array is greater than max_oids. When count of OIDs in object_id array is greater than max_oids object property set method will have to use multiple queries to perform requested value updates. In this case type and value checks are made per-chunk so second or subsequent requests may fail due to wrong type or value for OID requested. To mark this a warning is raised when count of OIDs in object_id array is greater than max_oids.</p> <b>types:</b> <table> <tbody> <tr><td>=</td><td>The type is taken from the MIB</td></tr> <tr><td>i</td><td>INTEGER</td> </tr> <tr><td>u</td><td>INTEGER</td></tr> <tr><td>s</td><td>STRING</td></tr> <tr><td>x</td><td>HEX STRING</td></tr> <tr><td>d</td><td>DECIMAL STRING</td></tr> <tr><td>n</td><td>NULLOBJ</td></tr> <tr><td>o</td><td>OBJID</td></tr> <tr><td>t</td><td>TIMETICKS</td></tr> <tr><td>a</td><td>IPADDRESS</td></tr> <tr><td>b</td><td>BITS</td></tr> </tbody> </table> <p> If <b>OPAQUE_SPECIAL_TYPES</b> was defined while compiling the SNMP library, the following are also valid: </p> <b>types:</b> <table> <tbody> <tr><td>U</td><td>unsigned int64</td></tr> <tr><td>I</td><td>signed int64</td></tr> <tr><td>F</td><td>float</td></tr> <tr><td>D</td><td>double</td></tr> </tbody> </table> <p> Most of these will use the obvious corresponding ASN.1 type.  's', 'x', 'd' and 'b' are all different ways of specifying an OCTET STRING value, and the 'u' unsigned type is also used for handling Gauge32 values. </p> <p> If the MIB-Files are loaded by into the MIB Tree with \"snmp_read_mib\" or by specifying it in the libsnmp config, '=' may be used as the <i>type</i> parameter for all object ids as the type can then be automatically read from the MIB. </p> <p> Note that there are two ways to set a variable of the type BITS like e.g. \"SYNTAX    BITS {telnet(0), ftp(1), http(2), icmp(3), snmp(4), ssh(5), https(6)}\": </p> <ul> <li> Using type \"b\" and a list of bit numbers. This method is not recommended since GET query for the same OID would return e.g. 0xF8. </li> <li> Using type \"x\" and a hex number but without(!) the usual \"0x\" prefix. </li> </ul> <p> See examples section for more details. </p> The new value.</p> /","params":[{"name":"object_id","declared_type":"string","description":"<p>The SNMP object id</p>"},{"name":"type","declared_type":"mixed","description":"<p>The MIB defines the type of each object id. It has to be specified as a single character from the below list.</p>"},{"name":"value","declared_type":"mixed","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setSecurity","fqn":"SNMP::setSecurity","kind":"Method","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":7841,"end":7852}},"declared_type":null,"signature":{"parameters":[{"name":"sec_level","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"auth_protocol","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"auth_passphrase","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"priv_protocol","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"priv_passphrase","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"contextName","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"contextEngineID","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Configures security-related SNMPv3 session parameters /","params":[{"name":"sec_level","declared_type":"string","description":"the security level (noAuthNoPriv|authNoPriv|authPriv)"},{"name":"auth_protocol","declared_type":"string","description":"[optional] the authentication protocol (MD5 or SHA)"},{"name":"auth_passphrase","declared_type":"string","description":"[optional] the authentication pass phrase"},{"name":"priv_protocol","declared_type":"string","description":"[optional] the privacy protocol (DES or AES)"},{"name":"priv_passphrase","declared_type":"string","description":"[optional] the privacy pass phrase"},{"name":"contextName","declared_type":"string","description":"[optional] the context name"},{"name":"contextEngineID","declared_type":"string","description":"[optional] the context EngineID"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"walk","fqn":"SNMP::walk","kind":"Method","origin":"PhpRuntime","extension":"snmp","location":{"file":"snmp/snmp.php","range":{"start":10236,"end":10240}},"declared_type":null,"signature":{"parameters":[{"name":"object_id","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"suffix_as_keys","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"max_repetitions","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"non_repeaters","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"Fetch SNMP object subtree When a SNMP error occures <b>SNMP::getErrno</b> and <b>SNMP::getError</b> can be used for retrieving error number (specific to SNMP extension, see class constants) and error message respectively. /","params":[{"name":"object_id","declared_type":"string","description":"<p>Root of subtree to be fetched</p>"},{"name":"suffix_as_keys","declared_type":"bool","description":"[optional] <p>By default full OID notation is used for keys in output array. If set to <b>TRUE</b> subtree prefix will be removed from keys leaving only suffix of object_id.</p>"},{"name":"max_repetitions","declared_type":"int","description":"[optional] <p>This specifies the maximum number of iterations over the repeating variables. The default is to use this value from SNMP object.</p>"},{"name":"non_repeaters","declared_type":"int","description":"[optional] <p>This specifies the number of supplied variables that should not be iterated over. The default is to use this value from SNMP object.</p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__call","fqn":"SoapClient::__call","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":10231,"end":10237}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Calls a SOAP function (deprecated) Calling this method directly is deprecated. Usually, SOAP functions can be called as methods of the SoapClient object; in situations where this is not possible or additional options are needed, use SoapClient::__soapCall. /","params":[{"name":"name","declared_type":"string","description":null},{"name":"args","declared_type":"array","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"SoapClient::__construct","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":9575,"end":9586}},"declared_type":null,"signature":{"parameters":[{"name":"wsdl","declared_type":null,"phpdoc_type":"string|null","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"SoapClient constructor URI of the WSDL file or <b>NULL</b> if working in non-WSDL mode. </p> <p> During development, WSDL caching may be disabled by the use of the soap.wsdl_cache_ttl <i>php.ini</i> setting otherwise changes made to the WSDL file will have no effect until soap.wsdl_cache_ttl is expired. </p> An array of options. If working in WSDL mode, this parameter is optional. If working in non-WSDL mode, the location and uri options must be set, where location is the URL of the SOAP server to send the request to, and uri is the target namespace of the SOAP service. </p> <p> The style and use options only work in non-WSDL mode. In WSDL mode, they come from the WSDL file. </p> <p> The soap_version option should be one of either <b>SOAP_1_1</b> or <b>SOAP_1_2</b> to select SOAP 1.1 or 1.2, respectively. If omitted, 1.1 is used. </p> <p> For HTTP authentication, the login and password options can be used to supply credentials. For making an HTTP connection through a proxy server, the options proxy_host, proxy_port, proxy_login and proxy_password are also available. For HTTPS client certificate authentication use local_cert and passphrase options. An authentication may be supplied in the authentication option. The authentication method may be either <b>SOAP_AUTHENTICATION_BASIC</b> (default) or <b>SOAP_AUTHENTICATION_DIGEST</b>. </p> <p> The compression option allows to use compression of HTTP SOAP requests and responses. </p> <p> The encoding option defines internal character encoding. This option does not change the encoding of SOAP requests (it is always utf-8), but converts strings into it. </p> <p> The trace option enables tracing of request so faults can be backtraced. This defaults to <b>FALSE</b> </p> <p> The classmap option can be used to map some WSDL types to PHP classes. This option must be an array with WSDL types as keys and names of PHP classes as values. </p> <p> Setting the boolean trace option enables use of the methods SoapClient->__getLastRequest, SoapClient->__getLastRequestHeaders, SoapClient->__getLastResponse and SoapClient->__getLastResponseHeaders. </p> <p> The exceptions option is a boolean value defining whether soap errors throw exceptions of type SoapFault. </p> <p> The connection_timeout option defines a timeout in seconds for the connection to the SOAP service. This option does not define a timeout for services with slow responses. To limit the time to wait for calls to finish the default_socket_timeout setting is available. </p> <p> The typemap option is an array of type mappings. Type mapping is an array with keys type_name, type_ns (namespace URI), from_xml (callback accepting one string parameter) and to_xml (callback accepting one object parameter). </p> <p> The cache_wsdl option is one of <b>WSDL_CACHE_NONE</b>, <b>WSDL_CACHE_DISK</b>, <b>WSDL_CACHE_MEMORY</b> or <b>WSDL_CACHE_BOTH</b>. </p> <p> The user_agent option specifies string to use in User-Agent header. </p> <p> The stream_context option is a resource for context. </p> <p> The features option is a bitmask of <b>SOAP_SINGLE_ELEMENT_ARRAYS</b>, <b>SOAP_USE_XSI_ARRAY_TYPE</b>, <b>SOAP_WAIT_ONE_WAY_CALLS</b>. </p> <p> The keep_alive option is a boolean value defining whether to send the Connection: Keep-Alive header or Connection: close. </p> <p> The ssl_method option is one of <b>SOAP_SSL_METHOD_TLS</b>, <b>SOAP_SSL_METHOD_SSLv2</b>, <b>SOAP_SSL_METHOD_SSLv3</b> or <b>SOAP_SSL_METHOD_SSLv23</b>. </p> /","params":[{"name":"wsdl","declared_type":"string|null","description":"<p>"},{"name":"options","declared_type":"array","description":"[optional] <p>"}],"return_type":null,"var_type":null,"throws":["SoapFault"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__doRequest","fqn":"SoapClient::__doRequest","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":15609,"end":15620}},"declared_type":null,"signature":{"parameters":[{"name":"request","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"location","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"action","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"version","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"oneWay","declared_type":null,"phpdoc_type":"bool|int","optional":true,"variadic":false,"by_reference":false},{"name":"uriParserClass","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"?string","phpdoc_return_type":"string|null"},"documentation":{"description":"Performs a SOAP request The XML SOAP request. </p> The URL to request. </p> The SOAP action. </p> The SOAP version. </p> If $oneWay is set to 1, this method returns nothing. Use this where a response is not expected. </p> a \"Location\" header is received in the response, or null to use the default, parse_url based parsing. /","params":[{"name":"request","declared_type":"string","description":"<p>"},{"name":"location","declared_type":"string","description":"<p>"},{"name":"action","declared_type":"string","description":"<p>"},{"name":"version","declared_type":"int","description":"<p>"},{"name":"oneWay","declared_type":"bool|int","description":"[optional] <p>"},{"name":"uriParserClass","declared_type":"string|null","description":"The classname to use for parsing the redirection URI when"}],"return_type":"string|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__getCookies","fqn":"SoapClient::__getCookies","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":14693,"end":14705}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Returns a list of all cookies /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__getFunctions","fqn":"SoapClient::__getFunctions","kind":"