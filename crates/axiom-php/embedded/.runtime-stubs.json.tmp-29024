'field' operation in order to make a selection on the documents to extract. /","params":[{"name":"sort_expr","declared_type":"string","description":null}],"return_type":"\\mysql_xdevapi\\CollectionFind","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"limit","fqn":"CollectionFind::limit","kind":"Method","origin":"PhpRuntime","extension":"mysql_xdevapi","location":{"file":"mysql_xdevapi/mysql_xdevapi.php","range":{"start":9784,"end":9789}},"declared_type":null,"signature":{"parameters":[{"name":"rows","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"CollectionFind","phpdoc_return_type":"\\mysql_xdevapi\\CollectionFind"},"documentation":{"description":"Set the maximum number of documents to return. /","params":[{"name":"rows","declared_type":"int","description":null}],"return_type":"\\mysql_xdevapi\\CollectionFind","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lockExclusive","fqn":"CollectionFind::lockExclusive","kind":"Method","origin":"PhpRuntime","extension":"mysql_xdevapi","location":{"file":"mysql_xdevapi/mysql_xdevapi.php","range":{"start":10657,"end":10670}},"declared_type":null,"signature":{"parameters":[{"name":"lock_waiting_option","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"CollectionFind","phpdoc_return_type":"\\mysql_xdevapi\\CollectionFind"},"documentation":{"description":"Execute operation with EXCLUSIVE LOCK Lock exclusively the document, other transactions are blocked from updating the document until the document is locked While the document is locked, other transactions are blocked from updating those docs, from doing SELECT ... LOCK IN SHARE MODE, or from reading the data in certain transaction isolation levels. Consistent reads ignore any locks set on the records that exist in the read view. This feature is directly useful with the modify() command, to avoid concurrency problems. Basically, it serializes access to a row through row locking /","params":[{"name":"lock_waiting_option","declared_type":"int","description":null}],"return_type":"\\mysql_xdevapi\\CollectionFind","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lockShared","fqn":"CollectionFind::lockShared","kind":"Method","origin":"PhpRuntime","extension":"mysql_xdevapi","location":{"file":"mysql_xdevapi/mysql_xdevapi.php","range":{"start":11361,"end":11371}},"declared_type":null,"signature":{"parameters":[{"name":"lock_waiting_option","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"CollectionFind","phpdoc_return_type":"\\mysql_xdevapi\\CollectionFind"},"documentation":{"description":"Execute operation with SHARED LOCK Allows to share the documents between multiple transactions which are locking in shared mode. Other sessions can read the rows, but cannot modify them until your transaction commits. If any of these rows were changed by another transaction that has not yet committed, your query waits until that transaction ends and then uses the latest values. /","params":[{"name":"lock_waiting_option","declared_type":"int","description":null}],"return_type":"\\mysql_xdevapi\\CollectionFind","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"offset","fqn":"CollectionFind::offset","kind":"Method","origin":"PhpRuntime","extension":"mysql_xdevapi","location":{"file":"mysql_xdevapi/mysql_xdevapi.php","range":{"start":11897,"end":11903}},"declared_type":null,"signature":{"parameters":[{"name":"position","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"CollectionFind","phpdoc_return_type":"