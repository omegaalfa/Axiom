name","declared_type":"string","description":"<p>"},{"name":"no_text","declared_type":"bool","description":"[optional]"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"openssl_csr_get_public_key","fqn":"openssl_csr_get_public_key","kind":"Function","origin":"PhpRuntime","extension":"openssl","location":{"file":"openssl/openssl.php","range":{"start":28445,"end":28471}},"declared_type":null,"signature":{"parameters":[{"name":"csr","declared_type":null,"phpdoc_type":"OpenSSLCertificateSigningRequest|string|resource","optional":false,"variadic":false,"by_reference":false},{"name":"short_names","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"OpenSSLAsymmetricKey|resource|false"},"documentation":{"description":"Returns the public key of a CERT /","params":[{"name":"csr","declared_type":"OpenSSLCertificateSigningRequest|string|resource","description":null},{"name":"short_names","declared_type":"bool","description":"[optional]"}],"return_type":"OpenSSLAsymmetricKey|resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"openssl_csr_get_subject","fqn":"openssl_csr_get_subject","kind":"Function","origin":"PhpRuntime","extension":"openssl","location":{"file":"openssl/openssl.php","range":{"start":27836,"end":27859}},"declared_type":null,"signature":{"parameters":[{"name":"csr","declared_type":null,"phpdoc_type":"OpenSSLCertificateSigningRequest|string|resource","optional":false,"variadic":false,"by_reference":false},{"name":"short_names","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Returns the subject of a CERT /","params":[{"name":"csr","declared_type":"OpenSSLCertificateSigningRequest|string|resource","description":null},{"name":"short_names","declared_type":"bool","description":"[optional]"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"openssl_csr_new","fqn":"openssl_csr_new","kind":"Function","origin":"PhpRuntime","extension":"openssl","location":{"file":"openssl/openssl.php","range":{"start":24028,"end":24043}},"declared_type":null,"signature":{"parameters":[{"name":"distinguished_names","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"private_key","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"extra_attributes","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"OpenSSLCertificateSigningRequest|resource|false"},"documentation":{"description":"Generates a CSR The Distinguished Name to be used in the certificate. </p> <i>privkey</i> should be set to a private key that was previously generated by <b>openssl_pkey_new</b> (or otherwise obtained from the other openssl_pkey family of functions). The corresponding public portion of the key will be used to sign the CSR. </p> By default, the information in your system openssl.conf is used to initialize the request; you can specify a configuration file section by setting the config_section_section key of <i>configargs</i>. You can also specify an alternative openssl configuration file by setting the value of the config key to the path of the file you want to use. The following keys, if present in <i>configargs</i> behave as their equivalents in the openssl.conf, as listed in the table below. <table> Configuration overrides <tr valign=\"top\"> <td><i>configargs</i> key</td> <td>type</td> <td>openssl.conf equivalent</td> <td>description</td> </tr> <tr valign=\"top\"> <td>digest_alg</td> <td>string</td> <td>default_md</td> <td>Selects which digest method to use</td> </tr> <tr valign=\"top\"> <td>x509_extensions</td> <td>string</td> <td>x509_extensions</td> <td>Selects which extensions should be used when creating an x509 certificate</td> </tr> <tr valign=\"top\"> <td>req_extensions</td> <td>string</td> <td>req_extensions</td> <td>Selects which extensions should be used when creating a CSR</td> </tr> <tr valign=\"top\"> <td>private_key_bits</td> <td>integer</td> <td>default_bits</td> <td>Specifies how many bits should be used to generate a private key</td> </tr> <tr valign=\"top\"> <td>private_key_type</td> <td>integer</td> <td>none</td> <td>Specifies the type of private key to create. This can be one of <b>OPENSSL_KEYTYPE_DSA</b>, <b>OPENSSL_KEYTYPE_DH</b> or <b>OPENSSL_KEYTYPE_RSA</b>. The default value is <b>OPENSSL_KEYTYPE_RSA</b> which is currently the only supported key type. </td> </tr> <tr valign=\"top\"> <td>encrypt_key</td> <td>boolean</td> <td>encrypt_key</td> <td>Should an exported key (with passphrase) be encrypted?</td> </tr> <tr valign=\"top\"> <td>encrypt_key_cipher</td> <td>integer</td> <td>none</td> <td> One of cipher constants. </td> </tr> </table> </p> <i>extraattribs</i> is used to specify additional configuration options for the CSR. Both <i>dn</i> and <i>extraattribs</i> are associative arrays whose keys are converted to OIDs and applied to the relevant part of the request. </p> /","params":[{"name":"distinguished_names","declared_type":"array","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"options","declared_type":"array|null","description":"[optional] <p>"},{"name":"extra_attributes","declared_type":"array|null","description":"[optional] <p>"}],"return_type":"OpenSSLCertificateSigningRequest|resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"openssl_csr_sign","fqn":"openssl_csr_sign","kind":"Function","origin":"PhpRuntime","extension":"openssl","location":{"file":"openssl/openssl.php","range":{"start":27035,"end":27051}},"declared_type":null,"signature":{"parameters":[{"name":"csr","declared_type":null,"phpdoc_type":"OpenSSLCertificateSigningRequest|string|resource","optional":false,"variadic":false,"by_reference":false},{"name":"ca_certificate","declared_type":null,"phpdoc_type":"OpenSSLCertificate|resource|string|null","optional":false,"variadic":false,"by_reference":false},{"name":"private_key","declared_type":null,"phpdoc_type":"OpenSSLAsymmetricKey|OpenSSLCertificate|array|string","optional":false,"variadic":false,"by_reference":false},{"name":"days","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false},{"name":"serial","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"serial_hex","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"OpenSSLCertificate|resource|false"},"documentation":{"description":"Sign a CSR with another certificate (or itself) and generate a certificate A CSR previously generated by <b>openssl_csr_new</b>. It can also be the path to a PEM encoded CSR when specified as file://path/to/csr or an exported string generated by <b>openssl_csr_export</b>. </p> The generated certificate will be signed by <i>cacert</i>. If <i>cacert</i> is null, the generated certificate will be a self-signed certificate. </p> <i>priv_key</i> is the private key that corresponds to <i>cacert</i>. </p> <i>days</i> specifies the length of time for which the generated certificate will be valid, in days. </p> You can finetune the CSR signing by <i>configargs</i>. See <b>openssl_csr_new</b> for more information about <i>configargs</i>. </p> An optional the serial number of issued certificate. If not specified it will default to 0. </p> the issued certificate. If set, it takes precedence over the serial parameter value. If not specified or set to null, the serial parameter value is used instead. /","params":[{"name":"csr","declared_type":"OpenSSLCertificateSigningRequest|string|resource","description":"<p>"},{"name":"ca_certificate","declared_type":"OpenSSLCertificate|resource|string|null","description":"<p>"},{"name":"private_key","declared_type":"OpenSSLAsymmetricKey|OpenSSLCertificate|array|string","description":"<p>"},{"name":"days","declared_type":"int","description":"<p>"},{"name":"options","declared_type":"array|null","description":"[optional] <p>"},{"name":"serial","declared_type":"int","description":"[optional] <p>"},{"name":"serial_hex","declared_type":"string|null","description":"An optional hexadecimal string representing the serial number of"}],"return_type":"OpenSSLCertificate|resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"openssl_decrypt","fqn":"openssl_decrypt","kind":"Function","origin":"PhpRuntime","extension":"openssl","location":{"file":"openssl/openssl.php","range":{"start":31430,"end":31445}},"declared_type":null,"signature":{"parameters":[{"name":"data","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"cipher_algo","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"passphrase","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"iv","declared_type":"st