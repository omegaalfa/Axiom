,"return_type":"ZMQSocket","var_type":null,"throws":["ZMQSocketException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"isPersistent","fqn":"ZMQContext::isPersistent","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":11091,"end":11103}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL zmq &gt;= 0.5.0) Whether the context is persistent. Persistent context is needed for persistent connections as each socket is allocated from a context. /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setOpt","fqn":"ZMQContext::setOpt","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":11553,"end":11559}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ZMQContext"},"documentation":{"description":"(PECL zmq &gt;= 1.0.4) Sets a ZMQ context option. The type of the value depends on the key. See ZMQ Constant Types for more information. /","params":[{"name":"key","declared_type":"int","description":"One of the <b>ZMQ::CTXOPT_*<b> constants."},{"name":"value","declared_type":"mixed","description":"The value of the parameter."}],"return_type":"ZMQContext","var_type":null,"throws":["ZMQContextException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"ZMQDevice::__construct","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":25144,"end":25155}},"declared_type":null,"signature":{"parameters":[{"name":"frontend","declared_type":"ZMQSocket","phpdoc_type":"ZMQSocket","optional":false,"variadic":false,"by_reference":false},{"name":"backend","declared_type":"ZMQSocket","phpdoc_type":"ZMQSocket","optional":false,"variadic":false,"by_reference":false},{"name":"listener","declared_type":"ZMQSocket","phpdoc_type":"null|ZMQSocket","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"(PECL zmq &gt;= 1.0.4) Construct a new device. \"ØMQ devices can do intermediation of addresses, services, queues, or any other abstraction you care to define above the message and socket layers.\" -- zguide Call to this method will prepare the device. Usually devices are very long running processes so running this method from interactive script is not recommended. This method throw ZMQDeviceException if the device cannot be started. /","params":[{"name":"frontend","declared_type":"ZMQSocket","description":"Frontend parameter for the devices. Usually where there messages are coming."},{"name":"backend","declared_type":"ZMQSocket","description":"Backend parameter for the devices. Usually where there messages going to."},{"name":"listener","declared_type":"null|ZMQSocket","description":"Listener socket, which receives a copy of all messages going both directions. The type of this socket should be SUB, PULL or DEALER."}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getIdleTimeout","fqn":"ZMQDevice::getIdleTimeout","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":25562,"end":25576}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Gets the idle callback timeout value. This method returns the idle callback timeout value. Added in ZMQ extension version 1.1.0. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getTimerTimeout","fqn":"ZMQDevice::getTimerTimeout","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":25850,"end":25865}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Gets the timer callback timeout value. Added in ZMQ extension version 1.1.0. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"run","fqn":"ZMQDevice::run","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":26174,"end":26177}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Runs the device. Call to this method will block until the device is running. It is not recommended that devices are used from interactive scripts. /","params":[],"return_type":null,"var_type":null,"throws":["ZMQDeviceException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setIdleCallback","fqn":"ZMQDevice::setIdleCallback","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":27274,"end":27289}},"declared_type":null,"signature":{"parameters":[{"name":"cb_func","declared_type":null,"phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"user_data","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ZMQDevice"},"documentation":{"description":"Sets the idle callback function. If idle timeout is defined the idle callback function shall be called if the internal poll loop times out without events. If the callback function returns false or a value that evaluates to false the device is stopped. The callback function signature is callback (mixed $user_data). /","params":[{"name":"cb_func","declared_type":"callable","description":"Callback function to invoke when the device is idle. Returning false or a value that evaluates to false from this function will cause the device to stop."},{"name":"timeout","declared_type":"int","description":"How often to invoke the idle callback in milliseconds. The idle callback is invoked periodically when there is no activity on the device. The timeout value guarantees that there is at least this amount of milliseconds between invocations of the callback function."},{"name":"user_data","declared_type":"mixed","description":"Additional data to pass to the callback function."}],"return_type":"ZMQDevice","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setIdleTimeout","fqn":"ZMQDevice::setIdleTimeout","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":27758,"end":27772}},"declared_type":null,"signature":{"parameters":[{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ZMQDevice"},"documentation":{"description":"Sets the idle callback timeout value. The idle callback is invoked periodically when the device is idle. On success this method returns the current object. /","params":[{"name":"timeout","declared_type":"int","description":"The idle callback timeout value in milliseconds"}],"return_type":"ZMQDevice","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setTimerCallback","fqn":"ZMQDevice::setTimerCallback","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":28820,"end":28836}},"declared_type":null,"signature":{"parameters":[{"name":"cb_func","declared_type":null,"phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"user_data","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ZMQDevice"},"documentation":{"description":"Sets the timer callback function. The timer callback will be invoked after timeout has passed. The difference between idle and timer callbacks are that idle callback is invoked only when the device is idle. The callback function signature is callback (mixed $user_data). Added in ZMQ extension version 1.1.0. /","params":[{"name":"cb_func","declared_type":"callable","description":"Callback function to invoke when the device is idle. Returning false or a value that evaluates to false from this function will cause the device to stop."},{"name":"timeout","declared_type":"int","description":"How often to invoke the idle callback in milliseconds. The idle callback is invoked periodically when there is no activity on the device. The timeout value guarantees that there is at least this amount of milliseconds between invocations of the callback function."},{"name":"user_data","declared_type":"mixed","description":"Additional data to pass to the callback function."}],"return_type":"ZMQDevice","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setTimerTimeout","fqn":"ZMQDevice::setTimerTimeout","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":29218,"end":29233}},"declared_type":null,"signature":{"parameters":[{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ZMQDevice"},"documentation":{"description":"Sets the timer callback timeout value. The timer callback is invoked periodically if it's set. Added in ZMQ extension version 1.1.0. /","params":[{"name":"timeout","declared_type":"int","description":"The timer callback timeout value."}],"return_type":"ZMQDevice","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"add","fqn":"ZMQPoll::add","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":21413,"end":21416}},"declared_type":null,"signature":{"parameters":[{"name":"entry","declared_type":"ZMQSocket","phpdoc_type":"ZMQSocket","optional":false,"variadic":false,"by_reference":false},{"name":"type","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"(PECL zmq &gt;= 0.5.0) Adds a new item to the poll set and returns the internal id of the added item. The item can be removed from the poll set using the returned string id. Returns a string id of the added item which can be later used to remove the item. /","params":[{"name":"entry","declared_type":"ZMQSocket","description":"ZMQSocket object or a PHP stream resource"},{"name":"type","declared_type":"int","description":"Defines what activity the socket is polled for. See <b>ZMQ::POLL_IN</b> and <b>ZMQ::POLL_OUT</b> constants."}],"return_type":"int","var_type":null,"throws":["ZMQPollException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"clear","fqn":"ZMQPoll::clear","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":21673,"end":21678}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"ZMQPoll"},"documentation":{"description":"(PECL zmq &gt;= 1.0.4) Clears all elements from the poll set. /","params":[],"return_type":"ZMQPoll","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"count","fqn":"ZMQPoll::count","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":21943,"end":21948}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"(PECL zmq &gt;= 0.5.0) Count the items in the poll set. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getLastErrors","fqn":"ZMQPoll::getLastErrors","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":22329,"end":22342}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int[]"},"documentation":{"description":"(PECL zmq &gt;= 0.5.0) Returns the ids of the objects that had errors in the last poll. Returns an array containing ids for the items that had errors in the last poll. Empty array is returned if there were no errors. /","params":[],"return_type":"int[]","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"poll","fqn":"ZMQPoll::poll","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":23361,"end":23365}},"declared_type":null,"signature":{"parameters":[{"name":"readable","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"writable","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"timeout","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"(PECL zmq &gt;= 0.5.0) Polls the items in the current poll set. The readable and writable items are returned in the readable and writable parameters. ZMQPoll::getLastErrors() can be used to check if there were errors. Returns an int representing amount of items with activity. /","params":[{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null},{"name":"timeout","declared_type":"int","description":"Timeout for the operation. -1 means that poll waits until at least one item has activity. Please note that starting from version 1.0.0 the poll timeout is defined in milliseconds, rather than microseconds."}],"return_type":"int","var_type":null,"throws":["ZMQPollException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"remove","fqn":"ZMQPoll::remove","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":24049,"end":24055}},"declared_type":null,"signature":{"parameters":[{"name":"item","declared_type":null,"phpdoc_type":"ZMQSocket|string|mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL zmq &gt;= 0.5.0) Remove item from the poll set. The item parameter can be ZMQSocket object, a stream resource or the id returned from ZMQPoll::add() method. Returns true if the item was removed and false if the object with given id does not exist in the poll set. /","params":[{"name":"item","declared_type":"ZMQSocket|string|mixed","description":"The ZMQSocket object, PHP stream or string id of the item."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"ZMQSocket::__construct","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":12873,"end":12884}},"declared_type":null,"signature":{"parameters":[{"name":"context","declared_type":"ZMQContext","phpdoc_type":"ZMQContext","optional":false,"variadic":false,"by_reference":false},{"name":"type","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"persistent_id","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"on_new_socket","declared_type":null,"phpdoc_type":"callable","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"(PECL zmq &gt;= 0.5.0) Constructs a ZMQSocket object. The persistent_id parameter can be used to allocated a persistent socket. A persistent socket has to be allocated from a persistent context and it stays connected over multiple requests. The persistent_id parameter can be used to recall the same socket over multiple requests. The on_new_socket is called only when a new underlying socket structure is created. /","params":[{"name":"context","declared_type":"ZMQContext","description":"<p>ZMQContext to build this object</p>"},{"name":"type","declared_type":"int","description":"<p>The type of the socket. See ZMQ::SOCKET_* constants.</p>"},{"name":"persistent_id","declared_type":"string","description":"[optional] <p>If persistent_id is specified the socket will be persisted over multiple requests. If context is not persistent the socket falls back to non-persistent mode.</p>"},{"name":"on_new_socket","declared_type":"callable","description":"[optional] <p>Callback function, which is executed when a new socket structure is created. This function does not get invoked if the underlying persistent connection is re-used.</p>"}],"return_type":null,"var_type":null,"throws":["ZMQSocketException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bind","fqn":"ZMQSocket::bind","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":13527,"end":13531}},"declared_type":null,"signature":{"parameters":[{"name":"dsn","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"force","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ZMQSocket"},"documentation":{"description":"(PECL zmq &gt;= 0.5.0) Bind the socket to an endpoint. The endpoint is defined in format transport://address where transport is one of the following: inproc, ipc, tcp, pgm or epgm. /","params":[{"name":"dsn","declared_type":"string","description":"The bind dsn, for example transport://address."},{"name":"force","declared_type":"bool","description":"Tries to bind even if the socket has already been bound to the given endpoint."}],"return_type":"ZMQSocket","var_type":null,"throws":["ZMQSocketException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"connect","fqn":"ZMQSocket::connect","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":14137,"end":14144}},"declared_type":null,"signature":{"parameters":[{"name":"dsn","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"force","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ZMQSocket"},"documentation":{"description":"(PECL zmq &gt;= 0.5.0) Connect the socket to a remote endpoint. The endpoint is defined in format transport://address where transport is one of the following: inproc, ipc, tcp, pgm or epgm. /","params":[{"name":"dsn","declared_type":"string","description":"The bind dsn, for example transport://address."},{"name":"force","declared_type":"bool","description":"Tries to bind even if the socket has already been bound to the given endpoint."}],"return_type":"ZMQSocket","var_type":null,"throws":["ZMQSocketException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"disconnect","fqn":"ZMQSocket::disconnect","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":14674,"end":14684}},"declared_type":null,"signature":{"parameters":[{"name":"dsn","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ZMQSocket"},"documentation":{"description":"(PECL zmq &gt;= 1.0.4) Disconnect the socket from a previously connected remote endpoint. The endpoint is defined in format transport://address where transport is one of the following: inproc, ipc, tcp, pgm or epgm. /","params":[{"name":"dsn","declared_type":"string","description":"The bind dsn, for example transport://address."}],"return_type":"ZMQSocket","var_type":null,"throws":["ZMQSocketException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getEndpoints","fqn":"ZMQSocket::getEndpoints","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":14983,"end":14995}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Returns a list of endpoints where the socket is connected or bound to. /","params":[],"return_type":"array","var_type":null,"throws":["ZMQSocketException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getPersistentId","fqn":"ZMQSocket::getPersistentId","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":15366,"end":15381}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string|null"},"documentation":{"description":"Returns the persistent id string assigned of the object and NULL if socket is not persistent. Returns the persistent id string assigned of the object and <b>NULL</b> if socket is not persistent. </p> /","params":[],"return_type":"string|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getSocketType","fqn":"ZMQSocket::getSocketType","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":16352,"end":16365}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Return the socket type. The socket type can be compared against ZMQ::SOCKET_* constants. Returns an integer representing the socket type. The integer can be compared against <b>ZMQ::SOCKET_*</b> constants. </p> /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getSockOpt","fqn":"ZMQSocket::getSockOpt","kind":"Method","origin":"PhpRuntime","extension":"zmq","location":{"file":"zmq/zmq.php","range":{"start":15952,"end":15962}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|int"},"documentation":{"description":"Returns the value of a socket option. This method is available if ZMQ extension has been compiled against ZMQ version 2.0.7 or higher Returns either a string or an integer depending on <b>key</b>. Throws ZMQSocketException on error. </p> /","params":[{"name":"key","declared_type":"int","description":"An int representing the option. See the <b>ZMQ::SOCKOPT_*</b> constants."}],"return_type":"string|int","var_type":null,"throws":["Z