nnection to an InterBase database The database argument has to be a valid path to database file on the server it resides on. If the server is not local, it must be prefixed with either 'hostname:' (TCP/IP), '//hostname/' (NetBEUI) or 'hostname@' (IPX/SPX), depending on the connection protocol used. </p> The user name. Can be set with the fbird.default_user &php.ini; directive. </p> The password for username. Can be set with the fbird.default_password &php.ini; directive. </p> charset is the default character set for a database. </p> buffers is the number of database buffers to allocate for the server-side cache. If 0 or omitted, server chooses its own default. </p> dialect selects the default SQL dialect for any statement executed within a connection, and it defaults to the highest one supported by client libraries. Functional only with InterBase 6 and up. </p> Functional only with InterBase 5 and up. </p> </p> /","params":[{"name":"database","declared_type":"string","description":"[optional] <p>"},{"name":"username","declared_type":"string","description":"[optional] <p>"},{"name":"password","declared_type":"string","description":"[optional] <p>"},{"name":"charset","declared_type":"string","description":"[optional] <p>"},{"name":"buffers","declared_type":"int","description":"[optional] <p>"},{"name":"dialect","declared_type":"int","description":"[optional] <p>"},{"name":"role","declared_type":"string","description":"[optional] <p>"},{"name":"sync","declared_type":"int","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_prepare","fqn":"fbird_prepare","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":33394,"end":33407}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"This is an alias of ibase_prepare Prepare a query for later binding of parameter placeholders and execution An InterBase query. </p> /","params":[{"name":"query","declared_type":"string","description":"<p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_query","fqn":"fbird_query","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":29732,"end":29743}},"declared_type":null,"signature":{"parameters":[{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"bind_args","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|bool"},"documentation":{"description":"This is an alias of ibase_query Execute a query on an InterBase database An InterBase link identifier. If omitted, the last opened link is assumed. </p> An InterBase query. </p> </p> there is a (possibly empty) result set (such as with a SELECT query), returns a result identifier. If the query was successful and there were no results, returns true. </p> <p> In PHP 5.0.0 and up, this function will return the number of rows affected by the query for INSERT, UPDATE and DELETE statements. In order to retain backward compatibility, it will return true for these statements if the query succeeded without affecting any rows. /","params":[{"name":"link_identifier","declared_type":"resource","description":"[optional] <p>"},{"name":"query","declared_type":"string","description":"<p>"},{"name":"bind_args","declared_type":"int","descri