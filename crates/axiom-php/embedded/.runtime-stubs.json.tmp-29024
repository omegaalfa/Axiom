null},"is_static":false},{"name":"_priority","fqn":"ZendAPI_Job::_priority","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":8720,"end":8730}},"declared_type":null,"signature":null,"documentation":{"description":"The priority of the job, options are the priority constants By default the priority is set to normal (JOB_QUEUE_PRIORITY_NORMAL) /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_scheduled_time","fqn":"ZendAPI_Job::_scheduled_time","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":10768,"end":10784}},"declared_type":null,"signature":null,"documentation":{"description":"The time that this job should be performed, this variables is the UNIX timestamp. If set to 0, it means that the job should be performed now (or at least as soon as possible) By default there is no scheduled time, which means we want to perform the job as soon as possible /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_script","fqn":"ZendAPI_Job::_script","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":7614,"end":7622}},"declared_type":null,"signature":null,"documentation":{"description":"Full path of the script that this job calls when it's processed /","params":[],"return_type":null,"var_type":"string","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_status","fqn":"ZendAPI_Job::_status","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":8158,"end":8166}},"declared_type":null,"signature":null,"documentation":{"description":"The status of the job By default, the job status is waiting to being