l","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__getLastResponseHeaders","fqn":"SoapClient::__getLastResponseHeaders","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":13780,"end":13804}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"?string","phpdoc_return_type":"string|null"},"documentation":{"description":"Returns the SOAP headers from the last response /","params":[],"return_type":"string|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__getTypes","fqn":"SoapClient::__getTypes","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":14445,"end":14455}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"?array","phpdoc_return_type":"array|null"},"documentation":{"description":"Returns a list of SOAP types /","params":[],"return_type":"array|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__setCookie","fqn":"SoapClient::__setCookie","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":16540,"end":16551}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"The __setCookie purpose The name of the cookie. </p> The value of the cookie. If not specified, the cookie will be deleted. </p> /","params":[{"name":"name","declared_type":"string","description":"<p>"},{"name":"value","declared_type":"string","description":"[optional] <p>"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__setLocation","fqn":"SoapClient::__setLocation","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":17065,"end":17078}},"declared_type":null,"signature":{"parameters":[{"name":"location","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"?string","phpdoc_return_type":"string|null"},"documentation":{"description":"Sets the location of the Web service to use The new endpoint URL. </p> /","params":[{"name":"location","declared_type":"string","description":"[optional] <p>"}],"return_type":"string|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__setSoapHeaders","fqn":"SoapClient::__setSoapHeaders","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":17670,"end":17686}},"declared_type":null,"signature":{"parameters":[{"name":"headers","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false},{"name":"headers","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Sets SOAP headers for subsequent calls The headers to be set. It could be <b>SoapHeader</b> object or array of <b>SoapHeader</b> objects. If not specified or set to <b>NULL</b>, the headers will be deleted. </p> /","params":[{"name":"headers","declared_type":"mixed","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__soapCall","fqn":"SoapClient::__soapCall","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":12379,"end":12389}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":null,"phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"inputHeaders","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false},{"name":"outputHeaders","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Calls a SOAP function The name of the SOAP function to call. </p> An array of the arguments to pass to the function. This can be either an ordered or an associative array. Note that most SOAP servers require parameter names to be provided, in which case this must be an associative array. </p> An associative array of options to pass to the client. </p> <p> The location option is the URL of the remote Web service. </p> <p> The uri option is the target namespace of the SOAP service. </p> <p> The soapaction option is the action to call. </p> An array of headers to be sent along with the SOAP request. </p> If supplied, this array will be filled with the headers from the SOAP response. </p> by the SOAP function, the return value of __soapCall will be a simple value (e.g. an integer, a string, etc). If multiple values are returned, __soapCall will return an associative array of named output parameters. </p> <p> On error, if the SoapClient object was constructed with the exceptions option set to <b>FALSE</b>, a SoapFault object will be returned. If this option is not set, or is set to <b>TRUE</b>, then a SoapFault object will be thrown as an exception. and the SoapClient was constructed with the exceptions option not set, or set to <b>TRUE</b>. /","params":[{"name":"name","declared_type":"string","description":"<p>"},{"name":"args","declared_type":"array","description":"<p>"},{"name":"options","declared_type":"array","description":"[optional] <p>"},{"name":"inputHeaders","declared_type":"mixed","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null}],"return_type":"mixed","var_type":null,"throws":["SoapFault"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"SoapClient","fqn":"SoapClient::SoapClient","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":4960,"end":4970}},"declared_type":null,"signature":{"parameters":[{"name":"wsdl","declared_type":null,"phpdoc_type":"string|null","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"SoapClient constructor URI of the WSDL file or <b>NULL</b> if working in non-WSDL mode. </p> <p> During development, WSDL caching may be disabled by the use of the soap.wsdl_cache_ttl <i>php.ini</i> setting otherwise changes made to the WSDL file will have no effect until soap.wsdl_cache_ttl is expired. </p> An array of options. If working in WSDL mode, this parameter is optional. If working in non-WSDL mode, the location and uri options must be set, where location is the URL of the SOAP server to send the request to, and uri is the target namespace of the SOAP service. </p> <p> The style and use options only work in non-WSDL mode. In WSDL mode, they come from the WSDL file. </p> <p> The soap_version option should be one of either <b>SOAP_1_1</b> or <b>SOAP_1_2</b> to select SOAP 1.1 or 1.2, respectively. If omitted, 1.1 is used. </p> <p> For HTTP authentication, the login and password options can be used to supply credentials. For making an HTTP connection through a proxy server, the options proxy_host, proxy_port, proxy_login and proxy_password are also available. For HTTPS client certificate authentication use local_cert and passphrase options. An authentication may be supplied in the authentication option. The authentication method may be either <b>SOAP_AUTHENTICATION_BASIC</b> (default) or <b>SOAP_AUTHENTICATION_DIGEST</b>. </p> <p> The compression option allows to use compression of HTTP SOAP requests and responses. </p> <p> The encoding option defines internal character encoding. This option does not change the encoding of SOAP requests (it is always utf-8), but converts strings into it. </p> <p> The trace option enables tracing of request so faults can be backtraced. This defaults to <b>FALSE</b> </p> <p> The classmap option can be used to map some WSDL types to PHP classes. This option must be an array with WSDL types as keys and names of PHP classes as values. </p> <p> Setting the boolean trace option enables use of the methods SoapClient->__getLastRequest, SoapClient->__getLastRequestHeaders, SoapClient->__getLastResponse and SoapClient->__getLastResponseHeaders. </p> <p> The exceptions option is a boolean value defining whether soap errors throw exceptions of type SoapFault. </p> <p> The connection_timeout option defines a timeout in seconds for the connection to the SOAP service. This option does not define a timeout for services with slow responses. To limit the time to wait for calls to finish the default_socket_timeout setting is available. </p> <p> The typemap option is an array of type mappings. Type mapping is an array with keys type_name, type_ns (namespace URI), from_xml (callback accepting one string parameter) and to_xml (callback accepting one object parameter). </p> <p> The cache_wsdl option is one of <b>WSDL_CACHE_NONE</b>, <b>WSDL_CACHE_DISK</b>, <b>WSDL_CACHE_MEMORY</b> or <b>WSDL_CACHE_BOTH</b>. </p> <p> The user_agent option specifies string to use in User-Agent header. </p> <p> The stream_context option is a resource for context. </p> <p> The features option is a bitmask of <b>SOAP_SINGLE_ELEMENT_ARRAYS</b>, <b>SOAP_USE_XSI_ARRAY_TYPE</b>, <b>SOAP_WAIT_ONE_WAY_CALLS</b>. </p> <p> The keep_alive option is a boolean value defining whether to send the Connection: Keep-Alive header or Connection: close. </p> <p> The ssl_method option is one of <b>SOAP_SSL_METHOD_TLS</b>, <b>SOAP_SSL_METHOD_SSLv2</b>, <b>SOAP_SSL_METHOD_SSLv3</b> or <b>SOAP_SSL_METHOD_SSLv23</b>. </p> /","params":[{"name":"wsdl","declared_type":"string|null","description":"<p>"},{"name":"options","declared_type":"array","description":"[optional] <p>"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"SoapFault::__construct","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":31511,"end":31522}},"declared_type":null,"signature":{"parameters":[{"name":"code","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"string","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"actor","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"details","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false},{"name":"name","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"headerFault","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false},{"name":"lang","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"SoapFault constructor The error code of the <b>SoapFault</b>. </p> The error message of the <b>SoapFault</b>. </p> A string identifying the actor that caused the error. </p> More details about the cause of the error. </p> Can be used to select the proper fault encoding from WSDL. </p> Can be used during SOAP header handling to report an error in the response header. </p> for SOAP version 1.2. /","params":[{"name":"code","declared_type":"string","description":"<p>"},{"name":"string","declared_type":"string","description":"<p>"},{"name":"actor","declared_type":"string","description":"[optional] <p>"},{"name":"details","declared_type":"mixed","description":"[optional] <p>"},{"name":"name","declared_type":"string","description":"[optional] <p>"},{"name":"headerFault","declared_type":"mixed","description":"[optional] <p>"},{"name":"lang","declared_type":"string","description":"The human language that the SoapFault is written in. This is only used"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__toString","fqn":"SoapFault::__toString","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":33386,"end":33396}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Obtain a string representation of a SoapFault /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"SoapFault","fqn":"SoapFault::SoapFault","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":32980,"end":32989}},"declared_type":null,"signature":{"parameters":[{"name":"faultcode","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"faultstring","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"faultactor","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"detail","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"faultname","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"headerfault","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"SoapFault constructor The error code of the <b>SoapFault</b>. </p> The error message of the <b>SoapFault</b>. </p> A string identifying the actor that caused the error. </p> More details about the cause of the error. </p> Can be used to select the proper fault encoding from WSDL. </p> Can be used during SOAP header handling to report an error in the response header. </p> /","params":[{"name":"faultcode","declared_type":"string","description":"<p>"},{"name":"faultstring","declared_type":"string","description":"<p>"},{"name":"faultactor","declared_type":"string","description":"[optional] <p>"},{"name":"detail","declared_type":"string","description":"[optional] <p>"},{"name":"faultname","declared_type":"string","description":"[optional] <p>"},{"name":"headerfault","declared_type":"mixed","description":"[optional] <p>"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"SoapHeader::__construct","kind":"Method","origin":"PhpRuntime","extension":"soap","location":{"file":"soap/soap.php","range":{"start":35992,"end":36003}},"declared_type":null,"signature":{"parameters":[{"name":"namespace","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference