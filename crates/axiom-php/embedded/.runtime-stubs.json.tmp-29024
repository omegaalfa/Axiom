ull,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, CUBRID &gt;= 8.4.1)<br/> Export the lob object to a file. Lob identifier as a result of cubrid_lob2_new() or get from the result set. </p> File name you want to store BLOB/CLOB data. It also supports the path of the file. </p> TRUE if the process is successful and FALSE for failure. </p> /","params":[{"name":"lob_identifier","declared_type":"resource","description":"<p>"},{"name":"file_name","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"cubrid_lob2_import","fqn":"cubrid_lob2_import","kind":"Function","origin":"PhpRuntime","extension":"cubrid","location":{"file":"cubrid/cubrid.php","range":{"start":45755,"end":45773}},"declared_type":null,"signature":{"parameters":[{"name":"lob_identifier","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"file_name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, CUBRID &gt;= 8.4.1)<br/> Import the lob object from a file. Lob identifier as a result of cubrid_lob2_new() or get from the result set. </p> File name you want to import BLOB/CLOB data. It also supports the path of the file. </p> TRUE if the process is successful and FALSE for failure. </p> /","params":[{"name":"lob_identifier","declared_type":"resource","description":"<p>"},{"name":"file_name","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"cubrid_lob2_new","fqn":"cubrid_lob2_new","kind":"Function","origin":"PhpRuntime","extension":"cubrid","location":{"file":"cubrid/cubrid.php","range":{"start":46408,"end":46423}},"declar