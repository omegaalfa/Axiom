on":{"description":"Performs the same action as sUnion, but stores the result in the first key <pre> $redisCluster->del('s0', 's1', 's2'); $redisCluster->sAdd('s0', '1'); $redisCluster->sAdd('s0', '2'); $redisCluster->sAdd('s1', '3'); $redisCluster->sAdd('s1', '1'); $redisCluster->sAdd('s2', '3'); $redisCluster->sAdd('s2', '4'); var_dump($redisCluster->sUnionStore('dst', 's0', 's1', 's2')); var_dump($redisCluster->sMembers('dst')); //// Output: // //int(4) //array(4) { //  [0]=> //  string(1) \"3\" //  [1]=> //  string(1) \"4\" //  [2]=> //  string(1) \"1\" //  [3]=> //  string(1) \"2\" //} </pre> /","params":[{"name":"dst","declared_type":"string","description":"the key to store the diff into."},{"name":"key","declared_type":"string","description":"Any number of keys corresponding to sets in redis."},{"name":"","declared_type":null,"description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"time","fqn":"RedisCluster::time","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":123422,"end":123426}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|array","phpdoc_return_type":null},"documentation":{"description":"Return the specified node server time. unix timestamp, and element one being microseconds. <pre> var_dump( $redisCluster->time('x') ); //// Output: // // array(2) { //   [0] => string(10) \"1342364352\" //   [1] => string(6) \"253002\" // } </pre> /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":fals