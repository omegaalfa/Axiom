age range when matching. </p> If true, the arguments will be converted to canonical form before matching. </p> The locale to use if no match is found. </p> /","params":[{"name":"languageTag","declared_type":"string[]","description":"<p>"},{"name":"locale","declared_type":"string","description":"<p>"},{"name":"canonicalize","declared_type":"bool","description":"<p>"},{"name":"defaultLocale","declared_type":"string|null","description":"<p>"}],"return_type":"string|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"locale_minimize_subtags","fqn":"locale_minimize_subtags","kind":"Function","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":282863,"end":282886}},"declared_type":null,"signature":{"parameters":[{"name":"locale","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":null},"documentation":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"locale_parse","fqn":"locale_parse","kind":"Function","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":189574,"end":189586}},"declared_type":null,"signature":{"parameters":[{"name":"locale","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"?array","phpdoc_return_type":"string[]|null"},"documentation":{"description":"(PHP 5 &gt;= 5.3.0, PECL intl &gt;= 1.0.0)<br/> Returns a key-value array of locale ID subtag elements. The locale to extract the subtag array from. Note: The 'variant' and 'private' subtags can take maximum 15 values whereas 'extlang' can take maximum 3 values. </p> identify the particular locale ID subtags, and the values are the associated subtag values. The array will be ordered as the locale id subtags e.g. in the locale id if variants are '-varX-varY-varZ' then the returned array will have variant0=&gt;varX , variant1=&gt;varY , variant2=&gt;varZ /","params":[{"name":"locale","declared_type":"string","description":"<p>"}],"return_type":"string[]|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"locale_set_default","fqn":"locale_set_default","kind":"Function","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":181209,"end":181227}},"declared_type":null,"signature":{"parameters":[{"name":"locale","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5 &gt;= 5.3.0, PECL intl &gt;= 1.0.0)<br/> Set the default runtime Locale The new Locale name. A comprehensive list of the supported locales is available at . </p> /","params":[{"name":"locale","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"localeconv","fqn":"localeconv","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":41886,"end":41896}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Get numeric formatting information as set by setlocale. The associative array that is returned contains the following fields: <tr valign=\"top\"> <td>Array element</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>decimal_point</td> <td>Decimal point character</td> </tr> <tr valign=\"top\"> <td>thousands_sep</td> <td>Thousands separator</td> </tr> <tr valign=\"top\"> <td>grouping</td> <td>Array containing numeric groupings</td> </tr> <tr valign=\"top\"> <td>int_curr_symbol</td> <td>International currency symbol (i.e. USD)</td> </tr> <tr valign=\"top\"> <td>currency_symbol</td> <td>Local currency symbol (i.e. $)</td> </tr> <tr valign=\"top\"> <td>mon_decimal_point</td> <td>Monetary decimal point character</td> </tr> <tr valign=\"top\"> <td>mon_thousands_sep</td> <td>Monetary thousands separator</td> </tr> <tr valign=\"top\"> <td>mon_grouping</td> <td>Array containing monetary groupings</td> </tr> <tr valign=\"top\"> <td>positive_sign</td> <td>Sign for positive values</td> </tr> <tr valign=\"top\"> <td>negative_sign</td> <td>Sign for negative values</td> </tr> <tr valign=\"top\"> <td>int_frac_digits</td> <td>International fractional digits</td> </tr> <tr valign=\"top\"> <td>frac_digits</td> <td>Local fractional digits</td> </tr> <tr valign=\"top\"> <td>p_cs_precedes</td> <td> true if currency_symbol precedes a positive value, false if it succeeds one </td> </tr> <tr valign=\"top\"> <td>p_sep_by_space</td> <td> true if a space separates currency_symbol from a positive value, false otherwise </td> </tr> <tr valign=\"top\"> <td>n_cs_precedes</td> <td> true if currency_symbol precedes a negative value, false if it succeeds one </td> </tr> <tr valign=\"top\"> <td>n_sep_by_space</td> <td> true if a space separates currency_symbol from a negative value, false otherwise </td> </tr> <td>p_sign_posn</td> <td> 0 - Parentheses surround the quantity and currency_symbol 1 - The sign string precedes the quantity and currency_symbol 2 - The sign string succeeds the quantity and currency_symbol 3 - The sign string immediately precedes the currency_symbol 4 - The sign string immediately succeeds the currency_symbol </td> </tr> <td>n_sign_posn</td> <td> 0 - Parentheses surround the quantity and currency_symbol 1 - The sign string precedes the quantity and currency_symbol 2 - The sign string succeeds the quantity and currency_symbol 3 - The sign string immediately precedes the currency_symbol 4 - The sign string immediately succeeds the currency_symbol </td> </tr> </p> <p> The p_sign_posn, and n_sign_posn contain a string of formatting options. Each number representing one of the above listed conditions. </p> <p> The grouping fields contain arrays that define the way numbers should be grouped. For example, the monetary grouping field for the nl_NL locale (in UTF-8 mode with the euro sign), would contain a 2 item array with the values 3 and 3. The higher the index in the array, the farther left the grouping is. If an array element is equal to CHAR_MAX, no further grouping is done. If an array element is equal to 0, the previous element should be used. /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"localtime","fqn":"localtime","kind":"Function","origin":"PhpRuntime","extension":"date","location":{"file":"date/date.php","range":{"start":24684,"end":24693}},"declared_type":null,"signature":{"parameters":[{"name":"timestamp","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false},{"name":"associative","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Get the local time If set to false or not supplied then the array is returned as a regular, numerically indexed array. If the argument is set to true then localtime returns an associative array containing all the different elements of the structure returned by the C function call to localtime. The names of the different keys of the associative array are as follows: </p> \"tm_sec\" - seconds /","params":[{"name":"timestamp","declared_type":"int|null","description":"[optional]"},{"name":"associative","declared_type":"bool","description":"[optional] <p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"log","fqn":"log","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":10808,"end":10811}},"declared_type":null,"signature":{"parameters":[{"name":"num","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"base","declared_type":"float","phpdoc_type":"float","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"float","phpdoc_return_type":"float"},"documentation":{"description":"Natural logarithm The value to calculate the logarithm for </p> The optional logarithmic base to use (defaults to 'e' and so to the natural logarithm). </p> base, if given, or the natural logarithm. /","params":[{"name":"num","declared_type":"float","description":"<p>"},{"name":"base","declared_type":"float","description":"[optional] <p>"}],"return_type":"float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"log10","fqn":"log10","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":11060,"end":11065}},"declared_type":null,"signature":{"parameters":[{"name":"num","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float","phpdoc_return_type":"float"},"documentation":{"description":"Base-10 logarithm The argument to process </p> /","params":[{"name":"num","declared_type":"float","description":"<p>"}],"return_type":"float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"log1p","fqn":"log1p","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":8090,"end":8095}},"declared_type":null,"signature":{"parameters":[{"name":"num","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float","phpdoc_return_type":"float"},"documentation":{"description":"Returns log(1 + number), computed in a way that is accurate even when the value of number is close to zero The argument to process </p> /","params":[{"name":"num","declared_type":"float","description":"<p>"}],"return_type":"float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"long2ip","fqn":"long2ip","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":19436,"end":19443}},"declared_type":null,"signature":{"parameters":[{"name":"ip","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Converts an long integer address into a string in (IPv4) internet standard dotted format A proper address representation. </p> /","params":[{"name":"ip","declared_type":"int","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lstat","fqn":"lstat","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7.php","range":{"start":24669,"end":24674}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Gives information about a file or symbolic link Path to a file or a symbolic link. </p> the structure of the array that lstat returns. This function is identical to the stat function except that if the filename parameter is a symbolic link, the status of the symbolic link is returned, not the status of the file pointed to by the symbolic link. /","params":[{"name":"filename","declared_type":"string","description":"<p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ltrim","fqn":"ltrim","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":31604,"end":31609}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"characters","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"characters","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Strip whitespace (or other characters) from the beginning of a string The input string. </p> You can also specify the characters you want to strip, by means of the charlist parameter. Simply list all characters that you want to be stripped. With .. you can specify a range of characters. </p> beginning of str. Without the second parameter, ltrim will strip these characters: \" \" (ASCII 32 (0x20)), an ordinary space. \"\\t\" (ASCII 9 (0x09)), a tab. \"\\n\" (ASCII 10 (0x0A)), a new line (line feed). \"\\r\" (ASCII 13 (0x0D)), a carriage return. \"\\0\" (ASCII 0 (0x00)), the NUL-byte. \"\\x0B\" (ASCII 11 (0x0B)), a vertical tab. /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"characters","declared_type":"string","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lzf_compress","fqn":"lzf_compress","kind":"Function","origin":"PhpRuntime","extension":"lzf","location":{"file":"lzf/lzf.php","range":{"start":301,"end":313}},"declared_type":null,"signature":{"parameters":[{"name":"data","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"false|string"},"documentation":{"description":"Compresses the given data string using LZF encoding. /","params":[{"name":"data","declared_type":"string","description":"Data to be compressed"}],"return_type":"false|string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lzf_decompress","fqn":"lzf_decompress","kind":"Function","origin":"PhpRuntime","extension":"lzf","location":{"file":"lzf/lzf.php","range":{"start":635,"end":649}},"declared_type":null,"signature":{"parameters":[{"name":"data","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"false|string"},"documentation":{"description":"Decompresses the given data string containing lzf encoded data. /","params":[{"name":"data","declared_type":"string","description":"The compressed string."}],"return_type":"false|string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"lzf_optimized_for","fqn":"lzf_optimized_for","kind":"Function","origin":"PhpRuntime","extension":"lzf","location":{"file":"lzf/lzf.php","range":{"start":920,"end":937}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Determines what was LZF extension optimized for during compilation. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"magic_quotes_runtime","fqn":"magic_quotes_runtime","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":27150,"end":27170}},"declared_type":null,"signature":{"parameters":[{"name":"new_setting","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Alias: {@see set_magic_quotes_runtime} /","params":[{"name":"new_setting","declared_type":"bool","description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mail","fqn":"mail","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7.php","range":{"start":32911,"end":32915}},"declared_type":null,"signature":{"parameters":[{"name":"to","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"message","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"additional_headers","declared_type":"array|string","phpdoc_type":"string|array","optional":true,"variadic":false,"by_reference":false},{"name":"additional_params","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Send mail Receiver, or receivers of the mail. </p> <p> The formatting of this string must comply with RFC 2822. Some examples are: user@example.com user@example.com, anotheruser@example.com User &lt;user@example.com&gt; User &lt;user@example.com&gt;, Another User &lt;anotheruser@example.com&gt; </p> Subject of the email to be sent. </p> <p> Subject must satisfy RFC 2047. </p> Message to be sent. </p> <p> Each line should be separated with a LF (\\n). Lines should not be larger than 70 characters. </p> <p> <strong>Caution</strong> (Windows only) When PHP is talking to a SMTP server directly, if a full stop is found on the start of a line, it is removed. To counter-act this, replace these occurrences with a double dot. </p> <pre> <?php $text = str_replace(\"\\n.\", \"\\n..\", $text); ?> </pre> String or array to be inserted at the end of the email header.<br/> Since 7.2.0 accepts an array. Its keys are the header names and its values are the respective header values. </p> <p> This is typically used to add extra headers (From, Cc, and Bcc). Multiple extra headers should be separated with a CRLF (\\r\\n). </p> <p> When sending mail, the mail must contain a From header. This can be set with the additional_headers parameter, or a default can be set in \"php.ini\". </p> <p> Failing to do this will result in an error message similar to Warning: mail(): \"sendmail_from\" not set in php.ini or custom \"From:\" header missing. The From header sets also Return-Path under Windows. </p> <p> If messages are not received, try using a LF (\\n) only. Some poor quality Unix mail transfer agents replace LF by CRLF automatically (which leads to doubling CR if CRLF is used). This should be a last resort, as it does not comply with RFC 2822. </p> The additional_parameters parameter can be used to pass additional flags as command line options to the program configured to be used when sending mail, as defined by the sendmail_path configuration setting. For example, this can be used to set the envelope sender address when using sendmail with the -f sendmail option. </p> <p> The user that the webserver runs as should be added as a trusted user to the sendmail configuration to prevent a 'X-Warning' header from being added to the message when the envelope sender (-f) is set using this method. For sendmail users, this file is /etc/mail/trusted-users. </p> <p> It is important to note that just because the mail was accepted for delivery, it does NOT mean the mail will actually reach the intended destination. </p> /","params":[{"name":"to","declared_type":"string","description":"<p>"},{"name":"subject","declared_type":"string","description":"<p>"},{"name":"message","declared_type":"string","description":"<p>"},{"name":"additional_headers","declared_type":"string|array","description":"<p>"},{"name":"additional_params","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_determine_best_xfer_encoding","fqn":"mailparse_determine_best_xfer_encoding","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":487,"end":525}},"declared_type":null,"signature":{"parameters":[{"name":"fp","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Figures out the best way of encoding the content read from the given file pointer. A valid file pointer, which must be seek-able. </p> {@link https://php.net/manual/en/ref.mbstring.php mbstring} module. /","params":[{"name":"fp","declared_type":"resource","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_create","fqn":"mailparse_msg_create","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":761,"end":781}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"resource"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Create a MIME mail resource. /","params":[],"return_type":"resource","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_extract_part","fqn":"mailparse_msg_extract_part","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":2329,"end":2355}},"declared_type":null,"signature":{"parameters":[{"name":"mimemail","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"msgbody","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"callbackfunc","declared_type":null,"phpdoc_type":"callable","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Extracts/decodes a message section A valid MIME resource. </p> /","params":[{"name":"mimemail","declared_type":"resource","description":"<p>"},{"name":"msgbody","declared_type":"string","description":null},{"name":"callbackfunc","declared_type":"callable","description":"[optional]"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_extract_part_file","fqn":"mailparse_msg_extract_part_file","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":1932,"end":1963}},"declared_type":null,"signature":{"parameters":[{"name":"mimemail","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"filename","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"callbackfunc","declared_type":null,"phpdoc_type":"callable","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|bool"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Extracts/decodes a message section from the supplied filename. The contents of the section will be decoded according to their transfer encoding - base64, quoted-printable and uuencoded text are supported. A valid MIME resource, created with {@link https://php.net/manual/en/function.mailparse-msg-create.php mailparse_msg_create()}. </p> Can be a file name or a valid stream resource. </p> If set, this must be either a valid callback that will be passed the extracted section, or <b>NULL</b> to make this function return the extracted section. </p> <p> If not specified, the contents will be sent to \"stdout\". </p> If callbackfunc is not <b>NULL</b> returns <b>TRUE</b> on success. </p> <p> If callbackfunc is set to <b>NULL</b>, returns the extracted section as a string. </p> <p> Returns FALSE on error. </p> /","params":[{"name":"mimemail","declared_type":"resource","description":"<p>"},{"name":"filename","declared_type":"mixed","description":"<p>"},{"name":"callbackfunc","declared_type":"callable","description":"[optional] <p>"}],"return_type":"string|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_extract_whole_part_file","fqn":"mailparse_msg_extract_whole_part_file","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":2782,"end":2819}},"declared_type":null,"signature":{"parameters":[{"name":"mimemail","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"callbackfunc","declared_type":null,"phpdoc_type":"callable","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Extracts a message section including headers without decoding the transfer encoding A valid MIME resource </p> /","params":[{"name":"mimemail","declared_type":"resource","description":"<p>"},{"name":"filename","declared_type":"string","description":null},{"name":"callbackfunc","declared_type":"callable","description":"[optional]"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_free","fqn":"mailparse_msg_free","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":3366,"end":3384}},"declared_type":null,"signature":{"parameters":[{"name":"mimemail","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Frees a MIME resource. A valid MIME resource allocated by {@link https://php.net/manual/en/function.mailparse-msg-create.php mailparse_msg_create()} or {@link https://php.net/manual/en/function.mailparse-msg-parse-file.php mailparse_msg_parse_file()}. </p> /","params":[{"name":"mimemail","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_get_part","fqn":"mailparse_msg_get_part","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":4013,"end":4035}},"declared_type":null,"signature":{"parameters":[{"name":"mimemail","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"mimesection","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Returns a handle on a given section in a mimemessage A valid MIME resource. </p> /","params":[{"name":"mimemail","declared_type":"resource","description":"<p>"},{"name":"mimesection","declared_type":"string","description":null}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_get_part_data","fqn":"mailparse_msg_get_part_data","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":3669,"end":3696}},"declared_type":null,"signature":{"parameters":[{"name":"mimemail","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Returns an associative array of info about the message A valid MIME resource. </p> /","params":[{"name":"mimemail","declared_type":"resource","description":"<p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_get_structure","fqn":"mailparse_msg_get_structure","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":4342,"end":4369}},"declared_type":null,"signature":{"parameters":[{"name":"mimemail","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Returns an array of mime section names in the supplied message A valid MIME resource. </p> /","params":[{"name":"mimemail","declared_type":"resource","description":"<p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_parse","fqn":"mailparse_msg_parse","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":5334,"end":5353}},"declared_type":null,"signature":{"parameters":[{"name":"mimemail","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"data","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Incrementally parse data into the supplied mime mail resource. This function allow you to stream portions of a file at a time, rather than read and parse the whole thing. A valid MIME resource. </p> /","params":[{"name":"mimemail","declared_type":"resource","description":"<p>"},{"name":"data","declared_type":"string","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_msg_parse_file","fqn":"mailparse_msg_parse_file","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":4833,"end":4857}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Parses a file. This is the optimal way of parsing a mail file that you have on disk. Path to the file holding the message. The file is opened and streamed through the parser. </p> /","params":[{"name":"filename","declared_type":"string","description":"<p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_rfc822_parse_addresses","fqn":"mailparse_rfc822_parse_addresses","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":6368,"end":6400}},"declared_type":null,"signature":{"parameters":[{"name":"addresses","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Parses a {@link http://www.faqs.org/rfcs/rfc822 RFC 822} compliant recipient list, such as that found in the To: header. A string containing addresses, like in: <pre>Wez Furlong <wez@example.com>, doe@example.com</pre> Note: This string must not include the header name. </p> Returns an array of associative arrays with the following keys for each recipient: </p> <table> <tr valign=\"top\"> <td>display</td> <td>The recipient name, for display purpose. If this part is not set for a recipient, this key will hold the same value as address.</td> </tr> <tr valign=\"top\"> <td>address</td> <td>The email address</td> </tr> <tr valign=\"top\"> <td>is_group</td> <td><b>TRUE</b> if the recipient is a newsgroup, <b>FALSE</b> otherwise.</td> </tr> </table> /","params":[{"name":"addresses","declared_type":"string","description":"<p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_stream_encode","fqn":"mailparse_stream_encode","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":7096,"end":7119}},"declared_type":null,"signature":{"parameters":[{"name":"sourcefp","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"destfp","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Streams data from the source file pointer, apply encoding and write to the destination file pointer. A valid file handle. The file is streamed through the parser. </p> The destination file handle in which the encoded data will be written. </p> One of the character encodings supported by the {@link https://php.net/manual/en/ref.mbstring.php mbstring} module. </p> /","params":[{"name":"sourcefp","declared_type":"resource","description":"<p>"},{"name":"destfp","declared_type":"resource","description":"<p>"},{"name":"encoding","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mailparse_uudecode_all","fqn":"mailparse_uudecode_all","kind":"Function","origin":"PhpRuntime","extension":"mailparse","location":{"file":"mailparse/mailparse.php","range":{"start":7903,"end":7925}},"declared_type":null,"signature":{"parameters":[{"name":"fp","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PECL mailparse >= 0.9.0)<br/> Scans the data from the given file pointer and extract each embedded uuencoded file into a temporary file. A valid file pointer. </p> Returns an array of associative arrays listing filename information. </p> <table> <tr valign=\"top\"> <td>filename</td> <td>Path to the temporary file name created</td> </tr> <tr valign=\"top\"> <td>origfilename</td> <td>The original filename, for uuencoded parts only</td> </tr> </table> <p> The first filename entry is the message body. The next entries are the decoded uuencoded files. </p> /","params":[{"name":"fp","declared_type":"resource","description":"<p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"max","fqn":"max","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":26652,"end":26655}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"array|mixed","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":"mixed","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"values","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Find highest value parameter values, either within a arg array or two arguments. /","params":[{"name":"value","declared_type":"array|mixed","description":"Array to look through or first value to compare"},{"name":"","declared_type":null,"description":null}],"return_type":"mixed","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_check_encoding","fqn":"mb_check_encoding","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":31632,"end":31649}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"array|string|null","phpdoc_type":"string|string[]|null","optional":true,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Check if the string is valid for the specified encoding The byte stream to check. If it is omitted, this function checks all the input from the beginning of the request. </p> The expected encoding. </p> /","params":[{"name":"value","declared_type":"string|string[]|null","description":"[optional] <p>"},{"name":"encoding","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_chr","fqn":"mb_chr","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":45776,"end":45782}},"declared_type":null,"signature":{"parameters":[{"name":"codepoint","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Get a specific character. /","params":[{"name":"codepoint","declared_type":"int","description":null},{"name":"encoding","declared_type":"string|null","description":"[optional]"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_convert_case","fqn":"mb_convert_case","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":717,"end":732}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Perform case folding on a string The string being converted. </p> The mode of the conversion. It can be one of MB_CASE_UPPER, MB_CASE_LOWER, or MB_CASE_TITLE. </p> way specified by mode. /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"int","description":"<p>"},{"name":"encoding","declared_type":"string|null","description":"[optional]"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_convert_encoding","fqn":"mb_convert_encoding","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":20099,"end":20118}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"array|string","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"to_encoding","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"from_encoding","declared_type":"array|string|null","phpdoc_type":"string|string[]|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|string|false","phpdoc_return_type":"array|string|false"},"documentation":{"description":"Convert character encoding The string being encoded. </p> The type of encoding that str is being converted to. </p> Is specified by character code names before conversion. It is either an array, or a comma separated enumerated list. If from_encoding is not specified, the internal encoding will be used. </p> <p> \"auto\" may be used, which expands to \"ASCII,JIS,UTF-8,EUC-JP,SJIS\". </p> from_encoding is an invalid encoding. Prior to PHP 8.0.0, a E_WARNING was emitted instead. /","params":[{"name":"string","declared_type":"string|array","description":"<p>"},{"name":"to_encoding","declared_type":"string","description":"<p>"},{"name":"from_encoding","declared_type":"string|string[]|null","description":"[optional] <p>"}],"return_type":"array|string|false","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_convert_kana","fqn":"mb_convert_kana","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":24320,"end":24335}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Convert \"kana\" one from another (\"zen-kaku\", \"han-kaku\" and more) The string being converted. </p> The conversion option. </p> <p> Specify with a combination of following options. <table> Applicable Conversion Options <tr valign=\"top\"> <td>Option</td> <td>Meaning</td> </tr> <tr valign=\"top\"> <td>r</td> <td> Convert \"zen-kaku\" alphabets to \"han-kaku\" </td> </tr> <tr valign=\"top\"> <td>R</td> <td> Convert \"han-kaku\" alphabets to \"zen-kaku\" </td> </tr> <tr valign=\"top\"> <td>n</td> <td> Convert \"zen-kaku\" numbers to \"han-kaku\" </td> </tr> <tr valign=\"top\"> <td>N</td> <td> Convert \"han-kaku\" numbers to \"zen-kaku\" </td> </tr> <tr valign=\"top\"> <td>a</td> <td> Convert \"zen-kaku\" alphabets and numbers to \"han-kaku\" </td> </tr> <tr valign=\"top\"> <td>A</td> <td> Convert \"han-kaku\" alphabets and numbers to \"zen-kaku\" (Characters included in \"a\", \"A\" options are U+0021 - U+007E excluding U+0022, U+0027, U+005C, U+007E) </td> </tr> <tr valign=\"top\"> <td>s</td> <td> Convert \"zen-kaku\" space to \"han-kaku\" (U+3000 -> U+0020) </td> </tr> <tr valign=\"top\"> <td>S</td> <td> Convert \"han-kaku\" space to \"zen-kaku\" (U+0020 -> U+3000) </td> </tr> <tr valign=\"top\"> <td>k</td> <td> Convert \"zen-kaku kata-kana\" to \"han-kaku kata-kana\" </td> </tr> <tr valign=\"top\"> <td>K</td> <td> Convert \"han-kaku kata-kana\" to \"zen-kaku kata-kana\" </td> </tr> <tr valign=\"top\"> <td>h</td> <td> Convert \"zen-kaku hira-gana\" to \"han-kaku kata-kana\" </td> </tr> <tr valign=\"top\"> <td>H</td> <td> Convert \"han-kaku kata-kana\" to \"zen-kaku hira-gana\" </td> </tr> <tr valign=\"top\"> <td>c</td> <td> Convert \"zen-kaku kata-kana\" to \"zen-kaku hira-gana\" </td> </tr> <tr valign=\"top\"> <td>C</td> <td> Convert \"zen-kaku hira-gana\" to \"zen-kaku kata-kana\" </td> </tr> <tr valign=\"top\"> <td>V</td> <td> Collapse voiced sound notation and convert them into a character. Use with \"K\",\"H\" </td> </tr> </table> </p> example \"sS\". /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"string","description":"[optional] <p>"},{"name":"encoding","declared_type":"string|null","description":"[optional]"}],"return_type":"string","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_convert_variables","fqn":"mb_convert_variables","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":27005,"end":27025}},"declared_type":null,"signature":{"parameters":[{"name":"to_encoding","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"from_encoding","declared_type":"array|string","phpdoc_type":"string|string[]","optional":false,"variadic":false,"by_reference":false},{"name":"vars","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"var","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"vars","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":true}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Convert character code in variable(s) The encoding that the string is being converted to. </p> from_encoding is specified as an array or comma separated string, it tries to detect encoding from from-coding. When from_encoding is omitted, detect_order is used. </p> vars is the other references to the variables being converted. String, Array and Object are accepted. mb_convert_variables assumes all parameters have the same encoding. </p> or false for failure. /","params":[{"name":"to_encoding","declared_type":"string","description":"<p>"},{"name":"from_encoding","declared_type":"string|string[]","description":"<p>"},{"name":"","declared_type":null,"description":null},{"name":"","declared_type":null,"description":null}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_decode_mimeheader","fqn":"mb_decode_mimeheader","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":26075,"end":26095}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Decode string in MIME header field The string being decoded. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_decode_numericentity","fqn":"mb_decode_numericentity","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":28487,"end":28510}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"map","declared_type":"array","phpdoc_type":"int[]","optional":false,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"?string","phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false},{"name":"is_hex","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false|null"},"documentation":{"description":"Decode HTML numeric string reference to character The string being decoded. </p> convmap is an array that specifies the code area to convert. </p> this parameter is not used. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"map","declared_type":"int[]","description":"<p>"},{"name":"encoding","declared_type":"null|string","description":null},{"name":"is_hex","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string|false|null","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_detect_encoding","fqn":"mb_detect_encoding","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":20948,"end":20966}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"encodings","declared_type":"array|string|null","phpdoc_type":"string|string[]|null","optional":true,"variadic":false,"by_reference":false},{"name":"strict","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Detect character encoding The string being detected. </p> encoding_list is list of character encoding. Encoding order may be specified by array or comma separated list string. </p> <p> If encoding_list is omitted, detect_order is used. </p> strict specifies whether to use the strict encoding detection or not. Default is false. </p> detected from the given string. /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"encodings","declared_type":"string|string[]|null","description":"[optional] <p>"},{"name":"strict","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_detect_order","fqn":"mb_detect_order","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":5770,"end":5785}},"declared_type":null,"signature":{"parameters":[{"name":"encoding","declared_type":"array|string|null","phpdoc_type":"array|string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|bool","phpdoc_return_type":"bool|string[]"},"documentation":{"description":"Set/Get character encoding detection order encoding_list is an array or comma separated list of character encoding. (\"auto\" is expanded to \"ASCII, JIS, UTF-8, EUC-JP, SJIS\") </p> <p> If encoding_list is omitted, it returns the current character encoding detection order as array. </p> <p> This setting affects mb_detect_encoding and mb_send_mail. </p> <p> mbstring currently implements the following encoding detection filters. If there is an invalid byte sequence for the following encodings, encoding detection will fail. </p> UTF-8, UTF-7, ASCII, EUC-JP,SJIS, eucJP-win, SJIS-win, JIS, ISO-2022-JP <p> For ISO-8859-*, mbstring always detects as ISO-8859-*. </p> <p> For UTF-16, UTF-32, UCS2 and UCS4, encoding detection will fail always. </p> <p> Useless detect order example </p> true is returned on success or FALSE on failure. When getting the encoding detection order, an ordered array of the encodings is returned. /","params":[{"name":"encoding","declared_type":"array|string|null","description":"[optional] <p>"}],"return_type":"bool|string[]","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_encode_mimeheader","fqn":"mb_encode_mimeheader","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":25656,"end":25676}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"charset","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"transfer_encoding","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"newline","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"indent","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Encode string for MIME header The string being encoded. </p> charset specifies the name of the character set in which str is represented in. The default value is determined by the current NLS setting (mbstring.language). mb_internal_encoding should be set to same encoding. </p> transfer_encoding specifies the scheme of MIME encoding. It should be either \"B\" (Base64) or \"Q\" (Quoted-Printable). Falls back to \"B\" if not given. </p> linefeed specifies the EOL (end-of-line) marker with which mb_encode_mimeheader performs line-folding (a RFC term, the act of breaking a line longer than a certain length into multiple lines. The length is currently hard-coded to 74 characters). Falls back to \"\\r\\n\" (CRLF) if not given. </p> Indentation of the first line (number of characters in the header before str). </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"charset","declared_type":"string|null","description":"[optional] <p>"},{"name":"transfer_encoding","declared_type":"string|null","description":"[optional] <p>"},{"name":"newline","declared_type":"string","description":"[optional] <p>"},{"name":"indent","declared_type":"int","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_encode_numericentity","fqn":"mb_encode_numericentity","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":27748,"end":27771}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"map","declared_type":"array","phpdoc_type":"int[]","optional":false,"variadic":false,"by_reference":false},{"name":"encoding","declared_type":"?string","phpdoc_type":"null|string","optional":true,"variadic":false,"by_reference":false},{"name":"hex","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Encode character to HTML numeric string reference The string being encoded. </p> convmap is array specifies code area to convert. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"map","declared_type":"int[]","description":"<p>"},{"name":"encoding","declared_type":"null|string","description":null},{"name":"hex","declared_type":"bool","description":"[optional]"}],"return_type":"string","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_encoding_aliases","fqn":"mb_encoding_aliases","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":21727,"end":21746}},"declared_type":null,"signature":{"parameters":[{"name":"encoding","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string[]|false"},"documentation":{"description":"Get aliases of a known encoding type /","params":[{"name":"encoding","declared_type":"string","description":"The encoding type being checked, for aliases."}],"return_type":"string[]|false","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_ereg","fqn":"mb_ereg","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":33069,"end":33076}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"matches","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Regular expression match with multibyte support The search pattern. </p> The search string. </p> Contains a substring of the matched string. </p> /","params":[{"name":"pattern","declared_type":"string","description":"<p>"},{"name":"string","declared_type":"string","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_ereg_match","fqn":"mb_ereg_match","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":38543,"end":38556}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Regular expression match for multibyte string The regular expression pattern. </p> The string being evaluated. </p> </p> /","params":[{"name":"pattern","declared_type":"string","description":"<p>"},{"name":"string","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_ereg_replace","fqn":"mb_ereg_replace","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":34787,"end":34802}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"replacement","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false|null","phpdoc_return_type":"string|false|null"},"documentation":{"description":"Replace regular expression with multibyte support The regular expression pattern. </p> <p> Multibyte characters may be used in pattern. </p> The replacement text. </p> The string being checked. </p> parameter. If i is specified for this parameter, the case will be ignored. If x is specified, white space will be ignored. If m is specified, match will be executed in multiline mode and line break will be included in '.'. If p is specified, match will be executed in POSIX mode, line break will be considered as normal character. If e is specified, replacement string will be evaluated as PHP expression. <p>PHP 7.1: The <i>e</i> modifier has been deprecated.</p> /","params":[{"name":"pattern","declared_type":"string","description":"<p>"},{"name":"replacement","declared_type":"string","description":"<p>"},{"name":"string","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"string|null","description":"Matching condition can be set by option"}],"return_type":"string|false|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_ereg_replace_callback","fqn":"mb_ereg_replace_callback","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":36646,"end":36670}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"callback","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false|null","phpdoc_return_type":"string|false|null"},"documentation":{"description":"Perform a regular expresssion seach and replace with multibyte support using a callback The regular expression pattern. </p> <p> Multibyte characters may be used in <b>pattern</b>. </p> A callback that will be called and passed an array of matched elements in the  <b>subject</b> string. The callback should return the replacement string. </p> <p> You'll often need the <b>callback</b> function for a <b>mb_ereg_replace_callback()</b> in just one place. In this case you can use an anonymous function to declare the callback within the call to <b>mb_ereg_replace_callback()</b>. By doing it this way you have all information for the call in one place and do not clutter the function namespace with a callback function's name not used anywhere else. </p> The string being checked. </p> Matching condition can be set by <em><b>option</b></em> parameter. If <em>i</em> is specified for this parameter, the case will be ignored. If <em>x</em> is specified, white space will be ignored. If <em>m</em> is specified, match will be executed in multiline mode and line break will be included in '.'. If <em>p</em> is specified, match will be executed in POSIX mode, line break will be considered as normal character. Note that <em>e</em> cannot be used for <b>mb_ereg_replace_callback()</b>. </p> The resultant string on success, or <b>FALSE</b> on error. </p> /","params":[{"name":"pattern","declared_type":"string","description":"<p>"},{"name":"callback","declared_type":"callable","description":"<p>"},{"name":"string","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"string","description":"<p>"}],"return_type":"string|false|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_ereg_search","fqn":"mb_ereg_search","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":38980,"end":38994}},"declared_type":null,"signature":{"parameters":[{"name":"pattern","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Multibyte regular expression match for predefined multibyte string The search pattern. </p> The search option. </p> /","params":[{"name":"pattern","declared_type":"string|null","description":"[optional] <p>"},{"name":"options","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_ereg_search_getpos","fqn":"mb_ereg_search_getpos","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":41949,"end":41970}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Returns start point for next regular expression match /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mb_ereg_search_getregs","fqn":"mb_ereg_search_getregs","kind":"Function","origin":"PhpRuntime","extension":"mbstring","location":{"file":"mbstring/mbstring.php","range":{"start":41712,"end":41734}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array|false","phpdoc_return_type":"string[]|false"},"documentation":{"description":"Retrieve the result from the last multibyte regular expression match part by last mb_ereg_search(), mb_ereg_search_pos(), mb_ereg_search_regs(). If there are some matches, the first element will have the matched sub-string, the second element will have the first part grouped with brackets, the third element will have the second part grouped with brackets, and so on. It returns FAL