nd":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":18685,"end":18701}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"result","declared_type":"Result","phpdoc_type":"resource|Result","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Free result memory /","params":[{"name":"result","declared_type":"resource|Result","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_get_attributes","fqn":"ldap_get_attributes","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":23488,"end":23507}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Get attributes from a search result entry An LDAP link identifier, returned by <b>ldap_connect</b>. </p> on success and <b>FALSE</b> on error. /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"entry","declared_type":"resource","description":null}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_get_dn","fqn":"ldap_get_dn","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":25892,"end":25903}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Get the DN of a result entry An LDAP link identifier, returned by <b>ldap_connect</b>. </p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"entry","declared_type":"resource","description":null}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_get_entries","fqn":"ldap_get_entries","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":21832,"end":21848}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Get all result entries An LDAP link identifier, returned by <b>ldap_connect</b>. </p> success and <b>FALSE</b> on error. </p> <p> The structure of the array is as follows. The attribute index is converted to lowercase. (Attributes are case-insensitive for directory servers, but not when used as array indices.) <pre> return_value[\"count\"] = number of entries in the result return_value[0] : refers to the details of first entry return_value[i][\"dn\"] = DN of the ith entry in the result return_value[i][\"count\"] = number of attributes in ith entry return_value[i][j] = NAME of the jth attribute in the ith entry in the result return_value[i][\"attribute\"][\"count\"] = number of values for attribute in ith entry return_value[i][\"attribute\"][j] = jth value of attribute in ith entry </pre> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"result","declared_type":"resource","description":null}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_get_option","fqn":"ldap_get_option","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":42859,"end":42874}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"option","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true},{"name":"value","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Get the current value for given option An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The parameter <i>option</i> can be one of: <tr valign=\"top\"> <td>Option</td> <td>Type</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_DEREF</b></td> <td>integer</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_SIZELIMIT</b></td> <td>integer</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_TIMELIMIT</b></td> <td>integer</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_NETWORK_TIMEOUT</b></td> <td>integer</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_PROTOCOL_VERSION</b></td> <td>integer</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_ERROR_NUMBER</b></td> <td>integer</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_REFERRALS</b></td> <td>bool</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_RESTART</b></td> <td>bool</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_HOST_NAME</b></td> <td>string</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_ERROR_STRING</b></td> <td>string</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_MATCHED_DN</b></td> <td>string</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_SERVER_CONTROLS</b></td> <td>array</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_CLIENT_CONTROLS</b></td> <td>array</td> </tr> </p> This will be set to the option value. </p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"option","declared_type":"int","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_get_values","fqn":"ldap_get_values","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":24578,"end":24593}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"attribute","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Get all values from a result entry An LDAP link identifier, returned by <b>ldap_connect</b>. </p> error. The number of values can be found by indexing \"count\" in the resultant array. Individual values are accessed by integer index in the array. The first index is 0. </p> <p> LDAP allows more than one entry for an attribute, so it can, for example, store a number of email addresses for one person's directory entry all labeled with the attribute \"mail\" return_value[\"count\"] = number of values for attribute return_value[0] = first value of attribute return_value[i] = ith value of attribute /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"entry","declared_type":"resource","description":null},{"name":"attribute","declared_type":"string","description":null}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_get_values_len","fqn":"ldap_get_values_len","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":25353,"end":25372}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"attribute","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Get all binary values from a result entry An LDAP link identifier, returned by <b>ldap_connect</b>. </p> error. Individual values are accessed by integer index in the array. The first index is 0. The number of values can be found by indexing \"count\" in the resultant array. /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"entry","declared_type":"resource","description":null},{"name":"attribute","declared_type":"string","description":null}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_list","fqn":"ldap_list","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":15244,"end":15253}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"base","declared_type":"array|string","phpdoc_type":"array|array|string","optional":false,"variadic":false,"by_reference":false},{"name":"filter","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"attributes","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"attributes_only","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"sizelimit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"timelimit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"deref","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"controls","declared_type":null,"phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Single-level search An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The base DN for the directory. </p> An array of the required attributes, e.g. array(\"mail\", \"sn\", \"cn\"). Note that the \"dn\" is always returned irrespective of which attributes types are requested. </p> <p> Using this parameter is much more efficient than the default action (which is to return all attributes and their associated values). The use of this parameter should therefore be considered good practice. </p> Should be set to 1 if only attribute types are wanted. If set to 0 both attributes types and attribute values are fetched which is the default behaviour. </p> Enables you to limit the count of entries fetched. Setting this to 0 means no limit. </p> <p> This parameter can NOT override server-side preset sizelimit. You can set it lower though. </p> <p> Some directory server hosts will be configured to return no more than a preset number of entries. If this occurs, the server will indicate that it has only returned a partial results set. This also occurs if you use this parameter to limit the count of fetched entries. </p> Sets the number of seconds how long is spend on the search. Setting this to 0 means no limit. </p> <p> This parameter can NOT override server-side preset timelimit. You can set it lower though. </p> Specifies how aliases should be handled during the search. It can be one of the following: <b>LDAP_DEREF_NEVER</b> - (default) aliases are never dereferenced.</p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"base","declared_type":"array|array|string","description":"<p>"},{"name":"filter","declared_type":"array|string","description":null},{"name":"attributes","declared_type":"array","description":"<p>"},{"name":"attributes_only","declared_type":"int","description":"<p>"},{"name":"sizelimit","declared_type":"int","description":"[optional] <p>"},{"name":"timelimit","declared_type":"int","description":"[optional] <p>"},{"name":"deref","declared_type":"int","description":"<p>"},{"name":"controls","declared_type":"array|null","description":"Array of LDAP Controls to send with the request."}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_mod_add","fqn":"ldap_mod_add","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":32162,"end":32174}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"dn","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"controls","declared_type":null,"phpdoc_type":"array|null",