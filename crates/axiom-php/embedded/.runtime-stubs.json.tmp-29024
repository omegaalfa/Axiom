,"origin":"PhpRuntime","extension":"svm","location":{"file":"svm/SVM.php","range":{"start":4483,"end":4496}},"declared_type":null,"signature":{"parameters":[{"name":"problem","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"number_of_folds","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"float","phpdoc_return_type":"float"},"documentation":{"description":"Test training params on subsets of the training data Crossvalidate can be used to test the effectiveness of the current parameter set on a subset of the training data. Given a problem set and a n \"folds\", it separates the problem set into n subsets, and the repeatedly trains on one subset and tests on another. While the accuracy will generally be lower than a SVM trained on the enter data set, the accuracy score returned should be relatively useful, so it can be used to test different training parameters. /","params":[{"name":"problem","declared_type":"array","description":"The problem data. This can either be in the form of an array, the URL of an SVMLight formatted file, or a stream to an opened SVMLight formatted datasource."},{"name":"number_of_folds","declared_type":"int","description":"The number of sets the data should be divided into and cross tested. A higher number means smaller training sets and less reliability. 5 is a good number to start with."}],"return_type":"float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getOptions","fqn":"SVM::getOptions","kind":"Method","origin":"PhpRuntime","extension":"svm","location":{"file":"svm/SVM.php","range":{"start":4885,"end":4895}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Return the current training parameters Retrieve an array containing the training parameters. The parameters will be keyed on the predefined SVM constants. /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setOptions","fqn":"SVM::setOptions","kind":"Method","origin":"PhpRuntime","extension":"svm","location":{"file":"svm/SVM.php","range":{"start":5280,"end":5290}},"declared_type":null,"signature":{"parameters":[{"name":"params","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set training parameters Set one or more training parameters. /","params":[{"name":"params","declared_type":"array","description":"An array of training parameters, keyed on the SVM constants."}],"return_type":"bool","var_type":null,"throws":["SVMException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"train","fqn":"SVM::train","kind":"Method","origin":"PhpRuntime","extension":"svm","location":{"file":"svm/SVM.php","range":{"start":6529,"end":6534}},"declared_type":null,"signature":{"parameters":[{"name":"problem","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"weights","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"SVMModel","phpdoc_return_type":"SVMModel"},"documentation":{"description":"Create a SVMModel based on training data Train a support vector machine based on the supplied training data. /","params":[{"name":"problem","declared_type":"array","description":"The problem can be provided in three different ways. An array, where the data should start with the class label (usually 1 or -1) then followed by a sparse data set of dimension => data pairs. A URL to a file containing a SVM Light formatted problem, with the each line being a new training example, the start of each line containing the class (1, -1) then a series of tab separated data values shows as key:value. A opened stream pointing to a data source formatted as in the file above."},{"name":"weights","declared_type":"array|null","description":"Weights are an optional set of weighting parameters for the different classes, to help account for unbalanced training sets. For example, if the classes were 1 and -1, and -1 had significantly more example than one, the weight for -1 could be 0.5. Weights should be in the range 0-1."}],"return_type":"SVMModel","var_type":null,"throws":["SMVException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"SVMModel::__construct","kind":"Method","origin":"PhpRuntime","extension":"svm","location":{"file":"svm/SVMModel.php","range":{"start":907,"end":918}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Construct a new SVMModel Build a new SVMModel. Models will usually be created from the SVM::train function, but then saved models may be restored directly. /","params":[{"name":"filename","declared_type":"string","description":"The filename for the saved model file this model should load."}],"return_type":null,"var_type":null,"throws":["Throws"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"checkProbabilityModel","fqn":"SVMModel::checkProbabilityModel","kind":"Method","origin":"PhpRuntime","extension":"svm","location":{"file":"svm/SVMModel.php","range":{"start":457,"end":478}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Returns true if the model has probability information /","params":[],"return_type":"bool","va