optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Determine accessibility of a file The name of the file to be tested. </p> A mask consisting of one or more of <b>POSIX_F_OK</b>, <b>POSIX_R_OK</b>, <b>POSIX_W_OK</b> and <b>POSIX_X_OK</b>. </p> <p> <b>POSIX_R_OK</b>, <b>POSIX_W_OK</b> and <b>POSIX_X_OK</b> request checking whether the file exists and has read, write and execute permissions, respectively. <b>POSIX_F_OK</b> just requests checking for the existence of the file. </p> /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_ctermid","fqn":"posix_ctermid","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":7574,"end":7587}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Get path name of controlling terminal the current controlling terminal. Otherwise <b>FALSE</b> is returned and errno is set, which can be checked with <b>posix_get_last_error</b>. /","params":[],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"posix_eaccess","fqn":"posix_eaccess","kind":"Function","origin":"PhpRuntime","extension":"posix","location":{"file":"posix/posix.php","range":{"start":21910,"end":21923}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_ret