adic":false,"by_reference":false},{"name":"base","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"filter","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"attributes","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"attributes_only","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"sizelimit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"timelimit","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"deref","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"controls","declared_type":null,"phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Search LDAP tree An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The base DN for the directory. </p> The search filter can be simple or advanced, using boolean operators in the format described in the LDAP documentation (see the Netscape Directory SDK for full information on filters). </p> An array of the required attributes, e.g. array(\"mail\", \"sn\", \"cn\"). Note that the \"dn\" is always returned irrespective of which attributes types are requested. </p> <p> Using this parameter is much more efficient than the default action (which is to return all attributes and their associated values). The use of this parameter should therefore be considered good practice. </p> Should be set to 1 if only attribute types are wanted. If set to 0 both attributes types and attribute values are fetched which is the default behaviour. </p> Enables you to limit the count of entries fetched. Setting this to 0 means no limit. </p> <p> This parameter can NOT override server-side preset sizelimit. You can set it lower though. </p> <p> Some directory server hosts will be configured to return no more than a preset number of entries. If this occurs, the server will indicate that it has only returned a partial results set. This also occurs if you use this parameter to limit the count of fetched entries. </p> Sets the number of seconds how long is spend on the search. Setting this to 0 means no limit. </p> <p> This parameter can NOT override server-side preset timelimit. You can set it lower though. </p> Specifies how aliases should be handled during the search. It can be one of the following: <b>LDAP_DEREF_NEVER</b> - (default) aliases are never dereferenced.</p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"base","declared_type":"array|string","description":"<p>"},{"name":"filter","declared_type":"array|string","description":"<p>"},{"name":"attributes","declared_type":"array","description":"<p>"},{"name":"attributes_only","declared_type":"int","description":"<p>"},{"name":"sizelimit","declared_type":"int","description":"[optional] <p>"},{"name":"timelimit","declared_type":"int","description":"[optional] <p>"},{"name":"deref","declared_type":"int","description":"<p>"},{"name":"controls","declared_type":"array|null","description":"Array of LDAP Controls to send with the request."}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_set_option","fqn":"ldap_set_option","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":45674,"end":45689}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"option","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set the value of the given option An LDAP link identifier, returned by <b>ldap_connect</b>. </p> The parameter <i>option</i> can be one of: <tr valign=\"top\"> <td>Option</td> <td>Type</td> <td>Available since</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_DEREF</b></td> <td>integer</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_SIZELIMIT</b></td> <td>integer</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_TIMELIMIT</b></td> <td>integer</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_NETWORK_TIMEOUT</b></td> <td>integer</td> <td>PHP 5.3.0</td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_PROTOCOL_VERSION</b></td> <td>integer</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_ERROR_NUMBER</b></td> <td>integer</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_REFERRALS</b></td> <td>bool</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_RESTART</b></td> <td>bool</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_HOST_NAME</b></td> <td>string</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_ERROR_STRING</b></td> <td>string</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_MATCHED_DN</b></td> <td>string</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_SERVER_CONTROLS</b></td> <td>array</td> <td></td> </tr> <tr valign=\"top\"> <td><b>LDAP_OPT_CLIENT_CONTROLS</b></td> <td>array</td> <td></td> </tr> </p> <p> <b>LDAP_OPT_SERVER_CONTROLS</b> and <b>LDAP_OPT_CLIENT_CONTROLS</b> require a list of controls, this means that the value must be an array of controls. A control consists of an oid identifying the control, an optional value, and an optional flag for criticality. In PHP a control is given by an array containing an element with the key oid and string value, and two optional elements. The optional elements are key value with string value and key iscritical with boolean value. iscritical defaults to <b>FALSE</b> if not supplied. See draft-ietf-ldapext-ldap-c-api-xx.txt for details. See also the second example below. </p> The new value for the specified <i>option</i>. </p> /","params":[{"name":"ldap","declared_type":"resource","description":"<p>"},{"name":"option","declared_type":"int","description":"<p>"},{"name":"value","declared_type":"mixed","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_set_rebind_proc","fqn":"ldap_set_rebind_proc","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":48384,"end":48404}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"callback","declared_type":"?callable","phpdoc_type":"callable|null","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set a callback function to do re-binds on referral chasing /","params":[{"name":"ldap","declared_type":"resource","description":null},{"name":"callback","declared_type":"callable|null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ldap_sort","fqn":"ldap_sort","kind":"Function","origin":"PhpRuntime","extension":"ldap","location":{"file":"ldap/ldap.php","range":{"start":38866,"end":38875}},"declared_type":null,"signature":{"parameters":[{"name":"ldap","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":f