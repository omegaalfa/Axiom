ename."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"readimage","fqn":"Gmagick::readimage","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":52883,"end":52892}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Reads image from filename. /","params":[{"name":"filename","declared_type":"string","description":"The image filename."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"readimageblob","fqn":"Gmagick::readimageblob","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"start":53295,"end":53308}},"declared_type":null,"signature":{"parameters":[{"name":"imageContents","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Gmagick"},"documentation":{"description":"Reads image from a binary string. /","params":[{"name":"imageContents","declared_type":"string","description":"Content of image."},{"name":"filename","declared_type":"string","description":"[optional] The image filename."}],"return_type":"Gmagick","var_type":null,"throws":["GmagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"readimagefile","fqn":"Gmagick::readimagefile","kind":"Method","origin":"PhpRuntime","extension":"gmagick","location":{"file":"gmagick/gmagick.php","range":{"star