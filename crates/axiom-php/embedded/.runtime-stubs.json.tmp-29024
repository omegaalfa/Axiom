se},{"name":"__wakeup","fqn":"PDO::__wakeup","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":58733,"end":58741}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"beginTransaction","fqn":"PDO::beginTransaction","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":45465,"end":45481}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Initiates a transaction <p> Turns off autocommit mode. While autocommit mode is turned off, changes made to the database via the PDO object instance are not committed until you end the transaction by calling {@link PDO::commit()}. Calling {@link PDO::rollBack()} will roll back all changes to the database and return the connection to autocommit mode. </p> <p> Some databases, including MySQL, automatically issue an implicit COMMIT when a database definition language (DDL) statement such as DROP TABLE or CREATE TABLE is issued within a transaction. The implicit COMMIT will prevent you from rolling back any other changes within the transaction boundary. </p> the driver does not support transactions <br/> <b>Note</b>: An exception is raised even when the <b>PDO::ATTR_ERRMODE</b> attribute is not <b>PDO::ERRMODE_EXCEPTION</b>. /","params":[],"return_type":"bool","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"commit","fqn":"PDO::commit","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":45865,"end":45871}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Commits a transaction /","params":[],"return_type":"bool","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"connect","fqn":"PDO::connect","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":70441,"end":70448}},"declared_type":null,"signature":{"parameters":[{"name":"dsn","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"username","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"password","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"static","phpdoc_return_type":null},"documentation":{"description":"Connect to a database and return a PDO subclass for drivers that support it Creates an instance of a PDO subclass for the database being connected to, if it exists, otherwise returns a generic PDO instance. /","params":[],"return_type":null,"var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"errorCode","fqn":"PDO::errorCode","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":54739,"end":54748}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"?string","phpdoc_return_type":"mixed"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Fetch the SQLSTATE associated with the last operation on the database handle the ANSI SQL-92 standard. Briefly, an SQLSTATE consists of a two characters class value followed by a three characters subclass value. A class value of 01 indicates a warning and is accompanied by a return code of SQL_SUCCESS_WITH_INFO. Class values other than '01', except for the class 'IM', indicate an error. The class 'IM' is specific to warnings and errors that derive from the implementation of PDO (or perhaps ODBC, if you're using the ODBC driver) itself. The subclass value '000' in any class indicates that there is no subclass for that SQLSTATE. </p> <p> <b>PDO::errorCode</b> only retrieves error codes for operations performed directly on the database handle. If you create a PDOStatement object through <b>PDO::prepare</b> or <b>PDO::query</b> and invoke an error on the statement handle, <b>PDO::errorCode</b> will not reflect that error. You must call <b>PDOStatement::errorCode</b> to return the error code for an operation performed on a particular statement handle. </p> <p> Returns <b>NULL</b> if no operation has been run on the database handle. /","params":[],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"errorInfo","fqn":"PDO::errorInfo","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":56646,"end":56655}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Fetch extended error information associated with the last operation on the database handle about the last operation performed by this database handle. The array consists of the following fields: <tr valign=\"top\"> <td>Element</td> <td>Information</td> </tr> <tr valign=\"top\"> <td>0</td> <td>SQLSTATE error code (a five characters alphanumeric identifier defined in the ANSI SQL standard).</td> </tr> <tr valign=\"top\"> <td>1</td> <td>Driver-specific error code.</td> </tr> <tr valign=\"top\"> <td>2</td> <td>Driver-specific error message.</td> </tr> </p> <p> If the SQLSTATE error code is not set or there is no driver-specific error, the elements following element 0 will be set to <b>NULL</b>. </p> <p> <b>PDO::errorInfo</b> only retrieves error information for operations performed directly on the database handle. If you create a PDOStatement object through <b>PDO::prepare</b> or <b>PDO::query</b> and invoke an error on the statement handle, <b>PDO::errorInfo</b> will not reflect the error from the statement handle. You must call <b>PDOStatement::errorInfo</b> to return the error information for an operation performed on a particular statement handle. /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"exec","fqn":"PDO::exec","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":48691,"end":48695}},"declared_type":null,"signature":{"parameters":[{"name":"statement","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.1.0)<br/> Execute an SQL statement and return the number of affected rows The SQL statement to prepare and execute. </p> <p> Data inside the query should be properly escaped. </p> or deleted by the SQL statement you issued. If no rows were affected, <b>PDO::exec</b> returns 0. </p> This function may return Boolean <b>FALSE</b>, but may also return a non-Boolean value which evaluates to <b>FALSE</b>. Please read the section on Booleans for more information. Use the === operator for testing the return value of this function. <p> The following example incorrectly relies on the return value of <b>PDO::exec</b>, wherein a statement that affected 0 rows results in a call to <b>die</b>: <code> $db->exec() or die(print_r($db->errorInfo(), true)); </code> /","params":[{"name":"statement","declared_type":"string","description":"<p>"}],"return_type":"int|false","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getAttribute","fqn":"PDO::getAttribute","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":57726,"end":57738}},"declared_type":null,"signature":{"parameters":[{"name":"attribute","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"(PHP 5 &gt;= 5.1.0, PHP 7, PECL pdo &gt;= 0.2.0)<br/> Retrieve a database connection attribute One of the PDO::ATTR_* constants. The constants that apply to database connections are as follows: PDO::ATTR_AUTOCOMMIT PDO::ATTR_CASE PDO::ATTR_CLIENT_VERSION PDO::ATTR_CONNECTION_STATUS PDO::ATTR_DRIVER_NAME PDO::ATTR_ERRMODE PDO::ATTR_ORACLE_NULLS PDO::ATTR_PERSISTENT PDO::ATTR_PREFETCH PDO::ATTR_SERVER_INFO PDO::ATTR_SERVER_VERSION PDO::ATTR_TIMEOUT </p> An unsuccessful call returns null. /","params":[{"name":"attribute","declared_type":"int","description":"<p>"}],"return_type":"mixed","var_type":null,"throws":["PDOException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getAvailableDrivers","fqn":"PDO::getAvailableDrivers","kind":"Method","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":59222,"end":59241}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"(PHP 5 &gt;= 5.1.3, PHP 7, PECL pdo &gt;= 1.0.3)<br/> Return an array of available PDO drivers no drivers are available, it returns an empty array. /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"inTransaction","fq