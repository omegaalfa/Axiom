ource","optional":false,"variadic":false,"by_reference":false},{"name":"result_type","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"decode_binary","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PHP 5, PECL sqlite &gt;= 1.0.0)<br/> Fetches the current row from a result set as an array current position is beyond the final row. /","params":[{"name":"result","declared_type":"resource","description":"<p>The SQLite result resource. This parameter is not required when using the object-oriented method.</p>"},{"name":"result_type","declared_type":"int","description":"[optional] <p>The optional result_type parameter accepts a constant and determines how the returned array will be indexed. Using <b>SQLITE_ASSOC</b> will return only associative indices (named fields) while <b>SQLITE_NUM</b> will return only numerical indices (ordinal field numbers). <b>SQLITE_BOTH</b> will return both associative and numerical indices. <b>SQLITE_BOTH</b> is the default for this function.</p>"},{"name":"decode_binary","declared_type":"bool","description":"[optional] <p>When the decode_binary parameter is set to <b>TRUE</b> (the default), PHP will decode the binary encoding it applied to the data if it was encoded using the sqlite_escape_string(). You should normally leave this value at its default, unless you are interoperating with databases created by other sqlite capable applications.</p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sqlite_error_string","fqn":"sqlite_error_string","kind":"Function","origin":"PhpRuntime","extension":"SQLite","location":{"file":"SQLite/SQLite.php","range":{"start":47440,"end":47459}},"declared_type":null,"signature":{"parameters":[{"name":"error_code","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"(PHP 5, PECL sqlite &gt;= 1.0.0)<br/> Returns the textual description of an error code The error code being used, which might be passed in from {@see sqlite_last_error}. </p> as a string. /","params":[{"name":"error_code","declared_type":"int","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sqlite_escape_string","fqn":"sqlite_escape_string","kind":"Function","origin":"PhpRuntime","extension":"SQLite","location":{"file":"SQLite/SQLite.php","range":{"start":45658,"end":45678}},"declared_type":null,"signature":{"parameters":[{"name":"item","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"(PHP 5, PECL sqlite &gt;= 1.0.0)<br/> Escapes a string for use as a query parameter The string being quoted. </p> <p> If the item contains a NUL character, or if it begins with a character whose ordinal value is 0x01, PHP will apply a binary encoding scheme so that you can safely store and retrieve binary data. </p> /","params":[{"name":"item","declared_type":"string","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sqlite_exec","fqn":"sqlite_exec","kind":"Function","origin":"PhpRuntime","extension":"SQLite","location":{"file":"SQLite/SQLite.php","range":{"start":30814,"end":30825}},"declared_type":null,"signature":{"parameters":[{"name":"dbhandle","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"error_msg","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, PECL sqlite &gt;= 1.0.3)<br/> Executes a result-less query against a given database The query to be executed. </p> <p> Data inside the query should be properly escaped. </p> The SQLite Database resource; returned from {@see sqlite_open()} when used procedurally. This parameter is not required when using the object-oriented method. </p> The specified variable will be filled if an error occurs. This is specially important because SQL syntax errors can't be fetched using the {@see sqlite_last_error} function. </p> If you need to run a query that returns rows, see sqlite_query.</p> /","params":[{"name":"query","declared_type":"string","description":"<p>"},{"name":"dbhandle","declared_type":"resource","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sqlite_factory","fqn":"sqlite_factory","kind":"Function","origin":"PhpRuntime","extension":"SQLite","location":{"file":"SQLite/SQLite.php","range":{"start":51269,"end":51283}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"error_message","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":null,"phpdoc_return_type":"SQLiteDatabase|null"},"documentation":{"description":"Opens a SQLite database and returns a SQLiteDatabase object The filename of the SQLite database. </p> The mode of the file. Intended to be used to open the database in read-only mode. Presently, this parameter is ignored by the sqlite library. The default value for mode is the octal value 0666 and this is the recommended value. </p> Passed by reference and is set to hold a descriptive error message explaining why the database could not be opened if there was an error. </p> /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"mode","declared_type":"int","description":"[optional] <p>"},{"name":"","declared_type":null,"description":null}],"return_type":"SQLiteDatabase|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sqlite_fetch_all","fqn":"sqlite_fetch_all","kind":"Function","origin":"PhpRuntime","extension":"SQLite","location":{"file":"SQLite/SQLite.php","range":{"start":36604,"end":36620}},"declared_type":null,"signature":{"parameters":[{"name":"result_type","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"decode_binary","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PHP 5, PECL sqlite &gt;= 1.0.0)<br/> Fetches all rows from a result set as an array of arrays after {@see sqlite_query}, it returns all rows. If called after {@see sqlite_fetch_array}, it returns the rest. If there are no rows in a result set, it returns an empty array.</p> <p>The column names returned by <b>SQLITE_ASSOC</b> and <b>SQLITE_BOTH</b> will be case-folded according to the value of the {@link https://php.net/manual/en/sqlite.configuration.php#ini.sqlite.assoc-case sqlite.assoc_case} configuration option.</p> /","params":[{"name":"result_type","declared_type":"int","description":"[optional]"},{"name":"decode_binary","declared_type":"bool","description":"[optional]"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since"