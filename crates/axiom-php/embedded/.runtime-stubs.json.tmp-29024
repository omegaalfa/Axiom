 an ordinary space. <li>\"\\t\" (ASCII 9 (0x09)), a tab. <li>\"\\n\" (ASCII 10 (0x0A)), a new line (line feed). <li>\"\\r\" (ASCII 13 (0x0D)), a carriage return. <li>\"\\0\" (ASCII 0 (0x00)), the NUL-byte. <li>\"\\x0B\" (ASCII 11 (0x0B)), a vertical tab. </ul> The input string. </p> You can also specify the characters you want to strip, by means of the charlist parameter. Simply list all characters that you want to be stripped. With .. you can specify a range of characters. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"characters","declared_type":"string","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"run","fqn":"run","kind":"Function","origin":"PhpRuntime","extension":"parallel","location":{"file":"parallel/parallel.php","range":{"start":1441,"end":1444}},"declared_type":null,"signature":{"parameters":[{"name":"task","declared_type":"Closure","phpdoc_type":"Closure","optional":false,"variadic":false,"by_reference":false},{"name":"argv","declared_type":"?array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"?Future","phpdoc_return_type":"Future|null"},"documentation":{"description":"### Automatic Scheduling --------------------------------------------------------------------------------------------------------------------- If a \\parallel\\Runtime internally created and cached by a previous call to parallel\\run() is idle, it will be used to execute the task. If no \\parallel\\Runtime is idle parallel will create and cache a \\parallel\\Runtime. Note: \\parallel\\Runtime objects created by the programmer are not used for automatic scheduling. /","params":[{"name":"task","declared_type":"Closure","description":null},{"name":"argv","declared_type":"array","description":null}],"return_type":"Future|null","var_type":null,"throws":["Runtime\\Error\\Closed","Runtime\\Error\\IllegalFunction","Runtime\\Error\\IllegalInstruction","Runtime\\Error\\IllegalParameter","Runtime\\Error\\IllegalReturn"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sapi_windows_cp_conv","fqn":"sapi_windows_cp_conv","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/basic.php","range":{"start":4958,"end":4978}},"declared_type":null,"signature":{"parameters":[{"name":"in_codepage","declared_type":"int|string","phpdoc_type":"int|string","optional":false,"variadic":false,"by_reference":false},{"name":"out_codepage","declared_type":"int|string","phpdoc_type":"int|string","optional":false,"variadic":false,"by_reference":false},{"name":"subject","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"?string","phpdoc_return_type":"string|null"},"documentation":{"description":"Convert string from one codepage to another /","params":[{"name":"in_codepage","declared_type":"int|string","description":"The codepage of the <i>subject</i> string. Either the codepage name or identifier."},{"name":"out_codepage","declared_type":"int|string","description":"The codepage to convert the <i>subject</i> string to. Either the codepage name or identifier."},{"name":"subject","declared_type":"string","description":"The string to convert."}],"return_type":"string|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sapi_windows_cp_get","fqn":"sapi_windows_cp_get","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/basic.php","range":{"start":4072,"end":4091}},"declared_type":null,"signature":{"parameters":[{"name":"kind","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Get process codepage If <i>kind</i> is 'ansi', the current ANSI code page of the operating system is returned. If <i>kind</i> is 'oem', the current OEM code page of the operating system is returned. Otherwise, the current codepage of the process is returned. </p> /","params":[{"name":"kind","declared_type":"string","description":"The kind of operating system codepage to get, either 'ansi' or 'oem'. Any other value refers to the current codepage of the process."}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sapi_windows_cp_is_utf8","fqn":"sapi_windows_cp_is_utf8","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/basic.php","range":{"start":5237,"end":5260}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Indicates whether the codepage is utf-8 compatible /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sapi_windows_cp_set","fqn":"sapi_windows_cp_set","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/basic.php","range":{"start":4361,"end":4380}},"declared_type":null,"signature":{"parameters":[{"name":"codepage","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set process codepage /","params":[{"name":"codepage","declared_type":"int","description":"A codepage identifier."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sapi_windows_generate_ctrl_event","fqn":"sapi_windows_generate_ctrl_event","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/basic.php","range":{"start":8702,"end":8734}},"declared_type":null,"signature":{"parameters":[{"name":"event","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"pid","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Send a CTRL event to another process. /","params":[{"name":"event","declared_type":"int","description":"The CTRL even to send; <b>either PHP_WINDOWS_EVENT_CTRL_C</b> or <b>PHP_WINDOWS_EVENT_CTRL_BREAK</b>."},{"name":"pid","declared_type":"int","description":"[optional] The ID of the process to which to send the event to. If 0 is given, the event is sent to all processes of the process group."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sapi_windows_set_ctrl_handler","fqn":"sapi_windows_set_ctrl_handler","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/basic.php","range":{"start":8119,"end":8148}},"declared_type":null,"signature":{"parameters":[{"name":"handler","declared_type":"?callable","phpdoc_type":"callable|null","optional":false,"variadic":false,"by_reference":false},{"name":"add","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set or remove a CTRL event handler, which allows Windows CLI processes to intercept or ignore CTRL+C and CTRL+BREAK events. Note that in multithreaded environments, this is only possible when called from the main thread. A callback function to set or remove. If set, this function will be called whenever a CTRL+C or CTRL+BREAK event occurs. </p> <p> The function is supposed to have the following signature: <code> handler(int $event): void </code> <code>event</code> The CTRL event which has been received; either <b>PHP_WINDOWS_EVENT_CTRL_C</b> or <b>PHP_WINDOWS_EVENT_CTRL_BREAK</b>. </p> <p> Setting a <b>null</b> handler causes the process to ignore CTRL+C events, but not CTRL+BREAK events. </p> /","params":[{"name":"handler","declared_type":"callable|null","description":"<p>"},{"name":"add","declared_type":"bool","description":"If <b>true</b>, the handler is set. If <b>false</b>, the handler is removed."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sapi_windows_vt100_support","fqn":"sapi_windows_vt100_support","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/basic.php","range":{"start":6989,"end":7015}},"declared_type":null,"signature":{"parameters":[{"name":"stream","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"enable","declared_type":"?bool","phpdoc_type":"bool|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Get or set VT100 support for the specified stream associated to an output buffer of a Windows console. At startup, PHP tries to enable the VT100 feature of the STDOUT/STDERR streams. By the way, if those streams are redirected to a file, the VT100 features may not be enabled. If VT100 support is enabled, it is possible to use control sequences as they are known from the VT100 terminal. They allow the modification of the terminal's output. On Windows these sequences are called Console Virtual Terminal Sequences. <b>Warning</b> This function uses the <b>ENABLE_VIRTUAL_TERMINAL_PROCESSING</b> flag implemented in the Windows 10 API, so the VT100 feature may not be available on older Windows versions. If bool, the VT100 feature will be enabled (if true) or disabled (if false). </p> <p> If <i>enable</i> is <b>null</b>, the function returns <b>true</b> if the stream <i>stream</i> has VT100 control codes enabled, <b>false</b> otherwise. </p> <p> If <i>enable</i> is a bool, the function will try to enable or disable the VT100 features of the stream <i>stream</i>. If the feature has been successfully enabled (or disabled), the function will return <b>true</b>, or <b>false</b> otherwise. </p> If <i>enable</i> is <b>null</b>: returns <b>true</b> if the VT100 feature is enabled, <b>false</b> otherwise. </p> <p> If <i>enable</i> is a bool: Returns <b>true</b> on success or <b>false</b> on failure. </p> /","params":[{"name":"stream","declared_type":"resource","description":"The stream on which the function will operate."},{"name":"enable","declared_type":"bool|null","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"scandir","fqn":"scandir","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7.php","range":{"start":13730,"end":13737}},"declared_type":null,"signature":{"parameters":[{"name":"directory","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"sorting_order","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"context","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"List files and directories inside the specified path The directory that will be scanned. </p> By default, the sorted order is alphabetical in ascending order. If the optional sorting_order is set to non-zero, then the sort order is alphabetical in descending order. </p> For a description of the context parameter, refer to the streams section of the manual. </p> failure. If directory is not a directory, then boolean false is returned, and an error of level E_WARNING is generated. /","params":[{"name":"directory","declared_type":"string","description":"<p>"},{"name":"sorting_order","declared_type":"int","description":"<p>"},{"name":"context","declared_type":"resource","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sem_acquire","fqn":"sem_acquire","kind":"Function","origin":"PhpRuntime","extension":"sysvsem","location":{"file":"sysvsem/sysvsem.php","range":{"start":1548,"end":1559}},"declared_type":null,"signature":{"parameters":[{"name":"semaphore","declared_type":null,"phpdoc_type":"SysvSemaphore|resource","optional":false,"variadic":false,"by_reference":false},{"name":"non_blocking","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Acquire a semaphore <i>sem_identifier</i> is a semaphore resource, obtained from <b>sem_get</b>. </p> Specifies if the process shouldn't wait for the semaphore to be acquired. If set to <i>true</i>, the call will return <i>false</i> immediately if a semaphore cannot be immediately acquired. </p> /","params":[{"name":"semaphore","declared_type":"SysvSemaphore|resource","description":"<p>"},{"name":"non_blocking","declared_type":"bool","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sem_get","fqn":"sem_get","kind":"Function","origin":"PhpRuntime","extension":"sysvsem","location":{"file":"sysvsem/sysvsem.php","range":{"start":895,"end":902}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"max_acquire","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"permissions","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"auto_release","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false|SysvSemaphore"},"documentation":{"description":"Get a semaphore id The number of processes that can acquire the semaphore simultaneously is set to <i>max_acquire</i>. </p> The semaphore permissions. Actually this value is set only if the process finds it is the only process currently attached to the semaphore. </p> Specifies if the semaphore should be automatically released on request shutdown. </p> error. /","params":[{"name":"key","declared_type":"int","description":null},{"name":"max_acquire","declared_type":"int","description":"[optional] <p>"},{"name":"permissions","declared_type":"int","description":"[optional] <p>"},{"name":"auto_release","declared_type":"bool","description":"[optional] <p>"}],"return_type":"resource|false|SysvSemaphore","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sem_release","fqn":"sem_release","kind":"Function","origin":"PhpRuntime","extension":"sysvsem","location":{"file":"sysvsem/sysvsem.php","range":{"start":1973,"end":1984}},"declared_type":null,"signature":{"parameters":[{"name":"semaphore","declared_type":null,"phpdoc_type":"SysvSemaphore|resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Release a semaphore A Semaphore resource handle as returned by <b>sem_get</b>. </p> /","params":[{"name":"semaphore","declared_type":"SysvSemaphore|resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sem_remove","fqn":"sem_remove","kind":"Function","origin":"PhpRuntime","extension":"sysvsem","location":{"file":"sysvsem/sysvsem.php","range":{"start":2372,"end":2382}},"declared_type":null,"signature":{"parameters":[{"name":"semaphore","declared_type":null,"phpdoc_type":"SysvSemaphore|resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Remove a semaphore A semaphore resource identifier as returned by <b>sem_get</b>. </p> /","params":[{"name":"semaphore","declared_type":"SysvSemaphore|resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"serialize","fqn":"serialize","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":4910,"end":4919}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Generates a storable representation of a value The value to be serialized. serialize handles all types, except the resource-type. You can even serialize arrays that contain references to itself. Circular references inside the array/object you are serializing will also be stored. Any other reference will be lost. </p> <p> When serializing objects, PHP will attempt to call the member function __sleep prior to serialization. This is to allow the object to do any last minute clean-up, etc. prior to being serialized. Likewise, when the object is restored using unserialize the __wakeup member function is called. </p> <p> Object's private members have the class name prepended to the member name; protected members have a '*' prepended to the member name. These prepended values have null bytes on either side. </p> value that can be stored anywhere. /","params":[{"name":"value","declared_type":"mixed","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_abort","fqn":"session_abort","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":17972,"end":17985}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void|bool"},"documentation":{"description":"(PHP 5 >= 5.6.0)<br> Discard session array changes and finish session /","params":[],"return_type":"void|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_cache_expire","fqn":"session_cache_expire","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":13876,"end":13896}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":null,"phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"Return current cache expire If <i>new_cache_expire</i> is given, the current cache expire is replaced with <i>new_cache_expire</i>. </p> <p> Setting <i>new_cache_expire</i> is of value only, if session.cache_limiter is set to a value different from nocache. </p> The value returned should be read in minutes, defaults to 180. /","params":[{"name":"value","declared_type":"int|null","description":"[optional] <p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_cache_limiter","fqn":"session_cache_limiter","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":13149,"end":13170}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":null,"phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Get and/or set the current cache limiter If <i>cache_limiter</i> is specified, the name of the current cache limiter is changed to the new value. </p> <table> Possible values <tr valign=\"top\"> <td>Value</td> <td>Headers sent</td> </tr> <tr valign=\"top\"> <td>public</td> <td> <pre> Expires: (sometime in the future, according session.cache_expire) Cache-Control: public, max-age=(sometime in the future, according to session.cache_expire) Last-Modified: (the timestamp of when the session was last saved) </pre> </td> </tr> <tr valign=\"top\"> <td>private_no_expire</td> <td> <pre> Cache-Control: private, max-age=(session.cache_expire in the future), pre-check=(session.cache_expire in the future) Last-Modified: (the timestamp of when the session was last saved) </pre> </td> </tr> <tr valign=\"top\"> <td>private</td> <td> <pre> Expires: Thu, 19 Nov 1981 08:52:00 GMT Cache-Control: private, max-age=(session.cache_expire in the future), pre-check=(session.cache_expire in the future) Last-Modified: (the timestamp of when the session was last saved) </pre> </td> </tr> <tr valign=\"top\"> <td>nocache</td> <td> <pre> Expires: Thu, 19 Nov 1981 08:52:00 GMT Cache-Control: no-store, no-cache, must-revalidate, post-check=0, pre-check=0 Pragma: no-cache </pre> </td> </tr> </table> /","params":[{"name":"value","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_commit","fqn":"session_commit","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":17219,"end":17233}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void|bool"},"documentation":{"description":"Alias of <b>session_write_close</b> /","params":[],"return_type":"void|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_create_id","fqn":"session_create_id","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":7578,"end":7595}},"declared_type":null,"signature":{"parameters":[{"name":"prefix","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Create new session id Not all characters are allowed within the session id. Characters in the range a-z A-Z 0-9 , (comma) and - (minus) are allowed. If it is used without active session, it omits collision check. /","params":[{"name":"prefix","declared_type":"string","description":"[optional] If prefix is specified, new session id is prefixed by prefix."}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_decode","fqn":"session_decode","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":4613,"end":4627}},"declared_type":null,"signature":{"parameters":[{"name":"data","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Decodes session data from a string The encoded data to be stored. </p> /","params":[{"name":"data","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_destroy","fqn":"session_destroy","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":8100,"end":8115}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Destroys all data registered to a session /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_encode","fqn":"session_encode","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":6193,"end":6207}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Encodes the current session data as a string /","params":[],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_gc","fqn":"session_gc","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":7904,"end":7914}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"Perform session data garbage collection /","params":[],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_get_cookie_params","fqn":"session_get_cookie_params","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":16632,"end":16657}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Get the session cookie parameters contains the following items: \"lifetime\" - The lifetime of the cookie in seconds. \"path\" - The path where information is stored. \"domain\" - The domain of the cookie. \"secure\" - The cookie should only be sent over secure connections. \"httponly\" - The cookie can only be accessed through the HTTP protocol. /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_id","fqn":"session_id","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":3695,"end":3705}},"declared_type":null,"signature":{"parameters":[{"name":"id","declared_type":null,"phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Get and/or set the current session id If <i>id</i> is specified, it will replace the current session id. <b>session_id</b> needs to be called before <b>session_start</b> for that purpose. Depending on the session handler, not all characters are allowed within the session id. For example, the file session handler only allows characters in the range a-z A-Z 0-9 , (comma) and - (minus)! </p> When using session cookies, specifying an <i>id</i> for <b>session_id</b> will always send a new cookie when <b>session_start</b> is called, regardless if the current session id is identical to the one being set. session or the empty string (\"\") if there is no current session (no current session id exists). /","params":[{"name":"id","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_is_registered","fqn":"session_is_registered","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":5878,"end":5899}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Find out whether a global variable is registered in a session The variable name. </p> global variable with the name <i>name</i> registered in the current session, false otherwise. /","params":[{"name":"name","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_module_name","fqn":"session_module_name","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":1713,"end":1732}},"declared_type":null,"signature":{"parameters":[{"name":"module","declared_type":null,"phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Get and/or set the current session module.<br/> Since 7.2.0 it is forbidden to set the module name to \"user\". If <i>module</i> is specified, that module will be used instead. </p> /","params":[{"name":"module","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_name","fqn":"session_name","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":1150,"end":1162}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Get and/or set the current session name.<br/> Before 7.2.0 checked cookie status and since 7.2.0 checks both cookie and session status to avoid PHP crash. The session name references the name of the session, which is used in cookies and URLs (e.g. PHPSESSID). It should contain only alphanumeric characters; it should be short and descriptive (i.e. for users with enabled cookie warnings). If <i>name</i> is specified, the name of the current session is changed to its value. </p> <p> <p> The session name can't consist of digits only, at least one letter must be present. Otherwise a new session id is generated every time. </p> </p> /","params":[{"name":"name","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_regenerate_id","fqn":"session_regenerate_id","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":4112,"end":4133}},"declared_type":null,"signature":{"parameters":[{"name":"delete_old_session","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Update the current session id with a newly generated one Whether to delete the old associated session file or not. </p> /","params":[{"name":"delete_old_session","declared_type":"bool","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_register","fqn":"session_register","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":5068,"end":5084}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"_","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Register one or more global variables with the current session A string holding the name of a variable or an array consisting of variable names or other arrays. </p> /","params":[{"name":"name","declared_type":"mixed","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_register_shutdown","fqn":"session_register_shutdown","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":4335,"end":4360}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"PHP > 5.4.0 <br/> Session shutdown function /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_reset","fqn":"session_reset","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":18334,"end":18347}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void|bool"},"documentation":{"description":"(PHP 5 >= 5.6.0)<br> Re-initialize session array with original values /","params":[],"return_type":"void|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_save_path","fqn":"session_save_path","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":2575,"end":2592}},"declared_type":null,"signature":{"parameters":[{"name":"path","declared_type":null,"phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Get and/or set the current session save path Session data path. If specified, the path to which data is saved will be changed. <b>session_save_path</b> needs to be called before <b>session_start</b> for that purpose. </p> <p> <p> On some operating systems, you may want to specify a path on a filesystem that handles lots of small files efficiently. For example, on Linux, reiserfs may provide better performance than ext2fs. </p> </p> /","params":[{"name":"path","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_set_cookie_params","fqn":"session_set_cookie_params","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":14714,"end":14739}},"declared_type":null,"signature":{"parameters":[{"name":"lifetime_or_options","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set the session cookie parameters An associative array which may have any of the keys lifetime, path, domain, secure, httponly and samesite. The values have the same meaning as described for the parameters with the same name. The value of the samesite element should be either Lax or Strict. If any of the allowed options are not given, their default values are the same as the default values of the explicit parameters. If the samesite element is omitted, no SameSite cookie attribute is set. </p> /","params":[{"name":"lifetime_or_options","declared_type":"array","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_set_save_handler","fqn":"session_set_save_handler","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":10512,"end":10536}},"declared_type":null,"signature":{"parameters":[{"name":"open","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"close","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"read","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"write","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"destroy","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"gc","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"create_sid","declared_type":"?callable","phpdoc_type":"callable|null","optional":true,"variadic":false,"by_reference":false},{"name":"validate_sid","declared_type":"?callable","phpdoc_type":"callable|null","optional":true,"variadic":false,"by_reference":false},{"name":"update_timestamp","declared_type":"?callable","phpdoc_type":"callable|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Sets user-level session storage functions Open function, this works like a constructor in classes and is executed when the session is being opened. The open function expects two parameters, where the first is the save path and the second is the session name. </p> Close function, this works like a destructor in classes and is executed when the session operation is done. </p> Read function must return string value always to make save handler work as expected. Return empty string if there is no data to read. Return values from other handlers are converted to boolean expression. true for success, false for failure. </p> Write function that is called when session data is to be saved. This function expects two parameters: an identifier and the data associated with it. </p> <p> The \"write\" handler is not executed until after the output stream is closed. Thus, output from debugging statements in the \"write\" handler will never be seen in the browser. If debugging output is necessary, it is suggested that the debug output be written to a file instead. </p> The destroy handler, this is executed when a session is destroyed with <b>session_destroy</b> and takes the session id as its only parameter. </p> The garbage collector, this is executed when the session garbage collector is executed and takes the max session lifetime as its only parameter. </p> <p>This callback is executed when a new session ID is required. No parameters are provided, and the return value should be a string that is a valid session ID for your handler.</p> /","params":[{"name":"open","declared_type":"callable","description":"<p>"},{"name":"close","declared_type":"callable","description":"<p>"},{"name":"read","declared_type":"callable","description":"<p>"},{"name":"write","declared_type":"callable","description":"<p>"},{"name":"destroy","declared_type":"callable","description":"<p>"},{"name":"gc","declared_type":"callable","description":"<p>"},{"name":"create_sid","declared_type":"callable|null","description":"[optional]"},{"name":"validate_sid","declared_type":"callable|null","description":"[optional]"},{"name":"update_timestamp","declared_type":"callable|null","description":"[optional]"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_start","fqn":"session_start","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":6912,"end":6925}},"declared_type":null,"signature":{"parameters":[{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Initialize session data In addition to the normal set of configuration directives, a read_and_close option may also be provided. If set to TRUE, this will result in the session being closed immediately after being read, thereby avoiding unnecessary locking if the session data won't be changed.</p> otherwise false. /","params":[{"name":"options","declared_type":"array","description":"[optional] <p>If provided, this is an associative array of options that will override the currently set session configuration directives. The keys should not include the session. prefix."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_status","fqn":"session_status","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":17604,"end":17618}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"(PHP 5 >= 5.4.0)<br> Returns the current session status <b>PHP_SESSION_NONE</b> if sessions are enabled, but none exists. <b>PHP_SESSION_ACTIVE</b> if sessions are enabled, and one exists. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_unregister","fqn":"session_unregister","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":5410,"end":5428}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Unregister a global variable from the current session The variable name. </p> /","params":[{"name":"name","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_unset","fqn":"session_unset","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":8377,"end":8390}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void|bool"},"documentation":{"description":"Free all session variables /","params":[],"return_type":"void|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"session_write_close","fqn":"session_write_close","kind":"Function","origin":"PhpRuntime","extension":"session","location":{"file":"session/session.php","range":{"start":16934,"end":16953}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void|bool"},"documentation":{"description":"Write session data and end session /","params":[],"return_type":"void|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set_error_handler","fqn":"set_error_handler","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":22666,"end":22683}},"declared_type":null,"signature":{"parameters":[{"name":"callback","declared_type":"?callable","phpdoc_type":"callable|null","optional":false,"variadic":false,"by_reference":false},{"name":"error_levels","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"callable|null"},"documentation":{"description":"Sets a user-defined error handler function The user function needs to accept two parameters: the error code, and a string describing the error. Then there are three optional parameters that may be supplied: the filename in which the error occurred, the line number in which the error occurred, and the context in which the error occurred (an array that points to the active symbol table at the point the error occurred). The function can be shown as: </p> <p> <b>handler</b> <b>int<i>errno</i></b> <b>string<i>errstr</i></b> <b>string<i>errfile</i></b> <b>int<i>errline</i></b> <b>array<i>errcontext</i></b> <i>errno</i> The first parameter, <i>errno</i>, contains the level of the error raised, as an integer.</p> The user function should stop execution if necessary by calling `exit()`. If the function returns a value other than false, script execution will continue with the next statement after the one that caused an error. If the function returns false, the standard PHP error handler is called. Can be used to mask the triggering of the <i>error_handler</i> function just like the error_reporting ini setting controls which errors are shown. Without this mask set the <i>error_handler</i> will be called for every error regardless to the setting of the error_reporting setting. </p> the built-in error handler is used null is returned. null is also returned in case of an error such as an invalid callback. If the previous error handler was a class method, this function will return an indexed array with the class and the method name. Note that error_handler chaining is possible by passing the output value as a reference: ``` $previousErrorHandler = set_error_handler( static function (int $errNo, string $errstr, string $errFile, int $errLine) use (&$previousErrorHandler): bool { // Handle specific scenarios return $previousErrorHandler !== null ? (bool) $previousErrorHandler(...func_get_args()) : false; } ); ``` /","params":[{"name":"callback","declared_type":"callable|null","description":"<p>"},{"name":"error_levels","declared_type":"int","description":"[optional] <p>"}],"return_type":"callable|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set_exception_handler","fqn":"set_exception_handler","kind":"Function","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core.php","range":{"start":23933,"end":23954}},"declared_type":null,"signature":{"parameters":[{"name":"callback","declared_type":"?callable","phpdoc_type":"callable|null","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"callable|null"},"documentation":{"description":"Sets a user-defined exception handler function Name of the function to be called when an uncaught exception occurs. This function must be defined before calling <b>set_exception_handler</b>. This handler function needs to accept one parameter, which will be the exception object that was thrown. NULL may be passed instead, to reset this handler to its default state. </p> no previous handler was defined, null is also returned. /","params":[{"name":"callback","declared_type":"callable|null","description":"<p>"}],"return_type":"callable|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set_file_buffer","fqn":"set_file_buffer","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_6.php","range":{"start":27985,"end":28000}},"declared_type":null,"signature":{"parameters":[{"name":"stream","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"size","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Alias: {@see stream_set_write_buffer} <p>Sets the buffering for write operations on the given stream to buffer bytes. Output using fwrite() is normally buffered at 8K. This means that if there are two processes wanting to write to the same output stream (a file), each is paused after 8K of data to allow the other to write. </p> This ensures that all writes with fwrite() are completed before other processes are allowed to write to that output stream. /","params":[{"name":"stream","declared_type":"resource","description":"The file pointer."},{"name":"size","declared_type":"int","description":"The number of bytes to buffer. If buffer is 0 then write operations are unbuffered."}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set_include_path","fqn":"set_include_path","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":19000,"end":19016}},"declared_type":null,"signature":{"parameters":[{"name":"include_path","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Sets the include_path configuration option The new value for the include_path </p> success or false on failure. /","params":[{"name":"include_path","declared_type":"string","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set_job_failed","fqn":"set_job_failed","kind":"Function","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend_f.php","range":{"start":237,"end":251}},"declared_type":null,"signature":{"parameters":[{"name":"error_string","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"causes a job to fail logically can be used to indicate an error in the script logic (e.g. database connection problem) /","params":[{"name":"error_string","declared_type":"string","description":"the error string to display"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set_magic_quotes_runtime","fqn":"set_magic_quotes_runtime","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":27610,"end":27634}},"declared_type":null,"signature":{"parameters":[{"name":"new_setting","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Sets the current active configuration setting of magic_quotes_runtime false for off, true for on. </p> /","params":[{"name":"new_setting","declared_type":"bool","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set_socket_blocking","fqn":"set_socket_blocking","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_6.php","range":{"start":28917,"end":28936}},"declared_type":null,"signature":{"parameters":[{"name":"socket","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Alias: {@see stream_set_blocking} <p>Sets blocking or non-blocking mode on a stream. This function works for any stream that supports non-blocking mode (currently, regular files and socket streams) </p> This affects calls like fgets() and fread() that read from the stream. In non-blocking mode an fgets() call will always return right away while in blocking mode it will wait for data to become available on the stream. /","params":[{"name":"socket","declared_type":"resource","description":null},{"name":"mode","declared_type":"bool","description":"If mode is FALSE, the given stream will be switched to non-blocking mode, and if TRUE, it will be switched to blocking mode."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set_time_limit","fqn":"set_time_limit","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_3.php","range":{"start":26517,"end":26531}},"declared_type":null,"signature":{"parameters":[{"name":"seconds","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Limits the maximum execution time The maximum execution time, in seconds. If set to zero, no time limit is imposed. </p> /","params":[{"name":"seconds","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setcookie","fqn":"setcookie","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":22597,"end":22606}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"expires_or_options","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"path","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"domain","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"secure","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"httponly","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Send a cookie The name of the cookie. </p> The value of the cookie. This value is stored on the clients computer; do not store sensitive information. Assuming the name is 'cookiename', this value is retrieved through $_COOKIE['cookiename'] </p> The time the cookie expires. This is a Unix timestamp so is in number of seconds since the epoch. In other words, you'll most likely set this with the time function plus the number of seconds before you want it to expire. Or you might use mktime. time()+60*60*24*30 will set the cookie to expire in 30 days. If set to 0, or omitted, the cookie will expire at the end of the session (when the browser closes). </p> <p> <p> You may notice the expire parameter takes on a Unix timestamp, as opposed to the date format Wdy, DD-Mon-YYYY HH:MM:SS GMT, this is because PHP does this conversion internally. </p> <p> expire is compared to the client's time which can differ from server's time. </p> </p> The path on the server in which the cookie will be available on. If set to '/', the cookie will be available within the entire domain. If set to '/foo/', the cookie will only be available within the /foo/ directory and all sub-directories such as /foo/bar/ of domain. The default value is the current directory that the cookie is being set in. </p> The domain that the cookie is available. To make the cookie available on all subdomains of example.com then you'd set it to '.example.com'. The . is not required but makes it compatible with more browsers. Setting it to www.example.com will make the cookie only available in the www subdomain. Refer to tail matching in the spec for details. </p> Indicates that the cookie should only be transmitted over a secure HTTPS connection from the client. When set to true, the cookie will only be set if a secure connection exists. On the server-side, it's on the programmer to send this kind of cookie only on secure connection (e.g. with respect to $_SERVER[\"HTTPS\"]). </p> When true the cookie will be made accessible only through the HTTP protocol. This means that the cookie won't be accessible by scripting languages, such as JavaScript. This setting can effectively help to reduce identity theft through XSS attacks (although it is not supported by all browsers). Added in PHP 5.2.0. true or false </p> setcookie will fail and return false. If setcookie successfully runs, it will return true. This does not indicate whether the user accepted the cookie. Example: <code> $value = 'something from somewhere'; setcookie(\"TestCookie\", $value); setcookie(\"TestCookie\", $value, time()+3600); setcookie(\"TestCookie\", $value, time()+3600, \"/~rasmus/\", \"example.com\", true); </code> /","params":[{"name":"name","declared_type":"string","description":"<p>"},{"name":"value","declared_type":"string","description":"[optional] <p>"},{"name":"expires_or_options","declared_type":"int","description":"[optional] <p>"},{"name":"path","declared_type":"string","description":"[optional] <p>"},{"name":"domain","declared_type":"string","description":"[optional] <p>"},{"name":"secure","declared_type":"bool","description":"[optional] <p>"},{"name":"httponly","declared_type":"bool","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setlocale","fqn":"setlocale","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_1.php","range":{"start":37498,"end":37507}},"declared_type":null,"signature":{"parameters":[{"name":"category","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"locales","declared_type":null,"phpdoc_type":"string|string[]|int","optional":false,"variadic":false,"by_reference":false},{"name":"rest","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"rest","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Set locale information <em>category</em> is a named constant specifying the category of the functions affected by the locale setting: </p><ul> <li> <b>LC_ALL</b> for all of the below </li> <li> <b>LC_COLLATE</b> for string comparison, see {@see strcoll()} </li> <li> <b>LC_CTYPE</b> for character classification and conversion, for example {@see strtoupper()} </li> <li> <b>LC_MONETARY</b> for {@see localeconv()} </li> <li> <b>LC_NUMERIC</b> for decimal separator (See also {@see localeconv()}) </li> <li> <b>LC_TIME</b> for date and time formatting with {@see strftime()} </li> <li> <b>LC_MESSAGES</B> for system responses (available if PHP was compiled with <em>libintl</em>) </li> </ul> If locale is null or the empty string \"\", the locale names will be set from the values of environment variables with the same names as the above categories, or from \"LANG\". </p> <p> If locale is \"0\", the locale setting is not affected, only the current setting is returned. </p> <p> If locale is an array or followed by additional parameters then each array element or parameter is tried to be set as new locale until success. This is useful if a locale is known under different names on different systems or for providing a fallback for a possibly not available locale. </p> not implemented on your platform, the specified locale does not exist or the category name is invalid. </p> <p> An invalid category name also causes a warning message. Category/locale names can be found in RFC 1766 and ISO 639. Different systems have different naming schemes for locales. </p> <p> The return value of setlocale depends on the system that PHP is running. It returns exactly what the system setlocale function returns.</p> /","params":[{"name":"category","declared_type":"int","description":"<p>"},{"name":"locales","declared_type":"string|string[]|int","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setrawcookie","fqn":"setrawcookie","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":25053,"end":25065}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"expires_or_options","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"path","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"domain","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"secure","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"httponly","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Send a cookie without urlencoding the cookie value /","params":[{"name":"name","declared_type":"string","description":null},{"name":"value","declared_type":"string","description":"[optional]"},{"name":"expires_or_options","declared_type":"int","description":"[optional]"},{"name":"path","declared_type":"string","description":"[optional]"},{"name":"domain","declared_type":"string","description":"[optional]"},{"name":"secure","declared_type":"bool","description":"[optional]"},{"name":"httponly","declared_type":"bool","description":"[optional]"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"settype","fqn":"settype","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_5.php","range":{"start":4279,"end":4286}},"declared_type":null,"signature":{"parameters":[{"name":"var","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"type","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set the type of a variable The variable being converted. </p> Possibles values of <b>type</b> are: </p><ul> <li> \"boolean\" (or, since PHP 4.2.0, \"bool\") </li> <li> \"integer\" (or, since PHP 4.2.0, \"int\") </li> <li> \"float\" (only possible since PHP 4.2.0, for older versions use the deprecated variant \"double\") </li> <li> \"string\" </li> <li> \"array\" </li> <li> \"object\" </li> <li> \"null\" (since PHP 4.2.0) </li> </ul> 8.0.0. Prior to PHP 8.0.0, a E_WARNING was emitted and false was returned. /","params":[{"name":"","declared_type":null,"description":null},{"name":"type","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sha1","fqn":"sha1","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":24764,"end":24768}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"binary","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Calculate the sha1 hash of a string The input string. </p> If the optional binary is set to true, then the sha1 digest is instead returned in raw binary format with a length of 20, otherwise the returned value is a 40-character hexadecimal number. </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"},{"name":"binary","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sha1_file","fqn":"sha1_file","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_0.php","range":{"start":25186,"end":25195}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"binary","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Calculate the sha1 hash of a file The filename </p> When true, returns the digest in raw binary format with a length of 20. </p> /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"binary","declared_type":"bool","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"shell_exec","fqn":"shell_exec","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_2.php","range":{"start":28908,"end":28918}},"declared_type":null,"signature":{"parameters":[{"name":"command","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false|null","phpdoc_return_type":"string|false|null"},"documentation":{"description":"Execute command via shell and return the complete output as a string The command that will be executed. </p> /","params":[{"name":"command","declared_type":"string","description":"<p>"}],"return_type":"string|false|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"shm_attach","fqn":"shm_attach","kind":"Function","origin":"PhpRuntime","extension":"sysvshm","location":{"file":"sysvshm/sysvshm.php","range":{"start":713,"end":723}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"size","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false},{"name":"permissions","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|SysvSharedMemory|false"},"documentation":{"description":"Creates or open a shared memory segment A numeric shared memory segment ID </p> The memory size. If not provided, default to the sysvshm.init_mem in the <i>php.ini</i>, otherwise 10000 bytes. </p> The optional permission bits. Default to 0666. </p> /","params":[{"name":"key","declared_type":"int","description":"<p>"},{"name":"size","declared_type":"int|null","description":"[optional] <p>"},{"name":"permissions","declared_type":"int","description":"[optional] <p>"}],"return_type":"resource|SysvSharedMemory|false","var_type":null,"throws":[],"deprecated":null},"availability":{"sinc