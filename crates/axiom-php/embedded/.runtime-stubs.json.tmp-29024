":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"key","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"HashContext|resource"},"documentation":{"description":"(PHP 5 &gt;= 5.1.2, PECL hash &gt;= 1.1)<br/> Initialize an incremental hashing context Name of selected hashing algorithm (i.e. \"md5\", \"sha256\", \"haval160,4\", etc..). For a list of supported algorithms see <b>hash_algos</b>.<br/> Since 7.2.0 usage of non-cryptographic hash functions (adler32, crc32, crc32b, fnv132, fnv1a32, fnv164, fnv1a64, joaat) was disabled. </p> Optional settings for hash generation, currently supports only one option: <b>HASH_HMAC</b>. When specified, the <i>key</i> must be specified. </p> When <b>HASH_HMAC</b> is specified for <i>options</i>, a shared secret key to be used with the HMAC hashing method must be supplied in this parameter. </p> \"seed\" parameter is supported by the MurmurHash variants. <b>hash_update_stream</b>, <b>hash_update_file</b>, and <b>hash_final</b>. hash function, or if key is empty. Passing configurations options of the wrong type in options will now emit an E_DEPRECATED error because they can be interpreted incorrectly. This will become a ValueError in the future. /","params":[{"name":"algo","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"},{"name":"key","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"array","description":"An array of options for the various hashing algorithms. Currently, only the"}],"return_type":"HashContext|resource","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hash_pbkdf2","fqn":"hash_pbkdf2","kind":"Function","origin":"PhpRuntime","extension":"hash","location":{"file":"hash/hash.php","range":{"start":14540,"end":14551}},"declared_type":null,"signature":{"parameters":[{"name":"algo","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"password","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"salt","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"iterations","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"binary","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Generate a PBKDF2 key derivation of a supplied password Name of selected hashing algorithm (i.e. \"md5\", \"sha256\", \"haval160,4\", etc..) See <b>hash_algos</b> for a list of supported algorithms.<br/> Since 7.2.0 usage of non-cryptographic hash functions (adler32, crc32, crc32b, fnv132, fnv1a32, fnv164, fnv1a64, joaat) was disabled. </p> The password to use for the derivation. </p> The salt to use for the derivation. This value should be generated randomly. </p> The number of internal iterations to perform for the derivation. </p> The length of the output string. If binary is TRUE this corresponds to the byte-length of the derived key, if binary is FALSE this corresponds to twice the byte-length of the derived key (as every byte of the key is returned as two hexits). <br/> If 0 is passed, the entire output of the supplied algorithm is used. </p> When set to TRUE, outputs raw binary data. FALSE outputs lowercase hexits. </p> Additional options. This parameter was added for PHP 8.1 only. </p> <i>binary</i> is set to <b>TRUE</b> in which case the raw binary representation of the derived key is returned. parameter is less than or equal to 0, the length is less than 0 or the salt is too long (greater than INT_MAX - 4). /","params":[{"name":"algo","declared_type":"string","description":"<p>"},{"name":"password","declared_type":"string","description":"<p>"},{"name":"salt","declared_type":"string","description":"<p>"},{"name":"iterations","declared_type":"int","description":"<p>"},{"name":"length","declared_type":"int","description":"[optional] <p>"},{"name":"binary","declared_type":"bool","description":"[optional] <p>"},{"name":"options","declared_type":"array","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"hash_update","fqn":"hash_update","kind":"Function","origin":"PhpRuntime","extension":"hash","location":{"file":"hash/hash.php","range":{"start":7577,"end":7588}},"declared_type":null,"signature":{"parameters":[{"name":"context","declared_type":null,"phpdoc_type":"HashContext|resource","optional":false,"variadic":false,"by_reference":false},{"name":"data","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5 &gt;= 5.1.2, PECL hash &gt;= 1.1)<br/> Pump data into an active hashing context Hashing context returned by {@see hash_init}. </p> Message to be included in the hash digest. </p> /","params":[{"name":"context","declared_type":"HashContext|resource","description":"<p>"},{"name":"data","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"de