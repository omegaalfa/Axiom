lied in a single morphology or filter function. Returns the new combined kernel. /","params":[{"name":"imagickKernel","declared_type":"ImagickKernel","description":null}],"return_type":"void","var_type":null,"throws":["ImagickKernelException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"addUnityKernel","fqn":"ImagickKernel::addUnityKernel","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":257158,"end":257172}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Adds a given amount of the 'Unity' Convolution Kernel to the given pre-scaled and normalized Kernel. This in effect adds that amount of the original image into the resulting convolution kernel. The resulting effect is to convert the defined kernels into blended soft-blurs, unsharp kernels or into sharpening kernels. /","params":[],"return_type":"void","var_type":null,"throws":["ImagickKernelException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fromBuiltin","fqn":"ImagickKernel::fromBuiltin","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":257783,"end":257794}},"declared_type":null,"signature":{"parameters":[{"name":"kernelType","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"kernelString","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ImagickKernel"},"documentation":{"description":"Create a kernel from a builtin in kernel. See https://www.imagemagick.org/Usage/morphology/#kernel for examples.<br> Currently the 'rotation' symbols are not supported. Example: $diamondKernel = ImagickKernel::fromBuiltIn(\\Imagick::KERNEL_DIAMOND, \"2\"); /","params":[{"name":"kernelType","declared_type":"int","description":"The type of kernel to build e.g. \\Imagick::KERNEL_DIAMOND"},{"name":"kernelString","declared_type":"string","description":"A string that describes the parameters e.g. \"4,2.5\""}],"return_type":"ImagickKernel","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"fromMatrix","fqn":"ImagickKernel::fromMatrix","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":258787,"end":258797}},"declared_type":null,"signature":{"parameters":[{"name":"matrix","declared_type":null,"phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"origin","declared_type":null,"phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"ImagickKernel"},"documentation":{"description":"Create a kernel from a builtin in kernel. See https://www.imagemagick.org/Usage/morphology/#kernel for examples.<br> Currently the 'rotation' symbols are not supported. Example: $diamondKernel = ImagickKernel::fromBuiltIn(\\Imagick::KERNEL_DIAMOND, \"2\"); /","params":[{"name":"matrix","declared_type":"array","description":"A matrix (i.e. 2d array) of values that define the kernel. Each element should be either a float value, or FALSE if that element shouldn't be used by the kernel."},{"name":"origin","declared_type":"array","description":"[optional] Which element of the kernel should be used as the origin pixel. e.g. For a 3x3 matrix specifying the origin as [2, 2] would specify that the bottom right element should be the origin pixel."}],"return_type":"ImagickKernel","var_type":null,"throws":["ImagickKernelException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"getMatrix","fqn":"ImagickKernel::getMatrix","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"fi