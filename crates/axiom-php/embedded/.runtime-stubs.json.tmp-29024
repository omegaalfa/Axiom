PHP binary. To use the calling script&#x00027;s working directory, use <b>realpath</b> or dirname(__FILE__). If a local file path has only backslashes and no forward slashes, this extension will fail to find the path. Always replace all backslashes with forward slashes when using this function. First path's revision number. Use <b>SVN_REVISION_HEAD</b> to specify the most recent revision. </p> Second path to diff. See <i>path1</i> for description. </p> Second path's revision number. See <i>rev1</i> for description. </p> and the second contains error stream output. The streams can be read using <b>fread</b>. Returns <b>FALSE</b> or <b>NULL</b> on error. </p> <p> The diff output will, by default, be in the form of Subversion's custom unified diff format, but an external diff engine may be used depending on Subversion's configuration. /","params":[{"name":"path1","declared_type":"string","description":"<p>"},{"name":"rev1","declared_type":"int","description":"<p>"},{"name":"path2","declared_type":"string","description":"<p>"},{"name":"rev2","declared_type":"int","description":"<p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"svn_export","fqn":"svn_export","kind":"Function","origin":"PhpRuntime","extension":"svn","location":{"file":"svn/svn.php","range":{"start":19306,"end":19316}},"declared_type":null,"signature":{"parameters":[{"name":"frompath","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"topath","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"working_copy","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"revision_no","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"descr