nable runtime hooks represented by constant SWOOLE_HOOK_ALL. #2. Swoole\\Runtime::enableCoroutine($flags);       // Enable specified runtime hooks. #3. Swoole\\Runtime::enableCoroutine(true, $flags); // Enable specified runtime hooks. #4. Swoole\\Runtime::enableCoroutine(false);        // Disable runtime hooks. Following statements are of the same (when used to disable runtime hooks): Swoole\\Runtime::enableCoroutine(0);       // #2 Swoole\\Runtime::enableCoroutine(true, 0); // #3 Swoole\\Runtime::enableCoroutine(false);   // #4 /","params":[{"name":"enable","declared_type":"int|bool","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"getHookFlags","fqn":"Runtime::getHookFlags","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Runtime.php","range":{"start":1140,"end":1152}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"/","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"kill","fqn":"Runtime::kill","kind":"Method","origin":"PhpRuntime","extension":"parallel","location":{"file":"parallel/parallel/Runtime.php","range":{"start":5543,"end":5547}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"void","phpdoc_return_type":null},"documentation":{"description":"Shall attempt to force the runtime to shutdown. Note: Tasks scheduled for execution will not be executed, the currently running task shall be interrupted. Warning: Internal function calls in progress cannot be interrupted. /","params":[],"return_type":null,"var_type":null,"throws":["Runtime\\Error\\Closed"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"run","fqn":"Runtime::run","kind":"Method","origin":"PhpRuntime","extension":"parallel","location":{"file":"parallel/parallel/Runtime.php","range":{"start":4856,"end":4859}},"declared_type":null,"signature":{"parameters":[{"name":"task","declared_type":"Closure","phpdoc_type":"Closure","optional":false,"variadic":false,"by_reference":false},{"name":"argv","declared_type":"?array","phpdoc_type":"null|array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"?Future","phpdoc_return_type":"Future|null"},"documentation":{"description":"Shall schedule task for execution in parallel, passing argv at execution time. time. ### Task Characteristics ----------------------------------------------------------------------------------------------------------------- Closures scheduled for parallel execution must not: - accept or return by reference - accept or return internal objects (see notes) - execute a limited set of instructions Instructions prohibited in Closures intended for parallel execution are: - yield - use by-reference - declare class - declare named function Note: Nested closures may yield or use by-reference, but must not contain class or named function declarations. Note: No instructions are prohibited in the files which the task may include. ### Arguments Characteristics ----------------------------------------------------------------------------------------------------------------- Arguments must not: - contain references - contain resources - contain internal objects (see notes) Note: In the case of file stream resources, the resource will be cast to the file descriptor and passed as int where possible, this is unsupported on Windows ### Internal Objects Notes ----------------------------------------------------------------------------------------------------------------- Internal objects generally use a custom structure which cannot be copied by value safely, PHP currently lacks the mechanics to do this (without serialization) and so only objects that do not use a custom structure may be shared. Some internal objects do not use a custom structure, for example @see \\parallel\\Events\\Event and so may be shared. Closures are a special kind of internal object and support being copied by value, and so may be shared. Channels are central to writing parallel code and support concurrent access and execution by necessity, and so may be shared. Warning: A user class that extends an internal class may use a custom structure as defined by the internal class, in which case they cannot be copied by value safely, and so may not be shared. statement. /","params":[{"name":"task","declared_type":"Closure","description":"A Closure with specific characteristics."},{"name":"argv","declared_type":"null|array","description":"An array of arguments with specific characteristics to be passed to task at execution"}],"return_type":"Future|null","var_type":null,"throws":["Runtime\\Error\\Closed","Runtime\\Error\\IllegalFunction","Runtime\\Error\\IllegalInstruction","Runtime\\Error\\IllegalParameter","Runtime\\Error\\IllegalReturn"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setHookFlags","fqn":"Runtime::setHookFlags","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Runtime.php","range":{"start":1258,"end":1270}},"declared_type":null,"signature":{"parameters":[{"name":"flags","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"/","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"hasErrorLabel","fqn":"RuntimeException::hasErrorLabel","kind":"Method","origin":"PhpRuntime","extension":"mongodb","location":{"file":"mongodb/Exception/RuntimeException.php","range":{"start":542,"end":555}},"declared_type":null,"signature":{"parameters":[{"name":"label","declared_type"