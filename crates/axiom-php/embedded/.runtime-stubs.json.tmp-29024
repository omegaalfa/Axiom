mly between the primary and its replicas. Tries to iterate through all replicas until it finds a working one. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"DISTRIBUTE_NONE","fqn":"Cluster::DISTRIBUTE_NONE","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":450,"end":465}},"declared_type":null,"signature":null,"documentation":{"description":"Enabled by default. Readonly commands are sent to the primary node only. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"DISTRIBUTE_RANDOM","fqn":"Cluster::DISTRIBUTE_RANDOM","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":705,"end":722}},"declared_type":null,"signature":null,"documentation":{"description":"Distribute readonly commands randomly between the primary and its replicas. Stops trying replicas after the first failed attempt. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"DISTRIBUTE_RANDOM_REPLICA","fqn":"Cluster::DISTRIBUTE_RANDOM_REPLICA","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":964,"end":989}},"declared_type":null,"signature":null,"documentation":{"description":"Distribute readonly commands randomly among replicas only, never the primary. Stops trying replicas after the first failed attempt. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"DISTRIBUTE_REPLICAS","fqn":"Cluster::DISTRIBUTE_REPLICAS","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":1245,"end":1264}},"declared_type":null,"signature":null,"documentation":{"description":"Distribute readonly commands randomly among replicas only, never the primary. Tries to iterate through all replicas until it finds a working one. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"FAILOVER_ALL","fqn":"Cluster::FAILOVER_ALL","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":4391,"end":4403}},"declared_type":null,"signature":null,"documentation":{"description":"On failure, retry the readonly command on all other nodes (replicas and primary), excluding the failed node. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"FAILOVER_DISTRIBUTE","fqn":"Cluster::FAILOVER_DISTRIBUTE","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":3184,"end":3203}},"declared_type":null,"signature":null,"documentation":{"description":"Always distribute readonly commands between master and slaves, at random. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"FAILOVER_DISTRIBUTE_REPLICAS","fqn":"Cluster::FAILOVER_DISTRIBUTE_REPLICAS","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":3515,"end":3543}},"declared_type":null,"signature":null,"documentation":{"description":"Modern alias for `FAILOVER_DISTRIBUTE_SLAVES`. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"FAILOVER_DISTRIBUTE_SLAVES","fqn":"Cluster::FAILOVER_DISTRIBUTE_SLAVES","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":3372,"end":3398}},"declared_type":null,"signature":null,"documentation":{"description":"Always distribute readonly commands to the slaves, at random. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"FAILOVER_ERROR","fqn":"Cluster::FAILOVER_ERROR","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":2989,"end":3003}},"declared_type":null,"signature":null,"documentation":{"description":"Send readonly commands to slave nodes if master is unreachable. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"FAILOVER_NONE","fqn":"Cluster::FAILOVER_NONE","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":2805,"end":2818}},"declared_type":null,"signature":null,"documentation":{"description":"Enabled by default. Send commands to master nodes only. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"FAILOVER_PRIMARY","fqn":"Cluster::FAILOVER_PRIMARY","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":3957,"end":3973}},"declared_type":null,"signature":null,"documentation":{"description":"On failure, retry the readonly command on the primary node. Only applicable when the failed node is a replica. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"FAILOVER_RANDOM_REPLICA","fqn":"Cluster::FAILOVER_RANDOM_REPLICA","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":3715,"end":3738}},"declared_type":null,"signature":null,"documentation":{"description":"On failure, retry the readonly command on a randomly selected replica. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"FAILOVER_REPLICAS","fqn":"Cluster::FAILOVER_REPLICAS","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":4157,"end":4174}},"declared_type":null,"signature":null,"documentation":{"description":"On failure, retry the readonly command on all replicas, excluding the failed node. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_AVAILABILITY_ZONE","fqn":"Cluster::OPT_AVAILABILITY_ZONE","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":4524,"end":4545}},"declared_type":null,"signature":null,"documentation":{"description":"Integer representing the availability zone option. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_DISTRIBUTE","fqn":"Cluster::OPT_DISTRIBUTE","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":259,"end":273}},"declared_type":null,"signature":null,"documentation":{"description":"Controls how readonly commands are distributed across cluster nodes. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_FAILOVER","fqn":"Cluster::OPT_FAILOVER","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":2598,"end":2610}},"declared_type":null,"signature":null,"documentation":{"description":"Controls the retry strategy when a command fails on a node. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_REPLICA_FAILOVER","fqn":"Cluster::OPT_REPLICA_FAILOVER","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":2272,"end":2292}},"declared_type":null,"signature":null,"documentation":{"description":"Modern alias for `OPT_SLAVE_FAILOVER`. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OPT_SLAVE_FAILOVER","fqn":"Cluster::OPT_SLAVE_FAILOVER","kind":"ClassConstant","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Cluster.php","range":{"start":2145,"end":2163}},"declared_type":null,"signature":null,"documentation":{"description":"Legacy compatibility view for PhpRedis' `OPT_SLAVE_FAILOVER`. This option maps the legacy `FAILOVER_*` modes onto Relay's newer `OPT_DISTRIBUTE` and `OPT_FAILOVER` settings. It is not a true alias: some `OPT_DISTRIBUTE` and `OPT_FAILOVER` combinations have no legacy representation, and `getOption(OPT_SLAVE_FAILOVER)` returns `false` for those states. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ALTERNATE_HANDLING","fqn":"Collator::ALTERNATE_HANDLING","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":3809,"end":3827}},"declared_type":null,"signature":null,"documentation":{"description":"<p> The Alternate attribute is used to control the handling of the so called variable characters in the UCA: whitespace, punctuation and symbols. If Alternate is set to NonIgnorable (N), then differences among these characters are of the same importance as differences among letters. If Alternate is set to Shifted (S), then these characters are of only minor importance. The Shifted value is often used in combination with Strength set to Quaternary. In such a case, whitespace, punctuation, and symbols are considered when comparing strings, but only if all other aspects of the strings (base letters, accents, and case) are identical. If Alternate is not set to Shifted, then there is no difference between a Strength of 3 and a Strength of 4. For more information and examples, see Variable_Weighting in the UCA. The reason the Alternate values are not simply On and Off is that additional Alternate values may be added in the future. The UCA option Blanked is expressed with Strength set to 3, and Alternate set to Shifted. The default for most locales is NonIgnorable. If Shifted is selected, it may be slower if there are many strings that are the same except for punctuation; sort key length will not be affected unless the strength level is also increased. </p> <p> Possible values are: <b>Collator::NON_IGNORABLE</b>(default) <b>Collator::SHIFTED</b> <b>Collator::DEFAULT_VALUE</b> </p> <p> ALTERNATE_HANDLING rules <p> S=3, A=N di Silva &lt; Di Silva &lt; diSilva &lt; U.S.A. &lt; USA S=3, A=S di Silva = diSilva &lt; Di Silva &lt; U.S.A. = USA S=4, A=S di Silva &lt; diSilva &lt; Di Silva &lt; U.S.A. &lt; USA </p> </p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"CASE_FIRST","fqn":"Collator::CASE_FIRST","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":5113,"end":5123}},"declared_type":null,"signature":null,"documentation":{"description":"<p> The Case_First attribute is used to control whether uppercase letters come before lowercase letters or vice versa, in the absence of other differences in the strings. The possible values are Uppercase_First (U) and Lowercase_First (L), plus the standard Default and Off. There is almost no difference between the Off and Lowercase_First options in terms of results, so typically users will not use Lowercase_First: only Off or Uppercase_First. (People interested in the detailed differences between X and L should consult the Collation Customization). Specifying either L or U won't affect string comparison performance, but will affect the sort key length. </p> <p> Possible values are: <b>Collator::OFF</b>(default) <b>Collator::LOWER_FIRST</b> <b>Collator::UPPER_FIRST</b> <b>Collator:DEFAULT</b> </p> <p> CASE_FIRST rules <p> C=X or C=L \"china\" &lt; \"China\" &lt; \"denmark\" &lt; \"Denmark\" C=U \"China\" &lt; \"china\" &lt; \"Denmark\" &lt; \"denmark\" </p> </p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"CASE_LEVEL","fqn":"Collator::CASE_LEVEL","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":5902,"end":5912}},"declared_type":null,"signature":null,"documentation":{"description":"<p> The Case_Level attribute is used when ignoring accents but not case. In such a situation, set Strength to be Primary, and Case_Level to be On. In most locales, this setting is Off by default. There is a small string comparison performance and sort key impact if this attribute is set to be On. </p> <p> Possible values are: <b>Collator::OFF</b>(default) <b>Collator::ON</b> <b>Collator::DEFAULT_VALUE</b> </p> <p> CASE_LEVEL rules <p> S=1, E=X role = Role = rôle S=1, E=O role = rôle &lt; Role </p> </p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"DEFAULT_STRENGTH","fqn":"Collator::DEFAULT_STRENGTH","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":678,"end":694}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"DEFAULT_VALUE","fqn":"Collator::DEFAULT_VALUE","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":548,"end":561}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"FRENCH_COLLATION","fqn":"Collator::FRENCH_COLLATION","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":1759,"end":1775}},"declared_type":null,"signature":null,"documentation":{"description":"<p> Sort strings with different accents from the back of the string. This attribute is automatically set to On for the French locales and a few others. Users normally would not need to explicitly set this attribute. There is a string comparison performance cost when it is set On, but sort key length is unaffected. Possible values are: <b>Collator::ON</b> <b>Collator::OFF</b>(default) <b>Collator::DEFAULT_VALUE</b> </p> <p> FRENCH_COLLATION rules <p> F=OFF cote &lt; coté &lt; côte &lt; côté F=ON cote &lt; côte &lt; coté &lt; côté </p> </p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"HIRAGANA_QUATERNARY_MODE","fqn":"Collator::HIRAGANA_QUATERNARY_MODE","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":8618,"end":8642}},"declared_type":null,"signature":null,"documentation":{"description":"<p> Compatibility with JIS x 4061 requires the introduction of an additional level to distinguish Hiragana and Katakana characters. If compatibility with that standard is required, then this attribute should be set On, and the strength set to Quaternary. This will affect sort key length and string comparison string comparison performance. </p> <p> Possible values are: <b>Collator::OFF</b>(default) <b>Collator::ON</b> <b>Collator::DEFAULT_VALUE</b> </p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"IDENTICAL","fqn":"Collator::IDENTICAL","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":750,"end":759}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"LOWER_FIRST","fqn":"Collator::LOWER_FIRST","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":904,"end":915}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"NON_IGNORABLE","fqn":"Collator::NON_IGNORABLE","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":867,"end":880}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"NORMALIZATION_MODE","fqn":"Collator::NORMALIZATION_MODE","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":7036,"end":7054}},"declared_type":null,"signature":null,"documentation":{"description":"<p> The Normalization setting determines whether text is thoroughly normalized or not in comparison. Even if the setting is off (which is the default for many locales), text as represented in common usage will compare correctly (for details, see UTN #5). Only if the accent marks are in noncanonical order will there be a problem. If the setting is On, then the best results are guaranteed for all possible text input. There is a medium string comparison performance cost if this attribute is On, depending on the frequency of sequences that require normalization. There is no significant effect on sort key length. If the input text is known to be in NFD or NFKD normalization forms, there is no need to enable this Normalization option. </p> <p> Possible values are: <b>Collator::OFF</b>(default) <b>Collator::ON</b> <b>Collator::DEFAULT_VALUE</b> </p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"NUMERIC_COLLATION","fqn":"Collator::NUMERIC_COLLATION","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":9111,"end":9128}},"declared_type":null,"signature":null,"documentation":{"description":"<p> When turned on, this attribute generates a collation key for the numeric value of substrings of digits. This is a way to get '100' to sort AFTER '2'. </p> <p> Possible values are: <b>Collator::OFF</b>(default) <b>Collator::ON</b> <b>Collator::DEFAULT_VALUE</b> </p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"OFF","fqn":"Collator::OFF","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":783,"end":786}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"ON","fqn":"Collator::ON","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":810,"end":812}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"PRIMARY","fqn":"Collator::PRIMARY","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":585,"end":592}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"QUATERNARY","fqn":"Collator::QUATERNARY","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":717,"end":727}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"SECONDARY","fqn":"Collator::SECONDARY","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":615,"end":624}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"SHIFTED","fqn":"Collator::SHIFTED","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":836,"end":843}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"SORT_NUMERIC","fqn":"Collator::SORT_NUMERIC","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":9220,"end":9232}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"SORT_REGULAR","fqn":"Collator::SORT_REGULAR","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":9151,"end":9163}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"SORT_STRING","fqn":"Collator::SORT_STRING","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":9186,"end":9197}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"STRENGTH","fqn":"Collator::STRENGTH","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":7933,"end":7941}},"declared_type":null,"signature":null,"documentation":{"description":"<p> The ICU Collation Service supports many levels of comparison (named \"Levels\", but also known as \"Strengths\"). Having these categories enables ICU to sort strings precisely according to local conventions. However, by allowing the levels to be selectively employed, searching for a string in text can be performed with various matching conditions. For more detailed information, see <b>collator_set_strength</b> chapter. </p> <p> Possible values are: <b>Collator::PRIMARY</b> <b>Collator::SECONDARY</b> <b>Collator::TERTIARY</b>(default) <b>Collator::QUATERNARY</b> <b>Collator::IDENTICAL</b> <b>Collator::DEFAULT_VALUE</b> </p> /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"TERTIARY","fqn":"Collator::TERTIARY","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":647,"end":655}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"UPPER_FIRST","fqn":"Collator::UPPER_FIRST","kind":"ClassConstant","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":939,"end":950}},"declared_type":null,"signature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"ASYNC","fqn":"Connection::ASYNC","kind":"ClassConstant","origin":"PhpRuntime","extension":"pq","location":{"file":"pq/pq.php","range":{"start":4620,"end":4625}},"declared_type":null,"signature":null,"documentation":{"description":"If the connection is not already open, perform the connection attempt [asynchronously](pq/Connection/: Asynchronous Usage). /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"na