. // # In redis.ini // redis.clusters.seeds = \"mycluster[]=localhost:7000&test[]=localhost:7001\" // redis.clusters.timeout = \"mycluster=5\" // redis.clusters.read_timeout = \"mycluster=10\" // redis.clusters.auth = \"mycluster=password\" OR ['user' => 'foo', 'pass' => 'bar] as example //Then, this cluster can be loaded by doing the following $redisClusterPro = new RedisCluster('mycluster'); $redisClusterDev = new RedisCluster('test'); </pre> /","params":[{"name":"name","declared_type":"string|null","description":null},{"name":"seeds","declared_type":"array|null","description":null},{"name":"timeout","declared_type":"int|float","description":null},{"name":"read_timeout","declared_type":"int|float","description":null},{"name":"persistent","declared_type":"bool","description":null},{"name":"auth","declared_type":"mixed","description":null},{"name":"context","declared_type":"array|null","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_compress","fqn":"RedisCluster::_compress","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":135937,"end":135946}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Compress a value with the currently configured compressor as set with RedisCluster::setOption(). /","params":[{"name":"value","declared_type":"string","description":"The value to be compressed."}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_digest","fqn":"RedisCluster::_digest","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":137307,"end":137314}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Compute the XXH3 digest of a PHP value after it has been `_pack`ed, producing the same digest Redis' DIGEST command would return for the stored value. NOTE: This function requires PHP >= 8.1 which is the version PHP added support for XXH3 hashing and made the hash extension mandatory. /","params":[{"name":"value","declared_type":"mixed","description":"The value to compute the digest for."}],"return_type":"string","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_masters","fqn":"RedisCluster::_masters","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":111297,"end":111305}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Return all redis master nodes <pre> $redisCluster->_masters(); // Will return [[0=>'127.0.0.1','6379'],[0=>'127.0.0.1','6380']] </pre> /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_pack","fqn":"RedisCluster::_pack","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":136633,"end":136638}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"A utility method to pack a value with whatever serializer and compressor are configured. /","params":[{"name":"value","declared_type":"mixed","description":"The value to be packed."}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_prefix","fqn":"RedisCluster::_prefix","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":109134,"end":109141}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool|string","phpdoc_return_type":null},"documentation":{"description":"A utility method to prefix the key with the prefix setting for phpredis. <pre> $redisCluster->setOption(RedisCluster::OPT_PREFIX, 'my-prefix:'); $redisCluster->_prefix('my-key'); // Will return 'my-prefix:my-key' </pre> /","params":[{"name":"key","declared_type":"mixed","description":"The key you wish to prefix"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_redir","fqn":"RedisCluster::_redir","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":137955,"end":137961}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string|null","phpdoc_return_type":"string|null"},"documentation":{"description":"Return the last redirection that occurred while executing a command against the cluster. /","params":[],"return_type":"string|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_serialize","fqn":"RedisCluster::_serialize","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":110212,"end":110222}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool|string","phpdoc_return_type":null},"documentation":{"description":"A utility method to serialize values manually. This method allows you to serialize a value with whatever serializer is configured, manually. This can be useful for serialization/unserialization of data going in and out of EVAL commands as phpredis can't automatically do this itself.  Note that if no serializer is set, phpredis will change Array values to 'Array', and Objects to 'Object'. <pre> $redisCluster->setOption(RedisCluster::OPT_SERIALIZER, RedisCluster::SERIALIZER_NONE); $redisCluster->_serialize(\"foo\"); // returns \"foo\" $redisCluster->_serialize(Array()); // Returns \"Array\" $redisCluster->_serialize(new stdClass()); // Returns \"Object\" $redisCluster->setOption(RedisCluster::OPT_SERIALIZER, RedisCluster::SERIALIZER_PHP); $redisCluster->_serialize(\"foo\"); // Returns 's:3:\"foo\";' </pre> /","params":[{"name":"value","declared_type":"mixed","description":"The value to be serialized."}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_uncompress","fqn":"RedisCluster::_uncompress","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":136278,"end":136289}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string"},"documentation":{"description":"Uncompress the provided value with the currently configured compressor as set with RedisCluster::setOption(). /","params":[{"name":"value","declared_type":"string","description":"The compressed value to uncompress."}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_unpack","fqn":"RedisCluster::_unpack","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":137665,"end":137672}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"A utility method to unpack a value that has been packed with the configured serializer and compressor. /","params":[{"name":"value","declared_type":"string","description":"The value which has been serialized and compressed."}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_unserialize","fqn":"RedisCluster::_unserialize","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":111015,"end":111027}},"declared_type":null,"signature":{"parameters":[{"name":"value","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"A utility method to unserialize data with whatever serializer is set up.  If there is no serializer set, the value will be returned unchanged.  If there is a serializer set up, and the data passed in is malformed, an exception will be thrown. This can be useful if phpredis is serializing values, and you return something from redis in a LUA script that is serialized. <pre> $redisCluster->setOption(RedisCluster::OPT_SERIALIZER, RedisCluster::SERIALIZER_PHP); $redisCluster->_unserialize('a:3:{i:0;i:1;i:1;i:2;i:2;i:3;}'); // Will return Array(1,2,3) </pre> /","params":[{"name":"value","declared_type":"string","description":"The value to be unserialized"}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"acl","fqn":"RedisCluster::acl","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":138539,"end":138542}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"subcmd","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Execute the Redis ACL command on the given node. /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"},{"name":"subcmd","declared_type":"string","description":"The ACL subcommand to execute (e.g. 'LIST', 'GETUSER', 'WHOAMI', 'CAT')."},{"name":"","declared_type":null,"description":null}],"return_type":"mixed","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"append","fqn":"RedisCluster::append","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":69069,"end":69075}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|int","phpdoc_return_type":null},"documentation":{"description":"Append specified string to the string stored in specified key. <pre> $redisCluster->set('key', 'value1'); $redisCluster->append('key', 'value2'); // 12 $redisCluster->get('key');              // 'value1value2' </pre> /","params":[{"name":"key","declared_type":"string","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bgrewriteaof","fqn":"RedisCluster::bgrewriteaof","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":116654,"end":116666}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Starts the background rewrite of AOF (Append-Only File) at a specific node. /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bgSave","fqn":"RedisCluster::bgSave","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":114863,"end":114869}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_address","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool","phpdoc_return_type":null},"documentation":{"description":"Performs a background save at a specific node. If a save is already running, this command will fail and return FALSE. /","params":[{"name":"key_or_address","declared_type":"string|array","description":"key or [host,port]"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bitcount","fqn":"RedisCluster::bitcount","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":74883,"end":74891}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"end","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"bybit","declared_type":"bool","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|bool|int","phpdoc_return_type":null},"documentation":{"description":"Count bits in a string. <pre> $redisCluster->set('bit', '345'); // // 11 0011  0011 0100  0011 0101 var_dump( $redisCluster->bitCount('bit', 0, 0) ); // int(4) var_dump( $redisCluster->bitCount('bit', 1, 1) ); // int(3) var_dump( $redisCluster->bitCount('bit', 2, 2) ); // int(4) var_dump( $redisCluster->bitCount('bit', 0, 2) ); // int(11) </pre> /","params":[{"name":"key","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bitop","fqn":"RedisCluster::bitop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":71338,"end":71343}},"declared_type":null,"signature":{"parameters":[{"name":"operation","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"deskey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"srckey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"otherkeys","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|bool|int","phpdoc_return_type":null},"documentation":{"description":"Bitwise operation on multiple keys. <pre> $redisCluster->set('bit1', '1'); // 11 0001 $redisCluster->set('bit2', '2'); // 11 0010 $redisCluster->bitOp('AND', 'bit', 'bit1', 'bit2'); // bit = 110000 $redisCluster->bitOp('OR',  'bit', 'bit1', 'bit2'); // bit = 110011 $redisCluster->bitOp('NOT', 'bit', 'bit1', 'bit2'); // bit = 110011 $redisCluster->bitOp('XOR', 'bit', 'bit1', 'bit2'); // bit = 11 </pre> /","params":[{"name":"operation","declared_type":"string","description":"either \"AND\", \"OR\", \"NOT\", \"XOR\""},{"name":"deskey","declared_type":"string","description":"return key"},{"name":"srckey","declared_type":"string","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bitpos","fqn":"RedisCluster::bitpos","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":74084,"end":74090}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"bit","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"end","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"bybit","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|int|false","phpdoc_return_type":null},"documentation":{"description":"Return the position of the first bit set to 1 or 0 in a string. The position is returned, thinking of the string as an array of bits from left to right, where the first byte's most significant bit is at position 0, the second byte's most significant bit is at position 8, and so forth. was 0 and end was 2, Redis would only search the first two bits. If we look for set bits (the bit argument is 1) and the string is empty or composed of just zero bytes, -1 is returned. If we look for clear bits (the bit argument is 0) and the string only contains bit set to 1, the function returns the first bit not part of the string on the right. So if the string is three bytes set to the value 0xff the command BITPOS key 0 will return 24, since up to bit 23 all the bits are 1. Basically, the function considers the right of the string as padded with zeros if you look for clear bits and specify no range or the start argument only. However, this behavior changes if you are looking for clear bits and specify a range with both start and end. If no clear bit is found in the specified range, the function returns -1 as the user specified a clear range and there are no 0 bits in that range. <pre> $redisCluster->set('key', '\\xff\\xff'); $redisCluster->bitpos('key', 1); // int(0) $redisCluster->bitpos('key', 1, 1); // int(8) $redisCluster->bitpos('key', 1, 3); // int(-1) $redisCluster->bitpos('key', 0); // int(16) $redisCluster->bitpos('key', 0, 1); // int(16) $redisCluster->bitpos('key', 0, 1, 5); // int(-1) </pre> /","params":[{"name":"key","declared_type":"string","description":"The key to check (must be a string)"},{"name":"bit","declared_type":"bool","description":"Whether to look for an unset (0) or set (1) bit."},{"name":"start","declared_type":"int","description":"Where in the string to start looking."},{"name":"end","declared_type":"int","description":"Where in the string to stop looking."},{"name":"bybit","declared_type":"bool","description":"If true, Redis will treat $start and $end as BIT values and not bytes, so if start"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"blmove","fqn":"RedisCluster::blmove","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":142988,"end":142994}},"declared_type":null,"signature":{"parameters":[{"name":"src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"wherefrom","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"whereto","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|string|false","phpdoc_return_type":"RedisCluster|string|false"},"documentation":{"description":"Move an element from one list to another, blocking up to a timeout until an element is available. /","params":[{"name":"src","declared_type":"string","description":"The source list."},{"name":"dst","declared_type":"string","description":"The destination list."},{"name":"wherefrom","declared_type":"string","description":"Where in the source list to extract the element (RedisCluster::LEFT or RedisCluster::RIGHT)."},{"name":"whereto","declared_type":"string","description":"Where in the destination list to put the element (RedisCluster::LEFT or RedisCluster::RIGHT)."},{"name":"timeout","declared_type":"float","description":"How long to block for an element."}],"return_type":"RedisCluster|string|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"blmovem","fqn":"RedisCluster::blmovem","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":143990,"end":143997}},"declared_type":null,"signature":{"parameters":[{"name":"src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"wherefrom","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"whereto","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|false","phpdoc_return_type":"RedisCluster|array|false"},"documentation":{"description":"Move one or more element from one list to another, blocking up to a timeout until an element is available. /","params":[{"name":"src","declared_type":"string","description":"The source list."},{"name":"dst","declared_type":"string","description":"The destination list."},{"name":"wherefrom","declared_type":"string","description":"Where in the source list to extract the element (RedisCluster::LEFT or RedisCluster::RIGHT)."},{"name":"whereto","declared_type":"string","description":"Where in the destination list to put the element (RedisCluster::LEFT or RedisCluster::RIGHT)."},{"name":"timeout","declared_type":"float","description":"How long to block for an element."},{"name":"options","declared_type":"array|null","description":"An array of options to modify how the command behaves."}],"return_type":"RedisCluster|array|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"blmpop","fqn":"RedisCluster::blmpop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":147762,"end":147768}},"declared_type":null,"signature":{"parameters":[{"name":"timeout","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"from","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|null|false","phpdoc_return_type":"RedisCluster|array|null|false"},"documentation":{"description":"Pop one or more elements from the first non-empty list, blocking up to the given timeout until an element is available. /","params":[{"name":"timeout","declared_type":"float","description":"How long to block for an element."},{"name":"keys","declared_type":"array","description":"One or more list keys to pop from."},{"name":"from","declared_type":"string","description":"The string 'LEFT' or 'RIGHT' to pop from the head or tail of the list."},{"name":"count","declared_type":"int","description":"The maximum number of elements to pop."}],"return_type":"RedisCluster|array|null|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"blPop","fqn":"RedisCluster::blPop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":18481,"end":18486}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"timeout_or_key","declared_type":"string|float|int","phpdoc_type":"string|float|int","optional":false,"variadic":false,"by_reference":false},{"name":"extra_args","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|array|null|false","phpdoc_return_type":null},"documentation":{"description":"BLPOP is a blocking list pop primitive. It is the blocking version of LPOP because it blocks the connection when there are no elements to pop from any of the given lists. An element is popped from the head of the first list that is non-empty, with the given keys being checked in the order that they are given. Or STRING Key1 STRING Key2 STRING Key3 ... STRING Keyn <pre> // Non blocking feature $redisCluster->lPush('key1', 'A'); $redisCluster->del('key2'); $redisCluster->blPop('key1', 'key2', 10); // array('key1', 'A') // OR $redisCluster->blPop(array('key1', 'key2'), 10); // array('key1', 'A') $redisCluster->brPop('key1', 'key2', 10); // array('key1', 'A') // OR $redisCluster->brPop(array('key1', 'key2'), 10); // array('key1', 'A') // Blocking feature // process 1 $redisCluster->del('key1'); $redisCluster->blPop('key1', 10); // blocking for 10 seconds // process 2 $redisCluster->lPush('key1', 'A'); // process 1 // array('key1', 'A') is returned </pre> /","params":[{"name":"key","declared_type":"string|array","description":"Array containing the keys of the lists"},{"name":"timeout_or_key","declared_type":"string|float|int","description":"Timeout or key"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"brPop","fqn":"RedisCluster::brPop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":20423,"end":20428}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"timeout_or_key","declared_type":"string|float|int","phpdoc_type":"string|float|int","optional":false,"variadic":false,"by_reference":false},{"name":"extra_args","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"RedisCluster|array|null|false","phpdoc_return_type":null},"documentation":{"description":"BRPOP is a blocking list pop primitive. It is the blocking version of RPOP because it blocks the connection when there are no elements to pop from any of the given lists. An element is popped from the tail of the first list that is non-empty, with the given keys being checked in the order that they are given. See the BLPOP documentation(https://redis.io/commands/blpop) for the exact semantics, since BRPOP is identical to BLPOP with the only difference being that it pops elements from the tail of a list instead of popping from the head. Or STRING Key1 STRING Key2 STRING Key3 ... STRING Keyn <pre> // Non blocking feature $redisCluster->lPush('key1', 'A'); $redisCluster->del('key2'); $redisCluster->blPop('key1', 'key2', 10); // array('key1', 'A') // OR $redisCluster->blPop(array('key1', 'key2'), 10); // array('key1', 'A') $redisCluster->brPop('key1', 'key2', 10); // array('key1', 'A') // OR $redisCluster->brPop(array('key1', 'key2'), 10); // array('key1', 'A') // Blocking feature // process 1 $redisCluster->del('key1'); $redisCluster->blPop('key1', 10); // blocking for 10 seconds // process 2 $redisCluster->lPush('key1', 'A'); // process 1 // array('key1', 'A') is returned </pre> /","params":[{"name":"key","declared_type":"string|array","description":"Array containing the keys of the lists"},{"name":"timeout_or_key","declared_type":"string|float|int","description":"Timeout or key"}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"brpoplpush","fqn":"RedisCluster::brpoplpush","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":26287,"end":26297}},"declared_type":null,"signature":{"parameters":[{"name":"srckey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"deskey","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"A blocking version of rpoplpush, with an integral timeout in the third parameter. /","params":[{"name":"srckey","declared_type":"string","description":null},{"name":"deskey","declared_type":"string","description":null},{"name":"timeout","declared_type":"int","description":null}],"return_type":null,"var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bzmpop","fqn":"RedisCluster::bzmpop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":146297,"end":146303}},"declared_type":null,"signature":{"parameters":[{"name":"timeout","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"from","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"RedisCluster|array|null|false","phpdoc_return_type":"RedisCluster|array|null|false"},"documentation":{"description":"Pop one or more of the highest or lowest scoring members from one or more sorted sets, blocking up to the given timeout until an element is available. /","params":[{"name":"timeout","declared_type":"float","description":"How long to block for an element."},{"name":"keys","declared_type":"array","description":"One or more sorted sets to pop from."},{"name":"from","declared_type":"string","description":"The string 'MIN' or 'MAX' to pop the lowest or highest scoring members."},{"name":"count","declared_type":"int","description":"The maximum number of elements to pop."}],"return_type":"RedisCluster|array|null|false","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bzPopMax","fqn":"RedisCluster::bzPopMax","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/RedisCluster.php","range":{"start":144761,"end":144769}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string|array","phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"timeout_or_key","declared_type":"string|int","phpdoc_type":"string|int","optional":false,"variadic":false,"by_reference":false},{"name":"extra_args","declared_type":"mixed","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Pop the highest scoring member(s) from one or more sorted sets, blocking until one is available. /","params":[{"name":"key","declared_type":"string|array","description":"One or more sorted sets, or the first of several key arguments."},{"name":"timeout_or_key","declared_type":"string|int","description":"Either a timeout, or an additional key, depending on how the command is invoked."},{"name":"","declared_type":null,"description":null}],"return_type":"array","var_type":null,"throws":["RedisClusterException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"bzPopMin","fqn":"Re