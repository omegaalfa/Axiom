null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Open a connection to an InterBase database The database argument has to be a valid path to database file on the server it resides on. If the server is not local, it must be prefixed with either 'hostname:' (TCP/IP), '//hostname/' (NetBEUI) or 'hostname@' (IPX/SPX), depending on the connection protocol used. </p> The user name. Can be set with the ibase.default_user &php.ini; directive. </p> The password for username. Can be set with the ibase.default_password &php.ini; directive. </p> charset is the default character set for a database. </p> buffers is the number of database buffers to allocate for the server-side cache. If 0 or omitted, server chooses its own default. </p> dialect selects the default SQL dialect for any statement executed within a connection, and it defaults to the highest one supported by client libraries. Functional only with InterBase 6 and up. </p> Functional only with InterBase 5 and up. </p> </p> /","params":[{"name":"database","declared_type":"string","description":"[optional] <p>"},{"name":"username","declared_type":"string","description":"[optional] <p>"},{"name":"password","declared_type":"string","description":"[optional] <p>"},{"name":"charset","declared_type":"string","description":"[optional] <p>"},{"name":"buffers","declared_type":"int","description":"[optional] <p>"},{"name":"dialect","declared_type":"int","description":"[optional] <p>"},{"name":"role","declared_type":"string","description":"[optional] <p>"},{"name":"sync","declared_type":"int","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ibase_db_info","fqn":"ibase_db_info","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":22617,"end":22630}},"declared_type":null,"signature":{"parameters":[{"name":