Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":23667,"end":23673}},"declared_type":null,"signature":{"parameters":[{"name":"operation","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key_or_settings","declared_type":"array|string|null","phpdoc_type":"array|string|null","optional":true,"variadic":false,"by_reference":false},{"name":"value","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"Execute the Redis CONFIG command in a variety of ways. What the command does in particular depends on the `$operation` qualifier. Operations that PhpRedis supports are: RESETSTAT, REWRITE, GET, and SET. $redis->config('GET', 'timeout'); $redis->config('GET', ['timeout', 'databases']); $redis->config('SET', 'timeout', 30); $redis->config('SET', ['timeout' => 30, 'loglevel' => 'warning']); /","params":[{"name":"operation","declared_type":"string","description":"The CONFIG operation to execute (e.g. GET, SET, REWRITE)."},{"name":"key_or_settings","declared_type":"array|string|null","description":"One or more keys or values."},{"name":"value","declared_type":"string|null","description":"The value if this is a `CONFIG SET` operation."}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"connect","fqn":"Redis::connect","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":25369,"end":25376}},"declared_type":null,"signature":{"parameters":[{"name":"host","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"port","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"float","phpdoc_type":"float","optional":true,"variadic":false,"by_reference":false},{"name":"persistent_id","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"retry_interval","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"read_timeout","declared_type":"float","phpdoc_type":"float","optional":true,"variadic":false,"by_reference":false},{"name":"context","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Connect to a Redis server address. 6379. Defaults to 0 (no timeout). be made with this ID. between connection attempts. Defaults to 0 (no timeout). when connecting. See `\\Redis::__construct()` for more details. $redis = new \\Redis; try { $redis->connect('localhost', 6379, 2.5, null, 100, 2.5); $foo = $redis->get('foo'); printf(\"foo: %s\\n\", $foo); } catch (Exception $ex) { fprintf(STDERR, \"Error: {$ex->getMessage()}\\n\"); } /","params":[{"name":"host","declared_type":"string","description":"The Redis server hostname or IP"},{"name":"port","declared_type":"int","description":"The Redis server port.  Defaults to"},{"name":"timeout","declared_type":"float","description":"The connection timeout in seconds."},{"name":"persistent_id","declared_type":"string|null","description":"If set, a persistent connection will"},{"name":"retry_interval","declared_type":"int","description":"The number of milliseconds to wait"},{"name":"read_timeout","declared_type":"float","description":"The read timeout in seconds."},{"name":"context","declared_type":"array|null","description":"An optional stream context to use"}],"return_type":"bool","var_type":null,"throws":["RedisException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"copy","fqn":"Redis::copy","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":26956,"end":26960}},"declared_type":null,"signature":{"parameters":[{"name":"src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Make a copy of a key. $redis = new Redis(['host' => 'localhost']); ```php $options = [ 'REPLACE' => true|false # Whether to replace an existing key. 'DB' => int             # Copy key to specific db. ]; ``` $redis->pipeline() ->select(1) ->del('newkey') ->select(0) ->del('newkey') ->mset(['source1' => 'value1', 'exists' => 'old_value']) ->exec(); var_dump($redis->copy('source1', 'newkey')); var_dump($redis->copy('source1', 'newkey', ['db' => 1])); var_dump($redis->copy('source1', 'exists')); var_dump($redis->copy('source1', 'exists', ['REPLACE' => true])); /","params":[{"name":"src","declared_type":"string","description":"The key to copy"},{"name":"dst","declared_type":"string","description":"The name of the new key created from the source key."},{"name":"options","declared_type":"array|null","description":"An array with modifiers on how COPY should operate."}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dbSize","fqn":"Redis::dbSize","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":27557,"end":27563}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Return the number of keys in the currently selected Redis database. $redis = new Redis(['host' => 'localhost']); $redis->flushdb(); $redis->set('foo', 'bar'); var_dump($redis->dbsize()); $redis->mset(['a' => 'a', 'b' => 'b', 'c' => 'c', 'd' => 'd']); var_dump($redis->dbsize()); /","params":[],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"debug","fqn":"Redis::debug","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":28124,"end":28129}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|string","phpdoc_return_type":"Redis|string"},"documentation":{"description":"Execute the Redis `DEBUG` command. Note that this is disabled by default and can be very dangerous, even allowing you to crash the server. Use with caution NOTE: The command has greatly increased in complexity since it was first added to PhpRedis, so you may need to use it via `Redis::rawCommand()` for certain subcommands. /","params":[{"name":"key","declared_type":"string","description":"The DEBUG subcommand to execute."}],"return_type":"Redis|string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"decr","fqn":"Redis::decr","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":28932,"end":28936}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"by","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Decrement a Redis integer by 1 or a provided value. not sent or is set to `1`, PhpRedis will actually invoke the 'DECR' command.  If it is any value other than `1` PhpRedis will actually send the `DECRBY` command. /","params":[{"name":"key","declared_type":"string","description":"The key to decrement"},{"name":"by","declared_type":"int","description":"How much to decrement the key.  Note that if this value is"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"decrBy","fqn":"Redis::decrBy","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":29436,"end":29442}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Decrement a redis integer by a value /","params":[{"name":"key","declared_type":"string","description":"The integer key to decrement."},{"name":"value","declared_type":"int","description":"How much to decrement the key."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"del","fqn":"Redis::del","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":30314,"end":30317}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Delete one or more keys from Redis. This method can be called in two distinct ways.  The first is to pass a single array of keys to delete, and the second is to pass N arguments, all names of keys.  See below for an example of both strategies. the name of a key. /","params":[{"name":"key","declared_type":"array|string","description":"Either an array with one or more key names or a string with"},{"name":"other_keys","declared_type":"string","description":"One or more additional keys passed in a variadic fashion."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"delete","fqn":"Redis::delete","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":31635,"end":31641}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array|string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":null},"documentation":{"description":"$redis->delete('legacy:key'); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":""},"availability":{"since":null,"until":null},"is_static":false},{"name":"delex","fqn":"Redis::delex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":30838,"end":30843}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Delete a key conditionally based on its value or hash digest $redis->delex('session:42'); /","params":[{"name":"key","declared_type":"string","description":"The key to delete"},{"name":"options","declared_type":"array|null","description":"An array with options to modify how DELX works."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"delifeq","fqn":"Redis::delifeq","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":31379,"end":31386}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Delete a key if it's equal to the specified value. This command is specific to Valkey >= 9.0 $redis->delifeq('session:42', 'token'); /","params":[{"name":"key","declared_type":"string","description":"The key to delete"},{"name":"value","declared_type":"mixed","description":"The value to compare against the key's value."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"digest","fqn":"Redis::digest","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":224794,"end":224800}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|string|false","phpdoc_return_type":"Redis|string|false"},"documentation":{"description":"Ask the server for the XXH3 digest of a given key's value $redis->digest('session:42'); /","params":[{"name":"key","declared_type":"string","description":"The key to retrieve the digest for."}],"return_type":"Redis|string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"discard","fqn":"Redis::discard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":32070,"end":32077}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Discard a transaction currently in progress. $redis->getMode(); $redis->set('foo', 'bar'); $redis->discard(); $redis->getMode(); /","params":[],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"dump","fqn":"Redis::dump","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":32562,"end":32566}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|string|false","phpdoc_return_type":"Redis|string|false"},"documentation":{"description":"Dump Redis' internal binary representation of a key. $redis->zadd('zset', 0, 'zero', 1, 'one', 2, 'two'); $binary = $redis->dump('zset'); $redis->restore('new-zset', 0, $binary); /","params":[{"name":"key","declared_type":"string","description":"The key to dump."}],"return_type":"Redis|string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"echo","fqn":"Redis::echo","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":32960,"end":32964}},"declared_type":null,"signature":{"parameters":[{"name":"str","declared_type"