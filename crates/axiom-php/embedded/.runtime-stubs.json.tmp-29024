,"declared_return_type":null,"phpdoc_return_type":"resource"},"documentation":{"description":"Function is used to install a new virtual machine to the machine 'driver' (image type, e.g. 'raw' or 'qcow2'), 'bus' (e.g. 'ide', 'scsi'), 'dev' (device to be presented to the guest - e.g. 'hda'), 'size' (with 'M' or 'G' suffixes, like '10G' for 10 gigabytes image etc.) and 'flags' (VIR_DOMAIN_DISK_FILE or VIR_DOMAIN_DISK_BLOCK, optionally VIR_DOMAIN_DISK_ACCESS_ALL to allow access to the disk for all users on the host system) 'network' (for network name) and optional 'model' for model of NIC device /","params":[{"name":"conn","declared_type":"resource","description":"libvirt connection resource"},{"name":"name","declared_type":"string","description":"name of the new domain"},{"name":"arch","declared_type":"string|null|false","description":"optional architecture string, can be NULL to get default (or false)"},{"name":"memMB","declared_type":"int","description":"number of megabytes of RAM to be allocated for domain"},{"name":"maxmemMB","declared_type":"int","description":"maximum number of megabytes of RAM to be allocated for domain"},{"name":"vcpus","declared_type":"int","description":"number of VCPUs to be allocated to domain"},{"name":"iso_image","declared_type":"string","description":"installation ISO image for domain"},{"name":"disks","declared_type":"array","description":"array of disk devices for domain, consist of keys as 'path' (storage location),"},{"name":"networks","declared_type":"array","description":"array of network devices for domain, consists of keys as 'mac' (for MAC address),"},{"name":"flags","declared_type":"int","description":"[optional] bit array of flags"}],"return_type":"resource","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"libvirt_domain_new_get_vnc","fqn":"libvirt_domain_new_get_vnc","kind":"Function","origin":"PhpRuntime","extension":"libvirt-php","location":{"file":"libvir