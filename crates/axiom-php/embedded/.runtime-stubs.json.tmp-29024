n":"<p>"},{"name":"len","declared_type":"int","description":"<p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"cubrid_lob2_seek","fqn":"cubrid_lob2_seek","kind":"Function","origin":"PhpRuntime","extension":"cubrid","location":{"file":"cubrid/cubrid.php","range":{"start":48687,"end":48703}},"declared_type":null,"signature":{"parameters":[{"name":"lob_identifier","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"offset","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"origin","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5, CUBRID &gt;= 8.4.1)<br/> Move the cursor of a lob object. Lob identifier as a result of cubrid_lob2_new() or get from the result set. </p> Number of units you want to move the cursor. </p> This parameter can be the following values: </p> <ul> <li>CUBRID_CURSOR_FIRST: move forward from the first beginning.</li> <li>CUBRID_CURSOR_CURRENT: move forward or backward from the current position.</li> <li>CUBRID_CURSOR_LAST: move backward at the end of LOB object.</li> </ul> TRUE if the process is successful and FALSE for failure. </p> /","params":[{"name":"lob_identifier","declared_type":"resource","description":"<p>"},{"name":"offset","declared_type":"int","description":"<p>"},{"name":"origin","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"cubrid_lob2_seek64","fqn":"cubrid_lob2_seek64","kind":"Function","origin":"PhpRuntime","extension":"cubrid","location":{"file":"cubrid/cubrid.php","range":{"start":47806,"end":47824}},"declared_type":null,"signature":{"pa