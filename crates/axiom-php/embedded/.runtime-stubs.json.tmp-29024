{"name":"color","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"filled","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"linewidth","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"linestyle","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Draws a filled or hollow rectangle. The first parameter, target, may be a WinBinder object, a window handle, a drawing surface or a bitmap. xpos and ypos are the coordinates of the upper-left corner of the rectangle, in pixels. width and height are the dimensions of the rectangle. color is a RGB color value. Set filled to FALSE to draw a border. A linewidth of zero sets the width to 1 pixel. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"target","declared_type":null,"description":null},{"name":"xpos","declared_type":null,"description":null},{"name":"ypos","declared_type":null,"description":null},{"name":"width","declared_type":null,"description":null},{"name":"height","declared_type":null,"description":null},{"name":"color","declared_type":null,"description":null},{"name":"filled","declared_type":"null","description":null},{"name":"linewidth","declared_type":"null","description":null},{"name":"linestyle","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_draw_text","fqn":"wb_draw_text","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":19863,"end":19875}},"declared_type":null,"signature":{"parameters":[{"name":"target","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"