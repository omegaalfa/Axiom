":{"description":"/","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_cmdtuples","fqn":"pg_cmdtuples","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":76221,"end":76233}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"/","params":[{"name":"result","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":"8.0"},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_connect","fqn":"pg_connect","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":1759,"end":1769}},"declared_type":null,"signature":{"parameters":[{"name":"connection_string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"host","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"port","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"tty","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"dbname","declared_type":"string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"Open a PostgreSQL connection The <i>connection_string</i> can be empty to use all default parameters, or it can contain one or more parameter settings separated by whitespace. Each parameter setting is in the form keyword = value. Spaces around the equal sign are optional. To write an empty value or a value containing spaces, surround it with single quotes, e.g., keyword = 'a value'. Single quotes and backslashes within the value must be escaped with a backslash, i.e., \\' and \\\\. </p> <p> The currently recognized parameter keywords are: <i>host</i>, <i>hostaddr</i>, <i>port</i>, <i>dbname</i> (defaults to value of <i>user</i>), <i>user</i>, <i>password</i>, <i>connect_timeout</i>, <i>options</i>, <i>tty</i> (ignored), <i>sslmode</i>, <i>requiressl</i> (deprecated in favor of <i>sslmode</i>), and <i>service</i>. Which of these arguments exist depends on your PostgreSQL version. </p> <p> The <i>options</i> parameter can be used to set command line parameters to be invoked by the server. </p> If <b>PGSQL_CONNECT_FORCE_NEW</b> is passed, then a new connection is created, even if the <i>connection_string</i> is identical to an existing connection. </p> /","params":[{"name":"connection_string","declared_type":"string","description":"<p>"},{"name":"flags","declared_type":"int","description":"<p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_connect_poll","fqn":"pg_connect_poll","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":5167,"end":5182}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false},{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Poll the status of an in-progress asynchronous PostgreSQL connection attempt. PostgreSQL database connection resource. </p> <b>PGSQL_POLLING_OK</b>, or <b>PGSQL_POLLING_ACTIVE</b>. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_connection_busy","fqn":"pg_connection_busy","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":6097,"end":6115}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Get connection is busy or not PostgreSQL database connection resource. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_connection_reset","fqn":"pg_connection_reset","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":6489,"end":6508}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Reset connection (reconnect) PostgreSQL database connection resource. </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_connection_status","fqn":"pg_connection_status","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":5692,"end":5712}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Get connection status PostgreSQL database connection resource. </p> <b>PGSQL_CONNECTION_BAD</b>. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_consume_input","fqn":"pg_consume_input","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":82817,"end":82833}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"PgSql\\Connection|resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Reads input on the connection Note that true does not necessarily indicate that input was waiting to be read. /","params":[{"name":"connection","declared_type":"PgSql\\Connection|resource","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_convert","fqn":"pg_convert","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":69644,"end":69654}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"table_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Convert associative array values into suitable for SQL statement PostgreSQL database connection resource. </p> Name of the table against which to convert types. </p> Data to be converted. </p> Any number of <b>PGSQL_CONV_IGNORE_DEFAULT</b>, <b>PGSQL_CONV_FORCE_NULL</b> or <b>PGSQL_CONV_IGNORE_NOT_NULL</b>, combined. </p> match properly with a PostgreSQL's type. match properly with a PostgreSQL's type. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"table_name","declared_type":"string","description":"<p>"},{"name":"values","declared_type":"array","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":["\\ValueError","\\TypeError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_copy_from","fqn":"pg_copy_from","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":51060,"end":51072}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"table_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"rows","declared_type":null,"phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"separator","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"null_as","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Insert records into a table from an array PostgreSQL database connection resource. </p> Name of the table into which to copy the <i>rows</i>. </p> An array of data to be copied into <i>table_name</i>. Each value in <i>rows</i> becomes a row in <i>table_name</i>. Each value in <i>rows</i> should be a delimited string of the values to insert into each field. Values should be linefeed terminated. </p> The token that separates values for each field in each element of <i>rows</i>. Default is TAB. </p> How SQL NULL values are represented in the <i>rows</i>. Default is \\N (\"\\\\N\"). </p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"table_name","declared_type":"string","description":"<p>"},{"name":"rows","declared_type":"array","description":"<p>"},{"name":"separator","declared_type":"string","description":"[optional] <p>"},{"name":"null_as","declared_type":"string","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_copy_to","fqn":"pg_copy_to","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":49893,"end":49903}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"table_name","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"separator","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"null_as","declared_type":"string","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Copy a table to an array PostgreSQL database connection resource. </p> Name of the table from which to copy the data into <i>rows</i>. </p> The token that separates values for each field in each element of <i>rows</i>. Default is TAB. </p> How SQL NULL values are represented in the <i>rows</i>. Default is \\N (\"\\\\N\"). </p> It returns <b>FALSE</b> on failure. /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"table_name","declared_type":"string","description":"<p>"},{"name":"separator","declared_type":"string","description":"[optional] <p>"},{"name":"null_as","declared_type":"string","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_dbname","fqn":"pg_dbname","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":8200,"end":8209}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"string","phpdoc_return_type":"string|false"},"documentation":{"description":"Get the database name PostgreSQL database connection resource. When <i>connection</i> is not present, the default connection is used. The default connection is the last connection made by <b>pg_connect</b> or <b>pg_pconnect</b>. </p> <i>connection</i> is to, or <b>FALSE</b> on error. /","params":[{"name":"connection","declared_type":"resource","description":"[optional] <p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"pg_delete","fqn":"pg_delete","kind":"Function","origin":"PhpRuntime","extension":"pgsql","location":{"file":"pgsql/pgsql.php","range":{"start":73621,"end":73630}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"tab