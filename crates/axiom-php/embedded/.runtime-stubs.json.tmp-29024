l","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagesx","fqn":"imagesx","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":47783,"end":47790}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int|false"},"documentation":{"description":"Get image width errors. /","params":[{"name":"image","declared_type":"resource|GdImage","description":null}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagesy","fqn":"imagesy","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":48026,"end":48033}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int|false"},"documentation":{"description":"Get image height errors. /","params":[{"name":"image","declared_type":"resource|GdImage","description":null}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagetruecolortopalette","fqn":"imagetruecolortopalette","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":18491,"end":18514}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"dither","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false},{"name":"num_colors","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Convert a true color image to a palette image Indicates if the image should be dithered - if it is true then dithering will be used which will result in a more speckled image but with better color approximation. </p> Sets the maximum number of colors that should be retained in the palette. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"dither","declared_type":"bool","description":"<p>"},{"name":"num_colors","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagettfbbox","fqn":"imagettfbbox","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":50702,"end":50714}},"declared_type":null,"signature":{"parameters":[{"name":"size","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"angle","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"font_filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Give the bounding box of a text using TrueType fonts The font size. Depending on your version of GD, this should be specified as the pixel size (GD1) or point size (GD2). </p> Angle in degrees in which text will be measured. </p> The name of the TrueType font file (can be a URL). Depending on which version of the GD library that PHP is using, it may attempt to search for files that do not begin with a leading '/' by appending '.ttf' to the filename and searching along a library-defined font path. </p> The string to be measured. </p> elements representing four points making the bounding box of the text on success and false on error. <tr valign=\"top\"> <td>key</td> <td>contents</td> </tr> <tr valign=\"top\"> <td>0</td> <td>lower left corner, X position</td> </tr> <tr valign=\"top\"> <td>1</td> <td>lower left corner, Y position</td> </tr> <tr valign=\"top\"> <td>2</td> <td>lower right corner, X position</td> </tr> <tr valign=\"top\"> <td>3</td> <td>lower right corner, Y position</td> </tr> <tr valign=\"top\"> <td>4</td> <td>upper right corner, X position</td> </tr> <tr valign=\"top\"> <td>5</td> <td>upper right corner, Y position</td> </tr> <tr valign=\"top\"> <td>6</td> <td>upper left corner, X position</td> </tr> <tr valign=\"top\"> <td>7</td> <td>upper left corner, Y position</td> </tr> </p> <p> The points are relative to the text regardless of the angle, so \"upper left\" means in the top left-hand corner seeing the text horizontally. /","params":[{"name":"size","declared_type":"float","description":"<p>"},{"name":"angle","declared_type":"float","description":"<p>"},{"name":"font_filename","declared_type":"string","description":"<p>"},{"name":"string","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"array","description":"[optional]"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagettftext","fqn":"imagettftext","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":54396,"end":54408}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"size","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"angle","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"x","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"y","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"color","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"font_filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"text","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Write text to the image using TrueType fonts The font size. Depending on your version of GD, this should be specified as the pixel size (GD1) or point size (GD2). </p> The angle in degrees, with 0 degrees being left-to-right reading text. Higher values represent a counter-clockwise rotation. For example, a value of 90 would result in bottom-to-top reading text. </p> The coordinates given by x and y will define the basepoint of the first character (roughly the lower-left corner of the character). This is different from the imagestring, where x and y define the upper-left corner of the first character. For example, \"top left\" is 0, 0. </p> The y-ordinate. This sets the position of the fonts baseline, not the very bottom of the character. </p> The color index. Using the negative of a color index has the effect of turning off antialiasing. See imagecolorallocate. </p> The path to the TrueType font you wish to use. </p> <p> Depending on which version of the GD library PHP is using, when font_filename does not begin with a leading / then .ttf will be appended to the filename and the library will attempt to search for that filename along a library-defined font path. </p> <p> When using versions of the GD library lower than 2.0.18, a space character, rather than a semicolon, was used as the 'path separator' for different font files. Unintentional use of this feature will result in the warning message: Warning: Could not find/open font. For these affected versions, the only solution is moving the font to a path which does not contain spaces. </p> <p> In many cases where a font resides in the same directory as the script using it the following trick will alleviate any include problems. </p> <pre> <?php // Set the enviroment variable for GD putenv('GDFONTPATH=' . realpath('.')); // Name the font to be used (note the lack of the .ttf extension) $font = 'SomeFont'; ?> </pre> <p> <strong>Note:</strong> <code>open_basedir</code> does <em>not</em> apply to font_filename. </p> The text string in UTF-8 encoding. </p> <p> May include decimal numeric character references (of the form: &amp;#8364;) to access characters in a font beyond position 127. The hexadecimal format (like &amp;#xA9;) is supported. Strings in UTF-8 encoding can be passed directly. </p> <p> Named entities, such as &amp;copy;, are not supported. Consider using html_entity_decode to decode these named entities into UTF-8 strings (html_entity_decode() supports this as of PHP 5.0.0). </p> <p> If a character is used in the string which is not supported by the font, a hollow rectangle will replace the character. </p> bounding box of the text. The order of the points is lower left, lower right, upper right, upper left. The points are relative to the text regardless of the angle, so \"upper left\" means in the top left-hand corner when you see the text horizontally. Returns false on error. /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"size","declared_type":"float","description":"<p>"},{"name":"angle","declared_type":"float","description":"<p>"},{"name":"x","declared_type":"int","description":"<p>"},{"name":"y","declared_type":"int","description":"<p>"},{"name":"color","declared_type":"int","description":"<p>"},{"name":"font_filename","declared_type":"string","description":"<p>"},{"name":"text","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"array","description":"[optional]"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagetypes","fqn":"imagetypes","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":66279,"end":66289}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Return the image types supported by this PHP build version of GD linked into PHP. The following bits are returned, IMG_BMP | IMG_GIF | IMG_JPG | IMG_PNG | IMG_WBMP | IMG_XPM | IMG_WEBP /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagewbmp","fqn":"imagewbmp","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":35569,"end":35578}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"file","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"foreground_color","declared_type":"?int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Output image to browser or file The path to save the file to. If not set or null, the raw image stream will be outputted directly. </p> You can set the foreground color with this parameter by setting an identifier obtained from imagecolorallocate. The default foreground color is black. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"file","declared_type":"string","description":"[optional] <p>"},{"name":"foreground_color","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagewebp","fqn":"imagewebp","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":33744,"end":33753}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"file","declared_type":null,"phpdoc_type":"resource|string|null","optional":true,"variadic":false,"by_reference":false},{"name":"quality","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Output a WebP image to browser or file The path or an open stream resource (which is automatically closed after this function returns) to save the file to. If not set or null, the raw image stream will be output directly. </p> quality ranges from 0 (worst quality, smaller file) to 100 (best quality, biggest file). </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"file","declared_type":"resource|string|null","description":"[optional] <p>"},{"name":"quality","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagexbm","fqn":"imagexbm","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":70046,"end":70054}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"filename","declared_type":"?string","phpdoc_type":"string|null","optional":false,"variadic":false,"by_reference":false},{"name":"foreground_color","declared_type":"?int","phpdoc_type":"int|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Output XBM image to browser or file The path to save the file to. If not set or null, the raw image stream will be outputted directly. </p> You can set the foreground color with this parameter by setting an identifier obtained from imagecolorallocate. The default foreground color is black. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"filename","declared_type":"string|null","description":"<p>"},{"name":"foreground_color","declared_type":"int|null","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imap_8bit","fqn":"imap_8bit","kind":"Function","origin":"PhpRuntime","extension":"imap","location":{"file":"imap/imap.php","range":{"start":28995,"end":29004}},"declared_type":null,"signature":{"parameters":[{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Convert an 8bit string to a quoted-printable string The 8bit string to convert </p> /","params":[{"name":"string","declared_type":"string","description":"<p>"}],"return_type":"string|false","v