],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_ping","fqn":"mysql_ping","kind":"Function","origin":"PhpRuntime","extension":"mysql","location":{"file":"mysql/mysql.php","range":{"start":25017,"end":25027}},"declared_type":null,"signature":{"parameters":[{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Ping a server connection or reconnect if there is no connection otherwise false. /","params":[{"name":"link_identifier","declared_type":"resource","description":"[optional]"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_query","fqn":"mysql_query","kind":"Function","origin":"PhpRuntime","extension":"mysql","location":{"file":"mysql/mysql.php","range":{"start":5666,"end":5677}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|bool"},"documentation":{"description":"Send a MySQL query An SQL query </p> <p> The query string should not end with a semicolon. Data inside the query should be properly escaped. </p> <b>mysql_query</b> returns a resource on success, or false on error. </p> <p> For other type of SQL statements, INSERT, UPDATE, DELETE, DROP, etc, <b>mysql_query</b> returns true on success or false on error. </p> <p> The returned result resource should be passed to <b>mysql_fetch_array</b>, and other functions for dealing with result tables, to access the returned data. </p> <p> Use <b>mysql_num_rows</b> to find out how many rows were returned for a SELECT statement or <b>mysql_affected_rows</b> to find out how many rows were affected by a DELETE, INSERT, REPLACE, or UPDATE statement. </p> <p> <b>mysql_query</b> will also fail and return false if the user does not have permission to access the table(s) referenced by the query. /","params":[{"name":"query","declared_type":"string","description":"<p>"},{"name":"link_identifier","declared_type":"resource","description":"[optional]"}],"return_type":"resource|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_real_escape_string","fqn":"mysql_real_escape_string","kind":"Function","origin":"PhpRuntime","extension":"mysql","location":{"file":"mysql/mysql.php","range":{"start":23433,"end":23457}},"declared_type":null,"signature":{"parameters":[{"name":"unescaped_string","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"Escapes special characters in a string for use in an SQL statement The string that is to be escaped. </p> /","params":[{"name":"unescaped_string","declared_type":"string","description":"<p>"},{"name":"link_identifier","declared_type":"resource","description":"[optional]"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_result","fqn":"mysql_result","kind":"Function","origin":"PhpRuntime","extension":"mysql","location":{"file":"mysql/mysql.php","range":{"start":13261,"end":13273}},"declared_type":null,"signature":{"parameters":[{"name":"result","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"row","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"field","declared_type":null,"phpdoc_type":"mixed","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Get result data The row number from the result that's being retrieved. Row numbers start at 0. </p> The name or offset of the field being retrieved. </p> <p> It can be the field's offset, the field's name, or the field's table dot field name (tablename.fieldname). If the column name has been aliased ('select foo as bar from...'), use the alias instead of the column name. If undefined, the first field is retrieved. </p> false on failure. /","params":[{"name":"result","declared_type":"resource","description":null},{"name":"row","declared_type":"int","description":"<p>"},{"name":"field","declared_type":"mixed","description":"[optional] <p>"}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_select_db","fqn":"mysql_select_db","kind":"Function","origin":"PhpRuntime","extension":"mysql","location":{"file":"mysql/mysql.php","range":{"start":4326,"end":4341}},"declared_type":null,"signature":{"parameters":[{"name":"database_name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Select a MySQL database The name of the database that is to be selected. </p> /","params":[{"name":"database_name","declared_type":"string","description":"<p>"},{"name":"link_identifier","declared_type":"resource","description":"[optional]"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"mysql_selectdb","fq