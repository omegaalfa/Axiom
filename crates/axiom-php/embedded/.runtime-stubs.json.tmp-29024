turn_type":"array"},"documentation":{"description":"- 'rings' Type: array of GEOSGeometry Rings that can be formed by the costituent linework of geometry. - 'cut_edges' (optional) Type: array of GEOSGeometry Edges which are connected at both ends but which do not form part of polygon. - 'dangles' Type: array of GEOSGeometry Edges which have one or both ends which are not incident on another edge endpoint - 'invalid_rings' Type: array of GEOSGeometry Edges which form rings which are invalid (e.g. the component lines contain a self-intersection) /","params":[{"name":"geom","declared_type":"GEOSGeometry","description":null}],"return_type":"array","var_type":null,"throws":["Exception"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"GEOSRelateMatch","fqn":"GEOSRelateMatch","kind":"Function","origin":"PhpRuntime","extension":"geos","location":{"file":"geos/geos.php","range":{"start":1314,"end":1329}},"declared_type":null,"signature":{"parameters":[{"name":"matrix","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"/","params":[{"name":"matrix","declared_type":"string","description":null},{"name":"pattern","declared_type":"string","description":null}],"return_type":"bool","var_type":null,"throws":["Exception"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"GEOSSharedPaths","fqn":"GEOSSharedPaths","kind":"Function","origin":"PhpRuntime","extension":"geos","location":{"file":"geos/geos.php","range":{"start":1004,"end":1019}},"declared_type":null,"signature":{"parameters":[{"name":"geom1","declared_type":"GEOSGeometry","phpdoc_type":"GEOSGeometry","optional":false,"variadic":false,"by_reference":false},{"name":"geom2","declared_t