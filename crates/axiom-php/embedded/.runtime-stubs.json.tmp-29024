php","range":{"start":105211,"end":105216}},"declared_type":null,"signature":null,"documentation":{"description":"A PDO subclass representing a connection using the PostgreSQL PDO driver. This driver supports a dedicated SQL query parser for the PostgreSQL dialect. It can handle the following: Single and double-quoted literals, with doubling as escaping mechanism C-style “escape” string literals Dollar-quoted string literals Two-dashes and C-style comments (non-nested). Support for ?? as escape sequence for the ? operator. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"Sqlite","fqn":"Pdo\\Sqlite","kind":"Class","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":95308,"end":95314}},"declared_type":null,"signature":null,"documentation":{"description":"A PDO subclass representing a connection using the SQLite PDO driver. This driver supports a dedicated SQL query parser for the SQLite dialect. It can handle the following: Single, double-quoted, and backtick literals, with doubling as escaping mechanism. Square brackets quoting for identifiers. Two-dashes and C-style comments (non-nested). /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PDOException","fqn":"PDOException","kind":"Class","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"start":628,"end":640}},"declared_type":null,"signature":null,"documentation":{"description":"Represents an error raised by PDO. You should not throw a <b>PDOException</b> from your own code. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"PDORow","fqn":"PDORow","kind":"Class","origin":"PhpRuntime","extension":"PDO","location":{"file":"PDO/PDO.php","range":{"star