go.php","range":{"start":42516,"end":42521}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"MongoCollection"},"documentation":{"description":"Gets a collection /","params":[{"name":"name","declared_type":"string","description":"The next string in the collection name."}],"return_type":"MongoCollection","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__toString","fqn":"MongoCollection::__toString","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":42270,"end":42280}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"String representation of this collection /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"aggregate","fqn":"MongoCollection::aggregate","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":43617,"end":43626}},"declared_type":null,"signature":{"parameters":[{"name":"pipeline","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"op","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"pipelineOperators","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PECL mongo &gt;= 1.3.0)<br/> <p> The MongoDB {@link https://docs.mongodb.org/manual/applications/aggregation/ aggregation framework} provides a means to calculate aggregated values without having to use MapReduce. While MapReduce is powerful, it is often more difficult than necessary for many simple aggregation tasks, such as totaling or averaging field values. </p> <p> This method accepts either a variable amount of pipeline operators, or a single array of operators constituting the pipeline. </p> /","params":[{"name":"pipeline","declared_type":"array","description":"<p> An array of pipeline operators, or just the first operator. </p>"},{"name":"op","declared_type":"array","description":"[optional] <p> The second pipeline operator.</p>"},{"name":"pipelineOperators","declared_type":"array","description":"[optional] <p> Additional pipeline operators. </p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"aggregateCursor","fqn":"MongoCollection::aggregateCursor","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":44942,"end":44957}},"declared_type":null,"signature":{"parameters":[{"name":"pipeline","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"MongoCommandCursor"},"documentation":{"description":"(PECL mongo &gt;= 1.5.0)<br/> <p> With this method you can execute Aggregation Framework pipelines and retrieve the results through a cursor, instead of getting just one document back as you would with {@link https://php.net/manual/en/mongocollection.aggregate.php MongoCollection::aggregate()}. This method returns a {@link https://php.net/manual/en/class.mongocommandcursor.php MongoCommandCursor} object. This cursor object implements the {@link https://php.net/manual/en/class.iterator.php Iterator} interface just like the {@link https://php.net/manual/en/class.mongocursor.php MongoCursor} objects that are returned by the {@link https://php.net/manual/en/mongocollection.find.php MongoCollection::find()} method </p> /","params":[{"name":"pipeline","declared_type":"array","description":"<p> The Aggregation Framework pipeline to execute. </p>"},{"name":"options","declared_type":"array","description":"[optional] <p> Options for the aggregation command </p>"}],"return_type":"MongoCommandCursor","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"batchInsert","fqn":"MongoCollection::batchInsert","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":52495,"end":52506}},"declared_type":null,"signature":{"parameters":[{"name":"a","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|bool"},"documentation":{"description":"Inserts multiple documents into this collection /","params":[{"name":"a","declared_type":"array","description":"An array of arrays."},{"name":"options","declared_type":"array","description":"Options for the inserts."}],"return_type":"array|bool","var_type":null,"throws":["MongoCursorException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"count","fqn":"MongoCollection::count","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":63757,"end":63762}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":null,"phpdoc_type":"array|stdClass","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Counts the number of documents in this collection /","params":[{"name":"query","declared_type":"array|stdClass","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"createDBRef","fqn":"MongoCollection::createDBRef","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":66094,"end":66105}},"declared_type":null,"signature":{"parameters":[{"name":"a","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Creates a database reference /","params":[{"name":"a","declared_type":"array","description":"Object to which to create a reference."}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"createIndex","fqn":"MongoCollection::createIndex","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":62055,"end":62066}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Creates an index on the given field(s), or does nothing if the index already exists /","params":[{"name":"keys","declared_type":"array","description":"Field or fields to use as index."},{"name":"options","declared_type":"array","description":"[optional] This parameter is an associative array of the form array(\"optionname\" => `<boolean>`, ...)."}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"deleteIndex","fqn":"MongoCollection::deleteIndex","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":62983,"end":62994}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":null,"phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Deletes an index from this collection /","params":[{"name":"keys","declared_type":"string|array","description":"Field or fields from which to delete the index."}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"deleteIndexes","fqn":"MongoCollection::deleteIndexes","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":63220,"end":63233}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Delete all indexes for this collection /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"distinct","fqn":"MongoCollection::distinct","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":60421,"end":60429}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"query","declared_type":"?array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"Retrieve a list of distinct values for the given key across a collection /","params":[{"name":"key","declared_type":"string","description":"The key to use."},{"name":"query","declared_type":"array","description":"An optional query parameters"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"drop","fqn":"MongoCollection::drop","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":47743,"end":47747}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Drops this collection /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ensureIndex","fqn":"MongoCollection::ensureIndex","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":62641,"end":62652}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"true"},"documentation":{"description":"Creates an index on the given field(s), or does nothing if the index already exists /","params":[{"name":"keys","declared_type":"array","description":"Field or fields to use as index."},{"name":"options","declared_type":"array","description":"[optional] This parameter is an associative array of the form array(\"optionname\" => `<boolean>`, ...)."}],"return_type":"true","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"find","fqn":"MongoCollection::find","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":59993,"end":59997}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"fields","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"MongoCursor"},"documentation":{"description":"Querys this collection /","params":[{"name":"query","declared_type":"array","description":"The fields for which to search."},{"name":"fields","declared_type":"array","description":"Fields of the results to return."}],"return_type":"MongoCursor","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"findAndModify","fqn":"MongoCollection::findAndModify","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":61006,"end":61019}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"update","declared_type":"?array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"fields","declared_type":"?array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Update a document and return it /","params":[{"name":"query","declared_type":"array","description":"The query criteria to search for."},{"name":"update","declared_type":"array","description":"The update criteria."},{"name":"fields","declared_type":"array","description":"Optionally only return these fields."},{"name":"options","declared_type":"array","description":"An array of options to apply, such as remove the match document from the DB and return it."}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"findOne","fqn":"MongoCollection::findOne","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":61535,"end":61542}},"declared_type":null,"signature":{"parameters":[{"name":"query","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"fields","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|null"},"documentation":{"description":"Querys this collection, returning a single element /","params":[{"name":"query","declared_type":"array","description":"The fields for which to search."},{"name":"fields","declared_type":"array","description":"Fields of the results to return."},{"name":"options","declared_type":"array","description":"This parameter is an associative array of the form array(\"name\" => `<value>`, ...)."}],"return_type":"array|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getDBRef","fqn":"MongoCollection::getDBRef","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":66421,"end":66429}},"declared_type":null,"signature":{"parameters":[{"name":"ref","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Fetches the document pointed to by a database reference /","params":[{"name":"ref","declared_type":"array","description":"A database reference."}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getIndexInfo","fqn":"MongoCollection::getIndexInfo","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":63466,"end":63478}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Returns an array of index names for this collection /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getName","fqn":"MongoCollection::getName","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":45165,"end":45172}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Returns this collection's name /","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getReadPreference","fqn":"MongoCollection::getReadPreference","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":46897,"end":46914}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PECL mongo &gt;= 1.3.0)<br/> (corresponding to the {@link https://secure.php.net/manual/en/class.mongoclient.php MongoClient} constants), and <em>tagsets</em> containing a list of all tag set criteria. If no tag sets were specified, <em>tagsets</em> will not be present in the array. /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getSlaveOkay","fqn":"MongoCollection::getSlaveOkay","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":45588,"end":45600}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL mongo &gt;= 1.1.0)<br/> <p> See {@link https://secure.php.net/manual/en/mongo.queries.php the query section} of this manual for information on distributing reads to secondaries. </p> /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"group","fqn":"MongoCollection::group","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":67147,"end":67152}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"initial","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"reduce","declared_type":"MongoCode","phpdoc_type":"MongoCode","optional":false,"variadic":false,"by_reference":false},{"name":"condition","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Performs an operation similar to SQL's GROUP BY command /","params":[{"name":"keys","declared_type":"mixed","description":"Fields to group by. If an array or non-code object is passed, it will be the key used to group results."},{"name":"initial","declared_type":"array","description":"Initial value of the aggregation counter object."},{"name":"reduce","declared_type":"MongoCode","description":"A function that aggregates (reduces) the objects iterated."},{"name":"condition","declared_type":"array","description":"An condition that must be true for a row to be considered."}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"insert","fqn":"MongoCollection::insert","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":51916,"end":51922}},"declared_type":null,"signature":{"parameters":[{"name":"a","declared_type":null,"phpdoc_type":"array|object","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool|array"},"documentation":{"description":"Inserts an array into the collection Note: If the parameter does not have an _id key or property, a new MongoId instance will be created and assigned to it. This special behavior does not mean that the parameter is passed by reference. <dl> <dt>\"w\"</dt> <dd>See WriteConcerns. The default value for MongoClient is 1.</dd> <dt>\"fsync\"</dt> <dd>Boolean, defaults to FALSE. Forces the insert to be synced to disk before returning success. If TRUE, an acknowledged insert is implied and will override setting w to 0.</dd> <dt>\"timeout\"</dt> <dd>Integer, defaults to MongoCursor::$timeout. If \"safe\" is set, this sets how long (in milliseconds) for the client to wait for a database response. If the database does not respond within the timeout period, a MongoCursorTimeoutException will be thrown.</dd> <dt>\"safe\"</dt> <dd>Deprecated. Please use the WriteConcern w option.</dd> </dl> Otherwise, returns TRUE if the inserted array is not empty (a MongoException will be thrown if the inserted array is empty). If an array is returned, the following keys may be present: <dl> <dt>ok</dt> <dd>This should almost be 1 (unless last_error itself failed).</dd> <dt>err</dt> <dd>If this field is non-null, an error occurred on the previous operation. If this field is set, it will be a string describing the error that occurred.</dd> <dt>code</dt> <dd>If a database error occurred, the relevant error code will be passed back to the client.</dd> <dt>errmsg</dt> <dd>This field is set if something goes wrong with a database command. It is coupled with ok being 0. For example, if w is set and times out, errmsg will be set to \"timed out waiting for slaves\" and ok will be 0. If this field is set, it will be a string describing the error that occurred.</dd> <dt>n</dt> <dd>If the last operation was an update, upsert, or a remove, the number of documents affected will be returned. For insert operations, this value is always 0.</dd> <dt>wtimeout</dt> <dd>If the previous option timed out waiting for replication.</dd> <dt>waited</dt> <dd>How long the operation waited before timing out.</dd> <dt>wtime</dt> <dd>If w was set and the operation succeeded, how long it took to replicate to w servers.</dd> <dt>upserted</dt> <dd>If an upsert occurred, this field will contain the new record's _id field. For upserts, either this field or updatedExisting will be present (unless an error occurred).</dd> <dt>updatedExisting</dt> <dd>If an upsert updated an existing element, this field will be true. For upserts, either this field or upserted will be present (unless an error occurred).</dd> </dl> /","params":[{"name":"a","declared_type":"array|object","description":"An array or object. If an object is used, it may not have protected or private properties."},{"name":"options","declared_type":"array","description":"Options for the insert."}],"return_type":"bool|array","var_type":null,"throws":["MongoException","MongoCursorException","MongoCursorTimeoutException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"remove","fqn":"MongoCollection::remove","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":59655,"end":59661}},"declared_type":null,"signature":{"parameters":[{"name":"criteria","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool|array"},"documentation":{"description":"(PECL mongo &gt;= 0.9.0)<br/> Remove records from this collection include: </p><ul> <li><p><em>\"w\"</em></p><p>See {@link https://secure.php.net/manual/en/mongo.writeconcerns.php Write Concerns}. The default value for <b>MongoClient</b> is <em>1</em>.</p></li> <li> <p> <em>\"justOne\"</em> </p> <p> Specify <strong><code>TRUE</code></strong> to limit deletion to just one document. If <strong><code>FALSE</code></strong> or omitted, all documents matching the criteria will be deleted. </p> </li> <li><p><em>\"fsync\"</em></p><p>Boolean, defaults to <b>FALSE</b>. If journaling is enabled, it works exactly like <em>\"j\"</em>. If journaling is not enabled, the write operation blocks until it is synced to database files on disk. If <strong><code>TRUE</code></strong>, an acknowledged insert is implied and this option will override setting <em>\"w\"</em> to <em>0</em>.</p><blockquote class=\"note\"><p><strong class=\"note\">Note</strong>: <span class=\"simpara\">If journaling is enabled, users are strongly encouraged to use the <em>\"j\"</em> option instead of <em>\"fsync\"</em>. Do not use <em>\"fsync\"</em> and <em>\"j\"</em> simultaneously, as that will result in an error.</p></blockquote></li> <li><p><em>\"j\"</em></p><p>Boolean, defaults to <b>FALSE</b>. Forces the write operation to block until it is synced to the journal on disk. If <strong><code>TRUE</code></strong>, an acknowledged write is implied and this option will override setting <em>\"w\"</em> to <em>0</em>.</p><blockquote class=\"note\"><p><strong class=\"note\">Note</strong>: <span class=\"simpara\">If this option is used and journaling is disabled, MongoDB 2.6+ will raise an error and the write will fail; older server versions will simply ignore the option.</p></blockquote></li> <li><p><em>\"socketTimeoutMS\"</em></p><p>This option specifies the time limit, in milliseconds, for socket communication. If the server does not respond within the timeout period, a <b>MongoCursorTimeoutException</b> will be thrown and there will be no way to determine if the server actually handled the write or not. A value of <em>-1</em> may be specified to block indefinitely. The default value for <b>MongoClient</b> is <em>30000</em> (30 seconds).</p></li> <li><p><em>\"w\"</em></p><p>See {@link https://secure.php.net/manual/en/mongo.writeconcerns.php Write Concerns}. The default value for <b>MongoClient</b> is <em>1</em>.</p></li> <li><p><em>\"wTimeoutMS\"</em></p><p>This option specifies the time limit, in milliseconds, for {@link https://secure.php.net/manual/en/mongo.writeconcerns.php write concern} acknowledgement. It is only applicable when <em>\"w\"</em> is greater than <em>1</em>, as the timeout pertains to replication. If the write concern is not satisfied within the time limit, a <a href=\"class.mongocursorexception.php\" class=\"classname\">MongoCursorException</a> will be thrown. A value of <em>0</em> may be specified to block indefinitely. The default value for {@link https://secure.php.net/manual/en/class.mongoclient.php MongoClient} is <em>10000</em> (ten seconds).</p></li> </ul> <p> The following options are deprecated and should no longer be used: </p><ul> <li><p><em>\"safe\"</em></p><p>Deprecated. Please use the {@link https://secure.php.net/manual/en/mongo.writeconcerns.php write concern} <em>\"w\"</em> option.</p></li> <li><p><em>\"timeout\"</em></p><p>Deprecated alias for <em>\"socketTimeoutMS\"</em>.</p></li> <li><p><b>\"wtimeout\"</b></p><p>Deprecated alias for <em>\"wTimeoutMS\"</em>.</p></li></ul> <em>\"w\"</em> option is set. Otherwise, returns <b>TRUE</b>. </p> <p> Fields in the status array are described in the documentation for <b>MongoCollection::insert()</b>. </p> /","params":[{"name":"criteria","declared_type":"array","description":"[optional] <p>Query criteria for the documents to delete.</p>"},{"name":"options","declared_type":"array","description":"[optional] <p>An array of options for the remove operation. Currently available options"}],"return_type":"bool|array","var_type":null,"throws":["MongoCursorException","MongoCursorTimeoutException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"save","fqn":"MongoCollection::save","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":65791,"end":65795}},"declared_type":null,"signature":{"parameters":[{"name":"a","declared_type":null,"phpdoc_type":"array|object","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|bool"},"documentation":{"description":"Saves an object to this collection Note: If the parameter does not have an _id key or property, a new MongoId instance will be created and assigned to it. See MongoCollection::insert() for additional information on this behavior. <dl> <dt>\"w\" <dd>See WriteConcerns. The default value for MongoClient is 1. <dt>\"fsync\" <dd>Boolean, defaults to FALSE. Forces the insert to be synced to disk before returning success. If TRUE, an acknowledged insert is implied and will override setting w to 0. <dt>\"timeout\" <dd>Integer, defaults to MongoCursor::$timeout. If \"safe\" is set, this sets how long (in milliseconds) for the client to wait for a database response. If the database does not respond within the timeout period, a MongoCursorTimeoutException will be thrown. <dt>\"safe\" <dd>Deprecated. Please use the WriteConcern w option. </dl> Otherwise, returns a boolean representing if the array was not empty (an empty array will not be inserted). /","params":[{"name":"a","declared_type":"array|object","description":"Array to save. If an object is used, it may not have protected or private properties."},{"name":"options","declared_type":"array","description":"Options for the save."}],"return_type":"array|bool","var_type":null,"throws":["MongoException","MongoCursorException","MongoCursorTimeoutException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setReadPreference","fqn":"MongoCollection::setReadPreference","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":47502,"end":47519}},"declared_type":null,"signature":{"parameters":[{"name":"read_preference","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"tags","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL mongo &gt;= 1.3.0)<br/> /","params":[{"name":"read_preference","declared_type":"string","description":"<p>The read preference mode: <b>MongoClient::RP_PRIMARY</b>, <b>MongoClient::RP_PRIMARY_PREFERRED</b>, <b>MongoClient::RP_SECONDARY</b>, <b>MongoClient::RP_SECONDARY_PREFERRED</b>, or <b>MongoClient::RP_NEAREST</b>.</p>"},{"name":"tags","declared_type":"array","description":"[optional] <p>An array of zero or more tag sets, where each tag set is itself an array of criteria used to match tags on replica set members.<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setSlaveOkay","fqn":"MongoCollection::setSlaveOkay","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":46285,"end":46297}},"declared_type":null,"signature":{"parameters":[{"name":"ok","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL mongo &gt;= 1.1.0)<br/> <p> See {@link https://secure.php.net/manual/en/mongo.queries.php the query section} of this manual for information on distributing reads to secondaries. </p> If reads should be sent to secondary members of a replica set for all possible queries using this {@link https://secure.php.net/manual/en/class.mongocollection.php MongoCollection} instance. </p> /","params":[{"name":"ok","declared_type":"bool","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"toIndexString","fqn":"MongoCollection::toIndexString","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":66541,"end":66554}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"/","params":[{"name":"keys","declared_type":"mixed","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"update","fqn":"MongoCollection::update","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":55232,"end":55238}},"declared_type":null,"signature":{"parameters":[{"name":"criteria","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"newobj","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Update records based on a given criteria array(\"optionname\" => boolean, ...). Currently supported options are: \"upsert\": If no document matches $$criteria, a new document will be created from $$criteria and $$new_object (see upsert example). \"multiple\": All documents matching $criteria will be updated. MongoCollection::update has exactly the opposite behavior of MongoCollection::remove- it updates one document by default, not all matching documents. It is recommended that you always specify whether you want to update multiple documents or a single document, as the database may change its default behavior at some point in the future. \"safe\" Can be a boolean or integer, defaults to false. If false, the program continues executing without waiting for a database response. If true, the program will wait for the database response and throw a MongoCursorException if the update did not succeed. If you are using replication and the master has changed, using \"safe\" will make the driver disconnect from the master, throw and exception, and attempt to find a new master on the next operation (your application must decide whether or not to retry the operation on the new master). If you do not use \"safe\" with a replica set and the master changes, there will be no way for the driver to know about the change so it will continuously and silently fail to write. If safe is an integer, will replicate the update to that many machines before returning success (or throw an exception if the replication times out, see wtimeout). This overrides the w variable set on the collection. \"fsync\": Boolean, defaults to false. Forces the update to be synced to disk before returning success. If true, a safe update is implied and will override setting safe to false. \"timeout\" Integer, defaults to MongoCursor::$timeout. If \"safe\" is set, this sets how long (in milliseconds) for the client to wait for a database response. If the database does not respond within the timeout period, a MongoCursorTimeoutException will be thrown /","params":[{"name":"criteria","declared_type":"array","description":"Description of the objects to update."},{"name":"newobj","declared_type":"array","description":"The object with which to update the matching records."},{"name":"options","declared_type":"array","description":"This parameter is an associative array of the form"}],"return_type":"bool","var_type":null,"throws":["MongoCursorException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"validate","fqn":"MongoCollection::validate","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":48047,"end":48055}},"declared_type":null,"signature":{"parameters":[{"name":"scan_data","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Validates this collection /","params":[{"name":"scan_data","declared_type":"bool","description":"Only validate indices, not the base collection."}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"batchSize","fqn":"MongoCommandCursor::batchSize","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":82328,"end":82337}},"declared_type":null,"signature":{"parameters":[{"name":"batchSize","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"MongoCursorInterface","phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"current","fqn":"MongoCommandCursor::current","kind":"Method","origin":"PhpRuntime","extension":"mongo","location":{"file":"mongo/mongo.php","range":{"start":81325,"end":81332}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Return the current element /","params":[],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"