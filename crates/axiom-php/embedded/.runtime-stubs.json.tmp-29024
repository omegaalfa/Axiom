tory, use <b>realpath</b> or dirname(__FILE__). Repository URL to import into. </p> Whether or not to refrain from recursively processing directories. </p> /","params":[{"name":"path","declared_type":"string","description":"<p>"},{"name":"url","declared_type":"string","description":"<p>"},{"name":"nonrecursive","declared_type":"bool","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"svn_info","fqn":"svn_info","kind":"Function","origin":"PhpRuntime","extension":"svn","location":{"file":"svn/svn.php","range":{"start":18760,"end":18768}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"svn_lock","fqn":"svn_lock","kind":"Function","origin":"PhpRuntime","extension":"svn","location":{"file":"svn/svn.php","range":{"start":12739,"end":12747}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"svn_log","fqn":"svn_log","kind":"Function","origin":"PhpRuntime","extension":"svn","location":{"file":"svn/svn.php","range":{"start":7725,"end":7732}},"declared_type":null,"signature":{"parameters":[{"name":"repos_url","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"start_revision","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"end_revision","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"limit","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"flags","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PECL svn &gt;= 0.1.0)<br/> Returns the commit log messages of a repository URL Repository URL of the item to retrieve log history from. </p> Revision number of the first log to retrieve. Use <b>SVN_REVISION_HEAD</b> to retrieve the log from the most recent revision. </p> Revision number of the last log to retrieve. Defaults to <i>start_revision</i> if specified or to <b>SVN_REVISION_INITIAL</b> otherwise. </p> Number of logs to retrieve. </p> Any combination of <b>SVN_OMIT_MESSAGES</b>, <b>SVN_DISCOVER_CHANGED_PATHS</b> and <b>SVN_STOP_ON_COPY</b>. </p> of: <pre> [0] => Array, ordered most recent (highest) revision first ( [rev] => integer revision number [author] => string author name [msg] => string log message [date] => string date formatted per ISO 8601, i.e. date('c') [paths] => Array, describing changed files ( [0] => Array ( [action] => string letter signifying change [path] => absolute repository path of changed file ) [1] => ... ) ) [1] => ... </pre> </p> <p> The output will always be a numerically indexed array of arrays, even when there are none or only one log message(s). </p> <p> The value of action is a subset of the status output in the first column, where possible values are: </p> <table> Actions <tr valign=\"top\"> <td>Letter</td> <td>Description</td> </tr> <tr valign=\"top\"> <td>M</td> <td>Item/props was modified</td> </tr> <tr valign=\"top\"> <td>A</td> <td>Item was added</td> </tr> <tr valign=\"top\"> <td>D</td> <td>Item was deleted</td> </tr> <tr valign=\"top\"> <td>R</td> <td>Item was replaced</td> </tr> </table> <p> If no changes were made to the item, an empty array is returned. /","params":[{"name":"repos_url","declared_type":"string","description":"<p>"},{"name":"start_revision","declared_type":"int","description":"[optional] <p>"},{"name":"end_revision","declared_type":"int","description":"[optional] <p>"},{"name":"limit","declared_type":"int","description":"[optional] <p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"svn_ls","fqn":"svn_ls","kind":"Function","origin":"PhpRuntime","extension":"svn","location":{"file":"svn/svn.php","range":{"start":5443,"end":5449}},"declared_type":null,"signature":{"parameters":[{"name":"repos_url","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"revision_no","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"recurse","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"peg","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"(PECL svn &gt;= 0.1.0)<br/> Returns list of directory contents in repository URL, optionally at revision number Enables recursion. </p> of: <pre> [0] => Array ( [created_rev] => integer revision number of last edit [last_author] => string author name of last edit [size] => integer byte file size of file [time] => string date of last edit in form 'M d H:i' or 'M d Y', depending on how old the file is [time_t] => integer unix timestamp of last edit [name] => name of file/directory [type] => type, can be 'file' or 'dir' ) [1] => ... </pre> /","params":[{"name":"repos_url","declared_type":"string","description":null},{"name":"revision_no","declared_type":"int","description":"[optional]"},{"name":"recurse","declared_type":"bool","description":"[optional] <p>"},{"name":"peg","declared_type":"bool","description":"[optional]"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"svn_mkdir","fqn":"svn_mkdir","kind":"Function","origi