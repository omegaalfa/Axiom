n":{"description":"Given one or more Redis SETS, this command returns all of the members from the first set that are not in any subsequent set. first sorted set, or false on failure. $redis->pipeline() ->del('set1', 'set2', 'set3') ->sadd('set1', 'apple', 'banana', 'carrot', 'date') ->sadd('set2', 'carrot') ->sadd('set3', 'apple', 'carrot', 'eggplant') ->exec(); $redis->sdiff('set1', 'set2', 'set3'); /","params":[{"name":"key","declared_type":"string","description":"The first set"},{"name":"other_keys","declared_type":"string","description":"One or more additional sets"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sdiffcard","fqn":"Redis::sdiffcard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":124485,"end":124494}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Compute the difference of one or more sets and return the cardinality of the result. $redis->sAdd('set1', 'apple', 'pear', 'banana', 'carrot'); $redis->sAdd('set2', 'apple',         'banana'); $redis->sAdd('set3',          'pear', 'banana'); $redis->sdiffcard(['set1', 'set2', 'set3']); /","params":[{"name":"keys","declared_type":"array","description":"One or more set key names."},{"name":"options","declared_type":"array|null","description":"An optional array of options that modifies how the command works."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sDiffStore","fqn":"Redis::sDiffStore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":121167,"end":121177}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"This method performs the same operation as SDIFF except it stores the resulting diff values in a specified destination key. $redis->sDiffStore('diff:set', 'set:all', 'set:archived'); /","params":[{"name":"dst","declared_type":"string","description":"The key where to store the result"},{"name":"key","declared_type":"string","description":"The first key to perform the DIFF on"},{"name":"other_keys","declared_type":"string","description":"One or more additional keys."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"select","fqn":"Redis::select","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":135567,"end":135573}},"declared_type":null,"signature":{"parameters":[{"name":"db","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Select a specific Redis database. /","params":[{"name":"db","declared_type":"int","description":"The database to select.  Note that by default Redis has 16 databases (0-15)."}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"serverName","fqn":"Redis::serverName","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":60071,"end":60081}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Get the server name as reported by the `HELLO` response. $redis->serverName(); /","params":[],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"serverVersion","fqn":"Redis::serverVersion","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":60295,"end":60308}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"string|false","phpdoc_return_type":"string|false"},"documentation":{"description":"Get the server version as reported by the `HELLO` response. $redis->serverVersion(); /","params":[],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"set","fqn":"Redis::set","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":137203,"end":137206}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"mixed","phpdoc_type":"array|int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|string|bool","phpdoc_return_type":"Redis|string|bool"},"documentation":{"description":"Create or set a Redis STRING key to a value. integer with an expiration.  If an expiration is set PhpRedis will actually send the `SETEX` command. OPTION                         DESCRIPTION ------------                   -------------------------------------------------------------- ['EX' => 60]                   expire 60 seconds. ['PX' => 6000]                 expire in 6000 milliseconds. ['EXAT' => time() + 10]        expire in 10 seconds. ['PXAT' => time()*1000 + 1000] expire in 1 second. ['KEEPTTL' => true]            Redis will not update the key's current TTL. ['XX']                         Only set the key if it already exists. ['NX']                         Only set the key if it doesn't exist. ['GET']                        Instead of returning `+OK` return the previous value of the key or NULL if the key didn't exist. /","params":[{"name":"key","declared_type":"string","description":"The key name to set."},{"name":"value","declared_type":"mixed","description":"The value to set the key to."},{"name":"options","declared_type":"array|int","description":"Either an array with options for how to perform the set or an"}],"return_type":"Redis|string|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setBit","fqn":"Redis::setBit","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":137757,"end":137763}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"idx","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"bool","phpdoc_type":"bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Set a specific bit in a Redis string to zero or one $redis->set('foo', 'bar'); $redis->setbit('foo', 7, 1); /","params":[{"name":"key","declared_type":"string","description":"The Redis STRING key to modify"},{"name":"value","declared_type":"bool","description":"Whether to set the bit to zero or one."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setDefer","fqn":"Redis::setDefer","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":1047,"end":1055}},"declared_type":null,"signature":{"parameters":[{"name":"defer","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"defer","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setEx","fqn":"Redis::setEx","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":1822,"end":1827}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"expire","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"mixed","description":null},{"name":"expire","declared_type":"mixed","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setex","fqn":"Redis::setex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":141323,"end":141328}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"expire","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Set a Redis STRING key with a specific expiration in seconds. /","params":[{"name":"key","declared_type":"string","description":"The name of the key to set."},{"name":"expire","declared_type":"int","description":"The key's expiration in seconds."},{"name":"value","declared_type":"mixed","description":"The value to set the key."}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setNx","fqn":"Redis::setNx","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":9321,"end":9326}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"mixed","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setnx","fqn":"Redis::setnx","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":141868,"end":141873}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Set a key to a value, but only if that key does not already exist. /","params":[{"name":"key","declared_type":"string","description":"The key name to set."},{"name":"value","declared_type":"mixed","description":"What to set the key to."}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setOption","fqn":"Redis::setOption","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":140786,"end":140795}},"declared_type":null,"signature":{"parameters":[{"name":"option","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Set a configurable option on the Redis object. Following are a list of options you can set: | OPTION          | TYPE | DESCRIPTION | | --------------- | ---- | ----------- | | OPT_MAX_RETRIES | int  | The maximum number of times Redis will attempt to reconnect if it gets disconnected, before throwing an exception. | | OPT_SCAN        | enum | Redis::OPT_SCAN_RETRY, or Redis::OPT_SCAN_NORETRY.  Whether PhpRedis should automatically SCAN again when zero keys but a nonzero iterator are returned. | | OPT_SERIALIZER  | enum | Set the automatic data serializer.<br>`Redis::SERIALIZER_NONE`<br>`Redis::SERIALIZER_PHP`<br>`Redis::SERIALIZER_IGBINARY`<br>`Redis::SERIALIZER_MSGPACK`, `Redis::SERIALIZER_JSON`| | OPT_PREFIX | string | A string PhpRedis will use to prefix every key we read or write. | | OPT_READ_TIMEOUT | float | How long PhpRedis will block for a response from Redis before throwing a 'read error on connection' exception. | | OPT_TCP_KEEPALIVE | bool |   Set or disable TCP_KEEPALIVE on the connection. | | OPT_COMPRESSION | enum | Set the compression algorithm<br>`Redis::COMPRESSION_NONE`<br>`Redis::COMPRESSION_LZF`<br>`Redis::COMPRESSION_LZ4`<br> `Redis::COMPRESSION_ZSTD` | | OPT_REPLY_LITERAL | bool | If set to true, PhpRedis will return the literal string Redis returns for LINE replies (e.g. '+OK'), rather than `true`. | | OPT_COMPRESSION_LEVEL | int | Set a specific compression level if Redis is compressing data. | | OPT_NULL_MULTIBULK_AS_NULL | bool | Causes PhpRedis to return `NULL` rather than `false` for NULL MULTIBULK replies | | OPT_BACKOFF_ALGORITHM | enum | The exponential backoff strategy to use. | | OPT_BACKOFF_BASE | int | The minimum delay between retries when backing off. | | OPT_BACKOFF_CAP  | int | The maximum delay between replies when backing off. | $redis->setOption(Redis::OPT_PREFIX, 'app:'); /","params":[{"name":"option","declared_type":"int","description":"The option constant."},{"name":"value","declared_type":"mixed","description":"The option value."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setOptions","fqn":"Redis::setOptions","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":866,"end":876}},"declared_type":null,"signature":{"parameters":[{"name":"options","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"options","declared_type":"mi