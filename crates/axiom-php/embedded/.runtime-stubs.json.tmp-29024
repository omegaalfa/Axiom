n read errors occur phpredis-compatibility: bool,          // Whether to use PhpRedis compatibility mode (https://relay.so/docs/compatibility) persistent: bool,                      // Whether to use a persistent connection prefix: string,                        // Prefix used for all keys database: int,                         // Database index to switch to auth: string|array<string>,            // Password or ACL credentials max-retries: int,                      // Number of reconnection attempts when a command or connection fails serializer: int,                       // The serializer to use (see `OPT_SERIALIZER_*` constants) compression: int,                      // The compression algorithm to use (see `OPT_COMPRESSION_*` constants) compression-level: int,                // The compression level to use stream: array<string, mixed>,          // TLS options (see https://www.php.net/manual/en/context.ssl.php) reply-literal: bool,                   // Whether to return reply literals like `OK` instead of `true` null-mbulk-as-null: bool,              // Whether to return multibulk as empty array or `null` capa-redirect: bool,                   // Whether to use CAPA redirects (https://valkey.io/commands/client-capa/) } $context /","params":[{"name":"host","declared_type":"string|array|null","description":null},{"name":"port","declared_type":"int","description":null},{"name":"connect_timeout","declared_type":"float","description":null},{"name":"command_timeout","declared_type":"float","description":null},{"name":"context","declared_type":"array","description":null},{"name":"database","declared_type":"int","description":null}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_compress","fqn":"Relay::_compress","kind":"Method","origin":"PhpRuntime","extension":"relay","location":{"file":"relay/Relay.php","range":{"start":20939,"end":20948}},"declared_type":null,"signature":{"param