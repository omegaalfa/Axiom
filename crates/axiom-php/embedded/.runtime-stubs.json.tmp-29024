,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"(PHP 5 &gt;= 5.1.2, PECL hash &gt;= 1.1)<br/> Pump data into an active hashing context from an open stream Hashing context returned by {@see hash_init}. </p> Open file handle as returned by any stream creation function. </p> Maximum number of characters to copy from <i>handle</i> into the hashing context. </p> /","params":[{"name":"context","declared_type":"HashContext|resource","description":"<p>"},{"name":"stream","declared_type":"resource","description":"<p>"},{"name":"length","declared_type":"int","description":"[optional] <p>"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"header","fqn":"header","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":28679,"end":28685}},"declared_type":null,"signature":{"parameters":[{"name":"header","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"replace","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"response_code","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Send a raw HTTP header The header string. </p> <p> There are two special-case header calls. The first is a header that starts with the string \"HTTP/\" (case is not significant), which will be used to figure out the HTTP status code to send. For example, if you have configured Apache to use a PHP script to handle requests for missing files (using the ErrorDocument directive), you may want to make sure that your script generates the proper status code. </p> <p> Example: <code> <?php // This example illustrates the \"HTTP/\" special case // Better alternatives in typical use cases include: // 1. header($_SERVER[\"SERVER_PROTOCOL\"] . \" 404 Not Found\"); //    (to override http status messages for clients that are still using HTTP/1.0) // 2. http_response_code(404); (to use the default message) header(\"HTTP/1.1 404 Not Found\"); ?> </code> </p> <p> The second special case is the \"Location:\" header. Not only does it send this header back to the browser, but it also returns a REDIRECT (302) status code to the browser unless the 201 or a 3xx status code has already been set. </p> <p>Example</p> <code> header(\"Location: http://www.example.com/\"); exit; </code> The optional replace parameter indicates whether the header should replace a previous similar header, or add a second header of the same type. By default it will replace, but if you pass in false as the second argument you can force multiple headers of the same type. </p> <p>For example:</p> <code> <?php header('WWW-Authenticate: Negotiate'); header('WWW-Authenticate: NTLM', false); ?> </code> Forces the HTTP response code to the specified value. Note that this parameter only has an effect if the header is not empty. </p> /","params":[{"name":"header","declared_type":"string","description":"<p>"},{"name":"replace","declared_type":"bool","description":"[optional] <p>"},{"name":"response_code","declared_type":"int","description":"<p>"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"header_register_callback","fqn":"header_register_callback","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":2316,"end":2340}},"declared_type":null,"signature":{"parameters":[{"name":"callback","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Registers a function that will be called when PHP starts sending output. The callback is executed just after PHP prepares all headers to be sent,<br> and before any other output is sent, creating a window to manipulate the outgoing headers before being sent. /","params":[{"name":"callback","declared_type":"callable","description":"Function called just before the headers are sent."}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"header_remove","fqn":"header_remove","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":29010,"end":29023}},"declared_type":null,"signature":{"parameters":[{"name":"name","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"void","phpdoc_return_type":"void"},"documentation":{"description":"Remove previously set headers The header name to be removed. </p> This parameter is case-insensitive. /","params":[{"name":"name","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"headers_list","fqn":"headers_list","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_4.php","range":{"start":29873,"end":29885}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"array","phpdoc_return_type":"array"},"documentation":{"description":"Returns a list of response headers sent (or ready to send) /","params":[],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"headers_send","fqn":"headers_send","kind":"Function","origin":"PhpRuntime","extension":"frankenphp","location":{"file":"frankenphp/frankenphp.php","range"