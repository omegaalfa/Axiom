ion":"[optional] Only used if compiled with ImageMagick (library) > 7"}],"return_type":"Imagick","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"swirlImage","fqn":"Imagick::swirlImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":112546,"end":112556}},"declared_type":null,"signature":{"parameters":[{"name":"degrees","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL imagick 2.0.0)<br/> Swirls the pixels about the center of the image /","params":[{"name":"degrees","declared_type":"float","description":null}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"textureImage","fqn":"Imagick::textureImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":164717,"end":164729}},"declared_type":null,"signature":{"parameters":[{"name":"texture_wand","declared_type":"Imagick","phpdoc_type":"Imagick","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Imagick"},"documentation":{"description":"(PECL imagick 2.0.0)<br/> Repeatedly tiles the texture image /","params":[{"name":"texture_wand","declared_type":"Imagick","description":null}],"return_type":"Imagick","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"thresholdImage","fqn":"Imagick::thresholdImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":94840,"end":94854}},"declared_type":null,"signature":{"parameters":[{"name":"threshold","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"channel","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL imagick 2.0.0)<br/> Changes the value of individual pixels based on a threshold /","params":[{"name":"threshold","declared_type":"float","description":null},{"name":"channel","declared_type":"int","description":"[optional]"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"thumbnailImage","fqn":"Imagick::thumbnailImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":81400,"end":81414}},"declared_type":null,"signature":{"parameters":[{"name":"columns","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"rows","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"bestfit","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"fill","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"legacy","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Changes the size of an image to the given dimensions and removes any associated profiles.<br> If legacy is true, the calculations are done with the small rounding bug that existed in Imagick before 3.4.0.<br> If false, the calculations should produce the same results as ImageMagick CLI does.<br> <br> <b>Note:</b> The behavior of the parameter bestfit changed in Imagick 3.0.0. Before this version given dimensions 400x400 an image of dimensions 200x150 would be left untouched. In Imagick 3.0.0 and later the image would be scaled up to size 400x300 as this is the \"best fit\" for the given dimensions. If bestfit parameter is used both width and height must be given. Image width </p> Image height </p> Whether to force maximum values </p> The behavior of the parameter bestfit changed in Imagick 3.0.0. Before this version given dimensions 400x400 an image of dimensions 200x150 would be left untouched. In Imagick 3.0.0 and later the image would be scaled up to size 400x300 as this is the \"best fit\" for the given dimensions. If bestfit parameter is used both width and height must be given. /","params":[{"name":"columns","declared_type":"int","description":"<p>"},{"name":"rows","declared_type":"int","description":"<p>"},{"name":"bestfit","declared_type":"bool","description":"[optional] <p>"},{"name":"fill","declared_type":"bool","description":"[optional]"},{"name":"legacy","declared_type":"bool","description":"[optional] Added since 3.4.0. Default value FALSE"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"tintImage","fqn":"Imagick::tintImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":165367,"end":165376}},"declared_type":null,"signature":{"parameters":[{"name":"tint","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"opacity","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"legacy","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"pplies a color vector to each pixel in the image. The 'opacity' color is a per channel strength factor for how strongly the color should be applied. If legacy is true, the behaviour of this function is incorrect, but consistent with how it behaved before Imagick version 3.4.0 /","params":[{"name":"tint","declared_type":"mixed","description":null},{"name":"opacity","declared_type":"mixed","description":null},{"name":"legacy","declared_type":"bool","description":"[optional]"}],"return_type":"bool","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"transformImage","fqn":"Imagick::transformImage","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":41157,"end":41171}},"declared_type":null,"signature":{"parameters":[{"name":"crop","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"geometry","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"Imagick"},"documentation":{"description":"(PECL imagick 2.0.0)<br/> Convenience method for setting crop size and the image geometry A crop geometry string. This geometry defines a subregion of the image to crop. </p> An image geometry string. This geometry defines the final size of the image. </p> /","params":[{"name":"crop","declared_type":"string","description":"<p>"},{"name":"geometry","declared_type":"string","description":"<p>"}],"return_type":"Imagick","var_type":null,"throws":["ImagickException"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"transformImageColorspace","fqn":"Imagick::transformImageColorspace","kind":"Method","origin":"PhpRuntime","extension":"imagick","location":{"file":"imagick/imagick.php","range":{"start":70498,"end":70522}},"declared_type":null,"signature":{"parameters":[{"name":"COLORSPACE","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"dec