rence":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PECL memcache &gt;= 2.0.0)<br/> Get statistics from all servers in pool Used in conjunction with <b>type</b> set to cachedump to identify the slab to dump from. The cachedump command ties up the server and is strictly to be used for debugging purposes. </p> Returns a two-dimensional associative array of server statistics or <b>FALSE</b> on failure. /","params":[{"name":"memcache","declared_type":"Memcache","description":null},{"name":"type","declared_type":"string","description":"[optional] <p>The type of statistics to fetch. Valid values are {reset, malloc, maps, cachedump, slabs, items, sizes}. According to the memcached protocol spec these additional arguments \"are subject to change for the convenience of memcache developers\".</p>"},{"name":"slabid","declared_type":"int","description":"[optional] <p>"},{"name":"limit","declared_type":"int","description":"Used in conjunction with type set to cachedump to limit the number of entries to dump."}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"memcache_get_server_status","fqn":"memcache_get_server_status","kind":"Function","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":27884,"end":27910}},"declared_type":null,"signature":{"parameters":[{"name":"memcache","declared_type":null,"phpdoc_type":"Memcache","optional":false,"variadic":false,"by_reference":false},{"name":"host","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"(PECL memcache &gt;= 2.1.0)<br/> Returns server status /","params":[{"name":"memcache","de