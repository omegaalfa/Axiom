rned data. </p> on failure. /","params":[{"name":"blob_handle","declared_type":"resource","description":"<p>"},{"name":"len","declared_type":"int","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_blob_import","fqn":"fbird_blob_import","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":44605,"end":44622}},"declared_type":null,"signature":{"parameters":[{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"file_handle","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"This is an alias of ibase_blob_import Create blob, copy file in it, and close it An InterBase link identifier. If omitted, the last opened link is assumed. </p> The file handle is a handle returned by fopen. </p> /","params":[{"name":"link_identifier","declared_type":"resource","description":"<p>"},{"name":"file_handle","declared_type":"resource","description":"<p>"}],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_blob_info","fqn":"fbird_blob_info","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":41221,"end":41236}},"declared_type":null,"signature":{"parameters":[{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"blob_id","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"This is an alias of ibase_blob_info Return blob length and other useful info An InterBase link identifier. If omitted, the last opened link is assumed. </p> A BLOB id. </p> consists of the length of the BLOB, the number of segments it contains, the size of the largest segment, and whether it is a stream BLOB or a segmented BLOB. /","params":[{"name":"link_identifier","declared_type":"resource","description":"<p>"},{"name":"blob_id","declared_type":"string","description":"<p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_blob_open","fqn":"fbird_blob_open","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":43399,"end":43414}},"declared_type":null,"signature":{"parameters":[{"name":"link_identifier","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"blob_id","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"This is an alias of ibase_blob_open Open blob for retrieving data parts An InterBase link identifier. If omitted, the last opened link is assumed. </p> A BLOB id. </p> fbird_blob_get or false on failure. /","params":[{"name":"link_identifier","declared_type":"resource","description":"<p>"},{"name":"blob_id","declared_type":"string","description":"<p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_close","fqn":"fbird_close","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":28365,"end":28376}},"declared_type":null,"signature":{"parameters":[{"name":"connection_id","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"This is an alias of ibase_close Close a connection to an InterBase database An InterBase link identifier returned from fbird_connect. If omitted, the last opened link is assumed. </p> /","params":[{"name":"connection_id","declared_type":"resource","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_commit","fqn":"fbird_commit","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":38321,"end":38333}},"declared_type":null,"signature":{"parameters":[{"name":"link_or_trans_identifier","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"This is an alias of ibase_commit Commit a transaction If called without an argument, this function commits the default transaction of the default link. If the argument is a connection identifier, the default transaction of the corresponding connection will be committed. If the argument is a transaction identifier, the corresponding transaction will be committed. </p> /","params":[{"name":"link_or_trans_identifier","declared_type":"resource","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_commit_ret","fqn":"fbird_commit_ret","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":39761,"end":39777}},"declared_type":null,"signature":{"parameters":[{"name":"link_or_trans_identifier","declared_type":null,"phpdoc_type":"resource","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"This is an alias of ibase_commit_ret Commit a transaction without closing it If called without an argument, this function commits the default transaction of the default link. If the argument is a connection identifier, the default transaction of the corresponding connection will be committed. If the argument is a transaction identifier, the corresponding transaction will be committed. The transaction context will be retained, so statements executed from within this transaction will not be invalidated. </p> /","params":[{"name":"link_or_trans_identifier","declared_type":"resource","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_connect","fqn":"fbird_connect","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":26132,"end":26145}},"declared_type":null,"signature":{"parameters":[{"name":"database","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"username","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"password","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"charset","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"buffers","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"dialect","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"role","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"sync","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"resource|false"},"documentation":{"description":"This is an alias of ibase_connect Open a connection to an InterBase database The database argument has to be a valid path to database file on the server it resides on. If the server is not local, it must be prefixed with either 'hostname:' (TCP/IP), '//hostname/' (NetBEUI) or 'hostname@' (IPX/SPX), depending on the connection protocol used. </p> The user name. Can be set with the fbird.default_user &php.ini; directive. </p> The password for username. Can be set with the fbird.default_password &php.ini; directive. </p> charset is the default character set for a database. </p> buffers is the number of database buffers to allocate for the server-side cache. If 0 or omitted, server chooses its own default. </p> dialect selects the default SQL dialect for any statement executed within a connection, and it defaults to the highest one supported by client libraries. Functional only with InterBase 6 and up. </p> Functional only with InterBase 5 and up. </p> </p> /","params":[{"name":"database","declared_type":"string","description":"[optional] <p>"},{"name":"username","declared_type":"string","description":"[optional] <p>"},{"name":"password","declared_type":"string","description":"[optional] <p>"},{"name":"charset","declared_type":"string","description":"[optional] <p>"},{"name":"buffers","declared_type":"int","description":"[optional] <p>"},{"name":"dialect","declared_type":"int","description":"[optional] <p>"},{"name":"role","declared_type":"string","description":"[optional] <p>"},{"name":"sync","declared_type":"int","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fbird_db_info","fqn":"fbird_db_info","kind":"Function","origin":"PhpRuntime","extension":"interbase","location":{"file":"interbase/interbase.php","range":{"start":488