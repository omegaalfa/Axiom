","description":"The vector set to modify."},{"name":"member","declared_type":"mixed","description":"The member to modify."},{"name":"attributes","declared_type":"array|string","description":"The attributes to set. This should either"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"vsim","fqn":"Redis::vsim","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":183996,"end":184000}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|null","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Query similarity of a vector by element or scores will attempt to infer which it is, but since there can be some ambiguity here due to serialization you can also explicitly specify `ELE`, `VALUES`, or `FP32` in the options array. $redis->vsim('embeddings', 'doc:1', ['COUNT' => 3]); /","params":[{"name":"key","declared_type":"string","description":"The vector set to query."},{"name":"member","declared_type":"mixed","description":"Either an element or array of scores. PhpRedis"},{"name":"options","declared_type":"array|null","description":"An optional options array"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wait","fqn":"Redis::wait","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":163133,"end":163137}},"declared_type":null,"signature":{"parameters":[{"name":"numreplicas","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Block the client up to the provided timeout until a certain number of replicas have confirmed receiving them. $redis->wait(1, 1000); /","params":[{"name":"numreplicas","declared_type":"int","description":"The number of replicas we want to confirm write operations"},{"name":"timeout","declared_type":"int","description":"How long to wait (zero meaning forever)."}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"waitaof","fqn":"Redis::waitaof","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":9948,"end":9955}},"declared_type":null,"signature":{"parameters":[{"name":"numlocal","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"numreplicas","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"timeout","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"$redis->waitaof(1, 1, 5000); /","params":[],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"watch","fqn":"Redis::watch","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":162528,"end":162533}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Watch one or more keys for conditional execution of a transaction. string key names may be passed variadically. $redis1 = new Redis(['host' => 'localhost']); $redis2 = new Redis(['host' => 'localhost']); // Start watching 'incr-key' $redis1->watch('incr-key'); // Retrieve its value. $val = $redis1->get('incr-key'); // A second client modifies 'incr-key' after we read it. $redis2->set('incr-key', 0); // Because another client changed the value of 'incr-key' after we read it, this // is no longer a proper increment operation, but because we are `WATCH`ing the // key, this transaction will fail and we can try again. // // If were to comment out the above `$redis2->set('incr-key', 0)` line the // transaction would succeed. $redis1->multi(); $redis1->set('incr-key', $val + 1); $res = $redis1->exec(); // bool(false) var_dump($res); /","params":[{"name":"key","declared_type":"array|string","description":"Either an array with one or more key names, or a string key name"},{"name":"other_keys","declared_type":"string","description":"If the first argument was passed as a string, any number of additional"}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xAck","fqn":"Redis::xAck","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":26837,"end":26841}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"group_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"id","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"/","params":[],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xack","fqn":"Redis::xack","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":164688,"end":164692}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"group","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"ids","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Acknowledge one or more messages that are pending (have been consumed using XREADGROUP but not yet acknowledged by XACK.) $redis->xAdd('ships', '*', ['name' => 'Enterprise']); $redis->xAdd('ships', '*', ['name' => 'Defiant']); $redis->xGroup('CREATE', 'ships', 'Federation', '0-0'); // Consume a single message with the consumer group 'Federation' $ship = $redis->xReadGroup('Federation', 'Picard', ['ships' => '>'], 1); /* Retrieve the ID of the message we read. assert(isset($ship['ships'])); $id = key($ship['ships']); // The message we just read is now pending. $res = $redis->xPending('ships', 'Federation')); var_dump($res); // We can tell Redis we were able to process the message by using XACK $res = $redis->xAck('ships', 'Federation', [$id]); assert($res === 1); // The message should no longer be pending. $res = $redis->xPending('ships', 'Federation'); var_dump($res); /","params":[{"name":"key","declared_type":"string","description":"The stream to query."},{"name":"group","declared_type":"string","description":"The consumer group to use."},{"name":"ids","declared_type":"array","description":"An array of stream entry IDs."}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xAdd","fqn":"Redis::xAdd","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":23461,"end":23465}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"id","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"pairs","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"void|false"},"documentation":{"description":"/","params":[{"name":"options","declared_type":"array","description":"Accepted options: \"nomkstream\", \"maxlen\", \"minid\", and \"limit\"."}],"return_type":"void|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xadd","fqn":"Redis::xadd","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":166165,"end":166169}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"id","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"maxlen","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"approx","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"nomkstream","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|string|false","phpdoc_return_type":null},"documentation":{"description":"Append a message to a stream. which means Redis will generate the ID that appends the message to the end of the stream.  It can also be a value in the form <ms>-* which will generate an ID that appends to the end of entries with the same <ms> value (if any exist). oldest messages in the stream until the length is <= $maxlen. but in a more efficient way, meaning the trimming may not be exactly to `$maxlen` values. /","params":[{"name":"key","declared_type":"string","description":"The stream name."},{"name":"id","declared_type":"string","description":"The ID for the message we want to add.  This can be the special value '*'"},{"name":"maxlen","declared_type":"int","description":"If specified Redis will append the new message but trim any number of the"},{"name":"approx","declared_type":"bool","description":"Used in conjunction with `$maxlen`, this flag tells Redis to trim the stream"},{"name":"nomkstream","declared_type":"bool","description":"If passed as `TRUE`, the stream must exist for Redis to append the message."}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xAutoClaim","fqn":"Redis::xAutoClaim","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":27568,"end":27578}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"group_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"consumer_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"min_idle_time","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"/","params":[{"name":"options","declared_type":"array","description":"Accepted options: \"count\" and \"justid\"."}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xautoclaim","fqn":"Redis::xautoclaim","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":168138,"end":168148}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"group","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"consumer","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min_idle","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"start","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"justid","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool|array","phpdoc_return_type":"Redis|array|bool"},"documentation":{"description":"This command allows a consumer to claim pending messages that have been idle for a specified period of time. Its purpose is to provide a mechanism for picking up messages that may have had a failed consumer. $redis->xGroup('CREATE', 'ships', 'combatants', '0-0', true); $redis->xAdd('ships', '1424-74205', ['name' => 'Defiant']); // Consume the ['name' => 'Defiant'] message $msgs = $redis->xReadGroup('combatants', \"Jem'Hadar\", ['ships' => '>'], 1); // The \"Jem'Hadar\" consumer has the message presently $pending = $redis->xPending('ships', 'combatants'); var_dump($pending); // Assume control of the pending message with a different consumer. $res = $redis->xAutoClaim('ships', 'combatants', 'Sisko', 0, '0-0'); // Now the 'Sisko' consumer owns the message $pending = $redis->xPending('ships', 'combatants'); var_dump($pending); /","params":[{"name":"key","declared_type":"string","description":"The stream to check."},{"name":"group","declared_type":"string","description":"The consumer group to query."},{"name":"consumer","declared_type":"string","description":"Which consumer to check."},{"name":"min_idle","declared_type":"int","description":"The minimum time in milliseconds for the message to have been pending."},{"name":"start","declared_type":"string","description":"The minimum message id to check."},{"name":"count","declared_type":"int","description":"An optional limit on how many messages are returned."},{"name":"justid","declared_type":"bool","description":"If the client only wants message IDs and not all of their data."}],"return_type":"Redis|array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xClaim","fqn":"Redis::xClaim","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":27183,"end":27189}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"group_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"consumer_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"min_idle_time","declared_type":"int","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"id","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"/","params":[{"name":"options","declared_type":"array","description":"Accepted options: \"idle\", \"time\", \"retrycount\", \"force\", and \"justid\"."}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xclaim","fqn":"Redis::xclaim","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":171409,"end":171415}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"group","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"consumer","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"min_idle","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"ids","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|bool","phpdoc_return_type":"Redis|array|bool"},"documentation":{"description":"This method allows a consumer to take ownership of pending stream entries, by ID.  Another command that does much the same thing but does not require passing specific IDs is `Redis::xAutoClaim`. ```php # Following is an options array describing every option you can pass.  Note that # 'IDLE', and 'TIME' are mutually exclusive. $options = [ 'IDLE'       => 3           # Set the idle time of the message to a 3.  By default # the idle time is set to zero. 'TIME'       => 1000*time() # Same as IDLE except it takes a unix timestamp in # milliseconds. 'RETRYCOUNT' => 0           # Set the retry counter to zero.  By default XCLAIM # doesn't modify the counter. 'FORCE'                     # Creates the pending message entry even if IDs are # not already # in the PEL with another client. 'JUSTID'                    # Return only an array of IDs rather than the messages # themselves. ]; ``` $redis->xGroup('CREATE', 'ships', 'combatants', '0-0', true); $redis->xAdd('ships', '1424-74205', ['name' => 'Defiant']); // Consume the ['name' => 'Defiant'] message $msgs = $redis->xReadGroup('combatants', \"Jem'Hadar\", ['ships' => '>'], 1); // The \"Jem'Hadar\" consumer has the message presently $pending = $redis->xPending('ships', 'combatants'); var_dump($pending); assert($pending && isset($pending[1])); // Claim the message by ID. $claimed = $redis->xClaim('ships', 'combatants', 'Sisko', 0, [$pending[1]], ['JUSTID']); var_dump($claimed); // Now the 'Sisko' consumer owns the message $pending = $redis->xPending('ships', 'combatants'); var_dump($pending); /","params":[{"name":"key","declared_type":"string","description":"The stream we wish to claim messages for."},{"name":"group","declared_type":"string","description":"Our consumer group."},{"name":"consumer","declared_type":"string","description":"Our consumer."},{"name":"min_idle","declared_type":"int","description":"The minimum idle-time in milliseconds a message must have for ownership to be transferred."},{"name":"options","declared_type":"array","description":"An options array that modifies how the command operates."}],"return_type":"Redis|array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xDel","fqn":"Redis::xDel","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":24026,"end":24030}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"id","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"/","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xdel","fqn":"Redis::xdel","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":171955,"end":171959}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"ids","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Remove one or more specific IDs from a stream. /","params":[{"name":"key","declared_type":"string","description":"The stream to modify."},{"name":"ids","declared_type":"array","description":"One or more message IDs to remove."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xdelex","fqn":"Redis::xdelex","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":172714,"end":172720}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"ids","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Remove one or more IDs from a stream with extended options. are as follows: KEEPREF | DELREF | ACKED deleted and 0 if not. $redis->xadd('s', '*', ['field' => 'value1']); $redis->xdelex('s', ['1-0'], 'KEEPREF'); /","params":[{"name":"key","declared_type":"string","description":"The stream to modify."},{"name":"ids","declared_type":"array","description":"One or more message IDs to remove."},{"name":"mode","declared_type":"string|null","description":"An optional mode argument.  Valid modes"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xgroup","fqn":"Redis::xgroup","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":175602,"end":175608}},"declared_type":null,"signature":{"parameters":[{"name":"operation","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"group","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"id_or_consumer","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"mkstream","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false},{"name":"entries_read","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"XGROUP Perform various operation on consumer groups for a particular Redis STREAM.  What the command does is primarily based on which operation is passed. 'HELP'           - Redis will return information about the command Requires: none 'CREATE'         - Create a consumer group. Requires:  Key, group, consumer. 'SETID'          - Set the ID of an existing consumer group for the stream. Requires:  Key, group, id. 'CREATECONSUMER' - Create a new consumer group for the stream.  You must also pass key, group, and the consumer name you wish to create. Requires:  Key, group, consumer. 'DELCONSUMER'    - Delete a consumer from group attached to the stream. Requires:  Key, group, consumer. 'DESTROY'        - Delete a consumer group from a stream. Requires:  Key, group. for information about which to send. cause Redis to also create the STREAM if it doesn't currently exist. only relevant to the 'CREATE' and 'SETID' operations. Note:  Requires Redis >= 7.0.0. $redis->xgroup('CREATE', 'mystream', 'workers', '$'); /","params":[{"name":"operation","declared_type":"string","description":"The subcommand you intend to execute.  Valid options are as follows"},{"name":"key","declared_type":"string|null","description":"The STREAM we're operating on."},{"name":"group","declared_type":"string|null","description":"The consumer group we want to create/modify/delete."},{"name":"id_or_consumer","declared_type":"string|null","description":"The STREAM id (e.g. '$') or consumer group.  See the operation section"},{"name":"mkstream","declared_type":"bool","description":"This flag may be sent in combination with the 'CREATE' operation, and"},{"name":"entries_read","declared_type":"int","description":"Allows you to set Redis' 'entries-read' STREAM value.  This argument is"}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xGroupCreate","fqn":"Redis::xGroupCreate","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":24884,"end":24896}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"group_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"id","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"mkstream","declared_type":"bool","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"/","params":[],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"xGroupCreateConsumer","fqn":"Redis::xGroupCreateConsumer","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":25537,"end":25557}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"group_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"consumer_name","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"/","params":[],"return_typ