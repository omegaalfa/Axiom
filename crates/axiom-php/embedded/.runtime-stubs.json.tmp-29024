e|GdImage","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Set the brush image for line drawing An image resource. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"brush","declared_type":"resource|GdImage","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagesetclip","fqn":"imagesetclip","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":73689,"end":73701}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"x1","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"y1","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"x2","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"y2","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"<b>imagesetclip()</b> sets the current clipping rectangle, i.e. the area beyond which no pixels will be drawn. /","params":[{"name":"image","declared_type":"resource|GdImage","description":"An image resource, returned by one of the image creation functions, such as {@see imagecreatetruecolor()}."},{"name":"x1","declared_type":"int","description":"The x-coordinate of the upper left corner."},{"name":"y1","declared_type":"int","description":"The y-coordinate of the upper left corner."},{"name":"x2","declared_type":"int","description":"The x-coordinate of the lower right corner."},{"name":"y2","declared_type"