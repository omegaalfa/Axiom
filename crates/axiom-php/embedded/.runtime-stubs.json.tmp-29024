l/en/class.intltimezone.php\" IntlTimeZone}, which will be used directly. </p> </li> <li> <p> A {@link \"https://secure.php.net/manual/en/class.datetimezone.php\" DateTimeZone}. Its identifier will be extracted and an ICU timezone object will be created; the timezone will be backed by ICU's database, not PHP's. </p> </li> <li> <p> A {@link \"https://secure.php.net/manual/en/language.types.string.php\" string}, which should be a valid ICU timezone identifier. See <b>IntlTimeZone::createTimeZoneIDEnumeration()</b>. Raw offsets such as <em>\"GMT+08:30\"</em> are also accepted. </p> </li> </ul> </p> /","params":[{"name":"formatter","declared_type":"IntlDateFormatter","description":null},{"name":"timezone","declared_type":"IntlTimeZone|DateTimeZone|string|null","description":"<p>"}],"return_type":"bool|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"datefmt_set_timezone_id","fqn":"datefmt_set_timezone_id","kind":"Function","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":202587,"end":202610}},"declared_type":null,"signature":{"parameters":[{"name":"mf","declared_type":"MessageFormatter","phpdoc_type":"MessageFormatter","optional":false,"variadic":false,"by_reference":false},{"name":"zone","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5 &gt;= 5.3.0, PECL intl &gt;= 1.0.0)<br/> Sets the time zone to use The time zone ID string of the time zone to use. If <b>NULL</b> or the empty string, the default time zone for the runtime is used. </p> /","params":[{"name":"mf","declared_type":"MessageFormatter","description":null},{"name":"zone","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"db2_autocommit","fqn":"db2_autocommit","kind":"Function","origin":"PhpRuntime","extension":"ibm_db2","location":{"file":"ibm_db2/ibm_db2.php","range":{"start":5165,"end":5179}},"declared_type":null,"signature":{"parameters":[{"name":"connection","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"?int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"int|bool","phpdoc_return_type":"int|bool"},"documentation":{"description":"Returns or sets the AUTOCOMMIT state for a database connection A valid database connection resource variable as returned from db2_connect or db2_pconnect. </p> One of the following constants:</p> <p> DB2_AUTOCOMMIT_OFF Turns AUTOCOMMIT off. </p> <p> DB2_AUTOCOMMIT_ON Turns AUTOCOMMIT on. </p> connection parameter, it returns the current state of AUTOCOMMIT for the requested connection as an integer value. A value of 0 indicates that AUTOCOMMIT is off, while a value of 1 indicates that AUTOCOMMIT is on. </p> <p> When db2_autocommit receives both the connection parameter and autocommit parameter, it attempts to set the AUTOCOMMIT state of the requested connection to the corresponding state. true on success or false on failure.</p> /","params":[{"name":"connection","declared_type":"resource","description":"<p>"},{"name":"value","declared_type":"int","description":"<p>"}],"return_type":"int|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"db2_bind_param","fqn":"db2_bind_param","kind":"Function","origin":"PhpRuntime","extension":"ibm_db2","location":{"file":"ibm_db2/ibm_db2.php","range":{"start":6195,"end":6209}},"declared_type":null,"signature":{"parameters":[{"name":"stmt","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"parameter_number","declared_type":"int","phpdoc_type":"in