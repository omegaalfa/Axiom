dding takes place. /","params":[{"name":"array","declared_type":"array","description":"<p>"},{"name":"length","declared_type":"int","description":"<p>"},{"name":"value","declared_type":"mixed","description":"<p>"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"array_pop","fqn":"array_pop","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_8.php","range":{"start":34760,"end":34769}},"declared_type":null,"signature":{"parameters":[{"name":"array","declared_type":"array","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true}],"declared_return_type":"mixed","phpdoc_return_type":"mixed|null"},"documentation":{"description":"Pop the element off the end of array The array to get the value from. </p> If array is empty (or is not an array), null will be returned. /","params":[{"name":"","declared_type":null,"description":null}],"return_type":"mixed|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"array_product","fqn":"array_product","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_9.php","range":{"start":24751,"end":24764}},"declared_type":null,"signature":{"parameters":[{"name":"array","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|float","phpdoc_return_type":"int|float"},"documentation":{"description":"Calculate the product of values in an array The array. </p> /","params":[{"name":"array","declared_type":"array","description":"<p>"}],"return_type":"int|float","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"array_push","fqn":"array_push","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_