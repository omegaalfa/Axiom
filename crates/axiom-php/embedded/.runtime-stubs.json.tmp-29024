railing slashes and shouldn't be prefixed with ftp://. </p> This parameter specifies an alternate port to connect to. If it is omitted or set to zero, then the default FTP port, 21, will be used. </p> This parameter specifies the timeout for all subsequent network operations. If omitted, the default value is 90 seconds. The timeout can be changed and queried at any time with <b>ftp_set_option</b> and <b>ftp_get_option</b>. </p> /","params":[{"name":"hostname","declared_type":"string","description":"<p>"},{"name":"port","declared_type":"int","description":"[optional] <p>"},{"name":"timeout","declared_type":"int","description":"[optional] <p>"}],"return_type":"resource|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ftp_delete","fqn":"ftp_delete","kind":"Function","origin":"PhpRuntime","extension":"ftp","location":{"file":"ftp/ftp.php","range":{"start":16896,"end":16906}},"declared_type":null,"signature":{"parameters":[{"name":"ftp","declared_type":null,"phpdoc_type":"resource","optional":false,"variadic":false,"by_reference":false},{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Deletes a file on the FTP server The link identifier of the FTP connection. </p> The file to delete. </p> /","params":[{"name":"ftp","declared_type":"resource","description":"<p>"},{"name":"filename","declared_type":"string","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ftp_exec","fqn":"ftp_exec","kind":"Function","origin":"PhpRuntime","extension":"ftp","location":{"file":"ftp/ftp.php","range":{"start":5402,"end":5410}},"declared_type":null,"signature":{"parameters":[{"name":"ftp","declared_type":null,"phpdoc_type":"resource","optional":fal