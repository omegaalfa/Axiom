e data store so storing a second value with the same key will overwrite the original value. Array: Names in key, variables in value. the stored variable will be expunged from the cache (on the next request). If no ttl is supplied (or if the ttl is 0), the value will persist until it is removed from the cache manually, or otherwise fails to exist in the cache (clear, restart, etc.). /","params":[{"name":"key","declared_type":"string|array","description":"String: Store the variable using this name. Keys are cache-unique,"},{"name":"var","declared_type":"mixed","description":"[optional] The variable to store"},{"name":"ttl","declared_type":"int","description":"[optional]  Time To Live; store var in the cache for ttl seconds. After the ttl has passed,"}],"return_type":"bool|array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"apcu_add","fqn":"apcu_add","kind":"Function","origin":"PhpRuntime","extension":"apcu","location":{"file":"apcu/apcu.php","range":{"start":20122,"end":20130}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"var","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"ttl","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool|array"},"documentation":{"description":"Caches a variable in the data store, only if it's not already stored so attempting to use apcu_add() to store data with a key that already exists will not overwrite the existing data, and will instead return FALSE. (This is the only difference between apcu_add() and apcu_store().) Array: Names in key, variables in value. the stored variable will be expunged from the cache (on the next request). If no ttl is supplied (or if the ttl is 0), the value will persist until it is removed from the cache manually, or otherwise fails to exist in the cache (clear, restart, etc.). Second syntax returns array with error keys. /","params":[{"name":"key","declared_type":"string|array","description":"Store the variable using this name. Keys are cache-unique,"},{"name":"var","declared_type":"mixed","description":"The variable to store"},{"name":"ttl","declared_type":"int","description":"Time To Live; store var in the cache for ttl seconds. After the ttl has passed,"}],"return_type":"bool|array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"apcu_cache_info","fqn":"apcu_cache_info","kind":"Function","origin":"PhpRuntime","extension":"apcu","location":{"file":"apcu/apcu.php","range":{"start":24735,"end":24750}},"declared_type":null,"signature":{"parameters":[{"name":"limited","declared_type":null,"phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"Retrieves cached information from APCu's data store This is useful when trying to optimize calls for statistics gathering. /","params":[{"name":"limited","declared_type":"bool","description":"If limited is TRUE, the return value will exclude the individual list of cache entries."}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"apcu_cas","fqn":"apcu_cas","kind":"Function","origin":"PhpRuntime","extension":"apcu","location":{"file":"apcu/apcu.php","range":{"start":22751,"end":22759}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"old","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"new","declared_type":null,"phpdoc_type