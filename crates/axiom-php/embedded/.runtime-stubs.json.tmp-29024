il":null},"is_static":false},{"name":"wb_draw_ellipse","fqn":"wb_draw_ellipse","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":18864,"end":18879}},"declared_type":null,"signature":{"parameters":[{"name":"target","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"xpos","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"ypos","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"width","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"color","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"filled","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"linewidth","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"linestyle","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Draws a filled or hollow rectangle. The first parameter, target, may be a WinBinder object, a window handle, a drawing surface or a bitmap. xpos and ypos are the coordinates of the upper-left corner of the rectangle, in pixels. width and height are the dimensions of the rectangle. color is a RGB color value. Set filled to FALSE to draw a border. In this case, linewidth sets the width of the border, in pixels. A linewidth of zero sets the width to 1 pixel. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"target","declared_type":null,"description":null},{"name":"xpos","declared_type":null,"description":null},{"name":"ypos","declared_type":null,"description":null},{"name":"width","declared_type":null,"description":null},{"name":"height","declared_type":null,"description":null},{"name":"color","declared_type":null,"description":null},{"name":"filled","declared_type":"null","description":null},{"name":"linewidth","declared_type":"null","description":null},{"name":"linestyle","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_draw_image","fqn":"wb_draw_image","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":20949,"end":20962}},"declared_type":null,"signature":{"parameters":[{"name":"target","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"bitmap","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"xpos","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"ypos","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"width","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"transparentcolor","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"xoffset","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"yoffset","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Draws a bitmap. The first parameter, target, may be a WinBinder object, a window handle, a drawing surface or another bitmap. xpos and ypos are the coordinates of the upper-left corner, in pixels. These parameters default to zero. width and height are the dimensions of the rectangle. These parameters also default to zero. In this case the bitmap is drawn with its original size. The parameter transparentcolor may be used to indicate which color is to be made transparent. If is set to NOCOLOR (the default), no transparency is used and the image is opaque. Parameters xoffset and yoffset are optionally used to specify where the image will be drawn. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"target","declared_type":null,"description":null},{"name":"bitmap","declared_type":null,"description":null},{"name":"xpos","declared_type":"int","description":null},{"name":"ypos","declared_type":"int","description":null},{"name":"width","declared_type":"null","description":null},{"name":"height","declared_type":"null","description":null},{"name":"transparentcolor","declared_type":"null","description":null},{"name":"xoffset","declared_type":"null","description":null},{"name":"yoffset","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_draw_line","fqn":"wb_draw_line","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":17206,"end":17218}},"declared_type":null,"signature":{"parameters":[{"name":"target","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"x0","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"y0","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"x1","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"y1","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"color","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"linewidth","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"linestyle","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Draws a straight line. The first parameter, target, may be a WinBinder object, a window handle, a drawing surface or a bitmap. The start and end points of the line are (x0, y0) and (x1, y1) respectively, in pixels. color is a RGB color value and linewidth is the width of the line, in pixels. A linewidth of zero sets the width to 1 pixel. Parameter linestyle accepts the values specified in the table below. 0    Solid line (the default style) 1    Dotted line 2-7    Dashed lines with increasing lengths 8    Line with alternating dashes and dots 9    Line with alternating dashes and double dots Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"target","declared_type":null,"description":null},{"name":"x0","declared_type":null,"description":null},{"name":"y0","declared_type":null,"description":null},{"name":"x1","declared_type":null,"description":null},{"name":"y1","declared_type":null,"description":null},{"name":"color","declared_type":null,"description":null},{"name":"linewidth","declared_type":"null","description":null},{"name":"linestyle","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_draw_point","fqn":"wb_draw_point","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":16284,"end":16297}},"declared_type