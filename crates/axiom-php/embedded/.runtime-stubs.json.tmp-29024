","phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"is_prefix","declared_type":"bool","phpdoc_type":"bool","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"SimpleXMLElement|false","phpdoc_return_type":"SimpleXMLElement|false"},"documentation":{"description":"Interprets an XML file into an object Path to the XML file </p> <p> Libxml 2 unescapes the URI, so if you want to pass e.g. b&c as the URI parameter a, you have to call simplexml_load_file(rawurlencode('https://example.com/?a=' . urlencode('b&c'))). Since PHP 5.1.0 you don't need to do this because PHP will do it for you. </p> You may use this optional parameter so that <b>simplexml_load_file</b> will return an object of the specified class. That class should extend the SimpleXMLElement class. </p> Since PHP 5.1.0 and Libxml 2.6.0, you may also use the <i>options</i> parameter to specify additional Libxml parameters. </p> Namespace prefix or URI. </p> <b>TRUE</b> if <i>ns</i> is a prefix, <b>FALSE</b> if it's a URI; defaults to <b>FALSE</b>. </p> properties containing the data held within the XML document, or <b>FALSE</b> on failure. /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"class_name","declared_type":"string|null","description":"[optional] <p>"},{"name":"options","declared_type":"int","description":"[optional] <p>"},{"name":"namespace_or_prefix","declared_type":"string","description":"[optional] <p>"},{"name":"is_prefix","declared_type":"bool","description":"[optional] <p>"}],"return_type":"SimpleXMLElement|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"simplexml_load_string","fqn":"simplexml_load_string","kind":"Function","origin":"PhpRuntime","extension":"SimpleXML","location":{"file":"SimpleXML/SimpleXML.php","range":{"start":20061,"end":20082}},"declared_type":null,"signature":{"parameters":[{"name":"data","declared_ty