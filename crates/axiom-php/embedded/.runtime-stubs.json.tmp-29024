gnature":null,"documentation":null,"availability":{"since":null,"until":null},"is_static":false},{"name":"_application_id","fqn":"ZendAPI_Job::_application_id","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":8501,"end":8517}},"declared_type":null,"signature":null,"documentation":{"description":"The application id of the job If the application id is not set, this job may get an application id automatically from the queue (if the queue was assigned one). By default it is null (which indicates no application id is assigned) /","params":[],"return_type":null,"var_type":"string","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_end_time","fqn":"ZendAPI_Job::_end_time","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":11554,"end":11564}},"declared_type":null,"signature":null,"documentation":{"description":"UNIX timestamp that it's the last time this job should occurs. If _interval was set, and _end_time was not, then this job will run forever. By default there is no end_time, so recurrent job will run forever. If the job is not recurrent (occurs only once) then the job will run at most once. If end_time has reached and the job was not execute yet, it will not run. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_global_variables","fqn":"ZendAPI_Job::_global_variables","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":9984,"end":10002}},"declared_type":null,"signature":null,"documentation":{"description":"Bit mask holding the global variables that the user want the job's script to have when it's called Options are prefixed with \"JOB_QUEUE_SAVE_\" and may be: POST|GET|COOKIE|SESSION|RAW_POST|SERVER|FILES|ENV By default there are no global variables we want to add to the job's script i.e. In order to save the current GET and COOKIE global variables, this property should be JOB_QUEUE_SAVE_GET|JOB_QUEUE_SAVE_COOKIE (or the integer 6) In that case (of GET and COOKIE), when the job is added, the current $_GET and $_COOKIE variables  should be saved, and when the job's script is called, those global variables should be populated /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_host","fqn":"ZendAPI_Job::_host","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":7723,"end":7729}},"declared_type":null,"signature":null,"documentation":{"description":"The host that the job was submit from /","params":[],"return_type":null,"var_type":"string","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_id","fqn":"ZendAPI_Job::_id","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":7483,"end":7487}},"declared_type":null,"signature":null,"documentation":{"description":"Unique id of the Job in the job queue /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_interval","fqn":"ZendAPI_Job::_interval","kind":"Property","origin":"PhpRuntime","extension":"zend","location":{"file":"zend/zend.php","range":{"start":11077,"end":11087}},"declared_type":null,"signature":null,"documentation":{"description":"The job running frequency in seconds. The job should run every _internal seconds This property applys only to recurrent job. By default, its value is 0 e.g. run it only once. /","params":[],"return_type":null,"var_type":"int","throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"_name","fqn":"ZendAPI_Job::_name",