alse,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"(PHP 5 &gt;=5.5.0 PECL intl &gt;= 3.0.0a1)<br/> Whether a certain date/time is in the weekend The calendar object, on the procedural style interface. </p> An optional timestamp representing the number of milliseconds since the epoch, excluding leap seconds. If <b>NULL</b>, this object's current time is used instead. </p> <p> A {@link https://php.net/manual/en/language.types.boolean.php bool} indicating whether the given or this object's time occurs in a weekend. </p> <p> The value <b>FALSE</b> may also be returned on failure, for instance after giving a date out of bounds on non-lenient mode; use {@link https://php.net/manual/en/intl.configuration.php#ini.intl.use-exceptions exceptions} or query {@link https://php.net/manual/en/function.intl-get-error-code.php intl_get_error_code()} to disambiguate.</p> /","params":[{"name":"calendar","declared_type":"IntlCalendar","description":"<p>"},{"name":"timestamp","declared_type":"float|null","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"intlcal_roll","fqn":"intlcal_roll","kind":"Function","origin":"PhpRuntime","extension":"intl","location":{"file":"intl/intl.php","range":{"start":236205,"end":236217}},"declared_type":null,"signature":{"parameters":[{"name":"calendar","declared_type":"IntlCalendar","phpdoc_type":"IntlCalendar","optional":false,"variadic":false,"by_reference":false},{"name":"field","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"int|bool","optional":true,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"int|bool","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"