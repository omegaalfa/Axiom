oc_return_type":"Redis|int|false"},"documentation":{"description":"Perform the intersection of one or more Redis SETs, storing the result in a destination key, rather than returning them. elements, consisting of the destination key name and one or more source keys names. be source key names. $redis->sInterStore(['dst', 'src1', 'src2', 'src3']); $redis->sInterStore('dst', 'src1', 'src'2', 'src3'); /","params":[{"name":"key","declared_type":"array|string","description":"Either a string key, or an array of keys (with at least two"},{"name":"other_keys","declared_type":"string","description":"If the first argument was a string, subsequent arguments should"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sismember","fqn":"Redis::sismember","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":142336,"end":142345}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Check whether a given value is the member of a Redis SET. /","params":[{"name":"key","declared_type":"string","description":"The redis set to check."},{"name":"value","declared_type":"mixed","description":"The value to test."}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"slaveof","fqn":"Redis::slaveof","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":142965,"end":142972}},"declared_type":null,"signature":{"parameters":[{"name":"host","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"port","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":null},"documentation":{"description":"Turn a redis instance into a replica of another or promote a replica to a primary. This method and the corresponding command in Redis has been marked deprecated and users should instead use Redis::replicaof() if connecting to redis-server >= 5.0.0. $redis->slaveof('10.0.0.5', 6380); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":""},"availability":{"since":null,"until":null},"is_static":false},{"name":"slowlog","fqn":"Redis::slowlog","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":146177,"end":146184}},"declared_type":null,"signature":{"parameters":[{"name":"operation","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Interact with Redis' slowlog functionality in various ways, depending on the value of 'operation'. be one of the following values: 'GET'   - Retrieve the Redis slowlog as an array. 'LEN'   - Retrieve the length of the slowlog. 'RESET' - Remove all slowlog entries. is 'get' and will specify how many elements to retrieve. If omitted Redis will send up to a default number of entries, which is configurable. Note:  With Redis >= 7.0.0 you can send -1 to mean \"all\". /","params":[{"name":"operation","declared_type":"string","description":"The operation you wish to perform.  This can"},{"name":"length","declared_type":"int","description":"This optional argument can be passed when operation"}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sMembers","fqn":"Redis::sMembers","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":126009,"end":126017}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Retrieve every member from a set key. $redis->sAdd('tng-crew', ...['Picard', 'Riker', 'Data', 'Worf', 'La Forge', 'Troi', 'Crusher', 'Broccoli']); $redis->sMembers('tng-crew'); /","params":[{"name":"key","declared_type":"string","description":"The set name."}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sMisMember","fqn":"Redis::sMisMember","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":126887,"end":126897}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"member","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_members","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Check if one or more values are members of a set. was a member of the set. $redis->sAdd('ds9-crew', ...[\"Sisko\", \"Kira\", \"Dax\", \"Worf\", \"Bashir\", \"O'Brien\"]); $members = $redis->sMIsMember('ds9-crew', ...['Sisko', 'Picard', 'Data', 'Worf']); /","params":[{"name":"key","declared_type":"string","description":"The set to query."},{"name":"member","declared_type":"string","description":"The first value to test if exists in the set."},{"name":"other_members","declared_type":"string","description":"Any number of additional values to check."}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sMove","fqn":"Redis::sMove","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":127720,"end":127725}},"declared_type":null,"signature":{"parameters":[{"name":"src","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Pop a member from one set and push it onto another.  This command will create the destination set if it does not currently exist. $redis->sAdd('numbers', 'zero', 'one', 'two', 'three', 'four'); $redis->sMove('numbers', 'evens', 'zero'); $redis->sMove('numbers', 'evens', 'two'); $redis->sMove('numbers', 'evens', 'four'); /","params":[{"name":"src","declared_type":"string","description":"The source set."},{"name":"dst","declared_type":"string","description":"The destination set."},{"name":"value","declared_type":"mixed","description":"The member you wish to move."}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sort","fqn":"Redis::sort","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":147709,"end":147713}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"mixed"},"documentation":{"description":"Sort the contents of a Redis key in various ways. data sorted.  See blow for a detailed description of this options array. or the number of elements placed in a destination set when using the STORE option. $options = [ 'SORT'  => 'ASC'|| 'DESC' // Sort in descending or descending order. 'ALPHA' => true || false  // Whether to sort alphanumerically. 'LIMIT' => [0, 10]        // Return a subset of the data at offset, count 'BY'    => 'weight_*'     // For each element in the key, read data from the external key weight_* and sort based on that value. 'GET'   => 'weight_*'     // For each element in the source key, retrieve the data from key weight_* and return that in the result rather than the source keys' element.  This can be used in combination with 'BY' ]; /","params":[{"name":"key","declared_type":"string","description":"The key you wish to sort"},{"name":"options","declared_type":"array|null","description":"Various options controlling how you would like the"}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sort_ro","fqn":"Redis::sort_ro","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":148031,"end":148038}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":null},"documentation":{"description":"This is simply a read-only variant of the sort command $redis->sort_ro('numbers', ['LIMIT' => [0, 5]]); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sortAsc","fqn":"Redis::sortAsc","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":148263,"end":148270}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"get","declared_type":"mixed","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"store","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":null},"documentation":{"description":"$redis->sortAsc('numbers'); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":""},"availability":{"since":null,"until":null},"is_static":false},{"name":"sortAscAlpha","fqn":"Redis::sortAscAlpha","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":148575,"end":148587}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"get","declared_type":"mixed","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"store","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":null},"documentation":{"description":"$redis->sortAscAlpha('tags'); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":""},"availability":{"since":null,"until":null},"is_static":false},{"name":"sortDesc","fqn":"Redis::sortDesc","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":148891,"end":148899}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"get","declared_type":"mixed","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"store","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":null},"documentation":{"description":"$redis->sortDesc('numbers'); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":""},"availability":{"since":null,"until":null},"is_static":false},{"name":"sortDescAlpha","fqn":"Redis::sortDescAlpha","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":149205,"end":149218}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"pattern","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"get","declared_type":"mixed","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"offset","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"store","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":null},"documentation":{"description":"$redis->sortDescAlpha('tags'); /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":""},"availability":{"since":null,"until":null},"is_static":false},{"name":"sPop","fqn":"Redis::sPop","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":128288,"end":128292}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|string|array|false","phpdoc_return_type":null},"documentation":{"description":"Remove one or more elements from a set. removing one element. $redis->del('numbers', 'evens'); $redis->sAdd('numbers', 'zero', 'one', 'two', 'three', 'four'); $redis->sPop('numbers'); /","params":[{"name":"key","declared_type":"string","description":"The set in question."},{"name":"count","declared_type":"int","description":"An optional number of members to pop.   This defaults to"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sRandMember","fqn":"Redis::sRandMember","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":129334,"end":129345}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"mixed","phpdoc_return_type":"Redis|array|string|false"},"documentation":{"description":"Retrieve one or more random members of a set. If this value is positive, Redis will return *up to* the requested number but with unique elements that will never repeat.  This means you may receive fewer then `$count` replies. If the number is negative, Redis will return the exact number requested but the result may contain duplicate elements. /","params":[{"name":"key","declared_type":"string","description":"The set to query."},{"name":"count","declared_type":"int","description":"An optional count of members to return."}],"return_type":"Redis|array|string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"srem","fqn":"Redis::srem","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":149886,"end":149890}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"other_values","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Remove one or more values from a Redis SET key. /","params":[{"name":"key","declared_type":"string","description":"The Redis SET key in question."},{"name":"value","declared_type":"mixed","description":"The first value to remove."},{"name":"other_values","declared_type":"mixed","description":"One or more additional values to remove."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sRemove","fqn":"Redis::sRemove","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":21129,"end":21136}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"mixed","description":null},{"name":"value","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sscan","fqn":"Redis::sscan","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":152195,"end":152200}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"iterator","declared_type":"null|int|string","phpdoc_type":"int|string|null","optional":false,"variadic":false,"by_reference":true},{"name":"pattern","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"count","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":null},"documentation":{"description":"Scan the members of a redis SET key. PhpRedis will update with the value returned from Redis after each subsequent call to SSCAN.  Once this cursor is zero you know all members have been traversed. returns the subset of members matching this pattern. before returning members for that iteration. $redis->del('myset'); for ($i = 0; $i < 10000; $i++) { $redis->sAdd('myset', \"member:$i\"); } $redis->sadd('myset', 'foofoo'); $redis->setOption(Redis::OPT_SCAN, Redis::SCAN_NORETRY); $scanned = 0; $it = null; // Without Redis::SCAN_RETRY we may receive empty results and // a nonzero iterator. do { // Scan members containing '5' $members = $redis->sscan('myset', $it, '*5*'); foreach ($members as $member) { echo \"NORETRY: $member\\n\"; $scanned++; } } while ($it != 0); echo \"TOTAL: $scanned\\n\"; $redis->setOption(Redis::OPT_SCAN, Redis::SCAN_RETRY); $scanned = 0; $it = null; // With Redis::SCAN_RETRY PhpRedis will never return an empty array // when the cursor is non-zero while (($members = $redis->sscan('myset', $it, '*5*'))) { foreach ($members as $member) { echo \"RETRY: $member\\n\"; $scanned++; } } /","params":[{"name":"key","declared_type":"string","description":"The Redis SET key in question."},{"name":"iterator","declared_type":"int|string|null","description":"A reference to an iterator which should be initialized to NULL that"},{"name":"pattern","declared_type":"string|null","description":"An optional glob style pattern to match against, so Redis only"},{"name":"count","declared_type":"int","description":"A hint to Redis as to how many members it should scan in one command"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sSize","fqn":"Redis::sSize","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":5196,"end":5201}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ssubscribe","fqn":"Redis::ssubscribe","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":153524,"end":153534}},"declared_type":null,"signature":{"parameters":[{"name":"channels","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"cb","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Subscribes the client to the specified shard channels. from one of the subscribed channels. client in a subscribe loop, waiting for messages to arrive. $redis = new Redis(['host' => 'localhost']); $redis->ssubscribe(['channel-1', 'channel-2'], function ($redis, $channel, $message) { echo \"[$channel]: $message\\n\"; // Unsubscribe from the message channel when we read 'quit' if ($message == 'quit') { echo \"Unsubscribing from '$channel'\\n\"; $redis->sunsubscribe([$channel]); } }); // Once we read 'quit' from both channel-1 and channel-2 the subscribe loop will be // broken and this command will execute. echo \"Subscribe loop ended\\n\"; /","params":[{"name":"channels","declared_type":"array","description":"One or more channel names."},{"name":"cb","declared_type":"callable","description":"The callback PhpRedis will invoke when we receive a message"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"strLen","fqn":"Redis::strLen","kind":"Method","origin":"PhpRuntime","extension":"swoole","location":{"file":"swoole/Swoole/Coroutine/Redis.php","range":{"start":4119,"end":4125}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"/","params":[{"name":"key","declared_type":"mixed","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"strlen","fqn":"Redis::strlen","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":153994,"end":154000}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Retrieve the length of a Redis STRING key. false on failure. /","params":[{"name":"key","declared_type":"string","description":"The key we want the length of."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"subscribe","fqn":"Redis::subscribe","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":155249,"end":155258}},"declared_type":null,"signature":{"parameters":[{"name":"channels","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"cb","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Subscribe to one or more Redis pubsub channels. from one of the subscribed channels. client in a subscribe loop, waiting for messages to arrive. $redis = new Redis(['host' => 'localhost']); $redis->subscribe(['channel-1', 'channel-2'], function ($redis, $channel, $message) { echo \"[$channel]: $message\\n\"; // Unsubscribe from the message channel when we read 'quit' if ($message == 'quit') { echo \"Unsubscribing from '$channel'\\n\"; $redis->unsubscribe([$channel]); } }); // Once we read 'quit' from both channel-1 and channel-2 the subscribe loop will be // broken and this command will execute. echo \"Subscribe loop ended\\n\"; /","params":[{"name":"channels","declared_type":"array","description":"One or more channel names."},{"name":"cb","declared_type":"callable","description":"The callback PhpRedis will invoke when we receive a message"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sUnion","fqn":"Redis::sUnion","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":129834,"end":129840}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|array|false","phpdoc_return_type":"Redis|array|false"},"documentation":{"description":"Returns the union of one or more Redis SET keys. /","params":[{"name":"key","declared_type":"string","description":"The first SET to do a union with"},{"name":"other_keys","declared_type":"string","description":"One or more subsequent keys"}],"return_type":"Redis|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sunioncard","fqn":"Redis::sunioncard","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":123707,"end":123717}},"declared_type":null,"signature":{"parameters":[{"name":"keys","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"?array","phpdoc_type":"array|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Compute the union of one or more sets and return the cardinality of the result. $redis->sAdd('set1', 'apple', 'pear', 'banana', 'carrot'); $redis->sAdd('set2', 'apple',         'banana'); $redis->sAdd('set3',          'pear', 'banana'); $redis->sunioncard(['set1', 'set2', 'set3']); $redis->sunioncard(['set1', 'set2'], ['LIMIT' => 2]); $redis->sunioncard(['set1', 'set2'], ['LIMIT' => 2, 'APPROX']); /","params":[{"name":"keys","declared_type":"array","description":"One or more set key names."},{"name":"options","declared_type":"array|null","description":"An optional array of options that modifies how the command works."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sUnionStore","fqn":"Redis::sUnionStore","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":130532,"end":130543}},"declared_type":null,"signature":{"parameters":[{"name":"dst","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Perform a union of one or more Redis SET keys and store the result in a new set false on failure. $redis->sUnionStore('union:set', 'set:a', 'set:b'); /","params":[{"name":"dst","declared_type":"string","description":"The destination key"},{"name":"key","declared_type":"string","description":"The first source key"},{"name":"other_keys","declared_type":"string","description":"One or more additional source keys"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"sunsubscribe","fqn":"Redis::sunsubscribe","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":156126,"end":156138}},"declared_type":null,"signature":{"parameters":[{"name":"channels","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|bool","phpdoc_return_type":"Redis|array|bool"},"documentation":{"description":"Unsubscribes the client from the given shard channels, or from all of them if none is given. $redis->ssubscribe(['channel-1', 'channel-2'], function ($redis, $channel, $message) { if ($message == 'quit') { echo \"$channel => 'quit' detected, unsubscribing!\\n\"; $redis->sunsubscribe([$channel]); } else { echo \"$channel => $message\\n\"; } }); echo \"We've unsubscribed from both channels, exiting\\n\"; /","params":[{"name":"channels","declared_type":"array","description":"One or more channels to unsubscribe from."}],"return_type":"Redis|array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"swapdb","fqn":"Redis::swapdb","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":156992,"end":156998}},"declared_type":null,"signature":{"parameters":[{"name":"src","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"dst","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Atomically swap two Redis databases so that all of the keys in the source database will now be in the destination database and vice-versa. Note: This command simply swaps Redis' internal pointer to the database and is therefore very fast, regardless of the size of the underlying databases. $redis->select(0); $redis->set('db0-key', 'db0-value'); $redis->swapdb(0, 1); $redis->get('db0-key'); /","params":[{"name":"src","declared_type":"int","description":"The source database number"},{"name":"dst","declared_type":"int","description":"The destination database number"}],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"time","fqn":"Redis::time","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":157409,"end":157413}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"Redis|array","phpdoc_return_type":"Redis|array"},"documentation":{"description":"Retrieve the server time from the connected Redis instance. elapsed since the second. /","params":[],"return_type":"Redis|array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"touch","fqn":"Redis::touch","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":144783,"end":144788}},"declared_type":null,"signature":{"parameters":[{"name":"key_or_array","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"more_keys","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Update one or more keys last modified metadata. an array of keys. had their last modified time reset $redis->touch('cache:1', 'cache:2'); /","params":[{"name":"key_or_array","declared_type":"array|string","description":"Either the first key or if passed as the only argument"},{"name":"more_keys","declared_type":"string","description":"One or more keys to send to the command."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"ttl","fqn":"Redis::ttl","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":157995,"end":157998}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Get the amount of time a Redis key has before it will expire, in seconds. no expiration, and -2 if the key does not exist.  In the event of an error, this command will return false. /","params":[{"name":"key","declared_type":"string","description":"The Key we want the TTL for."}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"type","fqn":"Redis::type","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":158789,"end":158793}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Get the type of a given Redis key. The Redis class defines several type constants that correspond with Redis key types. Redis::REDIS_NOT_FOUND Redis::REDIS_STRING Redis::REDIS_SET Redis::REDIS_LIST Redis::REDIS_ZSET Redis::REDIS_HASH Redis::REDIS_STREAM Redis::REDIS_VECTORSET foreach ($redis->keys('*') as $key) { echo \"$key => \" . $redis->type($key) . \"\\n\"; } /","params":[{"name":"key","declared_type":"string","description":"The key to check"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"unlink","fqn":"Redis::unlink","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":159770,"end":159776}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array|string","phpdoc_type":"array|string","optional":false,"variadic":false,"by_reference":false},{"name":"other_keys","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"Redis|int|false","phpdoc_return_type":"Redis|int|false"},"documentation":{"description":"Delete one or more keys from the Redis database.  Unlike this operation, the actual deletion is asynchronous, meaning it is safe to delete large keys without fear of Redis blocking for a long period of time. the first key to delete. you may pass any number of additional key names. /","params":[{"name":"key","declared_type":"array|string","description":"Either an array with one or more keys or a string with"},{"name":"other_keys","declared_type":"string","description":"If the first argument passed to this method was a string"}],"return_type":"Redis|int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"unsubscribe","fqn":"Redis::unsubscribe","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":160612,"end":160623}},"declared_type":null,"signature":{"parameters":[{"name":"channels","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"Redis|array|bool","phpdoc_return_type":"Redis|array|bool"},"documentation":{"description":"Unsubscribe from one or more subscribed channels. $redis->subscribe(['channel-1', 'channel-2'], function ($redis, $channel, $message) { if ($message == 'quit') { echo \"$channel => 'quit' detected, unsubscribing!\\n\"; $redis->unsubscribe([$channel]); } else { echo \"$channel => $message\\n\"; } }); echo \"We've unsubscribed from both channels, exiting\\n\"; /","params":[{"name":"channels","declared_type":"array","description":"One or more channels to unsubscribe from."}],"return_type":"Redis|array|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"unwatch","fqn":"Redis::unwatch","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":161032,"end":161039}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":"Redis|bool","phpdoc_return_type":"Redis|bool"},"documentation":{"description":"Remove any previously WATCH'ed keys in a transaction. $redis->unwatch(); /","params":[],"return_type":"Redis|bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"vadd","fqn":"Redis::vadd","kind":"Method","origin":"PhpRuntime","extension":"redis","location":{"file":"redis/Redis.php","range":{"start":182981,"end":182985}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"values","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"element","declared_type":"mixed","phpdoc_type":"mixed","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array|null"