iterate over large APC caches. This is helpful as it allows iterating over large caches in steps, while grabbing a defined number of entries per lock instance, so it frees the cache locks for other activities rather than hold up the entire cache to grab 100 (the default) entries. Also, using regular expression matching is more efficient as it's been moved to the C level. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"APCUIterator","fqn":"APCUIterator","kind":"Class","origin":"PhpRuntime","extension":"apcu","location":{"file":"apcu/apcu.php","range":{"start":25591,"end":25603}},"declared_type":null,"signature":null,"documentation":{"description":"The APCUIterator class The APCUIterator class makes it easier to iterate over large APCu caches. This is helpful as it allows iterating over large caches in steps, while grabbing a defined number of entries per lock instance, so it frees the cache locks for other activities rather than hold up the entire cache to grab 100 (the default) entries. Also, using regular expression matching is more efficient as it's been moved to the C level. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"AppendIterator","fqn":"AppendIterator","kind":"Class","origin":"PhpRuntime","extension":"SPL","location":{"file":"SPL/SPL.php","range":{"start":35854,"end":35868}},"declared_type":null,"signature":null,"documentation":{"description":"An Iterator that iterates over several iterators one after the other. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"AppendOptions","fqn":"AppendOptions","kind":"Class","origin":"PhpRuntime","extension":"couchbase","location":{"file":"couchbase/couchbase.php","range":{"start":97813,"end":97826}},"declared_typ