:[{"name":"bin","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"long","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"lat","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"radiusMeter","declared_type":null,"phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Helper method for creating a GEOWITHIN circle region predicate ``` Associative Array: bin => bin name op => Aerospike::OP_GEOWITHINREGION val => GeoJSON string produced from $long, $lat and $radius ``` /","params":[{"name":"bin","declared_type":"string","description":"name"},{"name":"long","declared_type":"float","description":"longitude of the point"},{"name":"lat","declared_type":"float","description":"latitude of the point"},{"name":"radiusMeter","declared_type":"float","description":"radius of the circle in meters"}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"predicateRange","fqn":"Aerospike::predicateRange","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":125310,"end":125324}},"declared_type":null,"signature":{"parameters":[{"name":"bin","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"index_type","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"min","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"max","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Helper method for creating a RANGE predicate Similar to predicateBetween(), predicateRange() looks for records with a range of values inside a complex type - a list containing the values (if the index type is *INDEX_TYPE_LIST*), the values contained in the keys of a map (if the index type is *INDEX_TYPE_MAPKEYS*), or a record with the given values contained in the values of a map (if the index type was *INDEX_TYPE_MAPVALUES*) ``` Associative Array: bin => bin name index_type => Aerospike::INDEX_TYPE_* op  => Aerospike::OP_BETWEEN val => [min, max] ``` /","params":[{"name":"bin","declared_type":"string","description":"name"},{"name":"index_type","declared_type":"int","description":"one of Aerospike::INDEX_TYPE_*"},{"name":"min","declared_type":"int","description":null},{"name":"max","declared_type":"int","description":null}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":true},{"name":"prepend","fqn":"Aerospike::prepend","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":46864,"end":46871}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"bin","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Prepend a string $value to the one already in $bin, in the record identified by the $key. ```php $key = $client->initKey(\"test\", \"users\", 1234); $options = [Aerospike::OPT_TTL => 3600]; $status = $client->prepend($key, 'name', '*', $options); if ($status == Aerospike::OK) { echo \"Starred the user.\\n\"; } else { echo \"[{$client->errorno()}] \".$client->error(); } ``` * Aerospike::OPT_WRITE_TIMEOUT * Aerospike::OPT_TTL * Aerospike::OPT_POLICY_KEY * Aerospike::OPT_POLICY_GEN * Aerospike::OPT_POLICY_COMMIT_LEVEL * Aerospike::OPT_DESERIALIZE * Aerospike::OPT_SLEEP_BETWEEN_RETRIES * Aerospike::OPT_TOTAL_TIMEOUT * Aerospike::OPT_MAX_RETRIES * Aerospike::OPT_SOCKET_TIMEOUT /","params":[{"name":"key","declared_type":"array","description":"The key identifying the record. An array with keys `['ns','set','key']` or `['ns','set','digest']`"},{"name":"bin","declared_type":"string","description":"The name of the bin"},{"name":"value","declared_type":"string","description":"The string value to prepend to the bin"},{"name":"options","declared_type":"array","description":"an optional array of write policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"put","fqn":"Aerospike::put","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":23639,"end":23642}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"bins","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"ttl","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Write a record identified by the $key with $bins, an array of bin-name => bin-value pairs. By default Aerospike::put() behaves in a set-and-replace mode, similar to how new keys are added to an array, or the value of existing ones is overwritten. This behavior can be modified using the *$options* parameter. **Note:** a binary-string which includes a null-byte will get truncated at the position of the **\\0** character if it is not wrapped. For more information and the workaround see 'Handling Unsupported Types'. **Example #1 Aerospike::put() default behavior example** ```php $key = $client->initKey(\"test\", \"users\", 1234); $bins = [\"email\" => \"hey@example.com\", \"name\" => \"Hey There\"]; // will ensure a record exists at the given key with the specified bins $status = $client->put($key, $bins); if ($status == Aerospike::OK) { echo \"Record written.\\n\"; } else { echo \"[{$client->errorno()}] \".$client->error(); } // Updating the record $bins = [\"name\" => \"You There\", \"age\" => 33]; // will update the name bin, and create a new 'age' bin $status = $client->put($key, $bins); if ($status == Aerospike::OK) { echo \"Record updated.\\n\"; } else { echo \"[{$client->errorno()}] \".$client->error(); } ``` ``` Record written. Record updated. ``` **Example #2 Fail unless the put explicitly creates a new record** ```php // This time we expect an error, due to the record already existing (assuming we // ran Example #1) $status = $client->put($key, $bins, 0, [Aerospike::OPT_POLICY_EXISTS => Aerospike::POLICY_EXISTS_CREATE]); if ($status == Aerospike::OK) { echo \"Record written.\\n\"; } elseif ($status == Aerospike::ERR_RECORD_EXISTS) { echo \"The Aerospike server already has a record with the given key.\\n\"; } else { echo \"[{$client->errorno()}] \".$client->error(); } ``` ``` The Aerospike cluster already has a record with the given key. ``` **Example #3 Fail if the record has been written since it was last read (CAS)** ```php // Get the record metadata and note its generation $client->exists($key, $metadata); $gen = $metadata['generation']; $gen_policy = [Aerospike::POLICY_GEN_EQ, $gen]; $res = $client->put($key, $bins, 0, [Aerospike::OPT_POLICY_GEN => $gen_policy]); if ($res == Aerospike::OK) { echo \"Record written.\\n\"; } elseif ($res == Aerospike::ERR_RECORD_GENERATION) { echo \"The record has been written since we last read it.\\n\"; } else { echo \"[{$client->errorno()}] \".$client->error(); } ?> ``` ``` The record has been written since we last read it. ``` **Example #4 Handling binary strings** ```php $str = 'Glagnar\\'s Human Rinds, \"It\\'s a bunch\\'a munch\\'a crunch\\'a human!'; $deflated = new \\Aerospike\\Bytes(gzdeflate($str)); $wrapped = new \\Aerospike\\Bytes(\"trunc\\0ated\"); $key = $client->initKey('test', 'demo', 'wrapped-bytes'); $status = $client->put($key, ['unwrapped'=>\"trunc\\0ated\", 'wrapped'=> $wrapped, 'deflated' => $deflated]); if ($status !== Aerospike::OK) { die($client->error()); } $client->get($key, $record); $wrapped = \\Aerospike\\Bytes::unwrap($record['bins']['wrapped']); $deflated = $record['bins']['deflated']; $inflated = gzinflate($deflated->s); echo \"$inflated\\n\"; echo \"wrapped binary-string: \"; var_dump($wrapped); $unwrapped = $record['bins']['unwrapped']; echo \"The binary-string that was given to put() without a wrapper: $unwrapped\\n\"; ``` ``` Glagnar's Human Rinds, \"It's a bunch'a munch'a crunch'a human! wrapped binary-string: string(10) \"truncated\" The binary-string that was given to put() without a wrapper: trunc ``` * Aerospike::OPT_WRITE_TIMEOUT * Aerospike::OPT_SERIALIZER * Aerospike::OPT_POLICY_KEY * Aerospike::OPT_POLICY_GEN * Aerospike::OPT_POLICY_EXISTS * Aerospike::OPT_POLICY_COMMIT_LEVEL * Aerospike::COMPRESSION_THRESHOLD * Aerospike::OPT_SLEEP_BETWEEN_RETRIES * Aerospike::OPT_TOTAL_TIMEOUT * Aerospike::OPT_MAX_RETRIES * Aerospike::OPT_SOCKET_TIMEOUT /","params":[{"name":"key","declared_type":"array","description":"The key identifying the record. An array with keys `['ns','set','key']` or `['ns','set','digest']`"},{"name":"bins","declared_type":"array","description":"The array of bin names and values to write. **Bin names cannot be longer than 14 characters.** Binary data containing the null byte (**\\0**) may get truncated. See 'Handling Unsupported Types' for more details and a workaround"},{"name":"ttl","declared_type":"int","description":"The record's time-to-live in seconds"},{"name":"options","declared_type":"array","description":"an optional array of write policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"query","fqn":"Aerospike::query","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":121942,"end":121947}},"declared_type":null,"signature":{"parameters":[{"name":"ns","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"set","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"where","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"record_cb","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"select","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Query a secondary index on a namespace or set Query a _ns.set_ with a specified predicate, and invoke a callback function *record_cb* on each record matched by the query and streaming back from the cluster. Optionally select the bins to be returned. Non-existent bins in this list will appear in the record with a NULL value. ```php $result = []; $where = Aerospike::predicateBetween(\"age\", 30, 39); $status = $client->query(\"test\", \"users\", $where, function ($record) use (&$result) { $result[] = $record['bins']; }); if ($status !== Aerospike::OK) { echo \"An error occured while querying[{$client->errorno()}] {$client->error()}\\n\"; } else { echo \"The query returned \".count($result).\" records\\n\"; } ``` ``` foo@example.com : bar@example.com I think a sample of 20 records is enough ``` predicate helper methods. The arrays conform to one of the following: ``` Array: bin => bin name op => one of Aerospike::OP_EQ, Aerospike::OP_BETWEEN, Aerospike::OP_CONTAINS, Aerospike::OP_RANGE, etc val => scalar integer/string for OP_EQ and OP_CONTAINS or [$min, $max] for OP_BETWEEN and OP_RANGE or an empty array() for no predicate ``` examples ``` [\"bin\"=>\"name\", \"op\"=>Aerospike::OP_EQ, \"val\"=>\"foo\"] [\"bin\"=>\"age\", \"op\"=>Aerospike::OP_BETWEEN, \"val\"=>[35,50]] [\"bin\"=>\"movies\", \"op\"=>Aerospike::OP_CONTAINS, \"val\"=>\"12 Monkeys\"] [\"bin\"=>\"movies\", \"op\"=>Aerospike::OP_RANGE, \"val\"=>[10,1000]] [] // no predicate ``` * Aerospike::OPT_READ_TIMEOUT * Aerospike::OPT_SLEEP_BETWEEN_RETRIES * Aerospike::OPT_TOTAL_TIMEOUT * Aerospike::OPT_MAX_RETRIES * Aerospike::OPT_SOCKET_TIMEOUT * Aerospike::OPT_QUERY_NOBINS /","params":[{"name":"ns","declared_type":"string","description":"the namespace"},{"name":"set","declared_type":"string","description":"the set within the given namespace"},{"name":"where","declared_type":"array","description":"the predicate for the query, usually created by the"},{"name":"record_cb","declared_type":"callable","description":"A callback function invoked for each record streaming back from the cluster"},{"name":"select","declared_type":"array","description":"An array of bin names which are the subset to be returned"},{"name":"options","declared_type":"array","description":"an optional array of policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"queryApply","fqn":"Aerospike::queryApply","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":143628,"end":143638}},"declared_type":null,"signature":{"parameters":[{"name":"ns","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"set","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"where","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"module","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"function","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"job_id","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Apply a UDF to each record in a query Query the *ns.set* with a predicate, and apply a UDF _module.function_ to each of matched records. Arguments can be passed to the UDF and any returned value optionally captured. Currently the only UDF language supported is Lua. ```php $where = Aerospike::predicateBetween(\"age\", 30, 39); $status = $client->queryApply(\"test\", \"users\", \"my_udf\", \"mytransform\", [20], $job_id); if ($status === Aerospike::OK) { var_dump(\"Job ID is $job_id\"); } else if ($status === Aerospike::ERR_CLIENT) { echo \"An error occured while initiating the BACKGROUND SCAN [{$client->errorno()}] \".$client->error(); } else { echo \"An error occured while running the BACKGROUND SCAN [{$client->errorno()}] \".$client->error(); } ``` ``` string(12) \"Job ID is 1\" ``` predicate methods. The arrays conform to one of the following: ``` Array: bin => bin name op => one of Aerospike::OP_EQ, Aerospike::OP_BETWEEN, Aerospike::OP_CONTAINS, Aerospike::OP_RANGE, etc val => scalar integer/string for OP_EQ and OP_CONTAINS or [$min, $max] for OP_BETWEEN and OP_RANGE or an empty array() for no predicate ``` examples ``` [\"bin\"=>\"name\", \"op\"=>Aerospike::OP_EQ, \"val\"=>\"foo\"] [\"bin\"=>\"age\", \"op\"=>Aerospike::OP_BETWEEN, \"val\"=>[35,50]] [\"bin\"=>\"movies\", \"op\"=>Aerospike::OP_CONTAINS, \"val\"=>\"12 Monkeys\"] [\"bin\"=>\"movies\", \"op\"=>Aerospike::OP_RANGE, \"val\"=>[10,1000]] [] // no predicate ``` * Aerospike::OPT_WRITE_TIMEOUT * Aerospike::OPT_POLICY_DURABLE_DELETE * Aerospike::OPT_READ_TIMEOUT * Aerospike::OPT_SLEEP_BETWEEN_RETRIES * Aerospike::OPT_TOTAL_TIMEOUT * Aerospike::OPT_MAX_RETRIES * Aerospike::OPT_SOCKET_TIMEOUT /","params":[{"name":"ns","declared_type":"string","description":"the namespace"},{"name":"set","declared_type":"string","description":"the set within the given namespace"},{"name":"where","declared_type":"array","description":"the predicate for the query, usually created by the"},{"name":"module","declared_type":"string","description":"the name of the UDF module registered with the cluster"},{"name":"function","declared_type":"string","description":"the name of the UDF"},{"name":"args","declared_type":"array","description":"optional arguments for the UDF"},{"name":"","declared_type":null,"description":null},{"name":"options","declared_type":"array","description":"an optional array of policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"reconnect","fqn":"Aerospike::reconnect","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":12317,"end":12326}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Reconnect the client to the cluster nodes. Aerospike::isConnected() can be used to test whether the re-connection succeded. If a connection error occured Aerospike::error() and Aerospike::errorno() can be used to inspect it. ```php $client = new Aerospike($config, false); $client->close(); $client->reconnect(); if (!$client->isConnected()) { echo \"Aerospike failed to connect[{$client->errorno()}]: {$client->error()}\\n\"; exit(1); } ``` /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"register","fqn":"Aerospike::register","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":130681,"end":130689}},"declared_type":null,"signature":{"parameters":[{"name":"path","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"module","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"language","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":null,"phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Register a UDF module with the cluster Note that modules containing stream UDFs need to also be copied to the path described in `aerospike.udf.lua_user_path`, as the last reduce iteration is run locally on the client (after reducing on all the nodes of the cluster). Currently the only UDF language supported is Lua. ```php $status = $client->register('/path/to/my_udf.lua', 'my_udf.lua'); if ($status == Aerospike::OK) { echo \"UDF module at $path is registered as my_udf on the Aerospike DB.\\n\"; } else { echo \"[{$client->errorno()}] \".$client->error(); } ``` * Aerospike::OPT_WRITE_TIMEOUT /","params":[{"name":"path","declared_type":"string","description":"the path to the Lua file on the client-side machine"},{"name":"module","declared_type":"string","description":"the name of the UDF module to register with the cluster"},{"name":"language","declared_type":"int","description":null},{"name":"options","declared_type":"array","description":"an optional array of policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"remove","fqn":"Aerospike::remove","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":36006,"end":36012}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Remove the record identified by the $key. ```php $key = $client->initKey(\"test\", \"users\", 1234); $status = $client->remove($key); if ($status == Aerospike::OK) { echo \"Record removed.\\n\"; } elseif ($status == Aerospike::ERR_RECORD_NOT_FOUND) { echo \"A user with key \". $key['key']. \" does not exist in the database\\n\"; } else { echo \"[{$client->errorno()}] \".$client->error(); } ``` ``` Record removed. ``` * Aerospike::OPT_WRITE_TIMEOUT * Aerospike::OPT_POLICY_GEN * Aerospike::OPT_POLICY_COMMIT_LEVEL * Aerospike::OPT_POLICY_DURABLE_DELETE * Aerospike::OPT_SLEEP_BETWEEN_RETRIES * Aerospike::OPT_TOTAL_TIMEOUT * Aerospike::OPT_MAX_RETRIES * Aerospike::OPT_SOCKET_TIMEOUT /","params":[{"name":"key","declared_type":"array","description":"The key identifying the record. An array with keys `['ns','set','key']` or `['ns','set','digest']`"},{"name":"options","declared_type":"array","description":"an optional array of write policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"removeBin","fqn":"Aerospike::removeBin","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":38133,"end":38142}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"bins","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Remove $bins from the record identified by the $key. ```php $key = [\"ns\" => \"test\", \"set\" => \"users\", \"key\" => 1234]; $options = array(Aerospike::OPT_TTL => 3600); $status = $client->removeBin($key, [\"age\"], $options); if ($status == Aerospike::OK) { echo \"Removed bin 'age' from the record.\\n\"; } elseif ($status == Aerospike::ERR_RECORD_NOT_FOUND) { echo \"The database has no record with the given key.\\n\"; } else { echo \"[{$client->errorno()}] \".$client->error(); } ``` * Aerospike::OPT_WRITE_TIMEOUT * Aerospike::OPT_POLICY_KEY * Aerospike::OPT_POLICY_GEN * Aerospike::OPT_POLICY_COMMIT_LEVEL * Aerospike::COMPRESSION_THRESHOLD * Aerospike::OPT_SLEEP_BETWEEN_RETRIES * Aerospike::OPT_TOTAL_TIMEOUT * Aerospike::OPT_MAX_RETRIES * Aerospike::OPT_SOCKET_TIMEOUT /","params":[{"name":"key","declared_type":"array","description":"The key identifying the record. An array with keys `['ns','set','key']` or `['ns','set','digest']`"},{"name":"bins","declared_type":"array","description":"A list of bin names to remove"},{"name":"options","declared_type":"array","description":"an optional array of write policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"scan","fqn":"Aerospike::scan","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":118648,"end":118652}},"declared_type":null,"signature":{"parameters":[{"name":"ns","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"set","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"record_cb","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false},{"name":"select","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Scan a namespace or set Scan a _ns.set_, and invoke a callback function *record_cb* on each record streaming back from the cluster. Optionally select the bins to be returned. Non-existent bins in this list will appear in the record with a NULL value. ```php $options = [Aerospike::OPT_SCAN_PRIORITY => Aerospike::SCAN_PRIORITY_MEDIUM]; $processed = 0; $status = $client->scan('test', 'users', function ($record) use (&$processed) { if (!is_null($record['bins']['email'])) echo $record['bins']['email'].\"\\n\"; if ($processed++ > 19) return false; // halt the stream by returning a false }, ['email'], $options); var_dump($status, $processed); ``` ``` foo@example.com : bar@example.com I think a sample of 20 records is enough ``` * Aerospike::OPT_READ_TIMEOUT * Aerospike::OPT_SOCKET_TIMEOUT maximum socket idle time in milliseconds (0 means do not apply a socket idle timeout) * Aerospike::OPT_SCAN_PRIORITY * Aerospike::OPT_SCAN_PERCENTAGE of the records in the set to return * Aerospike::OPT_SCAN_CONCURRENTLY whether to run the scan in parallel * Aerospike::OPT_SCAN_NOBINS whether to not retrieve bins for the records * Aerospike::OPT_SCAN_RPS_LIMIT limit the scan to process OPT_SCAN_RPS_LIMIT per second. /","params":[{"name":"ns","declared_type":"string","description":"the namespace"},{"name":"set","declared_type":"string","description":"the set within the given namespace"},{"name":"record_cb","declared_type":"callable","description":"A callback function invoked for each record streaming back from the cluster"},{"name":"select","declared_type":"array","description":"An array of bin names which are the subset to be returned"},{"name":"options","declared_type":"array","description":"an optional array of policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"scanApply","fqn":"Aerospike::scanApply","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":140054,"end":140063}},"declared_type":null,"signature":{"parameters":[{"name":"ns","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"set","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"module","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"function","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"args","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"job_id","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":true},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Apply a UDF to each record in a scan Scan the *ns.set* and apply a UDF _module.function_ to each of its records. Arguments can be passed to the UDF and any returned value optionally captured. Currently the only UDF language supported is Lua. ```php $status = $client->scanApply(\"test\", \"users\", \"my_udf\", \"mytransform\", array(20), $job_id); if ($status === Aerospike::OK) { var_dump(\"Job ID is $job_id\"); } else if ($status === Aerospike::ERR_CLIENT) { echo \"An error occured while initiating the BACKGROUND SCAN [{$client->errorno()}] \".$client->error(); } else { echo \"An error occured while running the BACKGROUND SCAN [{$client->errorno()}] \".$client->error(); } ``` ``` string(12) \"Job ID is 1\" ``` * Aerospike::OPT_WRITE_TIMEOUT * Aerospike::OPT_POLICY_DURABLE_DELETE * Aerospike::OPT_READ_TIMEOUT * Aerospike::OPT_SLEEP_BETWEEN_RETRIES * Aerospike::OPT_TOTAL_TIMEOUT * Aerospike::OPT_MAX_RETRIES * Aerospike::OPT_SOCKET_TIMEOUT * Aerospike::OPT_FAIL_ON_CLUSTER_CHANGE * Aerospike::OPT_SCAN_RPS_LIMIT /","params":[{"name":"ns","declared_type":"string","description":"the namespace"},{"name":"set","declared_type":"string","description":"the set within the given namespace"},{"name":"module","declared_type":"string","description":"the name of the UDF module registered with the cluster"},{"name":"function","declared_type":"string","description":"the name of the UDF"},{"name":"args","declared_type":"array","description":"optional arguments for the UDF"},{"name":"","declared_type":null,"description":null},{"name":"options","declared_type":"array","description":"an optional array of policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setDeserializer","fqn":"Aerospike::setDeserializer","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":160049,"end":160064}},"declared_type":null,"signature":{"parameters":[{"name":"unserialize_cb","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Set a deserialization handler for unsupported types Registers a callback method that will be triggered whenever a read method handles a value whose type is unsupported. This is a static method and the *unserialize_cb* handler is global across all instances of the Aerospike class. ```php Aerospike::setDeserializer(function ($val) { return json_decode(gzuncompress($val)); }); ``` ```php // $value is binary data of type AS_BYTES_BLOB function aerospike_deserialize ( string $value ) ``` /","params":[{"name":"unserialize_cb","declared_type":"callable","description":"a callback invoked for each value of an unsupported type, when reading from the cluster. The function must follow the signature"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setLogHandler","fqn":"Aerospike::setLogHandler","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":157978,"end":157991}},"declared_type":null,"signature":{"parameters":[{"name":"log_handler","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Set a handler for log events Registers a callback method that will be triggered whenever a logging event above the declared log threshold occurs. ```php $config = [\"hosts\" => [[\"addr\"=>\"localhost\", \"port\"=>3000]], \"shm\"=>[]]; $client = new Aerospike($config, true); if (!$client->isConnected()) { echo \"Aerospike failed to connect[{$client->errorno()}]: {$client->error()}\\n\"; exit(1); } $client->setLogLevel(Aerospike::LOG_LEVEL_DEBUG); $client->setLogHandler(function ($level, $file, $function, $line) { switch ($level) { case Aerospike::LOG_LEVEL_ERROR: $lvl_str = 'ERROR'; break; case Aerospike::LOG_LEVEL_WARN: $lvl_str = 'WARN'; break; case Aerospike::LOG_LEVEL_INFO: $lvl_str = 'INFO'; break; case Aerospike::LOG_LEVEL_DEBUG: $lvl_str = 'DEBUG'; break; case Aerospike::LOG_LEVEL_TRACE: $lvl_str = 'TRACE'; break; default: $lvl_str = '???'; } error_log(\"[$lvl_str] in $function at $file:$line\"); }); ``` ```php function log_handler ( int $level, string $file, string $function, int $line ) : void ``` /","params":[{"name":"log_handler","declared_type":"callable","description":"a callback function with the signature"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setLogLevel","fqn":"Aerospike::setLogLevel","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":156389,"end":156400}},"declared_type":null,"signature":{"parameters":[{"name":"log_level","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Set the logging threshold of the Aerospike object * Aerospike::LOG_LEVEL_OFF * Aerospike::LOG_LEVEL_ERROR * Aerospike::LOG_LEVEL_WARN * Aerospike::LOG_LEVEL_INFO * Aerospike::LOG_LEVEL_DEBUG * Aerospike::LOG_LEVEL_TRACE /","params":[{"name":"log_level","declared_type":"int","description":"one of `Aerospike::LOG_LEVEL_*` values"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"setSerializer","fqn":"Aerospike::setSerializer","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":159004,"end":159017}},"declared_type":null,"signature":{"parameters":[{"name":"serialize_cb","declared_type":"callable","phpdoc_type":"callable","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Set a serialization handler for unsupported types Registers a callback method that will be triggered whenever a write method handles a value whose type is unsupported. This is a static method and the *serialize_cb* handler is global across all instances of the Aerospike class. ```php Aerospike::setSerializer(function ($val) { return gzcompress(json_encode($val)); }); ``` ```php function aerospike_serialize ( mixed $value ) : string ``` /","params":[{"name":"serialize_cb","declared_type":"callable","description":"a callback invoked for each value of an unsupported type, when writing to the cluster. The function must follow the signature"}],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"shmKey","fqn":"Aerospike::shmKey","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":12852,"end":12858}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int|null"},"documentation":{"description":"Expose the shared memory key used by shared-memory cluster tending If shm cluster tending is enabled, Aerospike::shmKey will return the value of the shm key being used by the client. If it was set explicitly under the client's shm config parameter, or through the global `aerospike.shm.key` we expect to see that value. Otherwise the implicit value generated by the client will be returned /","params":[],"return_type":"int|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"touch","fqn":"Aerospike::touch","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":34032,"end":34037}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":"array","phpdoc_type":"array","optional":false,"variadic":false,"by_reference":false},{"name":"ttl","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Touch the record identified by the $key, resetting its time-to-live. ```php $key = $client->initKey(\"test\", \"users\", 1234); $status = $client->touch($key, 120); if ($status == Aerospike::OK) { echo \"Added 120 seconds to the record's expiration.\\n\" } elseif ($status == Aerospike::ERR_RECORD_NOT_FOUND) { echo \"A user with key \". $key['key']. \" does not exist in the database\\n\"; } else { echo \"[{$client->errorno()}] \".$client->error(); } ``` ``` Added 120 seconds to the record's expiration. ``` **or** ``` A user with key 1234 does not exist in the database. ``` * Aerospike::OPT_WRITE_TIMEOUT * Aerospike::OPT_POLICY_KEY * Aerospike::OPT_POLICY_GEN * Aerospike::OPT_POLICY_COMMIT_LEVEL * Aerospike::OPT_DESERIALIZE * Aerospike::OPT_SLEEP_BETWEEN_RETRIES * Aerospike::OPT_TOTAL_TIMEOUT * Aerospike::OPT_MAX_RETRIES * Aerospike::OPT_SOCKET_TIMEOUT /","params":[{"name":"key","declared_type":"array","description":"The key identifying the record. An array with keys `['ns','set','key']` or `['ns','set','digest']`"},{"name":"ttl","declared_type":"int","description":"The record's time-to-live in seconds"},{"name":"options","declared_type":"array","description":"an optional array of write policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"truncate","fqn":"Aerospike::truncate","kind":"Method","origin":"PhpRuntime","extension":"aerospike","location":{"file":"aerospike/aerospike.php","range":{"start":40257,"end":40265}},"declared_type":null,"signature":{"parameters":[{"name":"ns","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"set","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"nanos","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Remove all the records from a namespace or set Remove records in a specified namespace/set efficiently. This method is many orders of magnitude faster than deleting records one at a time. **Note:** works with Aerospike Server versions >= 3.12 See {@link https://www.aerospike.com/docs/reference/info#truncate Truncate command information} This asynchronous server call may return before the truncation is complete. The user can still write new records after the server returns because new records will have last update times greater than the truncate cutoff (set at the time of truncate call). The truncate command does not durably delete records in the Community Edition. The Enterprise Edition provides durability through the truncate command. ```php $secondsInDay = 24 * 60 * 60; // Multiply by 10 ^ 9 to get nanoseconds $yesterday = 1000000000 * (time() - $secondsInDay); // Remove all records in test/truncateSet updated before 24 hours ago $status = $client->truncate(\"test\", \"demoSet\", $yesterday); // Truncate all records in test, regardless of update time $status = $client->truncate(\"test\", null, 0); ``` last updated before the threshold will be removed. Units are in nanoseconds since unix epoch (1970-01-01 00:00:00). A value of 0 indicates that all records in the set should be truncated regardless of update time. The value must not be in the future. * Aerospike::OPT_WRITE_TIMEOUT /","params":[{"name":"ns","declared_type":"string","description":"the namespace"},{"name":"set","declared_type":"string","description":"the set within the given namespace"},{"name":"nanos","declared_type":"int","description":"cutoff threshold indicating that records"},{"name":"options","declared_type":"array","description":"an optional array of write policy options, whose keys include"}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"AllowDynamicProperties::__construct","kind":"Method","origin":"PhpRuntime","extension":"Core","location":{"file":"Core/Core_c.php","range":{"start":44760,"end":44771}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":null},"documentation":{"description":"Construct a new AllowDynamicProperties attribute instance Constructs a new AllowDynamicProperties instance. /","params":[],"return_type":null,"var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"__construct","fqn":"AMQPBasicProperties::__construct","kind":"Method","origin":"PhpRuntime","extension":"amqp","location":{"file":"amqp/amqp.php","range":{"start":4894,"end":4905}},"declared_type":null,"signature":{"parameters":[{"name":"contentType","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"contentEncoding","declared_type":"?string","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"headers","declared_type":"array","phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"deliver