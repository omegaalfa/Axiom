ll,"until":null},"is_static":false},{"name":"flush","fqn":"MemcachePool::flush","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":19403,"end":19408}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"(PECL memcache &gt;= 1.0.0)<br/> Flush all existing items at the server /","params":[],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"get","fqn":"MemcachePool::get","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":14664,"end":14667}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string|array","optional":false,"variadic":false,"by_reference":false},{"name":"flags","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":true}],"declared_return_type":null,"phpdoc_return_type":"string|array|false"},"documentation":{"description":"(PECL memcache &gt;= 0.2.0)<br/> Retrieve item from the server The key or array of keys to fetch. </p> If present, flags fetched along with the values will be written to this parameter. These flags are the same as the ones given to for example {@link https://php.net/manual/en/memcache.set.php Memcache::set()}. The lowest byte of the int is reserved for pecl/memcache internal usage (e.g. to indicate compression and serialization status). </p> Returns the string associated with the <b>key</b> or an array of found key-value pairs when <b>key</b> is an {@link https://php.net/manual/en/language.types.array.php array}. Returns <b>FALSE</b> on failure, <b>key</b> is not found or <b>key</b> is an empty {@link https://php.net/manual/en/language.types.array.php array}. </p> /","params":[{"name":"key","declared_type":"string|array","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"string|array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getExtendedStats","fqn":"MemcachePool::getExtendedStats","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":17306,"end":17322}},"declared_type":null,"signature":{"parameters":[{"name":"type","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"slabid","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"limit","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PECL memcache &gt;= 2.0.0)<br/> Get statistics from all servers in pool Used in conjunction with <b>type</b> set to cachedump to identify the slab to dump from. The cachedump command ties up the server and is strictly to be used for debugging purposes. </p> Returns a two-dimensional associative array of server statistics or <b>FALSE</b> on failure. /","params":[{"name":"type","declared_type":"string","description":"[optional] <p>The type of statistics to fetch. Valid values are {reset, malloc, maps, cachedump, slabs, items, sizes}. According to the memcached protocol spec these additional arguments \"are subject to change for the convenience of memcache developers\".</p>"},{"name":"slabid","declared_type":"int","description":"[optional] <p>"},{"name":"limit","declared_type":"int","description":"Used in conjunction with type set to cachedump to limit the number of entries to dump."}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getServerStatus","fqn":"MemcachePool::getServerStatus","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":7626,"end":7641}},"declared_type":null,"signature":{"parameters":[{"name":"host","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"port","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"(PECL memcache &gt;= 2.1.0)<br/> Returns server status /","params":[{"name":"host","declared_type":"string","description":"Point to the host where memcached is listening for connections."},{"name":"port","declared_type":"int","description":"Point to the port where memcached is listening for connections."}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getStats","fqn":"MemcachePool::getStats","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":16182,"end":16190}},"declared_type":null,"signature":{"parameters":[{"name":"type","declared_type":null,"phpdoc_type":"string","optional":true,"variadic":false,"by_reference":false},{"name":"slabid","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"limit","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array|false"},"documentation":{"description":"(PECL memcache &gt;= 0.2.0)<br/> Get statistics of the server The type of statistics to fetch. Valid values are {reset, malloc, maps, cachedump, slabs, items, sizes}. According to the memcached protocol spec these additional arguments \"are subject to change for the convenience of memcache developers\".</p> Used in conjunction with <b>type</b> set to cachedump to identify the slab to dump from. The cachedump command ties up the server and is strictly to be used for debugging purposes. </p> Used in conjunction with <b>type</b> set to cachedump to limit the number of entries to dump. </p> /","params":[{"name":"type","declared_type":"string","description":"[optional] <p>"},{"name":"slabid","declared_type":"int","description":"[optional] <p>"},{"name":"limit","declared_type":"int","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"getVersion","fqn":"MemcachePool::getVersion","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":7978,"end":7988}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"string|false"},"documentation":{"description":"(PECL memcache &gt;= 0.2.0)<br/> Return version of the server /","params":[],"return_type":"string|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"increment","fqn":"MemcachePool::increment","kind":"Method","origin":"PhpRuntime","extension":"memcache","location":{"file":"memcache/memcache.php","range":{"start":18440,"end":18449}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int|false"},"documentation":{"description":"(PECL memcache &gt;= 0.2.0)<br/> Increment item's value /","params":[{"name":"key","declared_type":"string","description":"Key of the item to increment."},{"name":"value","declared_type":"int","description":"[optional] increment the item by <b>value</b>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"