_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Flood fill to specific color x-coordinate of start. </p> y-coordinate of start. </p> The border color. A color identifier created with imagecolorallocate. </p> The fill color. A color identifier created with imagecolorallocate. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"x","declared_type":"int","description":"<p>"},{"name":"y","declared_type":"int","description":"<p>"},{"name":"border_color","declared_type":"int","description":"<p>"},{"name":"color","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagefilter","fqn":"imagefilter","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":70607,"end":70618}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"filter","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"arg1","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"arg2","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"arg3","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"arg4","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"args","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":true,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Applies a filter to an image filtertype can be one of the following: IMG_FILTER_NEGATE: Reverses all colors of the image.</p> IMG_FILTER_SCATTER filter. /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"filter","declared_type":"int","description":"<p>"},{"name":"","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":["\\ValueError"],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imageflip","fqn":"imageflip","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":100521,"end":100530}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Flips an image using a given mode An image resource, returned by one of the image creation functions, such as {@link https://php.net/manual/en/function.imagecreatetruecolor.php imagecreatetruecolor()}. </p> Flip mode, this can be one of the <b>IMG_FLIP_*</b> constants: </p> <table> <thead> <tr> <th>Constant</th> <th>Meaning</th> </tr> </thead> <tbody> <tr> <td><b>IMG_FLIP_HORIZONTAL</b></td> <td> Flips the image horizontally. </td> </tr> <tr> <td><b>IMG_FLIP_VERTICAL</b></td> <td> Flips the image vertically. </td> </tr> <tr> <td><b>IMG_FLIP_BOTH</b></td> <td> Flips the image both horizontally and vertically. </td> </tr> </tbody> </table> /","params":[{"name":"image","declared_type":"resource|GdImage","description":"<p>"},{"name":"mode","declared_type":"int","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagefontheight","fqn":"imagefontheight","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":41129,"end":41144}},"declared_type":null,"signature":{"parameters":[{"name":"font","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Get font height /","params":[{"name":"font","declared_type":"int","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagefontwidth","fqn":"imagefontwidth","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":40863,"end":40877}},"declared_type":null,"signature":{"parameters":[{"name":"font","declared_type":null,"phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int","phpdoc_return_type":"int"},"documentation":{"description":"Get font width /","params":[{"name":"font","declared_type":"int","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imageftbbox","fqn":"imageftbbox","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":56716,"end":56727}},"declared_type":null,"signature":{"parameters":[{"name":"size","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"angle","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"font_filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"string","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Give the bounding box of a text using fonts via freetype2 The font size. Depending on your version of GD, this should be specified as the pixel size (GD1) or point size (GD2). </p> Angle in degrees in which text will be measured. </p> The name of the TrueType font file (can be a URL). Depending on which version of the GD library that PHP is using, it may attempt to search for files that do not begin with a leading '/' by appending '.ttf' to the filename and searching along a library-defined font path. </p> The string to be measured. </p> <table> Possible array indexes for extrainfo <tr valign=\"top\"> <td>Key</td> <td>Type</td> <td>Meaning</td> </tr> <tr valign=\"top\"> <td>linespacing</td> <td>float</td> <td>Defines drawing linespacing</td> </tr> </table> </p> elements representing four points making the bounding box of the text: <tr valign=\"top\"> <td>0</td> <td>lower left corner, X position</td> </tr> <tr valign=\"top\"> <td>1</td> <td>lower left corner, Y position</td> </tr> <tr valign=\"top\"> <td>2</td> <td>lower right corner, X position</td> </tr> <tr valign=\"top\"> <td>3</td> <td>lower right corner, Y position</td> </tr> <tr valign=\"top\"> <td>4</td> <td>upper right corner, X position</td> </tr> <tr valign=\"top\"> <td>5</td> <td>upper right corner, Y position</td> </tr> <tr valign=\"top\"> <td>6</td> <td>upper left corner, X position</td> </tr> <tr valign=\"top\"> <td>7</td> <td>upper left corner, Y position</td> </tr> </p> <p> The points are relative to the text regardless of the angle, so \"upper left\" means in the top left-hand corner seeing the text horizontally. Returns false on error. /","params":[{"name":"size","declared_type":"float","description":"<p>"},{"name":"angle","declared_type":"float","description":"<p>"},{"name":"font_filename","declared_type":"string","description":"<p>"},{"name":"string","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"array","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagefttext","fqn":"imagefttext","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":60318,"end":60329}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"size","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"angle","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"x","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"y","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"color","declared_type":"int","phpdoc_type":"int","optional":false,"variadic":false,"by_reference":false},{"name":"font_filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"text","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false},{"name":"options","declared_type":"array","phpdoc_type":"array","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"array|false","phpdoc_return_type":"array|false"},"documentation":{"description":"Write text to the image using fonts using FreeType 2 The font size to use in points. </p> The angle in degrees, with 0 degrees being left-to-right reading text. Higher values represent a counter-clockwise rotation. For example, a value of 90 would result in bottom-to-top reading text. </p> The coordinates given by x and y will define the basepoint of the first character (roughly the lower-left corner of the character). This is different from the imagestring, where x and y define the upper-left corner of the first character. For example, \"top left\" is 0, 0. </p> The y-ordinate. This sets the position of the fonts baseline, not the very bottom of the character. </p> The index of the desired color for the text, see imagecolorexact. </p> The path to the TrueType font you wish to use. </p> <p> Depending on which version of the GD library PHP is using, when font_filename does not begin with a leading / then .ttf will be appended to the filename and the library will attempt to search for that filename along a library-defined font path. </p> <p> When using versions of the GD library lower than 2.0.18, a space character, rather than a semicolon, was used as the 'path separator' for different font files. Unintentional use of this feature will result in the warning message: Warning: Could not find/open font. For these affected versions, the only solution is moving the font to a path which does not contain spaces. </p> <p> In many cases where a font resides in the same directory as the script using it the following trick will alleviate any include problems. </p> <pre> <?php // Set the enviroment variable for GD putenv('GDFONTPATH=' . realpath('.')); // Name the font to be used (note the lack of the .ttf extension) $font = 'SomeFont'; ?> </pre> <p> <strong>Note:</strong> <code>open_basedir</code> does <em>not</em> apply to font_filename. </p> Text to be inserted into image. </p> <table> Possible array indexes for extrainfo <tr valign=\"top\"> <td>Key</td> <td>Type</td> <td>Meaning</td> </tr> <tr valign=\"top\"> <td>linespacing</td> <td>float</td> <td>Defines drawing linespacing</td> </tr> </table> </p> <tr valign=\"top\"> <td>0</td> <td>lower left x-coordinate</td> </tr> <tr valign=\"top\"> <td>1</td> <td>lower left y-coordinate</td> </tr> <tr valign=\"top\"> <td>2</td> <td>lower right x-coordinate</td> </tr> <tr valign=\"top\"> <td>3</td> <td>lower right y-coordinate</td> </tr> <tr valign=\"top\"> <td>4</td> <td>upper right x-coordinate</td> </tr> <tr valign=\"top\"> <td>5</td> <td>upper right y-coordinate</td> </tr> <tr valign=\"top\"> <td>6</td> <td>upper left x-coordinate</td> </tr> <tr valign=\"top\"> <td>7</td> <td>upper left y-coordinate</td> </tr> Returns false on error. /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"size","declared_type":"float","description":"<p>"},{"name":"angle","declared_type":"float","description":"<p>"},{"name":"x","declared_type":"int","description":"<p>"},{"name":"y","declared_type":"int","description":"<p>"},{"name":"color","declared_type":"int","description":"<p>"},{"name":"font_filename","declared_type":"string","description":"<p>"},{"name":"text","declared_type":"string","description":"<p>"},{"name":"options","declared_type":"array","description":"[optional] <p>"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagegammacorrect","fqn":"imagegammacorrect","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":37498,"end":37515}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"input_gamma","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false},{"name":"output_gamma","declared_type":"float","phpdoc_type":"float","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Apply a gamma correction to a GD image The input gamma. </p> The output gamma. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"input_gamma","declared_type":"float","description":"<p>"},{"name":"output_gamma","declared_type":"float","description":"<p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagegd","fqn":"imagegd","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":36061,"end":36068}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"file","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Output GD image to browser or file. <br/> Since 7.2.0 allows to output truecolor images. The path to save the file to. If not set or null, the raw image stream will be outputted directly. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"file","declared_type":"string|null","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagegd2","fqn":"imagegd2","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":36655,"end":36663}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false},{"name":"file","declared_type":"?string","phpdoc_type":"string|null","optional":true,"variadic":false,"by_reference":false},{"name":"chunk_size","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"mode","declared_type":"int","phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":"bool","phpdoc_return_type":"bool"},"documentation":{"description":"Output GD2 image to browser or file The path to save the file to. If not set or null, the raw image stream will be outputted directly. </p> Chunk size. </p> Either IMG_GD2_RAW or IMG_GD2_COMPRESSED. Default is IMG_GD2_RAW. </p> /","params":[{"name":"image","declared_type":"resource|GdImage","description":null},{"name":"file","declared_type":"string|null","description":"[optional] <p>"},{"name":"chunk_size","declared_type":"int","description":"[optional] <p>"},{"name":"mode","declared_type":"int","description":"[optional] <p>"}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagegetclip","fqn":"imagegetclip","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":74505,"end":74517}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":"GdImage","phpdoc_type":"resource|GdImage","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"array","phpdoc_return_type":"array|false"},"documentation":{"description":"<b>imagegetclip()</b> retrieves the current clipping rectangle, i.e. the area beyond which no pixels will be drawn. <ul> <li>x-coordinate of the upper left corner</li> <li>y-coordinate of the upper left corner</li> <li>x-coordinate of the lower right corner</li> <li>y-coordinate of the lower right corner</li> </ul> Returns <b>FALSE</b> on error. /","params":[{"name":"image","declared_type":"resource|GdImage","description":"An image resource, returned by one of the image creation functions, such as {@see imagecreatetruecolor()}"}],"return_type":"array|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"imagegetinterpolation","fqn":"imagegetinterpolation","kind":"Function","origin":"PhpRuntime","extension":"gd","location":{"file":"gd/gd.php","range":{"start":78472,"end":78493}},"declared_ty