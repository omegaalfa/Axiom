ion</td> </tr> <tr valign=\"top\"> <td> FILE_USE_INCLUDE_PATH </td> <td> Search for filename in the include directory. See include_path for more information. </td> </tr> <tr valign=\"top\"> <td> FILE_APPEND </td> <td> If file filename already exists, append the data to the file instead of overwriting it. Mutually exclusive with LOCK_EX since appends are atomic and thus there is no reason to lock. </td> </tr> <tr valign=\"top\"> <td> LOCK_EX </td> <td> Acquire an exclusive lock on the file while proceeding to the writing. Mutually exclusive with FILE_APPEND. </td> </tr> </table> </p> A valid context resource created with stream_context_create. </p> false on failure. /","params":[{"name":"filename","declared_type":"string","description":"<p>"},{"name":"data","declared_type":"mixed","description":"<p>"},{"name":"flags","declared_type":"int","description":"[optional] <p>"},{"name":"context","declared_type":"resource","description":"[optional] <p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"fileatime","fqn":"fileatime","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7.php","range":{"start":15263,"end":15272}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":"string","phpdoc_type":"string","optional":false,"variadic":false,"by_reference":false}],"declared_return_type":"int|false","phpdoc_return_type":"int|false"},"documentation":{"description":"Gets last access time of file Path to the file. </p> The time is returned as a Unix timestamp. /","params":[{"name":"filename","declared_type":"string","description":"<p>"}],"return_type":"int|false","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"filectime","fqn":"filectime","kind":"Function","origin":"PhpRuntime","extension":"standard","location":{"file":"standard/standard_7