ull","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_exec","fqn":"wb_exec","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":8346,"end":8353}},"declared_type":null,"signature":{"parameters":[{"name":"command","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"param","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Opens or executes a command. The string passed to this function can be one of the following:. A WinBinder script. An executable file. A non-executable file associated with an application. A folder name. Passing a null or empty string opens the current folder. A help file or help file topic. An URL, e-mail, newsgroup, or another Internet client application. Optional parameters can be passed to the command or application through the variable param. /","params":[{"name":"command","declared_type":null,"description":null},{"name":"param","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_find_file","fqn":"wb_find_file","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":5383,"end":5395}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Looks for a file in the Windows and System directories, in this order. If the file exists, return the complete path to it. If not, return filename. /","params":[{"name":"filename","declared_type":null,"description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_address","fqn":"wb_get_address","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":34373,"end":34387}},"declared_type":null,"signature":{"parameters":[{"name":"var","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns the address (as an integer pointer) of the variable var. var can be a string, integer, boolean, or double. This function is specially suited to use with wb_peek() and wb_poke(). /","params":[{"name":"var","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_class","fqn":"wb_get_class","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":25089,"end":25101}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns an integer that corresponds to the class of the object (control, window or menu) passed as the parameter. The class is passed as a parameter to functions wb_create_control() and wb_create_window(). /","params":[{"name":"wbobject","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_control","fqn":"wb_get_control","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":25454,"end":25468}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"id","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns an integer handle that corresponds to the WinBinder object (control, toolbar item or menu item) wbobject that has the supplied identifier id. This function is typically used to retrieve the handle of a child control in a dialog box or in a menu item. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"id","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_enabled","fqn":"wb_get_enabled","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":25607,"end":25621}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Returns TRUE if wbobject is enabled or FALSE otherwise. /","params":[{"name":"wbobject","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_enum_callback","fqn":"wb_get_enum_callback","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":39227,"end":39247}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Enumerate windows, i think: https://docs.microsoft.com/en-us/windows/win32/api/winuser/nf-winuser-enumwindows /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_focus","fqn":"wb_get_focus","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":25746,"end":25758}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns a handle to the window or control that has the keyboard focus. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_function_address","fqn":"wb_get_function_address","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":38366,"end":38389}},"declared_type":null,"signature":{"parameters":[{"name":"fname","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"idlib","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns the address of a library function. fname is the function name and idlib identifies a library already loaded. The idlib identifier must have been obtained with a call to wb_load_library(). If idlib is not set or is set to NULL, the last library sent to the function will be used. Name expansion: The function prepends and appends some special characters to the function name until it finds the function name, then it returns the function address or NULL if the function was not found. These special characters are the most common ones encountered in various types of libraries. For example, if fname is set to \"MyFunction\", wb_get_function_address() looks for the following function names, in order: MyFunction MyFunctionA MyFunctionW _MyFunction _MyFunctionA _MyFunctionW MyFunction@0, MyFunction@4, MyFunction@8... until MyFunction@80 _MyFunction@0, _MyFunction@4, _MyFunction@8... until MyFunction@80 The last two expansion options include a '@' character followed by the number of parameters times 4, which is a standard way to store function names inside DLLs. The loop starts from zero (\"@0\") and ends when it reaches 20 parameters (\"@80\"). NOTE: Function names, including the expansion characters, are limited to 255 characters. /","params":[{"name":"fname","declared_type":null,"description":null},{"name":"idlib","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_hook_callback","fqn":"wb_get_hook_callback","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":39388,"end":39408}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Unused, i think its https://docs.microsoft.com/en-us/windows/win32/api/winuser/nc-winuser-hookproc /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_id","fqn":"wb_get_id","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":25882,"end":25891}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns the integer identifier of the wbobject control. /","params":[{"name":"wbobject","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_image_data","fqn":"wb_get_image_data","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":15517,"end":15534}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"compress4to3","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns a string of data containing a copy of the internal true-color representation of the given image. If compress4to3 is TRUE, every fourth byte of the original 32-bit data is skipped, yielding a RGB (24-bit) data string. This is required for image libraries such as FreeImage. /","params":[{"name":"image","declared_type":null,"description":null},{"name":"compress4to3","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_instance","fqn":"wb_get_instance","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":44670,"end":44685}},"declared_type":null,"signature":{"parameters":[{"name":"caption","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"bringtofront","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Detects a running instance of a WinBinder application. Detecting running instances Each main window of all WinBinder applications stores a 32-bit identifier that is calculated according to the initial window caption and is unique to that caption. wb_get_instance() will try to find, among all current top-level windows, a WinBinder window that was created with the same caption. The function returns TRUE if it finds the existing window or FALSE if it is does not. The function is effective even of the caption of the first instance of the application is changed at runtime because the 32-bit identifier does not change throughout the life of the application. If bringtofront is set to TRUE, the function optionally restores the window (if minimized) and brings the corresponding window to the front of other windows. /","params":[{"name":"caption","declared_type":null,"description":null},{"name":"bringtofront","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_item_count","fqn":"wb_get_item_count","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":26115,"end":26132}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns the number of items of wbobject. ComboBox    The number of items ListBox    The number of items ListView    The number of rows /","params":[{"name":"wbobject","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_item_list","fqn":"wb_get_item_list","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":44941,"end":44957}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Returns an array with a list of the child controls in window or control wbobject. Each element is an integer identifier that represents a WinBinder object. /","params":[{"name":"wbobject","declared_type":null,"description":null}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_level","fqn":"wb_get_level","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":32644,"end":32656}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"item","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Retrieves an integer representing the level of a control item. Retrieving states: This function currently returns the insertion level of the treeview node specified in item. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"item","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_midi_callback","fqn":"wb_get_midi_callback","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":39052,"end":39072}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"returns a pointer to MidiOutProc (can also be used for MidiInProc, WaveInProc, WaveOutProc or any similar callback) for use with functions like midiOutOpen. /","params":[],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_parent","fqn":"wb_get_parent","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":26354,"end":26367}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"item","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns the handle of the control parent if item specifies a control, or the node parent if item specifies a treeview node. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"item","declared_type":"null","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_pixel","fqn":"wb_get_pixel","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":15866,"end":15878}},"declared_type":null,"signature":{"parameters":[{"name":"source","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"xpos","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"ypos","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Returns the RGB color value of the pixel at the given coordinates. The first parameter, source, may be a WinBinder object, a window handle, a drawing surface or a bitmap. Returns NOCOLOR if an error occurs. /","params":[{"name":"source","declared_type":null,"description":null},{"name":"xpos","declared_type":null,"description":null},{"name":"ypos","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_position","fqn":"wb_get_position","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":42418,"end":42433}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"clientarea","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Returns an array with the position of the control or window related to its parent, in pixels. The first element is the horizontal position and the second is the vertical position. If clientarea is TRUE, the area returned will not include the title bar and borders. The default is FALSE. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"clientarea","declared_type":"null","description":null}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_registry_key","fqn":"wb_get_registry_key","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":10649,"end":10668}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"subkey","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string|null"},"documentation":{"description":"Reads a string or integer value from the Windows registry item referenced by key, subkey and entry. The subkey may contain forward or reverse slashes. If entry is an empty string, a NULL value or is not supplied, the function retrieves the default value for the subkey. Values are always returned as strings. If the requested entry is an empty string, an empty string is returned. If the key does not exist in the registry, the function returns NULL. /","params":[{"name":"key","declared_type":null,"description":null},{"name":"subkey","declared_type":null,"description":null},{"name":"entry","declared_type":"null","description":null}],"return_type":"string|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_selected","fqn":"wb_get_selected","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":27013,"end":27028}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Returns a value or array with the indices or identifiers of the selected elements or items in wbobject. Retrieves: ComboBox    The index of the currently selected item. ListBox    The index of the currently selected item. If multiselected only the last on will be returned (use getText for all items text) ListView    An array with the indices of the selected items. ¹ TabControl    The index of the selected tab page. TreeView    The handle of the currently selected node. Window    0 (zero). Other controls    0 (zero). /","params":[{"name":"wbobject","declared_type":null,"description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_size","fqn":"wb_get_size","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":40841,"end":40852}},"declared_type":null,"signature":{"parameters":[{"name":"object","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"param","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"array"},"documentation":{"description":"Gets the dimensions of a control, window, image or string. The image handle must have been obtained with wb_create_image(), wb_create_mask() or wb_load_image(). This function generally returns an array where the first element is the width and the second is the height. Measurements are in pixels. If param is TRUE, the area returned will not include the title bar and borders. Default is FALSE. The function will return the integer WBC_MINIMIZED instead of an array if the requested window is minimized, or NULL on error. If object is a ListView handle and param is TRUE, the function returns an array with the widths of the column headers. If param is omitted or FALSE, the function behaves normally like described above If object is a text string, param is optionally used to pass the handle to a font created with wb_create_font(). If param is null or not used, the default font is used. Object types accepted object may be one of the following: A control handle A window handle An icon handle A bitmap handle The name of a bitmap file The name of an icon file A text string /","params":[{"name":"object","declared_type":null,"description":null},{"name":"param","declared_type":"null","description":null}],"return_type":"array","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_state","fqn":"wb_get_state","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":27401,"end":27413}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"item","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Retrieves an integer representing the current state of a control item. Retrieving states. This function currently returns the expanded or collapsed state of a treeview node indicated by item. It returns TRUE if the node is expanded and FALSE if it is collapsed. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"item","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_system_info","fqn":"wb_get_system_info","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":10046,"end":10064}},"declared_type":null,"signature":{"parameters":[{"name":"info","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Returns information about the current system and application, according to the string info. The parameter info is not case-sensitive. \"appmemory\"    The total memory used by the application¹ \"backgroundcolor\"    The main face color for Windows dialog boxes and controls \"colordepth\"    The current color depth in bits per pixel \"commandline\"    The original Windows command line including the executable file \"computername\"    The name of the computer inside the network \"consolemode\"    1 indicates that console mode (DOS box) is active, 0 otherwise \"diskdrives\"    The list of all available disk drives \"exepath\"    The path to the main executable (PHP.EXE) \"fontpath\"    The current font path \"freememory\"    The available physical memory \"gdiobjects\"    The number of currently allocated GDI handles \"instance\"    The instance identifier of the current application \"osnumber\"    The numeric OS version number \"ospath\"    The current OS path \"osversion\"    The complete OS version name \"pgmpath\"    The default OS application path \"screenarea\"    The total area (x, y, width, height) of the screen, in pixels \"systemfont\"    The common (default) system font for dialog boxes \"systempath\"    The OS system path \"temppath\"    The path used by the OS to hold temporary files \"totalmemory\"    The total physical memory installed \"username\"    The name of the currently logged user \"userobjects\"    The number of currently allocated USER handles \"workarea\"    The valid area (x, y, width, height) of the screen, in pixels /","params":[{"name":"info","declared_type":null,"description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_value","fqn":"wb_get_value","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":21678,"end":21690}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":"null","optional":false,"variadic":false,"by_reference":false},{"name":"item","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false},{"name":"subitem","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"mixed"},"documentation":{"description":"Retrieves the value of a control or control item. The item and subitem parameters are set to -1 if absent. /","params":[{"name":"wbobject","declared_type":"null","description":null},{"name":"item","declared_type":"int","description":null},{"name":"subitem","declared_type":"int","description":null}],"return_type":"mixed","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_get_visible","fqn":"wb_get_visible","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":27598,"end":27612}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Tells whether an object is visible. Returns TRUE if wbobject is visible and FALSE otherwise. /","params":[{"name":"wbobject","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_load_image","fqn":"wb_load_image","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":13879,"end":13892}},"declared_type":null,"signature":{"parameters":[{"name":"filename","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"index","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"param","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Loads the image, icon or cursor file filename from disk and returns a handle to it. If filename is an icon library, index specifies the index of the image inside the file. Default index is 0. If source is an icon or a cursor, if param is 0 (the default), the function returns a large icon or cursor if param is 1, it returns a small icon or cursor; if param is -1, the function returns the default icon or cursor. NOTE: The resulting image must be destroyed by a call to wb_destroy_image(). /","params":[{"name":"filename","declared_type":null,"description":null},{"name":"index","declared_type":"null","description":null},{"name":"param","declared_type":"null","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_load_library","fqn":"wb_load_library","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":36670,"end":36685}},"declared_type":null,"signature":{"parameters":[{"name":"libname","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Loads a DLL into memory. Returns an integer identifying libname. If libname is NULL then returns the identifier of the last library returned. The function accepts fully qualified and raw names. Returns NULL if no library was found. Name expansion The function appends some characters to the library name until it finds the library, then it returns an identifier for that library, or NULL if the library was not found. If libname is \"LIB\", for example, the function looks for the following files, in order: LIB LIB.DLL LIB32 LIB32.DLL LIB.EXE LIB32.EXE For each name, the function looks in the following locations: The application directory; The current directory; The 32-bit System directory (Usually C:\\WINDOWS\\SYSTEM32 or C:\\WINNT\\SYSTEM32); The 16-bit System directory (Usually C:\\WINDOWS\\SYSTEM or C:\\WINNT\\SYSTEM); The Windows directory (Usually C:\\WINDOWS or C:\\WINNT); The directory list contained in the PATH environment variable. /","params":[{"name":"libname","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_main_loop","fqn":"wb_main_loop","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":5146,"end":5158}},"declared_type":null,"signature":{"parameters":[],"declared_return_type":null,"phpdoc_return_type":"void"},"documentation":{"description":"Enters the Windows main loop. This function must be called if the application has a window. The call to wb_main_loop() must be the last executable statement of the PHP script: All statements after it will be ignored. The return value is used for debugging purposes only and may be ignored. /","params":[],"return_type":"void","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_message_box","fqn":"wb_message_box","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":6197,"end":6211}},"declared_type":null,"signature":{"parameters":[{"name":"parent","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"message","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"title","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"style","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Creates and displays a message box under the style supplied and returns a value according to the button pressed. Value for style & What is displayed WBC_OK (the default) - An OK button. WBC_INFO - An information icon and an OK button. WBC_WARNING - An exclamation point icon and an OK button. WBC_STOP - A stop icon and an OK button. WBC_QUESTION - A question mark icon and an OK button. WBC_OKCANCEL - A question mark icon, an OK button and a Cancel button. WBC_YESNO - A question mark icon, a Yes button and a No button. WBC_YESNOCANCEL - A question mark icon, a Yes button, a No button and a Cancel button. /","params":[{"name":"parent","declared_type":null,"description":null},{"name":"message","declared_type":null,"description":null},{"name":"title","declared_type":"null","description":null},{"name":"style","declared_type":"null","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_peek","fqn":"wb_peek","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":35365,"end":35372}},"declared_type":null,"signature":{"parameters":[{"name":"address","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":null,"phpdoc_type":"int","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"string"},"documentation":{"description":"Gets the contents of a memory area pointed by address. If length is empty or zero, returns bytes up to the first NUL character (zero-character) or up to 32767 bytes, whichever comes first. If length is greater than zero, returns length bytes. /","params":[{"name":"address","declared_type":null,"description":null},{"name":"length","declared_type":"int","description":null}],"return_type":"string","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_play_sound","fqn":"wb_play_sound","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":7388,"end":7401}},"declared_type":null,"signature":{"parameters":[{"name":"source","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"command","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Loads and plays a sound file or system sound. Parameter source may be a sound file name or a system sound constant. Parameter command may be used used to play a WAV sound synchronously or in a loop. A synchronous sound stops the currently playing sound and suspends the application control until it finishes. A MIDI soundtrack always stops any currently playing MIDI soundtrack. To stop one or more sounds, use function wb_stop_sound(). Value of $source: MIDI file name - Load and play the specified MIDI file. WBC_OK - Default system sound WBC_INFO - System information sound WBC_WARNING - Warning sound WBC_STOP - Error sound WBC_QUESTION - Question sound WBC_BEEP - Default beep (via the computer speaker) Value of $command: null or empty - Load and play the specified WAV sound file. 'sync' - Load and play the specified WAV sound file synchronously. 'loop' - Load and loop the specified WAV sound file. Returns TRUE on success or FALSE otherwise. /","params":[{"name":"source","declared_type":null,"description":null},{"name":"command","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_poke","fqn":"wb_poke","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":35559,"end":35566}},"declared_type":null,"signature":{"parameters":[{"name":"address","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"contents","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"length","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Sets the contents of a memory area pointed by address. /","params":[{"name":"address","declared_type":null,"description":null},{"name":"contents","declared_type":null,"description":null},{"name":"length","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_refresh","fqn":"wb_refresh","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":22313,"end":22323}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"now","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"xpos","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"ypos","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"width","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Refreshes or redraws the WinBinder object wbobject, forcing an immediate redraw if the parameter now is TRUE (the default). If now is FALSE, the redraw command is posted to the Windows message queue. Optional parameters xpos, ypos, width and height will make the function invalidate and redraw only the specified part of the screen or control. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"now","declared_type":"null","description":null},{"name":"xpos","declared_type":"null","description":null},{"name":"ypos","declared_type":"null","description":null},{"name":"width","declared_type":"null","description":null},{"name":"height","declared_type":"null","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_release_library","fqn":"wb_release_library","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":36948,"end":36966}},"declared_type":null,"signature":{"parameters":[{"name":"idlib","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Releases the DLL identified by idlib from memory. The idlib identifier must have been obtained with a call to wb_load_library(). NOTE: calling this function is usually not necessary. /","params":[{"name":"idlib","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_save_image","fqn":"wb_save_image","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":14222,"end":14235}},"declared_type":null,"signature":{"parameters":[{"name":"image","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"filename","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Saves the bitmap image to file filename. The image handle must have been obtained with wb_create_image(), wb_create_mask() or wb_load_image(). Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"image","declared_type":null,"description":null},{"name":"filename","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_send_message","fqn":"wb_send_message","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":34964,"end":34979}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"message","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"wparam","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false},{"name":"lparam","declared_type":null,"phpdoc_type":null,"optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Sends a Windows message to the HWND handle of the WinBinder object wbobject. The parameters wparam and lparam, as well as the return value, depend on message. See SendMessage() in the Windows API documentation for more information. The following constant may be used as the wbobject parameter: 0xFFFF This constant is the value of HWND_BROADCAST in the Windows API. For more information consult the Windows API documentation. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"message","declared_type":null,"description":null},{"name":"wparam","declared_type":null,"description":null},{"name":"lparam","declared_type":null,"description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_area","fqn":"wb_set_area","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":45845,"end":45856}},"declared_type":null,"signature":{"parameters":[{"name":"window","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"type","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"x","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"y","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"width","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Sets a specific area in a window. Possible values for type are:. WBC_TITLE        Sets the area used to drag a borderless window with the mouse. WBC_MINSIZE      Sets the minimum window size in a resizable window. Parameters x and y are ignored. If width is zero, no minimum horizontal dimension is set. if height is zero, no minimum vertical dimension is set. WBC_MAXSIZE      Sets the maximum window size in a resizable window. Parameters x and y are ignored. If width is zero, no maximum horizontal dimension is set. if height is zero, no maximum vertical dimension is set. /","params":[{"name":"window","declared_type":null,"description":null},{"name":"type","declared_type":null,"description":null},{"name":"x","declared_type":"null","description":null},{"name":"y","declared_type":"null","description":null},{"name":"width","declared_type":"null","description":null},{"name":"height","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_cursor","fqn":"wb_set_cursor","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":28196,"end":28209}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"source","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Set or change the mouse cursor shape of a window, control, a whole class or application-wide. * The cursor can be set for any window class and for control classes ImageButton, InvisibleArea (deprecated), HyperLink and EditBox. The source parameter can be a cursor handle from function wb_load_image() or one of the preset system cursors: arrow, cross, finger, forbidden, help, ibeam, null (no cursor), sizeall, sizenesw, sizens, sizenwse, sizewe, uparrow, wait and waitarrow. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"source","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_enabled","fqn":"wb_set_enabled","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":22613,"end":22627}},"declared_type":null,"signature":{"parameters":[{"name":"control","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"enabled","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Enables or disables control according to the value of enabled. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"control","declared_type":null,"description":null},{"name":"enabled","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_focus","fqn":"wb_set_focus","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":28389,"end":28401}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Assigns the keyboard focus to wbobject. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"wbobject","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_font","fqn":"wb_set_font","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":34069,"end":34080}},"declared_type":null,"signature":{"parameters":[{"name":"control","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"font","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"redraw","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Sets the font of control. font is a unique integer value returned by wb_create_font(). If font is zero or not given, the most recently created font is used. If font is a negative number, it means the system default font. Returns TRUE on success or FALSE if an error occurs. Tip: To check the system font name and size, call wb_get_system_info() using (\"systemfont\") as the info parameter. /","params":[{"name":"control","declared_type":null,"description":null},{"name":"font","declared_type":"null","description":null},{"name":"redraw","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_handler","fqn":"wb_set_handler","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":29106,"end":29120}},"declared_type":null,"signature":{"parameters":[{"name":"window","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"fn_handler","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool|null"},"documentation":{"description":"Assigns the callback function fn_handler to window. The handler function may be a regular PHP function or class method that is used to process events for this particular window. wb_set_handler() must be called whenever the window needs to process messages and events from its controls. To specify a function as the handler, pass the function name in fn_handler. If the handler is a class method, fn_handler must be an array which first element is the name of the object and the second one is the method name. For additional information, see callback functions and window handlers. /","params":[{"name":"window","declared_type":null,"description":null},{"name":"fn_handler","declared_type":null,"description":null}],"return_type":"bool|null","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_image","fqn":"wb_set_image","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":23705,"end":23717}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"source","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"transparentcolor","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"index","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"param","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Assigns the image source to the WinBinder object wbobject. Parameter source can be either an image, icon or cursor handle or a path to an image file name. If a handle, it must have been obtained with wb_create_image(), wb_create_mask() or wb_load_image(). The optional parameter transparentcolor tells the function which color is to be considered transparent. The default is NOCOLOR (no transparency). index is used to select a specific image from a multi-image file (such as a DLL or executable). If source is an icon or a cursor, if param is 0 (the default), the function sets a large icon or cursor. if param is 1, it sets a small icon or cursor; if param is -1, the function sets the default icon or cursor. For minimized windows, this function will also change the icon that is displayed on the task bar. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"source","declared_type":null,"description":null},{"name":"transparentcolor","declared_type":"null","description":null},{"name":"index","declared_type":"null","description":null},{"name":"param","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_item_image","fqn":"wb_set_item_image","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":24208,"end":24225}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"index","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"item","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"subitem","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Retrieves a portion of the image already assigned to a control and assigns it to a item (and optional subitem). The image must be previously assigned with wb_set_image(). The portion which is assigned is specified by index. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"index","declared_type":null,"description":null},{"name":"item","declared_type":"null","description":null},{"name":"subitem","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_location","fqn":"wb_set_location","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":29755,"end":29770}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"location","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Sets the location of an HTMLControl or sends a special command to it. Returns TRUE on success or FALSE if an error occurs (except when using \"cmd:busy\" as explained below). \"cmd:back\"    Go to previously visited page. \"cmd:forward\"    Go to a page previously viewed before issuing the back command. \"cmd:refresh\"    Redraw the current page. \"cmd:stop\"    Stop the current action, like loading a page. \"cmd:busy\"    Return TRUE if the browser is busy or FALSE if idle. \"cmd:blank\"    Clear the page. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"location","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_position","fqn":"wb_set_position","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":41970,"end":41985}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"xpos","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"ypos","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Moves the object wbobject to the coordinates xpos, ypos in relation to its parent window. If both xpos and ypos have the value WBC_CENTER or are not given, the window is centered on its parent window. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"xpos","declared_type":"null","description":null},{"name":"ypos","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_range","fqn":"wb_set_range","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":30066,"end":30078}},"declared_type":null,"signature":{"parameters":[{"name":"control","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"vmin","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"vmax","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Sets the valid range of values (vmin and vmax) of a control. Valid classes are Gauge, ScrollBar, Slider and Spinner. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"control","declared_type":null,"description":null},{"name":"vmin","declared_type":null,"description":null},{"name":"vmax","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_registry_key","fqn":"wb_set_registry_key","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":11291,"end":11310}},"declared_type":null,"signature":{"parameters":[{"name":"key","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"subkey","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"entry","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"value","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Reads a string or integer value from the Windows registry item referenced by key, subkey and entry. The subkey may contain forward or reverse slashes. If entry is an empty string, a NULL value or is not supplied, the function retrieves the default value for the subkey. Values are always returned as strings. If the requested entry is an empty string, an empty string is returned. If the key does not exist in the registry, the function returns NULL. /","params":[{"name":"key","declared_type":null,"description":null},{"name":"subkey","declared_type":null,"description":null},{"name":"entry","declared_type":"null","description":null},{"name":"value","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_size","fqn":"wb_set_size","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":41552,"end":41563}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"width","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"height","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Sizes the object wbobject to width and height pixels. Parameters width and height may be used as follows: Positive integer     window or control   Sets the window or control size to width and height pixels. WBC_NORMAL           window              Restores the window, if it is not already. WBC_MINIMIZED        window              Minimizes the window, if it is not already. WBC_MAXIMIZED        window              Maximizes the window, if it is not already. Array of integers    ListView            Changes the column widths of the control. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"width","declared_type":null,"description":null},{"name":"height","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_state","fqn":"wb_set_state","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":30501,"end":30513}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"item","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"state","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Sets the state of a control item (a treeview node). Returns TRUE on success or FALSE if an error occurs. Setting states: This function can currently set the expanded or collapsed state of the treeview node indicated by item. Set state to TRUE to expand the node or FALSE to collapse it. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"item","declared_type":null,"description":null},{"name":"state","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_style","fqn":"wb_set_style","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":31224,"end":31236}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"style","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"set","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Sets or resets one or more styles of the WinBinder object wbobject. Only a limited set of styles is supported due to Windows limitations. AppWindow ResizableWindow PopupWindow NakedWindow     WBC_TOP    Make the window a topmost window. ListView    WBC_LINES    Display grid lines around items ListView WBC_CHECKBOXES    Display check boxes in the first column of all items Slider    WBC_LINES    Show tick marks. The control must be created with the WBC_LINES style TreeView    WBC_LINES    Draw dotted lines linking children objects to their parents /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"style","declared_type":null,"description":null},{"name":"set","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_set_visible","fqn":"wb_set_visible","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":31486,"end":31500}},"declared_type":null,"signature":{"parameters":[{"name":"wbobject","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"visible","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Shows or hides the WinBinder object wbobject according to the value of visible. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"wbobject","declared_type":null,"description":null},{"name":"visible","declared_type":null,"description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_sort","fqn":"wb_sort","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":32326,"end":32333}},"declared_type":null,"signature":{"parameters":[{"name":"control","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"ascending","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"subitem","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Sorts the contents of a control, a control item, a ListView column or a sub-item. If the ascending parameter is TRUE (the default), the control or column is ordered starting with the lowest value or string, and vice-versa. The sorting criteria between two given items, item1 and item2, are as follows: String or number    String    Alphabetical order according to system locale String or number    Empty    The non-empty item is always greater than the empty one Number    Number    Numeric comparison In a ListView, wb_sort() sorts the column indexed by subitem. The index of the first column is zero. Returns TRUE on success or FALSE if an error occurs. /","params":[{"name":"control","declared_type":null,"description":null},{"name":"ascending","declared_type":"null","description":null},{"name":"subitem","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_stop_sound","fqn":"wb_stop_sound","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":7750,"end":7763}},"declared_type":null,"signature":{"parameters":[{"name":"command","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"bool"},"documentation":{"description":"Stops one or more sounds that were started with wb_play_sound(). null, empty or 'all' - Stop all sounds. 'wav' or 'wave' - Stop all WAV sounds. 'mid' or 'midi' - Stop all MIDI sounds. Returns TRUE on success or FALSE otherwise. /","params":[{"name":"command","declared_type":"null","description":null}],"return_type":"bool","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_sys_dlg_color","fqn":"wb_sys_dlg_color","kind":"Function","origin":"PhpRuntime","extension":"winbinder","location":{"file":"winbinder/winbinder.php","range":{"start":47012,"end":47028}},"declared_type":null,"signature":{"parameters":[{"name":"parent","declared_type":null,"phpdoc_type":null,"optional":false,"variadic":false,"by_reference":false},{"name":"title","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false},{"name":"color","declared_type":null,"phpdoc_type":"null","optional":true,"variadic":false,"by_reference":false}],"declared_return_type":null,"phpdoc_return_type":"int"},"documentation":{"description":"Displays the standard Select Color dialog box. Returns a RGB value which is the selected color value or NOCOLOR if the dialog box was canceled. Returns NULL if not successful. Parameters: parent is a handle to the WinBinder object that will serve as the parent for the dialog box. title is currently ignored. color is an optional RGB value used to initialize the dialog box. /","params":[{"name":"parent","declared_type":null,"description":null},{"name":"title","declared_type":"null","description":null},{"name":"color","declared_type":"null","description":null}],"return_type":"int","var_type":null,"throws":[],"deprecated":null},"availability":{"since":null,"until":null},"is_static":false},{"name":"wb_sys_dlg_path","fqn":"wb_sys_dlg_path","kind":"Function","